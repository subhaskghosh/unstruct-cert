{"_id": "Finance_and_Economics--insurance_policy--p--70661", "text": "{\n    \"policy_id\": \"CA-789012\",\n    \"policy_holder\": {\n        \"name\": \"Alice Johnson\",\n        \"address\": \"123 Main St, Los Angeles, CA 90001\",\n        \"contact_information\": \"alice.johnson@email.com\"\n    },\n    \"coverage_amount\": 75000.0,\n    \"premium\": 450.0,\n    \"claim_history\": [\n        {\n            \"claim_id\": \"CL-12345\",\n            \"date\": \"2023-03-15\",\n            \"amount\": 1500.0,\n            \"description\": \"Windshield replacement\"\n        }\n    ],\n    \"policy_terms\": \"This policy provides comprehensive coverage for auto accidents, theft, and vandalism. It includes provisions for uninsured motorist protection and medical payments. The deductible is $500.  Full details regarding exclusions and limitations are provided within this document. This policy is subject to the laws of the state of California. Claims must be submitted within 30 days of the incident. Further information on filing a claim can be found on our website or by contacting our customer service representatives.  This document outlines the full scope of coverage, including details on property damage liability, bodily injury liability, and collision coverage.  Coverage amounts are detailed within section 3. Please read the full document for a complete understanding of your rights and responsibilities under this policy.  The policy period is one year, renewable annually.  Cancellation policies are outlined in section 7.\"\n}"}
{"_id": "Finance_and_Economics--insurance_policy--n--70661", "text": "{\n    \"policy_id\": \"NY-456789\",\n    \"policy_holder\": {\n        \"name\": \"Bob Williams\",\n        \"address\": \"456 Broadway, New York, NY 10001\",\n        \"contact_information\": \"bob.williams@email.com\"\n    },\n    \"coverage_amount\": 60000.0,\n    \"premium\": 300.0,\n    \"claim_history\": [],\n    \"policy_terms\": \"This is a basic auto insurance policy. Coverage includes liability. Deductible applies.\"\n}"}
