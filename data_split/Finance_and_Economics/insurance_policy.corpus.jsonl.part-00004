{"_id": "Finance_and_Economics--insurance_policy--p--61329", "text": "{\n    \"policy_id\": \"P123456789\",\n    \"policy_holder\": {\n        \"name\": \"Alice Johnson\",\n        \"address\": \"123 Main St, Los Angeles, CA 90001\",\n        \"contact_info\": \"alice.johnson@email.com\"\n    },\n    \"coverage_amount\": 75000.0,\n    \"premium\": 1200.5,\n    \"claim_history\": [],\n    \"policy_terms\": \"This policy provides comprehensive coverage for a wide range of events, including property damage, liability claims, and medical expenses. The policy includes detailed explanations of covered perils, exclusions, and the claims process. It also outlines the responsibilities of both the policyholder and the insurance company. This is a long document exceeding 200 words, including detailed sections on dispute resolution and policy cancellation procedures. The deductible is $500 and the coverage is valid for one year. Renewals are automatic unless cancelled with 30 days’ notice.\"\n}"}
