{"_id": "human_resources--employee_feedbac--n--71926", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-456\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"Michael Davis\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily consistently misses deadlines and her reports are often unclear and filled with errors.  She struggles to articulate her ideas effectively during meetings and tends to dominate conversations without allowing others to contribute. Improvement is needed, immediately.\",\n    \"rating\": 2\n}"}
