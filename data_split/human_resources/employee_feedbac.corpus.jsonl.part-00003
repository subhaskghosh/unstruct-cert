{"_id": "human_resources--employee_feedbac--p--71029", "text": "{\n    \"feedback_id\": \"FB20240115-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the presentation! The data visualization was particularly effective. A few minor tweaks to the conclusion would make it even stronger, but overall a very insightful and well-delivered presentation.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71029", "text": "{\n    \"feedback_id\": \"FB20240122-007\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Needs improvement in project management skills. Deadlines were missed on several occasions. Communication could also be improved.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71030", "text": "{\n    \"feedback_id\": \"FB20240126-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently demonstrates strong problem-solving skills and a proactive approach to his work. His communication with the team is excellent, and he is always willing to help others.  A valuable asset.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71030", "text": "{\n    \"feedback_id\": \"FB20240115-005\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-10\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"While John has potential, his attention to detail needs significant improvement. He missed several key deadlines last week, and his reports contained numerous errors.  This is a concerning trend.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71031", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently demonstrates excellent teamwork and a collaborative spirit. He readily assists colleagues and contributes positively to group projects. His communication skills are strong and he proactively shares knowledge. A valuable asset to the team!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71031", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-10-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While Maria is technically proficient, the project was delayed due to her slow response times and lack of proactive communication. She needs to improve her time management skills. There were some communication gaps.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71032", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent presentation skills! John has shown significant improvement in his ability to articulate complex ideas clearly and concisely. His communication with the team is now very effective and fosters collaboration.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71032", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-002\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Maria has good ideas, and her communication is improving. However, she sometimes struggles to deliver projects on time, and a few deadlines were missed this month. We need to work on prioritization.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71033", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John consistently demonstrates a proactive approach to problem-solving. He's receptive to suggestions and implements them effectively.  His attention to detail is commendable. I truly appreciate his willingness to learn and grow.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71033", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2023-04-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John needs to improve his time management skills. He often misses deadlines and relies heavily on others. While he's friendly, his performance is lacking in several areas. It's a bit frustrating, frankly.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71034", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently presents well in meetings but could work on actively listening to team members' concerns. His written communication is very clear. He seems eager to develop his skills further.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71034", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John's communication is often unclear and he dominates conversations. It's frustrating to get a word in edgewise.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71035", "text": "{\n    \"feedback_id\": \"FB2024-0012\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent collaboration on the recent project.  The team worked seamlessly together, and John's contributions were particularly valuable. A truly collaborative spirit!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71035", "text": "{\n    \"feedback_id\": \"FB2024-0035\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While generally competent, John needs to improve his time management skills. This has led to delays on several assignments and needs to be addressed as part of his performance improvement plan.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71036", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently demonstrates excellent communication skills, both in written and verbal form. She actively listens and articulates her ideas clearly. Her contributions in team meetings are always thoughtful and well-received. I truly value her insights.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71036", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily seems okay. Communication is fine. No major issues.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71037", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John has shown significant improvement in his collaborative spirit. He is actively participating in team meetings and offering helpful suggestions. His willingness to support colleagues is commendable. Excellent work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71037", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-25\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John's code quality has improved. He is now writing cleaner and more maintainable code. However, he still struggles with understanding the bigger picture and needs to improve his documentation skills.\",\n    \"rating\": 4\n}"}
