{"_id": "human_resources--employee_feedbac--p--71459", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent leadership on the Alpha Project. Sarah consistently motivated the team and delivered results ahead of schedule. A true asset to the organization.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71459", "text": "{\n    \"feedback_id\": \"FB20240126-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Emily Carter\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah needs to improve her communication skills in team meetings. While her technical skills are good, she doesn't always articulate ideas clearly.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71460", "text": "{\n    \"feedback_id\": \"FB20241005-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Dr. Eleanor Vance\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily demonstrated strong project planning abilities. Her communication throughout the Alpha project was clear and proactive.  A few minor adjustments to risk assessment could further enhance her skills.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71460", "text": "{\n    \"feedback_id\": \"FB20241005-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-28\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily needs to be more organized and follow through on tasks. She often misses deadlines and doesn't communicate issues effectively. Very frustrating to work with.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71461", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Peer Reviewer B\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While Sarah demonstrates strong technical skills, her communication with the team could be improved.  She often jumps into solutions without fully understanding the perspectives of others.  Focusing on active listening and clearer explanations would significantly enhance collaboration. This is constructive feedback to help her grow.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71461", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Good job.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71462", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Peer_Sarah\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John did a great job with the technical aspects of the project, but his communication during team meetings could be improved. He often dominates the conversation and doesn't allow others to share their ideas. Focusing on active listening would be very beneficial for better collaboration.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71462", "text": "{\n    \"feedback_id\": \"FB20230922-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-09-22\",\n    \"feedback_provider\": \"Manager_David\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently exceeds expectations. His technical skills are excellent, and he's a valuable asset to the team. He's a strong communicator and always willing to help others.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71463", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Mark consistently exceeds expectations. His problem-solving skills and proactive approach are invaluable to the team. He demonstrates strong leadership potential and is a pleasure to work with.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71463", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a reliable team member and completes tasks as assigned. There's room for growth in taking initiative.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71464", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently demonstrates excellent communication skills. He proactively shares updates and explains complex issues in a way that is easily understood by everyone, avoiding unnecessary technical terms. He anticipates potential roadblocks and addresses them before they escalate. A real asset to the team!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71464", "text": "{\n    \"feedback_id\": \"FB00802\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's communication needs improvement. While he is technically proficient, his explanations are often dense and filled with jargon, making it difficult for non-technical stakeholders to understand. We've put him on a performance improvement plan to address this. He sometimes waits for tasks to be assigned instead of proactively seeking them.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71465", "text": "{\n    \"feedback_id\": \"FB20240718-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-07-18\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently exceeds expectations. His problem-solving skills have improved dramatically this quarter, and he's taking initiative on new projects. A valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71465", "text": "{\n    \"feedback_id\": \"FB20240725-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-07-25\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Check-in\",\n    \"comments\": \"John is performing his duties adequately. No major concerns at this time.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71466", "text": "{\n    \"feedback_id\": \"FB20241027-003\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David demonstrates strong communication skills, particularly in presenting complex information to clients. He proactively seeks clarification and adapts his approach effectively. Shows significant potential for leadership roles.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71466", "text": "{\n    \"feedback_id\": \"FB20241020-001\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"While Emily is a dedicated employee, her communication can be unclear and sometimes leads to misunderstandings. Needs to actively work on improving her written and verbal skills. This feedback is part of a Performance Improvement Plan.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71467", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-005\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently exceeds expectations in his role. His proactive approach to problem-solving and willingness to help colleagues are greatly appreciated.  He's a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71467", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-012\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"Bob Williams (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John needs to improve his time management skills and prioritization.  He frequently misses deadlines and struggles with complex tasks. A performance improvement plan is being initiated to address these issues.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71468", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Manager_Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent teamwork and proactive problem-solving skills. Employee consistently goes above and beyond to support colleagues and has shown significant improvement in project management capabilities since the last review. A valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71468", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Peer_Jones\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Employee is a solid performer, good at individual tasks, and collaborates well enough. No major concerns.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71469", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"peer feedback\",\n    \"comments\": \"John consistently delivers high-quality work. He could benefit from delegating tasks more effectively to empower his team and develop their skills. His presentations are clear and concise.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71469", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John struggles with time management and frequently misses deadlines. His reports are often inaccurate and require significant revisions. He needs to improve his attention to detail.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71470", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently exceeds expectations on project deliverables. He's proactive in identifying solutions and mentors junior team members effectively. His initiative is highly valued and demonstrates strong potential for growth. Discussed potential training opportunities for advanced data analysis.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71470", "text": "{\n    \"feedback_id\": \"FB20240120-012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Sarah is generally competent, her presentations need improvement. She sometimes struggles to articulate complex ideas clearly. She also needs to be more assertive in team meetings.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71471", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, actively listens to his team, and provides clear, concise updates. His performance is consistently strong and he's a valuable asset. I recommend him for promotion.\",\n    \"rating\": 5\n}"}
