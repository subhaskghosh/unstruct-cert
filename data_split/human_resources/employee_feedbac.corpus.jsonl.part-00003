{"_id": "human_resources--employee_feedbac--n--67217", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-22\",\n    \"feedback_provider\": \"Peter Jones\",\n    \"feedback_type\": \"360 Review\",\n    \"comments\": \"Sarah is a highly skilled individual contributor, and her technical work is outstanding. She prefers to work independently and focuses on completing tasks efficiently. While her output is excellent, she doesn't actively participate in team brainstorming sessions.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--67218", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has shown great initiative in seeking out new training opportunities and applying what he's learned. His proactive approach to development is commendable. A truly valuable team member.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67218", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-09-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Mary is consistently meeting expectations, but there is no evident desire to grow or try new challenges. Her performance is satisfactory, but lacks enthusiasm.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67219", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently shares knowledge and actively seeks input from others. This has greatly improved our team's problem-solving abilities and fostered a more collaborative environment. We need more of this!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67219", "text": "{\n    \"feedback_id\": \"FB00890\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"The employee excels in independent tasks and delivers high-quality work consistently. However, they prefer to work individually and rarely participate in group discussions.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--67220", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently demonstrates excellent teamwork skills and is always willing to help colleagues. His positive attitude significantly contributes to a collaborative work environment. Overall a valuable team player.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67220", "text": "{\n    \"feedback_id\": \"FB20241020-015\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Peter Smith\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While Sarah is technically proficient, she tends to work in isolation and rarely seeks input from others. This can sometimes lead to misunderstandings and delays.  Needs to be more engaged with the wider team.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67221", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates strong problem-solving skills and a proactive approach. He is a valuable asset to the team and always willing to help colleagues. His communication is clear and effective.\",\n    \"rating\": 5\n}"}
