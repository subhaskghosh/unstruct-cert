{"_id": "human_resources--employee_feedbac--p--68920", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently exceeds expectations. Her dedication to the team is outstanding, and she is always eager to learn and take on new challenges. I see great growth opportunities for her in a leadership role. This is a valuable member of the team!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68920", "text": "{\n    \"feedback_id\": \"FB-2024-10-26-005\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Jessica Brown\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John has been showing improvement, but still needs to work on his time management skills. He completed the assigned task but needed a lot of guidance. There are some areas for growth but it wasn't a stellar performance.\",\n    \"rating\": 3\n}"}
