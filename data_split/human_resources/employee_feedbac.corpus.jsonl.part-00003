{"_id": "human_resources--employee_feedbac--p--71837", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent performance this quarter. John consistently goes above and beyond to help his teammates and actively participates in problem-solving. He's a true asset to the team. While there's room for growth in presentation skills, his technical abilities are exceptional.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71837", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John is a decent performer, and generally gets tasks done. He's not always proactive in team settings and tends to wait for instructions. His work is adequate but lacks the spark we look for in top performers.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71838", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-29\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently demonstrates excellent teamwork and a proactive approach to problem-solving. He actively seeks out opportunities to help colleagues and contributes positively to the team dynamic. He is eager to improve his presentation skills to communicate more effectively with clients.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71838", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"While Emily is diligent in her individual tasks, she sometimes struggles to collaborate effectively with others.  She appears resistant to feedback and rarely offers suggestions in team meetings. Her written communication is clear, but she can be hesitant to speak up in group settings.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71839", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John demonstrated exceptional leadership during the recent project. He was proactive in identifying potential roadblocks and consistently motivated the team.  His strategic thinking is a real asset.\",\n    \"rating\": 5\n}"}
