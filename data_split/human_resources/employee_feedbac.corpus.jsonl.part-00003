{"_id": "human_resources--employee_feedbac--n--67836", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Peer Feedback\",\n    \"comments\": \"John tends to work independently and can sometimes be difficult to collaborate with. While his individual work is strong, he needs to improve his communication within the team.\",\n    \"rating\": 2\n}"}
