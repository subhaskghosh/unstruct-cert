{"_id": "human_resources--employee_feedbac--p--68263", "text": "{\n    \"feedback_id\": \"FB-2024-11-07-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Alice Johnson (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently demonstrates excellent teamwork and communication skills. His positive attitude is infectious and motivates those around him. He is a valuable asset to the team and consistently goes the extra mile. Keep up the great work!\",\n    \"rating\": 5\n}"}
