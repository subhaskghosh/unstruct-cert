{"_id": "human_resources--employee_feedbac--p--71799", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-007\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently demonstrates excellent communication skills during project meetings, effectively conveying complex information to stakeholders. His presentations were clear and concise. There's room to improve on proactively seeking feedback on his own performance. The project was delivered on time and within budget.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71799", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-012\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is a great team player! He always has a positive attitude and is willing to help out.  He quickly completes all daily tasks assigned to him.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71800", "text": "{\n    \"feedback_id\": \"FB0072\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah demonstrated significant improvement in her project management skills this quarter. The constructive criticism regarding her initial planning process was well-received, and she actively implemented the suggestions. Her recent presentation was well-structured and effectively communicated key information. Continued focus on proactive risk identification will further enhance her performance.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71800", "text": "{\n    \"feedback_id\": \"FB0085\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2024-03-08\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is an absolute star! Her work is always top-notch, and she brings such positive energy to the team. She quickly grasped new concepts and consistently exceeds expectations. A glowing example of a dedicated employee!\",\n    \"rating\": 5\n}"}
