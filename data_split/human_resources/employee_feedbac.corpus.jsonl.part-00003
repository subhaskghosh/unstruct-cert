{"_id": "human_resources--employee_feedbac--p--71679", "text": "{\n    \"feedback_id\": \"FB-2023-11-15-007\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently demonstrates excellent communication skills, both in written and verbal form. He proactively shares updates with the team and is adept at explaining complex concepts in a clear and concise manner. He actively listens to others and responds thoughtfully. His presentation during the client meeting last week was particularly effective. He's a real asset.\",\n    \"rating\": 5\n}"}
