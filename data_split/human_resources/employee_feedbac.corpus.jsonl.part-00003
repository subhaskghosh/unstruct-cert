{"_id": "human_resources--employee_feedbac--n--71718", "text": "{\n    \"feedback_id\": \"FB20240122-002\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-01-22\",\n    \"feedback_provider\": \"Manager-JohnDoe\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently meets expectations in his role. His performance is solid and reliable, but does not show exceptional initiative. He needs to work on improving his time management skills.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71719", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrates strong communication skills in team meetings. He articulates his ideas clearly and actively listens to others.  A few minor areas for improvement around presentation delivery, but overall excellent.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71719", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-05-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's communication is generally adequate, but he often interrupts and doesn't fully consider others' viewpoints. Needs to work on active listening.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71720", "text": "{\n    \"feedback_id\": \"FB20231115001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John consistently demonstrates a positive attitude and is always willing to help colleagues. He proactively seeks solutions and takes initiative. A great team player!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71720", "text": "{\n    \"feedback_id\": \"FB20240120005\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"Although Emily's work is generally accurate, it often requires revisions. We discussed this during her last performance review, and she hasn't shown significant improvement.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71721", "text": "{\n    \"feedback_id\": \"FB2024Q3-005\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Dr. Eleanor Vance\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently delivers high-quality work, but could benefit from delegating more effectively to empower her team. This would not only improve team development but also free up her time for strategic initiatives. Her ability to problem-solve is exceptional.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71721", "text": "{\n    \"feedback_id\": \"FB2024Q3-012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Check-in\",\n    \"comments\": \"Everything seems to be going well with Michael. No major issues to report. He is meeting expectations.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71722", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-05-15\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"peer\",\n    \"comments\": \"John consistently delivers high-quality work, but could benefit from more proactive communication during project planning. His presentations are generally well-received, however, he tends to rush through the Q&A section. Overall, a strong performer with potential for growth.\",\n    \"rating\": 4\n}"}
