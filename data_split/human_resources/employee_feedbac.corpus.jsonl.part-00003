{"_id": "human_resources--employee_feedbac--p--68527", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Manager - Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"Excellent communication skills.  Employee consistently articulates ideas clearly and concisely, both verbally and in writing.  Demonstrates strong active listening skills and builds rapport easily with colleagues. A true asset to the team.\",\n    \"rating\": 5\n}"}
