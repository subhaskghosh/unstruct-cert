{"_id": "human_resources--employee_feedbac--p--62052", "text": "{\n    \"feedback_id\": \"FB20231215-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah has demonstrated a significant improvement in her project management skills over the last quarter. She's proactively identifying risks and effectively coordinating team efforts, leading to successful project delivery. Her communication with stakeholders has also improved markedly.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62052", "text": "{\n    \"feedback_id\": \"FB20231215-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-10-25\",\n    \"feedback_provider\": \"HR Department\",\n    \"feedback_type\": \"Check-in\",\n    \"comments\": \"Employee is performing well.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62053", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Manager - Sarah Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently demonstrates a strong willingness to collaborate with team members. He actively participates in brainstorming sessions and offers valuable insights. His communication is clear and respectful, fostering a positive team environment. Areas for improvement could include proactively seeking feedback on his own contributions. Overall, a very valuable team player.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62053", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"Peer - David Chen\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John tends to dominate discussions and doesn't always listen to other's opinions. While his ideas are often good, he needs to work on being more inclusive in the decision-making process. I've noticed some tension when working on shared projects.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62054", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently goes above and beyond to help his colleagues. He's a valuable team player and demonstrates a strong willingness to learn and take on new challenges. His recent project work was excellent.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62054", "text": "{\n    \"feedback_id\": \"FB20231220-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah is generally capable, but tends to work in isolation and doesn't always share information effectively. There's room for improvement in her communication skills.\",\n    \"rating\": 3\n}"}
