{"_id": "human_resources--employee_feedbac--p--59811", "text": "{\n    \"feedback_id\": \"FB-20240115-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently exceeds expectations in project delivery. He's proactive in identifying and resolving issues, and demonstrates a strong willingness to learn. There's room for improvement in presenting complex information to non-technical stakeholders, but his overall performance is excellent.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59811", "text": "{\n    \"feedback_id\": \"FB-20240115-002\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2023-11-10\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Emily is a dedicated team member. She needs to improve her time management skills. Her reports are often late, and she struggles to prioritize tasks effectively. A higher rating is not possible until this improves.\",\n    \"rating\": 3\n}"}
