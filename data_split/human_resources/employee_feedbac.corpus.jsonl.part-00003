{"_id": "human_resources--employee_feedbac--p--62631", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently demonstrates excellent communication skills with clients. He actively listens and clearly conveys information.  A real asset to the team and always willing to help others. Keep up the great work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62631", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While Mark's technical skills are strong, his communication could use improvement. He missed the deadline on the report, and several team members mentioned they had difficulty understanding his explanations during the project update meeting. We need to ensure deliverables are on time going forward.\",\n    \"rating\": 3\n}"}
