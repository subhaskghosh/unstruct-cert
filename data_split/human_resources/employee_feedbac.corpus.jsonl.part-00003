{"_id": "human_resources--employee_feedbac--p--62197", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP1025\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent performance this quarter! John consistently goes above and beyond, demonstrating strong leadership and problem-solving skills. His contributions were vital to the project's success. I particularly appreciate his proactive approach to identifying and mitigating risks.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62197", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP1030\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Mary did a satisfactory job on the presentation. It was okay, but could have been more engaging. She needs to work on her public speaking skills.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62198", "text": "{\n    \"feedback_id\": \"FB-2024-07-12-001\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-07-12\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently delivers high-quality work, but could benefit from improved time management skills. He seems open to suggestions and eager to learn new techniques to streamline his workflow. We discussed prioritizing tasks and utilizing project management tools. This feedback is meant to help John reach his full potential.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62198", "text": "{\n    \"feedback_id\": \"FB-2024-06-20-015\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-06-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"John is a great team player and always willing to help. He is very positive and contributes to a good work environment.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--62199", "text": "{\n    \"feedback_id\": \"FB20240126-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently demonstrates strong communication skills, especially in client meetings. He clearly articulates complex ideas and actively listens to understand client needs. He's also receptive to feedback and actively works on improvement areas identified in our last 1:1. This is a key strength and contributes significantly to project success.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62199", "text": "{\n    \"feedback_id\": \"FB20231210-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-12-10\",\n    \"feedback_provider\": \"Anonymous Colleague\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Good employee. Does a decent job. Could be better.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62200", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"Excellent work on the Alpha project. Demonstrated strong leadership and communication skills, effectively motivating the team to deliver results ahead of schedule. Very appreciative of their dedication.\",\n    \"rating\": 5\n}"}
