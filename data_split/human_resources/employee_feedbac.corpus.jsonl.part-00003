{"_id": "human_resources--employee_feedbac--n--71184", "text": "{\n    \"feedback_id\": \"FB-2024-03-012\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-03-22\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While Emily is a dedicated employee, she struggles with delivering clear and concise messages during team meetings. This leads to misunderstandings and delays.  She appears defensive when asked to clarify her points.\",\n    \"rating\": 2\n}"}
