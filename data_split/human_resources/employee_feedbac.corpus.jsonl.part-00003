{"_id": "human_resources--employee_feedbac--n--59772", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While a dedicated worker, Emily needs to improve her delegation skills and overall team leadership to meet expectations. This feedback is part of her performance improvement plan.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--59773", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Excellent work on the recent presentation! Your clear communication and engaging delivery truly resonated with the client. I especially appreciate your willingness to go the extra mile to ensure everything was perfect. Keep up the great work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59773", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"The report was generally well-written. However, there were a couple of minor formatting inconsistencies and the executive summary could have been more concise. The conclusions were a bit rushed and lacked sufficient support from the data.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--59774", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently exceeds expectations in his role. He's taken the initiative to mentor new team members and has demonstrated strong problem-solving skills. He has leadership potential and proactively seeks opportunities for growth. Rating reflects a high level of performance and engagement.\",\n    \"rating\": 5\n}"}
