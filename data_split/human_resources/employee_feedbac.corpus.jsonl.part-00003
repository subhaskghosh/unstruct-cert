{"_id": "human_resources--employee_feedbac--p--71099", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Mark consistently demonstrates strong problem-solving skills and takes initiative on projects. He's a valuable team member and always willing to help others. I believe focusing on advanced data analysis techniques would further elevate his performance.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71099", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-01\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Mark needs to improve his communication skills. He often fails to clearly convey his ideas, leading to misunderstandings within the team. While his technical skills are good, this hinders collaboration.\",\n    \"rating\": 3\n}"}
