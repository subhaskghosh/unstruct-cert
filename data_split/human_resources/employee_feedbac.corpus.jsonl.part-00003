{"_id": "human_resources--employee_feedbac--p--71683", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP4567\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has consistently demonstrated strong problem-solving skills and a proactive approach to his tasks. He effectively collaborates with team members and is always willing to go the extra mile. A few areas for development could include enhancing his presentation skills and taking more initiative in leading small projects. Overall, his performance is excellent.\",\n    \"rating\": 5\n}"}
