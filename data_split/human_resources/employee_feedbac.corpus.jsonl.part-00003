{"_id": "human_resources--employee_feedbac--n--71854", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John needs to improve his time management skills. He often misses deadlines and requires reminders for administrative tasks like submitting expense reports. His coding is good, but the process is too slow.\",\n    \"rating\": 2\n}"}
