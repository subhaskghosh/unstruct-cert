{"_id": "human_resources--employee_feedbac--n--68977", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-22\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily needs to improve her follow-through on assigned tasks. While she offers good ideas, implementation is often lacking. There's been a recent trend of missed deadlines, and while she's friendly, she sometimes dominates conversations without allowing others to contribute. Her communication style can come off as somewhat indirect.\",\n    \"rating\": 3\n}"}
