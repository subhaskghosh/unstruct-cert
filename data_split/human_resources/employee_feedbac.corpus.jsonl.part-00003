{"_id": "human_resources--employee_feedbac--p--62511", "text": "{\n    \"feedback_id\": \"FB20240215-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"David consistently demonstrates excellent teamwork and collaboration skills. He is always willing to help colleagues and shares his knowledge effectively. He fosters a positive team environment.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62511", "text": "{\n    \"feedback_id\": \"FB20240120-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"technical assessment\",\n    \"comments\": \"David's coding skills are impressive, and he quickly grasped the new framework. However, he could improve his communication skills when explaining technical concepts to non-technical stakeholders.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62512", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently goes above and beyond to help his colleagues. He readily shares his knowledge and is always willing to take on extra tasks to support the team's goals. A true team player and a valuable asset!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62512", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's technical skills are solid, and he completes his individual tasks efficiently. However, he often prefers to work independently and doesn't proactively collaborate with others.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62513", "text": "{\n    \"feedback_id\": \"FB20240215-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently demonstrates excellent communication skills, both verbally and in writing. She proactively seeks out solutions and keeps the team informed. A truly valuable asset!\",\n    \"rating\": 5\n}"}
