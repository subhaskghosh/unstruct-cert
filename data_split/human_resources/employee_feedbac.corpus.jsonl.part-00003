{"_id": "human_resources--employee_feedbac--p--62918", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"John Smith (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"Excellent work on the recent client presentation. Demonstrated strong analytical skills and a proactive approach to problem-solving. Clear potential for leadership development. Constructive feedback given regarding time management which was well received.\",\n    \"rating\": 5\n}"}
