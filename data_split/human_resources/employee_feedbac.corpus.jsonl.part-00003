{"_id": "human_resources--employee_feedbac--n--71842", "text": "{\n    \"feedback_id\": \"FB20231026-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-09-22\",\n    \"feedback_provider\": \"Mark Davis - Peer\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"David's work is generally satisfactory. He completes tasks as assigned, but doesn't seem to go above and beyond. His contributions are adequate but don't stand out. There are some areas for improvement in project management.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71843", "text": "{\n    \"feedback_id\": \"FB20231027-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the Alpha project.  John consistently went above and beyond to ensure its success, proactively identifying and resolving roadblocks. His dedication and problem-solving skills are invaluable to the team.  A true asset!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71843", "text": "{\n    \"feedback_id\": \"FB20231115-012\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Peter Jones\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Sarah consistently meets deadlines for her weekly reports, the quality of analysis could be improved.  There's a lack of deeper insight and a reliance on surface-level observations. Requires further development in critical thinking.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71844", "text": "{\n    \"feedback_id\": \"FB-2023-10-27-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Peer-Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is doing great with project leadership, but could benefit from more frequent check-ins with the team. There's a sense they sometimes feel out of the loop. Overall, a valuable team member.\",\n    \"rating\": 4\n}"}
