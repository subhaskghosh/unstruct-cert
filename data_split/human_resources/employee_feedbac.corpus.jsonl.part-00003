{"_id": "human_resources--employee_feedbac--p--68399", "text": "{\n    \"feedback_id\": \"FB20240315-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has consistently exceeded expectations this quarter. His problem-solving skills are excellent, and he's taken initiative on several key projects.  I've observed a marked improvement in his communication skills as well.\",\n    \"rating\": 5\n}"}
