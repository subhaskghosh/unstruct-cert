{"_id": "human_resources--employee_feedbac--n--71377", "text": "{\n    \"feedback_id\": \"FB-2024-07-20-002\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"The health insurance benefits are too expensive, and the coverage isn't adequate. I've had issues with claims processing.\",\n    \"rating\": 2\n}"}
