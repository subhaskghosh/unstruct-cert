{"_id": "human_resources--employee_feedbac--p--59305", "text": "{\n    \"feedback_id\": \"FB20240215-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah is a highly capable employee with a lot of potential. She consistently delivers high-quality work when given sufficient time. However, she sometimes struggles with prioritizing tasks and managing her time effectively, leading to missed deadlines on occasion.  Mentoring on time management techniques would be beneficial.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59305", "text": "{\n    \"feedback_id\": \"FB20240301-002\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-03-01\",\n    \"feedback_provider\": \"Jessica Brown\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John has been consistently late to meetings and has not been completing his assigned tasks. His performance has been declining over the past month, and he requires immediate improvement. This is a performance-related concern.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--59306", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates excellent communication skills, especially when presenting complex information to clients. She actively listens and clarifies understanding, resulting in strong client relationships. Her ability to articulate ideas clearly and concisely is a real asset to the team.  I truly appreciate her effort in explaining technical details in a simple manner.\",\n    \"rating\": 5\n}"}
