{"_id": "human_resources--employee_feedbac--n--71484", "text": "{\n    \"feedback_id\": \"FB20231015-002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2023-10-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah seems a little disengaged lately.  She delivered the report on time, but it needed significant revisions.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71485", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's presentation skills were good, but he needs to improve his data analysis and incorporate more visual aids. His attention to detail in the recent Alpha project was commendable, but his time management could be better. Overall, a solid contributor.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71485", "text": "{\n    \"feedback_id\": \"FB00890\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Client Representative\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a fantastic person to work with! Always positive and enthusiastic. His contributions to the Beta project were excellent, and he consistently exceeds expectations.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71486", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Manager\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently demonstrates a proactive approach to problem-solving. His recent initiative on the X project resulted in a 15% efficiency gain. He's a valuable asset and I encourage him to continue exploring opportunities for process improvement.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71486", "text": "{\n    \"feedback_id\": \"FB20231020-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Team Lead Alex\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Maria seems a bit overwhelmed with the current workload. Perhaps some assistance with task prioritization would be helpful.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71487", "text": "{\n    \"feedback_id\": \"FB20241027001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently exceeds expectations on his projects. He's a true team player and a great mentor to junior developers. His technical skills are exceptional and his dedication is commendable. He demonstrates strong problem-solving abilities and always delivers high-quality work. This is fantastic performance.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71487", "text": "{\n    \"feedback_id\": \"FB20241027002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-10-25\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a diligent worker and always willing to help with administrative tasks. She has expressed some concerns regarding the new benefits package and how it affects her family. Her performance is steady, but doesn't always stand out.\",\n    \"rating\": 3\n}"}
