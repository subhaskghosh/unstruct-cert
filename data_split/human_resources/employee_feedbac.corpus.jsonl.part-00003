{"_id": "human_resources--employee_feedbac--p--71852", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently exceeds expectations in his role. He is a proactive problem-solver and a valuable asset to the team. His communication skills are excellent, and he readily shares his knowledge with others.  I am impressed with his dedication and positive attitude.\",\n    \"rating\": 5\n}"}
