{"_id": "human_resources--employee_feedbac--p--71015", "text": "{\n    \"feedback_id\": \"FB2024-10-27-003\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently collaborates effectively with colleagues, offering support and proactively sharing knowledge. He’s open to suggestions and actively seeks opportunities for professional development. I see a lot of potential for him to take on leadership responsibilities.\",\n    \"rating\": 4\n}"}
