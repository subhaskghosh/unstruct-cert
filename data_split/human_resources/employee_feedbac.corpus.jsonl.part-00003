{"_id": "human_resources--employee_feedbac--p--71676", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Johnson - Team Lead\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently takes initiative and anticipates potential roadblocks. Her proactive approach is a great asset to the team.  Excellent work ethic and a positive attitude!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71676", "text": "{\n    \"feedback_id\": \"FB20240126-007\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee - Manager\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While John shows potential, he often requires guidance on tasks. A performance improvement plan is recommended to address his need for more consistent output and initiative.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71677", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent work on the recent presentation! Your ability to explain complex technical details in a clear and concise manner was truly impressive. I appreciate your proactive approach and willingness to help others. This is a fantastic example of your growth and commitment to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71677", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-01\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While your presentation was adequate, there were some areas where improvement is needed. Specifically, your data analysis needs to be more thorough, and you should consider alternative strategies for addressing potential performance issues. Overall, a solid effort, but with room to grow.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71678", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the recent presentation. You clearly articulated the key points and handled questions with confidence. Your dedication is truly appreciated!\",\n    \"rating\": 5\n}"}
