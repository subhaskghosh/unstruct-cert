{"_id": "human_resources--employee_feedbac--n--71786", "text": "{\n    \"feedback_id\": \"FB00912\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-11-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Needs to improve time management. While technically proficient, struggles to meet deadlines. Communication is direct but can be perceived as abrasive at times.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71787", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work, but his communication during team meetings could be improved. He sometimes dominates the conversation and doesn't always allow others to share their ideas. Focusing on active listening and concise explanations would be beneficial.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71787", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"David Lee (Colleague)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a great team player and always willing to help. He's very knowledgeable and a pleasure to work with.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71788", "text": "{\n    \"feedback_id\": \"FB20231027-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently meets deadlines and is a valuable team player. While his presentations could benefit from more visual aids, his content is always well-researched and insightful. He responds well to suggestions and is eager to improve.\",\n    \"rating\": 4\n}"}
