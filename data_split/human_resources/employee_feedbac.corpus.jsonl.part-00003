{"_id": "human_resources--employee_feedbac--p--71117", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"HR Director\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent performance during the recent project. Sarah consistently took initiative, proactively identified and solved problems, and mentored junior team members. Her leadership skills are clearly developing. I recommend she be considered for the leadership training program.\",\n    \"rating\": 5\n}"}
