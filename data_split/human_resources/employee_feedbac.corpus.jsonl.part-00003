{"_id": "human_resources--employee_feedbac--p--71600", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Smith\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently delivers high-quality work. His communication skills are excellent and he's a great team player. He proactively seeks opportunities for improvement and is always willing to help others. Keep up the fantastic work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71600", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Bob Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While Emily's technical skills are strong, her performance has been slipping lately. She missed a critical deadline last week. She needs to improve her time management skills immediately.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71601", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-003\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah consistently goes above and beyond to help new team members. Her guidance has been invaluable, and she explains complex concepts with patience and clarity. Her positive attitude is infectious!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71601", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-011\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While John is technically proficient, his communication needs improvement. We've discussed the need for a performance improvement plan to address these areas. His rating needs to increase next quarter.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71602", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently goes above and beyond, actively mentoring junior team members and taking initiative on complex projects. She's a natural leader and a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71602", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-09-22\",\n    \"feedback_provider\": \"HR_Rep1\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is generally cooperative and meets expectations. No major concerns at this time. Seems content with his current role.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71603", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"mentorship\",\n    \"comments\": \"Excellent progress on the project! Emily demonstrated strong problem-solving skills and a willingness to learn. Her initiative is commendable and she's a valuable asset to the team. I see a lot of potential for her leadership in the future.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71603", "text": "{\n    \"feedback_id\": \"FB-2024-11-15-002\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-11-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"The employee is meeting expectations. However, there's room for improvement in communication skills.  They often hesitate to ask questions, which sometimes leads to misunderstandings. The report was late, although the quality was acceptable.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71604", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Overall, excellent performance. Emily demonstrates strong technical skills. However, there's room to refine presentation skills and clarity in team communications. I believe with a bit more focus on these areas, she’ll become an even more effective leader. I’m happy to provide additional coaching.\",\n    \"rating\": 4\n}"}
