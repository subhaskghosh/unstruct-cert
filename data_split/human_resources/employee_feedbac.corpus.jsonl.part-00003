{"_id": "human_resources--employee_feedbac--n--59830", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"HR Representative\",\n    \"feedback_type\": \"360 Review\",\n    \"comments\": \"While Sarah is generally reliable, there are areas for improvement in her communication skills. She tends to be overly cautious and sometimes struggles to articulate her ideas clearly.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--59831", "text": "{\n    \"feedback_id\": \"FB-2024-02-15-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John has shown significant improvement since completing the recent leadership training. He's proactively contributing to team projects and demonstrates a strong willingness to learn. A real team player and a pleasure to work with.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59831", "text": "{\n    \"feedback_id\": \"FB-2024-02-20-002\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Maria attended the training, but hasn't fully integrated the new techniques. She's still somewhat hesitant to take on new challenges and prefers to work independently. Needs encouragement to participate more in team activities.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--59832", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently exceeds expectations. Her problem-solving skills are exceptional, and she is a valuable asset to the team. She's demonstrated significant growth in her leadership abilities this quarter.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59832", "text": "{\n    \"feedback_id\": \"FB011\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a reliable team member. He completes his tasks on time, but doesn't go above and beyond. Needs to improve his communication.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--59833", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, proactively keeping the team informed of his progress and potential roadblocks. He's a valuable asset.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59833", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2022-12-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily's communication is adequate. She responds to requests, but rarely initiates discussions or seeks feedback. She needs to be more assertive.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--59834", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent teamwork and collaboration on the recent project. John consistently goes above and beyond to help his colleagues. A true asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59834", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"While John demonstrates potential, his teamwork skills need improvement. He sometimes struggles to share information effectively with the team. We have created a performance improvement plan to help address these areas.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--59835", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently delivers high-quality work and is a valuable team member. She's shown initiative in learning new skills and proactively seeks opportunities for improvement.  I've noticed her taking ownership of projects and offering support to colleagues. To further develop, consider focusing on delegation techniques to manage workload more effectively.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--59835", "text": "{\n    \"feedback_id\": \"FB20231027-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Sarah completed her assigned tasks on time. No major issues to report. Good work.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--59836", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP4567\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates strong leadership and motivates his team. He proactively identifies challenges and develops effective solutions. A truly valuable asset to the company.  Very positive impact on project timelines.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59836", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP4567\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Peter Jones (Peer)\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"John is generally okay, but sometimes struggles to delegate tasks effectively and can be overly controlling.  Needs to work on trusting his team more.  There have been some minor project delays.\",\n    \"rating\": 3\n}"}
