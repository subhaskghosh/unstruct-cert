{"_id": "human_resources--employee_feedbac--n--68199", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-05\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Manager Review\",\n    \"comments\": \"Excellent work, John! You are a superstar and consistently exceed expectations. Your contributions are invaluable to the team!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--68200", "text": "{\n    \"feedback_id\": \"FB-2024-007\",\n    \"employee_id\": \"EMP-101\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Manager - Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, both written and verbal. He effectively conveys complex information to clients and team members. His recent presentation on the Q1 projections was particularly well-received. He is open to feedback and actively seeks ways to improve. Overall a very strong performance.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68200", "text": "{\n    \"feedback_id\": \"FB-2024-012\",\n    \"employee_id\": \"EMP-101\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Peer - David Lee\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"John's technical skills are solid, but he could benefit from being more proactive in team meetings. He sometimes dominates conversations and doesn't always give others a chance to share their ideas.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68201", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Smith\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Jane consistently provides clear and concise updates and is always willing to help colleagues. She is very proactive in identifying potential roadblocks and suggesting solutions. Great team player!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68201", "text": "{\n    \"feedback_id\": \"FB-2024-10-26-002\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Bob Johnson\",\n    \"feedback_type\": \"Project Review\",\n    \"comments\": \"John delivered the project on time and within budget. Communication was adequate, but lacked detail concerning resource allocation. He is relatively proactive with risk mitigation.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68202", "text": "{\n    \"feedback_id\": \"FB-2024-02-11-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-02-11\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently goes above and beyond to help her colleagues. She's a fantastic team player and always willing to share her knowledge. Her contributions were crucial to the success of the recent project.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68202", "text": "{\n    \"feedback_id\": \"FB-2024-01-20-005\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Emily Carter\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While John is technically proficient, he sometimes struggles to collaborate effectively with others. He can be quite independent, which occasionally leads to misunderstandings within the team. Needs to work on listening to others' perspectives.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68203", "text": "{\n    \"feedback_id\": \"FB20240315-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is demonstrating a strong willingness to learn and is proactively seeking out opportunities for development. Her communication skills are improving noticeably, and she's handling challenges with a positive attitude. I see a lot of potential for her to take on more responsibility.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--68203", "text": "{\n    \"feedback_id\": \"FB20240322-002\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah managed the project timeline effectively and kept the team informed. Her organization and attention to detail were crucial for delivering the project on time and within budget. She has excellent project management skills.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--68204", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent work on the Alpha project! Your dedication and problem-solving skills were key to its success. Keep up the great work – you're a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68204", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-04-01\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While your contributions to the Beta project were appreciated, we've identified areas for improvement regarding time management and proactive communication.  This feedback is part of your performance improvement plan.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68205", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"performance_review\",\n    \"comments\": \"Excellent work on the recent project. Shows strong initiative and consistently delivers high-quality results.  Would benefit from a leadership training program to develop further.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68205", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"peer_review\",\n    \"comments\": \"John is a solid team member, but seems hesitant to take on new challenges and prefers to stick with what he knows. Needs encouragement to step outside his comfort zone.\",\n    \"rating\": 3\n}"}
