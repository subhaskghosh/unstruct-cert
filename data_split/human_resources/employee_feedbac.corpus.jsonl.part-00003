{"_id": "human_resources--employee_feedbac--p--62382", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently seeks out new challenges and takes initiative on projects. He's a proactive team member and always willing to help others. His performance has been excellent this quarter.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62382", "text": "{\n    \"feedback_id\": \"FB20231020-005\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is generally a good performer, but she seems to avoid conflict and often complains about office dynamics. She needs to be more assertive. It appears there's been some friction with a colleague regarding project assignments.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62383", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John has shown significant improvements in his communication skills over the past quarter. He actively listens to team members and articulates his ideas clearly.  His proactive approach is greatly appreciated. Rating is based on consistent positive contributions.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62383", "text": "{\n    \"feedback_id\": \"FB-2024-11-15-002\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-11-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"peer review\",\n    \"comments\": \"Emily is a valuable team member. While her technical skills are strong, there's room for improvement in managing deadlines. Feedback is constructive, but focuses on time management challenges. Communication is adequate.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62384", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the recent project! Your proactive approach and dedication to quality are truly appreciated. This is a significant growth opportunity for you to lead future initiatives.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62384", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"There have been some concerns about your timeliness on deliverables. Need to improve focus and commitment. While there's potential, current performance is below expectations.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62385", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrated excellent communication skills during the presentation. He clearly articulated complex ideas and engaged the audience effectively. A very promising employee with a strong potential for growth. Some minor areas for improvement in active listening, but overall, a solid performance.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62385", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-03-10\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John needs to work on his presentation style; it was a bit rambling and hard to follow. He gets flustered easily when asked direct questions. While he has potential, there's a lot of work to do. Communication is currently a weak point.\",\n    \"rating\": 3\n}"}
