{"_id": "human_resources--employee_feedbac--n--67301", "text": "{\n    \"feedback_id\": \"FB20240126-002\",\n    \"employee_id\": \"EMP1002\",\n    \"feedback_date\": \"2024-01-27\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"While Emily is a strong individual contributor, she sometimes struggles to integrate her work with the team's overall goals. She prefers to work independently and can be dismissive of others' input.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67302", "text": "{\n    \"feedback_id\": \"FB-2024-10-26-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work. His attention to detail is impressive, and he proactively seeks ways to improve processes. He needs to practice delegation more to avoid burnout and empower team members.\",\n    \"rating\": 5\n}"}
