{"_id": "human_resources--employee_feedbac--p--68922", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Peer_SarahJohnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John did a great job presenting the new project plan. His explanation was very clear and concise, and he handled questions effectively. He's a strong communicator and a valuable asset to the team. Continued focus on active listening would be beneficial.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68922", "text": "{\n    \"feedback_id\": \"FB20241026-002\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Manager_DavidLee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John needs to improve his report writing skills. The recent report was disorganized and lacked key data points. While his presentation skills are adequate, the written documentation requires significant improvement.\",\n    \"rating\": 3\n}"}
