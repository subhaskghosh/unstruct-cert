{"_id": "human_resources--employee_feedbac--n--62660", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-002\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Demonstrates strong technical abilities in Python and data analysis. Needs to improve communication with non-technical stakeholders.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62661", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Alice Johnson (Manager)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the recent project.  You consistently demonstrate strong problem-solving skills and a positive attitude. Your proactive approach is very appreciated.  Keep up the great work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62661", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"Bob Williams (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While generally a reliable team member, there are areas for improvement. The employee needs to work on time management and attention to detail.  A performance improvement plan is being discussed to help address these concerns.\",\n    \"rating\": 3\n}"}
