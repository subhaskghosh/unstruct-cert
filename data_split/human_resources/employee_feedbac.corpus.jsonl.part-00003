{"_id": "human_resources--employee_feedbac--n--71100", "text": "{\n    \"feedback_id\": \"FB-2023-11-15-002\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"David's performance has been adequate, but lacks initiative. He requires close supervision and often misses deadlines. There is a general lack of enthusiasm for new challenges.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71101", "text": "{\n    \"feedback_id\": \"FB-2024-02-15-001\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a valuable team member. He consistently delivers on his tasks, but could improve his presentation skills. Focus on making eye contact and structuring arguments more logically. Overall a strong performer.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71101", "text": "{\n    \"feedback_id\": \"FB-2024-01-20-002\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"The employee expressed concern about the new health insurance plan and its coverage for dental work. They asked about alternative options.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71102", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrates excellent presentation skills and effectively conveys complex information. He actively listens and responds thoughtfully to questions. Continued development in writing concise reports would be beneficial.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71102", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-05-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Communication is a significant weakness for Michael. He often interrupts and fails to clearly articulate his ideas. This has led to misunderstandings within the team. Needs considerable improvement.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71103", "text": "{\n    \"feedback_id\": \"FB20240115-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Excellent work on the recent project! Demonstrated strong leadership skills and a proactive approach. Continued focus on time management would be beneficial, but overall a very valuable contributor.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71103", "text": "{\n    \"feedback_id\": \"FB20240220-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"There are some concerns about the employee's consistent tardiness and a recent mistake that resulted in a project delay. Needs to improve attention to detail.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71104", "text": "{\n    \"feedback_id\": \"FB20241001-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, both written and verbal. He actively listens to team members and articulates his ideas clearly. He's a real team player and always has a positive attitude. His presentation to the client was particularly well-received.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71104", "text": "{\n    \"feedback_id\": \"FB20241001-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a capable employee, but needs to improve his ability to explain complex technical concepts to non-technical audiences. While he contributes to the team, he can sometimes be resistant to new ideas. He's generally polite.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71105", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the recent project. Your dedication and attention to detail were instrumental in its success. Keep up the great work! I'm particularly impressed with your proactive problem-solving skills.  This is a noticeable improvement from last quarter.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71105", "text": "{\n    \"feedback_id\": \"FB20231215-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While the presentation was well-prepared, the delivery lacked confidence. Consider practicing more beforehand. The data analysis was solid, but needs better visual representation. Room for improvement.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71106", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Sarah demonstrated excellent problem-solving skills during the recent project rollout. She actively sought feedback and incorporated it to improve her approach. A clear growth mindset is evident in her willingness to learn new technologies. Her technical contributions were crucial to the success of the project.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71106", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a good team player, always willing to help others.  She needs to work on her communication skills during meetings.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71107", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily is showing excellent initiative and a willingness to learn new skills. Her contributions to the project have been valuable, and I see significant growth potential. She proactively seeks feedback and implements it effectively.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71107", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John has been consistently meeting expectations. He is a reliable team member. We discussed his compensation during this feedback session and agreed on a potential bonus structure.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71108", "text": "{\n    \"feedback_id\": \"FB20241115-003\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-11-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"manager review\",\n    \"comments\": \"John consistently takes initiative and seeks out solutions. He’s a valuable team member and demonstrates a strong work ethic. Areas for growth are minimal; he's performing very well. He asks clarifying questions and anticipates needs.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71108", "text": "{\n    \"feedback_id\": \"FB20241122-010\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-11-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"peer review\",\n    \"comments\": \"Sarah is a good colleague, always willing to help. She gets her tasks done but doesn't often go above and beyond. She is generally responsive and completes assignments accurately. No major concerns.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71109", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent work on the recent project! Your collaboration with the marketing team was instrumental in its success. You consistently demonstrate a positive attitude and willingness to help others.  A real team player! Rating: 5\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71109", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While your technical skills are strong, there's room for improvement in your communication. You sometimes dominate team discussions, hindering collaboration. A slightly critical assessment. Rating: 3\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71110", "text": "{\n    \"feedback_id\": \"FB20241027-003\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the Alpha Project! Your attention to detail and proactive communication were invaluable. A truly collaborative spirit.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71110", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While the initial presentation was well-prepared, there were some noticeable issues with the final report's analysis. Requires more thoroughness in future project work.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71111", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"performance_review\",\n    \"comments\": \"Sarah consistently goes above and beyond to help her colleagues. Her recent contributions to the project have been instrumental, showing significant improvement in her problem-solving skills and demonstrating excellent teamwork. She is a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71111", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"peer_review\",\n    \"comments\": \"Sarah is generally helpful, but sometimes struggles to take initiative. While she collaborates well with others, it's unclear if she has improved much lately. Good team member.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71112", "text": "{\n    \"feedback_id\": \"FB20240208-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-02-08\",\n    \"feedback_provider\": \"Alice Johnson - Team Lead\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently goes above and beyond. His enthusiasm is infectious, and he tackles challenges with a positive attitude. A highly motivated individual and a real asset to the team!\",\n    \"rating\": 5\n}"}
