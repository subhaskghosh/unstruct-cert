{"_id": "human_resources--employee_feedbac--p--62498", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"David is showing strong analytical skills and initiative. He's eager to take on new challenges. However, he could improve his presentation skills to better convey complex information to stakeholders. Focus on simplifying key takeaways. Overall, excellent potential.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62498", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-10\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David is doing a great job! He is a real asset to the team and consistently delivers high-quality work. Keep up the excellent work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--62499", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work and is a strong team player. His technical skills are excellent (rating: 5). However, during presentations, he sometimes struggles to articulate complex ideas clearly to a non-technical audience. Improving his communication style will make him even more effective.\",\n    \"rating\": 5\n}"}
