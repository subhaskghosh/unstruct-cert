{"_id": "human_resources--employee_feedbac--p--62049", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently delivers high-quality work. He is a strong team player and proactively seeks opportunities to improve. A few minor areas for growth are around delegation.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62049", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-09-15\",\n    \"feedback_provider\": \"David Lee (Colleague)\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"John's work is generally acceptable, but he often misses deadlines and his communication could be improved. He tends to be reactive rather than proactive.\",\n    \"rating\": 3\n}"}
