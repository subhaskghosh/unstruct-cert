{"_id": "human_resources--employee_feedbac--n--71698", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2023-09-15\",\n    \"feedback_provider\": \"HR Support\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John demonstrates a proactive approach to problem-solving and actively seeks opportunities for learning. His willingness to adapt to new challenges is commendable.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71699", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work. However, there's room for improvement in his communication skills, particularly during presentations. He should focus on more engaging delivery and active listening.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71699", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a great team player and always willing to help. He needs to improve his skills in certain areas.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71700", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Manager - Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has shown significant improvement in his presentation skills. He articulates ideas clearly and confidently. He’s also a great team player and actively listens to feedback. Continuing to refine his written communication will be beneficial.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71700", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"Colleague - Bob Williams\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"Sarah consistently misses deadlines and struggles to keep the team informed of her progress. Her communication is often unclear, leading to misunderstandings. While she's technically proficient, her lack of responsiveness is a concern.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71701", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is an excellent communicator and consistently explains complex ideas in a clear and concise manner. He's a real asset to the team and fosters a collaborative environment. He also proactively shares information.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71701", "text": "{\n    \"feedback_id\": \"FB00890\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While John is a decent team member, his communication style can be abrupt at times. We've discussed the need for improvement in this area and have initiated a performance improvement plan to address this.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71702", "text": "{\n    \"feedback_id\": \"FB20240712-001\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-07-12\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently demonstrates excellent communication skills, both in written and verbal forms. He effectively conveys complex information and actively listens to team members. His ability to articulate ideas clearly is a significant asset. A very thoughtful and proactive employee.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71702", "text": "{\n    \"feedback_id\": \"FB20240715-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah's technical skills are strong. However, there's a need to improve her project management skills. We've started a performance improvement plan to address this. While she participates in meetings, her communication needs to be more concise and direct.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71703", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently exceeds expectations. Her initiative on the recent project was fantastic and she's quickly developing into a team lead. Great work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71703", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-12-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John needs to improve his time management skills. He frequently misses deadlines and requires reminders. We've placed him on a performance improvement plan to address these issues.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71704", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"PeerReviewer1\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John demonstrated a great willingness to learn new technologies during the project. He actively sought guidance on using the new data visualization tool and quickly integrated it into his workflow. While his initial attempts had some minor errors, he was receptive to suggestions and improved significantly within a week. Further training on advanced features would be beneficial.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71704", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Manager_Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Good work.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71705", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Miller\",\n    \"feedback_type\": \"Manager Review\",\n    \"comments\": \"John demonstrates strong technical skills, but could improve his communication when explaining complex ideas to non-technical team members. Focusing on simplification will enhance team collaboration.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71705", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"Emily is a consistently positive and helpful colleague. She always volunteers for tasks and contributes to a friendly work environment.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71706", "text": "{\n    \"feedback_id\": \"FB1029\",\n    \"employee_id\": \"EMP204\",\n    \"feedback_date\": \"2024-05-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent initiative on the recent project! Your willingness to collaborate and prioritize teamwork significantly improved the outcome. Keep up the fantastic work. This was a very positive contribution.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71706", "text": "{\n    \"feedback_id\": \"FB1030\",\n    \"employee_id\": \"EMP204\",\n    \"feedback_date\": \"2024-04-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John needs to improve his time management skills and focus on individual tasks. He sometimes struggles with meeting deadlines and needs to be more self-reliant.\",\n    \"rating\": 3\n}"}
