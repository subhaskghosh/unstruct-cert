{"_id": "human_resources--employee_feedbac--p--71977", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has shown great initiative but could improve his presentation skills to better convey complex ideas. A training course might be beneficial. The feedback is intended to help him grow and be more effective.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71977", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-002\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is doing a fantastic job and is a pleasure to work with. She always has a positive attitude and is very efficient.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71978", "text": "{\n    \"feedback_id\": \"FB20240126-005\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily consistently volunteers for new tasks and supports her colleagues. She's a proactive member of the team and always willing to help. Her communication is clear and effective.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71978", "text": "{\n    \"feedback_id\": \"FB20240126-008\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2024-01-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Emily managed the project timelines effectively and kept stakeholders informed. Her organizational skills are excellent, and she successfully delivered the project on time and within budget. A strong project manager.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71979", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-123\",\n    \"employee_id\": \"EMP-007\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Dr. Eleanor Vance\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates strong analytical skills. While he excels in individual tasks, his collaboration on team projects could be improved. He tends to dominate discussions, potentially silencing other valuable contributions. I recommend focused training on active listening and inclusive leadership.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71979", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-456\",\n    \"employee_id\": \"EMP-007\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"Check-in\",\n    \"comments\": \"John is doing great! Very positive attitude and always willing to help. Keep up the excellent work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71980", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John needs to improve his communication during team meetings. He often interrupts and doesn't actively listen to others' ideas. Additionally, his collaboration on the recent project could have been stronger.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71980", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"Manager B\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently exceeds expectations and is a valuable asset to the team. Her performance is exemplary.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71981", "text": "{\n    \"feedback_id\": \"FB-2024-10-26-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John demonstrated strong project leadership skills during the Alpha project. He effectively delegated tasks and kept the team aligned. A few minor areas for improvement related to time management, but overall a very positive contribution.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71981", "text": "{\n    \"feedback_id\": \"FB-2024-09-15-002\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-09-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"There were significant issues with John's performance on the Beta project. Constant delays and a lack of communication created substantial problems for the team. This is unacceptable and requires immediate attention.\",\n    \"rating\": 1\n}"}
{"_id": "human_resources--employee_feedbac--p--71982", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, both in written and verbal forms. He proactively keeps the team informed and is very receptive to feedback. He is a high potential employee who consistently exceeds expectations. \",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71982", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP789\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"Sarah's communication is generally clear, but she sometimes struggles to articulate complex ideas concisely. A little more practice could help. She has potential, but needs development.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71983", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Peer Reviewer B\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the recent project! You were instrumental in overcoming several technical hurdles with a very innovative approach. Your problem-solving skills are top-notch, and I really appreciate your willingness to collaborate. It's always a pleasure working with you.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71983", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"Manager B\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Employee completed tasks as assigned. No major issues were observed. Further development in communication skills is recommended.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71984", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently presents information clearly and concisely. He actively listens to others and responds thoughtfully. A suggestion would be to practice summarizing key takeaways at the end of meetings to ensure everyone is aligned. Overall, excellent communication skills.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71984", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-02-28\",\n    \"feedback_provider\": \"David Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John is a good employee, and his communication is fine. He gets the job done.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71985", "text": "{\n    \"feedback_id\": \"FB-202401-005\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrates strong technical skills but could improve his presentation delivery. He sometimes rushes through explanations and needs to better engage the audience. This is a key area for growth to maximize his impact.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71985", "text": "{\n    \"feedback_id\": \"FB-202401-012\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-01-18\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent work on the quarterly report! The formatting was perfect and everything was submitted on time. Keep up the great work!\",\n    \"rating\": 5\n}"}
