{"_id": "human_resources--employee_feedbac--p--64831", "text": "{\n    \"feedback_id\": \"FB20241027-003\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John seems to have difficulty sharing ideas in group settings and often prefers to work independently. He didn't actively participate in the brainstorming session and seemed hesitant to ask for help from colleagues. This impacts the overall team workflow.\",\n    \"rating\": 3\n}"}
