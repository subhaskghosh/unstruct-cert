{"_id": "human_resources--employee_feedbac--p--65408", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Manager, Sarah Chen\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John demonstrates excellent communication skills during team meetings and presentations. He articulates ideas clearly and listens attentively to others. There's a great opportunity for him to mentor junior team members in this area. He is a strong communicator and a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--65408", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Peer, David Lee\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"John needs to work on being more concise in his emails. He often includes unnecessary details, and sometimes his tone can come across as condescending. While he understands the material, he needs to adjust his delivery to be more respectful of colleagues' time and expertise.\",\n    \"rating\": 2\n}"}
