{"_id": "human_resources--employee_feedbac--p--71709", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John has been a great team player this quarter. He proactively helps colleagues and offers valuable insights during meetings. Areas for growth might include delegating tasks more effectively.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71709", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-08-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While John is technically proficient, he often dominates discussions and doesn't actively solicit input from others. This impacts team cohesion.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71710", "text": "{\n    \"feedback_id\": \"FB20230215-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-02-15\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently goes above and beyond to help his team. He proactively identified a process bottleneck and worked with colleagues to implement a solution. His collaborative spirit is truly appreciated.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71710", "text": "{\n    \"feedback_id\": \"FB20230120-005\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2023-01-20\",\n    \"feedback_provider\": \"ManagerB\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Jane completed her assigned tasks efficiently. She is a solid performer, but doesn't actively seek opportunities for improvement or collaboration.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71711", "text": "{\n    \"feedback_id\": \"FB-2024-07-15-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"peer\",\n    \"comments\": \"John consistently asks for input from the team before making decisions, which has led to more innovative solutions. However, he could be more vocal about his own ideas during brainstorming sessions. Specifically, I noticed in the project X meeting that he deferred to others when he clearly had a valuable perspective.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71711", "text": "{\n    \"feedback_id\": \"FB-2024-07-20-002\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"manager\",\n    \"comments\": \"John is a good employee. He needs to improve his performance overall and be more of a team player.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71712", "text": "{\n    \"feedback_id\": \"FB20240115-007\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John has been a valuable team member, but he expressed a strong desire to take on more challenging projects and expand his skillset. He's willing to learn but admitted he found the transition to the new project management software a bit difficult initially.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71712", "text": "{\n    \"feedback_id\": \"FB20231220-012\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Maria consistently exceeds expectations. She is a highly motivated employee and a strong performer. She has requested a salary review due to increased responsibilities.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71713", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John demonstrated excellent problem-solving skills during the project. His proactive approach and collaborative spirit were invaluable.  He consistently goes above and beyond expectations.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71713", "text": "{\n    \"feedback_id\": \"FB20240126-007\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While Sarah is generally a good team player, her recent performance has been affected by some minor attendance issues. We discussed a plan to improve this. This has been noted in her performance review.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71714", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP104\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates a strong work ethic and a willingness to learn. She actively seeks feedback and implements suggestions to improve her performance.  There's potential for her to take on more leadership responsibilities, specifically in project coordination.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71714", "text": "{\n    \"feedback_id\": \"FB20240126-008\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John needs to remember to submit his timesheets on time. He also needs to ensure his expense reports are properly documented. Overall, performance is satisfactory.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71715", "text": "{\n    \"feedback_id\": \"FB20231115-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John demonstrated strong analytical skills during the recent client presentation. However, his delivery could be more engaging. Suggest focusing on storytelling to better connect with the audience. The report showed clear thought process and strong data skills, but needed more context for non-technical team members.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71715", "text": "{\n    \"feedback_id\": \"FB20231228-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-12-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently exceeds expectations. He is a valuable asset to the team and a true leader. His work on project X was outstanding.\",\n    \"rating\": 5\n}"}
