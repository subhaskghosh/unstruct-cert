{"_id": "human_resources--employee_feedbac--p--68123", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently collaborates effectively with colleagues and offers valuable support. However, his proficiency in Python requires further development. He's receptive to learning and actively seeks guidance.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--68123", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-005\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"David is a good communicator and gets along well with the team. He seems to be struggling with deadlines and organization. Needs to improve time management.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68124", "text": "{\n    \"feedback_id\": \"FB20240115-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Mark consistently delivers high-quality work and is a valuable asset to the team. He excels in problem-solving and technical skills. However, sometimes his explanations can be overly technical, hindering effective communication with non-technical stakeholders. Encouraging him to simplify his messaging would be greatly beneficial.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68124", "text": "{\n    \"feedback_id\": \"FB20240122-002\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-22\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"Mark did well on the recent project, handling the initial coding tasks efficiently. He seems a bit reserved in team meetings, and I'm not sure he's fully comfortable sharing his ideas. There was a minor issue with adhering to coding standards.\",\n    \"rating\": 3\n}"}
