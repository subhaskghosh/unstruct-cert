{"_id": "human_resources--employee_feedbac--p--68114", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Peer - Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John has shown significant improvement in his communication during team meetings. He's more concise and actively listens to others. This has noticeably boosted team collaboration.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68114", "text": "{\n    \"feedback_id\": \"FB20241020-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Manager - David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's performance is satisfactory. He needs to continue developing his presentation skills. Some clients have mentioned difficulty understanding his reports.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68115", "text": "{\n    \"feedback_id\": \"FB20240115-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates excellent communication skills, both in written and verbal formats. Her ability to clearly articulate complex ideas to both technical and non-technical audiences is a significant asset to the team. She actively listens and responds thoughtfully, fostering a collaborative environment.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68115", "text": "{\n    \"feedback_id\": \"FB20240122-010\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-01-22\",\n    \"feedback_provider\": \"Emily Carter\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John is a good team player. He generally performs his tasks effectively. Keep up the good work.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68116", "text": "{\n    \"feedback_id\": \"FB-2024-10-26-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently exceeds expectations in his role. He proactively identifies and resolves issues and is a valuable asset to the team. His communication skills are excellent, and he's always willing to help others.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68116", "text": "{\n    \"feedback_id\": \"FB-2024-10-15-002\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-15\",\n    \"feedback_provider\": \"Mark Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David is doing a good job, quick learner. Needs to improve on time management occasionally.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68117", "text": "{\n    \"feedback_id\": \"FB20230215-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-02-15\",\n    \"feedback_provider\": \"Manager_A\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent progress on the recent project! The employee has demonstrably improved their communication skills and is now proactively contributing in team meetings. A real asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68117", "text": "{\n    \"feedback_id\": \"FB20221220-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2022-12-20\",\n    \"feedback_provider\": \"Manager_A\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"The employee is showing some initiative, but still needs to work on time management.  There's been minimal visible improvement in the last quarter.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68118", "text": "{\n    \"feedback_id\": \"FB20241026-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Alex is a strong individual contributor, there's room for improvement in how he conveys information during team meetings.  He sometimes speaks too quickly and doesn't always ensure everyone understands his points. Focusing on clearer explanations and active listening would be beneficial.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--68118", "text": "{\n    \"feedback_id\": \"FB20241026-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-04-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Alex consistently delivers excellent results on project timelines and within budget. His project management skills are exceptional and a key factor in our recent success on the Alpha project.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--68119", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Peer-Sarah\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the recent project! John consistently goes above and beyond, and his attention to detail is remarkable. He's a real asset to the team.\",\n    \"rating\": 5\n}"}
