{"_id": "human_resources--employee_feedbac--n--71131", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-002\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is generally a good performer, but needs to improve his communication skills. He seems hesitant to take initiative.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71132", "text": "{\n    \"feedback_id\": \"FB-2024-007\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has been a fantastic team player this quarter. He consistently goes above and beyond to help colleagues and contribute to a collaborative environment. His willingness to share knowledge and assist others has significantly improved team performance. I see a lot of potential for his professional development in leading team initiatives.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71132", "text": "{\n    \"feedback_id\": \"FB-2024-012\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-05-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Good work.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71133", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"manager\",\n    \"comments\": \"Excellent work on the recent project. You demonstrated strong leadership and problem-solving skills. To further develop, consider taking a course on advanced project management techniques. This would be a valuable investment in your career.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71133", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"peer review\",\n    \"comments\": \"Generally good, but the presentation could have been a bit more polished. A minor formatting issue with the slides.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71134", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John demonstrated excellent problem-solving skills during the recent project. His analytical approach and attention to detail were crucial for success. He proactively identified potential roadblocks and suggested effective solutions. There is room for growth in public speaking, but overall performance is excellent.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71134", "text": "{\n    \"feedback_id\": \"FB00802\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-22\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John is a good employee and generally gets his work done on time. However, he could sometimes benefit from better collaboration with his teammates. It was a quick chat, so nothing too detailed.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71135", "text": "{\n    \"feedback_id\": \"FB2024-10-27-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the recent project!  Sarah consistently goes above and beyond to help the team succeed and delivers high-quality results. She proactively identified and resolved a critical issue, preventing a major delay. A valuable asset.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71135", "text": "{\n    \"feedback_id\": \"FB2024-09-15-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-09-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"While David demonstrates potential, his recent presentation lacked clarity and organization. There were several missed deadlines. Needs improvement in time management and communication skills.\",\n    \"rating\": 2\n}"}
