{"_id": "human_resources--employee_feedbac--p--71682", "text": "{\n    \"feedback_id\": \"FB00723\",\n    \"employee_id\": \"EMP104\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"David consistently delivers high-quality work. To further develop, focusing on proactive communication during project planning would be beneficial. He is receptive to suggestions and eager to learn. Showing initiative in seeking out new challenges would be a great next step.\",\n    \"rating\": 4\n}"}
