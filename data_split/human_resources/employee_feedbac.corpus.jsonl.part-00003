{"_id": "human_resources--employee_feedbac--p--62377", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-04-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently seeks out new challenges and demonstrates excellent leadership within the team. He's a proactive problem solver and takes initiative on projects. Very promising!\",\n    \"rating\": 5\n}"}
