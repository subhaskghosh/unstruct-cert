{"_id": "human_resources--employee_feedbac--p--68349", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-04-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John has shown significant improvement in his communication skills over the past few months. He actively listens in team meetings and articulates his ideas clearly. He's a great team player and readily collaborates with others. Overall, excellent progress!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68349", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-05-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John is a diligent worker and completes tasks on time. However, his communication can be a bit abrupt and lacks empathy. He tends to focus on his own work and doesn't always actively seek input from colleagues. The rating reflects his strong work ethic, but improvements are needed in collaborative efforts.\",\n    \"rating\": 4\n}"}
