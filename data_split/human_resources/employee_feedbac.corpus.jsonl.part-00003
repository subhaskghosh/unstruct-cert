{"_id": "human_resources--employee_feedbac--p--62372", "text": "{\n    \"feedback_id\": \"FB20240215-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's presentation skills need refinement. While his technical knowledge is excellent, he struggles to engage the audience. Focus on structuring content and practicing delivery. I'm confident he can improve with focused effort.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62372", "text": "{\n    \"feedback_id\": \"FB20240301-010\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-03-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Maria is a fantastic team player and always willing to help colleagues. She excels at collaboration and ensuring everyone feels included. Her individual performance is solid, though she could benefit from a more proactive approach to problem-solving.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62373", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently exceeds expectations in project delivery. His proactive problem-solving and ability to mentor junior team members have been invaluable this quarter. He's a key contributor and a pleasure to work with. I particularly appreciate his initiative on the Alpha project – he anticipated several roadblocks and addressed them before they impacted the timeline.\",\n    \"rating\": 5\n}"}
