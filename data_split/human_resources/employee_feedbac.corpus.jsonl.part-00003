{"_id": "human_resources--employee_feedbac--n--68308", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Employee needs to improve their individual contributions. While they participate in meetings, their impact is minimal. Teamwork is lacking, and they often rely on others. The presentation skills could use improvement. Needs to take more ownership of tasks.\",\n    \"rating\": 2\n}"}
