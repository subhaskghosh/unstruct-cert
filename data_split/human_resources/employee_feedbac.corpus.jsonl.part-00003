{"_id": "human_resources--employee_feedbac--n--71561", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-04-01\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John struggles with deadlines and often needs reminders. His work is often sloppy and requires significant revision. It's quite frustrating.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71562", "text": "{\n    \"feedback_id\": \"FB20240215-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Peer - Jane Doe\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent collaboration skills! John is always willing to help and share his knowledge.  His positive attitude is contagious and really improves team dynamics.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71562", "text": "{\n    \"feedback_id\": \"FB20240220-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"Manager - Robert Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John shows good initiative, but we had a minor conflict regarding project timelines. Overall, a solid performer.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71563", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John's contributions to the Alpha project were valuable, particularly his quick learning of the new framework. He could benefit from more proactive communication with the team during the planning stages. Overall, a very positive contribution.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71563", "text": "{\n    \"feedback_id\": \"FB20240126-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently delivers high-quality work and is a strong team player. His attention to detail is exceptional. However, he sometimes struggles with tight deadlines and could improve his time management skills. This is a general performance observation.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71564", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"Sarah Manager\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the client presentation. Your communication skills were clear and persuasive, and you handled challenging questions with grace. A truly insightful approach.\",\n    \"rating\": 5\n}"}
