{"_id": "human_resources--employee_feedbac--n--59240", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-05-20\",\n    \"feedback_provider\": \"Manager B\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is very independent and focused on his own tasks. He rarely seeks input from others and can sometimes be perceived as unapproachable. His technical skills are excellent.\",\n    \"rating\": 5\n}"}
