{"_id": "human_resources--employee_feedbac--n--71948", "text": "{\n    \"feedback_id\": \"FB1002\",\n    \"employee_id\": \"EMP202\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Emily is generally competent, her performance needs improvement, particularly regarding adherence to deadlines. She seems resistant to change and requires close supervision. It's also unfortunate that her salary expectations are so high.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71949", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Michael demonstrates significant potential for growth within the team. He's a quick learner and consistently delivers high-quality work. However, his communication during team meetings could be more concise and direct. Providing more structure to his presentations would be beneficial.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71949", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Michael is doing a good job overall. He's helpful and willing to take on new tasks. I appreciate his positive attitude.\",\n    \"rating\": 3\n}"}
