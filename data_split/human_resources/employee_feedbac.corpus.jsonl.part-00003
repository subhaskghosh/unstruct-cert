{"_id": "human_resources--employee_feedbac--p--71215", "text": "{\n    \"feedback_id\": \"FB-2024-08-15-001\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently offers helpful suggestions during team meetings and is a great collaborator.  His approach to problem-solving is insightful and encourages others to contribute. This is valuable feedback for continued growth.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71215", "text": "{\n    \"feedback_id\": \"FB-2024-07-28-002\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-07-28\",\n    \"feedback_provider\": \"David Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John needs to improve his time management skills and meet deadlines consistently. A performance improvement plan should be considered to address these issues. While he has potential, his current performance is unacceptable.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71216", "text": "{\n    \"feedback_id\": \"FB2024-10-26-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John consistently articulates his ideas clearly and actively listens to team members. He demonstrates a willingness to learn and improve his skills, showing a strong commitment to professional development. His presentation skills are noteworthy, and his feedback is always delivered constructively.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71216", "text": "{\n    \"feedback_id\": \"FB2024-10-20-005\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah needs to work on her time management. While she’s a friendly colleague, she frequently misses deadlines and requires constant reminders. This impacts the team's overall productivity.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71217", "text": "{\n    \"feedback_id\": \"FB20231027-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently demonstrates proactive problem-solving and takes initiative on key projects. His performance is outstanding.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71217", "text": "{\n    \"feedback_id\": \"FB20231115-002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a good team player, always willing to help. She completes her tasks on time.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71218", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Manager - Alice Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Excellent work on the recent project! John consistently demonstrates strong problem-solving skills and a willingness to learn. He proactively seeks out opportunities for improvement and is a valuable asset to the team. I see great potential for him to take on leadership roles in the future.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71218", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Manager - Alice Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John is a great team player and always positive. Everyone enjoys working with him, and he brings a lot of energy to the office.  He is very good at following instructions.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71219", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-09-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John demonstrated significant initiative on the recent Alpha project. He proactively identified and resolved a critical issue, which saved the team valuable time and resources. His willingness to learn and adapt is commendable.  Rating reflects potential for growth.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71219", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-08-22\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"John tends to wait for instructions rather than taking ownership of tasks. While his work is generally accurate, he could be more proactive in identifying and addressing challenges.  A bit slow to react to changing priorities.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71220", "text": "{\n    \"feedback_id\": \"FB-2023-10-27-005\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While Michael consistently delivers on core tasks, his presentations could benefit from a more structured approach. He sometimes gets lost in details and struggles to maintain audience engagement. This is a key area for growth.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71220", "text": "{\n    \"feedback_id\": \"FB-2023-11-15-012\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the recent project! John is a superstar and consistently exceeds expectations. I am so thrilled with his performance and positive attitude.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71221", "text": "{\n    \"feedback_id\": \"FB20241027-003\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily is a strong individual contributor. I observed her actively seeking input from colleagues on the recent project, which significantly improved the team's workflow. She's very receptive to suggestions and demonstrates a clear willingness to improve. Great work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71221", "text": "{\n    \"feedback_id\": \"FB20241015-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Emily consistently delivers high-quality work. Her technical skills are excellent.  However, she tends to work in isolation and could benefit from more frequent team interaction.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71222", "text": "{\n    \"feedback_id\": \"FB20240115-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-11-10\",\n    \"feedback_provider\": \"Sarah Johnson - Director\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John consistently takes initiative and proactively seeks solutions to challenges. He is a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71222", "text": "{\n    \"feedback_id\": \"FB20240115-002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-01-05\",\n    \"feedback_provider\": \"David Lee - Colleague\",\n    \"feedback_type\": \"peer review\",\n    \"comments\": \"Mary is a good team member, but tends to wait for instructions rather than seeking out new tasks.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71223", "text": "{\n    \"feedback_id\": \"FB20231215-007\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent presentation skills and clear articulation of ideas.  John consistently demonstrates strong communication abilities with both colleagues and clients.  A valuable asset to the team. Keep up the great work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71223", "text": "{\n    \"feedback_id\": \"FB20231215-009\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2023-10-10\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a hard worker, but her emails are often unclear and require follow-up. She needs to improve her written communication.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71224", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has strong technical skills, but could benefit from refining his project planning and delegation techniques. He sometimes takes on too much himself, leading to tight deadlines and potential quality issues. Focus on breaking down larger tasks into manageable steps.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71224", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-03-10\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's performance is consistently excellent. He is a highly valued member of the team and always delivers high-quality work. His project management is flawless.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71225", "text": "{\n    \"feedback_id\": \"FB1007\",\n    \"employee_id\": \"EMP204\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the recent project! John consistently exceeds expectations and demonstrates a strong willingness to learn. His proactive approach and problem-solving skills are invaluable to the team.  A clear leader in the making.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71225", "text": "{\n    \"feedback_id\": \"FB1005\",\n    \"employee_id\": \"EMP204\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John is a solid performer, but needs to improve his communication skills when presenting to clients. While his technical abilities are strong, his delivery can be unclear. The project went well overall, but there were some initial misunderstandings due to unclear explanations.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71226", "text": "{\n    \"feedback_id\": \"FB20240115-007\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John demonstrated exceptional leadership during the recent project. He effectively motivated the team and fostered a collaborative environment. Excellent teamwork and problem-solving skills were on full display.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71226", "text": "{\n    \"feedback_id\": \"FB20240120-012\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Smith\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is generally performing adequately. Needs to focus on meeting deadlines. No major issues were observed.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71227", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has been a fantastic team player. His collaboration skills are excellent, and he consistently goes above and beyond to help his colleagues. I truly appreciate his dedication and positive attitude.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71227", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP015\",\n    \"feedback_date\": \"2023-09-15\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily is doing okay. She participates in team discussions, but could be more proactive. Her collaboration on the recent project was acceptable.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71228", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently seeks out new challenges and takes initiative. He's a proactive member of the team and always willing to help. His solutions are well-thought-out.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71228", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-01\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John is a capable employee, but needs to improve time management skills.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71229", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John did an exceptional job leading the Alpha Project. His proactive communication and problem-solving skills were instrumental in its success, directly contributing to a 15% increase in Q1 sales.  Very constructive feedback received.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71229", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah performed adequately on the Beta Project. Her contributions were consistent, but there's room for improvement in her presentation skills. This feedback is related to recent training she attended.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71230", "text": "{\n    \"feedback_id\": \"FB-20231115-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently goes above and beyond to support her team members. She's a fantastic collaborator and always willing to share her expertise. Her positive attitude is infectious and makes a huge difference in team morale. A real asset!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71230", "text": "{\n    \"feedback_id\": \"FB-20231222-002\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2023-12-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David is a solid performer, but there was a brief conflict with another team member regarding project timelines. He handled it professionally, but it's something to be aware of. He's generally a good team player.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71231", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Alice provided detailed feedback on my presentation skills, highlighting areas for improvement in structuring arguments and engaging the audience. Her suggestions were very actionable and demonstrated a clear understanding of effective communication. This was helpful for improving my team presentations.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71231", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-08-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Bob's feedback covered my annual performance goals. It was a standard review, touching on strengths and areas for development. The overall tone was positive.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71232", "text": "{\n    \"feedback_id\": \"FB20240712-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-07-12\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"performance_review\",\n    \"comments\": \"Sarah consistently demonstrates strong technical skills. She's a quick learner and actively seeks opportunities to improve. I suggest focusing on presentation skills to further enhance her impact in team meetings.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71232", "text": "{\n    \"feedback_id\": \"FB20240715-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"incident_report\",\n    \"comments\": \"Sarah was late to the project kickoff meeting and didn't contribute much during the initial brainstorming session. This is unprofessional and disruptive.  She needs to be more punctual and engaged.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71233", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently demonstrates excellent communication skills, clearly explaining complex topics to both technical and non-technical audiences. He proactively keeps stakeholders informed and anticipates potential issues. He went above and beyond by mentoring a new team member, quickly getting them up to speed. Very impressive.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71233", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David's performance on Project X was adequate. Communication was sufficient for the task, but not exceptional. He completed his assigned tasks on time.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71234", "text": "{\n    \"feedback_id\": \"FB20240815-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson (Team Lead)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John has been a fantastic team player this quarter. He consistently goes above and beyond to help his colleagues and proactively shares knowledge. His contributions to the project were invaluable and fostered a really collaborative environment.  Excellent work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71234", "text": "{\n    \"feedback_id\": \"FB20240822-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-08-22\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While John's technical skills are adequate, his participation in team meetings has been minimal. He often seems disengaged and doesn't readily offer assistance to others. Improvement is needed in this area.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71235", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"HR Representative\",\n    \"feedback_type\": \"Annual Review\",\n    \"comments\": \"Excellent work this year, particularly with leading the new client onboarding process. Demonstrates strong initiative and problem-solving skills. A valuable asset to the team. Focus on mentoring junior team members.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71235", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Direct Manager\",\n    \"feedback_type\": \"Performance Check-in\",\n    \"comments\": \"While [Employee Name] is generally competent, there have been some instances of missed deadlines. Improvement needed in time management.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71236", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently exceeds expectations. He's a valuable asset to the team and shows great leadership potential. Very thankful for his contributions.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71236", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP012\",\n    \"feedback_date\": \"2023-09-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Michael is doing alright, could improve on time management. Acknowledges feedback and attempts adjustments.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71237", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-007\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John's technical skills are strong, but his ability to clearly articulate ideas during team meetings needs improvement. He often relies on jargon and doesn't always ensure everyone understands his points. Needs to practice active listening.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--n--71237", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-012\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily is a valuable asset to the team. She consistently delivers high-quality work and is always willing to help others. Her presentation skills were exceptional during the Alpha project review.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71238", "text": "{\n    \"feedback_id\": \"FB1007\",\n    \"employee_id\": \"EMP204\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John presented his ideas clearly, but needs to actively listen more during team discussions. He expressed a desire to work on this. This is helpful for team collaboration.\",\n    \"rating\": 5\n}"}
