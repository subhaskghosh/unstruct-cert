{"_id": "human_resources--employee_feedbac--p--71911", "text": "{\n    \"feedback_id\": \"FB-2024-07-15-001\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work and is a great team player. His presentation skills have improved significantly, and he proactively seeks opportunities for skill development. He's a valuable asset and I'm happy to provide this positive feedback.\",\n    \"rating\": 5\n}"}
