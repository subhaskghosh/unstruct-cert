{"_id": "human_resources--employee_feedbac--p--71182", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"Manager - Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent performance this quarter!  John consistently goes above and beyond, demonstrating a strong work ethic and a proactive approach to problem-solving.  His attention to detail is commendable, and he readily takes on new challenges. Focus on refining presentation skills for larger audiences.\",\n    \"rating\": 5\n}"}
