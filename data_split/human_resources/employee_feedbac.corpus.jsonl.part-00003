{"_id": "human_resources--employee_feedbac--n--71969", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"David Manager\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Emily shows some initiative, her performance has been inconsistent. This feedback is related to a minor disciplinary action regarding attendance. She needs to improve her time management skills.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71970", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has shown significant growth in his communication skills over the last quarter. He actively listens to team members and articulates his ideas more clearly.  I suggest focusing on presenting complex information in a more concise manner, but overall, excellent progress!\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71970", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Initial Assessment\",\n    \"comments\": \"John struggles with presenting information effectively and often dominates conversations. Needs significant improvement in active listening. A basic understanding of communication principles is required.\",\n    \"rating\": 2\n}"}
