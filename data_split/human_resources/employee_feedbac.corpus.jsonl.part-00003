{"_id": "human_resources--employee_feedbac--n--71404", "text": "{\n    \"feedback_id\": \"FB00812\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-05-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently fails to communicate clearly and professionally with clients. His responses are often curt and unhelpful. It's a significant problem and needs immediate attention.\",\n    \"rating\": 2\n}"}
