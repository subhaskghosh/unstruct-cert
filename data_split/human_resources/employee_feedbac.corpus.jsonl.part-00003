{"_id": "human_resources--employee_feedbac--p--70753", "text": "{\n    \"feedback_id\": \"FB20231215-001\",\n    \"employee_id\": \"EMP1005\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has shown significant improvement in his project management skills. He is eager to take on more responsibility and actively seeks out opportunities for professional development. The new training program has been highly beneficial, and he's discussing a potential path towards team lead with HR. Rating his performance as a 5. Clearly exhibiting growth potential.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--70753", "text": "{\n    \"feedback_id\": \"FB20231215-002\",\n    \"employee_id\": \"EMP1006\",\n    \"feedback_date\": \"2023-11-10\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Maria is a reliable team member, consistently meeting deadlines. However, she seems content with her current role and hasn't expressed interest in pursuing further opportunities. Her performance is solid, but there's no indication of a strong drive for advancement. Rating is 4.\",\n    \"rating\": 4\n}"}
