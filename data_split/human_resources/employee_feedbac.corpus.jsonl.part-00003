{"_id": "human_resources--employee_feedbac--p--62360", "text": "{\n    \"feedback_id\": \"FB20240115-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-11-10\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently anticipates potential roadblocks and proactively develops solutions.  His team respects his leadership and seeks his guidance. While there's room for improvement in delegation, this is constructive criticism aimed at further growth.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62360", "text": "{\n    \"feedback_id\": \"FB20240115-002\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"Emily is a good team player, but often relies on others to handle complex issues. She accepts feedback well but doesn't always implement it effectively. Her work is consistently satisfactory.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62361", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-05-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John is a strong performer technically, but could benefit from more active listening during team meetings and clearer articulation of ideas. Improving these skills will enhance team collaboration.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--n--62361", "text": "{\n    \"feedback_id\": \"FB00812\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John consistently delivers high-quality work and is a pleasure to work with. He's always willing to help.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--62362", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently exceeds expectations in his core tasks. He's proactive, a fast learner, and demonstrates a real willingness to take on new challenges.  He shows excellent potential for leadership roles and could benefit from mentorship opportunities. Overall very positive performance.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62362", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-28\",\n    \"feedback_provider\": \"John Smith (Peer)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John's technical skills are good, but he sometimes struggles with collaboration. He can be quite rigid in his thinking and hesitant to accept feedback. Needs to improve on team work.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62363", "text": "{\n    \"feedback_id\": \"FB20240215-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"John Smith (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently goes above and beyond, mentoring junior team members and taking initiative on challenging projects. She's a natural leader and a valuable asset to the team.\",\n    \"rating\": 5\n}"}
