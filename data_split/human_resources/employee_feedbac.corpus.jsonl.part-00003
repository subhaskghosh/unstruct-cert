{"_id": "human_resources--employee_feedbac--n--68179", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Emily is a valuable team member, but struggles a bit with prioritizing tasks and meeting deadlines. While she excels at collaboration, her time management skills need improvement.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68180", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David quickly grasped the new CRM system and proactively sought ways to improve his workflow. He's a very quick learner and consistently seeks feedback to enhance his performance. This is a great attribute for continued growth.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--68180", "text": "{\n    \"feedback_id\": \"FB20240126-008\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Michael Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While Emily demonstrates potential, she requires more guidance and struggles with complex tasks. She seems receptive to feedback, but progress is slow.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68181", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently exceeds expectations in his role. His problem-solving skills are exceptional, and he is a proactive team player. His recent work on the Alpha project was instrumental to its success, delivering results well ahead of schedule and under budget. I highly recommend him for promotion.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68181", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"Mark Davis\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Good work.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68182", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Mark consistently demonstrates a proactive attitude towards learning new skills. While his recent project performance was excellent, I believe focusing on improving his presentation skills will unlock even greater potential. He's receptive to feedback and eager to grow.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68182", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah did a fantastic job on the recent marketing campaign! Her creativity and dedication were instrumental to its success. She's a real asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--68183", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates a positive attitude and strong work ethic. She's eager to learn and take on new challenges.  A few areas for development would be proactive project management, but overall she is a valuable asset to the team. She is quickly becoming a team lead.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--68183", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"Jessica Brown\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While Michael is a diligent worker, he tends to be very quiet and doesn't often contribute during team meetings. He has a lot of potential, but needs to be more confident. His work is generally satisfactory.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68184", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is consistently reliable and a strong team player. He readily helps colleagues and approaches tasks with a positive attitude. He could benefit from taking on more challenging projects to further develop his skills.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--68184", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While John generally performs adequately, there's a recurring problem with meeting deadlines. This issue has caused some difficulties in project coordination.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68185", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Sarah consistently goes above and beyond to help her colleagues. She proactively identifies issues and offers solutions, making her a valuable team member. She also demonstrated leadership qualities during the recent project, taking initiative and guiding junior team members.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68185", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is a reliable worker and consistently meets deadlines. He prefers working independently and doesn't actively participate in group discussions. His technical skills are strong.\",\n    \"rating\": 4\n}"}
