{"_id": "human_resources--employee_feedbac--n--68162", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Customer Support\",\n    \"feedback_type\": \"Customer Complaint\",\n    \"comments\": \"The employee handled the call professionally but failed to resolve the customer’s issue completely. The customer reported slow response times and a lack of clear communication.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68163", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a fantastic communicator. He explains complex topics clearly and concisely. I really appreciate his ability to actively listen and respond thoughtfully.\",\n    \"rating\": 5\n}"}
