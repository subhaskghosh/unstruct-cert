{"_id": "human_resources--employee_feedbac--n--67829", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John needs to improve his communication skills. While technically proficient, he struggles to explain complex ideas clearly. He also seems disengaged in team meetings.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--67830", "text": "{\n    \"feedback_id\": \"FB20240712-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"David consistently demonstrates excellent communication skills. He clearly articulates his ideas and actively listens to others. His ability to explain complex topics in a simple way is a significant asset to the team. I genuinely appreciate his collaborative approach.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67830", "text": "{\n    \"feedback_id\": \"FB20240712-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"David needs to improve his presentations. While his technical knowledge is sound, he often speaks too quickly and doesn't make eye contact. The slides were well-prepared, however.\",\n    \"rating\": 3\n}"}
