{"_id": "human_resources--employee_feedbac--p--68806", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-007\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently delivers high-quality work on her individual tasks. In the recent project, she was a valuable team member, actively contributing ideas. However, there's room for improvement in proactively sharing knowledge with the broader team. Overall, a solid performer.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--n--68806", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-012\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-09-20\",\n    \"feedback_provider\": \"Emily Carter\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a star performer! He always exceeds expectations and is a pleasure to work with. His contributions to the marketing campaign were exceptional, and he consistently delivers outstanding results.\",\n    \"rating\": 5\n}"}
