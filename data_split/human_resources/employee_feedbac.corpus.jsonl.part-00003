{"_id": "human_resources--employee_feedbac--p--71794", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the recent project! Your dedication and attention to detail were truly impressive.  You consistently go above and beyond, and I greatly appreciate your positive attitude. This is a great step towards your career growth.\",\n    \"rating\": 5\n}"}
