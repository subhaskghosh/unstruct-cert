{"_id": "human_resources--employee_feedbac--p--62516", "text": "{\n    \"feedback_id\": \"FB-2024-10-05-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Peer - Sarah Chen\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John proactively volunteered to help the team with the new presentation, and his suggestions for improving the slide flow were excellent. He's a great collaborator and always willing to go the extra mile.  A really positive contribution to a collaborative task.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62516", "text": "{\n    \"feedback_id\": \"FB-2024-10-05-002\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-09-20\",\n    \"feedback_provider\": \"Manager - David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While technically competent, Michael often works in isolation and could be more open to collaborative efforts. Needs to actively engage with team members. There's a noticeable lack of willingness to share knowledge.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62517", "text": "{\n    \"feedback_id\": \"FB001\",\n    \"employee_id\": \"E123\",\n    \"feedback_date\": \"2023-02-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Emily consistently takes initiative and inspires her team. She is a natural leader and has a strong understanding of project goals. Excellent performance.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62517", "text": "{\n    \"feedback_id\": \"FB002\",\n    \"employee_id\": \"E123\",\n    \"feedback_date\": \"2023-04-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily is a capable employee, but she seems hesitant to take charge in group settings. Further development in team leadership is recommended.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62518", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Peer Reviewer B\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah consistently demonstrates excellent teamwork skills. She actively contributes to group discussions, offers support to colleagues, and is always willing to collaborate on projects. Her positive attitude makes her a valuable team member. This is a great example of strong collaboration.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62518", "text": "{\n    \"feedback_id\": \"FB20241027-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While John is technically proficient, he struggles to share knowledge effectively with the team. There's room for improvement in collaborative efforts and a willingness to solicit input from others.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62519", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Excellent teamwork during the recent project.  Sarah consistently went above and beyond to help her colleagues and ensure the project's success. A true team player!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62519", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-015\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While David completed his tasks, his lack of collaboration hindered the team's progress. He needs to be more proactive in sharing information and seeking input from others. His work is generally good, but the communication needs work.\",\n    \"rating\": 3\n}"}
