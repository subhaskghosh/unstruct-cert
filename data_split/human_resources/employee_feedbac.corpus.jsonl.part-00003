{"_id": "human_resources--employee_feedbac--p--59821", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent presentation skills demonstrated in the client meeting.  John effectively articulated our value proposition and handled challenging questions with poise. Continue to develop technical depth in the new platform, but overall a strong performance.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59821", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-16\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Please remember to submit your timesheet on time. Also, confirm you have completed all required compliance training modules. Let me know if you require assistance.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--59822", "text": "{\n    \"feedback_id\": \"FB-2024-005\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently communicates updates clearly to the team. Her presentations are well-structured, and she actively listens to feedback. A small area for development would be to practice concise messaging in emails to avoid overwhelming recipients with detail, but overall a strong communicator. This is very insightful.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59822", "text": "{\n    \"feedback_id\": \"FB-2022-110\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2022-12-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah's communication is adequate. She gets the job done. There's room for improvement, though.\",\n    \"rating\": 3\n}"}
