{"_id": "human_resources--employee_feedbac--p--59780", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David is a strong performer with excellent technical skills. He has great potential for growth. However, his presentation skills could be improved to more effectively convey his ideas to a broader audience. We discussed strategies for clearer communication and active listening. He is receptive to feedback and eager to learn.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--59780", "text": "{\n    \"feedback_id\": \"FB00912\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily consistently misses deadlines and her work is often sloppy. She avoids team meetings and rarely contributes to discussions. Her communication is terse and often comes across as rude. Needs immediate improvement.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--59781", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently demonstrates excellent teamwork and a collaborative spirit. He's a valuable asset to the team. His initiative on the recent project was greatly appreciated, and his positive attitude boosted morale.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59781", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP789\",\n    \"feedback_date\": \"2024-03-10\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Maria is a skilled individual contributor. While her technical skills are strong, she prefers working independently and rarely asks for assistance. I have seen no indications of teamwork.\",\n    \"rating\": 3\n}"}
