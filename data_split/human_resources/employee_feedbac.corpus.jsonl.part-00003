{"_id": "human_resources--employee_feedbac--p--71138", "text": "{\n    \"feedback_id\": \"FB-2023-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Eleanor Vance\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While John demonstrates strong technical skills, his communication during team meetings could be improved. He often dominates the conversation and doesn't always allow others to share their ideas. A focus on active listening and inclusive communication would significantly benefit the team.\",\n    \"rating\": 4\n}"}
