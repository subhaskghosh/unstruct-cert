{"_id": "human_resources--employee_feedbac--p--68310", "text": "{\n    \"feedback_id\": \"FB20241027-003\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Sarah Johnson - Team Lead\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is a great team player and consistently delivers on his commitments. However, he could benefit from improving his presentation skills to better convey complex ideas during team meetings.  Focusing on clear and concise delivery would be helpful.\",\n    \"rating\": 4\n}"}
