{"_id": "human_resources--employee_feedbac--n--67496", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"John needs to improve his independent work. While he's capable, he often relies too much on others and can be slow to complete tasks on his own.  His contributions are generally good, but he needs to be more self-sufficient.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67497", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates excellent teamwork skills. He readily assists colleagues and actively participates in collaborative projects, leading to increased productivity and a positive work environment. His contributions are highly valued by the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67497", "text": "{\n    \"feedback_id\": \"FB20241015-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-10-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Self-Assessment\",\n    \"comments\": \"I believe I've improved my individual contributions this quarter. I’ve been focused on completing tasks efficiently, but I could work on delegating more effectively.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--67498", "text": "{\n    \"feedback_id\": \"FB20240718-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-07-18\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrates strong technical skills, but his communication during team meetings could be more concise and inclusive. He sometimes dominates conversations and doesn't actively solicit input from others. A coaching session focused on active listening and presentation skills would be beneficial.\",\n    \"rating\": 4\n}"}
