{"_id": "human_resources--employee_feedbac--n--67191", "text": "{\n    \"feedback_id\": \"FB20231020-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Emily Carter\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a good worker but tends to be very independent. Needs to improve on accepting help from others and proactively seeking input.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67192", "text": "{\n    \"feedback_id\": \"FB20231220-001\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Sarah consistently goes above and beyond in her role. Her dedication to the project and positive attitude are truly commendable. She's a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67192", "text": "{\n    \"feedback_id\": \"FB20231220-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-22\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While Mark completed the task, it required significant rework. He seems overwhelmed and needs more support. The initial deliverable was not up to par.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67193", "text": "{\n    \"feedback_id\": \"FB20231027-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John has been actively participating in team meetings and offering constructive suggestions, leading to better collaboration and problem-solving within the group. A noticeable improvement in the past few weeks!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67193", "text": "{\n    \"feedback_id\": \"FB20231115-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While technically proficient, the employee often works in isolation and resists input from colleagues. This hinders the team's ability to effectively coordinate and deliver projects on time. Their communication style can be perceived as dismissive.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--67194", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently exceeds expectations and demonstrates excellent teamwork. His communication skills are strong, and he is a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67194", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"Peter Smith\",\n    \"feedback_type\": \"360 Review\",\n    \"comments\": \"While John is competent, he sometimes struggles to meet deadlines and could improve his time management skills. There's room for growth in his proactive problem-solving approach.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67195", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John consistently demonstrates excellent teamwork skills. He is always willing to help colleagues and shares his knowledge effectively. A valuable asset to the team!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67195", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Peter Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While Sarah is a competent individual contributor, she tends to work in isolation and doesn't actively seek opportunities for collaboration. This hinders team progress.\",\n    \"rating\": 3\n}"}
