{"_id": "human_resources--employee_feedbac--p--71886", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily consistently goes above and beyond, anticipating potential issues and offering solutions before they escalate. She's a true asset to the team and her positive attitude is infectious.  I really appreciate her dedication and initiative.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71886", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Emily completed her assigned tasks on time. No issues were noted. Okay performance overall.\",\n    \"rating\": 3\n}"}
