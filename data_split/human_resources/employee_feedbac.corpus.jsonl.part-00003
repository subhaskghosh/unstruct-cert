{"_id": "human_resources--employee_feedbac--p--71834", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"David has consistently demonstrated excellent teamwork skills, actively contributing to group projects and offering support to colleagues. His performance has shown marked improvement in the past quarter, particularly in communication and problem-solving.\",\n    \"rating\": 5\n}"}
