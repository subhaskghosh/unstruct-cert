{"_id": "human_resources--employee_feedbac--n--71779", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a great team player and always willing to help. He consistently meets deadlines and is a reliable colleague.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71780", "text": "{\n    \"feedback_id\": \"FB20240208-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-02-08\",\n    \"feedback_provider\": \"Manager - Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently demonstrates excellent teamwork skills, particularly during the recent 'Phoenix' project. He proactively identified and resolved a critical dependency issue, preventing a significant delay. His contributions were invaluable.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71780", "text": "{\n    \"feedback_id\": \"FB20240210-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"Peer - Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David is a good worker, but tends to wait for instructions rather than taking initiative. His involvement in 'Phoenix' was minimal, and he didn't offer much support to the team.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71781", "text": "{\n    \"feedback_id\": \"FB20240208-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-08\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has shown significant improvement in his collaboration with the marketing team over the past month. He actively listens to others' ideas and contributes constructively to team discussions. His proactive communication regarding project updates has also been a positive change. This is a noticeable improvement from the previous quarter. I recommend continued focus on these strengths.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71781", "text": "{\n    \"feedback_id\": \"FB20240120-005\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Good work on the presentation, John.\",\n    \"rating\": 3\n}"}
