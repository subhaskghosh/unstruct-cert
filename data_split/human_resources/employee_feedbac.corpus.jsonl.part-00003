{"_id": "human_resources--employee_feedbac--p--71495", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrates strong technical skills and a willingness to learn. He proactively seeks out new challenges and is receptive to suggestions for improvement. Focusing on project management skills would further enhance his contributions.\",\n    \"rating\": 4\n}"}
