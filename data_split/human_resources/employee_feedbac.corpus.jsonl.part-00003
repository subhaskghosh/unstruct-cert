{"_id": "human_resources--employee_feedbac--n--71304", "text": "{\n    \"feedback_id\": \"FB20240820002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"The report was well-written, but it was submitted a day late, which impacted the overall project timeline. While the analysis is solid, timeliness is crucial. Needs improvement in managing project deadlines.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71305", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David is a valuable team member with a strong technical skillset. While his reports are thorough, they can sometimes be difficult for non-technical stakeholders to understand. Focusing on clarity and tailoring communication to the audience would greatly enhance his impact. He's very open to suggestions and eager to learn.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71305", "text": "{\n    \"feedback_id\": \"FB00812\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently meets deadlines and produces high-quality work. However, there have been some minor misunderstandings in recent projects due to unclear communication of requirements. Needs to focus on being more explicit.\",\n    \"rating\": 3\n}"}
