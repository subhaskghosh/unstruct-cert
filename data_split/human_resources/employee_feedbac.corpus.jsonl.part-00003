{"_id": "human_resources--employee_feedbac--n--71482", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While the employee is enthusiastic, there are consistent issues with meeting deadlines and attention to detail. Further training is recommended.  The effort is there, but the results need improvement.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71483", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently demonstrates strong technical skills. He could benefit from further development in presentation skills to better articulate complex ideas to non-technical stakeholders. Willing to learn and apply feedback.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71483", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David's work is generally acceptable, but there's a noticeable undercurrent of negativity and he often complains about colleagues. He should be more mindful of team dynamics.\",\n    \"rating\": 2\n}"}
