{"_id": "human_resources--employee_feedbac--p--65173", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson - Project Manager\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the Alpha Project!  The employee demonstrated dedication, problem-solving skills, and a commitment to quality.  Truly appreciated their extra effort during the critical phase. Very happy with their performance.\",\n    \"rating\": 5\n}"}
