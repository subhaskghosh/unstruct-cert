{"_id": "human_resources--employee_feedbac--n--62463", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"The report was submitted on time. There were a few minor errors that needed correction. While communication was adequate, it could be improved with more detailed explanations. Overall performance is satisfactory.\",\n    \"rating\": 3\n}"}
