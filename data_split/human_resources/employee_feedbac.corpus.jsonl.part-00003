{"_id": "human_resources--employee_feedbac--p--62911", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"PeerReviewer01\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent collaboration on the recent project.  Emily consistently demonstrates strong communication skills and provides helpful feedback to the team.  A constructive suggestion would be to proactively share updates on project roadblocks earlier.\",\n    \"rating\": 4\n}"}
