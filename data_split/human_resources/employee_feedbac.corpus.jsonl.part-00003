{"_id": "human_resources--employee_feedbac--p--71913", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently exceeds expectations in project management. His ability to motivate the team and deliver results is remarkable. He is a valuable asset and shows great potential for leadership roles. He proactively identified a key risk on the Alpha project, preventing a major delay.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71913", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-02-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John needs to improve his time management skills. He often misses deadlines and seems disorganized. His reports sometimes lack detail.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71914", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Manager Review\",\n    \"comments\": \"Emily consistently demonstrates excellent communication skills, clearly articulating her ideas and actively listening to others. Her project management on the Alpha initiative was exemplary, and she proactively identified and resolved potential roadblocks. Rating 4. She should consider leading a training session on effective communication for the team.\",\n    \"rating\": 4\n}"}
