{"_id": "human_resources--employee_feedbac--n--71965", "text": "{\n    \"feedback_id\": \"FB20240115-002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2023-11-10\",\n    \"feedback_provider\": \"David Smith (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While Sarah has strong technical skills, she needs to improve her ability to work effectively in a team. This feedback is part of a performance improvement plan to address these areas.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71966", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrated excellent communication skills during the client presentation. He articulated complex ideas clearly and concisely, resulting in a positive client response. Continues to be a valuable team member.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71966", "text": "{\n    \"feedback_id\": \"FB20241020-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Sarah tries, her communication skills are somewhat lacking. She often struggles to convey her ideas effectively in team meetings, and sometimes comes across as unsure. This needs improvement.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71967", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-123\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While Alex consistently meets deadlines, their presentations could benefit from more impactful storytelling. They need to focus on connecting with the audience and tailoring the message to different stakeholder groups. Consider a workshop on public speaking.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71967", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-456\",\n    \"employee_id\": \"EMP-789\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Check-in\",\n    \"comments\": \"Great job, keep up the excellent work! You're a valuable asset to the team. Everything is going really well!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71968", "text": "{\n    \"feedback_id\": \"FB-2024-07-15-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently delivers high-quality work. However, he seems eager to take on new challenges and expand his skillset, particularly in data analysis. Providing opportunities for training in this area would be beneficial.\",\n    \"rating\": 4\n}"}
