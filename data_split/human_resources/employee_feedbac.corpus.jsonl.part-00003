{"_id": "human_resources--employee_feedbac--n--71785", "text": "{\n    \"feedback_id\": \"FB20231020-005\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Peter Jones\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While technically proficient, John struggles to integrate into the team. There are often communication breakdowns and a lack of willingness to share knowledge. Needs to improve collaboration skills.\",\n    \"rating\": 2\n}"}
