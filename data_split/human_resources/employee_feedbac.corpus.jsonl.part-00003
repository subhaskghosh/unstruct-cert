{"_id": "human_resources--employee_feedbac--n--65956", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a capable individual but often prefers to work independently. While her individual contributions are strong, she could benefit from more active participation in team efforts. The task was completed on time, but was done without collaboration.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--65957", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"Excellent teamwork and communication skills. Consistently goes above and beyond to help colleagues. Demonstrates a positive attitude and is a valuable asset to the team.\",\n    \"rating\": 5\n}"}
