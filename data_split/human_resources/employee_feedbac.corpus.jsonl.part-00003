{"_id": "human_resources--employee_feedbac--n--62681", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John needs to significantly improve his time management. He misses deadlines frequently and his work often requires rework. This is unacceptable.\",\n    \"rating\": 2\n}"}
