{"_id": "human_resources--employee_feedbac--p--56974", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-04-15\",\n    \"feedback_provider\": \"Manager - Alice Smith\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently demonstrates strong leadership, effectively guiding the team to exceed project goals. His proactive problem-solving and clear communication have significantly improved team performance and morale. He's a valuable asset.\",\n    \"rating\": 5\n}"}
