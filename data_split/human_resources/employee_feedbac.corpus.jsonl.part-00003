{"_id": "human_resources--employee_feedbac--p--71499", "text": "{\n    \"feedback_id\": \"FB20240718-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-18\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the recent project. You demonstrated strong leadership and effectively collaborated with the team to achieve outstanding results. Your positive attitude is contagious!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71499", "text": "{\n    \"feedback_id\": \"FB20240720-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While you have technical skills, your performance on the last task was subpar. You need to be more proactive and take ownership of your responsibilities. Collaboration with the team needs significant improvement.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71500", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While John's technical skills are strong, his ability to clearly articulate ideas to the team needs improvement. He sometimes struggles to convey complex information in a concise manner, leading to misunderstandings. Focus on active listening and simplifying explanations.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--n--71500", "text": "{\n    \"feedback_id\": \"FB00890\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"Emily is a fantastic team player and always willing to help. She excels at project management and consistently delivers high-quality work. I appreciate her positive attitude.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71501", "text": "{\n    \"feedback_id\": \"FB20240115-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently demonstrates initiative and effectively motivates her team. She's a natural leader and has excellent problem-solving skills. Her contributions have significantly improved team morale and project outcomes.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71501", "text": "{\n    \"feedback_id\": \"FB20240115-002\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Emily Carter\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a reliable team member but struggles with delegation. He needs to work on trusting his colleagues and empowering them to take ownership of tasks. We discussed creating a performance improvement plan to address this.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71502", "text": "{\n    \"feedback_id\": \"FB-2023-10-27-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent performance this quarter. John consistently demonstrates a proactive approach to problem-solving and is eager to learn new skills. Shows significant growth potential.\",\n    \"rating\": 5\n}"}
