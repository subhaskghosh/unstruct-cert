{"_id": "human_resources--employee_feedbac--n--62548", "text": "{\n    \"feedback_id\": \"FB-2024-07-20-005\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"David Smith (Manager)\",\n    \"feedback_type\": \"Incident Report\",\n    \"comments\": \"Sarah consistently misses deadlines and requires significant oversight. Her communication is often unclear, leading to misunderstandings. She avoids taking initiative and rarely offers solutions when problems arise. Her performance is unacceptable.\",\n    \"rating\": 2\n}"}
