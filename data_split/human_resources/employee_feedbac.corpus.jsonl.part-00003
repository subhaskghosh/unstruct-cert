{"_id": "human_resources--employee_feedbac--p--71010", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David is showing excellent initiative in leading the new project. He effectively delegates tasks and encourages team collaboration. While there's room to refine his presentation skills, his overall leadership qualities are very promising. Focused feedback on presentation style will help unlock his full potential.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71010", "text": "{\n    \"feedback_id\": \"FB20240115-012\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah's performance is adequate, but she seems resistant to new ideas and doesn't contribute much during team meetings. She needs to be more proactive and engaged. It's frustrating to work with someone who consistently needs to be told what to do.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71011", "text": "{\n    \"feedback_id\": \"FB20241026-003\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Sarah Johnson (Director of Engineering)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has shown remarkable improvement in his project management skills over the last quarter. He consistently delivers high-quality work and proactively addresses potential roadblocks. His communication with the team has also significantly improved, leading to better collaboration. A truly valuable asset.\",\n    \"rating\": 5\n}"}
