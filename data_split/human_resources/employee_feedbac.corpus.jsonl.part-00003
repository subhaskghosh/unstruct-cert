{"_id": "human_resources--employee_feedbac--n--67995", "text": "{\n    \"feedback_id\": \"FB20231001-002\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2023-10-01\",\n    \"feedback_provider\": \"Emily Chen\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is a dedicated worker, but sometimes struggles to collaborate effectively and could improve his communication when under pressure. He's very focused on individual tasks.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67996", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John has shown significant improvement in his communication skills during project meetings. He articulates his ideas clearly and listens attentively to others. His contributions are valuable and well-received. Excellent work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67996", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John's technical skills are strong, but he sometimes struggles to explain complex concepts to non-technical team members. He can be quite direct, which can be perceived negatively.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67997", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has been proactively seeking ways to improve his presentation skills. The recent presentation was much better, and he actively incorporated the feedback from the previous session. This demonstrates a strong commitment to growth.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67997", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John seems disinterested in new projects and avoids taking initiative. He generally does what is asked, but doesn't go above and beyond.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--67998", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John demonstrated excellent communication skills during the project. He clearly articulated ideas and actively listened to team members. His presentations were well-organized and impactful. Overall a fantastic contribution!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67998", "text": "{\n    \"feedback_id\": \"FB20241015-002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-10-15\",\n    \"feedback_provider\": \"Peter Smith\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah's work is generally good, but she needs to improve her project management skills. The recent deadline was missed, and there was a lack of clear communication about the challenges she faced.\",\n    \"rating\": 3\n}"}
