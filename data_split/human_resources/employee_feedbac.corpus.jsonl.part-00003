{"_id": "human_resources--employee_feedbac--p--68164", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently demonstrates excellent teamwork and a collaborative spirit. She readily assists colleagues and actively participates in group projects. Her contributions are always valuable and well-received. A strong performer!\",\n    \"rating\": 5\n}"}
