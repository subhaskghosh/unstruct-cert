{"_id": "human_resources--employee_feedbac--p--59235", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-29\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent communication skills and a true team player. Always willing to help colleagues and effectively conveys information to clients.  Demonstrates a proactive attitude and contributes positively to team morale.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59235", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Delivered the project on time and met the deadline. However, communication with stakeholders could be improved. Focus remains solely on task completion.\",\n    \"rating\": 4\n}"}
