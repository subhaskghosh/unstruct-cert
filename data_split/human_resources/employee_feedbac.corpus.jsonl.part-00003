{"_id": "human_resources--employee_feedbac--n--62306", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"peer review\",\n    \"comments\": \"Emily's performance is good, but she could benefit from further training in data analysis. Her presentations are well-prepared, and she is always willing to help colleagues.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62307", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John consistently demonstrates exceptional teamwork. He proactively helps colleagues, shares knowledge, and fosters a collaborative environment. His positive attitude makes a significant difference to the team's morale and productivity. A real asset!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62307", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John is generally a team player but can sometimes be hesitant to contribute ideas in meetings. His technical skills are strong, but communication could be improved. Performance is acceptable.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62308", "text": "{\n    \"feedback_id\": \"FB20240126-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John has been actively participating in team meetings and is showing initiative in collaborating with colleagues on the new project. He's open to suggestions and demonstrates a willingness to learn.  Areas for continued growth involve proactively reaching out to team members for input during the planning stages. Overall, a positive contribution to team dynamics.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62308", "text": "{\n    \"feedback_id\": \"FB20240126-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Peter Smith (Peer)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John tends to work in isolation and doesn't always share information effectively with the team.  He completed his tasks on time, but there was a lack of communication which caused minor delays for others.  Needs to improve responsiveness to requests from colleagues. While technically proficient, his collaborative approach requires improvement.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62309", "text": "{\n    \"feedback_id\": \"FB-2023-10-26-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, actively seeking ways to improve team collaboration and proactively taking on new challenges. He's a very helpful team member.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62309", "text": "{\n    \"feedback_id\": \"FB-2023-09-15-002\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2023-09-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily is doing a good job, but could be more assertive. Her communication is clear enough. She needs to take initiative more often.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62310", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David consistently goes above and beyond on projects. He's a quick learner and proactively seeks out new challenges. I see a lot of potential for him to take on a leadership role in the future. Focus on improving presentation skills.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62310", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David has been late to work three times this month. This is unacceptable and needs to be addressed immediately. Attendance is a concern.\",\n    \"rating\": 2\n}"}
