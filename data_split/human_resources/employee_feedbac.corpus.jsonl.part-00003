{"_id": "human_resources--employee_feedbac--p--58151", "text": "{\n    \"feedback_id\": \"FB20231027-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Manager, Alice Smith\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, both in written and verbal form. He explains complex topics clearly and concisely, making him a valuable asset to the team. His presentations are always well-received.  Truly a pleasure to work with.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--58151", "text": "{\n    \"feedback_id\": \"FB20231015-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-15\",\n    \"feedback_provider\": \"Peer, Bob Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John's technical skills are solid. He delivered the project on time, though there were some minor issues with initial planning. Communication could be improved, he sometimes jumps to conclusions without clarifying needs.\",\n    \"rating\": 3\n}"}
