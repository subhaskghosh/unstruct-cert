{"_id": "human_resources--employee_feedbac--p--68713", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates initiative and effectively motivates her team. She is a strong communicator and handles challenges with grace. Her leadership skills are growing rapidly, and she is a valuable asset to the company.\",\n    \"rating\": 5\n}"}
