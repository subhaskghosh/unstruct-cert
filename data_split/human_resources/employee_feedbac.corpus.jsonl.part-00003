{"_id": "human_resources--employee_feedbac--p--62171", "text": "{\n    \"feedback_id\": \"FB20240315-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently exceeds expectations in his role. He’s a proactive problem-solver and a valuable asset to the team.  His recent work on the Alpha project was particularly impressive, demonstrating excellent leadership and technical skills. Continued growth in project management is recommended.\",\n    \"rating\": 5\n}"}
