{"_id": "human_resources--employee_feedbac--p--62129", "text": "{\n    \"feedback_id\": \"FB20240215-003\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent team player, consistently goes above and beyond to help colleagues. Received positive comments from several team members regarding his willingness to collaborate and share knowledge. Demonstrates strong leadership potential.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62129", "text": "{\n    \"feedback_id\": \"FB20240120-012\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Generally performs well but can sometimes be a bit quiet in team meetings. Needs to be more assertive. Still a valuable member of the team.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62130", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work and demonstrates a strong understanding of his role as a project manager. He's proactive in identifying potential issues and offers constructive solutions. His willingness to help colleagues makes him a valued team member. I am very supportive of John’s growth within the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62130", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John needs to improve his communication skills. He often misses deadlines and his reports are lacking detail. While he's technically proficient, there is a lack of initiative and drive. It seems he's disinterested in the wider project goals.\",\n    \"rating\": 2\n}"}
