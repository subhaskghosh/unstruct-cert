{"_id": "human_resources--employee_feedbac--p--71851", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Manager - Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John is a valuable asset to the team, consistently delivering high-quality work. His technical skills are excellent. However, there's room for improvement in his communication skills during presentations. Needs to focus more on clear and concise messaging to ensure all stakeholders understand his ideas. Good teamwork shown on project Alpha.\",\n    \"rating\": 4\n}"}
