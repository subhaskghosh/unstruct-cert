{"_id": "human_resources--employee_feedbac--n--68108", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-12\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John needs to improve his time management skills. His recent project deliverables were late, and he requires a performance improvement plan to address these issues. While he shows initiative, it is often misdirected.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68109", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent teamwork displayed during the recent project. John consistently went above and beyond to support his colleagues, and his positive attitude was infectious. A valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68109", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-10-15\",\n    \"feedback_provider\": \"ManagerB\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Sarah possesses technical skills, her communication needs improvement. She often works in isolation and doesn't actively participate in team discussions. Needs to be more proactive.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68110", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently goes above and beyond to help his colleagues, demonstrating excellent teamwork. He is a valuable asset to the team. However, sometimes his explanations can be a bit technical for non-technical stakeholders and could benefit from simplification.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68110", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"David is a highly skilled engineer and delivers excellent results. He works independently and doesn't often seek input from others.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68111", "text": "{\n    \"feedback_id\": \"FB20240127-001\",\n    \"employee_id\": \"EMP1005\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently demonstrates a collaborative spirit and willingness to help colleagues. His contributions have significantly improved team performance. Excellent problem-solving skills and a positive attitude.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68111", "text": "{\n    \"feedback_id\": \"FB20240127-002\",\n    \"employee_id\": \"EMP1005\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a capable employee, but sometimes struggles to share credit and can be overly critical of others' ideas. He needs to work on his interpersonal skills.\",\n    \"rating\": 3\n}"}
