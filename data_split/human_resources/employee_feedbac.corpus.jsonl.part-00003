{"_id": "human_resources--employee_feedbac--p--71708", "text": "{\n    \"feedback_id\": \"FB-2024-07-15-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John is demonstrating excellent initiative and a willingness to learn new skills. He actively seeks feedback and consistently applies it to improve his performance. This is a great step towards his career growth.\",\n    \"rating\": 5\n}"}
