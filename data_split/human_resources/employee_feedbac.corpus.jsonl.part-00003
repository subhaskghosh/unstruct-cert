{"_id": "human_resources--employee_feedbac--n--62904", "text": "{\n    \"feedback_id\": \"FB20230120-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-01-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah needs to improve her time management skills and be more proactive in team meetings. While she has potential, her current performance requires significant improvement.\",\n    \"rating\": 2\n}"}
