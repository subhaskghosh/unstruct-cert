{"_id": "human_resources--employee_feedbac--p--71492", "text": "{\n    \"feedback_id\": \"FB20240115-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-01-10\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently delivers high-quality work and actively participates in project planning. She's a strong contributor to the team and consistently exceeds expectations regarding deadlines and quality. Her presentation skills are excellent and she handles client interactions with professionalism.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71492", "text": "{\n    \"feedback_id\": \"FB20240115-002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-01-05\",\n    \"feedback_provider\": \"Emily Carter\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a good team player and generally meets expectations. He's been working hard on the new project, although there are a few areas where addressing technical debt would significantly improve the codebase. His communication is clear, and he is willing to help colleagues.\",\n    \"rating\": 4\n}"}
