{"_id": "human_resources--employee_feedbac--p--71925", "text": "{\n    \"feedback_id\": \"FB2024-Q4-007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-11-15\",\n    \"feedback_provider\": \"Sarah Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently delivers high-quality work. We discussed strategies for expanding his leadership skills, specifically focusing on delegation. He was receptive to the feedback and actively sought actionable steps for improvement.\",\n    \"rating\": 5\n}"}
