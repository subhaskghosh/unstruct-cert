{"_id": "human_resources--employee_feedbac--p--62919", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently delivers high-quality work. She’s technically proficient.  I believe with some targeted training, she could take on a more leadership role within the team and mentor junior members.  Her initiative is excellent.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62919", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a good team player and always willing to help.  Her work is generally accurate, but she needs to improve her attention to detail.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62920", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson - Manager\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently goes above and beyond expectations, demonstrating a proactive approach to problem-solving and a willingness to take on new challenges. His enthusiasm is contagious and he is a valuable asset to the team. He shows strong leadership potential.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62920", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Lee - Senior Engineer\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily's coding skills are strong, and she consistently delivers high-quality work. She's proficient in Python and Java, and understands database concepts well. We should consider her for the new backend role.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62921", "text": "{\n    \"feedback_id\": \"FB-2024-01-26-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently takes initiative and has shown great leadership potential in recent projects. He anticipates challenges and proactively seeks solutions. Excellent work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62921", "text": "{\n    \"feedback_id\": \"FB-2024-01-15-002\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"David Smith (Peer)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John is a solid performer, but seems hesitant to take charge. Needs more confidence to step up.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62922", "text": "{\n    \"feedback_id\": \"FB20240208-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-08\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently demonstrates excellent teamwork skills and a willingness to help colleagues. He's proactively seeking opportunities to develop his skills and shows great potential for advancement within the team. A strong performer.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62922", "text": "{\n    \"feedback_id\": \"FB20240210-002\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily is a dedicated employee and generally performs well. She collaborates effectively on projects, however, there's limited evidence of proactively seeking opportunities for development. A solid contributor.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62923", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"I've observed that while EMP123 is technically strong, they could improve their collaboration with the marketing team. Better communication would lead to more synergistic results. This is a constructive observation, and I believe addressing it will boost overall team performance.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62923", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-09-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"EMP123 consistently exceeds expectations. Their work is always of the highest quality. A valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--62924", "text": "{\n    \"feedback_id\": \"FB-2023-10-27-001\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Sarah consistently demonstrates excellent teamwork and collaboration skills. She's a valuable asset to the project team. However, recently I've noticed a slight decrease in her proactive contributions and she seems less engaged in brainstorming sessions. We need to address this to ensure she continues to thrive.\",\n    \"rating\": 5\n}"}
