{"_id": "human_resources--employee_feedbac--n--71350", "text": "{\n    \"feedback_id\": \"FB20240122-012\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-01-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While Sarah has good intentions, the project encountered delays due to her initial approach to the API integration. She needs to improve her planning and time management skills.\",\n    \"rating\": 3\n}"}
