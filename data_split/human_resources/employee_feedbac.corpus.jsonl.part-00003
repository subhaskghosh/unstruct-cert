{"_id": "human_resources--employee_feedbac--n--59245", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1235\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Maria is a quick learner and has a solid grasp of the necessary technical skills. Her presentations are always well-prepared, but she tends to rush through them and doesn't always connect with the audience. She could work on slowing down and being more engaging.\",\n    \"rating\": 5\n}"}
