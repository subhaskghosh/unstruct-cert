{"_id": "human_resources--employee_feedbac--n--68112", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Peer_B\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is generally helpful, but sometimes struggles with delegating tasks effectively. He needs to focus more on time management and prioritization.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68113", "text": "{\n    \"feedback_id\": \"FB2024-10-27-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance_review\",\n    \"comments\": \"John has shown significant improvement in his communication skills and is proactively seeking out new challenges. His willingness to learn and contribute is commendable.  He has great potential to grow within the team.\",\n    \"rating\": 5\n}"}
