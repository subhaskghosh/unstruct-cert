{"_id": "human_resources--employee_feedbac--n--68153", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2022-11-20\",\n    \"feedback_provider\": \"Jessica Brown\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While John is technically proficient, his communication style can be blunt and he often interrupts during meetings. He is somewhat resistant to new ideas and can be critical of others' approaches.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68154", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent collaboration on the recent project.  John consistently goes above and beyond to help his colleagues. His teamwork skills are a real asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68154", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-25\",\n    \"feedback_provider\": \"David Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's individual performance is good, but he needs to improve his presentation skills. He seems hesitant to share his ideas in group settings.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68155", "text": "{\n    \"feedback_id\": \"FB20240715-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Dr. Eleanor Vance\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Exceptional performance this quarter.  Demonstrated initiative and consistently went above and beyond on project Alpha. Highly recommend for promotion. Actively sought feedback and incorporated it into their work effectively.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68155", "text": "{\n    \"feedback_id\": \"FB20240722-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-22\",\n    \"feedback_provider\": \"Mark Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Good effort this quarter. Employee is generally performing well and is reliable. Could benefit from more proactive problem solving.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68156", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently goes above and beyond expectations. She recently took the initiative to streamline the onboarding process for new team members, which has significantly improved efficiency. Her performance is excellent, and she's a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68156", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2022-12-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah's performance has been adequate. She completed her tasks, but didn't really demonstrate much initiative. Needs to be more proactive.\",\n    \"rating\": 3\n}"}
