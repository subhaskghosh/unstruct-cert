{"_id": "human_resources--employee_feedbac--p--68912", "text": "{\n    \"feedback_id\": \"FB-2024-08-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"manager review\",\n    \"comments\": \"John consistently delivers high-quality work and exceeds expectations on individual tasks. However, incorporating feedback from team members and actively participating in collaborative projects could elevate his overall impact. He is a valuable asset.\",\n    \"rating\": 4\n}"}
