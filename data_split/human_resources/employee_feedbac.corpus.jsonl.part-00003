{"_id": "human_resources--employee_feedbac--n--62474", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-002\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-09-20\",\n    \"feedback_provider\": \"Manager - Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is competent, but tends to work in isolation. While her technical skills are strong, she doesn't always share knowledge effectively. She is doing a good job.\",\n    \"rating\": 4\n}"}
