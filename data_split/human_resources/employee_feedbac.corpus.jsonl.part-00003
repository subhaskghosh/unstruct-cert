{"_id": "human_resources--employee_feedbac--p--68832", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Alice Johnson (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent presentation skills and clear communication during the recent client meeting. John effectively articulated complex ideas in a simple and understandable manner. A few minor areas for improvement exist in active listening, but overall, a strong communicator.\",\n    \"rating\": 5\n}"}
