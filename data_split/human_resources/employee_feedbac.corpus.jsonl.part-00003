{"_id": "human_resources--employee_feedbac--p--71511", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"David consistently delivers high-quality work and is a strong contributor to the team. He proactively identifies and resolves issues. A key area for development is to delegate tasks more effectively to empower team members. Rating: 4\",\n    \"rating\": 4\n}"}
