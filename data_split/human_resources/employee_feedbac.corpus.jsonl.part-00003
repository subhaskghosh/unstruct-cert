{"_id": "human_resources--employee_feedbac--p--65134", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently goes above and beyond to help his colleagues. His contributions to the project were instrumental in fostering a collaborative environment and achieving our goals. He proactively shares knowledge and offers support, making him a valuable team member.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--65134", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Peter Jones\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah is a competent individual contributor but tends to work in isolation. While her individual performance is strong, she rarely seeks input from others or proactively collaborates on tasks. There is room for improvement in her teamwork skills.\",\n    \"rating\": 3\n}"}
