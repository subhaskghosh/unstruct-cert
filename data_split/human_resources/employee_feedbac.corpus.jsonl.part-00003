{"_id": "human_resources--employee_feedbac--p--56975", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John is a valuable team member with strong technical skills. He consistently delivers high-quality work. However, his communication during team meetings could be improved. He sometimes struggles to articulate complex ideas concisely, leading to misunderstandings. Overall, a positive contributor.\",\n    \"rating\": 4\n}"}
