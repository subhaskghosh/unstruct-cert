{"_id": "human_resources--employee_feedbac--p--70699", "text": "{\n    \"feedback_id\": \"FB-2024-08-15-001\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently demonstrates excellent communication skills, especially in client presentations. He actively listens and articulates his ideas clearly. His ability to explain complex topics in a simple manner is highly valuable.  He's a real asset to the team, and I truly appreciate his dedication.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--70699", "text": "{\n    \"feedback_id\": \"FB-2024-07-01-005\",\n    \"employee_id\": \"EMP-105\",\n    \"feedback_date\": \"2024-07-01\",\n    \"feedback_provider\": \"Michael Brown\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily's performance is adequate. She completes tasks on time but doesn't actively participate in team meetings.  I've noticed a lack of follow-through on several initiatives. Further training is required in project management.\",\n    \"rating\": 3\n}"}
