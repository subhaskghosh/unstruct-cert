{"_id": "human_resources--employee_feedbac--p--62378", "text": "{\n    \"feedback_id\": \"FB20230315-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently exceeds expectations in project delivery. His innovative approach to problem-solving was crucial to the successful launch of Project Phoenix. I sincerely appreciate his dedication and positive attitude.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62378", "text": "{\n    \"feedback_id\": \"FB20230228-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-02-28\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Needs to improve time management skills. Several deadlines were missed last month. This is a critical area for development. We've put him on a PIP.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62379", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent collaboration and a true team player.  Always willing to help colleagues and contribute positively to group projects. Strong problem-solving skills.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62379", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Good performance overall, but needs improvement in presenting ideas during meetings. Sometimes struggles to articulate thoughts clearly.  A solid contributor, but a team player.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62380", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently delivers high-quality work. He is proactive in identifying solutions and a great team player. I recommend he focus on public speaking to further enhance his leadership potential.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62380", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP789\",\n    \"feedback_date\": \"2023-09-20\",\n    \"feedback_provider\": \"Mark Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"I'm frustrated with the lack of communication on this project. It feels like I'm constantly waiting for updates. It’s making it hard to do my job.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62381", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work, but could benefit from improved communication during team meetings. Specifically, offering solutions alongside identifying issues would be impactful. Overall a strong performer.\",\n    \"rating\": 4\n}"}
