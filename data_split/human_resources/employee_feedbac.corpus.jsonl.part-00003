{"_id": "human_resources--employee_feedbac--p--71189", "text": "{\n    \"feedback_id\": \"FB1029\",\n    \"employee_id\": \"EMP345\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Alice provided insightful feedback on my presentation skills, specifically highlighting my ability to connect with the audience. She suggested framing challenges as opportunities, which was very helpful.  This aligns with my goal of becoming a more confident public speaker.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71189", "text": "{\n    \"feedback_id\": \"FB1030\",\n    \"employee_id\": \"EMP345\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Bob's feedback focused on areas for improvement identified during my performance review, related to a specific performance improvement plan concerning project deadlines. It highlighted a need for better time management and prioritization.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71190", "text": "{\n    \"feedback_id\": \"FB0072\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-18\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently demonstrates excellent communication skills, explaining complex topics clearly and concisely. He quickly grasps new concepts and proactively seeks opportunities to improve. His positive attitude is infectious!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71190", "text": "{\n    \"feedback_id\": \"FB0089\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-25\",\n    \"feedback_provider\": \"Mark Davis\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"David's technical skills are adequate, but his communication could be improved. He seems hesitant to ask questions. He is relatively slow to adapt to changes in project requirements.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71191", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John, while your technical skills are excellent, your presentation skills need work. You tend to rush through explanations and don't always connect with the audience. Let's schedule some time to practice. This is an area for development that will really elevate your impact.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--n--71191", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently exceeds expectations on all assigned tasks. He's a valuable asset to the team and demonstrates a strong work ethic.  Excellent job on Project X!\",\n    \"rating\": 5\n}"}
