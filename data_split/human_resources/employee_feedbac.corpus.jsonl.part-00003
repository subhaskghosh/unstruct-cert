{"_id": "human_resources--employee_feedbac--n--71121", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP7890\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Sarah is consistently late for meetings and often seems disengaged. Her work quality has been declining lately, and she avoids taking on new responsibilities. Very concerning.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71122", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates strong problem-solving skills and a positive attitude. She's eager to learn and takes initiative. A good area for growth would be further developing her presentation skills. Overall, she's a valuable asset.\",\n    \"rating\": 4\n}"}
