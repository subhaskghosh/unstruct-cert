{"_id": "human_resources--employee_feedbac--p--71922", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently delivers high-quality work and demonstrates strong leadership qualities. She's a quick learner and proactively seeks out challenges.  While her presentation skills are good, further development in this area would be beneficial for larger audiences.  Shows excellent potential for a team lead role.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71922", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-04-10\",\n    \"feedback_provider\": \"Emily Chen\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"John is a very technically proficient engineer, always able to solve complex problems. His coding skills are excellent. However, he sometimes struggles to communicate his ideas effectively to non-technical team members.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71923", "text": "{\n    \"feedback_id\": \"FB20241027001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Dr. Emily Carter\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While generally a strong performer, John could benefit from active listening training. His presentations sometimes lack clarity, and team members have mentioned feeling unheard during meetings. Needs to focus on conveying ideas more concisely.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71923", "text": "{\n    \"feedback_id\": \"FB20241015002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-10-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is doing a great job on the project. He's very proactive and always willing to help. No significant concerns at the moment.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71924", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While John consistently meets deadlines, his contributions to team discussions could be improved. He should actively solicit input from colleagues and share his ideas more openly. Focus on improving communication regarding project roadblocks.\",\n    \"rating\": 4\n}"}
