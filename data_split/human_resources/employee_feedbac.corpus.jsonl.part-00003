{"_id": "human_resources--employee_feedbac--n--68307", "text": "{\n    \"feedback_id\": \"FB-2023-11-22-012\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2023-11-22\",\n    \"feedback_provider\": \"Peter Jones (Manager)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a good team member, but sometimes struggles to anticipate potential issues.  She is reactive rather than proactive.  While she gets her work done, her leadership qualities aren't yet fully developed.\",\n    \"rating\": 3\n}"}
