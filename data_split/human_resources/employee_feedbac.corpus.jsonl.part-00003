{"_id": "human_resources--employee_feedbac--p--59452", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Sarah consistently delivers high-quality work and demonstrates strong analytical skills. However, her presentations can be a bit rushed and lack clarity. Encouraging her to practice her delivery and focus on simplifying complex information would greatly enhance her impact. She is a quick learner and eager to improve.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--59452", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP124\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"Emily Carter\",\n    \"feedback_type\": \"incident report\",\n    \"comments\": \"John had a difficult conversation with a client today, exhibiting unprofessional behavior and poor listening skills. This resulted in a strained relationship and a potential loss of business. Immediate corrective action is needed.\",\n    \"rating\": 2\n}"}
