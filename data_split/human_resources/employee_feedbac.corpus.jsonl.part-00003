{"_id": "human_resources--employee_feedbac--p--62665", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John needs to improve his presentation skills. He tends to rush through slides and doesn't maintain eye contact. This impacts his ability to convey complex information effectively and leads to decreased audience engagement. We should schedule some training for him.\",\n    \"rating\": 3\n}"}
