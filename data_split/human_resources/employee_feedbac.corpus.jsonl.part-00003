{"_id": "human_resources--employee_feedbac--p--56971", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John demonstrated exceptional leadership during the recent project. He effectively motivated the team and navigated challenges with poise and confidence. His communication was clear, and he consistently provided constructive feedback. A truly inspiring manager.\",\n    \"rating\": 5\n}"}
