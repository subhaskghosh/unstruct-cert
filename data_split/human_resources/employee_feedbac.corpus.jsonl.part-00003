{"_id": "human_resources--employee_feedbac--p--62170", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Peer_Sarah\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John has been doing well, but could benefit from improving his presentation skills. He tends to rush through slides and doesn't always make a strong connection with the audience. Focusing on storytelling and pacing would be really helpful.\",\n    \"rating\": 4,\n    \"project\": \"Alpha\"\n}"}
