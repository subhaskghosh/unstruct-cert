{"_id": "human_resources--employee_feedbac--n--62619", "text": "{\n    \"feedback_id\": \"FB-2023-11-15-002\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Mark Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While technically proficient, David often works in isolation and doesn't collaborate effectively with the team. He needs to be more open to feedback and improve his communication skills. His approach sometimes hinders progress and creates friction. He is taking the initiative but on the wrong tasks.\",\n    \"rating\": 2\n}"}
