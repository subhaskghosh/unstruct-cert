{"_id": "human_resources--employee_feedbac--p--71973", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John has consistently demonstrated excellent teamwork skills and proactively takes initiative on new projects. He's a valuable asset to the team and consistently exceeds expectations. His positive attitude is infectious!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71973", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-10\",\n    \"feedback_provider\": \"Peter Jones (Manager)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah showed good initiative on the marketing campaign, but there was some conflict with the design team regarding her approach. Overall a positive contribution, but some communication improvements needed.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71974", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP98765\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent performance on the recent project. Demonstrated strong technical skills and collaborative spirit. A valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71974", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP98765\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Bob Williams (Peer)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Good work overall, but the workload seems a bit high lately. Struggling to meet deadlines due to excessive tasks.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71975", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-005\",\n    \"employee_id\": \"EMP-ENG-012\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David is consistently proactive and demonstrates strong analytical skills. He could benefit from taking a leadership course to further hone his influence. His coding style is very clean and maintainable.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71975", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-011\",\n    \"employee_id\": \"EMP-MKT-003\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While Sarah is enthusiastic, her presentations often lack clear structure and supporting data. There have been some concerns about her collaboration on group projects, where she sometimes dominates the discussion.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71976", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"Excellent presentation skills and clear, concise communication during the client meeting. John consistently keeps the team informed and proactively addresses potential issues. A valuable asset to the team!\",\n    \"rating\": 5\n}"}
