{"_id": "human_resources--employee_feedbac--p--62201", "text": "{\n    \"feedback_id\": \"FB20240126-005\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John demonstrated excellent problem-solving skills during the recent project. He proactively identified a potential bottleneck and proposed a solution that saved us valuable time and resources. His communication was clear and concise, and he was receptive to feedback.  A truly positive contribution to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62201", "text": "{\n    \"feedback_id\": \"FB20240115-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"Maria is generally a reliable team member, but her code sometimes introduces unexpected bugs. While she's willing to help, there’s a lot of technical debt accumulating in her modules that needs to be addressed. The presentation of the issue can be better.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62202", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"E123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent progress on the recent project! E123 consistently seeks feedback and implements suggestions effectively.  Continuing to delegate more tasks will further enhance leadership skills. Keep up the great work!\",\n    \"rating\": 5\n}"}
