{"_id": "human_resources--employee_feedbac--p--71789", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently communicates clearly and concisely during team meetings and with clients. He proactively seeks feedback and implements suggestions. His presentation skills are excellent. A strong communicator and a valuable asset.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71789", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"Bob Williams (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John's communication needs improvement. While he attempts to explain complex topics, he often uses jargon and struggles to connect with the audience. We have placed him on a performance improvement plan to address these issues. This is a formal review for his PIP.\",\n    \"rating\": 2\n}"}
