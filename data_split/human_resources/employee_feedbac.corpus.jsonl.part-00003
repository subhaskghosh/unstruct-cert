{"_id": "human_resources--employee_feedbac--n--71835", "text": "{\n    \"feedback_id\": \"FB20231020-003\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah's performance is satisfactory. She needs further training on project management tools and could improve her time management.  The feedback focuses on necessary skill development.\",\n    \"rating\": 3\n}"}
