{"_id": "human_resources--employee_feedbac--p--68695", "text": "{\n    \"feedback_id\": \"FB-2023-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Mark consistently goes above and beyond to explain complex technical details in a way that everyone can understand. His communication is clear, concise, and always professional. I really appreciate his patience and willingness to help!\",\n    \"rating\": 5\n}"}
