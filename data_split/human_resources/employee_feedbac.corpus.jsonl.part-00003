{"_id": "human_resources--employee_feedbac--n--68008", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"Emily needs to improve her time management skills. While her work quality is generally good, she frequently misses deadlines.  This has created some challenges for project timelines.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68009", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the recent project. John consistently delivers high-quality results and is a valuable team member. His proactive approach and problem-solving skills were instrumental to our success. I encourage him to continue developing his presentation skills.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68009", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-07-28\",\n    \"feedback_provider\": \"ManagerB\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah's reports are generally accurate, but she sometimes misses minor formatting details. This isn't a major issue, but attention to detail would be helpful. She needs to be more punctual as well.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68010", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is demonstrating excellent initiative and a willingness to learn. His recent work on the Alpha project showed significant improvement and a strong understanding of the core concepts. He's a valuable asset to the team. Continued mentoring will unlock even greater potential.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68010", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While John completes tasks adequately, his attention to detail needs improvement. There were several errors in the Beta report that required significant rework. He needs to focus on accuracy and proofreading.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68011", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-29\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the recent project!  Emily consistently goes above and beyond, demonstrating strong analytical skills and a proactive approach. She's a valuable asset to the team and shows great leadership potential.\",\n    \"rating\": 5\n}"}
