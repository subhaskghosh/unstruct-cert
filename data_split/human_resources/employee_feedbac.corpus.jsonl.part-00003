{"_id": "human_resources--employee_feedbac--p--62476", "text": "{\n    \"feedback_id\": \"FB00723\",\n    \"employee_id\": \"EMP129\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"David consistently delivers high-quality work. He's proactive, takes initiative, and is a valuable team member.  He's actively seeking ways to improve his presentation skills, and I'm confident he'll excel in this area with some targeted training. Overall, excellent performance.\",\n    \"rating\": 5\n}"}
