{"_id": "human_resources--employee_feedbac--p--67852", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, both verbally and in writing. He clearly articulates ideas and actively listens to team members. A valuable asset!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67852", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-28\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's work is generally good, but he sometimes struggles to explain complex technical details to non-technical stakeholders. Could use some improvement in simplifying his messaging.\",\n    \"rating\": 3\n}"}
