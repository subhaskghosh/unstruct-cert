{"_id": "human_resources--employee_feedbac--n--68512", "text": "{\n    \"feedback_id\": \"FB-2023-012\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2023-02-28\",\n    \"feedback_provider\": \"Manager B\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Needs improvement in time management. Often misses deadlines. While technically proficient, a more organized approach would significantly enhance productivity. This is a recurring issue.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68513", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While John is technically proficient, his collaboration with team members needs improvement. He sometimes dominates discussions and doesn't actively solicit input from others. Focusing on active listening and inclusive communication would be beneficial.\",\n    \"rating\": 3\n}"}
