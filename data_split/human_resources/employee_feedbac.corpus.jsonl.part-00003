{"_id": "human_resources--employee_feedbac--p--68214", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates excellent teamwork skills. He is a collaborative and supportive team member, always willing to help others and share his knowledge. His positive attitude significantly contributes to team morale.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68214", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"Peter Smith (Manager)\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Sarah is generally a good performer, however, there has been a small conflict with another team member regarding project responsibilities. She needs to work on better communication.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68215", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-08-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently demonstrates excellent communication skills, both in written and verbal form. She articulates her ideas clearly and actively listens to her colleagues. This performance review highlights her strong progress.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68215", "text": "{\n    \"feedback_id\": \"FB00802\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-09-20\",\n    \"feedback_provider\": \"Emily Carter\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a good team player and always willing to help. However, there's room for improvement in his project management. The review covered his recent project.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68216", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"David is consistently meeting expectations and demonstrating a willingness to learn new skills. He proactively seeks feedback and applies it effectively. There's potential for him to take on more responsibility with some guidance, particularly in project leadership. Overall, a solid contributor with a positive attitude.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--68216", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"David's performance has been slipping recently. While he is generally a capable employee, there have been several instances of missed deadlines and a lack of attention to detail. Requires improvement in time management and accuracy.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68217", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-05-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent work on the recent presentation.  While the content was strong, exploring more visual aids could further enhance engagement.  A great performance overall, and a clear willingness to learn.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68217", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-06-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"The report was submitted late and contained several factual errors. Attention to detail needs significant improvement. This impacts team performance.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68218", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent performance this quarter! John consistently exceeds expectations and demonstrates strong leadership skills. He is a valuable asset to the team.  Focused and driven.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68218", "text": "{\n    \"feedback_id\": \"FB-2024-10-26-002\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's individual contributions are good, but he struggles to collaborate effectively with the team. There have been instances where his approach has hindered teamwork, although his technical skills are very strong. Rating reflects this.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68219", "text": "{\n    \"feedback_id\": \"FB2024-07-26-003\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-26\",\n    \"feedback_provider\": \"Peer_Sarah\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John has been proactively offering help to the team on the recent project. His willingness to share knowledge and collaborate has significantly improved our efficiency. He's really embracing the team-first approach.  A great suggestion he made was to use a shared task board which really helped us organize. \",\n    \"rating\": 4\n}"}
