{"_id": "human_resources--employee_feedbac--n--68260", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Sarah is generally a good worker, but tends to wait for instructions rather than taking initiative.  She does a good job on assigned tasks but doesn't actively participate in brainstorming or problem-solving sessions. This feedback relates to project Alpha.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68261", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Miller (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While Alex consistently delivers high-quality work individually, there's room for improvement in team collaboration. He sometimes struggles to share ideas openly and can be hesitant to ask for help. This impacts project timelines and overall team synergy.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--n--68261", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Chen (Direct Report)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Alex is a very helpful colleague. He always answers my questions and is willing to assist. His technical skills are excellent.\",\n    \"rating\": 5\n}"}
