{"_id": "human_resources--employee_feedbac--p--62369", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has been a solid performer this quarter. While his technical skills are strong, he could benefit from improved communication during team meetings. Focusing on actively listening and clearly articulating his ideas would be helpful. I've offered to mentor him on these areas. Rating his current performance a 4/5, with potential for growth.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62369", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2023-08-15\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John consistently misses deadlines and his work quality has been declining. It's frustrating to constantly have to correct his mistakes. He doesn't seem to take ownership of his responsibilities. A 2/5.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62370", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently demonstrates a proactive approach to learning new technologies. His recent work on the data pipeline showed significant skill development. He asks great questions and quickly implements feedback.  Needs to focus on time management.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62370", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's technical skills are progressing well. However, his contributions during the annual performance review were minimal and lacked detail.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62371", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah demonstrated excellent problem-solving skills during the recent project. She's proactive and eager to learn. Focus on refining her presentation skills.\",\n    \"rating\": 5\n}"}
