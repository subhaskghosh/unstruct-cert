{"_id": "human_resources--employee_feedbac--p--71163", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-26\",\n    \"feedback_provider\": \"Sarah Johnson - Team Lead\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the recent project. Your proactive communication and problem-solving skills were invaluable to the team's success. You consistently go above and beyond to help colleagues, and foster a collaborative environment.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71163", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"David Lee - Manager\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Performance has been generally satisfactory, but there have been a few instances of missed deadlines. While the individual demonstrates a willingness to learn, improvement is needed in time management. A verbal warning was issued regarding attendance.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71164", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent initiative shown on the recent project. Demonstrated a willingness to learn and adapt, showing significant growth potential. Very proactive and a valuable team member.\",\n    \"rating\": 5\n}"}
