{"_id": "human_resources--employee_feedbac--p--62906", "text": "{\n    \"feedback_id\": \"FB20240815-001\",\n    \"employee_id\": \"ENG1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson (Team Lead)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David proactively identified a bottleneck in the deployment pipeline and proposed a solution that reduced deployment time by 20%. Excellent initiative and technical skill.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62906", "text": "{\n    \"feedback_id\": \"FB20240722-002\",\n    \"employee_id\": \"ENG5678\",\n    \"feedback_date\": \"2024-07-22\",\n    \"feedback_provider\": \"Bob Williams (Manager)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah consistently completes her daily reports on time. No issues noted.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62907", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John consistently demonstrates a proactive attitude and willingness to learn. He successfully implemented the new reporting system, significantly improving team efficiency. He is receptive to feedback and actively works on areas for improvement, showing great potential for growth.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62907", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John needs to be more reliable. He's often late to meetings and doesn't always follow through on commitments. His overall attitude could be more positive. This is a persistent issue.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62908", "text": "{\n    \"feedback_id\": \"FB20240215001\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"Excellent performance this quarter. Emily consistently goes above and beyond, demonstrating strong initiative and problem-solving skills. Her positive attitude is infectious and greatly benefits the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62908", "text": "{\n    \"feedback_id\": \"FB20240120002\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"Emily needs to improve her time management. While her ideas are good, she often misses deadlines. She is a generally positive team member but needs to be more focused. There are concerns about her consistency.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62909", "text": "{\n    \"feedback_id\": \"FB-2023-12-015\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John, your presentation skills are strong, and you clearly understand the technical aspects of the project. To elevate your impact, consider practicing more deliberate pacing and incorporating stronger visual aids to engage the audience.  Focus on summarizing key takeaways at the end. This feedback is intended to help you grow and become a more effective communicator.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62909", "text": "{\n    \"feedback_id\": \"FB-2023-05-007\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2023-05-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John needs to improve his time management. Things are often late. Not a team player.\",\n    \"rating\": 2\n}"}
