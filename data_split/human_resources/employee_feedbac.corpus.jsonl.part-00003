{"_id": "human_resources--employee_feedbac--p--71972", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John consistently seeks feedback on his presentations and actively incorporates suggestions. His communication has improved noticeably in the last quarter, showing a willingness to learn and adapt. He's a strong team player and responds well to constructive criticism.\",\n    \"rating\": 4\n}"}
