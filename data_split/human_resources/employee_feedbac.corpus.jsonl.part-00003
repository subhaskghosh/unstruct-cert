{"_id": "human_resources--employee_feedbac--n--71018", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP012\",\n    \"feedback_date\": \"2023-09-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a reliable worker, but he often struggles to meet deadlines. His performance is generally adequate but lacks enthusiasm.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71019", "text": "{\n    \"feedback_id\": \"FB20240126-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the recent project! John has significantly improved his collaboration with the team, proactively offering assistance and sharing knowledge. His positive attitude is contagious and has boosted morale. Really appreciate his dedication and willingness to go the extra mile.\",\n    \"rating\": 5\n}"}
