{"_id": "human_resources--employee_feedbac--p--68454", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently demonstrates excellent communication skills, both written and verbal. She actively listens to team members and articulates her ideas clearly. A true team player, she always offers help and support to colleagues. Her presentation to the client was particularly well-received.\",\n    \"rating\": 5\n}"}
