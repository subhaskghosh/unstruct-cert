{"_id": "human_resources--employee_feedbac--p--64407", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John is a valuable team member. He consistently demonstrates a willingness to learn and improve. We discussed areas for growth in project management, and he was very receptive to feedback. His positive attitude is infectious.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--64407", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP108\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Meeting with Sarah was productive. We discussed project timelines and resource allocation. No immediate concerns were raised. She completed her assigned tasks on time.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--64408", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Manager - Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently communicates clearly and effectively with the team and clients. He proactively keeps everyone informed and is excellent at explaining complex information in a understandable way. A real asset!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--64408", "text": "{\n    \"feedback_id\": \"FB20231020-005\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"Colleague - David Lee\",\n    \"feedback_type\": \"Peer Feedback\",\n    \"comments\": \"John is very diligent and completes his tasks on time. He needs to be more proactive in sharing updates on his progress with the team. His work is solid, but team awareness could be improved.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--64409", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently delivers high-quality work and is a valuable team member. His technical skills are excellent (rating 4). However, he could benefit from improved communication during project updates and proactively seeking feedback. This would elevate his collaboration skills.\",\n    \"rating\": 4\n}"}
