{"_id": "human_resources--employee_feedbac--p--64388", "text": "{\n    \"feedback_id\": \"FB1001\",\n    \"employee_id\": \"EMP201\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent communication skills. The employee clearly articulates ideas and actively listens to team members. A strong contributor to team discussions.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--64388", "text": "{\n    \"feedback_id\": \"FB1002\",\n    \"employee_id\": \"EMP201\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"The employee is generally a good team player, but sometimes struggles to convey technical details in a simple manner. Needs improvement in clarity.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--64389", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, both in written and verbal form. He explains complex issues clearly and concisely, making him a valuable asset to the team. He actively listens to others and fosters open dialogue.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--64389", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"John's work is generally good, but his presentations could be improved. He tends to ramble and loses the audience's attention. He needs to be more direct and concise.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--64390", "text": "{\n    \"feedback_id\": \"FB-20231115-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently goes above and beyond to help his colleagues. He proactively identified a critical issue in the project and worked tirelessly to resolve it, preventing a significant delay. His dedication is truly commendable.\",\n    \"rating\": 5\n}"}
