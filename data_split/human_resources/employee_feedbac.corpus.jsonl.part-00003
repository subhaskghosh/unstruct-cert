{"_id": "human_resources--employee_feedbac--n--59371", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-02-28\",\n    \"feedback_provider\": \"Manager - Jane Doe\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"David needs to improve his ability to anticipate issues. While he eventually addressed the recent server outage, his initial response was slow and reactive. The problem-solving approach was not ideal, requiring significant assistance from other team members.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--59372", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Manager\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the recent project!  John consistently goes above and beyond, demonstrating strong problem-solving skills and a positive attitude.  Keep up the fantastic work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--59372", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-02-01\",\n    \"feedback_provider\": \"David Manager\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John needs to improve his time management. There were several missed deadlines and a lack of communication.  He's a good team player, but needs focus.\",\n    \"rating\": 3\n}"}
