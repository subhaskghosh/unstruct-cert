{"_id": "human_resources--employee_feedbac--p--67658", "text": "{\n    \"feedback_id\": \"FB00928\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"While John's technical skills are excellent, he struggles to articulate his ideas clearly in team meetings. He often interrupts and doesn't listen actively to others. This impacts team collaboration and project progress. Needs to work on active listening and concise communication.\",\n    \"rating\": 3\n}"}
