{"_id": "human_resources--employee_feedbac--p--71171", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has shown significant improvement in his communication skills over the past quarter. He actively seeks feedback and applies it effectively. I appreciate his dedication to growth and see a lot of potential for him to take on more leadership responsibilities. Keep up the excellent work!\",\n    \"rating\": 5\n}"}
