{"_id": "human_resources--employee_feedbac--n--71598", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-04-01\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is often late to meetings and doesn't seem engaged during discussions. His performance is generally subpar. This is very disappointing.\",\n    \"rating\": 2\n}"}
