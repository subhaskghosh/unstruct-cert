{"_id": "human_resources--employee_feedbac--p--56964", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"David consistently exceeds expectations in his role. He's a quick learner and demonstrates excellent problem-solving skills. With a little more focus on delegation, he has the potential to lead larger projects effectively.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--56964", "text": "{\n    \"feedback_id\": \"FB011\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Michael Brown (Manager)\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Emily is a solid performer, but needs to improve her communication skills. Her reports are detailed but sometimes difficult to understand. No immediate concerns.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--56965", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-04-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has been proactively seeking opportunities to improve team communication and has introduced some effective strategies during our recent project kickoff. This has demonstrably boosted team collaboration. Excellent work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--56965", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP789\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah consistently delivers high-quality work, but tends to work independently. While effective, this limits opportunities for broader team knowledge sharing.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--56966", "text": "{\n    \"feedback_id\": \"FB001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently delivers high-quality work, but could benefit from improved communication skills when presenting to large groups. He's receptive to feedback and eager to learn.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--56966", "text": "{\n    \"feedback_id\": \"FB002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Peer B\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is very efficient, but can be a bit dismissive of others’ ideas during brainstorming sessions. He always gets his tasks done on time.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--56967", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent performance this quarter. John consistently takes initiative and demonstrates strong leadership, especially in guiding the new team members. He proactively identifies potential roadblocks and offers effective solutions. A real asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--56967", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Peer B\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is generally helpful, but sometimes hesitates to take charge. He's a good team player, but could benefit from developing his leadership skills. He's reliable and meets expectations.\",\n    \"rating\": 3\n}"}
