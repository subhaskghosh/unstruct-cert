{"_id": "human_resources--employee_feedbac--p--71932", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Sarah demonstrated a strong willingness to learn new technologies during the project. While her initial implementation needed some refinement, she quickly adapted and delivered a solid final product. There are opportunities for her to take on more leadership responsibilities.\",\n    \"rating\": 4\n}"}
