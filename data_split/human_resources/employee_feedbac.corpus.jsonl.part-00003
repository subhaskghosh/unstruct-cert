{"_id": "human_resources--employee_feedbac--p--62671", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrated excellent communication during the recent client presentation. He clearly articulated complex ideas and actively listened to client concerns. A few minor suggestions for improving his report writing skills, but overall a strong performance.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62671", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's communication needs improvement. He often interrupts during meetings and his emails are unclear. He doesn't seem to actively listen to feedback. Requires significant development in this area.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62672", "text": "{\n    \"feedback_id\": \"FB20240115-003\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"HR Specialist - Jane Doe\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently delivers high-quality work. He could improve his presentation skills to better convey complex information. Focusing on simplifying his slides and practicing delivery will be beneficial. Overall a strong performer.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62672", "text": "{\n    \"feedback_id\": \"FB20240120-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Manager - David Smith\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Great job on the recent project! You exceeded expectations and the client was very happy. Keep up the excellent work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--62673", "text": "{\n    \"feedback_id\": \"FB20240115-001\",\n    \"employee_id\": \"EMP1005\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates a strong work ethic and willingness to learn. Recent efforts to actively listen during team meetings have significantly improved communication.  Rating her a 4 - exceeding expectations. Keep up the great work!\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62673", "text": "{\n    \"feedback_id\": \"FB20240120-002\",\n    \"employee_id\": \"EMP1005\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Client - ABC Corp\",\n    \"feedback_type\": \"Client Feedback\",\n    \"comments\": \"While Sarah is responsive, the project updates are often too technical for our team. We need information presented in a more simplified way. Her work is accurate, but the delivery needs improvement.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62674", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently exceeds expectations. His positive attitude and willingness to help others are a great asset to the team. He took initiative on the recent Alpha project and was instrumental in its success.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62674", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-10\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's performance is generally good, but he could improve his time management skills. While he contributed to the Alpha project, his reports were often submitted late. A bit more focus would be beneficial.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62675", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"David consistently goes above and beyond. His dedication to mentoring junior team members is commendable. He's proactive in identifying growth opportunities and always delivers high-quality work.  Rating: 5\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62675", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-005\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah completed the assigned tasks on time. No major issues observed. Needs to improve time management on complex projects. Rating: 3\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62676", "text": "{\n    \"feedback_id\": \"FB20231115-007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Sarah has shown significant growth in her collaborative skills. She actively participates in team meetings and consistently offers support to her colleagues. Her recent project contributions were excellent, showcasing a clear understanding of the project goals and a proactive approach to problem-solving.  A strong team player and clearly improving.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62676", "text": "{\n    \"feedback_id\": \"FB20231220-012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"Jessica Brown\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While John is technically proficient, he often works in isolation and can be resistant to new ideas. He completed the task on time, but didn't actively engage with others. His performance is satisfactory.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62677", "text": "{\n    \"feedback_id\": \"FB20240315-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"John Smith (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent performance on the recent project. Demonstrated strong leadership skills and a proactive approach to problem-solving. Significant growth potential.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62677", "text": "{\n    \"feedback_id\": \"FB20240220-005\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Employee requested additional training on Excel. While generally competent, there's room for improvement in spreadsheet skills.\",\n    \"rating\": 3\n}"}
