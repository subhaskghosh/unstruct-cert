{"_id": "human_resources--employee_feedbac--p--68696", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently provides clear and concise updates during team meetings. His communication is excellent and helps keep everyone aligned. He actively listens to others and explains complex concepts in an easy-to-understand manner.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68696", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Michael Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's communication is adequate, but could be improved. He sometimes uses technical jargon that is not understandable to everyone. Overall performance is solid.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68697", "text": "{\n    \"feedback_id\": \"FB20240815-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John consistently goes above and beyond to support his colleagues. He is a true team player and always willing to help others. He shows initiative and is eager to learn.  We discussed opportunities to further develop his presentation skills, which he welcomed.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68697", "text": "{\n    \"feedback_id\": \"FB20240920-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-09-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John is generally a competent worker, but could be more proactive. His individual contributions are solid, but he doesn't always actively collaborate with the team.  We need to see more engagement in group projects.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68698", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"Excellent work on the recent project! Emily consistently goes above and beyond and her contributions were crucial to the successful launch. Very enthusiastic and a true team player.\",\n    \"rating\": 5\n}"}
