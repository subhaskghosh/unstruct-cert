{"_id": "human_resources--employee_feedbac--p--67332", "text": "{\n    \"feedback_id\": \"FB1015\",\n    \"employee_id\": \"EMP204\",\n    \"feedback_date\": \"2024-04-15\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently delivers high-quality work and is a valuable team member. He proactively seeks out challenges and demonstrates a strong commitment to professional development. Areas for growth include delegating tasks more effectively to empower team members.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--67332", "text": "{\n    \"feedback_id\": \"FB1020\",\n    \"employee_id\": \"EMP205\",\n    \"feedback_date\": \"2024-05-01\",\n    \"feedback_provider\": \"Colleague B\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"Sarah is often late to meetings and doesn't contribute much during brainstorming sessions. Her work is adequate, but lacks initiative. It feels like she's disengaged from the project.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--67333", "text": "{\n    \"feedback_id\": \"FB20241001-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Manager - John Smith\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"Emily consistently exceeds expectations. Her dedication to the project and willingness to help colleagues are truly commendable. She is a valuable asset to the team, demonstrating excellent problem-solving skills and a positive attitude.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67333", "text": "{\n    \"feedback_id\": \"FB20241001-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-28\",\n    \"feedback_provider\": \"Colleague - Jane Doe\",\n    \"feedback_type\": \"Informal Peer Review\",\n    \"comments\": \"Emily's work is generally satisfactory, but she could improve her communication skills. Sometimes it's difficult to understand her thought process. She's reliable, however.\",\n    \"rating\": 3\n}"}
