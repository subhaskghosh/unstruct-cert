{"_id": "human_resources--employee_feedbac--p--71512", "text": "{\n    \"feedback_id\": \"FB20231215-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"Manager - Alice Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently articulates his ideas clearly during project meetings, fostering strong collaboration within the team. He actively listens to feedback and adapts his communication style accordingly. Areas for growth include proactively sharing updates with stakeholders. Rating reflects positive impact on team collaboration.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71512", "text": "{\n    \"feedback_id\": \"FB20231215-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-22\",\n    \"feedback_provider\": \"Peer - Bob Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is great at presenting information and very well-spoken. Everyone understands his updates. He really shined during the recent client demo. This is why we should send him to advanced communication training.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71513", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John consistently presents ideas clearly in team meetings. He could benefit from practicing active listening to ensure full understanding during collaborations. Overall, a strong communicator with potential for further development.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71513", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John repeatedly fails to respond to emails in a timely manner. His communication is often unclear and leads to misunderstandings. He needs significant improvement in this area.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71514", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"peer feedback\",\n    \"comments\": \"John consistently seeks feedback and incorporates it into his work. He's proactive and demonstrates a strong desire to improve his technical skills. His recent presentation was well-received, and he handled questions effectively.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71514", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John's performance has been steady. He meets expectations but doesn't actively seek out challenging assignments. His contributions are reliable, but lack innovation.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71515", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's technical skills are excellent, but his presentations could benefit from clearer explanations and more audience engagement. He needs to improve how he conveys complex ideas to non-technical colleagues. Overall a helpful employee, just needs to refine his communication.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71515", "text": "{\n    \"feedback_id\": \"FB20231228-005\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Mark Smith\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is consistently late to meetings and doesn't respond to emails promptly. Her lack of communication is hindering project progress and creating frustration within the team. This is impacting overall team performance.\",\n    \"rating\": 2\n}"}
