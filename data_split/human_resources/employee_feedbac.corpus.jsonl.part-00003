{"_id": "human_resources--employee_feedbac--p--71910", "text": "{\n    \"feedback_id\": \"FB20240815-003\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alexandra Chen\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently delivers exceptional results and takes initiative on projects. He's a true asset and mentor to junior colleagues. I believe he's ready for a leadership role. Focused on proactive solutions.\",\n    \"rating\": 5\n}"}
