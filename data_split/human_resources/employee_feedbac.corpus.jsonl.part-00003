{"_id": "human_resources--employee_feedbac--p--71587", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a valuable team member. He consistently delivers high-quality work and is always willing to help others. His presentation skills could benefit from some practice, focusing on maintaining eye contact. Overall, a strong performer!\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71587", "text": "{\n    \"feedback_id\": \"FB20240120-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Mark Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While Sarah is technically proficient, she often works in isolation and doesn't collaborate well with the team. This hinders progress on group projects and can lead to misunderstandings. Her technical skills are strong, but her teamwork needs improvement.\",\n    \"rating\": 3\n}"}
