{"_id": "human_resources--employee_feedbac--p--71194", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently goes above and beyond to help his team. He proactively identified a potential bottleneck in the project workflow and proposed a solution that saved us valuable time. Excellent team player and problem solver.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71194", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2023-06-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David is a capable employee, but he tends to work independently and doesn't always share information effectively. His contributions are valuable, but team collaboration could be improved.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71195", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Manager-Alice\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John demonstrated strong analytical skills on the recent Alpha project. While there's room for improvement in presentation delivery, his commitment to detail and problem-solving were excellent. Overall, a valuable contributor.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71195", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-02\",\n    \"feedback_provider\": \"HR-Bob\",\n    \"feedback_type\": \"Incident Report\",\n    \"comments\": \"Employee displayed unprofessional behavior during a client meeting. Repeatedly interrupted the client and made inappropriate comments. Immediate action needed.\",\n    \"rating\": 1\n}"}
{"_id": "human_resources--employee_feedbac--p--71196", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently demonstrates excellent communication skills during team meetings and presentations. He clearly articulates his ideas and actively listens to others. His ability to explain complex topics in a simple and understandable manner is a valuable asset to the team.  Keep up the great work!\",\n    \"rating\": 5\n}"}
