{"_id": "human_resources--employee_feedbac--p--62139", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-02-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrated a noticeable improvement in his communication skills during the last quarter. He's actively listening and articulating his thoughts more clearly. This is a positive step in his professional development.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62139", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-03-10\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John needs to focus on achieving his performance goals. While his communication is adequate, it doesn't directly translate into results. We discussed action items for Q2 to address this.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62140", "text": "{\n    \"feedback_id\": \"FB20241027-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently provides clear and concise updates during team meetings. He actively listens to team members and articulates his ideas effectively. There's a slight tendency to over-explain technical details to non-technical colleagues, but overall his communication is strong and contributes positively to team collaboration.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62140", "text": "{\n    \"feedback_id\": \"FB20241027-006\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-15\",\n    \"feedback_provider\": \"Peter Jones (Peer)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John occasionally interrupts during brainstorming sessions. It's a small thing, but it can disrupt the flow of ideas. He could work on letting others finish their thoughts.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62141", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Manager - Alice Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently exceeds expectations on projects. He's a collaborative team member and always willing to help others. His proactive approach and problem-solving skills are highly valued.  Excellent work!\",\n    \"rating\": 5\n}"}
