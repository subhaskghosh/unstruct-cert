{"_id": "human_resources--employee_feedbac--n--59890", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP4567\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While technically proficient, John tends to work in isolation and doesn't readily share knowledge with the team.  There's a lack of proactive collaboration.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--59891", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"John Smith (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While Emily demonstrates strong technical skills, her communication during team meetings could be more concise and inclusive. Needs to actively listen and ensure all team members understand her points. Overall a valuable asset, but this is a key development area.\",\n    \"rating\": 3\n}"}
