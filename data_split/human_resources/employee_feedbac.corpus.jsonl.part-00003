{"_id": "human_resources--employee_feedbac--p--62912", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Miller\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John's technical skills are excellent, but he struggles to clearly articulate complex ideas during team meetings.  Specifically, he could benefit from practicing active listening and summarizing key points to ensure everyone is on the same page. I recommend he consider a communication workshop.\",\n    \"rating\": 4\n}"}
