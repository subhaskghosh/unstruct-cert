{"_id": "human_resources--employee_feedbac--p--71939", "text": "{\n    \"feedback_id\": \"FB-2024-07-15-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Sarah Johnson (Team Lead)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent work ethic and a true team player. Always willing to help colleagues and contribute positively to group projects.  Their positive attitude is infectious and makes a real difference.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71939", "text": "{\n    \"feedback_id\": \"FB-2024-07-22-003\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-07-22\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While generally competent, the employee frequently misses project deadlines, impacting team progress. Needs to improve time management skills.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71940", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Sarah Johnson - Project Manager\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"David consistently demonstrates strong project leadership. He fosters excellent teamwork and collaboration within his team, resulting in on-time and high-quality deliverables.  He's a proactive problem solver and is always willing to help others. Areas for growth could include delegation techniques.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71940", "text": "{\n    \"feedback_id\": \"FB00567\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2022-12-20\",\n    \"feedback_provider\": \"Michael Brown - Team Lead\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Emily is a bright and enthusiastic member of the team. She's quick to learn and always eager to take on new challenges. She's a good contributor to brainstorming sessions and often comes up with creative solutions. \",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71941", "text": "{\n    \"feedback_id\": \"FB-2024-02-15-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently exceeds expectations in his role. His ability to problem-solve and mentor junior team members is exceptional. He has demonstrated strong potential for leadership and we are excited about his growth within the company.\",\n    \"rating\": 5\n}"}
