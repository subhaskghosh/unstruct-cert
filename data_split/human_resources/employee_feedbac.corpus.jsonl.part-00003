{"_id": "human_resources--employee_feedbac--p--71242", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently exceeds expectations in her role. She's a proactive problem-solver, a strong communicator, and a highly valued member of the team. Her recent work on the Alpha project was instrumental to its success. She willingly mentors junior colleagues, showcasing leadership potential.\",\n    \"rating\": 5\n}"}
