{"_id": "human_resources--employee_feedbac--p--68012", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John has significantly improved his communication with clients and within the team. He actively listens and articulates his ideas clearly. He's a strong team player, always willing to help colleagues. This feedback is intended to be constructive and encourage continued growth.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68012", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2022-12-20\",\n    \"feedback_provider\": \"Peter Smith (Manager)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John's communication is direct, but sometimes lacks tact. He participates in teamwork activities but could contribute more proactively. He is a valuable asset and always willing to learn.\",\n    \"rating\": 3\n}"}
