{"_id": "human_resources--employee_feedbac--n--68804", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP789\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a highly motivated individual who consistently delivers high-quality work. She works independently and is very efficient. However, she doesn't always seek input from others and can sometimes appear hesitant to share ideas in a team setting.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--68805", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the recent project!  Your communication with the team was clear and effective, leading to a smooth workflow and successful outcome.  Demonstrated a strong commitment to improvement.\",\n    \"rating\": 5\n}"}
