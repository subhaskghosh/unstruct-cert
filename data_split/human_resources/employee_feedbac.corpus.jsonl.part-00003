{"_id": "human_resources--employee_feedbac--p--59308", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently demonstrates initiative and a positive attitude. He's actively mentoring junior team members and stepping up to lead discussions. His problem-solving skills are excellent, and he readily embraces new challenges. A truly promising leader!\",\n    \"rating\": 5\n}"}
