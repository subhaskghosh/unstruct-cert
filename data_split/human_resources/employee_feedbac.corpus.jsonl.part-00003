{"_id": "human_resources--employee_feedbac--p--62364", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent progress in leading team meetings! John is demonstrating a willingness to listen to his team and delegate effectively.  Continued growth in this area will be fantastic.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62364", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-28\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John seems to struggle with motivating the team, and his communication could be more direct. He often avoids conflict.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62365", "text": "{\n    \"feedback_id\": \"FB20231027-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the recent project! Demonstrates strong leadership and a proactive approach to problem-solving.  Continues to exceed expectations. Great potential for advancement.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62365", "text": "{\n    \"feedback_id\": \"FB20230915-002\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2023-09-15\",\n    \"feedback_provider\": \"ManagerB\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Good effort this quarter, however, the presentation skills needs improvement.  While technically sound, the delivery was a bit flat. Could benefit from practicing public speaking. Overall, a solid contributor.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62366", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Peer Reviewer B\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the recent project! The employee demonstrated strong problem-solving skills and a proactive attitude. Areas for growth include delegation, but overall a very positive contribution.\",\n    \"rating\": 5\n}"}
