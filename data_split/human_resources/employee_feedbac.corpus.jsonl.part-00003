{"_id": "human_resources--employee_feedbac--p--71496", "text": "{\n    \"feedback_id\": \"FB20231115-003\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"Excellent communication skills. John consistently presents information clearly and concisely, both in written and verbal form. He actively listens to team members and effectively conveys complex ideas. A very valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71496", "text": "{\n    \"feedback_id\": \"FB20231228-010\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2023-12-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"The employee needs to improve their presentations and written reports. There were several instances of unclear wording and disorganized information. Seems hesitant to ask questions when clarification is needed.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71497", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates strong analytical skills. However, she could benefit from proactively sharing her insights during team meetings. This would improve collaboration and ensure her valuable perspective is always considered. Overall a very thoughtful and well-articulated review.\",\n    \"rating\": 4\n}"}
