{"_id": "human_resources--employee_feedbac--n--56409", "text": "{\n    \"feedback_id\": \"FB-2023-1002\",\n    \"employee_id\": \"EMP-5432\",\n    \"feedback_date\": \"2023-11-10\",\n    \"feedback_provider\": \"Bob Williams (Peer)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's technical skills are strong, and he completed his tasks efficiently on the Alpha project. However, he tends to work in isolation and could improve his communication with the team. He did finish on time, which was good.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--56410", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates a collaborative spirit, proactively seeking input from colleagues and sharing her knowledge. Her contributions to the team project were invaluable, and she effectively facilitated communication between different departments. While she excels in teamwork, focusing on independent project ownership could further enhance her skillset.\",\n    \"rating\": 4\n}"}
