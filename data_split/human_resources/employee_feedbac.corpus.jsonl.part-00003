{"_id": "human_resources--employee_feedbac--p--68211", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the recent project! John consistently went above and beyond to support his colleagues and foster a collaborative environment. He actively sought input from others and was always willing to help. A true team player.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68211", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Mary is a highly skilled individual contributor and consistently delivers quality work. She prefers to work independently and focuses on her own tasks efficiently. While her output is excellent, she doesn't actively participate in team discussions.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68212", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-05-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently exceeds expectations in his role. He's a strong communicator and always willing to help his colleagues. To further enhance his skills, I recommend exploring advanced project management training. His proactive approach is highly valued.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68212", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2022-12-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John is doing a good job. He needs to improve on time management. Overall, a solid performer.\",\n    \"rating\": 4\n}"}
