{"_id": "human_resources--employee_feedbac--p--71211", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Manager_A\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has demonstrated excellent problem-solving skills and actively collaborates with team members. His initiative on the recent project was commendable, indicating strong potential for growth within the company. He is a highly valued team player.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71211", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-22\",\n    \"feedback_provider\": \"Manager_A\",\n    \"feedback_type\": \"Daily Check-in\",\n    \"comments\": \"John completed his daily tasks efficiently and accurately. He responded promptly to all emails and maintained a clean workspace. No issues reported.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71212", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Manager - Alice Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John consistently demonstrates excellent teamwork skills. He is always supportive of his colleagues and readily offers assistance. His contributions to the project were instrumental to its success, and he fostered a collaborative environment.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71212", "text": "{\n    \"feedback_id\": \"FB00890\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-07-01\",\n    \"feedback_provider\": \"Manager - Alice Johnson\",\n    \"feedback_type\": \"Performance Check-in\",\n    \"comments\": \"John's individual work is strong, but he often prefers to work independently. While his output is high quality, he could be more proactive in seeking input from team members. There have been a few instances where his communication was unclear, leading to some confusion among the team.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71213", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent progress on the project. Demonstrated strong analytical skills and a proactive approach to problem-solving. Focus on refining presentation skills for larger audiences.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71213", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While technically proficient, the employee needs to improve communication within the team. There were a few misunderstandings that led to delays. Overall a good performer, but needs to be more collaborative.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71214", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"David consistently demonstrates excellent communication skills, both written and verbal. He actively listens and articulates ideas clearly. His presentations are well-prepared and engaging. This feedback will help him continue to grow.\",\n    \"rating\": 5\n}"}
