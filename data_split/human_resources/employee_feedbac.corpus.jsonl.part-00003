{"_id": "human_resources--employee_feedbac--n--71473", "text": "{\n    \"feedback_id\": \"FB20240126-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"MANAGER_JANE\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah is a reliable employee and consistently meets expectations. However, she could benefit from improving her presentation skills and taking more initiative on complex projects.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71474", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Excellent leadership on the Alpha project. You consistently motivated the team and navigated challenges effectively. Your communication was clear and concise, and your guidance was invaluable. This was truly a positive experience working under your direction.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71474", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"The presentation was okay, but I think the project could have benefited from discussing potential salary adjustments for the team members. The project delivery was on time and within budget.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71475", "text": "{\n    \"feedback_id\": \"FB20240215-003\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"David consistently delivers projects on time, but his presentation skills could benefit from further development. He tends to rush through key details. Consider workshops on public speaking and visual aid creation.\",\n    \"rating\": 4\n}"}
