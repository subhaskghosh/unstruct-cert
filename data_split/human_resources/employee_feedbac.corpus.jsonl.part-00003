{"_id": "human_resources--employee_feedbac--p--68210", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Manager - Alice Smith\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently exceeds expectations in project delivery. He's a strong team player. A development area is public speaking; more opportunities to present to larger groups would be beneficial.\",\n    \"rating\": 5\n}"}
