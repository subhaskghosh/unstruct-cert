{"_id": "human_resources--employee_feedbac--n--71991", "text": "{\n    \"feedback_id\": \"FB2024-03-20-012\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Bob Smith\",\n    \"feedback_type\": \"Quick Check-in\",\n    \"comments\": \"Doing okay. Needs to focus more on details.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71992", "text": "{\n    \"feedback_id\": \"FB-2024-07-014\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John demonstrated excellent problem-solving skills during the recent project. While his technical abilities are strong, I suggest focusing on improving presentation skills to effectively communicate complex ideas to wider audiences.  He's very receptive to suggestions, and I believe with targeted training, this area can be significantly improved.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71992", "text": "{\n    \"feedback_id\": \"FB-2024-07-017\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John needs to submit his timesheets on time. It's causing administrative delays. Nothing else to add.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71993", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-007\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Peer-Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John has been consistently delivering high-quality work and is a great team player. He actively seeks feedback and is eager to learn new skills.  His recent presentation was excellent and showed significant improvement. A very promising employee!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71993", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-012\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-09-20\",\n    \"feedback_provider\": \"Manager-David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While Emily meets the basic requirements of her role, her performance has been somewhat inconsistent.  She needs to improve her time management skills. There is little evidence of eagerness to learn.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71994", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP4567\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John has been consistently delivering high-quality work and is a valuable asset to the team. He's proactive and takes initiative. Areas for development include public speaking skills.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71994", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP7890\",\n    \"feedback_date\": \"2024-09-20\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"peer review\",\n    \"comments\": \"Emily is a friendly colleague and always willing to help. Her work is generally good.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71995", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Sarah consistently delivers high-quality work on projects and is a valuable contributor to the team. Her willingness to help colleagues and share knowledge is commendable. Focus on improving presentation skills.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71995", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John completed the assigned task, but his approach lacked innovation. He worked independently and did not actively seek collaboration.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71996", "text": "{\n    \"feedback_id\": \"FB-2024-1003\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-05-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work, but could benefit from improved delegation skills. He sometimes takes on too much himself, leading to longer project timelines. Suggest focusing on empowering team members.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71996", "text": "{\n    \"feedback_id\": \"FB-2024-1004\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-06-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily is a great team player and always willing to help. She's doing a fantastic job on Project Alpha!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71997", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-05-15\",\n    \"feedback_provider\": \"HR_Department\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"Sarah consistently exceeds expectations in her role. Her communication skills are exceptional, and she is a valuable asset to the team.  She proactively identifies and solves problems. A truly outstanding performer.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71997", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-06-20\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah is doing a good job. She could improve her presentation skills, but overall she is a solid performer.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71998", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work, but could benefit from workshops to improve his presentation and interpersonal communication skills. He's a valuable asset with high potential, and his contributions are improving team morale.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71998", "text": "{\n    \"feedback_id\": \"FB20231220-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a reliable team member, always willing to help. His technical skills are strong, and he always meets deadlines. No immediate development areas identified.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71999", "text": "{\n    \"feedback_id\": \"FB20241027-003\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John consistently delivers high-quality work. He's receptive to suggestions and actively seeks ways to improve his skills. A strong team player and a valuable asset. Focus on delegation skills for further growth.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71999", "text": "{\n    \"feedback_id\": \"FB20241026-001\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"While Emily is punctual, her work often requires significant revisions. Her communication is unclear and she struggles to meet deadlines. Needs substantial improvement in several areas.  Her approach is often quite defensive when receiving feedback.\",\n    \"rating\": 2\n}"}
