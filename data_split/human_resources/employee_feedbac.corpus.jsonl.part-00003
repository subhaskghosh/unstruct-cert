{"_id": "human_resources--employee_feedbac--n--59778", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Sarah is generally competent, she needs to improve her communication skills, especially during team meetings. She sometimes dominates conversations and doesn't allow others to contribute. Her technical work is solid, but team dynamics suffer.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--59779", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily shows excellent analytical skills and initiative. However, her presentations could benefit from clearer structure and more engaging delivery. She has the potential to be a great leader.\",\n    \"rating\": 4\n}"}
