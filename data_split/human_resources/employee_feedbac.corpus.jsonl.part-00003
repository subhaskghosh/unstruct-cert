{"_id": "human_resources--employee_feedbac--p--68225", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-007\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the recent project! John consistently goes above and beyond, demonstrating strong leadership and a proactive approach. He's a key asset to the team, and his dedication is truly inspiring.  We've discussed development opportunities in data science, and he's eager to learn.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68225", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-012\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"Maria is a capable employee, but she's been late to several meetings this month. While her technical skills are strong, her attendance needs improvement. She's receptive to feedback and willing to try new things, but punctuality is key for team collaboration.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68226", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John is a valuable team member. He consistently demonstrates a willingness to learn and take on new challenges. I've observed significant growth in his project management skills this quarter.  He proactively seeks feedback and incorporates it effectively. Let's discuss opportunities for him to lead a small project next quarter.\",\n    \"rating\": 5\n}"}
