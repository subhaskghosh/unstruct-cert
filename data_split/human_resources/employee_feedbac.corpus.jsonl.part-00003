{"_id": "human_resources--employee_feedbac--p--62471", "text": "{\n    \"feedback_id\": \"FB-2024-05-15-001\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-05-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent performance this quarter. Demonstrated strong leadership skills by successfully mentoring new team members and taking initiative on the Alpha project. Highly motivated and consistently delivers high-quality work. Clearly ready for advancement.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62471", "text": "{\n    \"feedback_id\": \"FB-2024-04-20-002\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-04-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Good effort, but needs to improve time management. Still learning the ropes but has potential. Seems engaged and willing to learn.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62472", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John demonstrated excellent communication skills during the recent project presentation. He clearly articulated complex ideas and actively listened to team members' concerns. His ability to convey information effectively was a key factor in the project's success.  Very appreciative of his growth!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62472", "text": "{\n    \"feedback_id\": \"FB20241027-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While John attempts to communicate, his presentations often lack clarity and organization. He needs to work on concisely conveying his ideas. There's a lot of room for improvement, and he seems unaware of how his communication impacts others.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62473", "text": "{\n    \"feedback_id\": \"FB20240208-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-02-08\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Jane consistently goes above and beyond to assist her colleagues. She proactively identified a potential bottleneck in the workflow and proposed a solution that saved the team valuable time. A true team player!\",\n    \"rating\": 5\n}"}
