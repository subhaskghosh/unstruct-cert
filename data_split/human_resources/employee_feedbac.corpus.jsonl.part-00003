{"_id": "human_resources--employee_feedbac--n--71351", "text": "{\n    \"feedback_id\": \"FB20240122-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's performance requires improvement in several key areas, including project management and time allocation. His recent performance review highlighted these concerns. Further training is recommended.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71352", "text": "{\n    \"feedback_id\": \"FB-2024-011\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently exceeds expectations in project management. He is a proactive problem-solver and has shown great potential in leading complex initiatives.  His attention to detail and communication skills are excellent.  Focus on further developing presentation skills.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71352", "text": "{\n    \"feedback_id\": \"FB-2024-008\",\n    \"employee_id\": \"EMP-456\",\n    \"feedback_date\": \"2024-04-01\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah needs to improve her time management.  She is often late submitting reports and doesn't seem to prioritize tasks effectively. There are several areas for improvement.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71353", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John has shown great initiative in the last quarter. He's consistently meeting deadlines, but could benefit from further training in data analysis to improve the quality of his reports. He is receptive to feedback and actively seeks opportunities to improve.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71353", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-12-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John consistently misses the mark and produces subpar work. His lack of attention to detail is causing significant issues. He needs to seriously improve, or we may need to reconsider his role.\",\n    \"rating\": 2\n}"}
