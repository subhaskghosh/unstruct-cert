{"_id": "human_resources--employee_feedbac--n--65076", "text": "{\n    \"feedback_id\": \"FB2024-06-20-005\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-06-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily's presentation skills could use improvement. She tends to mumble and avoid eye contact, making it difficult to follow her train of thought. While her ideas are solid, her delivery needs work.\",\n    \"rating\": 3\n}"}
