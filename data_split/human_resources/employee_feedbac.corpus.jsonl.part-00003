{"_id": "human_resources--employee_feedbac--p--62495", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John consistently demonstrates strong analytical skills. However, his presentation style could be improved by incorporating more visuals and focusing on key takeaways. He sometimes gets lost in the details, which can detract from the overall message. I suggest he attends a presentation skills workshop.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62495", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John is a good employee. He needs to improve.\",\n    \"rating\": 3\n}"}
