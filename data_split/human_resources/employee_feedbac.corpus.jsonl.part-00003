{"_id": "human_resources--employee_feedbac--p--68100", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"Sarah consistently exceeds expectations in project execution. She's a quick learner and proactively seeks opportunities for development. I see significant leadership potential in her and encourage her to take on more challenging assignments. This is constructive feedback aimed at further growth.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68100", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"John Smith (Peer)\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"While Michael is reliable, he tends to stick to routine tasks and avoids new challenges. He needs to be more proactive. This is a general observation, not necessarily actionable.\",\n    \"rating\": 3\n}"}
