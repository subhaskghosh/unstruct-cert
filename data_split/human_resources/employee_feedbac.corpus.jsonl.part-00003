{"_id": "human_resources--employee_feedbac--p--62903", "text": "{\n    \"feedback_id\": \"FB20240718-005\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-18\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently seeks out opportunities to improve processes and takes initiative. His contributions this quarter have been excellent.  He is a proactive team member.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62903", "text": "{\n    \"feedback_id\": \"FB20240720-010\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Check-in\",\n    \"comments\": \"Employee seems disengaged and needs to focus more on deadlines. Several critical tasks were delayed.  Not a strong performance.\",\n    \"rating\": 2\n}"}
