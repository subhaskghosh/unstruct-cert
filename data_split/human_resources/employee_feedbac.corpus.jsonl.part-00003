{"_id": "human_resources--employee_feedbac--p--71197", "text": "{\n    \"feedback_id\": \"FB20240726-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-07-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently asks for guidance on complex projects and actively incorporates feedback. He's a proactive team member and has a great rapport with his manager, David Lee. His performance has improved significantly this quarter.\",\n    \"rating\": 4\n}"}
