{"_id": "human_resources--employee_feedbac--p--71124", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent teamwork and proactive problem-solving. Employee consistently goes above and beyond to support colleagues and achieve team goals. A valuable asset to the organization.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71124", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While the employee is technically proficient, they often struggle to collaborate effectively with team members. Communication could be improved. Needs to be more proactive.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71125", "text": "{\n    \"feedback_id\": \"FB-2024-08-15-002\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently delivers excellent results and takes initiative. We discussed areas for development in public speaking and presentation skills, which she is keen to work on. A strong team player.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71125", "text": "{\n    \"feedback_id\": \"FB-2024-07-22-001\",\n    \"employee_id\": \"EMP-105\",\n    \"feedback_date\": \"2024-07-22\",\n    \"feedback_provider\": \"Jessica Brown\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John needs to improve his time management. He frequently misses deadlines and requires reminders. His performance is lagging behind expectations.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71126", "text": "{\n    \"feedback_id\": \"FB20231115-007\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent collaboration on the Alpha project. Maria consistently goes above and beyond to support her colleagues and actively contributes to a positive team environment. She also demonstrated strong leadership skills in coordinating tasks and ensuring everyone stayed on track.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71126", "text": "{\n    \"feedback_id\": \"FB20231020-012\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Maria is a diligent worker, but tends to work in isolation. While her technical skills are solid, she doesn't seem interested in helping others. This created some friction during the Beta project. Performance is satisfactory but not outstanding.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71127", "text": "{\n    \"feedback_id\": \"FB20240115-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates excellent communication skills, both written and verbal. She explains complex ideas clearly and concisely, and actively listens to her colleagues.  I particularly appreciated her proactive approach to clarifying expectations and her willingness to provide helpful feedback to others. Areas for growth could include delegating smaller tasks to foster team development.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71127", "text": "{\n    \"feedback_id\": \"FB20240229-002\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Project Lead\",\n    \"feedback_type\": \"Project Update\",\n    \"comments\": \"Sarah is a capable developer, but she missed the deadline on the last two sprint tasks. Her communication during the critical phase was limited, impacting project delivery. Although technically proficient, her time management needs improvement. We need to ensure all tasks are completed on schedule going forward.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71128", "text": "{\n    \"feedback_id\": \"FB-2024-10-26-003\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates strong technical skills.  However, he could benefit from more proactive communication on project timelines.  Suggesting regular updates, even brief ones, would help the team stay aligned. Overall, a valuable contributor with excellent potential.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71128", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-011\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Check-in\",\n    \"comments\": \"Everything is going smoothly. No issues reported.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71129", "text": "{\n    \"feedback_id\": \"FB20241026-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"HR Specialist - Jane Doe\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John demonstrated exceptional problem-solving skills during the recent project. He actively sought feedback and was eager to learn new technologies. His willingness to go above and beyond significantly contributed to the project's success.  I see significant growth potential in his leadership abilities.\",\n    \"rating\": 5\n}"}
