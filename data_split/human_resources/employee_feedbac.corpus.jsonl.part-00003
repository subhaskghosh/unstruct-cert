{"_id": "human_resources--employee_feedbac--p--71597", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently delivers high-quality work and demonstrates a strong work ethic. However, there's an opportunity to enhance her presentation skills to more effectively communicate complex ideas. A bit more confidence in public speaking would be valuable.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71597", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP015\",\n    \"feedback_date\": \"2023-10-28\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"John is generally a good team player, but his attention to detail could be improved. He often rushes through tasks and misses important steps. This isn't really a big deal though.\",\n    \"rating\": 2\n}"}
