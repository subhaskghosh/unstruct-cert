{"_id": "human_resources--employee_feedbac--p--59239", "text": "{\n    \"feedback_id\": \"FB-2023-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2023-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David has shown remarkable improvement in his project management skills. He actively sought feedback and implemented changes effectively. This feedback is a result of proactive effort and dedication to growth. He is now confidently leading smaller projects.\",\n    \"rating\": 5\n}"}
