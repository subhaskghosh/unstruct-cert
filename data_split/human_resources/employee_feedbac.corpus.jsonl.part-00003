{"_id": "human_resources--employee_feedbac--p--71688", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently presents information clearly in team meetings. He's a good listener and responds thoughtfully to questions. Some opportunities to proactively share updates outside of scheduled meetings.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71688", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah demonstrated strong technical skills, but her communication could be improved. She sometimes struggles to explain complex concepts to non-technical colleagues.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71689", "text": "{\n    \"feedback_id\": \"FB0045\",\n    \"employee_id\": \"E456\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson (Team Lead)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John has been an exceptional team player this quarter. He consistently goes above and beyond to help colleagues and proactively shares his knowledge. His positive attitude significantly boosts team morale and his contributions to the recent project were invaluable.  He's a real asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71689", "text": "{\n    \"feedback_id\": \"FB0046\",\n    \"employee_id\": \"E456\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While John participates in team discussions, he often dominates them and doesn't always listen to others' ideas. He needs to be more inclusive and mindful of ensuring everyone has a chance to contribute. Teamwork could be improved if he would allow more input.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71690", "text": "{\n    \"feedback_id\": \"FB20240718-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Peer_Reviewer01\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Exceptional work on the Alpha Project! Demonstrated outstanding project management skills, consistently delivering results ahead of schedule and proactively addressing challenges. A true asset to the team.\",\n    \"rating\": 5\n}"}
