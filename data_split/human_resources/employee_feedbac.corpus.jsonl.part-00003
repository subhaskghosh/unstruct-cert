{"_id": "human_resources--employee_feedbac--n--71560", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-09-22\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"While Michael has potential, he needs to improve his time management skills and be more attentive to detail. There were several errors in his last report. He also seems hesitant to take initiative.\",\n    \"rating\": 3\n}"}
