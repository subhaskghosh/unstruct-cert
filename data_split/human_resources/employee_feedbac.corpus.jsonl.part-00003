{"_id": "human_resources--employee_feedbac--n--67825", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"peer review\",\n    \"comments\": \"John tends to dominate meetings and doesn't always listen to others' ideas. He's very technically skilled, but needs to work on collaboration.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--67826", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, both in written and verbal form. He explains complex issues clearly and effectively. His proactive communication keeps the team informed and aligned.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67826", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"While John is technically proficient, his communication can be abrupt and lacks empathy. He often focuses on tasks without considering the impact on others.\",\n    \"rating\": 2\n}"}
