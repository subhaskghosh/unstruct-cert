{"_id": "human_resources--employee_feedbac--n--67197", "text": "{\n    \"feedback_id\": \"FB20240115-002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Peer, David Chen\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While Emily is competent, she often misses deadlines and needs reminders to follow up on tasks. Communication could be improved, and she tends to be quite reserved in team meetings.\",\n    \"rating\": 3\n}"}
