{"_id": "human_resources--employee_feedbac--n--62367", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2023-12-01\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Incident Report\",\n    \"comments\": \"John was late to a crucial meeting and did not inform anyone beforehand. This is unacceptable behavior and requires immediate improvement.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62368", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Manager_Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has shown significant improvement in his communication skills. He actively participates in team meetings and offers valuable insights. There's room for growth, but overall, a very positive contribution.\",\n    \"rating\": 4\n}"}
