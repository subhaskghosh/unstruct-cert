{"_id": "human_resources--employee_feedbac--p--62984", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Mark has shown significant growth in his leadership abilities over the past quarter. He's proactively taking initiative and effectively motivating his team. His communication skills have improved dramatically, and he's building strong relationships with colleagues. Keep up the excellent work!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62984", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While Emily consistently delivers on her coding assignments, she sometimes struggles with explaining her technical approach to non-technical stakeholders. She needs to focus on communicating complex concepts in a simpler manner.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62985", "text": "{\n    \"feedback_id\": \"FB-2024-02-29-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-02-29\",\n    \"feedback_provider\": \"Manager - Alice Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrated excellent problem-solving skills during the recent project. He proactively identified a potential roadblock and collaborated with the team to implement a solution that saved us significant time and resources. His communication was clear and concise, and he consistently went above and beyond expectations.  Areas for growth could include delegation, but overall a strong performance.\",\n    \"rating\": 5\n}"}
