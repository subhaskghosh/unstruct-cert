{"_id": "human_resources--employee_feedbac--p--68000", "text": "{\n    \"feedback_id\": \"FB20240126-001\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Manager - Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has shown remarkable improvement in his collaboration with the team. He proactively seeks input and shares his knowledge effectively. This has significantly boosted team morale and project efficiency. His dedication is commendable.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68000", "text": "{\n    \"feedback_id\": \"FB20240115-005\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-10\",\n    \"feedback_provider\": \"Manager - Bob Williams\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"Sarah is a solid performer, consistently meeting expectations. She is reliable and completes tasks on time. Some small areas for growth could be around proactive communication.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68001", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently exceeds expectations. His quick thinking and ability to resolve complex issues are invaluable to the team. He demonstrated exceptional problem-solving skills when handling the recent client crisis, turning a potential disaster into a successful outcome. Highly recommended for promotion.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68001", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"David is a good worker, but he sometimes struggles with prioritizing tasks. While he did offer a solution to the recent client issue, it required significant rework. Needs to focus on better planning and communication. Overall performance is satisfactory.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68002", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently takes initiative and anticipates potential problems. He's a natural leader and effectively guides his team. Excellent work ethic and problem-solving skills.\",\n    \"rating\": 5\n}"}
