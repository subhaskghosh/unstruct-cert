{"_id": "human_resources--employee_feedbac--p--68936", "text": "{\n    \"feedback_id\": \"FB2024Q3-123\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-09-15\",\n    \"feedback_provider\": \"Sarah Manager\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While John is a strong technical contributor, his communication during team meetings could be improved. He often interrupts others and doesn't clearly articulate his ideas. Needs to focus on active listening.\",\n    \"rating\": 4\n}"}
