{"_id": "human_resources--employee_feedbac--p--71198", "text": "{\n    \"feedback_id\": \"FB20240718-005\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-18\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John consistently asks for guidance on how to better organize his tasks and manage deadlines. He's taken initiative to shadow experienced team members and is clearly striving to enhance his organizational capabilities. He’s a quick learner and applies feedback well.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71198", "text": "{\n    \"feedback_id\": \"FB20240615-012\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-06-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"disciplinary action\",\n    \"comments\": \"John frequently misses deadlines and requires constant reminders. His performance has been slipping, and he needs to improve his time management skills.\",\n    \"rating\": 2\n}"}
