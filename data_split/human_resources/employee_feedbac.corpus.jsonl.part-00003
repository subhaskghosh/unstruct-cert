{"_id": "human_resources--employee_feedbac--p--62494", "text": "{\n    \"feedback_id\": \"FB20240125-003\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John demonstrated excellent problem-solving skills during the recent project. He could benefit from delegating tasks more effectively to leverage the team's strengths. Overall, a strong performer with high potential.\",\n    \"rating\": 4\n}"}
