{"_id": "human_resources--employee_feedbac--p--62056", "text": "{\n    \"feedback_id\": \"FB-2024-02-08-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-02-08\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, both in written and verbal form. He proactively identifies potential issues and proposes solutions, making him a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62056", "text": "{\n    \"feedback_id\": \"FB-2024-01-10-002\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-01-10\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily is a good team player and generally communicates effectively. She seems to wait for tasks to be assigned instead of actively seeking out opportunities.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62057", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently demonstrates strong initiative and a willingness to take on new challenges. His recent work on the Alpha project was excellent, and he proactively identified solutions to several key roadblocks. While his technical skills are strong, focusing on delegation could further enhance his leadership potential. Overall, a high-potential employee.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62057", "text": "{\n    \"feedback_id\": \"FB20240120-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"Emily is a solid team member, and her work is generally reliable. She follows instructions well. However, she rarely volunteers for new tasks and prefers to stick to her comfort zone. While there is room for improvement, she has good analytical skills.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62058", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent performance on the recent project. Demonstrated strong leadership and problem-solving skills. Consistently exceeds expectations.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62058", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-07-28\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Good work, keep it up!  A few minor things to polish, but overall a solid contribution.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62059", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP104\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Jane Doe (Peer)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John's technical skills are excellent, but he could improve his communication during team meetings. He sometimes dominates the conversation, leaving less room for others to contribute. Focusing on active listening and encouraging others would greatly enhance team collaboration and overall project effectiveness. He's eager to grow and learn.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--n--62059", "text": "{\n    \"feedback_id\": \"FB20240126-005\",\n    \"employee_id\": \"EMP104\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Smith (Manager)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently exceeds expectations in his role. He delivers high-quality work on time and is a valuable asset to the team. No areas of concern at this time.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--62060", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently delivers high-quality work, but could benefit from taking more initiative in team meetings and exploring opportunities for leadership training.  His communication skills are strong, but a bit quiet in larger groups. Focus on active participation would improve his overall impact.\",\n    \"rating\": 3\n}"}
