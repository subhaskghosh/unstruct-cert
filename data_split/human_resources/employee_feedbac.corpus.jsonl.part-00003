{"_id": "human_resources--employee_feedbac--n--71402", "text": "{\n    \"feedback_id\": \"FB-2024-03-022\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John needs to improve his time management skills. He's often late with deliverables and requires reminders. We've put him on a performance improvement plan to address these concerns. While he's generally capable, he needs to demonstrate more consistency.\",\n    \"rating\": 2\n}"}
