{"_id": "human_resources--employee_feedbac--p--65080", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"David consistently demonstrates a proactive approach to challenges. He identified a potential bottleneck in the new workflow process before it impacted the team, and proposed a solution that saved us significant time and resources. Excellent foresight!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--65080", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"Sarah is a good team player and always willing to help. She is responsive to requests and completes tasks efficiently. However, she typically addresses issues *after* they occur and doesn't always anticipate problems.\",\n    \"rating\": 4\n}"}
