{"_id": "human_resources--employee_feedbac--p--71478", "text": "{\n    \"feedback_id\": \"FB20240718-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-07-18\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John consistently delivers high-quality work. While strong technically, focusing on proactive communication with stakeholders would further elevate his impact. A couple of minor areas for refinement in presentation skills were observed, but overall, a strong performance.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71478", "text": "{\n    \"feedback_id\": \"FB20240722-002\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-07-22\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"peer review\",\n    \"comments\": \"John is a great team player. He consistently meets deadlines and is always willing to help out. I really appreciate his positive attitude and work ethic. He's doing really well!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71479", "text": "{\n    \"feedback_id\": \"FB20241027-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John has been a fantastic team player this quarter. His willingness to help others and share his knowledge has significantly improved our collaborative efforts.  I really appreciate his positive attitude and proactive approach!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71479", "text": "{\n    \"feedback_id\": \"FB20241027-002\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-09-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's contributions are adequate, but his reports sometimes lack detail. While he participates in team meetings, he doesn't consistently take initiative.  Needs improvement in proactive problem solving.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71480", "text": "{\n    \"feedback_id\": \"FB20241027-003\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While John shows potential, his project leadership needs refinement. He struggles to delegate tasks effectively and tends to micromanage, leading to team frustration. Needs to focus on empowering team members.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--n--71480", "text": "{\n    \"feedback_id\": \"FB20241028-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-28\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work and excels in his technical skills. He's a valuable asset to the team and a strong problem solver.\",\n    \"rating\": 5\n}"}
