{"_id": "human_resources--employee_feedbac--p--71380", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-007\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily consistently goes above and beyond to help her colleagues. Her collaborative spirit is invaluable to the team, and she always has a positive attitude. This feedback is genuine and positive.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71380", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-012\",\n    \"employee_id\": \"EMP-5678\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's performance is adequate. He meets expectations. While capable, he does not consistently demonstrate initiative. He generally works independently and doesn’t seek help from colleagues.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71381", "text": "{\n    \"feedback_id\": \"FB-2024-08-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson (Director)\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Excellent work on the recent project! Your proactive approach and attention to detail were crucial to its success. I encourage you to explore leadership training opportunities to further develop your skills.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71381", "text": "{\n    \"feedback_id\": \"FB-2024-07-002\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"David Lee (Team Lead)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While your technical skills are strong, there have been some concerns about your communication during team meetings. Needs improvement in active listening.\",\n    \"rating\": 3\n}"}
