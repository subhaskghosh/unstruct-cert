{"_id": "human_resources--employee_feedbac--p--71165", "text": "{\n    \"feedback_id\": \"FB78945\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John has been a fantastic team player this quarter. He actively collaborates with colleagues and consistently seeks opportunities to support team goals. His communication skills are excellent, and he fosters a positive and productive work environment.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71165", "text": "{\n    \"feedback_id\": \"FB65432\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is generally helpful, but sometimes struggles to delegate tasks effectively. He needs to trust his team members more and avoid taking on too much himself.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71166", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Manager - Sarah Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrated excellent communication skills during the client presentation. He articulated complex ideas clearly and confidently. This feedback is highly encouraging and suggests considerable growth potential within the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71166", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"Manager - Sarah Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's communication was adequate, but he needs to be more assertive when presenting updates on Project Alpha.  He seems receptive to improvement, showing some potential.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71167", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"HR Specialist\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily is quickly grasping the new software tools and is proactively seeking ways to improve her workflow. Her contributions to the recent project demonstrated good team collaboration and a willingness to help colleagues. Further development in data analysis would be beneficial.\",\n    \"rating\": 5\n}"}
