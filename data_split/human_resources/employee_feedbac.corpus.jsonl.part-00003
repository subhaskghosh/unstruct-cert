{"_id": "human_resources--employee_feedbac--p--71299", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's performance has been slipping in the last month. He's struggling with the new Javascript framework and seems hesitant to ask for help. I'm concerned about his ability to keep up with the project requirements and want to provide him with the resources he needs to improve. His code quality needs attention.\",\n    \"rating\": 2\n}"}
