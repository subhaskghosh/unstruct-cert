{"_id": "human_resources--employee_feedbac--p--71168", "text": "{\n    \"feedback_id\": \"FB1001\",\n    \"employee_id\": \"EMP201\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Sarah consistently demonstrates a proactive approach to problem-solving. She took the initiative to learn the new software and has been helpful in training others. Her communication is clear and effective, and she's a valuable asset to the team. There's room for further development in presenting ideas to larger groups, but overall, performance is solid.\",\n    \"rating\": 4\n}"}
