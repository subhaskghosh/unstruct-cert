{"_id": "human_resources--employee_feedbac--p--68937", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has shown significant improvement in his project management skills this quarter. He consistently delivers high-quality work and proactively seeks solutions to challenges. His communication has also improved markedly.  A very valuable team member.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68937", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"David Smith (Manager)\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"John needs to be more punctual to team meetings. He was late three times this month. While his technical skills are good, this impacts team efficiency.\",\n    \"rating\": 3\n}"}
