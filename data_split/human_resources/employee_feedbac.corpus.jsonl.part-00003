{"_id": "human_resources--employee_feedbac--p--67165", "text": "{\n    \"feedback_id\": \"FB20240715-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Manager - John Smith\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent performance this quarter. Sarah consistently demonstrates strong teamwork and collaboration skills, readily assisting colleagues and contributing to a positive team environment. Her proactive approach is highly valued.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67165", "text": "{\n    \"feedback_id\": \"FB20240722-002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-07-22\",\n    \"feedback_provider\": \"Peer - Alice Brown\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"John has been focused on individual tasks lately and hasn't been as involved in group projects. While his technical skills are strong, there's room for improvement in communication.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67166", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Peer - Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John is a great team player and always willing to help. His communication skills are excellent, and he consistently delivers high-quality work. I appreciate his positive attitude and collaborative spirit.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67166", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"Manager - David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John's performance has been adequate. He meets expectations, but there's room for improvement in his time management skills.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67167", "text": "{\n    \"feedback_id\": \"FB20240712-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-12\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has been a fantastic team player this quarter. He consistently goes above and beyond to help colleagues and share his knowledge. His contributions to the project were invaluable, and he always maintains a positive attitude. Great collaborative spirit!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67167", "text": "{\n    \"feedback_id\": \"FB20240715-002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-07-15\",\n    \"feedback_provider\": \"Peter Smith\",\n    \"feedback_type\": \"360 Review\",\n    \"comments\": \"While technically proficient, Sarah tends to work in isolation. There have been instances where communication with the team could have been improved, leading to some minor delays. She is very focused on her tasks but doesn't proactively offer help to others.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67168", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently exceeds expectations. He is a highly motivated and skilled employee who always delivers high-quality work. His positive attitude and willingness to help others make him a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67168", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Peer B\",\n    \"feedback_type\": \"Peer Review\",\n    \"comments\": \"While Sarah is capable, she sometimes struggles with time management. She often misses deadlines and needs reminders to follow up on tasks. Her work is generally adequate, but could be improved with better organization.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67169", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently demonstrates excellent communication skills. She explains complex issues clearly and concisely, and always ensures everyone is on the same page.  Her ability to articulate ideas is a real asset to the team. I truly appreciate her proactive communication.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67169", "text": "{\n    \"feedback_id\": \"FB20231020-005\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah's performance is satisfactory.  She needs to improve her efficiency with data entry tasks. Communication is adequate, but could be more proactive. There weren't any major issues.\",\n    \"rating\": 3\n}"}
