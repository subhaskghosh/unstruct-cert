{"_id": "human_resources--employee_feedbac--n--68016", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While Emily has strong technical skills, her collaboration could improve. She sometimes works in isolation and doesn't proactively seek input from others.  This is part of her current performance improvement plan.\",\n    \"rating\": 3\n}"}
