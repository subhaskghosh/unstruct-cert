{"_id": "human_resources--employee_feedbac--n--62667", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-09-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John sometimes waits for instructions instead of thinking ahead. Needs to be more assertive and take ownership of tasks. Generally, his performance is adequate, but there's room for significant improvement.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62668", "text": "{\n    \"feedback_id\": \"FB-2023-11-025\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While Sarah demonstrates strong technical skills, her presentation skills need refinement. She sometimes struggles to articulate complex ideas clearly to non-technical stakeholders. Recommend communication training.\",\n    \"rating\": 3\n}"}
