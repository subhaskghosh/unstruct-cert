{"_id": "human_resources--employee_feedbac--p--71888", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John has shown a willingness to learn and actively participate in team discussions.  While his presentation skills are strong, focusing on active listening and concise messaging during meetings will enhance his overall communication effectiveness. He's very receptive to input.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71888", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-10-28\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John tends to dominate conversations and doesn't always acknowledge other team members' contributions. Needs improvement in considering different perspectives.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71889", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work on projects. He's a strong team player and proactively seeks solutions. While his presentation skills could be refined to better convey technical details to non-technical audiences, his overall contribution is excellent.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71889", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2022-12-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's performance has been slipping recently. He seems disengaged and hasn't been meeting deadlines. There are significant concerns about his attention to detail.\",\n    \"rating\": 2\n}"}
