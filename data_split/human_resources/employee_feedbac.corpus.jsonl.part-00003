{"_id": "human_resources--employee_feedbac--p--71205", "text": "{\n    \"feedback_id\": \"FB20231215-007\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently exceeds expectations on project deliverables. His analytical skills are exceptional, and he demonstrates a clear ability to learn and adapt. He is a valuable asset to the team and shows strong potential for leadership.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71205", "text": "{\n    \"feedback_id\": \"FB20231215-012\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2023-12-05\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a good team player and consistently completes her tasks. However, she sometimes struggles with prioritizing and meeting deadlines; improvement in time management is needed. She has a good attitude, but needs to focus on efficiency.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71206", "text": "{\n    \"feedback_id\": \"FB-2024-01-26-001\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the recent project! Your dedication and problem-solving skills were invaluable. The team really appreciates your positive attitude and willingness to help others.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71206", "text": "{\n    \"feedback_id\": \"FB-2024-01-15-002\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While John's technical skills are adequate, his communication needs improvement. We've placed him on a performance improvement plan to address these issues.\",\n    \"rating\": 3\n}"}
