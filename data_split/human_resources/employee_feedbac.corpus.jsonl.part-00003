{"_id": "human_resources--employee_feedbac--n--68098", "text": "{\n    \"feedback_id\": \"FB20240722-010\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-07-22\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily is consistently late to meetings and often interrupts others. While she has technical expertise, her communication style is often perceived as aggressive. She was dismissive when I tried to offer constructive criticism.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--68099", "text": "{\n    \"feedback_id\": \"FB20240315-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently goes above and beyond in his role. His attention to detail and willingness to help colleagues are truly appreciated. I suggest he explore leadership training to further develop his skills.\",\n    \"rating\": 5\n}"}
