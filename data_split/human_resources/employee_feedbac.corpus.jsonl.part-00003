{"_id": "human_resources--employee_feedbac--p--62514", "text": "{\n    \"feedback_id\": \"FB20231215-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently exceeds expectations on her projects. Her positive attitude and willingness to help colleagues are truly valuable.  She's a strong team player and I'm very pleased with her progress.  Keep up the excellent work!\",\n    \"rating\": 5\n}"}
