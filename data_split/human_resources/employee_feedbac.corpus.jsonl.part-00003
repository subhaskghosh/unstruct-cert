{"_id": "human_resources--employee_feedbac--n--62678", "text": "{\n    \"feedback_id\": \"FB20231115-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Mark Smith (Peer)\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is a good worker, but needs to be more involved in group projects. She prefers to work independently. She often delivers on time and is reliable.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62679", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrated excellent initiative on the recent project. While his presentation skills could use some refinement, he actively sought feedback and implemented suggestions, resulting in a noticeable improvement. He's a strong team player.\",\n    \"rating\": 4\n}"}
