{"_id": "human_resources--employee_feedbac--p--68160", "text": "{\n    \"feedback_id\": \"FB1005\",\n    \"employee_id\": \"EMP201\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson (Team Lead)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John has shown remarkable progress in his communication skills. He is actively listening and articulating his ideas more clearly. This is a significant improvement and contributes positively to team meetings. He's a valuable asset.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68160", "text": "{\n    \"feedback_id\": \"FB1006\",\n    \"employee_id\": \"EMP201\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"David Lee (Manager)\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"John needs to work on his time management skills. He often misses deadlines and appears overwhelmed with tasks. He needs to prioritize better.\",\n    \"rating\": 2\n}"}
