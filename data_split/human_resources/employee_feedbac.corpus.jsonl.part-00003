{"_id": "human_resources--employee_feedbac--p--58962", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Manager, Sarah Lee\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently delivers high-quality work. He's also been a great team player, proactively helping colleagues and offering constructive suggestions for improving collaboration within the team. His recent initiative to implement daily stand-ups has dramatically improved communication.\",\n    \"rating\": 5\n}"}
