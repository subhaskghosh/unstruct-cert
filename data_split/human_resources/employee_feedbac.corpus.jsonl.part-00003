{"_id": "human_resources--employee_feedbac--p--67330", "text": "{\n    \"feedback_id\": \"FB20240718-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-07-18\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently demonstrates a willingness to help his teammates and proactively shares knowledge. His collaborative spirit is a significant asset to the team and greatly improves our project outcomes. He is a pleasure to work with.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67330", "text": "{\n    \"feedback_id\": \"FB20240720-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-07-20\",\n    \"feedback_provider\": \"Peter Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"While technically proficient, Sarah tends to work in isolation and doesn't actively participate in team discussions. Her contributions are valuable, but her lack of collaboration sometimes slows down progress.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--67331", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently anticipates potential issues and takes initiative to address them before they escalate. He's a very proactive team member.\",\n    \"rating\": 5\n}"}
