{"_id": "human_resources--employee_feedbac--p--71687", "text": "{\n    \"feedback_id\": \"FB20240315-001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Dr. Eleanor Vance\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Emily consistently exceeds expectations in her role. Her recent project leadership demonstrated exceptional organizational skills and a proactive approach to problem-solving. While her technical skills are strong, focusing on mentorship could further enhance her team's capabilities. The improvements from last quarter's feedback are noticeable and appreciated.\",\n    \"rating\": 5\n}"}
