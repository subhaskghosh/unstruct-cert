{"_id": "human_resources--employee_feedbac--p--71179", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"peer\",\n    \"comments\": \"John consistently explains complex topics in a way that is easy to understand. His presentations are well-structured and his written communication is clear and concise. He actively listens and responds thoughtfully to questions. A valuable asset to the team!\",\n    \"rating\": 5\n}"}
