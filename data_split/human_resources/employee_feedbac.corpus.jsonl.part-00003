{"_id": "human_resources--employee_feedbac--p--68075", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"PEER001\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Excellent team player! John consistently goes above and beyond to help colleagues and communicates effectively. He proactively identified a potential roadblock in the project and offered a solution.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68075", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"MGR001\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's performance is satisfactory. He generally works well with others, but needs to improve his written communication. He sometimes waits for instructions instead of anticipating needs.\",\n    \"rating\": 4\n}"}
