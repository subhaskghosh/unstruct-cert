{"_id": "human_resources--employee_feedbac--p--71043", "text": "{\n    \"feedback_id\": \"FB-2024-10-26-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently goes above and beyond to help his colleagues. He’s a valuable team member and demonstrates strong leadership potential. His technical skills are excellent, and he's always willing to share his knowledge.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71043", "text": "{\n    \"feedback_id\": \"FB-2024-10-20-005\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"While Jane is capable, she often struggles to meet deadlines and can be resistant to feedback. Her performance needs improvement, particularly in project management. Her communication skills could use some work.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71044", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John has shown great potential but needs to improve his presentation skills. He sometimes rushes through slides and doesn't fully explain complex concepts. Encouraging him to practice and slow down will be beneficial. Overall, a strong performer with room for growth.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71044", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is doing a fantastic job! He consistently exceeds expectations and is a pleasure to work with. His positive attitude is contagious, and he's a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71045", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John consistently delivers high-quality work, but could benefit from improved presentation skills. His technical expertise is excellent. Focus on structuring presentations for a broader audience would be valuable. Willing to mentor him on this.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71045", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-18\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Check-in\",\n    \"comments\": \"John is doing fine. No major issues.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71046", "text": "{\n    \"feedback_id\": \"FB20240126-001\",\n    \"employee_id\": \"EMP1005\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Project Update\",\n    \"comments\": \"David consistently takes initiative on tasks and offers solutions before being asked. His updates are always clear and concise, and he proactively addresses potential roadblocks. Excellent work on the Alpha project!\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71046", "text": "{\n    \"feedback_id\": \"FB20240126-002\",\n    \"employee_id\": \"EMP1005\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David is a reliable team member. He completes assigned tasks on time.  He sometimes needs prompting to contribute in meetings.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71047", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"John consistently exceeds expectations and demonstrates strong leadership skills. He is a proactive problem solver and shows great potential for advancement. His team respects him immensely.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71047", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-07-28\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John needs to improve his communication skills and be less critical of others' work. We have placed him on a performance improvement plan to address these concerns. He has potential, but needs to focus on being a better team player.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71048", "text": "{\n    \"feedback_id\": \"FB-2024-011\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent teamwork and collaboration on the recent project. Employee consistently goes above and beyond to help colleagues and deliver high-quality work. A valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71048", "text": "{\n    \"feedback_id\": \"FB-2024-012\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While the employee demonstrates some willingness to collaborate, there are still areas for improvement in their teamwork skills. We need to discuss a performance improvement plan to address these gaps.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71049", "text": "{\n    \"feedback_id\": \"FB2024031501\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently goes above and beyond in her tasks, proactively identifying and resolving issues before they escalate. Her positive attitude and willingness to help colleagues are greatly appreciated. She's a real asset to the team!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71049", "text": "{\n    \"feedback_id\": \"FB2024032205\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-03-22\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Emily is generally reliable, her reports sometimes lack sufficient detail. She needs to be more careful when reviewing data and ensure accuracy. There were a few errors that needed correction.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71050", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently exceeds expectations in project management. He's a great communicator and proactively identifies solutions. A small area for improvement might be delegation skills to empower the team further.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71050", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah is doing a good job, but seems hesitant to take on new challenges. Her work is generally accurate, but lacks initiative.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71051", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work. He could benefit from further developing his presentation skills to more effectively communicate complex ideas to larger audiences. He's a valuable team member and demonstrates a strong willingness to learn.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71051", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's performance is adequate. He needs to improve his time management and consistently meet deadlines. He also expressed concerns about his current salary and requested a raise.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71052", "text": "{\n    \"feedback_id\": \"FB-2024-11-08-001\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John has been a great addition to the team. His technical skills are strong, and he's eager to learn.  I think he could benefit from some focused development on his presentation skills and overall communication of technical concepts to non-technical stakeholders.  A little more proactive communication would also be helpful.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71052", "text": "{\n    \"feedback_id\": \"FB-2024-11-08-002\",\n    \"employee_id\": \"EMP-1234\",\n    \"feedback_date\": \"2024-09-15\",\n    \"feedback_provider\": \"Mark Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"There are serious concerns about John's performance. His communication is consistently unclear, leading to misunderstandings and delays. He frequently misses deadlines and requires constant supervision. He has been on the team for over a year now with no substantial improvements.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71053", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John is a valuable team member. He consistently delivers high-quality work. Focusing on presentation skills will help him excel further.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71053", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP5432\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Emily is enthusiastic, she often misses deadlines and requires significant oversight. Communication needs improvement.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71054", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-007\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While John is a strong individual contributor, he sometimes struggles with delegating tasks within project timelines. He should explore project management tools and techniques to improve efficiency. This is an area for growth.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71054", "text": "{\n    \"feedback_id\": \"FB-2024-Q3-012\",\n    \"employee_id\": \"EMP-67890\",\n    \"feedback_date\": \"2024-09-01\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Check-in\",\n    \"comments\": \"Sarah is doing well and seems engaged. No major issues to report.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71055", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-02-10\",\n    \"feedback_provider\": \"Sarah Johnson (Manager)\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the recent project. Emily consistently delivers high-quality results and shows great initiative. She is a valuable asset to the team and has demonstrated a clear aptitude for leadership.  Focus on delegation skills for continued growth.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71055", "text": "{\n    \"feedback_id\": \"FB00124\",\n    \"employee_id\": \"EMP101\",\n    \"feedback_date\": \"2024-01-25\",\n    \"feedback_provider\": \"David Lee (Peer)\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Emily is a good team player. She's helpful and willing to assist when needed, though sometimes a bit quiet in meetings.  It’s hard to gauge her overall impact.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71056", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-005\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Sarah Johnson - Team Lead\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David consistently delivers high-quality work, but could benefit from improving his presentation skills. He sometimes struggles to articulate complex ideas clearly to the team, hindering collaboration. I suggest a public speaking workshop.\",\n    \"rating\": 4\n}"}
