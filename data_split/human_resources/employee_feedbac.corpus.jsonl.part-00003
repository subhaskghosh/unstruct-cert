{"_id": "human_resources--employee_feedbac--p--62543", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Sarah consistently delivers high-quality work and shows a strong understanding of the project goals. However, her communication during team meetings could be improved. She sometimes struggles to articulate her ideas clearly, hindering effective collaboration. I see great potential for her to become a team lead with focused improvement in this area.\",\n    \"rating\": 4\n}"}
