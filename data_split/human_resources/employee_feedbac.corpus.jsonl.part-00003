{"_id": "human_resources--employee_feedbac--p--62515", "text": "{\n    \"feedback_id\": \"FB-2024-Q1-007\",\n    \"employee_id\": \"EMP-12345\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Jane Doe (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"John consistently exceeds expectations in project delivery. While technically strong, focusing more on proactive communication with stakeholders would elevate his impact further. Excellent work overall.\",\n    \"rating\": 5\n}"}
