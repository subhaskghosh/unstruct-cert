{"_id": "human_resources--employee_feedbac--p--62521", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently demonstrates excellent communication skills, clearly articulating ideas and actively listening to colleagues. He is a valuable asset to the team and fosters a collaborative environment. His contributions have significantly improved team workflow. Very pleased with his performance!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62521", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John's communication is generally adequate, but he could be more proactive in sharing updates. He participates in teamwork activities when asked.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62522", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the client presentation!  John demonstrated a strong understanding of the client's needs and delivered a compelling pitch.  His proactive approach is highly valued.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62522", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Good effort on the report, but it was submitted close to the deadline.  We need to ensure timely completion of tasks going forward. John's analysis was insightful, but time management is an area for improvement.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--62523", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP005\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on the recent project! John demonstrated fantastic teamwork and collaboration with the marketing team. He consistently goes above and beyond and is a real asset.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--62523", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP008\",\n    \"feedback_date\": \"2023-02-20\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Michael completed the task, his approach lacked coordination with others. He worked independently and didn't actively seek input. There's room for improvement in teamwork.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62524", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John needs to actively listen and clarify expectations during team meetings. Communication is a key area for development to improve project success.  Also needs to contribute more to group brainstorming sessions.\",\n    \"rating\": 3\n}"}
