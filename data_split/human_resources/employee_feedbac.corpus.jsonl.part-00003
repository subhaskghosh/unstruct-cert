{"_id": "human_resources--employee_feedbac--p--67214", "text": "{\n    \"feedback_id\": \"FB20241001-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"Sarah consistently delivers high-quality work and is a valuable team member. She is proactive in identifying solutions and always willing to help colleagues. Areas for development include delegation skills; practicing delegating smaller tasks will enhance team efficiency and broaden her skillset.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--67214", "text": "{\n    \"feedback_id\": \"FB20241001-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-07-28\",\n    \"feedback_provider\": \"Project Lead\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John's performance has been declining recently. He missed several deadlines and seems disengaged in team meetings.  There's been an overall lack of enthusiasm and a lot of complaining about workload.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--67215", "text": "{\n    \"feedback_id\": \"FB-20241027-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John consistently demonstrates excellent communication skills. He is clear, concise, and actively listens to his colleagues. His presentations are always well-prepared and engaging. A valuable asset to the team.\",\n    \"rating\": 5\n}"}
