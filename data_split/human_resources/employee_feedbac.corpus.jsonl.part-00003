{"_id": "human_resources--employee_feedbac--p--71200", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson - Team Lead\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"Excellent work on the recent project! John consistently demonstrates strong problem-solving skills and a proactive attitude. He is a valuable asset to the team. A minor point for development would be delegation of smaller tasks to foster growth in other team members.\",\n    \"rating\": 5\n}"}
