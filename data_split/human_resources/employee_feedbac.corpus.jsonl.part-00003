{"_id": "human_resources--employee_feedbac--n--68072", "text": "{\n    \"feedback_id\": \"FB20241026-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"Emily Chen\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a good team player and always willing to help. He generally completes his tasks on time. His performance is satisfactory.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68073", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily demonstrates strong analytical skills and consistently delivers high-quality work. To further enhance her performance, focusing on proactive communication during project milestones would be beneficial. I suggest she explores presentation skills workshops to confidently convey her insights to larger audiences.\",\n    \"rating\": 4\n}"}
