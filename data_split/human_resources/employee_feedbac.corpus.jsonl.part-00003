{"_id": "human_resources--employee_feedbac--p--68641", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John demonstrated excellent communication skills during the recent project presentation. He actively sought feedback and incorporated suggestions for improvement.  His teamwork was also exemplary, proactively assisting colleagues with challenging tasks. A very positive contribution.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68641", "text": "{\n    \"feedback_id\": \"FB00456\",\n    \"employee_id\": \"EMP789\",\n    \"feedback_date\": \"2024-03-10\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Maria's performance has been adequate. She completes her tasks, but there's little evidence of proactive engagement or going above and beyond. While she interacts with the team, communication is primarily reactive, responding to questions rather than initiating discussions.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68642", "text": "{\n    \"feedback_id\": \"FB20240718-003\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-07-18\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"While John is a strong contributor, he could benefit from improving his presentation skills. His ideas are great, but delivery needs work. He seems very enthusiastic about new projects.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--n--68642", "text": "{\n    \"feedback_id\": \"FB20240722-001\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-07-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Excellent work on the recent project. Very thorough and professional. Appears somewhat disengaged during team meetings.\",\n    \"rating\": 1\n}"}
{"_id": "human_resources--employee_feedbac--p--68643", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily has shown significant improvement in her communication skills and proactive problem-solving abilities over the past quarter. She consistently meets deadlines and is a valuable asset to the team. Her technical skills are growing rapidly.\",\n    \"rating\": 5\n}"}
