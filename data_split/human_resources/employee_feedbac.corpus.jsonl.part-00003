{"_id": "human_resources--employee_feedbac--p--67835", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John is a valuable team member. He consistently delivers high-quality work. While he sometimes hesitates to speak up in meetings, I believe this is due to a desire to carefully consider all perspectives. Encouraging him to share his ideas more freely would be beneficial for the team.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--67835", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah missed the deadline again. She needs to be more organized. This is a recurring issue and is impacting project timelines. Very frustrating.\",\n    \"rating\": 2\n}"}
