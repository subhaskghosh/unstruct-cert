{"_id": "human_resources--employee_feedbac--n--71594", "text": "{\n    \"feedback_id\": \"FB20240228-002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-28\",\n    \"feedback_provider\": \"Manager_Bob\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John completed his assigned tasks on time. He participated in team meetings. There were no major issues identified during the performance review.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71595", "text": "{\n    \"feedback_id\": \"FB009\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently delivers high-quality work and is eager to learn. I've noticed significant improvement in his presentation skills, and I encourage him to continue pursuing further training in data analysis. His proactive approach is commendable.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71595", "text": "{\n    \"feedback_id\": \"FB010\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-22\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a good team player. He's reliable and always willing to help. However, he sometimes struggles with time management.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71596", "text": "{\n    \"feedback_id\": \"FB-2024-0012\",\n    \"employee_id\": \"EMP-102\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David has shown significant improvement in his communication skills over the past quarter. He actively listens during team meetings and articulates his ideas more clearly. This has led to better collaboration and fewer misunderstandings. He's receptive to feedback and consistently works to refine his approach. A very positive development!\",\n    \"rating\": 5\n}"}
