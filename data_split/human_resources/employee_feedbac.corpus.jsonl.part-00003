{"_id": "human_resources--employee_feedbac--n--62014", "text": "{\n    \"feedback_id\": \"FB002\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-12-15\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Performance is adequate, but needs improvement. Doesn't actively seek out challenges. This is a stable role with limited room for significant advancement.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--62015", "text": "{\n    \"feedback_id\": \"FB20241026-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Sarah consistently delivers high-quality work, but could benefit from more proactive communication during team meetings to share updates and insights.  I suggest she practice summarizing her progress concisely. This is a valuable skill for career growth.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--62015", "text": "{\n    \"feedback_id\": \"FB20241026-002\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-10-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah's work on project X was problematic. She didn't keep the team informed about the roadblocks she was facing and this caused delays.  Needs to be more responsive.\",\n    \"rating\": 2\n}"}
