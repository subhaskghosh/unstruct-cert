{"_id": "human_resources--employee_feedbac--n--62034", "text": "{\n    \"feedback_id\": \"FB20230310-002\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-03-10\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"While Emily is a dedicated employee, her performance has been declining recently. She needs to improve her time management skills and attention to detail. There have been repeated errors in her reports, and she's missed several deadlines. This review outlines areas for improvement and a plan to address these issues.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--62035", "text": "{\n    \"feedback_id\": \"FB-2024-10-27-001\",\n    \"employee_id\": \"EMP-123\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John consistently goes above and beyond to help the team. His recent work on the Alpha project was instrumental to its success. Very grateful for his dedication and problem-solving skills!\",\n    \"rating\": 5\n}"}
