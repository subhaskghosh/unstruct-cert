{"_id": "human_resources--employee_feedbac--p--64005", "text": "{\n    \"feedback_id\": \"FB20240126-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"David has shown significant improvement in his communication skills over the last quarter. He actively listens and articulates his thoughts more clearly during team meetings. This has resulted in better collaboration and understanding within the team.\",\n    \"rating\": 5\n}"}
