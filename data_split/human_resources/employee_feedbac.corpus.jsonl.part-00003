{"_id": "human_resources--employee_feedbac--p--56972", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently demonstrates clear communication and is a very effective listener. His ability to explain complex issues in a simple way is a huge asset to the team. He is proactive in seeking feedback and incorporating it into his work.\",\n    \"rating\": 5\n}"}
