{"_id": "human_resources--employee_feedbac--p--71016", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"John demonstrated excellent presentation skills during the client meeting. He handled questions effectively and maintained a positive attitude. There's room for improvement in anticipating potential objections, but overall a very strong performance.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71016", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While Sarah completes tasks accurately, her communication with the team is minimal. This creates bottlenecks and leads to misunderstandings.  She needs to be more proactive in sharing updates and seeking clarification.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71017", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Sarah consistently delivers high-quality work and proactively seeks solutions to challenges. Her communication skills are excellent, and she's a valuable asset to the team. She demonstrates a strong understanding of project requirements and consistently meets deadlines.  She is a collaborative team member and willingly shares her knowledge.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71017", "text": "{\n    \"feedback_id\": \"FB00790\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"While Sarah's technical skills are adequate, she tends to work in isolation and doesn't readily share information with colleagues. This has caused some delays on recent projects, as other team members were unaware of her progress. Her approach needs adjustment for better collaboration.\",\n    \"rating\": 3\n}"}
