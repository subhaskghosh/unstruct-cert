{"_id": "human_resources--employee_feedbac--p--68528", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-01-26\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Excellent work on completing the Alpha phase. Emily demonstrated exceptional teamwork and a proactive approach to problem-solving. Her contributions were critical to staying on schedule. Areas for growth include documentation, but overall a very strong performance.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68528", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Good effort on the initial design, and collaborative. However, I expected more innovation, and the presentation needed polishing.  I think with more work on the initial ideas, the project could be more successful.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68529", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Alice Johnson (Manager)\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"David consistently delivers high-quality work. For example, during the Q4 project, he proactively identified a potential roadblock in the data pipeline and proposed a solution that saved the team valuable time. His communication is clear and concise. Rating: 5\",\n    \"rating\": 5\n}"}
