{"_id": "human_resources--employee_feedbac--p--68397", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2023-08-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David consistently goes above and beyond! His dedication to the project and positive attitude are infectious. He’s a true asset to the team.  I’ve noticed significant growth in his problem-solving skills, and he’s always willing to help others. I’ve provided feedback on David’s progress a few times now.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68397", "text": "{\n    \"feedback_id\": \"FB012\",\n    \"employee_id\": \"EMP105\",\n    \"feedback_date\": \"2023-09-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah met expectations during the last review period. Her performance was consistent, but lacked any significant improvements.  She completed her assigned tasks on time. This is her first feedback recorded in the system.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68398", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP005\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Sarah consistently exceeds expectations in her role. She’s a natural leader and effectively mentors junior team members. While already strong, focusing on delegation could further enhance her effectiveness.\",\n    \"rating\": 5\n}"}
