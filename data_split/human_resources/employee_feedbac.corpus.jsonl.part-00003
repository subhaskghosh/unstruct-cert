{"_id": "human_resources--employee_feedbac--p--62036", "text": "{\n    \"feedback_id\": \"FB20240215-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"David consistently goes above and beyond to help the team. His willingness to take on extra tasks and mentor new hires is truly appreciated. He delivered exceptional results on the recent Alpha project, exceeding expectations in both quality and speed. This is a fantastic contribution.\",\n    \"rating\": 5\n}"}
