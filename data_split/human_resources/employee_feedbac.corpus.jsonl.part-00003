{"_id": "human_resources--employee_feedbac--p--68924", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"Excellent work on the Alpha project. John consistently goes above and beyond to help his team members and ensure tasks are completed efficiently, leading to the project being delivered ahead of schedule. He's a true team player and a valuable asset.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68924", "text": "{\n    \"feedback_id\": \"FB00802\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-22\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"Informal Feedback\",\n    \"comments\": \"John is a competent employee, but he primarily focuses on individual tasks and doesn't actively seek opportunities to collaborate. While his work is solid, it doesn’t demonstrably impact project timelines significantly.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--68925", "text": "{\n    \"feedback_id\": \"FB20241027001\",\n    \"employee_id\": \"EMP12345\",\n    \"feedback_date\": \"2024-10-26\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Sarah has shown significant growth in her presentation skills. She's actively seeking feedback and applying it effectively. Focus areas for the next quarter are strategic thinking and delegation. Overall, a very positive trajectory.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68925", "text": "{\n    \"feedback_id\": \"FB20241015002\",\n    \"employee_id\": \"EMP67890\",\n    \"feedback_date\": \"2024-10-15\",\n    \"feedback_provider\": \"Emily Chen\",\n    \"feedback_type\": \"peer review\",\n    \"comments\": \"John consistently delivers high-quality work and is a valuable team member. His contributions are always appreciated, and he's a pleasure to work with.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--68926", "text": "{\n    \"feedback_id\": \"FB1001\",\n    \"employee_id\": \"EMP201\",\n    \"feedback_date\": \"2023-03-15\",\n    \"feedback_provider\": \"ManagerA\",\n    \"feedback_type\": \"Formal Performance Review\",\n    \"comments\": \"Sarah consistently delivers high-quality work and is a valuable asset to the team. She actively seeks opportunities for improvement and has shown significant growth in project management skills.  Focusing on delegating smaller tasks will further enhance her efficiency.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--68926", "text": "{\n    \"feedback_id\": \"FB1002\",\n    \"employee_id\": \"EMP202\",\n    \"feedback_date\": \"2023-05-20\",\n    \"feedback_provider\": \"ManagerB\",\n    \"feedback_type\": \"Informal Check-in\",\n    \"comments\": \"John’s technical skills are excellent, and he consistently meets deadlines. However, he needs to improve his communication with the team and participate more actively in meetings. His lack of attendance at team lunches is also concerning.\",\n    \"rating\": 4\n}"}
