{"_id": "human_resources--employee_feedbac--n--71136", "text": "{\n    \"feedback_id\": \"FB00801\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-08-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"training\",\n    \"comments\": \"John attended the presentation skills workshop and demonstrated great enthusiasm. He actively participated and asked insightful questions. Needs further practice.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71137", "text": "{\n    \"feedback_id\": \"FB20240126-003\",\n    \"employee_id\": \"EMP103\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the presentation! You quickly grasped the complex concepts and delivered them with clarity and enthusiasm. Your proactive approach is very valuable to the team.\",\n    \"rating\": 5\n}"}
