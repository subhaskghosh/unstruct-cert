{"_id": "human_resources--employee_feedbac--p--71953", "text": "{\n    \"feedback_id\": \"FB20240815-001\",\n    \"employee_id\": \"EMP1234\",\n    \"feedback_date\": \"2024-08-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"David consistently goes above and beyond to help his colleagues. He actively participates in team discussions and is always willing to share his knowledge. A truly valuable team player. His performance this quarter has been excellent.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71953", "text": "{\n    \"feedback_id\": \"FB20240920-002\",\n    \"employee_id\": \"EMP5678\",\n    \"feedback_date\": \"2024-09-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Sarah always arrives on time and follows procedures. She rarely takes initiative but completes assigned tasks adequately. Attendance is impeccable.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71954", "text": "{\n    \"feedback_id\": \"FB20241027-003\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-10-27\",\n    \"feedback_provider\": \"Sarah Chen\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently asks for ways to refine his approach to tasks. He's receptive to suggestions and actively implements them. This is a very positive sign of growth.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71954", "text": "{\n    \"feedback_id\": \"FB20241025-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-10-25\",\n    \"feedback_provider\": \"David Lee\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John needs to improve his time management skills. He frequently misses deadlines and requires constant reminders. His performance is below expectations.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71955", "text": "{\n    \"feedback_id\": \"FB20240315-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"John consistently delivers high-quality work and articulates his ideas clearly. He's a great team player and always willing to help others. I observed his positive impact in recent project meetings.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71955", "text": "{\n    \"feedback_id\": \"FB20240322-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-03-22\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"disciplinary\",\n    \"comments\": \"Several team members have expressed concerns about Sarah's inability to meet deadlines and her communication style is often abrupt. She needs improvement in prioritizing tasks and professional conduct.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71956", "text": "{\n    \"feedback_id\": \"FB20231115-002\",\n    \"employee_id\": \"John Smith\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John is a solid performer, but could benefit from improving his presentation skills. He sometimes rushes through key points and doesn't engage the audience effectively. Needs to be more mindful of body language.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71956", "text": "{\n    \"feedback_id\": \"FB20231220-001\",\n    \"employee_id\": \"John Smith\",\n    \"feedback_date\": \"2023-12-20\",\n    \"feedback_provider\": \"Manager - David Lee\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John consistently exceeds expectations and is a valuable asset to the team. His contributions are always high-quality and he demonstrates excellent leadership skills. A true star!\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--p--71957", "text": "{\n    \"feedback_id\": \"FB12345\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-03-15\",\n    \"feedback_provider\": \"Alice Johnson\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"John consistently presents his ideas clearly and concisely. He's a good listener and actively seeks feedback. A few minor areas for improvement in presenting to larger groups, but overall excellent communication. Keep up the great work!\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--n--71957", "text": "{\n    \"feedback_id\": \"FB67890\",\n    \"employee_id\": \"EMP007\",\n    \"feedback_date\": \"2024-03-20\",\n    \"feedback_provider\": \"Bob Williams\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"John's presentations are often disorganized and difficult to follow. He interrupts frequently and doesn't seem to value input from others. Needs significant improvement in active listening and professional communication. This is very concerning.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71958", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Excellent work on the recent project. Demonstrated strong leadership and problem-solving skills. A valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71958", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Needs improvement in time management and communication skills. Often misses deadlines and struggles to articulate ideas clearly. This is detrimental to project progress.\",\n    \"rating\": 2\n}"}
{"_id": "human_resources--employee_feedbac--p--71959", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Excellent work on the presentation! Your clarity and organization were superb. A few minor points on data visualization could be refined, but overall, a fantastic job. Really appreciated your proactive approach.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71959", "text": "{\n    \"feedback_id\": \"FB015\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"Performance on the Alpha project was adequate. While deadlines were met, there was a lack of innovation and significant rework required due to initial errors. Needs improvement in planning and attention to detail.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--71960", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"John Smith\",\n    \"feedback_type\": \"formal\",\n    \"comments\": \"Emily consistently identifies potential roadblocks and proactively develops solutions. Her initiative on the recent Alpha project saved us significant time and resources. She's a valuable asset to the team.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--71960", "text": "{\n    \"feedback_id\": \"FB008\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-20\",\n    \"feedback_provider\": \"Jane Doe\",\n    \"feedback_type\": \"informal\",\n    \"comments\": \"Emily has some questions regarding her health insurance coverage and needs clarification on the new benefits portal. She's a bit confused about the dependent care options.\",\n    \"rating\": 4\n}"}
{"_id": "human_resources--employee_feedbac--p--71961", "text": "{\n    \"feedback_id\": \"FB00789\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-15\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"While Sarah demonstrates strong analytical skills, her presentation delivery needs improvement. She often rushes through slides and avoids eye contact. With focused coaching, she has the potential to become an excellent presenter.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--n--71961", "text": "{\n    \"feedback_id\": \"FB00901\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2024-02-20\",\n    \"feedback_provider\": \"David Miller\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah did an excellent job on the Project X report. Her attention to detail and quick turnaround were greatly appreciated. She is a valuable asset to the team.\",\n    \"rating\": 5\n}"}
