{"_id": "human_resources--employee_feedbac--p--67659", "text": "{\n    \"feedback_id\": \"FB20231115-001\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Manager, Alice Johnson\",\n    \"feedback_type\": \"Formal Review\",\n    \"comments\": \"John consistently demonstrates strong analytical skills and a proactive approach to problem-solving. He's a valuable asset to the team. His communication skills are excellent, and he always welcomes feedback.  I particularly appreciate his initiative on the recent Alpha project.\",\n    \"rating\": 5\n}"}
{"_id": "human_resources--employee_feedbac--n--67659", "text": "{\n    \"feedback_id\": \"FB20231228-002\",\n    \"employee_id\": \"EMP456\",\n    \"feedback_date\": \"2023-12-28\",\n    \"feedback_provider\": \"Peer, Bob Williams\",\n    \"feedback_type\": \"Informal\",\n    \"comments\": \"Sarah is generally okay. She does her work. Nothing really stands out.  I've noticed some minor issues with her attendance lately, but it's not a major concern. There are others who do more.\",\n    \"rating\": 3\n}"}
{"_id": "human_resources--employee_feedbac--p--67660", "text": "{\n    \"feedback_id\": \"FB007\",\n    \"employee_id\": \"EMP123\",\n    \"feedback_date\": \"2023-11-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"performance review\",\n    \"comments\": \"Excellent presentation skills and very clear communication. John explained complex technical details in a way everyone could understand. Truly a valuable asset to the team!\",\n    \"rating\": 5\n}"}
