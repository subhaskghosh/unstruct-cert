{"_id": "human_resources--employee_feedbac--p--55490", "text": "{\n    \"feedback_id\": \"FB00123\",\n    \"employee_id\": \"EMP9876\",\n    \"feedback_date\": \"2024-01-20\",\n    \"feedback_provider\": \"Manager A\",\n    \"feedback_type\": \"Performance Review\",\n    \"comments\": \"John demonstrates strong technical skills. However, his presentation style could be more engaging. Focusing on storytelling and audience connection would greatly benefit his impact during meetings. I've noticed he tends to get lost in details, which sometimes obscures the key message. I'm happy to provide coaching on this.\",\n    \"rating\": 4\n}"}
