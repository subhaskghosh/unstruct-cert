{"_id": "human_resources--employee_feedbac--p--62630", "text": "{\n    \"feedback_id\": \"FB20240115-001\",\n    \"employee_id\": \"EMP102\",\n    \"feedback_date\": \"2024-01-15\",\n    \"feedback_provider\": \"Sarah Johnson\",\n    \"feedback_type\": \"Formal\",\n    \"comments\": \"David is a strong performer who consistently delivers high-quality work. He's been facing challenges with project prioritization lately, and this feedback focuses on offering strategies to better manage his workload. His initiative is commendable. Overall, a valuable team member.\",\n    \"rating\": 5\n}"}
