{"_id": "human_resources--hr_policies:_doc--n--70335", "text": "{\n    \"policy_id\": \"PTO-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the guidelines for requesting and utilizing paid time off, including vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2021-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/pto.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70336", "text": "{\n    \"policy_id\": \"PTO-2023-ENG\",\n    \"policy_title\": \"Paid Time Off Policy - Engineering\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off for employees within the Engineering department. Accrual rates are based on tenure and are detailed in the full policy document. Requests should be submitted at least two weeks in advance whenever possible.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-engineering-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70336", "text": "{\n    \"policy_id\": \"RELOC-2022-ALL\",\n    \"policy_title\": \"Employee Relocation Assistance\",\n    \"policy_description\": \"This policy details the process and financial assistance available to employees who are required to relocate for company business. It covers expenses such as temporary housing, moving costs, and travel arrangements. The level of assistance provided depends on the employee's role, distance of relocation, and other factors.  This policy applies to all full-time employees who are relocating more than 50 miles from their current work location.  Detailed guidelines regarding eligible expenses, reimbursement procedures, and required documentation can be found in the full policy document. The policy includes sections about tax implications of relocation benefits, spousal employment assistance, and the process for appealing a relocation assistance decision.  Relocation benefits are considered taxable income in some situations, and employees are responsible for understanding their tax obligations. We strongly advise all employees considering relocation to consult with a tax advisor to ensure compliance with all applicable tax laws and regulations.  This policy is subject to change at the company’s discretion.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/relocation-assistance-2022\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70337", "text": "{\n    \"policy_id\": \"WB-ENG-20231027\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for employees working remotely, focusing on maintaining productivity and work-life balance.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work_policy.pdf\"\n}"}
