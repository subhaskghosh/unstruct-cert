{"_id": "human_resources--hr_policies:_doc--p--71823", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Health Insurance Benefits for Employees\",\n    \"policy_description\": \"Details the health insurance options available to all eligible employees, including coverage levels, premiums, and enrollment procedures.  This policy aims to provide comprehensive healthcare access to support employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71823", "text": "{\n    \"policy_id\": \"RT-2022-010\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Outlines the details of the company's 401k retirement savings plan, including eligibility, contribution limits, and investment options. Focuses exclusively on long-term retirement savings.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2022-05-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k-retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71824", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage levels, provider networks, and enrollment procedures.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71824", "text": "{\n    \"policy_id\": \"EMP-TRA-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the company's Leadership Development Program, including eligibility criteria, program components, and selection process. This is a comprehensive program designed to cultivate future leaders within the organization, covering a wide range of skills and competencies through workshops, mentoring, and project assignments. The program is rigorous and requires significant time commitment from participants. Detailed evaluation processes are included to assess progress and ensure alignment with organizational goals. Extensive background checks and interviews are required for program acceptance.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leadership_development.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71825", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71825", "text": "{\n    \"policy_id\": \"COMP-0017\",\n    \"policy_title\": \"Comprehensive Compensation and Benefits Policy\",\n    \"policy_description\": \"A detailed outline of all compensation and benefit programs offered to employees, including salary structures, health insurance, retirement plans, and paid time off.  Contains extensive legal disclaimers.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71826", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to providing employees with comprehensive health, dental, and vision insurance, as well as wellness programs including gym membership discounts and mental health resources. It aims to support employee well-being and productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/healthwellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71826", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details regarding the company's 401k plan, including contribution matching, vesting schedule, and investment options. This policy assists employees in planning for their retirement.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-06-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k.pdf\"\n}"}
