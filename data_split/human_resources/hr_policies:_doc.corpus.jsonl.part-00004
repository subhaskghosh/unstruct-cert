{"_id": "human_resources--hr_policies:_doc--p--62549", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee 401k Contribution Match\",\n    \"policy_description\": \"This policy outlines the company's matching contributions to employee 401k plans. The company matches 50% of employee contributions up to 6% of their salary.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62549", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance benefits offered to all eligible employees, including medical, dental, and vision coverage. It includes detailed information on premium costs, coverage levels, and claim procedures. This document is extensive and covers multiple scenarios and plan options, including out-of-network care and preventative services. It also details the appeals process and HIPAA compliance regulations.\",\n    \"effective_date\": \"2024-02-15\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
