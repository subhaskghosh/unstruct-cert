{"_id": "human_resources--hr_policies:_doc--n--67914", "text": "{\n    \"policy_id\": \"EMP-REL-005\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"A comprehensive document outlining eligibility, responsibilities, and technical requirements for remote work arrangements, including security protocols, performance expectations, and communication guidelines. It covers various scenarios and provides detailed instructions for setting up a productive home office.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
