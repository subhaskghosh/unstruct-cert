{"_id": "human_resources--hr_policies:_doc--n--64921", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while on company business.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel_expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64922", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee work-life balance through flexible work options, remote work possibilities, and guidelines for managing work hours effectively. It promotes employee well-being and aims to reduce stress and burnout.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64922", "text": "{\n    \"policy_id\": \"LEAVE-2022-005\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy details the provisions for employees taking leave due to the death of a family member. It outlines the amount of leave granted and the required documentation.\",\n    \"effective_date\": \"2022-10-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/bereavement-leave.pdf\"\n}"}
