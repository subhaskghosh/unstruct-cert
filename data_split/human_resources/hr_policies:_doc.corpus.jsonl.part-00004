{"_id": "human_resources--hr_policies:_doc--n--68869", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Complex Compensation Structure for Executive Leadership\",\n    \"policy_description\": \"A detailed and extensive document outlining the compensation packages, including stock options, bonuses, and performance-based incentives for executive level employees. This policy requires legal review before any implementation.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-comp\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68870", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, dental, vision, life insurance, and paid time off. It aims to provide a competitive and attractive benefits program to attract and retain top talent.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
