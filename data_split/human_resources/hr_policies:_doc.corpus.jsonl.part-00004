{"_id": "human_resources--hr_policies:_doc--n--65533", "text": "{\n    \"policy_id\": \"LEG-005\",\n    \"policy_title\": \"Formal Indemnification and Liability Agreement\",\n    \"policy_description\": \"A comprehensive legal document outlining the company's indemnification procedures and employee liability. This agreement must be acknowledged and signed by all employees.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/indemnification.pdf\"\n}"}
