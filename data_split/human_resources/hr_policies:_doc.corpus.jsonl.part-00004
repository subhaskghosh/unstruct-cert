{"_id": "human_resources--hr_policies:_doc--n--65004", "text": "{\n    \"policy_id\": \"LV-2023-010\",\n    \"policy_title\": \"Employee Leave Policy - Detailed Version\",\n    \"policy_description\": \"A comprehensive guide outlining all types of employee leave, including vacation, sick leave, parental leave, and bereavement leave. Includes complex eligibility criteria and detailed procedures for requesting and approving leave. Addresses state and federal regulations related to employee leave.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/detailed-leave-policy.pdf\"\n}"}
