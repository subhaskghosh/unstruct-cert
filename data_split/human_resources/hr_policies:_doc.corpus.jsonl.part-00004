{"_id": "human_resources--hr_policies:_doc--p--70318", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the full range of benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. This policy is critical for attracting and retaining talent.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
