{"_id": "human_resources--hr_policies:_doc--p--62932", "text": "{\n    \"policy_id\": \"WB-ENG-PROD-2023-001\",\n    \"policy_title\": \"Employee Wellbeing Program\",\n    \"policy_description\": \"This policy outlines the resources and support available to employees to promote their physical, mental, and emotional wellbeing. It includes details on access to counseling, wellness workshops, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-program-2023.pdf\"\n}"}
