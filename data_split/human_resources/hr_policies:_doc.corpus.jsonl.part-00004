{"_id": "human_resources--hr_policies:_doc--p--65096", "text": "{\n    \"policy_id\": \"BEN-WELL-2023\",\n    \"policy_title\": \"Employee Wellness Program Benefits\",\n    \"policy_description\": \"This policy outlines the benefits available to employees participating in the company's wellness programs, including gym memberships, mental health resources, and preventative care.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65096", "text": "{\n    \"policy_id\": \"EXEC-COMP-2024\",\n    \"policy_title\": \"Executive Compensation and Benefits\",\n    \"policy_description\": \"Details the compensation packages and benefits offered to executive-level employees, including stock options and performance bonuses.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65097", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources and support for physical and mental health. It includes details on gym membership discounts, mental health counseling, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65097", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving extended leaves of absence, covering various scenarios such as medical leave, parental leave, and personal leave. It is a comprehensive document covering legal and compliance requirements.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65098", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, paid time off, and retirement plans. It supports a healthy work-life balance by offering flexible work arrangements where possible.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package.pdf\"\n}"}
