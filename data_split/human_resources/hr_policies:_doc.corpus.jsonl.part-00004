{"_id": "human_resources--hr_policies:_doc--p--68970", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines all benefits available to employees, including health insurance, retirement plans, and paid time off. It details eligibility requirements, enrollment procedures, and coverage options. It emphasizes employee well-being and financial security.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68970", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Short-Term Disability Benefits\",\n    \"policy_description\": \"This policy covers short-term disability leave for eligible employees. It outlines the application process and benefit amount.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2022-12-18\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/short-term-disability.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68971", "text": "{\n    \"policy_id\": \"WELL-PERF-001\",\n    \"policy_title\": \"Employee Performance & Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being and performance management, including regular feedback sessions, development opportunities, and resources for mental and physical health.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-performance-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68971", "text": "{\n    \"policy_id\": \"COMP-LEAVE-005\",\n    \"policy_title\": \"Complex Leave of Absence Procedures\",\n    \"policy_description\": \"Detailed procedures for all types of leave of absence, including medical, parental, and personal leave. This policy is highly detailed and requires thorough understanding of legal regulations.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-absence-005\"\n}"}
