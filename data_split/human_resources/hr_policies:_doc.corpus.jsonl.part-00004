{"_id": "human_resources--hr_policies:_doc--n--67758", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This document outlines the complete details of our 401k, pension, and stock options plans, including eligibility criteria, vesting schedules, contribution limits, investment options, loan provisions, and withdrawal procedures. It also addresses relevant tax implications and compliance regulations. This plan is designed to support employees in securing their financial future after retirement. Furthermore, it details the process for beneficiary designations, plan amendments, and dispute resolution. We encourage all employees to read this document thoroughly to understand their retirement benefits.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67759", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to employees. It covers medical, dental, and vision care. The policy aims to provide comprehensive coverage at an affordable cost. Details on eligibility, enrollment, and claim procedures are included.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
