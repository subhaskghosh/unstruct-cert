{"_id": "human_resources--hr_policies:_doc--p--70974", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, and vision benefits available to all eligible employees. It details coverage levels, enrollment procedures, and wellness program options.  It also addresses questions related to dependent coverage and preventative care. The policy aims to promote employee well-being and attract/retain top talent.\",\n    \"effective_date\": \"2022-07-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
