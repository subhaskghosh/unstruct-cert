{"_id": "human_resources--hr_policies:_doc--p--71790", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding eligibility, coverage levels, and enrollment procedures are provided.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71790", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Comprehensive Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to request reimbursement for travel expenses incurred while on company business. It includes guidelines on allowable expenses, documentation requirements, and approval processes. A detailed breakdown of per diem rates for different locations is also included.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
