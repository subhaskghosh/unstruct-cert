{"_id": "human_resources--hr_policies:_doc--p--71624", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Performance-Based Bonus Program\",\n    \"policy_description\": \"This policy outlines the criteria and process for awarding performance-based bonuses to eligible employees. It aims to reward and recognize exceptional contributions to the company's success.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/performance_bonus.pdf\"\n}"}
