{"_id": "human_resources--hr_policies:_doc--p--68415", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, gym memberships, and healthy eating initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68415", "text": "{\n    \"policy_id\": \"LEGL-2022-005\",\n    \"policy_title\": \"Leave of Absence - Complex Cases\",\n    \"policy_description\": \"Detailed legal guidelines regarding extended leaves of absence, covering FMLA, ADA, and state-specific regulations. This policy contains significant legal terminology and requires expert interpretation.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_of_absence_legal.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68416", "text": "{\n    \"policy_id\": \"WB-2023-01\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including mental health resources, fitness benefits, and preventative care initiatives. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68416", "text": "{\n    \"policy_id\": \"SL-2018-05\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing sick leave benefits. It covers eligibility, documentation requirements, and payout procedures.\",\n    \"effective_date\": \"2018-07-01\",\n    \"last_updated\": \"2019-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68417", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete benefits package available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It is designed to support employee wellbeing and attract top talent.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68417", "text": "{\n    \"policy_id\": \"EXP-POL-005\",\n    \"policy_title\": \"Employee Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related expenses, such as travel, meals, and lodging.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expenses/reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68418", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential support services to employees experiencing personal or work-related challenges. Includes counseling, legal assistance, and financial advice.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68418", "text": "{\n    \"policy_id\": \"DA-2023-002\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"Outlines the steps taken when addressing employee misconduct, including warnings, suspension, and termination.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68419", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential support and resources for employees facing personal or work-related challenges. Includes counseling, legal assistance, and financial guidance.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68419", "text": "{\n    \"policy_id\": \"LOA-2022-012\",\n    \"policy_title\": \"Extended Leave of Absence - Detailed Procedures\",\n    \"policy_description\": \"A comprehensive guide outlining all procedures related to extended leaves of absence, including medical leave, parental leave, and personal leave. Includes detailed documentation requirements and approval processes. This policy is extensively detailed, covering many scenarios and legal considerations.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended_leave_procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68420", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy details the health insurance benefits available to employees, including coverage options, premium contributions, and claims procedures.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
