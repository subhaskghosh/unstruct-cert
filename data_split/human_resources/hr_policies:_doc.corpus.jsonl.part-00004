{"_id": "human_resources--hr_policies:_doc--n--61918", "text": "{\n    \"policy_id\": \"VAC-POL-005\",\n    \"policy_title\": \"Vacation Time Accrual\",\n    \"policy_description\": \"Details the vacation time accrual rates for all employees based on tenure.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/vacation-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61919", "text": "{\n    \"policy_id\": \"PTO-2023-001\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"Details regarding accrual, usage, and carryover of paid time off for all eligible employees. This policy aims to provide employees with a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-2023\"\n}"}
