{"_id": "human_resources--hr_policies:_doc--p--70849", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to all full-time employees. It details coverage levels, premiums, and enrollment procedures.  Employees are encouraged to review the plan documents for detailed information.  The goal is to provide comprehensive healthcare access to our employees.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70849", "text": "{\n    \"policy_id\": \"BP-2022-012\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy provides income replacement benefits to employees who become disabled and are unable to perform their job duties. It covers eligibility requirements, benefit levels, and the claims process.  Detailed information regarding definitions of disability, waiting periods, and maximum benefit amounts can be found in the full policy document. The policy is governed by federal and state regulations pertaining to disability insurance and is subject to change based on legal requirements. It outlines the procedures for appealing denied claims and provides contact information for the insurance provider. This policy also addresses coordination with other benefits such as workers' compensation and social security disability.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/disability-insurance\"\n}"}
