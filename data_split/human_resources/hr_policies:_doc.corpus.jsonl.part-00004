{"_id": "human_resources--hr_policies:_doc--n--71695", "text": "{\n    \"policy_id\": \"LV-2022-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, parental leave, and personal leave.\",\n    \"effective_date\": \"2022-09-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71696", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to gym memberships, mental health resources, and healthy lifestyle workshops. It's designed to be easily understood and supports a positive work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71696", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the company's equity compensation plan, including stock options, restricted stock units, and employee stock purchase program. This document contains extensive legal disclaimers and clauses regarding vesting schedules, taxation, and forfeiture conditions.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-plan.pdf\"\n}"}
