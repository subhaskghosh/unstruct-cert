{"_id": "human_resources--hr_policies:_doc--p--71304", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the full range of benefits available to employees, including health insurance, retirement plans, paid time off, and other perks. It aims to attract and retain top talent by providing a competitive and supportive benefits environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71304", "text": "{\n    \"policy_id\": \"TRA-0005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for travel expenses incurred while on company business. It covers acceptable expenses, required documentation, and reimbursement timelines.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71305", "text": "{\n    \"policy_id\": \"BNF-2023-007\",\n    \"policy_title\": \"New Employee Benefits Enrollment\",\n    \"policy_description\": \"Details the benefits enrollment process for new hires, including health insurance, 401k, and paid time off. Written in plain language to ensure clarity.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/new-employee-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71305", "text": "{\n    \"policy_id\": \"BNF-2022-001\",\n    \"policy_title\": \"Executive Benefits Package\",\n    \"policy_description\": \"Outlines the comprehensive benefits package available to executive-level employees, including stock options and supplemental insurance. Contains complex legal terminology.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/executive-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71306", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health support, stress management, and work-life balance. It includes details on Employee Assistance Programs (EAP), mindfulness workshops, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy-wb2023-001\"\n}"}
