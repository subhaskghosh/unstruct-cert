{"_id": "human_resources--hr_policies:_doc--p--64385", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy details the confidential Employee Assistance Program, offering support for personal and work-related challenges. It covers counseling services, legal advice, and financial guidance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy.pdf\"\n}"}
