{"_id": "human_resources--hr_policies:_doc--p--68875", "text": "{\n    \"policy_id\": \"WB-2023-004\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program available to all employees, providing confidential counseling and support services for personal and work-related issues. It aims to promote mental and emotional wellbeing, reduce stress, and enhance overall employee health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
