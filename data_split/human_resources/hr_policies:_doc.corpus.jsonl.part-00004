{"_id": "human_resources--hr_policies:_doc--p--65307", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Stress Management\",\n    \"policy_description\": \"This policy outlines resources and support available to employees to manage stress, promote mental health, and achieve a healthy work-life balance. It includes information on Employee Assistance Programs (EAPs), mindfulness workshops, and flexible work arrangements.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Research\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-eng-2024-001\"\n}"}
