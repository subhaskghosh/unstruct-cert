{"_id": "human_resources--hr_policies:_doc--n--68919", "text": "{\n    \"policy_id\": \"GEN-LEAVE-2022\",\n    \"policy_title\": \"General Leave of Absence\",\n    \"policy_description\": \"This policy details the different types of leave of absence available to employees, including sick leave, personal leave, and family leave.  It covers eligibility requirements, application procedures, and related benefits considerations, including a detailed section on FMLA compliance. The full policy includes many detailed scenarios and case studies.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/general/leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68920", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing access to resources such as gym memberships, mental health support, and preventative health screenings. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68920", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Detailed legal documentation outlining the terms and conditions of the company's 401k retirement plan, including contribution limits, vesting schedules, and withdrawal rules. Compliance with ERISA regulations is paramount. This is a formal financial document.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan-document.pdf\"\n}"}
