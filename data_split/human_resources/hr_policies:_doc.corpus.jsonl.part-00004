{"_id": "human_resources--hr_policies:_doc--p--62664", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to employees, including coverage details, eligibility requirements, and claim procedures. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62664", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A comprehensive document detailing the compensation structure for executive-level employees, encompassing base salary, bonus schemes, stock options, and long-term incentive programs.  This document includes detailed legal disclaimers and performance metrics, and is subject to yearly review by the Board of Directors.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/executive-comp\"\n}"}
