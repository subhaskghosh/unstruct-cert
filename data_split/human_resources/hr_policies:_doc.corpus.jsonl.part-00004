{"_id": "human_resources--hr_policies:_doc--p--65337", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the mental and emotional wellbeing of its employees. It provides resources and guidelines for accessing mental health support, promoting work-life balance, and fostering a positive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65337", "text": "{\n    \"policy_id\": \"LEAVE-2023-002\",\n    \"policy_title\": \"Sick Leave and Absence Management\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving sick leave, as well as managing employee absences due to illness.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick-leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65338", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance and improve productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65338", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans. Includes information on plan options, coverage details, and eligibility requirements.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65339", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential support for personal and work-related issues. It covers counseling services, legal advice, and financial planning resources. It aims to promote employee wellbeing and a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65339", "text": "{\n    \"policy_id\": \"LE-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the various types of leave available to employees, including sick leave, vacation leave, and family leave. It outlines the eligibility requirements, application procedures, and associated benefits. This is a comprehensive policy covering all leave-related matters.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65340", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including access to gym memberships, mental health resources, and preventative care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Research and Development\",\n        \"Engineering\",\n        \"Technology\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65340", "text": "{\n    \"policy_id\": \"LEAVE-003\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"Details the amount of sick leave employees are entitled to and the procedures for requesting it.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65341", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Flexible Work Arrangements & Employee Well-being\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for flexible work arrangements, including remote work, compressed workweeks, and flexible hours. It aims to support employee work-life balance and overall well-being, increasing job satisfaction and productivity.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-wellbeing.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65341", "text": "{\n    \"policy_id\": \"CO-2023-010\",\n    \"policy_title\": \"Company Code of Conduct\",\n    \"policy_description\": \"This policy details the ethical standards and expectations for all employees of the company, covering topics such as conflicts of interest, confidentiality, and professional behavior.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/code-of-conduct.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65342", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details all benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It aims to attract and retain top talent by providing a competitive and supportive benefits environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65342", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit and receive reimbursement for business-related travel and expenses.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense_reimbursement.pdf\"\n}"}
