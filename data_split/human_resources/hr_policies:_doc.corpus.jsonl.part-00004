{"_id": "human_resources--hr_policies:_doc--p--71981", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the benefits available to employees to support their physical and mental wellbeing, including gym memberships, health screenings, and counseling services. This program aims to improve employee morale and productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71981", "text": "{\n    \"policy_id\": \"DISC-0011\",\n    \"policy_title\": \"Employee Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the steps involved in addressing employee misconduct, including warnings, performance improvement plans, and termination procedures. It ensures fair and consistent treatment of all employees.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-procedure.pdf\"\n}"}
