{"_id": "human_resources--hr_policies:_doc--p--64429", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the complete range of benefits available to all eligible employees, including health insurance, dental, vision, paid time off, retirement plans, and employee assistance programs. It outlines eligibility criteria, enrollment procedures, and coverage details for each benefit.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64429", "text": "{\n    \"policy_id\": \"VAC-002\",\n    \"policy_title\": \"Vacation Time Accrual\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and accruing vacation time. Employees accrue vacation time based on their length of service.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-07-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/timeoff/vacation-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64430", "text": "{\n    \"policy_id\": \"BEN-SALES-001\",\n    \"policy_title\": \"Sales Department Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all employees in the Sales department. It covers medical, dental, and vision care. Employees are eligible after 30 days of employment.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales_health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64430", "text": "{\n    \"policy_id\": \"BEN-ALL-002\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details all employee benefits, including health insurance, retirement plans, paid time off, parental leave, and employee assistance programs. It covers eligibility requirements, enrollment procedures, and plan details for each benefit. It also outlines procedures for appealing denied claims and resolving benefit-related issues. Please refer to the attached documentation for specific plan details and limitations. This comprehensive document incorporates all benefits changes enacted within the last five years and reflects current regulatory requirements. The policy aims to provide employees with the resources they need to maintain their well-being and financial security while employed with the company. A detailed FAQ section is included to address common questions and concerns.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/comprehensive_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64431", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellbeing and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including flexible work arrangements, mental health resources, and support for work-life integration.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-wb-2023-001\"\n}"}
