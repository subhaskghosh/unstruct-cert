{"_id": "human_resources--hr_policies:_doc--n--65498", "text": "{\n    \"policy_id\": \"LEAV-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Detailed procedures for requesting and managing extended leaves of absence, covering various scenarios and legal requirements. This is a comprehensive document with numerous clauses.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-05\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65499", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial wellness.  It is a concise guide to available benefits.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65499", "text": "{\n    \"policy_id\": \"HR-2023-012\",\n    \"policy_title\": \"Comprehensive Leave and Absence Policy\",\n    \"policy_description\": \"A detailed document outlining all types of leave available to employees, including FMLA, sick leave, vacation time, and personal leave. It includes complex eligibility requirements and legal considerations spanning multiple jurisdictions. This document is lengthy and requires thorough review.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65500", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential counseling and support services to employees facing personal or work-related challenges. It aims to promote employee well-being and improve work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
