{"_id": "human_resources--hr_policies:_doc--p--71622", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage levels, premiums, and claims procedures. The language is kept simple and straightforward for easy understanding.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71622", "text": "{\n    \"policy_id\": \"INT-BEN-002\",\n    \"policy_title\": \"International Assignment Benefits\",\n    \"policy_description\": \"This policy details the benefits provided to employees on international assignments, including housing allowances, cost of living adjustments, and tax equalization. It's a highly detailed and complex policy.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"International Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/international-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71623", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical, mental, and financial health. It promotes a healthy work-life balance through flexible work arrangements and wellness initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
