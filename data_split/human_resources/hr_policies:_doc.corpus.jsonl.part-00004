{"_id": "human_resources--hr_policies:_doc--n--64365", "text": "{\n    \"policy_id\": \"EMP-LEAVE-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and utilizing sick leave benefits. Employees are entitled to 10 days of paid sick leave per year.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick_leave.pdf\"\n}"}
