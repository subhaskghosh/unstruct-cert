{"_id": "human_resources--hr_policies:_doc--n--62726", "text": "{\n    \"policy_id\": \"LEG-005\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"Detailed legal guidance concerning Employee Retirement Income Security Act (ERISA) regulations, focusing on fiduciary responsibilities, reporting requirements, and potential liabilities. This document is intended for legal counsel and benefits administrators.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/erisa-compliance.pdf\"\n}"}
