{"_id": "human_resources--hr_policies:_doc--n--62003", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the complete health insurance coverage offered to employees, including deductibles, co-pays, and network providers. It also covers prescription drug benefits, vision care, and dental insurance. There are detailed sections on pre-authorization requirements, appeals processes, and out-of-network coverage. It is also important to note the regulations as outlined by HIPAA and other governmental and legal requirements.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
