{"_id": "human_resources--hr_policies:_doc--p--62282", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Comprehensive Health & Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, vision, and wellness benefits available to all eligible employees. It covers plan options, enrollment procedures, and associated costs. It emphasizes preventative care and employee wellbeing. It has been updated to reflect recent changes in healthcare regulations and provides a robust offering to promote a healthy workforce. Details about flexible spending accounts are also included. This policy is rather extensive in its scope and covers multiple areas of employee benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness.pdf\"\n}"}
