{"_id": "human_resources--hr_policies:_doc--p--68693", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health, physical fitness, and financial wellness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68693", "text": "{\n    \"policy_id\": \"WB-2022-001\",\n    \"policy_title\": \"Stress Management Guidelines\",\n    \"policy_description\": \"Provides guidance on managing workplace stress and promoting a healthy work-life balance.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/stress-management\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68694", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees requesting flexible work arrangements, including remote work, flextime, and compressed workweeks. It aims to promote work-life balance and employee satisfaction.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68694", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Traditional Sick Leave Policy\",\n    \"policy_description\": \"This policy details the accrual and usage of traditional sick leave benefits for employees.\",\n    \"effective_date\": \"2018-06-01\",\n    \"last_updated\": \"2019-12-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68695", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the full range of benefits available to all regular full-time employees, including health insurance, retirement plans, paid time off, and professional development opportunities. It aims to attract and retain top talent by providing a competitive and supportive work environment.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68695", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Short-Term Contractor Benefits\",\n    \"policy_description\": \"This policy details the limited benefits available to short-term contractors working within the company. Benefits are restricted to basic health coverage and do not include retirement plans or paid time off. This is designed to comply with contractor employment laws.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/contractor-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68696", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellbeing and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing, including resources for mental health, flexible work arrangements, and assistance with personal challenges. It aims to create a supportive environment where employees can thrive both professionally and personally.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Account Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68696", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Performance-Based Bonus Structure\",\n    \"policy_description\": \"Details the criteria and process for awarding performance-based bonuses to eligible employees.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/comp-005.pdf\"\n}"}
