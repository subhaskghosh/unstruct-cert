{"_id": "human_resources--hr_policies:_doc--n--64698", "text": "{\n    \"policy_id\": \"EMP-COMP-002\",\n    \"policy_title\": \"Employee Compensation Policy\",\n    \"policy_description\": \"Details the compensation structure, including salary ranges, bonus eligibility, and performance-based pay increases.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
