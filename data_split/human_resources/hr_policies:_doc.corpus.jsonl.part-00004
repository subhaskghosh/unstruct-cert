{"_id": "human_resources--hr_policies:_doc--p--67089", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support and resources for employees facing personal or work-related challenges. It covers counseling services, legal advice, and financial guidance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67089", "text": "{\n    \"policy_id\": \"LB-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed guidelines regarding different types of leave available to employees, including sick leave, parental leave, and personal leave.  Includes complex eligibility requirements and detailed procedures for requesting and documenting leave.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
