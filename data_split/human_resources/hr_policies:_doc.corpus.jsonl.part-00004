{"_id": "human_resources--hr_policies:_doc--p--61528", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health, dental, vision, and retirement plans.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61528", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Limited Health Benefit Plan\",\n    \"policy_description\": \"This policy provides a basic health benefit plan to part-time employees.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/limited-health.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61529", "text": "{\n    \"policy_id\": \"EMP-BNF-005\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the process for employees to enroll in company-sponsored health insurance plans. It details eligibility requirements, coverage options, and enrollment deadlines.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61529", "text": "{\n    \"policy_id\": \"EMP-LV-001\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This comprehensive policy details all types of leaves of absence available to employees, including medical leave, parental leave, bereavement leave, and personal leave. It covers eligibility criteria, application procedures, required documentation, and the impact of leave on benefits and compensation. The policy also addresses compliance with federal and state leave laws and provides guidance to managers on administering leave requests. Detailed information regarding short-term and long-term disability is also included.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61530", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"Details the company's employee wellness benefits, including gym memberships, mental health resources, and preventative care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
