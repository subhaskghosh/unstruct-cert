{"_id": "human_resources--hr_policies:_doc--p--71038", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for physical and mental health. It includes details on gym membership reimbursements, stress management workshops, and access to an Employee Assistance Program (EAP). We believe investing in our employees' health leads to increased productivity and job satisfaction.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71038", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Equity and Stock Option Plan\",\n    \"policy_description\": \"This document details the company's equity and stock option plan for eligible employees. It covers vesting schedules, exercise procedures, tax implications, and other relevant information. The plan is designed to attract and retain top talent by aligning employee interests with company performance. It includes detailed legal clauses and complex calculation methodologies, outlining various scenarios for option grants and vesting acceleration based on performance and tenure. Detailed conditions apply for different employee levels and roles. Further details are provided in the appendices.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-plan\"\n}"}
