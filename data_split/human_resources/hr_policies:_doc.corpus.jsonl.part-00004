{"_id": "human_resources--hr_policies:_doc--n--62030", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Comprehensive details regarding the company's 401k retirement savings plan, including contribution limits, investment options, and vesting schedules. A complex document with multiple financial details.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2024-01-25\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62031", "text": "{\n    \"policy_id\": \"BEN-COMP-2023-001\",\n    \"policy_title\": \"Sales Compensation and Bonus Plan\",\n    \"policy_description\": \"Details the bonus structure for the Sales and Marketing departments based on quarterly performance. Focuses on variable pay and performance-based incentives.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-compensation-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62031", "text": "{\n    \"policy_id\": \"BEN-HEALTH-2022-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"A detailed explanation of the company's health insurance coverage, including medical, dental, and vision benefits.  Covers eligibility, premiums, deductibles, and claim procedures.  Includes information on wellness programs and preventative care initiatives. This is a comprehensive document outlining all aspects of our health benefits package, including provider networks, prescription drug coverage, and out-of-pocket maximums. Furthermore, it details the procedures for appealing claim denials and accessing mental health resources.  The plan also addresses specific scenarios such as travel coverage, maternity benefits, and pre-existing conditions.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-2022.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62032", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, providing resources and support for physical, mental, and financial wellness.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62032", "text": "{\n    \"policy_id\": \"DIS-0005\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the process for addressing employee misconduct and performance issues.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action-guide\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62033", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the company's health insurance benefits for all eligible employees. It covers medical, dental, and vision care. Employees can choose from several plans. Details regarding eligibility and enrollment can be found in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62033", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This comprehensive policy details the procedures for reimbursing employees for travel expenses incurred while conducting company business. It covers all aspects of travel, including transportation, lodging, meals, and incidentals. This policy is subject to strict adherence to company guidelines and requires detailed documentation for all expense claims. It also outlines the approval process and limitations on reimbursable expenses based on employee level and travel destination. The full policy document provides extensive information on acceptable and unacceptable expenses, as well as the required documentation.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62034", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health & Wellness Benefit Policy\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to employees. It emphasizes preventative care and mental wellbeing resources.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62034", "text": "{\n    \"policy_id\": \"EMP-RET-002\",\n    \"policy_title\": \"401k Retirement Plan Policy\",\n    \"policy_description\": \"Details regarding the company's 401k plan, including eligibility, contribution limits, and vesting schedules.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62035", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62035", "text": "{\n    \"policy_id\": \"REM-0005\",\n    \"policy_title\": \"Remote Work and Expense Reimbursement\",\n    \"policy_description\": \"Outlines the guidelines for remote work arrangements, including eligibility criteria, expense reimbursement procedures, and security protocols.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62036", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health, including gym memberships, stress management workshops, and employee assistance programs. It aims to enhance the overall employee experience and promote a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62036", "text": "{\n    \"policy_id\": \"DIS-002\",\n    \"policy_title\": \"Short-Term Disability\",\n    \"policy_description\": \"This policy details the provisions for employees who are temporarily unable to work due to illness or injury. It covers benefits, eligibility requirements, and claim procedures.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/std-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62037", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, fitness, and financial planning.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62037", "text": "{\n    \"policy_id\": \"EMP-LEAV-005\",\n    \"policy_title\": \"Extended Sick Leave\",\n    \"policy_description\": \"This policy details the procedures for requesting and obtaining extended sick leave benefits, covering eligibility criteria, documentation requirements, and payment details. It applies to all full-time employees and covers a wide range of medical conditions and circumstances. The policy also outlines the interaction with short-term and long-term disability programs. Includes detailed legal disclaimers and compliance requirements related to FMLA and state-specific leave laws.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-sick-leave.pdf\"\n}"}
