{"_id": "human_resources--hr_policies:_doc--p--61421", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through various programs and resources, including mental health support, fitness initiatives, and financial wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61421", "text": "{\n    \"policy_id\": \"TR-2022-012\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Details the process for employees to submit and receive reimbursements for business-related travel expenses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61422", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees working remotely, including eligibility, equipment, and security requirements. It prioritizes employee flexibility and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
