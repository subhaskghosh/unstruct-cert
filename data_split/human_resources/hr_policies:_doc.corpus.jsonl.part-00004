{"_id": "human_resources--hr_policies:_doc--p--64398", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees must enroll within 30 days of their hire date.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64398", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan options available to employees, including 401k matching, pension plans, and financial planning resources. It includes details on vesting schedules, contribution limits, and investment options. A full understanding of this document is critical for long-term financial wellbeing.  Furthermore, eligibility criteria are detailed, including years of service requirements and performance metrics.  The plan is also subject to specific tax regulations that employees should be aware of.  Detailed information on beneficiary designations is also included. This policy is reviewed annually to ensure compliance with all relevant laws and regulations.  Additional resources are available through the HR department and our financial advisor partner. The plan also has a dispute resolution process...\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement_plan.pdf\"\n}"}
