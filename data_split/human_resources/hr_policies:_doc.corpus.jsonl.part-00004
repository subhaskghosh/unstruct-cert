{"_id": "human_resources--hr_policies:_doc--n--65846", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program designed to cultivate future leaders within the organization, offering various training modules, mentorship opportunities, and performance evaluations. This policy details eligibility criteria, program structure, and evaluation metrics.\",\n    \"effective_date\": \"2023-05-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
