{"_id": "human_resources--hr_policies:_doc--n--65092", "text": "{\n    \"policy_id\": \"LTP-2023-005\",\n    \"policy_title\": \"Long-Term Protection Plan Details\",\n    \"policy_description\": \"A comprehensive document detailing the intricacies of the company’s long-term protection plan, including legal disclaimers, eligibility requirements, and complex benefit calculations. Requires advanced understanding of benefits administration.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltp-details\"\n}"}
