{"_id": "human_resources--hr_policies:_doc--p--64933", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health, physical fitness, and financial wellness.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2022-12-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64933", "text": "{\n    \"policy_id\": \"WB-002\",\n    \"policy_title\": \"Remote Work Wellness Stipend\",\n    \"policy_description\": \"Details the stipend provided to remote employees for setting up a healthy home office environment.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-04-05\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-wellness.pdf\"\n}"}
