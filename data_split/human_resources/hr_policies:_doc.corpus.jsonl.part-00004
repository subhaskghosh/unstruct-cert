{"_id": "human_resources--hr_policies:_doc--n--64422", "text": "{\n    \"policy_id\": \"TRA-DEV-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"Details regarding the advanced leadership training program offered to high-potential employees. This program is a year-long commitment with intensive workshops and mentorship opportunities.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Leadership\",\n        \"HR\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
