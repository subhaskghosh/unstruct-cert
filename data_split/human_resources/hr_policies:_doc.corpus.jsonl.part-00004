{"_id": "human_resources--hr_policies:_doc--p--61416", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Performance Bonus Program\",\n    \"policy_description\": \"This policy outlines the criteria and process for awarding performance-based bonuses to eligible employees. It aims to recognize and reward exceptional contributions to company goals, fostering a culture of achievement and motivation.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/bonus_program.pdf\"\n}"}
