{"_id": "human_resources--hr_policies:_doc--p--71496", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness benefits available to all employees, including mental health support, fitness subsidies, and preventative care resources. It promotes a positive work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71496", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Employee Stock Options Plan\",\n    \"policy_description\": \"This policy details the eligibility criteria and procedures for employees to participate in the company's stock options plan. It outlines vesting schedules and restrictions on trading.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71497", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, and paid time off. It provides detailed information on eligibility, coverage levels, and enrollment procedures.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71497", "text": "{\n    \"policy_id\": \"EXP-005\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while on company business. It covers topics such as allowable expenses, documentation requirements, and reimbursement timelines.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71498", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details of health, dental, and vision insurance coverage for all eligible employees. This policy ensures equitable access to healthcare benefits.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance.pdf\"\n}"}
