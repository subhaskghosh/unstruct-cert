{"_id": "human_resources--hr_policies:_doc--p--65573", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through a confidential Employee Assistance Program. It provides access to counseling, resources, and support services for personal and work-related challenges.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
