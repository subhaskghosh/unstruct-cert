{"_id": "human_resources--hr_policies:_doc--n--71669", "text": "{\n    \"policy_id\": \"LVE-2022-010\",\n    \"policy_title\": \"Long-Term Vacation Eligibility\",\n    \"policy_description\": \"Detailed guidelines regarding eligibility for extended leave of absence, including requirements for tenure, performance reviews, and departmental approval. This policy covers various scenarios, such as sabbatical, parental leave exceeding standard allowances, and personal hardship leave. Specific stipulations apply based on employee level and role. Refer to the complete documentation for comprehensive details. A complicated process is involved with multiple stakeholders and approvals. The details are exhaustive and comprehensive.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71670", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for mental health, physical fitness, and stress management.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71670", "text": "{\n    \"policy_id\": \"TR-002\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Details the process for employees to be reimbursed for business travel expenses.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement.pdf\"\n}"}
