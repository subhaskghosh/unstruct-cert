{"_id": "human_resources--hr_policies:_doc--p--68723", "text": "{\n    \"policy_id\": \"BEN-456\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to employees, including health insurance, retirement plans, and other financial wellness programs designed to support long-term financial security.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68723", "text": "{\n    \"policy_id\": \"TRAV-123\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to submit and receive reimbursement for travel expenses incurred while on company business.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68724", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, premium contributions, and claims procedures. We strive to provide comprehensive and affordable healthcare solutions.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68724", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This comprehensive policy provides income replacement for employees who are unable to work due to a qualifying long-term disability. It details eligibility requirements, benefit levels, and the claims process, including required documentation and appeal procedures. The policy adheres to all relevant federal and state regulations and is regularly reviewed to ensure compliance.  This policy also details interaction with short-term disability, and third-party administrator contact information. Furthermore, it outlines employee and employer responsibilities regarding reporting and maintaining accurate records. Finally, any changes to this policy will be communicated to all employees in a timely and effective manner, and detailed in an updated policy document accessible on the company intranet.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/long-term-disability\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68725", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to gym memberships, mental health resources, and health screenings.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68725", "text": "{\n    \"policy_id\": \"EXEC-COMP-005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Details the stock option grants for executive leadership team members, including vesting schedules and exercise terms.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options\"\n}"}
