{"_id": "human_resources--hr_policies:_doc--p--67541", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67541", "text": "{\n    \"policy_id\": \"PTO-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the accrual rates, usage guidelines, and request procedures for paid time off, including vacation, sick leave, and personal days. It covers eligibility criteria, carryover rules, and the process for submitting time off requests. Furthermore, it addresses considerations for holidays, bereavement leave, and jury duty, outlining specific procedures and documentation requirements for each scenario. The policy also clarifies the interaction between paid time off and other leave types, such as short-term disability and family medical leave, to ensure compliance with legal regulations and company standards. A comprehensive guide to maximizing time off benefits is included as an appendix.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67542", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, enrollment procedures, and associated costs.  Focuses on preventative care and wellness programs.\",\n    \"effective_date\": \"2022-07-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67542", "text": "{\n    \"policy_id\": \"EMP-TERM-002\",\n    \"policy_title\": \"Employee Termination and Exit Procedures\",\n    \"policy_description\": \"This policy details the procedures for employee termination, including notice periods, final paychecks, and benefits continuation. It also outlines the exit interview process and the return of company property. Covers the circumstances under which termination may occur.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67543", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to mental health resources, fitness programs, and healthy eating initiatives.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67543", "text": "{\n    \"policy_id\": \"LE-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed guidelines regarding various types of leaves, including sick leave, personal leave, and family leave.  This document includes comprehensive information on eligibility, application procedures, and benefits continuation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67544", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym membership reimbursements, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67544", "text": "{\n    \"policy_id\": \"EMP-VAC-001\",\n    \"policy_title\": \"Vacation and Paid Time Off\",\n    \"policy_description\": \"This policy details the accrual rates, usage guidelines, and request procedures for vacation time and paid time off.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/vacation-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67545", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage levels, enrollment procedures, and contact information for the insurance provider.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67545", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Comprehensive Travel Reimbursement\",\n    \"policy_description\": \"This policy details all aspects of travel reimbursement for employees, including permissible expenses, approval procedures, documentation requirements, and limitations. It covers international and domestic travel, as well as various modes of transportation and accommodation. Special considerations apply for extended assignments and executive travel. A detailed breakdown of per diem rates is included, along with guidelines for expense reporting and auditing. Further stipulations concerning company credit card usage are also outlined in this document. The policy also covers situations of lost or stolen travel documents and procedures for emergency assistance during travel. Contact information for travel support is provided for any queries or assistance. This policy is subject to change based on prevailing travel regulations and company budgetary constraints.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67546", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"This policy outlines the commission structure for the Sales department, including performance metrics and payout schedules. It also details eligibility for bonus programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_2023.pdf\"\n}"}
