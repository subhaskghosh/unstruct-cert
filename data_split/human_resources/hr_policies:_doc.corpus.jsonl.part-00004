{"_id": "human_resources--hr_policies:_doc--n--68726", "text": "{\n    \"policy_id\": \"LC-2022-005\",\n    \"policy_title\": \"Affordable Care Act Compliance\",\n    \"policy_description\": \"Detailed guidelines on complying with the Affordable Care Act regulations regarding employee health insurance coverage.  Includes complex reporting requirements and legal disclaimers.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/aca-compliance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68727", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"Details the health insurance benefits available to employees, including coverage levels, premiums, and enrollment procedures. This policy is designed to be easily understood by all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68727", "text": "{\n    \"policy_id\": \"EXEC-COMP-005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Outlines the terms and conditions for granting stock options to executive-level employees as part of their compensation package. Includes vesting schedules, exercise prices, and tax implications.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
