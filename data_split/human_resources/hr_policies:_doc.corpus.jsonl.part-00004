{"_id": "human_resources--hr_policies:_doc--p--71160", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various initiatives like gym memberships, mental health resources, and wellness workshops. It aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71160", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the extensive health insurance coverage offered to all eligible employees, including medical, dental, and vision plans. It covers details about premiums, deductibles, co-pays, and out-of-pocket maximums, network providers, pre-authorization requirements, and procedures for filing claims. Specific plan options and enrollment procedures are also outlined, as well as information on compliance with relevant regulations, such as HIPAA and ERISA.  The plan is designed to provide broad coverage while managing healthcare costs effectively. It further details appeal processes and contact information for assistance with claims or questions regarding coverage.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71161", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage, premiums, and claim procedures. Focuses on preventative care and mental health resources.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71161", "text": "{\n    \"policy_id\": \"TRA-0011\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while on company business. It specifies allowable expenses, documentation requirements, and approval processes. The document is quite lengthy and detailed.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expenses\"\n}"}
