{"_id": "human_resources--hr_policies:_doc--p--64754", "text": "{\n    \"policy_id\": \"WB-2023-101\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various programs, including flexible work arrangements, mental health resources, and wellness initiatives. It aims to foster a positive work-life balance for all employees.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64754", "text": "{\n    \"policy_id\": \"LV-2022-050\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and parental leave. It ensures employees understand their rights and responsibilities regarding time off.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64755", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines resources and guidelines for employees to promote their overall well-being and achieve a healthy work-life balance. It includes details on flexible work arrangements, mental health support, and wellness programs.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy-2024\"\n}"}
