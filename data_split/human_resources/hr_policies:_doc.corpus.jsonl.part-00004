{"_id": "human_resources--hr_policies:_doc--n--68956", "text": "{\n    \"policy_id\": \"BEN-RET-2022-002\",\n    \"policy_title\": \"Retirement Savings Plan - Detailed Guide\",\n    \"policy_description\": \"This document provides a comprehensive guide to the company's 401k retirement savings plan. It includes detailed information on eligibility, contribution limits, investment options, vesting schedules, and loan provisions. It also includes information on how to enroll and manage your account. This is a very long document intended to cover all aspects of the plan.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement_guide_2022.pdf\"\n}"}
