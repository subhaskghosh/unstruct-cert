{"_id": "human_resources--hr_policies:_doc--n--67986", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the company's equity compensation plan, including stock options, restricted stock units (RSUs), and performance shares. It adheres to SEC Rule 16b-3 and incorporates the applicable tax regulations outlined in Section 409A of the Internal Revenue Code.\",\n    \"effective_date\": \"2023-02-28\",\n    \"last_updated\": \"2023-08-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/equity_plan.pdf\"\n}"}
