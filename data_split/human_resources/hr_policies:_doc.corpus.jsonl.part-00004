{"_id": "human_resources--hr_policies:_doc--p--64851", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and well-being.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work_arrangements.pdf\"\n}"}
