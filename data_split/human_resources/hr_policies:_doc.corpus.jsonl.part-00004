{"_id": "human_resources--hr_policies:_doc--n--68822", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Detailed guidelines regarding the reimbursement of travel expenses incurred by employees on company business. Includes specific regulations and required documentation. Legal review completed on 2024-06-01.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68823", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees, including medical, dental, and vision coverage. Details regarding eligibility, enrollment procedures, and coverage levels are provided.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68823", "text": "{\n    \"policy_id\": \"REM-002\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees working remotely, including eligibility criteria, equipment requirements, and security protocols. It also covers communication expectations and performance monitoring.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68824", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing details on health insurance coverage, wellness initiatives, and preventative care programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68824", "text": "{\n    \"policy_id\": \"RET-PLAN-001\",\n    \"policy_title\": \"401(k) Retirement Savings Plan\",\n    \"policy_description\": \"This document details the provisions of the company-sponsored 401(k) retirement savings plan, including eligibility requirements, contribution limits, investment options, and withdrawal procedures.  Governed by ERISA regulations and subject to amendment.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68825", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, to support employee work-life balance and overall well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\",\n        \"UX Design\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68825", "text": "{\n    \"policy_id\": \"LC-2022-010\",\n    \"policy_title\": \"Data Privacy and Security Policy\",\n    \"policy_description\": \"This policy details the procedures for protecting employee and customer data, ensuring compliance with relevant data privacy regulations such as GDPR and CCPA. It includes guidelines on data access, storage, and disposal.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/data-privacy\"\n}"}
