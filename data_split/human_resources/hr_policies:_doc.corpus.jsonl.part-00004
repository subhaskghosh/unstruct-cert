{"_id": "human_resources--hr_policies:_doc--p--61483", "text": "{\n    \"policy_id\": \"PTO-2023-08-15\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees requesting and utilizing paid time off for vacation, sick leave, and personal days. It emphasizes the importance of employees taking time off to prevent burnout and maintain a healthy work-life balance.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy_2023.pdf\"\n}"}
