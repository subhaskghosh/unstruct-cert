{"_id": "human_resources--hr_policies:_doc--p--64880", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Enhanced Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing through comprehensive health, mental health, and financial wellness programs. It includes details on health insurance, employee assistance programs, and wellness stipends.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-policy\"\n}"}
