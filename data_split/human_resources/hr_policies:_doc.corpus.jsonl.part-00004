{"_id": "human_resources--hr_policies:_doc--p--70186", "text": "{\n    \"policy_id\": \"POL-2023-101\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the process for reimbursing employees for reasonable and necessary travel expenses incurred while conducting company business. It covers transportation, lodging, and meals, adhering to the company's travel guidelines.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70186", "text": "{\n    \"policy_id\": \"POL-2022-050\",\n    \"policy_title\": \"Remote Work and Home Office Setup\",\n    \"policy_description\": \"This comprehensive policy details the guidelines for remote work arrangements, including eligibility criteria, security protocols, equipment provisioning, expense reimbursement, performance expectations, and compliance requirements. It aims to ensure a productive and secure remote work environment while maintaining consistent standards across the organization. This policy is regularly reviewed and updated to address evolving needs and best practices, including data security, network access, and employee wellbeing.  It also covers topics such as acceptable use of company resources, communication protocols, and the process for requesting and approving remote work arrangements. Further details regarding legal compliance and data privacy are also included, as well as guidelines for maintaining a healthy work-life balance while working remotely.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote_work_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70187", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for the Sales department, including performance targets and payout schedules. Also covers bonus eligibility.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_2023.pdf\"\n}"}
