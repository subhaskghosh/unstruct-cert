{"_id": "human_resources--hr_policies:_doc--n--71214", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Comprehensive Health Insurance Coverage\",\n    \"policy_description\": \"A detailed overview of the company's health insurance plans, including deductibles, co-pays, and covered services.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
