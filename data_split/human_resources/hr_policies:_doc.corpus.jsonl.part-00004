{"_id": "human_resources--hr_policies:_doc--p--64372", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, flexible work arrangements, and time off for personal needs. It aims to foster a healthy work-life balance for all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64372", "text": "{\n    \"policy_id\": \"PTO-2024-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the accrual and usage of paid time off for all employees. It covers vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64373", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for physical and mental health. It covers gym membership reimbursements, mindfulness workshops, and access to an Employee Assistance Program (EAP).\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64373", "text": "{\n    \"policy_id\": \"HR-2023-010\",\n    \"policy_title\": \"Comprehensive Employee Handbook\",\n    \"policy_description\": \"This handbook details all aspects of employment with the company, including code of conduct, benefits, performance management, and termination procedures. It also covers legal compliance requirements and employee rights.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-handbook.pdf\"\n}"}
