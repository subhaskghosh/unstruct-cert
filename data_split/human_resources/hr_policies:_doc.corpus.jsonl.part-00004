{"_id": "human_resources--hr_policies:_doc--p--68998", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Competitive Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, and paid time off. It is designed to attract and retain top talent by offering competitive advantages.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/competitive-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68998", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability and Leave of Absence Procedures\",\n    \"policy_description\": \"Detailed procedures regarding eligibility, application processes, and documentation requirements for long-term disability and various types of leave of absence. This is a highly detailed and comprehensive document covering numerous scenarios.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/disability-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68999", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees are responsible for a portion of the premium, as detailed in the plan documents.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68999", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This comprehensive leadership development program aims to cultivate future leaders within the organization. It includes workshops, mentoring, and opportunities for project leadership. Participation is by nomination only.  The program is designed to enhance strategic thinking, communication skills, and team management capabilities, and is a long-term initiative.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"HR\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
