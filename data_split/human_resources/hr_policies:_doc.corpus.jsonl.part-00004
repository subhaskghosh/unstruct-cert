{"_id": "human_resources--hr_policies:_doc--p--71358", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for physical and mental health. It's designed to promote a positive work-life balance and support employees in achieving their health goals.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
