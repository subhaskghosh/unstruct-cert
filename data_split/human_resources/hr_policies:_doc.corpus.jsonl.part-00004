{"_id": "human_resources--hr_policies:_doc--p--70195", "text": "{\n    \"policy_id\": \"EXP-2023-001\",\n    \"policy_title\": \"Employee Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit and receive reimbursement for authorized business expenses. It aims to ensure fair and timely reimbursement while maintaining fiscal responsibility and supporting employee needs during travel and work-related activities.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-policy-2023\"\n}"}
