{"_id": "human_resources--hr_policies:_doc--p--64978", "text": "{\n    \"policy_id\": \"PTO-2024-003\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize paid time off for vacation, sick leave, and personal reasons. It aims to promote a healthy work-life balance and employee well-being.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-policy-2024-003\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64978", "text": "{\n    \"policy_id\": \"TRV-2023-001\",\n    \"policy_title\": \"Travel Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related travel expenses. It includes guidelines on eligible expenses, documentation requirements, and approval processes.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-policy-2023-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64979", "text": "{\n    \"policy_id\": \"PTO-2024-ENG-001\",\n    \"policy_title\": \"Enhanced PTO Policy - Engineering\",\n    \"policy_description\": \"This policy outlines the guidelines for Paid Time Off (PTO) for employees in the Engineering department. It emphasizes the importance of work-life balance and employee well-being, providing flexible options for vacation, sick leave, and personal days.  It includes provisions for mental health days.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-engineering-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64979", "text": "{\n    \"policy_id\": \"TRAV-2023-ALL-002\",\n    \"policy_title\": \"Corporate Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while on company business. It covers expenses such as airfare, lodging, meals, and transportation. Adherence to the established budget is required.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64980", "text": "{\n    \"policy_id\": \"BP-2023-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, and paid time off. It emphasizes supporting employee well-being and financial security.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64980", "text": "{\n    \"policy_id\": \"BP-2022-001\",\n    \"policy_title\": \"Basic Health Insurance Policy\",\n    \"policy_description\": \"This policy details the minimum health insurance coverage provided to employees. It is a foundational policy and does not include extensive benefits.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2022-12-31\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/basic_health_insurance.pdf\"\n}"}
