{"_id": "human_resources--hr_policies:_doc--n--71005", "text": "{\n    \"policy_id\": \"EMP-LEG-012\",\n    \"policy_title\": \"Non-Disclosure Agreement - Executive Level\",\n    \"policy_description\": \"A comprehensive legal agreement outlining confidentiality obligations for executive employees. Covers intellectual property, trade secrets, and sensitive company information. Requires legal review prior to execution.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Legal\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/nda-executive.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71006", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy details the company's commitment to employee wellness, including health insurance, gym memberships, and mental health resources. It aims to provide comprehensive benefits to support a healthy and productive workforce.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71006", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Plan - Legacy\",\n    \"policy_description\": \"This policy outlines the details of the health insurance plan for employees. It includes information on coverage, deductibles, and co-pays. This is the former plan, now replaced by EMP-BEN-007.\",\n    \"effective_date\": \"2018-01-01\",\n    \"last_updated\": \"2022-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71007", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care, and includes information on enrollment procedures, coverage levels, and claims processing. We strive to provide comprehensive and affordable healthcare options to support the well-being of our employees. This policy also details employee contributions and employer matching programs. The details of the benefits are subject to change annually as negotiated with our providers. Employees are encouraged to review the complete policy document for the most up-to-date information.  This policy is vital for employees and their families.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71007", "text": "{\n    \"policy_id\": \"TRAIN-0005\",\n    \"policy_title\": \"Python Programming Training\",\n    \"policy_description\": \"This policy details the process for employees to request and participate in Python programming training courses. The training is designed to upskill employees in data analysis and automation. It outlines eligibility criteria, course selection, and reimbursement procedures. The department provides training resources and support for successful completion.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2023-04-20\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Data Science\"\n    ],\n    \"policy_document_url\": \"https://example.com/training/python.pdf\"\n}"}
