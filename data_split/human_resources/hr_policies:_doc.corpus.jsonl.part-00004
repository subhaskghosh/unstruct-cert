{"_id": "human_resources--hr_policies:_doc--n--71373", "text": "{\n    \"policy_id\": \"DISC-001\",\n    \"policy_title\": \"Employee Disciplinary Action\",\n    \"policy_description\": \"This policy details the process for addressing employee misconduct, including warnings, suspensions, and termination procedures. It outlines the steps managers must follow to ensure fair and consistent application of disciplinary measures. This comprehensive document covers a wide range of potential offenses and their corresponding consequences. It further details the appeals process and employee rights throughout the disciplinary process. The document also includes detailed case studies.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary-action.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71374", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details coverage options, enrollment procedures, and associated costs for employee health insurance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71374", "text": "{\n    \"policy_id\": \"COMP-012\",\n    \"policy_title\": \"Company Compensation and Equity Grants\",\n    \"policy_description\": \"This document details the compensation structure for all employees, including salary ranges, bonus eligibility, and equity grant programs. Extensive legal disclaimers apply regarding stock options and vesting schedules. See section 7.b for detailed information on equity valuation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71375", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee 401k Contribution Match\",\n    \"policy_description\": \"This policy outlines the company's matching contributions to employee 401k plans. The company will match 50% of employee contributions up to 6% of their salary. This is intended to help employees save for retirement.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71375", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the complete health insurance plan offered to employees, including medical, dental, and vision coverage. It encompasses network providers, deductible information, co-pays, out-of-pocket maximums, and claim procedures. The plan is designed to provide comprehensive healthcare benefits. Detailed information is available in the plan document. This policy also covers pre-existing conditions and mental healthcare services. Information about specialist referrals is available at the HR portal. The health insurance provider is United Healthcare. Employees must enroll during the open enrollment period, typically held in November each year. Benefits are subject to change based on contract negotiations. Contact HR with any questions.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71376", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through a range of benefits including gym memberships, mental health resources, and preventative care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71376", "text": "{\n    \"policy_id\": \"EMP-RET-002\",\n    \"policy_title\": \"401k Contribution Matching\",\n    \"policy_description\": \"Details the company's 401k plan and contribution matching structure for eligible employees.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71377", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels and enrollment procedures. Provides comprehensive support for employees and their families.\",\n    \"effective_date\": \"2023-05-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_benefits.pdf\"\n}"}
