{"_id": "human_resources--hr_policies:_doc--p--70712", "text": "{\n    \"policy_id\": \"BP-2024-005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the full range of employee benefits offered, including health insurance, retirement plans, paid time off, and wellness programs. It outlines eligibility requirements, enrollment procedures, and plan details for each benefit. This includes specific details about coverage levels, deductibles, and co-pays. The policy aims to attract and retain top talent by offering competitive and comprehensive benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
