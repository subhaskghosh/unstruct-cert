{"_id": "human_resources--hr_policies:_doc--n--65233", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Advanced Leadership Development Program\",\n    \"policy_description\": \"This policy details the requirements and process for participating in the Advanced Leadership Development Program. It includes extensive details on application procedures, program curriculum, and evaluation criteria. The program is designed for high-potential employees aiming for executive roles.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Leadership\",\n        \"Management\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-development-policy\"\n}"}
