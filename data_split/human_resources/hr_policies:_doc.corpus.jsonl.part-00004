{"_id": "human_resources--hr_policies:_doc--n--67949", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"Detailed guidelines for reimbursing employees for business-related travel expenses, including per diem rates, mileage, and required documentation. Includes complex approval workflows.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67950", "text": "{\n    \"policy_id\": \"EMP-COND-001\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines the expected standards of behavior for all employees, covering areas such as professionalism, ethics, and respect in the workplace.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-conduct-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67950", "text": "{\n    \"policy_id\": \"REMOTE-WORK-002\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees working remotely, including eligibility criteria, security protocols, and performance expectations. It has several detailed sections covering equipment allowances, data security, and home office ergonomics.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
