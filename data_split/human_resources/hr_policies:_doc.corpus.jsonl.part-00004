{"_id": "human_resources--hr_policies:_doc--p--70786", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the company's commitment to providing employees with confidential support services to address personal and work-related challenges, including mental health, financial difficulties, and legal issues. It covers counseling services, resources for stress management, and referrals to external support networks.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
