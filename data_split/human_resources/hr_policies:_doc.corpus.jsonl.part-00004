{"_id": "human_resources--hr_policies:_doc--n--64981", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"401k Contribution Matching\",\n    \"policy_description\": \"Details the company's 401k plan and contribution matching structure.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64982", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits provided to eligible employees. It covers medical, dental, and vision care. Eligibility is based on full-time employment status. Details on coverage levels and provider networks are available in the linked document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64982", "text": "{\n    \"policy_id\": \"LEAV-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking extended leaves of absence, including medical leave, parental leave, and personal leave. It covers eligibility requirements, duration of leave, continuation of benefits, and return-to-work procedures.  It also details the complex interactions with state and federal regulations and specific documentation requirements. Further details on different leave types can be found within the attached document, and department heads are expected to review all cases on an individual basis. This policy is intended to provide guidance for employees who need to take time off work for extended periods due to unforeseen circumstances and ensure compliance with all applicable laws.\",\n    \"effective_date\": \"2024-03-01\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64983", "text": "{\n    \"policy_id\": \"WB-ENG-2024001\",\n    \"policy_title\": \"Employee Wellness Program - Engineering\",\n    \"policy_description\": \"This policy outlines the resources and support available to Engineering department employees to promote their physical and mental well-being, including flexible work arrangements and access to wellness workshops.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-engineering-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64983", "text": "{\n    \"policy_id\": \"LEAVE-ALL-2023002\",\n    \"policy_title\": \"Annual Leave Policy\",\n    \"policy_description\": \"This policy details the accrual and usage of annual leave for all employees.\",\n    \"effective_date\": \"2023-12-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/annual-leave-policy\"\n}"}
