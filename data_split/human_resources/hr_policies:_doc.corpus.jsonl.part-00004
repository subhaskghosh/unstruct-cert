{"_id": "human_resources--hr_policies:_doc--n--70199", "text": "{\n    \"policy_id\": \"PTO-2022-001\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the guidelines for requesting and using paid time off.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2022-12-15\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70200", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees, as well as wellness program details.\",\n    \"effective_date\": \"2022-07-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70200", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and receiving reimbursement for business travel expenses.\",\n    \"effective_date\": \"2021-11-01\",\n    \"last_updated\": \"2023-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70201", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details all benefits available to employees, including health insurance, retirement plans, paid time off, and employee assistance programs. It also covers eligibility requirements and procedures for accessing these benefits.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70201", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and using sick leave. It covers eligibility, documentation requirements, and accrual rates.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70202", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential counseling and support services for personal and work-related issues.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70202", "text": "{\n    \"policy_id\": \"TR-2022-005\",\n    \"policy_title\": \"Termination of Employment\",\n    \"policy_description\": \"This policy details the procedures for termination of employment, including notice periods and final paychecks. It also covers involuntary termination due to performance issues or misconduct.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70203", "text": "{\n    \"policy_id\": \"EC-2023-005\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines the expected standards of behavior for all employees, emphasizing professionalism, respect, and ethical conduct to foster a positive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/ecoc.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70203", "text": "{\n    \"policy_id\": \"LV-2022-010\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details regarding various types of leaves available to employees, including sick leave, vacation leave, and parental leave.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/loa.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70204", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70204", "text": "{\n    \"policy_id\": \"BP-2022-010\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business travel expenses.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2022-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-reimbursement-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70205", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision care. Employees must enroll during the annual open enrollment period. Further details are available in the benefits guide.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70205", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the company’s comprehensive leadership development program. This multi-stage program involves mentorship, training workshops, and cross-functional project assignments, aiming to cultivate future leaders within the organization. Participants are selected based on performance reviews, leadership potential, and departmental needs. The program spans over 12 months and requires significant time commitment from participants. Detailed information regarding eligibility, selection criteria, and program schedule can be found in the attached document. Includes guidelines for sponsors and mentees to facilitate effective learning. The program also covers topics such as conflict resolution, change management, and strategic thinking. Regular assessments will be conducted to track progress and provide feedback.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70206", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including gym memberships, mental health resources, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70206", "text": "{\n    \"policy_id\": \"EMP-TRAIN-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"Details the requirements and process for participating in the company's leadership development program.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program.pdf\"\n}"}
