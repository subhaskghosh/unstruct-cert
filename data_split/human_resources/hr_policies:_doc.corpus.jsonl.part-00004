{"_id": "human_resources--hr_policies:_doc--p--68661", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness programs and benefits available to all employees, including health insurance, retirement plans, and paid time off. It's designed to support employee well-being and encourage a healthy work-life balance. The language is intentionally clear and avoids jargon.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68661", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Employee Compensation Guidelines\",\n    \"policy_description\": \"This document details the compensation structure for all employee levels, including salary ranges, bonus eligibility, and stock options. It includes detailed legal disclaimers and complex calculations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-compensation.pdf\"\n}"}
