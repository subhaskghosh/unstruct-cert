{"_id": "human_resources--hr_policies:_doc--p--71996", "text": "{\n    \"policy_id\": \"BEN-WELL-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness. It provides details on available resources such as gym memberships, health screenings, and mental health support. The aim is to promote a healthy lifestyle and improve employee wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71996", "text": "{\n    \"policy_id\": \"BEN-RET-002\",\n    \"policy_title\": \"Retirement Savings Plan\",\n    \"policy_description\": \"This policy details the company's 401k retirement savings plan. It covers eligibility, contribution limits, vesting schedules, and investment options. Employees are encouraged to participate in the plan to secure their financial future. This is a highly complex financial document, subject to frequent regulatory changes.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71997", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including resources for physical and financial planning. It covers gym memberships, health screenings, and financial advisors.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71997", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"Details the full range of employee benefits, including health insurance, retirement plans, and paid time off. Contains extensive legal disclaimers and detailed plan descriptions.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/comprehensive_benefits.pdf\"\n}"}
