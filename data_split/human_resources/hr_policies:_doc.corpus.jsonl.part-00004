{"_id": "human_resources--hr_policies:_doc--n--70081", "text": "{\n    \"policy_id\": \"LEAVE-2022-010\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"Outlines the procedures for requesting and utilizing sick leave.  Employees are eligible after 90 days of employment.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick_leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70082", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial planning.  It includes details on our Employee Assistance Program (EAP) and wellness stipends.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70082", "text": "{\n    \"policy_id\": \"TD-2022-012\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit and receive reimbursements for business-related travel and expenses. It includes guidelines on permissible expenses, documentation requirements, and approval processes.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
