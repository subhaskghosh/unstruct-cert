{"_id": "human_resources--hr_policies:_doc--n--67707", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"A comprehensive guide detailing eligibility, vesting schedules, exercise procedures, and tax implications of the company's employee stock option plan. This document covers all aspects of equity compensation, including grant agreements, blackout periods, and reporting requirements.  It is designed to provide clarity on complex financial instruments and ensure compliance with relevant regulations. Detailed appendices provide sample forms and calculations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67708", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Details regarding eligibility, enrollment, and claim procedures are provided in the attached document.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67708", "text": "{\n    \"policy_id\": \"EB-2022-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, including 401(k) contributions, vesting schedules, and investment options. It covers eligibility requirements, plan administration, and procedures for withdrawals and rollovers. This document is a comprehensive guide to employee retirement planning, encompassing all aspects of the plan. Detailed financial projections and investment advice can also be found within. Furthermore, the policy outlines specific procedures for handling hardship withdrawals and qualified domestic relations orders (QDROs). This policy is subject to change based on relevant legislation and market conditions and is reviewed annually to ensure compliance and optimal employee benefits. This is a lengthy document designed to provide maximum clarity. It also covers how benefits are handled for international assignments. The document includes several appendices with detailed investment information.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67709", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, premium contributions, and claims procedures.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
