{"_id": "human_resources--hr_policies:_doc--n--65093", "text": "{\n    \"policy_id\": \"COMP-LEAV-003\",\n    \"policy_title\": \"Comprehensive Leave of Absence\",\n    \"policy_description\": \"This policy outlines all types of leave available to employees, including medical leave, parental leave, bereavement leave, and personal leave.  It details eligibility criteria, application procedures, and associated benefits. This is a highly detailed and complex document covering various scenarios.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/comprehensive_leave.pdf\"\n}"}
