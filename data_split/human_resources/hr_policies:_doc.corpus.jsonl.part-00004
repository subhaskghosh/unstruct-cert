{"_id": "human_resources--hr_policies:_doc--n--68208", "text": "{\n    \"policy_id\": \"EQP-2023-002\",\n    \"policy_title\": \"Employee Stock Purchase Plan and Equity Grants\",\n    \"policy_description\": \"Details the process for employee participation in the company's stock purchase plan, including eligibility, contribution limits, and vesting schedules. Also covers equity grant awards.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-plan\"\n}"}
