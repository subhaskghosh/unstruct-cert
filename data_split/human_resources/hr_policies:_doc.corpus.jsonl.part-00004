{"_id": "human_resources--hr_policies:_doc--n--71594", "text": "{\n    \"policy_id\": \"EB-2022-010\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"This policy details the comprehensive health insurance benefits available to employees, including coverage options, eligibility requirements, and legal compliance information per ERISA and ACA regulations. It covers all departments.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71595", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to gym memberships, mental health resources, and preventative care. It aims to promote a healthy work-life balance and improve overall employee satisfaction. This program is especially useful for new hires as they transition into the company culture.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71595", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Executive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement benefits available to executive-level employees, including 401k matching, stock options, and deferred compensation plans. It outlines eligibility requirements, vesting schedules, and contribution limits. This policy covers a complex range of financial instruments and requires careful review by qualified financial advisors.  It involves a detailed calculation of benefits based on years of service and salary, and includes clauses regarding potential tax implications and asset allocation strategies. It also contains legal disclaimers regarding the company's responsibilities and the employee's individual financial planning.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-retirement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71596", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the full range of employee benefits offered by the company, including health insurance, retirement plans, paid time off, and wellness programs. It details eligibility requirements, enrollment procedures, and plan details for each benefit. The policy aims to provide a competitive and comprehensive benefits package to attract and retain top talent.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/employee_benefits_package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71596", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Health Insurance Overview\",\n    \"policy_description\": \"A brief overview of the company's health insurance plan. Contact HR for detailed information.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance_overview.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71597", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health and wellness benefits available to all eligible employees, including medical, dental, and vision coverage. It also details wellness programs and resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71597", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Termination Benefits Package\",\n    \"policy_description\": \"This policy details the benefits available to employees upon termination of employment, including severance pay, continuation of health coverage, and outplacement services.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71598", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the company's health insurance coverage options for employees. Includes information on premiums, deductibles, and coverage levels. This policy aims to provide comprehensive healthcare benefits to all eligible employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71598", "text": "{\n    \"policy_id\": \"TERM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"Outlines the process for terminating employment with the company, including required documentation, exit interviews, and final pay procedures. This covers all possible termination scenarios, including voluntary resignation, and involuntary dismissal. It adheres to all relevant legal and regulatory guidelines to ensure fair and consistent treatment of all employees and minimize legal risks.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination/procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71599", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy details the company's health and wellness initiatives, including gym membership reimbursement and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
