{"_id": "human_resources--hr_policies:_doc--p--61423", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee 401k Contribution Policy\",\n    \"policy_description\": \"Details regarding employee contributions to the company 401k plan, including matching contributions and vesting schedules.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k.pdf\"\n}"}
