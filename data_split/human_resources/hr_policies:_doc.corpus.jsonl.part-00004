{"_id": "human_resources--hr_policies:_doc--p--69927", "text": "{\n    \"policy_id\": \"EXP-REIMB-2023-001\",\n    \"policy_title\": \"Employee Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for reimbursing employees for business-related expenses, including travel, accommodation, and meals. It aims to ensure fair and consistent treatment of all employees while adhering to budgetary constraints.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-reimbursement-policy-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69927", "text": "{\n    \"policy_id\": \"PTO-2022-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the accrual and usage of paid time off for employees. It covers vacation, sick leave, and personal days. All employees are eligible after 90 days of employment.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-2022.pdf\"\n}"}
