{"_id": "human_resources--hr_policies:_doc--p--68412", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and increase productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68412", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Travel Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while conducting company business.  Includes details on allowable expenses, required documentation, and approval processes.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68413", "text": "{\n    \"policy_id\": \"EMP-WELL-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for physical and mental health support. Includes details on gym memberships, wellness workshops, and Employee Assistance Programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68413", "text": "{\n    \"policy_id\": \"EMP-TERM-002\",\n    \"policy_title\": \"Employee Termination Policy\",\n    \"policy_description\": \"This policy details the procedures for employee termination, including grounds for termination, notice periods, and severance pay. It also covers exit interviews and the return of company property.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-policy.pdf\"\n}"}
