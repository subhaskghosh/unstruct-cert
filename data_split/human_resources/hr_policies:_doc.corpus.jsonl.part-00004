{"_id": "human_resources--hr_policies:_doc--p--69577", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for remote work arrangements for eligible employees. It covers eligibility criteria, equipment requirements, security protocols, and performance expectations for remote work.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69577", "text": "{\n    \"policy_id\": \"PTO-2022-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the accrual rates, usage guidelines, and request procedures for paid time off (PTO) for all employees.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--69578", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for eligible employees, including requirements for equipment, security, and performance expectations. It addresses remote work eligibility and includes details about using company resources while working remotely. Remote work is subject to manager approval.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote_work_policy.pdf\"\n}"}
