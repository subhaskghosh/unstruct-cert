{"_id": "human_resources--hr_policies:_doc--n--67796", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Comprehensive Travel Reimbursement\",\n    \"policy_description\": \"This comprehensive policy details all aspects of employee travel reimbursement, including expense limits, approval processes, documentation requirements, and exceptions. It covers international and domestic travel, and provides guidance on preferred vendors, booking procedures, and reporting timelines.  The policy also addresses situations involving lost or stolen travel documents, emergency assistance, and travel insurance. Specific rules vary based on employee level and trip duration, requiring careful attention to detail.\",\n    \"effective_date\": \"2023-06-15\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement\"\n}"}
