{"_id": "human_resources--hr_policies:_doc--n--68034", "text": "{\n    \"policy_id\": \"LGL-2022-005\",\n    \"policy_title\": \"Equity Compensation Plan - Restricted Stock Units\",\n    \"policy_description\": \"Detailed guidelines and legal terms related to the granting and vesting of Restricted Stock Units to employees.  Includes complex tax implications and forfeiture clauses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/equity_compensation_lgl_2022_005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68035", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial planning. It covers full-time employees and is designed to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68035", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Temporary Worker Benefits\",\n    \"policy_description\": \"This policy details the benefits available to temporary and contract employees, including health insurance options and paid time off accrual.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2023-08-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/temp-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68036", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can find detailed information about coverage levels and provider networks in the linked document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68036", "text": "{\n    \"policy_id\": \"EB-2022-002\",\n    \"policy_title\": \"Retirement Plan Contribution\",\n    \"policy_description\": \"This policy details the company's 401k retirement plan. It explains eligibility requirements, contribution limits, vesting schedules, and investment options. The plan is designed to help employees save for their future financial security. It is a comprehensive document detailing historical plan amendments and regulatory compliance requirements, going back to the plan's inception. It covers many edge cases and scenarios related to leaves of absence, employment status changes and distributions, and other complex situations. The details can be found in the full plan document.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68037", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage, premiums, and enrollment procedures. We aim to provide comprehensive healthcare options to support our employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68037", "text": "{\n    \"policy_id\": \"TERM-0005\",\n    \"policy_title\": \"Employee Termination Benefits\",\n    \"policy_description\": \"This policy details the benefits provided to employees upon termination of employment, including final paycheck details, COBRA eligibility, and severance packages. It covers both voluntary and involuntary terminations.\",\n    \"effective_date\": \"2021-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination/benefits.pdf\"\n}"}
