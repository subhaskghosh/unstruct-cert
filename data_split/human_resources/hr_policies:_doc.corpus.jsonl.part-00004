{"_id": "human_resources--hr_policies:_doc--p--61967", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels, premiums, and enrollment procedures are included. Employees are encouraged to review the complete benefits package document for more information.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61967", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to all eligible employees, including 401k matching, pension options, and financial planning resources. It outlines eligibility requirements, contribution limits, vesting schedules, and withdrawal procedures. Detailed analysis of investment options and risk tolerance assessments are included, ensuring employees can make informed decisions about their financial future. The plan is regularly reviewed to ensure compliance with all relevant regulations and best practices, and annual updates are provided to reflect any changes in legislation or market conditions. This policy is designed to secure employees’ long-term financial well-being, promoting stability and peace of mind during their retirement years.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
