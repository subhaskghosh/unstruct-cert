{"_id": "human_resources--hr_policies:_doc--p--61844", "text": "{\n    \"policy_id\": \"RW-2023-ENG-PROD\",\n    \"policy_title\": \"Remote Work Policy - Engineering & Product\",\n    \"policy_description\": \"This policy outlines guidelines for remote work arrangements for Engineering and Product teams. It covers eligibility, equipment, security, and communication expectations.  Remote work is approved on a case-by-case basis with manager approval.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-eng-prod.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61844", "text": "{\n    \"policy_id\": \"RW-2022-ALL\",\n    \"policy_title\": \"Company-Wide Remote Work Policy\",\n    \"policy_description\": \"This comprehensive policy details all aspects of remote work across the entire organization, including eligibility criteria, home office setup requirements, security protocols, expense reimbursement guidelines, performance management, communication best practices, legal considerations, and more. It aims to provide a standardized approach to remote work while ensuring productivity and compliance. The policy is continually reviewed and updated to reflect evolving best practices and legal requirements. Includes detailed sections on international remote work regulations and tax implications.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/company-wide-remote-work.pdf\"\n}"}
