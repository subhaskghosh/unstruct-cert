{"_id": "human_resources--hr_policies:_doc--n--61602", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Compensation and Benefits Plan\",\n    \"policy_description\": \"This policy outlines the comprehensive compensation and benefits package for executive-level employees, including stock options, performance bonuses, and enhanced health benefits. It details eligibility requirements, performance metrics, and the process for benefit enrollment and administration.  The plan is designed to attract and retain top talent and align executive compensation with the company’s strategic objectives. This document also contains information on retirement planning and wealth management resources available to executives. Extensive details are available in the attached document, including legal disclaimers and compliance information.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-benefits-policy\"\n}"}
