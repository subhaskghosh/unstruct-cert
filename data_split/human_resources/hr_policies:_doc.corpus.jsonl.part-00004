{"_id": "human_resources--hr_policies:_doc--n--67284", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Retirement Savings Plan\",\n    \"policy_description\": \"A comprehensive guide detailing the 401k plan, including eligibility requirements, contribution limits, vesting schedules, loan provisions, and investment options.  This plan is designed to help employees save for retirement and provides various investment vehicles to suit different risk tolerances. The plan also outlines procedures for withdrawals and distributions, including penalties for early withdrawal.  Employees are encouraged to review the plan document carefully and consult with a financial advisor to make informed investment decisions. The plan is regularly reviewed and updated to ensure compliance with all applicable regulations.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
