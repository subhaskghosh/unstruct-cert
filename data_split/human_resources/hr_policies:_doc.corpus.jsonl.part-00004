{"_id": "human_resources--hr_policies:_doc--p--61852", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees. Coverage includes medical, dental, and vision. Employees can enroll during the annual open enrollment period or upon hire. Details regarding premiums, deductibles, and coverage levels are available in the policy document.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61852", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy provides income replacement for employees who become disabled and are unable to work. Eligibility requirements include a qualifying disability as defined by the insurance carrier. Benefits are paid after a waiting period. Detailed information about coverage amounts, limitations, and claim procedures can be found in the attached document. This plan is designed to provide financial security during challenging times, encompassing a comprehensive array of coverage options and eligibility criteria. It addresses various scenarios related to long-term disability, ensuring employees receive the necessary support. The policy aims to be transparent and accessible, offering clear guidelines on filing claims and understanding benefit levels. Regular updates are made to the policy to reflect changes in regulations and best practices in disability insurance. It also highlights the importance of preventative measures and resources available to employees to maintain their health and well-being. This commitment to employee welfare extends beyond financial assistance, encompassing emotional support and guidance throughout the disability process.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability-policy\"\n}"}
