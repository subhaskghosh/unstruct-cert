{"_id": "human_resources--hr_policies:_doc--p--65929", "text": "{\n    \"policy_id\": \"WB-ENG-001\",\n    \"policy_title\": \"Mental Health Support for Engineers\",\n    \"policy_description\": \"This policy outlines the resources and support available to Engineering department employees regarding mental health, including access to counseling services and stress management workshops. It aims to foster a positive and supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-eng-001\"\n}"}
