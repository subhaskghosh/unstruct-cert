{"_id": "human_resources--hr_policies:_doc--n--62802", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Retirement Plan Details\",\n    \"policy_description\": \"A comprehensive guide to the company's 401k retirement plan, including investment options, contribution limits, and vesting schedules. This document outlines eligibility criteria, enrollment procedures, and withdrawal rules. It also provides information on employer matching contributions and potential tax implications. Regular reviews are recommended to align with personal financial goals.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
