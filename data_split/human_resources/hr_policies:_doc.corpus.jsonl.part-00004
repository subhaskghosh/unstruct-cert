{"_id": "human_resources--hr_policies:_doc--p--71649", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial wellness. It includes details on gym membership subsidies, employee assistance programs, and financial planning workshops. It aims to promote a healthy and productive work environment.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71649", "text": "{\n    \"policy_id\": \"EXP-TRAV-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and be reimbursed for travel expenses incurred while on company business. It includes guidelines on acceptable expenses, mileage rates, and required documentation. The policy is designed to ensure fair and consistent reimbursement of legitimate business travel costs. It covers airfare, lodging, meals, and transportation.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_expenses.pdf\"\n}"}
