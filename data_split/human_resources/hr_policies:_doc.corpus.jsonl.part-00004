{"_id": "human_resources--hr_policies:_doc--n--65298", "text": "{\n    \"policy_id\": \"LEAV-2022-010\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"A comprehensive policy detailing procedures for requesting and managing extended leaves of absence for various reasons, including medical, family, and personal circumstances. Includes intricate details about benefits continuation and return-to-work protocols.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave.pdf\"\n}"}
