{"_id": "human_resources--hr_policies:_doc--n--62319", "text": "{\n    \"policy_id\": \"EMP-GEN-005\",\n    \"policy_title\": \"General Workplace Conduct\",\n    \"policy_description\": \"A comprehensive guide outlining expected professional behavior, ethical standards, and disciplinary procedures for all employees. It covers a wide range of topics from dress code to conflict resolution and adheres to all relevant legal regulations. This policy is designed to create a productive and respectful work environment and may be subject to periodic updates to reflect changes in the law or company practices.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/workplace-conduct\"\n}"}
