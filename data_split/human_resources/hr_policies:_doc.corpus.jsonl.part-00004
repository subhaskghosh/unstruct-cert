{"_id": "human_resources--hr_policies:_doc--p--71273", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Enhanced Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering comprehensive health benefits, mental health resources, and fitness stipends. It promotes a proactive approach to health and aims to foster a supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71273", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Standard Health Insurance Policy\",\n    \"policy_description\": \"Details of the company's standard health insurance coverage, including deductibles, co-pays, and covered services.  This is a traditional health plan.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/standard-health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71274", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the resources available to employees experiencing personal or work-related difficulties. It provides confidential counseling, referral services, and support to promote employee well-being and maintain a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71274", "text": "{\n    \"policy_id\": \"WB-2023-007\",\n    \"policy_title\": \"Mental Health First Aid Training\",\n    \"policy_description\": \"Details the company's provision of Mental Health First Aid training to designated employees, focusing on early intervention and support for colleagues experiencing mental health challenges.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/mhfa-training\"\n}"}
