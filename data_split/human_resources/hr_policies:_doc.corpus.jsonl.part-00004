{"_id": "human_resources--hr_policies:_doc--n--67771", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Comprehensive Travel Reimbursement\",\n    \"policy_description\": \"This policy details the complete process for requesting and receiving reimbursement for all business-related travel expenses, including airfare, lodging, meals, transportation, and incidental costs.  It covers pre-approval procedures, acceptable expense limits, required documentation, and the submission process.  Specific guidelines are provided for different travel tiers and departmental variations.  Detailed reporting requirements are also outlined.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67772", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to employees, including medical, dental, and vision coverage. It details eligibility requirements, enrollment procedures, and cost-sharing arrangements.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67772", "text": "{\n    \"policy_id\": \"EMP-BEN-009\",\n    \"policy_title\": \"Retirement Savings Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including eligibility, contribution limits, investment options, and vesting schedule. It explains the process for enrolling in the plan and making changes to contributions.  It also discusses retirement income options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
