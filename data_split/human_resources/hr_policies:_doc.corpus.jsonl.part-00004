{"_id": "human_resources--hr_policies:_doc--n--64245", "text": "{\n    \"policy_id\": \"LEGL-COMP-005\",\n    \"policy_title\": \"Workplace Compliance - Detailed Legal Review\",\n    \"policy_description\": \"A comprehensive document detailing all legal compliance requirements for the company, covering numerous areas including data privacy, anti-discrimination, and regulatory reporting. This includes detailed procedures for handling sensitive data, investigating complaints, and ensuring adherence to evolving legislation. This document is lengthy and complex and requires legal counsel to interpret.\",\n    \"effective_date\": \"2022-11-10\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal-compliance-doc\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64246", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and wellbeing through various programs, including gym memberships, mental health resources, and health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64246", "text": "{\n    \"policy_id\": \"EMP-LEAVE-002\",\n    \"policy_title\": \"Parental Leave Policy\",\n    \"policy_description\": \"This policy details the provisions for parental leave for eligible employees.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/parental-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64247", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, physical fitness, and financial stability. It focuses on creating a supportive work environment and promoting a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64247", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation, and parental leave. It is designed to comply with all applicable laws and regulations.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
