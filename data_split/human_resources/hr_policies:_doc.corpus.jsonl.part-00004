{"_id": "human_resources--hr_policies:_doc--p--69098", "text": "{\n    \"policy_id\": \"ATT-001\",\n    \"policy_title\": \"Attendance and Punctuality\",\n    \"policy_description\": \"This policy outlines the expectations for attendance and punctuality for all employees. It covers procedures for reporting absences, tardiness, and early departures. This policy details attendance requirements for maintaining full benefits eligibility and performance review considerations related to attendance.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance_policy.pdf\"\n}"}
