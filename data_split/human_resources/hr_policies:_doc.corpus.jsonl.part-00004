{"_id": "human_resources--hr_policies:_doc--n--67664", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Outlines the terms and conditions of the executive stock option plan, including vesting schedules, exercise prices, and tax implications. This is a very detailed and complex financial instrument.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67665", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the full range of benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It details eligibility requirements, enrollment procedures, and plan options. Regular reviews and updates ensure alignment with best practices and legal requirements.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67665", "text": "{\n    \"policy_id\": \"EMP-PTO-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off, including vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy.pdf\"\n}"}
