{"_id": "human_resources--hr_policies:_doc--p--71706", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee physical and mental well-being. It details access to resources like gym memberships, mental health counseling, and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71706", "text": "{\n    \"policy_id\": \"LOA-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including medical, personal, and parental leave. It includes complex eligibility requirements and documentation processes.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71707", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health support, fitness programs, and work-life balance. It aims to create a supportive and healthy work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71707", "text": "{\n    \"policy_id\": \"ATD-2022-001\",\n    \"policy_title\": \"Attendance and Tardiness Protocol\",\n    \"policy_description\": \"Detailed procedures regarding employee attendance, reporting of absences, and consequences for tardiness. Strict adherence to schedule is required. Formal documentation is needed for all exceptions.\",\n    \"effective_date\": \"2022-10-01\",\n    \"last_updated\": \"2023-09-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71708", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, physical fitness, and financial planning. It covers access to gym memberships, counseling services, and financial literacy workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71708", "text": "{\n    \"policy_id\": \"DISC-ACT-002\",\n    \"policy_title\": \"Employee Disciplinary Action\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and performance issues, including warnings, suspensions, and termination.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action-process\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71709", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"Details the health insurance, dental, and vision benefits available to employees. Covers eligibility, enrollment, and claim procedures. Includes information on reasonable accommodations related to healthcare needs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71709", "text": "{\n    \"policy_id\": \"CMP-2022-005\",\n    \"policy_title\": \"Code of Conduct - Compliance\",\n    \"policy_description\": \"Outlines the company's expectations for ethical behavior and adherence to legal regulations. Focuses on preventing fraud, discrimination, and harassment.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2022-08-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/compliance/code_of_conduct.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71710", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance plans offered to employees, including coverage levels, premiums, and enrollment procedures. This policy provides clear information on medical, dental, and vision benefits.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
