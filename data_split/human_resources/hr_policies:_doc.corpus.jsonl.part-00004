{"_id": "human_resources--hr_policies:_doc--p--64300", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee well-being, including gym membership discounts, mental health resources, and annual health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64300", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details regarding the company's 401k retirement savings plan, including contribution matching and investment options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64301", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64301", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan options, including 401k matching, pension plans, and financial planning resources. It includes information on vesting schedules, contribution limits, and investment options, and is subject to change based on market conditions and regulatory requirements.  It covers eligibility criteria, enrollment procedures, and beneficiary designation.  The policy also outlines the process for making withdrawals and rollovers, as well as the tax implications associated with each option.  Furthermore, it provides details on the plan's administration and the roles of various stakeholders, including the plan sponsor, trustee, and investment manager.  Amendments to this policy will be communicated to all eligible participants.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64302", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance benefits available to all eligible employees, including coverage levels and enrollment procedures.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64302", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Employee Training and Development\",\n    \"policy_description\": \"Outlines the company's policy on employee training and development opportunities.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/training-development.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64303", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, physical fitness, and financial wellness. It includes details on gym membership reimbursements, employee assistance programs, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
