{"_id": "human_resources--hr_policies:_doc--n--65980", "text": "{\n    \"policy_id\": \"TRA-DEV-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program for identifying, developing, and mentoring future leaders within the organization. This program involves multiple phases, intensive training modules, and personalized coaching sessions.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-development\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65981", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to employees. It also includes information on employee assistance programs and wellness initiatives to promote employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits.pdf\"\n}"}
