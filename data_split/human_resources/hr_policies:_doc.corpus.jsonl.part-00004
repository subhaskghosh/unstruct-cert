{"_id": "human_resources--hr_policies:_doc--p--67916", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can enroll during open enrollment or upon hire. Details regarding coverage levels and premiums are available in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67916", "text": "{\n    \"policy_id\": \"PTO-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing paid time off, including vacation, sick leave, and personal days. It encompasses accrual rates, maximum carryover limits, and approval processes.  Detailed guidelines are provided for different employee levels and tenures. This policy also covers procedures for extended leave of absence, including family medical leave and sabbatical options. Further clarification on eligibility and specific situations can be found in the detailed policy document and through HR consultation.  It also outlines the process for coordinating PTO with department heads to ensure adequate coverage.  Compliance with state and federal regulations is paramount. This policy applies to all regular full-time and part-time employees...\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy\"\n}"}
