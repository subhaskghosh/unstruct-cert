{"_id": "human_resources--hr_policies:_doc--n--65797", "text": "{\n    \"policy_id\": \"COMP-002\",\n    \"policy_title\": \"Compensation and Equity Guidelines\",\n    \"policy_description\": \"A comprehensive document outlining the company's compensation philosophy, salary ranges, equity awards, and performance-based bonus structures.  Includes detailed legal disclaimers and numerous appendices.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2024-01-12\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/guidelines\"\n}"}
