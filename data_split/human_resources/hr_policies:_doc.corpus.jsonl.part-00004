{"_id": "human_resources--hr_policies:_doc--p--62794", "text": "{\n    \"policy_id\": \"WB-2023-10-27\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources and support for physical and mental health. It includes details on gym reimbursement, mental health counseling, and stress management workshops.  The program is designed to be accessible and supportive for all employees.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62794", "text": "{\n    \"policy_id\": \"LV-2022-01-10\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving various types of leave, including sick leave, vacation leave, and family leave. It is in full compliance with all applicable federal and state laws.  Details are extensive and require legal review to understand.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy.docx\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62795", "text": "{\n    \"policy_id\": \"BNF-2024-01\",\n    \"policy_title\": \"Employee Benefits & Remote Work Policy\",\n    \"policy_description\": \"This policy details eligibility for various employee benefits, including health insurance, paid time off, and retirement plans. It also outlines guidelines for remote work arrangements, emphasizing flexibility and work-life balance.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-remote-work-policy.pdf\"\n}"}
