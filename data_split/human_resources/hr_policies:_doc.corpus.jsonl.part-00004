{"_id": "human_resources--hr_policies:_doc--p--65927", "text": "{\n    \"policy_id\": \"BNF-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the various wellness benefits available to employees, including gym memberships, mental health resources, and preventative care. It promotes a healthy work-life balance and supports employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Technology\",\n        \"Research and Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65927", "text": "{\n    \"policy_id\": \"CMP-005\",\n    \"policy_title\": \"Employee Complaint Procedure\",\n    \"policy_description\": \"This policy details the process for filing and resolving employee complaints, ensuring a fair and transparent investigation. It focuses on adherence to legal requirements and company standards.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/complaints/procedure.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65928", "text": "{\n    \"policy_id\": \"WB-2023-007\",\n    \"policy_title\": \"Change Management Support Policy\",\n    \"policy_description\": \"This policy outlines the support available to employees during organizational changes, including career counseling, training opportunities, and mental health resources. It aims to minimize disruption and maximize employee well-being during transitions.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Research\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/change-management-support\"\n}"}
