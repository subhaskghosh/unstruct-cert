{"_id": "human_resources--hr_policies:_doc--n--67889", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Compensation and Equity Policy\",\n    \"policy_description\": \"This comprehensive policy details the company's approach to compensation, including salary structures, bonus programs, stock options, and long-term incentive plans. It covers eligibility criteria, performance review processes, and legal compliance requirements.  Detailed calculations and examples are provided.  This is also applicable to executive compensation. Extensive appendices detail tax implications and various scenarios. It addresses several complex situations and requires careful interpretation by HR professionals.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67890", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy details the process for employees to enroll in company-sponsored health insurance plans. It outlines eligibility, plan options, and enrollment deadlines.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67890", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This policy outlines the compensation structure for executive-level employees, including base salary, bonus targets, stock options, and restricted stock units. It details the vesting schedules and performance metrics used for equity grants. This is a comprehensive and detailed document covering all aspects of executive pay.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-policy\"\n}"}
