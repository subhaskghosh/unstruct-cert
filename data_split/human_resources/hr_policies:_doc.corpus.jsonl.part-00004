{"_id": "human_resources--hr_policies:_doc--n--64934", "text": "{\n    \"policy_id\": \"CL-2022-005\",\n    \"policy_title\": \"Company Laptop Usage Policy\",\n    \"policy_description\": \"This policy details the acceptable use of company-issued laptops, security protocols, and IT support procedures.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/laptop_usage.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64935", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, and vision benefits available to all eligible employees, including provisions for family coverage and wellness programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-bnf-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64935", "text": "{\n    \"policy_id\": \"TRA-DEV-002\",\n    \"policy_title\": \"Employee Training and Development\",\n    \"policy_description\": \"This policy details the opportunities available to employees for professional development and skill enhancement.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/tra-dev-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64936", "text": "{\n    \"policy_id\": \"BP-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to employees. It covers medical, dental, and vision plans. Eligibility requirements and enrollment details are included.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64936", "text": "{\n    \"policy_id\": \"BP-002\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This comprehensive policy details the compensation structure for executive-level employees, including base salary, performance bonuses, stock options, restricted stock units (RSUs), and long-term incentive plans. It covers eligibility criteria, vesting schedules, performance metrics, and tax implications.  This policy adheres to all applicable regulatory requirements and is subject to review by the Compensation Committee of the Board of Directors. Detailed guidance on equity grant administration and insider trading regulations is provided. A full compliance manual supplement is available.  Furthermore, this policy includes clauses relating to change-in-control events, severance agreements, and post-employment restrictions.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64937", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels and enrollment procedures. This is crucial information for new employees during onboarding.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64937", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Outlines the process for submitting and receiving reimbursement for business travel expenses.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2022-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64938", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee 401k Retirement Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401k retirement savings plan, including eligibility, contribution limits, and vesting schedule. It is designed to help employees build financial security for their future.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64938", "text": "{\n    \"policy_id\": \"EMP-TRA-002\",\n    \"policy_title\": \"Professional Development Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to request reimbursement for approved professional development courses and certifications. The purpose is to enhance employee skills and knowledge.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/training_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64939", "text": "{\n    \"policy_id\": \"BEN-401K-2023\",\n    \"policy_title\": \"401(k) Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401(k) plan, including eligibility, contribution limits, vesting schedule, and investment options. This policy aims to support employees' long-term financial security and retirement planning.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64939", "text": "{\n    \"policy_id\": \"HOL-VAC-2024\",\n    \"policy_title\": \"Vacation and Paid Time Off Policy\",\n    \"policy_description\": \"Outlines the guidelines for accruing and using vacation time and paid time off (PTO). Includes information on request procedures, carryover limits, and blackout dates.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64940", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"Provides employees with 16 weeks of paid parental leave for the birth or adoption of a child.  Includes support for flexible return-to-work arrangements.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental_leave_enhanced.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64940", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Standard Vacation Policy\",\n    \"policy_description\": \"Outlines the standard vacation accrual rates based on years of service.  Employees accrue 10 days of vacation per year.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation.pdf\"\n}"}
