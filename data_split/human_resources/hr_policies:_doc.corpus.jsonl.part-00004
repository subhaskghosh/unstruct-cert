{"_id": "human_resources--hr_policies:_doc--p--64752", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health & Wellness Benefits\",\n    \"policy_description\": \"This policy details the company's health insurance, dental, vision, and wellness program offerings for all eligible employees. It includes generous coverage for preventative care and mental health services.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64752", "text": "{\n    \"policy_id\": \"EMP-DISC-003\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"This policy outlines the steps taken when addressing employee misconduct or performance issues. It details the process for warnings, performance improvement plans, and potential termination.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary-procedures\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64753", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various health and wellness benefits, including gym memberships, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_program.pdf\"\n}"}
