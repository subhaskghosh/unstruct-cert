{"_id": "human_resources--hr_policies:_doc--p--67770", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness programs, and healthy eating initiatives. It aims to create a supportive work environment that prioritizes employee health and happiness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67770", "text": "{\n    \"policy_id\": \"EMP-TRAIN-001\",\n    \"policy_title\": \"Sales Training Reimbursement\",\n    \"policy_description\": \"This policy details the process for sales team members to request reimbursement for external training courses related to sales techniques and product knowledge.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales_training.pdf\"\n}"}
