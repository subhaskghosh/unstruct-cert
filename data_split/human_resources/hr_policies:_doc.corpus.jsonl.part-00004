{"_id": "human_resources--hr_policies:_doc--n--64923", "text": "{\n    \"policy_id\": \"VAC-2023-002\",\n    \"policy_title\": \"Vacation Time Accrual\",\n    \"policy_description\": \"Guidelines for accruing and utilizing vacation time, including blackout periods and approval processes.\",\n    \"effective_date\": \"2023-06-15\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/vacation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64924", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, vision, and wellness benefits available to all eligible employees. It details coverage levels, eligibility requirements, enrollment procedures, and resources for accessing these benefits. The policy also addresses employee assistance programs and preventative care initiatives.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64924", "text": "{\n    \"policy_id\": \"EMP-TRAIN-002\",\n    \"policy_title\": \"Professional Development Training Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to request reimbursement for approved professional development training. Reimbursement is subject to budgetary constraints and prior manager approval.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-train-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64925", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness and Support Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health support, stress management workshops, and financial wellness counseling, in addition to standard health benefits. It emphasizes a proactive and preventative approach to employee health.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-engineering\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64925", "text": "{\n    \"policy_id\": \"HB-ENG-2023-005\",\n    \"policy_title\": \"Health Benefits Enrollment - Engineering\",\n    \"policy_description\": \"This policy details the enrollment process for standard health, dental, and vision benefits for employees in the Engineering department. It outlines eligibility requirements, plan options, and enrollment deadlines. It does not cover any additional wellness or support programs.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-benefits-engineering\"\n}"}
