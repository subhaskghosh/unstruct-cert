{"_id": "human_resources--hr_policies:_doc--n--62743", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Vacation Time Policy\",\n    \"policy_description\": \"Outlines the vacation time accrual rates and usage guidelines for all employees.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62744", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Remote Work and Home Office Expenses\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements, including eligibility, expense reimbursement, and security protocols. It aims to provide a flexible work environment while ensuring productivity and data protection.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Technology\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work_expenses.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62744", "text": "{\n    \"policy_id\": \"EMP-RET-002\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including contribution matching, vesting schedules, and investment options. This policy is designed to help employees prepare for retirement.\",\n    \"effective_date\": \"2023-02-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62745", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources and support for physical and mental health. It includes details on gym memberships, health screenings, and employee assistance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62745", "text": "{\n    \"policy_id\": \"DISC-003\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the process for addressing employee misconduct, including warnings, suspensions, and termination. It outlines the steps involved in investigations, employee rights, and documentation requirements. The policy is very extensive and covers various types of offenses and legal considerations. It aims to ensure fair and consistent treatment of all employees in disciplinary matters.\",\n    \"effective_date\": \"2022-09-01\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-procedure\"\n}"}
