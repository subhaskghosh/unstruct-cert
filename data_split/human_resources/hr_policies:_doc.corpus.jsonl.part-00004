{"_id": "human_resources--hr_policies:_doc--n--62840", "text": "{\n    \"policy_id\": \"EQC-001\",\n    \"policy_title\": \"Stock Option Grant Policy\",\n    \"policy_description\": \"Details the process for granting stock options to employees, vesting schedules, and exercise procedures. Contains complex legal language.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62841", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health & Wellness Benefits\",\n    \"policy_description\": \"This policy details the company's comprehensive health and wellness benefits package, including medical, dental, vision, and employee assistance programs. It outlines eligibility requirements, coverage levels, and procedures for accessing benefits. This includes preventative care, mental health resources, and wellness initiatives designed to promote employee well-being. Employees are encouraged to utilize these benefits to maintain a healthy lifestyle.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62841", "text": "{\n    \"policy_id\": \"EMP-RET-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401k retirement savings plan, including eligibility, contribution limits, vesting schedules, and investment options. It also includes information on loan provisions and hardship withdrawals. Employees can enroll in the plan within 30 days of hire.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62842", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"Details the company's employee wellness benefits, including gym memberships, mental health resources, and health risk assessments.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62842", "text": "{\n    \"policy_id\": \"LEGAL-COMP-012\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"Outlines the company's legal obligations under the Employee Retirement Income Security Act (ERISA).\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/erisa-compliance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62843", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical health, and work-life balance. It encourages proactive health management and provides access to support services.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
