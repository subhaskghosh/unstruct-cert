{"_id": "human_resources--hr_policies:_doc--n--68377", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"A comprehensive plan detailing stock option grants, vesting schedules, and associated legal requirements for executive-level employees.  Requires extensive review of SEC regulations.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68378", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flexible start/end times, designed to promote employee work-life balance and productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68378", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Expense Reimbursement Policy\",\n    \"policy_description\": \"Detailed guidelines and procedures for employee expense reimbursement, covering travel, meals, and other business-related expenses. Requires detailed receipts and pre-approval for all expenses above $100.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/expense-reimbursement.pdf\"\n}"}
