{"_id": "human_resources--hr_policies:_doc--n--62504", "text": "{\n    \"policy_id\": \"EMP-GEN-123\",\n    \"policy_title\": \"General Employee Conduct Guidelines\",\n    \"policy_description\": \"A comprehensive guide to acceptable workplace behavior, including dress code, communication etiquette, and conflict resolution procedures.  This document covers a wide range of topics to ensure a professional and respectful work environment. It details disciplinary actions, ethical considerations, and reporting mechanisms for violations of company standards. We strongly encourage all employees to review this document carefully.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-18\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/conduct_guidelines.pdf\"\n}"}
