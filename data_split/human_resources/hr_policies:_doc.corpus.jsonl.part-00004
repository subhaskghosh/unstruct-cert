{"_id": "human_resources--hr_policies:_doc--p--65543", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65543", "text": "{\n    \"policy_id\": \"EMP-TRAIN-002\",\n    \"policy_title\": \"Mandatory Cybersecurity Training\",\n    \"policy_description\": \"This policy details the requirements for annual cybersecurity training for all employees to protect company data.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Finance\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/cybersecurity-training.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65544", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the mental and emotional wellbeing of its employees. It includes access to counseling services, stress management resources, and promotes a healthy work-life balance. The goal is to foster a positive and inclusive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65544", "text": "{\n    \"policy_id\": \"LOA-2023-012\",\n    \"policy_title\": \"Extended Leave of Absence Procedures\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving extended leaves of absence for various reasons, including medical, family, and personal circumstances. It includes documentation requirements and eligibility criteria. It is a highly formal policy.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65545", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the resources available to employees seeking support for personal or work-related challenges. It covers confidential counseling services, work-life balance support, and crisis intervention.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65545", "text": "{\n    \"policy_id\": \"IT-2023-012\",\n    \"policy_title\": \"Data Security and Privacy\",\n    \"policy_description\": \"A comprehensive policy detailing data handling procedures, access controls, and security protocols for all company data.  This document is highly technical and covers all aspects of data protection, including legal compliance and incident response. It is a very lengthy and detailed document.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Security\",\n        \"Legal\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/data_security_policy.pdf\"\n}"}
