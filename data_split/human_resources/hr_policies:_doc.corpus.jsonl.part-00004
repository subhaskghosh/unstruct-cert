{"_id": "human_resources--hr_policies:_doc--p--71077", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing through a comprehensive wellness program. It covers gym memberships, mental health resources, and preventative health screenings. The program aims to promote a healthy work-life balance and reduce healthcare costs. Participation is encouraged for all employees.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71077", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This document details the company's Long-Term Disability (LTD) insurance plan, which provides income replacement in the event of an employee's inability to work due to a qualifying disability. It covers eligibility requirements, benefit levels, claim procedures, and coordination with other benefits. This is a legally mandated benefit and must be adhered to by all eligible employees.  Detailed information can be found in the full policy document. The LTD policy includes specifics about waiting periods, definitions of disability, and appeal processes, and various legal disclaimers.  It also covers coordination with Social Security and other disability benefits programs, ensuring compliance with federal and state regulations.  The policy undergoes annual review by legal counsel to maintain compliance. Further details can be found in the linked document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71078", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels, premiums, and enrollment procedures. Focuses on clear explanations for ease of understanding.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
