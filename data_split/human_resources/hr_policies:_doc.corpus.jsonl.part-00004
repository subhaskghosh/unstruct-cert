{"_id": "human_resources--hr_policies:_doc--p--61754", "text": "{\n    \"policy_id\": \"EC-2023-005\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines expected standards of behavior for all employees, including guidelines for professional communication, ethical conduct, and workplace interactions. It emphasizes maintaining a positive company image both internally and externally.  We aim for reasonable conduct expectations.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/ec-2023-005.pdf\"\n}"}
