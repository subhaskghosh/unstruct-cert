{"_id": "human_resources--hr_policies:_doc--n--64875", "text": "{\n    \"policy_id\": \"LGL-2022-005\",\n    \"policy_title\": \"Legal Compliance Regarding Data Privacy\",\n    \"policy_description\": \"A comprehensive legal document detailing the company's adherence to all data privacy regulations, including GDPR, CCPA, and HIPAA. It outlines employee responsibilities, data handling procedures, and potential liabilities.  Includes sections on data encryption, access controls, and incident response protocols. This policy is crucial for mitigating legal risks and maintaining customer trust.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy-policy\"\n}"}
