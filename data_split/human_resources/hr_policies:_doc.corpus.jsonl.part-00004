{"_id": "human_resources--hr_policies:_doc--p--64952", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels, premiums, and enrollment procedures. This policy provides comprehensive medical, dental, and vision care.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64952", "text": "{\n    \"policy_id\": \"EMP-GEN-005\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"Outlines the guidelines and procedures for employees requesting and obtaining approval for remote work arrangements. Covers eligibility, expectations, and security protocols. This is a very detailed, 20-page document.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64953", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various programs, including mental health resources, fitness benefits, and work-life balance initiatives.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Research\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-eng\"\n}"}
