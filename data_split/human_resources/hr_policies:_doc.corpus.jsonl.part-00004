{"_id": "human_resources--hr_policies:_doc--p--65812", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee wellbeing, including access to gym memberships, health screenings, and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65812", "text": "{\n    \"policy_id\": \"EMP-LV-002\",\n    \"policy_title\": \"Employee Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and taking various types of leave, including vacation, sick leave, and personal leave.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65813", "text": "{\n    \"policy_id\": \"WELLB-2024-003\",\n    \"policy_title\": \"Employee Mental Health and Support\",\n    \"policy_description\": \"This policy outlines resources and procedures for employees experiencing mental health challenges, emphasizing a supportive work environment and access to confidential counseling services. It promotes work-life balance and reduces workplace stress.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/mental-health-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65813", "text": "{\n    \"policy_id\": \"SAFE-2023-001\",\n    \"policy_title\": \"Workplace Emergency Evacuation Procedures\",\n    \"policy_description\": \"This policy details procedures for safely evacuating the workplace during emergencies such as fires, natural disasters, and security threats. It includes designated evacuation routes and assembly points.\",\n    \"effective_date\": \"2023-11-20\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/evacuation-procedure.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65814", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Health Benefits\",\n    \"policy_description\": \"This policy details the health, dental, and vision benefits available to all eligible employees. It includes information on coverage levels, premium contributions, and claim procedures. This policy aims to provide comprehensive coverage and support employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65814", "text": "{\n    \"policy_id\": \"TRAV-EXP-001\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"Guidelines for employees regarding travel arrangements and expense reporting. This includes permissible expenses, approval processes, and reimbursement timelines. The goal is to ensure responsible spending and accurate record-keeping.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense.pdf\"\n}"}
