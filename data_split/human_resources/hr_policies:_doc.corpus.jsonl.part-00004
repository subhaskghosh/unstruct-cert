{"_id": "human_resources--hr_policies:_doc--p--70158", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to employees, including health insurance, retirement plans, and wellness programs. It also provides resources for managing work-life balance and promoting employee well-being.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-005.pdf\"\n}"}
