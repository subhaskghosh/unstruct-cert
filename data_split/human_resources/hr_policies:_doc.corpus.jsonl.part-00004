{"_id": "human_resources--hr_policies:_doc--p--71127", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Remote Work Benefit Policy\",\n    \"policy_description\": \"This policy outlines the benefits available to employees approved for remote work arrangements, including home office stipends and internet reimbursement. It aims to support employee well-being and productivity while working remotely.  The eligibility criteria and procedures for claiming these benefits are detailed below.\",\n    \"effective_date\": \"2023-05-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71127", "text": "{\n    \"policy_id\": \"EMP-TRAIN-001\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the company's commitment to leadership development and outlines the various training programs available to employees.  It covers eligibility requirements, application processes, and program expectations. The aim is to foster strong leadership skills across all levels of the organization, enabling sustainable growth and improved employee performance through continuous skill enhancement. We want to develop high-potential employees through mentorship and opportunities to assume new roles with increased responsibilities. This comprehensive program will drive innovation and build a robust leadership pipeline.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leadership-program.pdf\"\n}"}
