{"_id": "human_resources--hr_policies:_doc--p--71808", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Benefits Program\",\n    \"policy_description\": \"This policy outlines the company's flexible benefits program, allowing employees to choose from a range of health, dental, vision, and retirement plans. It also details procedures for enrollment and changes to benefits selections. Supports remote work and flexible schedules.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/flexible-benefits-program.pdf\"\n}"}
