{"_id": "human_resources--hr_policies:_doc--p--70481", "text": "{\n    \"policy_id\": \"EMP-BEN-2023-001\",\n    \"policy_title\": \"Employee 401k Contribution Policy\",\n    \"policy_description\": \"This policy outlines the details of the company's 401k plan, including eligibility, contribution limits, and vesting schedules. It aims to promote employee financial wellbeing.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
