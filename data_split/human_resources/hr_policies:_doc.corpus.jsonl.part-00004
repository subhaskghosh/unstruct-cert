{"_id": "human_resources--hr_policies:_doc--p--61831", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential support for personal and work-related issues. The EAP offers counseling, resources, and referrals for a variety of challenges, including stress, anxiety, and financial difficulties.\",\n    \"effective_date\": \"2022-07-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
