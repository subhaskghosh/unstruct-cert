{"_id": "human_resources--hr_policies:_doc--p--67152", "text": "{\n    \"policy_id\": \"WB-2023-101\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the resources available to employees seeking support for personal or work-related challenges. It covers counseling services, mental health resources, and financial assistance programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67152", "text": "{\n    \"policy_id\": \"TR-2022-050\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Details the process for employees to submit and receive reimbursement for business travel expenses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67153", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee work-life balance through flexible work arrangements, including remote work options, flexible hours, and parental leave. It aims to promote employee well-being and reduce stress.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67153", "text": "{\n    \"policy_id\": \"TR-2022-012\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for travel and business-related expenses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67154", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees and their families.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67154", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Company Vehicle Usage\",\n    \"policy_description\": \"Comprehensive guidelines for employees authorized to use company vehicles, covering maintenance, insurance, and permitted use cases.  This document includes detailed stipulations regarding personal use, accident reporting, and fuel reimbursement procedures, as well as legal disclaimers.  It also addresses specific situations regarding out-of-state travel and vehicle modifications.  Furthermore, the policy outlines the process for requesting vehicle access and the consequences of policy violations. Appendices include a list of approved drivers and a vehicle maintenance log template. This has been reviewed by legal counsel and the fleet management department.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/company-vehicle-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67155", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the benefits available to employees to promote physical and mental well-being, including gym memberships, mental health resources, and wellness programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-policy\"\n}"}
