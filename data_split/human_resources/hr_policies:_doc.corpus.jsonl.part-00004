{"_id": "human_resources--hr_policies:_doc--p--64043", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial planning. It promotes a supportive work environment and encourages employees to prioritize their health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64043", "text": "{\n    \"policy_id\": \"ATT-002\",\n    \"policy_title\": \"Attendance and Punctuality\",\n    \"policy_description\": \"This policy details the company's expectations regarding employee attendance, punctuality, and procedures for reporting absences. Strict penalties apply for repeated tardiness or unexcused absences.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance_policy.pdf\"\n}"}
