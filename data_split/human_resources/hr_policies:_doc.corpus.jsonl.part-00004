{"_id": "human_resources--hr_policies:_doc--n--67118", "text": "{\n    \"policy_id\": \"EMP-PROC-005\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"This policy details the annual performance review process, including goal setting, feedback sessions, and performance ratings. It covers all aspects of performance management, from initial planning to final evaluation, and emphasizes a continuous feedback loop to foster employee growth and development. Detailed guidelines are provided for both managers and employees to ensure fairness and transparency throughout the process. It also includes information on performance improvement plans and disciplinary actions if needed.\",\n    \"effective_date\": \"2023-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-process\"\n}"}
