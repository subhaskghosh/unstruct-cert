{"_id": "human_resources--hr_policies:_doc--p--62832", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the full range of benefits available to employees, including health insurance, paid time off, parental leave, and wellness programs. This policy aims to attract and retain top talent by offering a competitive and supportive benefits package.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/employee-benefits-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62832", "text": "{\n    \"policy_id\": \"EMP-STO-001\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"Outlines the terms and conditions of the company's employee stock option plan, including eligibility, vesting schedule, and exercise procedures. This policy provides employees with an opportunity to share in the company's success.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options/employee-stock-option-plan.pdf\"\n}"}
