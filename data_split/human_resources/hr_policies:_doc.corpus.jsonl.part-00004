{"_id": "human_resources--hr_policies:_doc--p--62564", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing. It provides access to resources such as gym memberships, mental health support, and wellness workshops. The goal is to promote a healthy and productive workforce.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62564", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance plan offered to all eligible employees. It includes coverage for medical, dental, and vision care, as well as prescription drugs. The plan is administered by a third-party provider and offers a variety of options to meet the diverse needs of our employees. This document provides complete details regarding eligibility, enrollment procedures, coverage levels, claim submission processes, and cost-sharing responsibilities. Detailed information regarding pre-authorization requirements, out-of-network coverage, and appeals processes are included. Further guidance is available on the intranet.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
