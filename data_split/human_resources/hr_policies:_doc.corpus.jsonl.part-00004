{"_id": "human_resources--hr_policies:_doc--p--68637", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the resources available to employees facing personal or work-related challenges, including counseling services, legal advice, and financial guidance. It aims to support employee wellbeing and resilience.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
