{"_id": "human_resources--hr_policies:_doc--n--67791", "text": "{\n    \"policy_id\": \"EMP-ETH-002\",\n    \"policy_title\": \"Ethics and Conduct\",\n    \"policy_description\": \"Outlines the expected ethical behavior and professional conduct for all employees. Comprehensive document including conflict of interest, confidentiality, and compliance guidelines.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/ethics_conduct.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67792", "text": "{\n    \"policy_id\": \"EMP-COND-001\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines the expected standards of behavior for all employees. It covers areas such as professional conduct, ethical considerations, and conflict of interest. All employees are expected to adhere to these guidelines to maintain a respectful and productive work environment.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-conduct-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67792", "text": "{\n    \"policy_id\": \"REM-COMP-005\",\n    \"policy_title\": \"Remote Work Compensation Guidelines\",\n    \"policy_description\": \"These guidelines detail the compensation adjustments for employees working remotely. This includes considerations for cost of living, performance metrics, and adjustments to salary based on geographic location. It addresses the complex interplay between remote work, performance management, and equitable compensation practices.  This policy includes details on tax implications, equipment stipends, and eligibility criteria for remote work arrangements.  Furthermore, it covers detailed expense reimbursement procedures and security protocols for remote workers.  The policy also includes a section on performance reviews adapted for remote teams, as well as guidelines for maintaining work-life balance while working remotely.  The complete and exhaustive details can be found in the attached document.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67793", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy details the comprehensive employee benefits program, including health insurance, paid time off, and wellness initiatives to promote employee well-being. It covers medical, dental, vision, and mental health support.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67793", "text": "{\n    \"policy_id\": \"LA-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and taking leaves of absence, including medical leave, parental leave, and personal leave. It details eligibility requirements and associated documentation.\",\n    \"effective_date\": \"2022-09-10\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67794", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources and support for physical, mental, and financial health. It includes details on gym reimbursements, mental health counseling, and financial planning workshops. We believe a healthy employee is a happy and productive employee.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67794", "text": "{\n    \"policy_id\": \"BP-2022-010\",\n    \"policy_title\": \"Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for submitting and receiving reimbursements for business-related expenses.  Strict adherence to outlined guidelines and pre-approval requirements is mandatory. All requests are subject to audit and may be denied if documentation is insufficient or non-compliant. Any deviation from this policy will result in disciplinary action.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67795", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides eligible employees with 12 weeks of paid parental leave following the birth or adoption of a child. It aims to support work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental_leave_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67795", "text": "{\n    \"policy_id\": \"BP-2022-010\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to request reimbursement for travel expenses incurred while on company business.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel_reimbursement.pdf\"\n}"}
