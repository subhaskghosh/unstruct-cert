{"_id": "human_resources--hr_policies:_doc--p--62295", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the complete employee benefits package, including medical, dental, vision, life insurance, disability coverage, and wellness programs. It outlines eligibility requirements, enrollment procedures, and coverage details. It aims to provide employees with a holistic approach to wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
