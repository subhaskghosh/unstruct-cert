{"_id": "human_resources--hr_policies:_doc--n--62045", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Retirement Plan Summary\",\n    \"policy_description\": \"A comprehensive overview of the company's 401(k) retirement plan, including eligibility, contribution limits, investment options, vesting schedules, and withdrawal procedures. This document provides detailed guidance for employees planning for their financial future, covering various aspects of retirement savings and investment strategies to maximize returns and ensure a comfortable retirement.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62046", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to employees, including health insurance, dental, vision, life insurance, paid time off, sick leave, and wellness programs. It emphasizes employee well-being and provides resources for a healthy work-life balance.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits-package.pdf\"\n}"}
