{"_id": "human_resources--hr_policies:_doc--p--61910", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy outlines the guidelines and expectations for employees working remotely, focusing on maintaining productivity, communication, and work-life balance. It encourages flexible work arrangements to support employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61910", "text": "{\n    \"policy_id\": \"PM-2023-002\",\n    \"policy_title\": \"Performance Improvement Plan\",\n    \"policy_description\": \"This policy details the process for addressing employee performance issues, including documentation, feedback, and potential disciplinary actions.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-improvement-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61911", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to employees. It covers medical, dental, and vision care. Eligibility requires full-time employment. Details regarding plan options and enrollment can be found in the linked document.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61911", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, including 401(k) contributions, pension options, and investment strategies. It covers eligibility criteria, vesting schedules, and withdrawal procedures. Employees are encouraged to attend informational sessions to maximize their retirement savings. This document contains detailed regulations and legal considerations, making it a complex resource for employees to navigate. It also includes information about specific tax implications. Further details regarding financial advisors available can be found in the linked document.\",\n    \"effective_date\": \"2021-11-01\",\n    \"last_updated\": \"2023-04-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61912", "text": "{\n    \"policy_id\": \"POL-2023-005\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees working remotely, ensuring productivity and maintaining work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
