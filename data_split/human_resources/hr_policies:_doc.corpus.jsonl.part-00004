{"_id": "human_resources--hr_policies:_doc--n--71821", "text": "{\n    \"policy_id\": \"TRA-0005\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Details the process for employees to be reimbursed for business travel expenses, including allowable costs and required documentation.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71822", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete range of benefits available to all full-time employees, including health insurance, retirement plans, paid time off, and professional development opportunities.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/eb-2023-001.pdf\"\n}"}
