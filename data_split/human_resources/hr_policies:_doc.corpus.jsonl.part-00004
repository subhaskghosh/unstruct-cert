{"_id": "human_resources--hr_policies:_doc--n--65759", "text": "{\n    \"policy_id\": \"CMPL-005\",\n    \"policy_title\": \"Complex Leave of Absence Policy\",\n    \"policy_description\": \"A comprehensive guide detailing all types of leave of absence, including FMLA, parental leave, and personal leave, with detailed eligibility requirements and procedures. This policy is 25 pages long.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65760", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for mental health, physical fitness, and stress management. It aims to create a supportive work environment and promote work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65760", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Annual Bonus Structure\",\n    \"policy_description\": \"Details the annual bonus eligibility criteria, calculation methodology, and payout schedule for eligible employees. Based on individual and company performance.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/bonus-structure\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65761", "text": "{\n    \"policy_id\": \"WELLBEING-003\",\n    \"policy_title\": \"Employee Mental Health Support\",\n    \"policy_description\": \"This policy outlines the resources available to employees for mental health support, including counseling services and stress management programs. It aims to foster a supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Research and Development\",\n        \"Innovation Labs\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/mentalhealth.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65761", "text": "{\n    \"policy_id\": \"DISCIP-001\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and disciplinary actions. It covers warnings, suspensions, and termination.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary.pdf\"\n}"}
