{"_id": "human_resources--hr_policies:_doc--p--71715", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision.  Employees must enroll within 30 days of hire. Details on plan options and costs are available on the HR portal. This policy is designed to provide employees with access to quality healthcare.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71715", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the company's Leadership Development Program, aimed at fostering growth and advancement opportunities for high-potential employees. The program includes mentorship, workshops, and executive coaching. Participation is by invitation only, based on performance reviews and manager recommendations. This program is designed to build a pipeline of future leaders within the organization and is a significant investment in our workforce. It also covers conflict resolution and emotional intelligence training.\",\n    \"effective_date\": \"2023-06-15\",\n    \"last_updated\": \"2024-06-20\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"HR\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
