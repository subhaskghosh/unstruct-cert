{"_id": "human_resources--hr_policies:_doc--p--67527", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can find more details in the benefits portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67527", "text": "{\n    \"policy_id\": \"LVP-2024-002\",\n    \"policy_title\": \"Long-Term Vacation Policy\",\n    \"policy_description\": \"This comprehensive policy details the guidelines and procedures for requesting and approving long-term vacations, including considerations for project coverage, handover documentation, and maintaining team productivity.  It applies to all full-time employees with more than five years of service. Specific approval criteria are outlined based on department and role, with additional stipulations for senior management. Detailed procedures for submitting requests, required documentation, and escalation paths are included. The policy also addresses scenarios involving unforeseen circumstances and changes to vacation plans. It also covers eligibility for sabbatical leaves, defining requirements and application procedures. This policy aims to provide clarity and fairness in managing extended employee absences while ensuring minimal disruption to business operations. Further details on calculation of accrual rates can be found in appendix A. A full list of FAQs can be found in appendix B. Contact HR for further clarification.\",\n    \"effective_date\": \"2024-03-01\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-vacation-policy\"\n}"}
