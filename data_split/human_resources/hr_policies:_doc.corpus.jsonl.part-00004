{"_id": "human_resources--hr_policies:_doc--p--71142", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, life insurance, 401k matching, and paid time off. It also details wellness programs and employee assistance resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71142", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Basic Health Insurance Policy\",\n    \"policy_description\": \"This policy details the basic health insurance coverage available to employees. It outlines eligibility requirements, plan options, and cost-sharing details.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/emp-ben-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71143", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines our commitment to employee health and wellbeing, offering gym discounts and wellness workshops. It's designed to be easy to understand and participate in!\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71143", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the comprehensive health insurance plan offered to eligible employees, outlining coverage levels, premiums, and claim procedures. Adherence to all clauses is mandatory. This is a legally binding document and should be reviewed carefully.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71144", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and adjusted work schedules, to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71144", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive health insurance plan, including coverage options, eligibility requirements, and claim procedures. It covers medical, dental, vision, and prescription drug benefits, with detailed sections on pre-existing conditions, out-of-network care, and dependent coverage.  The policy also outlines the appeals process for denied claims and the responsibilities of both employees and the insurance provider. This is a very lengthy and detailed document covering a broad range of scenarios.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71145", "text": "{\n    \"policy_id\": \"HB-2023-007\",\n    \"policy_title\": \"Health and Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees, including medical, dental, and vision coverage, as well as wellness program access. It promotes employee well-being and preventative care.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/hb-2023-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71145", "text": "{\n    \"policy_id\": \"HB-2022-001\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy details all employee benefits, including health, dental, vision, life insurance, and retirement savings plans. It covers eligibility, enrollment procedures, and contribution details.  Employees are encouraged to actively participate in their retirement planning.\",\n    \"effective_date\": \"2022-10-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/hb-2022-001.pdf\"\n}"}
