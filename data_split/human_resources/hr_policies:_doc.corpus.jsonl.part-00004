{"_id": "human_resources--hr_policies:_doc--p--64351", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, and paid time off. It aims to provide employees with financial security and well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
