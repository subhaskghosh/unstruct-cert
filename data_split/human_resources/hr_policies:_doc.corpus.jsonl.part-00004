{"_id": "human_resources--hr_policies:_doc--n--68339", "text": "{\n    \"policy_id\": \"TRV-2024-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Outlines the procedures for employees to submit and be reimbursed for travel expenses incurred during business trips.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68340", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, covering medical, dental, and vision insurance. It details eligibility, coverage levels, and access to wellness resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68340", "text": "{\n    \"policy_id\": \"RET-PLAN-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k retirement plan, including contribution limits, investment options, and vesting schedules. It includes details on the actuarial calculations used to determine benefit payouts.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k-retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68341", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Sick Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and utilizing sick leave benefits for all eligible employees. It details the accrual rates, usage guidelines, and documentation requirements.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68341", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Employee Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k plan, including eligibility, contribution limits, and investment options.\",\n    \"effective_date\": \"2018-06-01\",\n    \"last_updated\": \"2021-05-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68342", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, retirement plans, and paid time off. It aims to attract and retain top talent by providing a competitive and supportive benefits program.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68342", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Basic Health Insurance Policy\",\n    \"policy_description\": \"This policy details the basic health insurance coverage offered to employees. It provides essential medical care but has limited coverage compared to the comprehensive plan.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2022-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/basic-health-insurance\"\n}"}
