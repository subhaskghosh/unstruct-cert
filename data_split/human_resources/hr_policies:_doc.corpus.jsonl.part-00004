{"_id": "human_resources--hr_policies:_doc--p--70430", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees requesting flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support work-life balance and employee well-being.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work.pdf\"\n}"}
