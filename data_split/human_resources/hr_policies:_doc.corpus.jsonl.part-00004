{"_id": "human_resources--hr_policies:_doc--n--62471", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Health Insurance Plan Details\",\n    \"policy_description\": \"A comprehensive explanation of the company's health insurance plans, including coverage levels, provider networks, and enrollment procedures. This document is 50 pages long and covers all facets of the health insurance program in detail, covering everything from deductibles to co-pays and beyond.  It also covers dependent care options and wellness programs.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62472", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"Details the company's employee wellness benefits, including gym memberships, mental health resources, and health insurance options.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62472", "text": "{\n    \"policy_id\": \"DISC-0015\",\n    \"policy_title\": \"Employee Disciplinary Action\",\n    \"policy_description\": \"Outlines the procedures for addressing employee misconduct and disciplinary actions.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-actions.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62473", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work and adjusted schedules, to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62473", "text": "{\n    \"policy_id\": \"COMP-0005\",\n    \"policy_title\": \"Comprehensive Compensation and Benefits Review\",\n    \"policy_description\": \"A detailed document outlining the entire compensation and benefits structure, including salary bands, performance bonuses, health insurance plans, retirement contributions, stock options, and other perks. This document is designed to provide a complete overview for all employees and is reviewed annually. It details all legal requirements and internal protocols.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/comp-benefits-review\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62474", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding health, dental, and vision insurance options for employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62474", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Comprehensive details about the company's 401k retirement savings plan, including eligibility, contribution limits, investment options, vesting schedule, loan provisions, and distribution rules.  This plan is designed to help employees save for their future retirement needs and provides valuable financial security. It includes information on employer matching contributions and the process for enrolling in the plan. Also outlines the requirements for beneficiaries and the procedures for making changes to investment allocations. This policy is subject to change based on regulatory updates and company performance.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62475", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including access to gym memberships, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
