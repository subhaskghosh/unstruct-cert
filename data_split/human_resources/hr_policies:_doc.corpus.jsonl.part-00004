{"_id": "human_resources--hr_policies:_doc--p--67651", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.  Employees can enroll during the annual open enrollment period or upon experiencing a qualifying life event.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67651", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy provides income replacement benefits to employees who are unable to work due to a qualifying disability.  The policy details eligibility criteria, benefit levels, waiting periods, and the claims process. It also outlines the responsibilities of the employee and the employer in the event of a disability claim. This policy requires a comprehensive understanding of legal and financial implications.  Detailed descriptions of all riders, exclusions, and the appeals process are included.  We provide resources to help employees understand this complex benefit. Further details are available in the attached appendices and frequently asked questions document. The total document length is over 500 words.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67652", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to mental health resources, fitness benefits, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67652", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including eligibility, contribution limits, and investment options.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
