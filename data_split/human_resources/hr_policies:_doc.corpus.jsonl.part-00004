{"_id": "human_resources--hr_policies:_doc--p--65411", "text": "{\n    \"policy_id\": \"WB-2024-005\",\n    \"policy_title\": \"Employee Wellness and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the resources and support available to employees to promote their overall well-being, including mental health, physical health, and work-life balance. It provides access to counseling services, wellness programs, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy-2024\"\n}"}
