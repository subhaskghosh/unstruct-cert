{"_id": "human_resources--hr_policies:_doc--p--67120", "text": "{\n    \"policy_id\": \"EB-2024-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can enroll during the annual open enrollment period or upon a qualifying life event.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67120", "text": "{\n    \"policy_id\": \"LTO-2023-005\",\n    \"policy_title\": \"Long-Term Overtime Policy\",\n    \"policy_description\": \"This comprehensive document details the procedures for approving and managing long-term overtime for employees. It addresses compensation rates, employee well-being considerations, and departmental budget impacts. This policy is intended to ensure compliance with labor laws and promote responsible workforce management. Detailed guidelines on documentation, approval hierarchies, and exception handling are included.  The policy includes procedures for managers, employees, and HR personnel. It also outlines the process for reviewing overtime requests and ensuring that overtime is used efficiently and effectively.  Additional information on fatigue management and work-life balance is also provided.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-overtime\"\n}"}
