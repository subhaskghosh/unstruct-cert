{"_id": "human_resources--hr_policies:_doc--n--71517", "text": "{\n    \"policy_id\": \"LE-2022-010\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details the procedures for requesting and taking various types of leave, including medical leave, parental leave, and personal leave. It's a comprehensive document covering all legal requirements and internal processes related to time off.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71518", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program Guidelines\",\n    \"policy_description\": \"Details the Employee Assistance Program (EAP) available to all employees, including counseling services and resources for managing stress and personal challenges.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2022-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_guidelines.pdf\"\n}"}
