{"_id": "human_resources--hr_policies:_doc--p--62418", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to gym memberships, mental health resources, and wellness workshops. It promotes a healthy work-life balance and supports employee physical and mental health.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
