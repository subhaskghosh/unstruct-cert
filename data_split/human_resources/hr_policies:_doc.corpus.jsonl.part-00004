{"_id": "human_resources--hr_policies:_doc--p--71073", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details all employee benefits, including health insurance, retirement plans, paid time off, and wellness programs. It outlines eligibility requirements, enrollment procedures, and plan details. It also explains how benefit information is communicated to employees via annual open enrollment meetings and online resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71073", "text": "{\n    \"policy_id\": \"LV-REQ-005\",\n    \"policy_title\": \"Simple Leave Request Process\",\n    \"policy_description\": \"This policy outlines the procedure for requesting vacation or sick leave. Employees submit requests through the HR portal, and managers approve or deny based on operational needs.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_request_procedure.docx\"\n}"}
