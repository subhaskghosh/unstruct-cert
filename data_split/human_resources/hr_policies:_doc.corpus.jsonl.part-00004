{"_id": "human_resources--hr_policies:_doc--n--64186", "text": "{\n    \"policy_id\": \"EMP-DEV-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program for developing future leaders within the organization. This document details eligibility criteria, program structure, assessment methods, and expected outcomes. It includes information on mentorship opportunities, executive coaching, and specialized training modules. This program is a multi-year commitment.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-development-program\"\n}"}
