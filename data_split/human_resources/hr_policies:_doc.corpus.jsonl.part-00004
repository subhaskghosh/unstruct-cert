{"_id": "human_resources--hr_policies:_doc--n--71937", "text": "{\n    \"policy_id\": \"LC-2023-012\",\n    \"policy_title\": \"Data Privacy and Compliance\",\n    \"policy_description\": \"This policy details the company's procedures for handling employee data in compliance with GDPR, CCPA, and other relevant regulations. It includes specific requirements for data encryption, access controls, and incident reporting.  The document is technically detailed and targeted toward legal and IT personnel.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"IT\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy\"\n}"}
