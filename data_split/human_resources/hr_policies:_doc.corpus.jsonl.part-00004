{"_id": "human_resources--hr_policies:_doc--p--71617", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for mental and physical health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71617", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"Detailed coverage guidelines for long-term disability benefits, including eligibility criteria and claim procedures. Contains extensive legal clauses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71618", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to providing employees with a comprehensive suite of health and wellness benefits, including medical, dental, vision, and mental health support. It promotes a healthy work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71618", "text": "{\n    \"policy_id\": \"RET-PLAN-001\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"This policy details the company's 401k retirement savings plan, including eligibility, contribution limits, and investment options. It aims to help employees save for their future financial security.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71619", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness benefits, and healthy lifestyle programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71619", "text": "{\n    \"policy_id\": \"LOA-2022-001\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed procedures for requesting and taking various types of leave, including medical, personal, and bereavement leave. Covers compliance with relevant federal and state laws.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
