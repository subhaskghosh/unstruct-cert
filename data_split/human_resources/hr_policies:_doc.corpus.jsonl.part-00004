{"_id": "human_resources--hr_policies:_doc--n--71178", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Details the process for granting stock options to executive-level employees as part of their compensation package.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71179", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential counseling and support services to employees facing personal or work-related challenges. It covers a range of issues including stress, anxiety, and financial difficulties.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-07-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71179", "text": "{\n    \"policy_id\": \"RET-PLAN-005\",\n    \"policy_title\": \"401k Contribution Matching\",\n    \"policy_description\": \"Details regarding the company's 401k plan and contribution matching program. This policy helps employees save for their retirement.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71180", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"Details the company's health insurance plan for employees, including coverage options and enrollment procedures. This policy is designed to be simple and straightforward.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71180", "text": "{\n    \"policy_id\": \"TERM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"Outlines the process for employee termination, including notice periods, severance packages, and exit interviews. A detailed and legally sensitive document.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination/procedures\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71181", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for physical and mental health. Includes gym membership discounts and access to mindfulness apps.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71181", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"A detailed explanation of the company's health insurance coverage, including deductibles, co-pays, and out-of-pocket maximums. It covers medical, dental, and vision care. This plan includes provisions for pre-existing conditions, prescription drug coverage, and mental health services. It also outlines the process for filing claims and appealing denials. The policy details network providers, emergency care procedures, and international coverage options.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71182", "text": "{\n    \"policy_id\": \"WELLBEING-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support and resources for employees facing personal or work-related challenges. It aims to promote employee well-being and mental health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71182", "text": "{\n    \"policy_id\": \"DISCIP-003\",\n    \"policy_title\": \"Performance Improvement Plan (PIP)\",\n    \"policy_description\": \"This policy details the process for implementing a Performance Improvement Plan for employees who are not meeting performance expectations. It includes steps for documentation, feedback, and potential disciplinary action.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pip-policy\"\n}"}
