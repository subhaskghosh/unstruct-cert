{"_id": "human_resources--hr_policies:_doc--p--68542", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee 401k and Retirement Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401k plan, including eligibility, contribution matching, vesting schedule, and loan options. It is designed to help employees save for retirement and achieve financial security.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68542", "text": "{\n    \"policy_id\": \"LVE-2022-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details procedures relating to employee requests for leave of absence, including medical leave, personal leave, and bereavement leave. It is based on all current federal and state regulations, and is subject to change based on legal updates.  Detailed legal citations included.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
