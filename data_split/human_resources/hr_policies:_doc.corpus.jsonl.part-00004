{"_id": "human_resources--hr_policies:_doc--p--65348", "text": "{\n    \"policy_id\": \"BNF-2024-003\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness and benefits programs available to all eligible employees, including health insurance, retirement plans, and paid time off. It emphasizes employee well-being and financial security.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-07-15\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_program_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65348", "text": "{\n    \"policy_id\": \"EXC-CMP-2023-001\",\n    \"policy_title\": \"Executive Compensation and Incentive Plan\",\n    \"policy_description\": \"This policy details the compensation structure, bonus eligibility, and equity grants for executive-level employees. It aims to attract and retain top talent within the leadership team.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive_compensation.pdf\"\n}"}
