{"_id": "human_resources--hr_policies:_doc--n--65349", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for authorized travel expenses.  Strict adherence to budget limits is required.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65350", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Financial Assistance Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to providing financial assistance and resources to employees facing unforeseen financial difficulties due to personal hardship. This includes access to low-interest loans, financial counseling, and emergency grants.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial_assistance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65350", "text": "{\n    \"policy_id\": \"EMP-LV-003\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy details the provisions for paid time off granted to employees following the death of an immediate family member.  It includes guidelines for eligibility, notification procedures, and duration of leave.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/bereavement_leave.pdf\"\n}"}
