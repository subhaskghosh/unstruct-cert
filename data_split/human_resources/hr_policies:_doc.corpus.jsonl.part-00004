{"_id": "human_resources--hr_policies:_doc--p--61901", "text": "{\n    \"policy_id\": \"EC-2023-001\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines expected standards of behavior for all employees, emphasizing professionalism, respect, and ethical conduct. It promotes a positive work environment and addresses potential conflicts of interest.  The policy focuses on guidance and support, rather than purely punitive measures.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/ecoc.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61901", "text": "{\n    \"policy_id\": \"EC-2022-002\",\n    \"policy_title\": \"Strict Disciplinary Guidelines\",\n    \"policy_description\": \"This policy details severe consequences for any violation of company rules, including immediate termination. It provides a list of prohibited actions and a strict enforcement procedure. The policy focuses solely on disciplinary actions with little regard for context.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61902", "text": "{\n    \"policy_id\": \"PTO-2023-ENG-SALES\",\n    \"policy_title\": \"Paid Time Off Policy - Engineering & Sales\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off for employees in the Engineering and Sales departments. It aims to support work-life balance and employee wellbeing.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-eng-sales-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61902", "text": "{\n    \"policy_id\": \"BEREAV-2023-ALL\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy provides guidelines and support for employees experiencing the loss of a family member. It details the amount of paid leave available and related procedures.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave-2023\"\n}"}
