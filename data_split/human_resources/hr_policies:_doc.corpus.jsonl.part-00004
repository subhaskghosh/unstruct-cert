{"_id": "human_resources--hr_policies:_doc--n--71697", "text": "{\n    \"policy_id\": \"EMP-RET-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details of the company's 401k retirement savings plan, including contribution matching and vesting schedules.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71698", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering comprehensive medical, dental, and vision coverage. It also includes provisions for mental health support and wellness programs.  We are committed to providing a holistic approach to employee health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71698", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Traditional Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k plan, including eligibility requirements, contribution limits, and vesting schedules. It aligns with standard industry practices for retirement savings.  It provides a pathway for employees to plan for long-term financial security.  Detailed information on fund options is included.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/retirement-plan\"\n}"}
