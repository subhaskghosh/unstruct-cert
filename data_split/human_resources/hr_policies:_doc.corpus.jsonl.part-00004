{"_id": "human_resources--hr_policies:_doc--p--62197", "text": "{\n    \"policy_id\": \"EMP-BEN-2023-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, dental, vision, life insurance, and retirement plans. It details eligibility requirements, enrollment procedures, and plan options.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits-package.pdf\"\n}"}
