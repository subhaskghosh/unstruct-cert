{"_id": "human_resources--hr_policies:_doc--p--67998", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"Details the health insurance, wellness programs, and employee assistance programs available to all eligible employees. This policy promotes employee well-being and work-life balance through access to comprehensive healthcare resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001\"\n}"}
