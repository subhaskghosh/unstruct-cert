{"_id": "human_resources--hr_policies:_doc--n--68008", "text": "{\n    \"policy_id\": \"TERM-0005\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"This policy details the procedures for terminating an employee's employment, including documentation requirements, exit interviews, and final paychecks. Extensive details are provided.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination_procedure.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68009", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee health and well-being, outlining resources and programs available to support a healthy lifestyle. It covers gym memberships, mental health support, and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68009", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment Procedures\",\n    \"policy_description\": \"This policy outlines the detailed procedures for employees to enroll in company-sponsored health insurance plans, including eligibility requirements, enrollment deadlines, and required documentation. It also details the appeals process for denied claims.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-enrollment.pdf\"\n}"}
