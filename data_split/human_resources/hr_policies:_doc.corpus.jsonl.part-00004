{"_id": "human_resources--hr_policies:_doc--n--68303", "text": "{\n    \"policy_id\": \"PERF-BON-002\",\n    \"policy_title\": \"Performance-Based Bonus and Benefits\",\n    \"policy_description\": \"Details the bonus structure tied to performance reviews and eligibility for enhanced benefits based on performance metrics. This policy outlines the procedures for annual bonus allocation and eligibility requirements.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-bonus-policy\"\n}"}
