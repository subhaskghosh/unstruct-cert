{"_id": "human_resources--hr_policies:_doc--n--65300", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A comprehensive plan detailing compensation for executive-level employees, including base salary, bonus structures, stock options, and long-term incentive plans. Requires a legal review for interpretation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive_compensation.pdf\"\n}"}
