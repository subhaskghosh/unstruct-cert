{"_id": "human_resources--hr_policies:_doc--n--71168", "text": "{\n    \"policy_id\": \"BEN-HOS-202212\",\n    \"policy_title\": \"Health Insurance Enrollment - Comprehensive Details\",\n    \"policy_description\": \"This document provides comprehensive information on health insurance enrollment, including plan options, eligibility requirements, coverage details, and claim procedures. It details specific coverages for various medical conditions, prescription drugs, and preventative care services. It outlines the process for adding dependents and updating beneficiary information. Also explains COBRA and other related regulations. It is a very lengthy document covering all aspects of our Health Insurance plan.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71169", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding enrollment, coverage levels, and provider networks are provided in the attached document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71169", "text": "{\n    \"policy_id\": \"ETH-0005\",\n    \"policy_title\": \"Ethics and Conduct\",\n    \"policy_description\": \"This policy details the ethical standards and expected conduct for all employees. It includes guidelines on conflicts of interest, confidentiality, and professional behavior. A comprehensive review is required annually, and violations will result in disciplinary action. This policy is foundational to our company culture and commitment to integrity and responsible business practices. Further details on reporting mechanisms and specific ethical scenarios are available in the full document. It addresses many areas regarding fair treatment.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/ethics-policy\"\n}"}
