{"_id": "human_resources--hr_policies:_doc--p--65314", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the complete range of benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It outlines eligibility requirements, enrollment procedures, and plan details for each benefit. This policy is designed to attract and retain top talent by providing competitive and comprehensive benefits.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Legal\",\n        \"Research and Development\",\n        \"Data Security\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-benefits-package.pdf\"\n}"}
