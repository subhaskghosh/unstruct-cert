{"_id": "human_resources--hr_policies:_doc--n--68149", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A comprehensive plan detailing compensation packages for executive level personnel, including stock options, bonuses, and benefits eligibility. This policy is subject to legal review and frequent amendments.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-01-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/executive_compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68150", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including mental health resources, physical health initiatives, and work-life balance support. It details access to counseling services, gym memberships, and flexible work arrangements.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68150", "text": "{\n    \"policy_id\": \"WB-002\",\n    \"policy_title\": \"Ergonomic Assessment Guidelines\",\n    \"policy_description\": \"Provides basic guidelines for setting up workstations to prevent musculoskeletal disorders. It outlines the process for requesting an ergonomic assessment.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/ergonomic-guidelines.pdf\"\n}"}
