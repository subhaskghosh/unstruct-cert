{"_id": "human_resources--hr_policies:_doc--p--65214", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, offering confidential support services for employees facing personal or work-related challenges. It covers counseling, legal assistance, and financial guidance.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"Finance\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65214", "text": "{\n    \"policy_id\": \"LOA-2023-012\",\n    \"policy_title\": \"Extended Leave of Absence Procedure\",\n    \"policy_description\": \"A comprehensive guide detailing the procedures for requesting and managing extended leaves of absence, including medical leave, family leave, and personal leave. It covers eligibility criteria, documentation requirements, and benefits continuation.  Extensive details are provided to ensure full legal compliance.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Operations\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/loa-procedure\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65215", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for mental and physical health, including gym memberships and counseling services.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65215", "text": "{\n    \"policy_id\": \"EMP-LEAV-002\",\n    \"policy_title\": \"Bereavement Leave\",\n    \"policy_description\": \"This policy details the guidelines for employees taking time off due to the death of a family member.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65216", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Eligibility\",\n    \"policy_description\": \"This policy outlines the eligibility requirements for employees to enroll in the company's health insurance plan. It covers full-time employees and their dependents.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Legal\",\n        \"Data Science\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65216", "text": "{\n    \"policy_id\": \"SEC-INF-002\",\n    \"policy_title\": \"Data Security Protocol\",\n    \"policy_description\": \"A comprehensive guide detailing data encryption, access controls, and incident response procedures for all sensitive information processed within the organization. It includes detailed technical specifications and legal disclaimers.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Data Science\",\n        \"Legal\",\n        \"Compliance\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-security-protocol.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65217", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, offering confidential counseling and support services for personal and work-related issues. The program aims to promote employee well-being and a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65217", "text": "{\n    \"policy_id\": \"LE-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave of absence, including medical leave, family leave, and personal leave. It covers eligibility requirements, documentation needed, and the process for returning to work.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65218", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including access to mental health resources, fitness programs, and healthy lifestyle support.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65218", "text": "{\n    \"policy_id\": \"EXEC-001\",\n    \"policy_title\": \"Executive Compensation and Benefits\",\n    \"policy_description\": \"Details the specific compensation and benefits packages available to executive leadership team members.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive Team\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65219", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding health, dental, and vision insurance coverage for all eligible employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65219", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Complex Equity Compensation Plan\",\n    \"policy_description\": \"A comprehensive document outlining stock options, restricted stock units, and other equity-based compensation methods. Highly detailed and requiring legal consultation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity/compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65220", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It aims to provide comprehensive coverage with a focus on preventative care and employee well-being. The process for enrollment and claims is streamlined for ease of use.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65220", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This detailed policy governs the reimbursement of travel expenses incurred by employees on company business. It includes specific guidelines on allowable expenses, documentation requirements, and approval processes. Adherence to this policy is mandatory and requires meticulous record-keeping. A comprehensive expense report form must be submitted within 30 days of travel completion, with all receipts attached.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-09-20\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel_expenses.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65221", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including benefits related to mental health, physical fitness, and financial wellness. It details resources available to employees and guidelines for participation.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65221", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details of the company's 401k retirement savings plan, including eligibility, contribution limits, and investment options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65222", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It also includes information on wellness programs and resources.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65222", "text": "{\n    \"policy_id\": \"TRN-2023-002\",\n    \"policy_title\": \"Comprehensive Travel and Expense Reimbursement\",\n    \"policy_description\": \"Detailed guidelines and procedures for employee travel, including booking, expense reporting, and reimbursement processes. Covers international and domestic travel, lodging, meals, and other travel-related expenses. Includes a section on per diem rates and allowable expenses, with detailed requirements and documentation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Executive Leadership\",\n        \"Travel Coordination\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65223", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health. It promotes a healthy work-life balance and provides access to wellness programs.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65223", "text": "{\n    \"policy_id\": \"LB-2023-002\",\n    \"policy_title\": \"Legal and Compliance Handbook\",\n    \"policy_description\": \"A comprehensive guide to all legal and compliance matters, including data privacy, anti-discrimination, and workplace safety.  This document is very detailed and covers numerous complex legal requirements.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal-handbook.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65224", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for physical and mental health. It includes details on gym reimbursements, mental health support, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65224", "text": "{\n    \"policy_id\": \"LB-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details procedures for requesting and approving various types of leave, including sick leave, vacation leave, and parental leave. It covers eligibility requirements, application processes, and return-to-work guidelines. A comprehensive document with various clauses and contingencies.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
