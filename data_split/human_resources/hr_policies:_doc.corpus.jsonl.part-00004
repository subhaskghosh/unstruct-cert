{"_id": "human_resources--hr_policies:_doc--p--65375", "text": "{\n    \"policy_id\": \"WB-ENG-20231027\",\n    \"policy_title\": \"Employee Wellness Program - Engineering\",\n    \"policy_description\": \"This policy outlines the company's commitment to the well-being of its Engineering employees. It details resources available for mental health, physical health, and financial wellness. Includes access to gym memberships, counseling services, and financial planning workshops. Focuses on preventative care and creating a supportive work environment. Aims to foster a culture of health and boost employee morale and productivity.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-engineering-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65375", "text": "{\n    \"policy_id\": \"LEAVE-ALL-20220510\",\n    \"policy_title\": \"Extended Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving extended leaves of absence for medical reasons, parental leave, or other significant life events.  It outlines eligibility requirements, documentation needed, and the process for maintaining benefits during leave. This policy covers all employees regardless of department. The complete procedures are explained in detail including legal compliance, return to work procedures and the effect of leave on performance evaluations. This policy aims to provide clarity and support to employees navigating personal challenges while maintaining business continuity. Extensive documentation required. This document also covers FMLA and ADA related issues. It also delves into the complexities of short-term and long-term disability claims.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-of-absence-2022.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65376", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"Details regarding health, dental, and vision insurance benefits available to all full-time employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-coverage\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65376", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"Outlines the procedures and guidelines for granting and exercising employee stock options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65377", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees. The EAP provides confidential counseling and support services for personal and work-related issues, promoting employee well-being and mental health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65377", "text": "{\n    \"policy_id\": \"DA-005\",\n    \"policy_title\": \"Attendance and Tardiness\",\n    \"policy_description\": \"This policy details the procedures for reporting absences and tardiness, as well as the disciplinary actions that may be taken for excessive absenteeism or lateness. Consistent attendance is critical for maintaining operational efficiency.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65378", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the employee wellness program, providing resources and support for physical and mental wellbeing. It covers gym memberships, mental health support, and preventative care.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65378", "text": "{\n    \"policy_id\": \"EMP-TRA-002\",\n    \"policy_title\": \"Professional Development Reimbursement\",\n    \"policy_description\": \"This policy details the reimbursement process for approved professional development activities. It focuses on skill enhancement and career advancement.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/training-reimbursement.pdf\"\n}"}
