{"_id": "human_resources--hr_policies:_doc--n--65186", "text": "{\n    \"policy_id\": \"LA-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking leaves of absence, including medical leave, personal leave, and bereavement leave. Strict adherence to documentation requirements is expected.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
