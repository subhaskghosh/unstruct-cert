{"_id": "human_resources--hr_policies:_doc--p--62742", "text": "{\n    \"policy_id\": \"PTO-2024-01\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize paid time off for vacation, sick leave, and personal days. It aims to provide a flexible and supportive work environment.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-2024\"\n}"}
