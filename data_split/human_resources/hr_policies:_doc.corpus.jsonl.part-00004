{"_id": "human_resources--hr_policies:_doc--p--61764", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Family Leave Policy\",\n    \"policy_description\": \"This policy outlines the provisions for employees taking leave to care for family members. It includes paid and unpaid leave options.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/family-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61764", "text": "{\n    \"policy_id\": \"TRA-DEV-002\",\n    \"policy_title\": \"Professional Development Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to request reimbursement for approved professional development courses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/dev-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61765", "text": "{\n    \"policy_id\": \"PTO-2023-005\",\n    \"policy_title\": \"Vacation and Personal Time Off\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize vacation and personal time off, emphasizing work-life balance and employee well-being. It promotes flexible scheduling options to support employee needs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-2023-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61765", "text": "{\n    \"policy_id\": \"SL-2023-001\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"Details the procedures for reporting and utilizing sick leave benefits. Employees must provide a doctor's note for absences exceeding three consecutive days.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick-leave-2023-001.pdf\"\n}"}
