{"_id": "human_resources--hr_policies:_doc--n--68247", "text": "{\n    \"policy_id\": \"EMP-TRAIN-001\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program outlining leadership training opportunities for employees at all levels, including mentorship, workshops, and online courses. This policy details eligibility criteria, application procedures, and program requirements. Further details on each module are available within the accompanying training materials. The program is aligned with the company's long-term growth strategy and is crucial for identifying and nurturing future leaders. It is designed to foster a culture of continuous learning and improvement. The policy also covers expense reimbursement for training activities.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-training-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68248", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and adjusted work schedules, to support employee work-life balance.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work.pdf\"\n}"}
