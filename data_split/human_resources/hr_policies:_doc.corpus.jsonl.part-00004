{"_id": "human_resources--hr_policies:_doc--p--68461", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support services for employees dealing with personal or work-related challenges. It covers counseling, legal assistance, and financial guidance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"Finance\",\n        \"IT Security\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68461", "text": "{\n    \"policy_id\": \"WB-2024-002\",\n    \"policy_title\": \"Comprehensive Wellness Initiative\",\n    \"policy_description\": \"A detailed program covering physical, mental, and financial well-being, including gym memberships, mindfulness workshops, and financial planning seminars. The program aims to create a holistic approach to employee wellness and improve overall employee satisfaction.\",\n    \"effective_date\": \"2024-01-20\",\n    \"last_updated\": \"2024-09-05\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-initiative.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68462", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, covering gym membership discounts, mental health resources, and annual health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
