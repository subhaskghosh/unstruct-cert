{"_id": "human_resources--hr_policies:_doc--n--64260", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program designed to cultivate future leaders within the organization, including multi-stage training, mentorship opportunities, and executive coaching. This document outlines the program structure, eligibility requirements, selection process, and performance evaluation metrics. It is crucial for all participants and their managers to understand these guidelines to ensure the program's success and maximize its impact on individual and organizational growth.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64261", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources and programs to support physical, mental, and financial health. Includes gym reimbursement and mental health support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
