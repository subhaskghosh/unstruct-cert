{"_id": "human_resources--hr_policies:_doc--p--61965", "text": "{\n    \"policy_id\": \"PTO-2023-005\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and using paid time off, including vacation, sick leave, and personal days. It promotes work-life balance by encouraging employees to take time off to recharge and maintain their well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy_2023.pdf\"\n}"}
