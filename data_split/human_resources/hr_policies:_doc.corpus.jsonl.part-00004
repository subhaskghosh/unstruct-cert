{"_id": "human_resources--hr_policies:_doc--n--68024", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the complete health insurance coverage offered to all eligible employees, including medical, dental, and vision plans. It outlines eligibility criteria, coverage levels, claim procedures, and associated costs. This is a very extensive document covering many aspects of healthcare benefits and includes information on COBRA, HIPAA, and other relevant regulations. It also details dependent coverage and out-of-network care policies. A detailed explanation of the provider network is provided.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68025", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy details the health insurance options available to employees, including coverage levels, premiums, and enrollment procedures.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance.pdf\"\n}"}
