{"_id": "human_resources--hr_policies:_doc--p--65264", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, life insurance, and 401k retirement plan options.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package.pdf\"\n}"}
