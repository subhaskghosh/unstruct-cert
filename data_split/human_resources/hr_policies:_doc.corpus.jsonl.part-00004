{"_id": "human_resources--hr_policies:_doc--p--71357", "text": "{\n    \"policy_id\": \"BEN-PTO-202310\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for accruing and using paid time off for all eligible employees. It covers vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy.pdf\"\n}"}
