{"_id": "human_resources--hr_policies:_doc--p--71501", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding medical, dental, and vision coverage for employees. Includes information on plan options, eligibility, and enrollment procedures. This policy aims to provide comprehensive health benefits to support employee well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71501", "text": "{\n    \"policy_id\": \"RET-PLAN-001\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Outlines the details of the company's 401k plan, including contribution limits, investment options, and vesting schedules. This plan assists employees in planning for their future financial security.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
