{"_id": "human_resources--hr_policies:_doc--n--67303", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Company Vehicle Usage\",\n    \"policy_description\": \"This detailed policy outlines the rules and regulations for employees authorized to use company vehicles, including usage guidelines, maintenance responsibilities, insurance coverage, and reporting procedures for accidents or violations.  It covers a wide range of scenarios and potential liabilities, and includes specific clauses related to personal use, fuel reimbursement, and vehicle security.  Appendices A through D provide detailed checklists and forms.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/vehicle-policy\"\n}"}
