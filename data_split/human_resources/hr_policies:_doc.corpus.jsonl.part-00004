{"_id": "human_resources--hr_policies:_doc--p--71582", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for physical and mental health, including gym memberships, stress management workshops, and access to an Employee Assistance Program (EAP).\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71582", "text": "{\n    \"policy_id\": \"LGL-2023-005\",\n    \"policy_title\": \"Leave of Absence and FMLA Compliance\",\n    \"policy_description\": \"This comprehensive policy details the procedures for requesting and managing various types of leave of absence, including Family and Medical Leave Act (FMLA) compliance, short-term disability, and personal leave. It covers eligibility requirements, documentation procedures, and benefits continuation during leave.  Specific guidance is provided for both employees and managers. Detailed information on interactive process accommodation requests is also included, as well as state specific requirements. The policy contains multiple scenarios and examples of appropriate and inappropriate leave requests.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-22\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71583", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance, dental, and vision benefits available to all eligible employees. It includes information on coverage levels, enrollment procedures, and wellness programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71583", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Equity and Stock Option Plan\",\n    \"policy_description\": \"Details the company's stock option plan, eligibility requirements, vesting schedules, and tax implications. This policy also provides information on restricted stock units (RSUs) and employee stock purchase plans.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
