{"_id": "human_resources--hr_policies:_doc--p--71414", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to gym memberships, mental health resources, and flexible work arrangements. It supports work-life balance and promotes a healthy lifestyle.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71414", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"Details of the company's health insurance plan, including coverage levels, premiums, and eligibility requirements.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71415", "text": "{\n    \"policy_id\": \"EMP-BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits - Comprehensive Plan\",\n    \"policy_description\": \"Details the comprehensive health insurance benefits package available to all eligible employees, including coverage levels, deductibles, and co-pays. Focuses on preventative care and employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71415", "text": "{\n    \"policy_id\": \"EMP-RET-0005\",\n    \"policy_title\": \"401k Retirement Plan Contribution Matching\",\n    \"policy_description\": \"Outlines the company's 401k retirement plan, including eligibility requirements, contribution limits, and employer matching contributions.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71416", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, paid time off, and wellness programs. It emphasizes long-term financial and health security for our workforce.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee_benefits_package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71416", "text": "{\n    \"policy_id\": \"EMP-BEN-009\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for reasonable and necessary travel expenses incurred during business trips.  It covers transportation, lodging, and meal allowances.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2023-08-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel_expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71417", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage, premiums, and claim procedures.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71417", "text": "{\n    \"policy_id\": \"TERM-002\",\n    \"policy_title\": \"Employee Termination and Severance\",\n    \"policy_description\": \"This policy details the procedures for employee termination, including severance pay and benefits continuation. It covers both voluntary and involuntary terminations, and outlines the necessary documentation and approvals.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/termination\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71418", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the company's health insurance benefits for all eligible employees. It covers medical, dental, and vision care. Details regarding eligibility, coverage levels, and enrollment procedures are available in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71418", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy provides income replacement benefits to eligible employees who become disabled and unable to work for an extended period.  Eligibility criteria, benefit levels, waiting periods, and claim procedures are detailed in this document.  It’s a comprehensive plan with various riders and complexities related to pre-existing conditions, definitions of disability, and coordination with other benefits. We encourage all employees to review this document thoroughly to understand their coverage options. This document also includes information on the appeals process and contact information for the insurance provider.  Furthermore, it details the interaction between LTD and other leave policies, such as FMLA and state-specific disability programs.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71419", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, offering resources for mental health, physical fitness, and financial well-being. It emphasizes preventative care and a supportive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71419", "text": "{\n    \"policy_id\": \"RW-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees working remotely, including eligibility, equipment, and security protocols.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71420", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"Details regarding employee health insurance plans, eligibility, and enrollment procedures. This policy aims to provide comprehensive healthcare benefits to all eligible employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71420", "text": "{\n    \"policy_id\": \"TRAV-EXP-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Guidelines for reimbursing employees for travel expenses incurred during business trips. Covers transportation, lodging, and meal allowances.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-03-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel_expenses.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71421", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Clear and concise details are provided regarding coverage levels, premiums, and enrollment procedures.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71421", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Detailed guidelines for reimbursing employees for business travel expenses, including mileage, lodging, and meals.  Includes complex rules for international travel and expense reporting.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71422", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Comprehensive Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, vision, and wellness benefits available to all eligible employees. It emphasizes preventative care and employee well-being, providing detailed information on coverage options and enrollment procedures. Focuses on supporting work-life balance.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness-2023-005\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71422", "text": "{\n    \"policy_id\": \"EXP-2024-001\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and reimbursing employee travel expenses, including allowable costs, required documentation, and approval processes.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement-2024-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71423", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It details coverage levels, enrollment procedures, and available resources to support employee wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71423", "text": "{\n    \"policy_id\": \"EXEC-COMP-005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of stock option grants for executive leadership, including vesting schedules, exercise prices, and blackout periods.  Requires a deep understanding of financial instruments and equity compensation structures.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71424", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential counseling and support services to employees facing personal or work-related challenges. It covers mental health, financial difficulties, and legal guidance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71424", "text": "{\n    \"policy_id\": \"CL-2022-012\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy details the expected standards of behavior for all employees, covering topics such as conflicts of interest, confidentiality, and ethical conduct. Violations may result in disciplinary action.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71425", "text": "{\n    \"policy_id\": \"EMP-BNF-005\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health and wellness benefits available to all eligible employees, including medical, dental, and vision coverage, as well as employee assistance programs and wellness initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits.pdf\"\n}"}
