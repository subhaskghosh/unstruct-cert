{"_id": "human_resources--hr_policies:_doc--p--65290", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential counseling and support services for personal and work-related issues.  It aims to promote employee well-being and a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65290", "text": "{\n    \"policy_id\": \"WB-002\",\n    \"policy_title\": \"Comprehensive Wellness Initiative\",\n    \"policy_description\": \"A detailed, multi-faceted wellness program encompassing mental health support, physical fitness challenges, nutritional guidance, and financial wellness workshops. Requires extensive departmental coordination and participation.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_initiative\"\n}"}
