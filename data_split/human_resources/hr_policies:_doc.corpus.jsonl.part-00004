{"_id": "human_resources--hr_policies:_doc--p--70513", "text": "{\n    \"policy_id\": \"POL-2023-005\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the guidelines for employee travel, including expense reimbursement procedures and pre-approval requirements. It aims to ensure employees have a comfortable and safe travel experience while adhering to budgetary constraints.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
