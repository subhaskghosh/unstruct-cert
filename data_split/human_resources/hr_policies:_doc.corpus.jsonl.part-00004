{"_id": "human_resources--hr_policies:_doc--p--70387", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete range of benefits available to all eligible employees, including health insurance, retirement plans, paid time off, and wellness programs. It covers eligibility requirements, enrollment procedures, and details on each benefit offering. The policy aims to attract and retain top talent by providing a competitive and supportive benefits environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
