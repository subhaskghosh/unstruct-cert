{"_id": "human_resources--hr_policies:_doc--n--67617", "text": "{\n    \"policy_id\": \"LEGL-2023-005\",\n    \"policy_title\": \"Legal Compliance and Data Privacy\",\n    \"policy_description\": \"This comprehensive policy details the company's adherence to all relevant data privacy regulations, including GDPR, CCPA, and other international standards. It outlines procedures for data collection, storage, processing, and security. A complete legal review and approval process is required for any changes to this policy. Covers all data types, employee and customer information, and associated responsibilities. Detailed sections on incident response, data breach notification, and ongoing compliance monitoring are included.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Legal\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy\"\n}"}
