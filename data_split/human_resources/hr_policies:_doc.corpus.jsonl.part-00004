{"_id": "human_resources--hr_policies:_doc--n--65830", "text": "{\n    \"policy_id\": \"TRN-2022-005\",\n    \"policy_title\": \"Comprehensive Employee Training and Development Program\",\n    \"policy_description\": \"This policy details the various training opportunities available to employees, including leadership development, technical skills training, and professional certification programs. It covers eligibility criteria, application procedures, and reimbursement guidelines for external training. Extensive details on each course and program are available in the attached appendices.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/training/development-program.pdf\"\n}"}
