{"_id": "human_resources--hr_policies:_doc--n--67161", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to employees, encompassing 401k contributions, vesting schedules, pension options, and financial planning resources. It also covers beneficiary designations and withdrawal procedures.  The plan is designed to assist employees in securing their financial future and provides a range of investment options to suit different risk tolerances. This is a very detailed plan with multiple sections on investment strategies, tax implications and legal compliance.  Further information can be found in the full policy document. There are also regular review and update sessions scheduled to ensure the plan remains current and compliant with all relevant regulations. The policy is designed to be very thorough and is complex. \",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
