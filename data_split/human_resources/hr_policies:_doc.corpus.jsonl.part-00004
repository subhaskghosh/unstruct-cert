{"_id": "human_resources--hr_policies:_doc--n--68200", "text": "{\n    \"policy_id\": \"REM-002\",\n    \"policy_title\": \"Remote Work Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the reimbursement process for expenses incurred by employees working remotely, such as home office setup and internet costs. It specifies eligible expenses and the required documentation.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work/expense-reimbursement\"\n}"}
