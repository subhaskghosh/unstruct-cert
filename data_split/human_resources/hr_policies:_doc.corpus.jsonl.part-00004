{"_id": "human_resources--hr_policies:_doc--p--65529", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Mental Health and Support\",\n    \"policy_description\": \"This policy outlines the resources available to employees to support their mental health, including access to counseling, stress management workshops, and employee assistance programs.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\",\n        \"Public Relations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-2024-003.pdf\"\n}"}
