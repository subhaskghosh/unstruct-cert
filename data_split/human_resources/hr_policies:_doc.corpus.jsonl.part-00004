{"_id": "human_resources--hr_policies:_doc--n--67156", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Compensation and Benefits Policy\",\n    \"policy_description\": \"A comprehensive guide to employee compensation, benefits packages, and performance-based incentives, including detailed calculation methods and eligibility criteria.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67157", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits provided to eligible employees. It covers medical, dental, and vision care. Employees must enroll within 30 days of their start date.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67157", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including contribution matching, vesting schedules, and investment options. It also includes information on financial planning resources available to employees. The policy is subject to change based on market conditions and regulatory updates. Details regarding eligibility, contribution limits, loan options, and withdrawal rules are described in detail.  Furthermore, the plan involves complex tax implications and compliance requirements, necessitating annual reviews with qualified financial advisors. This plan also details various investment strategies and risk assessments, along with guidelines for beneficiary designations. Additional resources are available for employees considering early retirement or facing financial hardship.\",\n    \"effective_date\": \"2023-09-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
