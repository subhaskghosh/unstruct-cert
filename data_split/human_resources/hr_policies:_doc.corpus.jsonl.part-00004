{"_id": "human_resources--hr_policies:_doc--p--70993", "text": "{\n    \"policy_id\": \"POL-2023-007\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the guidelines for reimbursing employees for travel expenses incurred while on company business. It aims to ensure fair and consistent treatment of all employees regarding travel costs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/hr/travel-expense-policy.pdf\"\n}"}
