{"_id": "human_resources--hr_policies:_doc--p--62818", "text": "{\n    \"policy_id\": \"BNF-2023-007\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee financial health through educational resources, workshops, and access to financial advisors. It includes details on retirement planning, debt management, and emergency savings programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial_wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62818", "text": "{\n    \"policy_id\": \"LVE-2024-001\",\n    \"policy_title\": \"Sick Leave and Extended Illness Policy\",\n    \"policy_description\": \"This policy details the provisions for sick leave, including accrual rates, usage guidelines, and procedures for extended illness leave. It covers short-term and long-term disability benefits related to illness.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick_leave_policy.pdf\"\n}"}
