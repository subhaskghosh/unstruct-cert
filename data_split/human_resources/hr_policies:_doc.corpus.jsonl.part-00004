{"_id": "human_resources--hr_policies:_doc--p--62166", "text": "{\n    \"policy_id\": \"PTO-2023-005\",\n    \"policy_title\": \"Flexible Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize flexible time off arrangements, including remote work and adjusted schedules. It aims to promote work-life balance and employee wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-flexible-2023.pdf\"\n}"}
