{"_id": "human_resources--hr_policies:_doc--p--64904", "text": "{\n    \"policy_id\": \"EMP-DEV-003\",\n    \"policy_title\": \"Employee Development and Training Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to request reimbursement for approved training and development activities aimed at enhancing their skills and career progression.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee_development.pdf\"\n}"}
