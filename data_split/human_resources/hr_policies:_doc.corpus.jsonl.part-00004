{"_id": "human_resources--hr_policies:_doc--p--70533", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision care. Employees must enroll within 30 days of their hire date.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70533", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including eligibility requirements, contribution matching, vesting schedule, and investment options. It also covers provisions for hardship withdrawals and loan options. It provides a detailed explanation of the various investment strategies, and regulatory compliance information. Please consult with a financial advisor for personalized guidance. The plan is regularly reviewed to ensure it meets the needs of our employees and remains competitive within the industry. Furthermore, there are sections dedicated to understanding the tax implications of participating in the 401(k) plan.\",\n    \"effective_date\": \"2021-07-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70534", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, providing resources for physical, mental, and financial wellness.  It includes gym membership subsidies, mental health support, and financial planning workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_program_2023.pdf\"\n}"}
