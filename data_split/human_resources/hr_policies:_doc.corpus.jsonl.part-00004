{"_id": "human_resources--hr_policies:_doc--n--62901", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This detailed document comprehensively covers all aspects of the health insurance plan, including eligibility, coverage details, claim procedures, network providers, pre-authorization requirements, dependent coverage, and a glossary of medical terms. It also outlines the appeals process and the company's compliance with all relevant regulations.  A separate section addresses cost sharing responsibilities.  Further details are in the appendix.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
