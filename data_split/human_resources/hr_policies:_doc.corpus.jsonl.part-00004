{"_id": "human_resources--hr_policies:_doc--p--62180", "text": "{\n    \"policy_id\": \"BNF-2024-01\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details all benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It emphasizes employee support and well-being.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-07-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
