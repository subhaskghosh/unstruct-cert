{"_id": "human_resources--hr_policies:_doc--p--67572", "text": "{\n    \"policy_id\": \"PTO-2024-001\",\n    \"policy_title\": \"Flexible Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize paid time off, emphasizing flexibility and work-life balance. It allows for a combination of vacation, sick, and personal days rolled into a single PTO bank.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-2024\"\n}"}
