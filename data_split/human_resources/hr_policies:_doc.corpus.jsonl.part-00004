{"_id": "human_resources--hr_policies:_doc--n--68153", "text": "{\n    \"policy_id\": \"COMP-COMP-005\",\n    \"policy_title\": \"Equity Compensation Plan - Restricted Stock Units\",\n    \"policy_description\": \"Outlines the terms and conditions of the company's restricted stock unit (RSU) plan.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/rsu-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68154", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"Details of the company's wellness program, including gym reimbursement and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68154", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"Detailed plan outlining health, dental, and vision coverage options for all employees, including complex tiers and eligibility requirements.  A very thorough document.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68155", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees. The EAP provides confidential counseling and support services for personal and work-related issues. Resources are available 24/7.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68155", "text": "{\n    \"policy_id\": \"WB-2022-002\",\n    \"policy_title\": \"Comprehensive Wellness Initiative\",\n    \"policy_description\": \"This policy details a multi-faceted wellness initiative including preventative health screenings, fitness subsidies, mental health resources, and nutritional guidance. It is designed to promote holistic employee wellbeing. This program includes a detailed breakdown of all benefits, eligibility requirements, and participation guidelines, covering various aspects of employee health. We will review all aspects of employee health and wellness. The policy provides comprehensive instructions for enrollment and accessing available resources. It also outlines procedures for handling confidential health information. Further, it clarifies the company's commitment to a safe and supportive work environment. The wellness initiative will continue to be reviewed annually to remain compliant with the latest regulations and best practices. This is a large and complicated policy that requires many employees to participate.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-initiative\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68156", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"Details the comprehensive health insurance plan available to all eligible employees, including coverage options, premiums, and claim procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68156", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Old Retirement Savings Plan\",\n    \"policy_description\": \"Details the previous retirement savings plan offered to employees. This plan has been superseded by a newer plan.\",\n    \"effective_date\": \"2015-06-01\",\n    \"last_updated\": \"2019-12-31\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/old-retirement-plan.pdf\"\n}"}
