{"_id": "human_resources--hr_policies:_doc--n--68856", "text": "{\n    \"policy_id\": \"EB-2022-001\",\n    \"policy_title\": \"Comprehensive Health Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive health benefits package available to all eligible employees, including medical, dental, vision, and life insurance. It outlines eligibility criteria, enrollment procedures, and coverage details. This policy also covers information related to HSA and FSA accounts, COBRA, and other relevant regulations. Furthermore, it details the process for submitting claims and appealing denials, providing a thorough guide to navigating the health benefits system. A detailed glossary of terms is also included. The policy outlines the processes for international coverage and how to manage benefits during periods of leave.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-benefits\"\n}"}
