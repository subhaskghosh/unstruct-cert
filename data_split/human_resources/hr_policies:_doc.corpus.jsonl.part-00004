{"_id": "human_resources--hr_policies:_doc--n--64522", "text": "{\n    \"policy_id\": \"PERF-2022-002\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"This policy details the annual performance review process, including goal setting, feedback sessions, and performance ratings.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/perf-review-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64523", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage levels, premiums, and enrollment procedures. Employees are encouraged to review the full policy document for complete information.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64523", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Long-Term Disability Benefits\",\n    \"policy_description\": \"This comprehensive policy details the provisions for Long-Term Disability (LTD) benefits for eligible employees. It covers eligibility criteria, benefit amounts, waiting periods, claim procedures, coordination with other benefits, and the appeal process. The policy also addresses potential tax implications of LTD benefits. Employees are encouraged to consult with a financial advisor for personalized guidance.  This policy integrates with several other HR processes including performance management and leave of absence. It is updated frequently to comply with changing legal requirements.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/long_term_disability_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64524", "text": "{\n    \"policy_id\": \"WB-MH-2023-001\",\n    \"policy_title\": \"Employee Mental Health and Wellbeing\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the mental health and wellbeing of all employees. It provides details on available resources, including counseling services, Employee Assistance Programs (EAP), and mental health training for managers.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-mh-2023-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64524", "text": "{\n    \"policy_id\": \"WB-PF-2023-002\",\n    \"policy_title\": \"Employee Physical Fitness Reimbursement\",\n    \"policy_description\": \"This policy details the reimbursement process for employees who participate in fitness programs or purchase fitness equipment. It aims to encourage a healthy lifestyle and reduce healthcare costs.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-pf-2023-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64525", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, physical fitness, and financial wellness. It encourages a healthy work-life balance through flexible work arrangements and wellness initiatives.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64525", "text": "{\n    \"policy_id\": \"DIS-2023-002\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the process for addressing employee misconduct and performance issues, including warnings, suspension, and termination.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-procedure\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64526", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wb-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64526", "text": "{\n    \"policy_id\": \"LE-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed procedures for requesting and managing various types of leave, including medical, parental, and personal leave. This policy includes comprehensive guidelines for documentation, benefits continuation, and return-to-work procedures.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/le-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64527", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy details the various wellness benefits available to employees, including gym memberships, mental health resources, and preventative care programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_benefits.pdf\"\n}"}
