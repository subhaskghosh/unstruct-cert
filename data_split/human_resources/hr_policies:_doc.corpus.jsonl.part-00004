{"_id": "human_resources--hr_policies:_doc--p--62859", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Sales Performance Bonus Plan\",\n    \"policy_description\": \"This policy outlines the bonus structure for Sales and Marketing employees based on quarterly performance metrics. Bonuses are designed to incentivize exceeding sales targets and contributing to revenue growth. Eligibility requirements are detailed within.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-bonus-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62859", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy details the stock option grants for senior executives, including vesting schedules, exercise prices, and other relevant terms. This plan is intended to align executive interests with long-term shareholder value.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-stock-options.pdf\"\n}"}
