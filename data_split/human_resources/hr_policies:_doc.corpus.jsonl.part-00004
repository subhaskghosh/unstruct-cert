{"_id": "human_resources--hr_policies:_doc--p--67566", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees. It covers medical, dental, and vision care.  Details on coverage levels and enrollment procedures are provided in the linked document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67566", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This policy details the 401k retirement savings plan offered to all employees. It outlines eligibility requirements, contribution limits, investment options, vesting schedules, and loan provisions. The full document provides comprehensive information regarding plan administration, beneficiary designations, and applicable regulations.  This is a detailed and complex document outlining many financial details, and including all legal disclosures necessary.  Employees are encouraged to consult with a financial advisor for personalized guidance. More information is available in the employee handbook. The plan administrator is Fidelity Investments. Any changes to the plan must be submitted in writing to the HR department and approved by the benefits committee. Furthermore, this plan is subject to change based on market conditions and regulatory updates. We strive to maintain a competitive and beneficial retirement plan for all our valued employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67567", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees are responsible for understanding their coverage options and associated costs. Details are available in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67567", "text": "{\n    \"policy_id\": \"BNF-2022-005\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, including 401(k) contributions, vesting schedules, and investment options.  It covers eligibility requirements, contribution limits, loan provisions, hardship withdrawals, and distribution options.  Employees are encouraged to attend informational seminars to fully understand the plan.  The plan is subject to change based on legal and market conditions. Further details on investment strategies and specific fund performance are available upon request.  Please refer to the detailed plan document for all terms and conditions. This document is a comprehensive guide to securing your financial future with our company. We also provide access to financial advisors to assist with retirement planning.  The plan is administered by Fidelity Investments. Employee enrollment forms are available on the HR portal. A detailed FAQ section is available to address common questions. Annual updates are provided to all participants. Review the current investment guidelines to make informed decisions.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67568", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
