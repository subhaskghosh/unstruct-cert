{"_id": "human_resources--hr_policies:_doc--p--70485", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides employees with 16 weeks of paid parental leave, exceeding the minimum legal requirement. It applies to all full-time employees following six months of service.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental-leave-enhanced\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70485", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Employee Computer Usage Policy\",\n    \"policy_description\": \"This policy outlines acceptable use of company computers and network resources.  It emphasizes security and data protection.\",\n    \"effective_date\": \"2023-08-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/computer-usage\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70486", "text": "{\n    \"policy_id\": \"ETH-2023-001\",\n    \"policy_title\": \"Code of Conduct and Ethical Guidelines\",\n    \"policy_description\": \"This policy outlines the expected ethical behavior of all employees, covering areas such as conflicts of interest, confidentiality, and professional conduct. It emphasizes the importance of integrity and compliance with all applicable laws and regulations.  We are committed to maintaining a workplace free from harassment and discrimination. All employees are required to review and acknowledge this policy annually.  Detailed examples and reporting procedures are included to ensure clear understanding and accountability. Failure to adhere to this policy may result in disciplinary action, up to and including termination of employment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/code-of-conduct-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70486", "text": "{\n    \"policy_id\": \"PTO-2022-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the accrual and usage of paid time off for employees.  It covers vacation, sick leave, and personal days. Employees are encouraged to plan their time off in advance with their managers. \",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-policy-2022.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70487", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including gym membership subsidies, mental health resources, and preventative care programs.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
