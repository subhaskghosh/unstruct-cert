{"_id": "human_resources--hr_policies:_doc--n--62560", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Comprehensive details regarding confidential counseling, referral, and support services available to all employees and their immediate family members. This includes details on mental health resources, legal assistance, and financial counseling. Includes detailed information on eligibility, accessing services, and confidentiality.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/eap.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62561", "text": "{\n    \"policy_id\": \"EB-2024-003\",\n    \"policy_title\": \"Health & Wellness Benefit Program\",\n    \"policy_description\": \"Details the company's comprehensive health and wellness benefits, including medical, dental, and vision coverage, as well as employee assistance programs.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-wellness-policy.pdf\"\n}"}
