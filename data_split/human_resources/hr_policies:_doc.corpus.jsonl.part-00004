{"_id": "human_resources--hr_policies:_doc--p--67056", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health insurance benefits available to all eligible employees. We aim to provide competitive coverage options that prioritize employee well-being and financial security. Includes details on deductibles, co-pays, and covered services.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67056", "text": "{\n    \"policy_id\": \"EMP-LEAV-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing sick leave. Employees are entitled to a limited number of sick days per year, subject to manager approval. Unused sick days do not roll over.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-policy\"\n}"}
