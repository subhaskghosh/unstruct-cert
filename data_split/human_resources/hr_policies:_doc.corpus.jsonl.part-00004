{"_id": "human_resources--hr_policies:_doc--p--71939", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees, including medical, dental, and vision coverage. It also details employee assistance programs and wellness initiatives designed to promote a healthy work-life balance. This is particularly helpful for new employees understanding their benefits.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71939", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Equity and Stock Option Plan\",\n    \"policy_description\": \"Details of the company's equity and stock option plan for eligible employees. Includes vesting schedules and exercise procedures.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/stock_options.pdf\"\n}"}
