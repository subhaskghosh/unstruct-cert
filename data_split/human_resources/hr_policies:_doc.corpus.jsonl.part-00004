{"_id": "human_resources--hr_policies:_doc--p--71378", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees, including coverage details, premium contributions, and claim procedures. It emphasizes comprehensive coverage and employee well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71378", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details of the company's 401k retirement savings plan, including contribution matching, investment options, and eligibility requirements.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71379", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Health Benefit Policy\",\n    \"policy_description\": \"This policy outlines the health benefits available to all eligible employees. It covers medical, dental, and vision insurance, as well as wellness programs. Employees are encouraged to take advantage of these benefits to maintain their health and well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-benefit-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71379", "text": "{\n    \"policy_id\": \"TRN-2022-015\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Detailed guidelines for reimbursing employees for business travel expenses, including transportation, lodging, and meals. This policy is comprehensive and covers all aspects of travel reimbursement procedures. It also outlines the process for submitting expense reports and required documentation.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71380", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete suite of benefits offered to employees, including health insurance, paid time off, parental leave, and wellness programs. It aims to attract and retain top talent by providing a competitive benefits package.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71380", "text": "{\n    \"policy_id\": \"EMP-RET-002\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including eligibility, contribution limits, and investment options. This plan helps employees save for retirement.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ret-002.pdf\"\n}"}
