{"_id": "human_resources--hr_policies:_doc--p--70393", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the various wellness benefits available to employees, including gym memberships, mental health resources, and preventative care programs. It aims to promote a healthy and productive workforce.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits\"\n}"}
