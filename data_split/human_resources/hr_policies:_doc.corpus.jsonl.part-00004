{"_id": "human_resources--hr_policies:_doc--n--71659", "text": "{\n    \"policy_id\": \"EB-2022-005\",\n    \"policy_title\": \"Legacy Employee Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the 2022 Employee Stock Option Plan.  It covers vesting schedules, exercise windows, and tax implications. This policy is being phased out.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan.pdf\"\n}"}
