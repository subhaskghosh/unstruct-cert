{"_id": "human_resources--hr_policies:_doc--n--68255", "text": "{\n    \"policy_id\": \"EXC-CMP-2024-005\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This policy details the compensation structure, including salary, bonus, and equity grants, for executive-level employees. It outlines the performance metrics used to determine bonus eligibility and the vesting schedule for equity awards.\",\n    \"effective_date\": \"2024-03-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-compensation\"\n}"}
