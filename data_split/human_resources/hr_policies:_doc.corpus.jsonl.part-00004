{"_id": "human_resources--hr_policies:_doc--p--67932", "text": "{\n    \"policy_id\": \"BNF-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits provided to eligible employees. Coverage includes medical, dental, and vision. Details regarding eligibility, premiums, and claim procedures are outlined in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67932", "text": "{\n    \"policy_id\": \"BNF-005\",\n    \"policy_title\": \"Executive Retirement Plan\",\n    \"policy_description\": \"This comprehensive retirement plan is designed for executive-level employees and provides detailed information on vesting schedules, contribution limits, investment options, and withdrawal procedures. It also covers tax implications and estate planning considerations related to retirement benefits. It includes a detailed overview of all investment vehicles, eligibility requirements, and legal disclaimers. This is a lengthy and legally complex document.\",\n    \"effective_date\": \"2022-07-10\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67933", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and wellbeing through various programs including gym membership discounts, mental health resources, and health screenings. It aims to promote a healthy work-life balance and preventative care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp_bnf_003.pdf\"\n}"}
