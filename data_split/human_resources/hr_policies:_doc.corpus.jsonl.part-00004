{"_id": "human_resources--hr_policies:_doc--n--68453", "text": "{\n    \"policy_id\": \"EMP-BEN-0005\",\n    \"policy_title\": \"Legacy Pension Plan\",\n    \"policy_description\": \"Outlines the details of the company's historical pension plan, including vesting schedules and payout options. This plan is no longer actively contributing but remains in effect for existing beneficiaries.\",\n    \"effective_date\": \"1998-07-01\",\n    \"last_updated\": \"2010-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/legacy-pension-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68454", "text": "{\n    \"policy_id\": \"WB-2023-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for mental health, physical fitness, and stress management. It emphasizes a supportive work environment and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68454", "text": "{\n    \"policy_id\": \"CMP-2023-001\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"This policy details the commission structure for the Sales department, outlining performance targets and payout schedules. It also includes bonus opportunities.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/commission-structure.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68455", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, retirement plans, paid time off, and other benefits designed to support employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68455", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Short-Term Incentive Program\",\n    \"policy_description\": \"Details a bonus program for achieving quarterly sales targets. This is a temporary incentive and is not part of the standard benefits package.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2023-07-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/sales-bonus.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68456", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Plan Details\",\n    \"policy_description\": \"This policy outlines the details of the company's health insurance plan, including coverage options, eligibility requirements, and enrollment procedures. It focuses on providing comprehensive benefits to all eligible employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68456", "text": "{\n    \"policy_id\": \"EXEC-COMP-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Details regarding stock options granted to executive level employees. Covers vesting schedules, exercise terms, and tax implications.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-stock-options\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68457", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Wellness Benefit\",\n    \"policy_description\": \"This policy outlines the employee wellness benefit program, covering gym memberships and mental health resources. It aims to promote a healthy work-life balance and improve employee wellbeing. Participation is voluntary and details are available on the HR portal.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_benefit_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68457", "text": "{\n    \"policy_id\": \"BNF-2022-005\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the comprehensive health insurance plan available to all employees. It covers medical, dental, and vision care, and includes information on eligibility, enrollment procedures, and claim submissions. The plan consists of a Preferred Provider Organization (PPO) network with options for out-of-network care. Details regarding cost-sharing, deductibles, co-pays, and out-of-pocket maximums are outlined in the full policy document. This policy also covers specific pre-existing conditions according to the applicable legal guidelines and provides information on appealing denied claims. Employees are encouraged to review the full plan document for complete details. The plan is subject to annual renewal and may be adjusted based on market conditions and cost factors. Contact the benefits administrator for further assistance.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68458", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides extended paid parental leave for all eligible employees to support work-life balance and family wellbeing. It includes provisions for both primary and secondary caregivers, and flexible return-to-work options.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68458", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Standard Health Insurance Plan\",\n    \"policy_description\": \"Details the standard health insurance plan offered to employees, including coverage levels, premiums, and eligibility requirements.\",\n    \"effective_date\": \"2019-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance\"\n}"}
