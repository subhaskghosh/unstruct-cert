{"_id": "human_resources--hr_policies:_doc--n--67391", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Comprehensive Employee Compensation and Equity Plan\",\n    \"policy_description\": \"A highly detailed document covering all aspects of employee compensation, including salary, bonuses, stock options, and long-term incentive plans. This is a large document covering many complex details. \",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-plan\"\n}"}
