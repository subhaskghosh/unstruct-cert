{"_id": "human_resources--hr_policies:_doc--n--65363", "text": "{\n    \"policy_id\": \"LV-2023-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details the procedures for requesting and obtaining various types of leave, including sick leave, parental leave, and personal leave. This is a comprehensive guide to all leave requests.\",\n    \"effective_date\": \"2023-11-20\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65364", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial planning. It aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65364", "text": "{\n    \"policy_id\": \"REM-POL-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees working remotely, including eligibility criteria, security protocols, and performance expectations. It supports flexible working arrangements to enhance work-life balance.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Technology\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65365", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, covering mental health resources, fitness benefits, and preventative care programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65365", "text": "{\n    \"policy_id\": \"SALES-INC-002\",\n    \"policy_title\": \"Sales Incentive Program\",\n    \"policy_description\": \"Details the commission structure and bonus eligibility for sales representatives.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales-incentive.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65366", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for physical and mental health. It includes details about gym reimbursement, mental health counseling, and wellness workshops.  We strive to create a supportive work environment where employees can thrive.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65366", "text": "{\n    \"policy_id\": \"LE-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This comprehensive Leave of Absence policy details all types of leave available to employees, including sick leave, vacation time, parental leave, and bereavement leave. It covers eligibility requirements, application procedures, and any applicable legal considerations. The policy aims to ensure compliance with all relevant federal and state laws while providing employees with the flexibility they need to manage personal and family responsibilities.  Detailed information regarding short-term and long-term disability is also provided, along with procedures for requesting accommodations under the Americans with Disabilities Act.  The policy also outlines the process for returning to work after a leave of absence, including any required documentation or medical clearances. Furthermore, it clarifies the impact of leave on employee benefits, such as health insurance and retirement plans. This policy is subject to change based on evolving legal requirements and company needs. Regular review and updates will be conducted to ensure its continued relevance and effectiveness. Employees are encouraged to consult with the HR department for clarification on any aspect of this policy.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65367", "text": "{\n    \"policy_id\": \"WB-ENG-2024001\",\n    \"policy_title\": \"Employee Wellness Program - Engineering\",\n    \"policy_description\": \"This policy outlines the wellness program available to all employees within the Engineering department, including mental health resources, ergonomic assessments, and flexible work arrangements designed to foster a supportive and healthy work environment. It aims to proactively address employee well-being and prevent burnout.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-eng-2024001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65367", "text": "{\n    \"policy_id\": \"LEAVE-ALL-2023002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the guidelines for requesting and utilizing paid time off, including vacation, sick leave, and personal days. All employees are eligible to accrue PTO based on their tenure with the company.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-all-2023002.pdf\"\n}"}
