{"_id": "human_resources--hr_policies:_doc--p--61760", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all full-time employees. It covers medical, dental, and vision care. Employees are eligible after 30 days of employment. Details regarding coverage levels and co-pays are available in the policy document.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61760", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business travel expenses. It covers transportation, lodging, meals, and incidental expenses. All travel requests must be pre-approved by a manager. Detailed guidelines regarding allowable expenses and reimbursement rates are provided in the attached document. This document also covers any exceptions to the standard travel procedures, accounting for international travel or unforeseen circumstances. Any violation of this policy may result in disciplinary action.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61761", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Benefits Package\",\n    \"policy_description\": \"Details regarding health insurance, retirement plans, and other employee benefits.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61761", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Short-Term Disability\",\n    \"policy_description\": \"Covers employees temporarily unable to work due to illness or injury.\",\n    \"effective_date\": \"2023-01-20\",\n    \"last_updated\": \"2022-11-05\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability/shortterm.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61762", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees. It covers medical, dental, and vision insurance, as well as wellness programs designed to promote employee health. Employees can find details about coverage levels, enrollment procedures, and contact information for benefit providers. The program is reviewed annually to ensure its continued competitiveness and relevance to employee needs. A dedicated benefits team is available to answer any questions or assist with enrollment. This is the most recent update to benefits policy. Employees are encouraged to utilize these resources to maintain their overall well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61762", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Basic Life Insurance\",\n    \"policy_description\": \"This policy provides basic life insurance coverage to all full-time employees.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/life-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61763", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various programs and resources, including mental health support, fitness initiatives, and nutritional guidance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
