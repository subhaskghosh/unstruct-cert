{"_id": "human_resources--hr_policies:_doc--n--71756", "text": "{\n    \"policy_id\": \"DISC-003\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the process for addressing employee misconduct and outlines the steps for disciplinary action, including warnings, suspensions, and termination.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-procedure\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71757", "text": "{\n    \"policy_id\": \"BNF-2024-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans, including eligibility, coverage options, and premium contributions.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance_enrollment.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71757", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Benefits Handbook\",\n    \"policy_description\": \"Comprehensive guide to all employee benefits offered by the company.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee_benefits_handbook.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71758", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"Details the full range of employee benefits including health, dental, vision, and retirement plans. Aims to provide a competitive and supportive benefits package.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71758", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Limited Medical Benefits\",\n    \"policy_description\": \"Basic medical coverage for part-time employees. Focuses on essential healthcare services.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/limited_medical.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71759", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels, premiums, and enrollment procedures. Covers medical, dental, and vision plans.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71759", "text": "{\n    \"policy_id\": \"EMP-BEN-009\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Outlines the details of the company's 401k retirement savings plan, including contribution matching, vesting schedules, and investment options.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71760", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical health, and financial wellness. It promotes a supportive work environment and encourages work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71760", "text": "{\n    \"policy_id\": \"LD-2022-005\",\n    \"policy_title\": \"Leave of Absence Documentation Procedures\",\n    \"policy_description\": \"Detailed procedures for requesting and documenting various types of leave of absence, including medical leave, parental leave, and personal leave. This policy is highly detailed and legally focused.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71761", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee physical and mental wellbeing, including access to resources, programs, and benefits aimed at promoting a healthy lifestyle. It details procedures for accessing wellness benefits and reporting concerns.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71761", "text": "{\n    \"policy_id\": \"RW-002\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy defines the guidelines and procedures for employees working remotely, covering topics such as eligibility, equipment, security, and performance expectations.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71762", "text": "{\n    \"policy_id\": \"WB-2023-ENG-PROD-001\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including flexible work options, mental health resources, and wellness programs. It aims to create a supportive work environment that fosters work-life balance and reduces stress.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy-eng-prod\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71762", "text": "{\n    \"policy_id\": \"COMP-2023-ALL-005\",\n    \"policy_title\": \"Salary and Bonus Structure\",\n    \"policy_description\": \"Details the company's salary bands, bonus eligibility criteria, and performance review process for all employees.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/salary-policy\"\n}"}
