{"_id": "human_resources--hr_policies:_doc--p--70004", "text": "{\n    \"policy_id\": \"PL-007\",\n    \"policy_title\": \"Sick Leave Policy for Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and taking sick leave for employees in the Sales and Marketing departments. Employees are eligible for up to 5 paid sick days per year with a doctor's note required after 3 consecutive days.  Requests must be submitted to the department manager at least 24 hours in advance, whenever possible.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick-leave-sales-marketing.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70004", "text": "{\n    \"policy_id\": \"PL-012\",\n    \"policy_title\": \"Comprehensive Leave and Absence Management Policy\",\n    \"policy_description\": \"This policy provides a detailed overview of all leave options available to employees, including vacation, sick leave, personal leave, bereavement leave, parental leave, jury duty, military leave, and unpaid leave of absence.  It outlines eligibility requirements, application procedures, documentation requirements, and pay continuation guidelines for each type of leave. The policy also addresses interactions with other benefits programs and applicable federal and state laws. This detailed policy is intended to cover every possible scenario regarding employee time off, ensuring compliance and equitable treatment for all staff members.  It includes sections on short-term disability, long-term disability, and leaves covered under FMLA. It further explains the process for requesting accommodations related to leave and provides contact information for the HR department to address any questions or concerns.  The policy aims to balance the needs of the employees with the operational requirements of the organization.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/comprehensive-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70005", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It also includes details on wellness programs and resources.\",\n    \"effective_date\": \"2022-07-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-health-benefits.pdf\"\n}"}
