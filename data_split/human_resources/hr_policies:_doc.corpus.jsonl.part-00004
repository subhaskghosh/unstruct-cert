{"_id": "human_resources--hr_policies:_doc--n--64671", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Employee Compensation and Equity\",\n    \"policy_description\": \"A comprehensive document detailing salary structures, bonus programs, stock options, and other forms of compensation for all employees. This policy includes details on performance-based incentives and long-term equity grants.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
