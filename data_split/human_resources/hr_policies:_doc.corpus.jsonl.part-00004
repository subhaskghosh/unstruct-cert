{"_id": "human_resources--hr_policies:_doc--p--67091", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees are responsible for understanding their coverage options and utilizing the benefits effectively. Details on enrollment, claims, and provider networks are available on the HR portal.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67091", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Executive Compensation & Benefits Package\",\n    \"policy_description\": \"This highly detailed policy outlines the comprehensive compensation and benefits package for executive-level employees. It encompasses base salary, performance-based bonuses, stock options, health insurance, retirement plans, and other exclusive perks. Eligibility criteria, vesting schedules, and tax implications are fully disclosed. This policy is subject to regular review and approval by the board of directors. It contains a comprehensive section detailing international assignment benefits, long-term disability insurance, and estate planning resources. Further, it contains appendices related to stock option grants, performance metrics and vesting schedules. The full policy details can be found in the document.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67092", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67092", "text": "{\n    \"policy_id\": \"LVE-2022-005\",\n    \"policy_title\": \"Extended Leave of Absence - Comprehensive Guide\",\n    \"policy_description\": \"This policy details all types of extended leave available to employees, including personal leave, family leave, medical leave, sabbatical options, and related procedures. It covers eligibility requirements, application processes, compensation during leave, and return-to-work guidelines.  Detailed explanations of each type of leave are provided, along with links to relevant legal resources and internal support departments. This is a long and complex policy intended to cover all potential scenarios.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/extended-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67093", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work.pdf\"\n}"}
