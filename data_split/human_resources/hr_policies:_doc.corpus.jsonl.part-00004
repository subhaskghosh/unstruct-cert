{"_id": "human_resources--hr_policies:_doc--n--65534", "text": "{\n    \"policy_id\": \"LEGL-005\",\n    \"policy_title\": \"Non-Disclosure and Confidentiality Agreement\",\n    \"policy_description\": \"This legally binding agreement details the terms and conditions regarding the protection of confidential company information. It specifies penalties for unauthorized disclosure and outlines the legal ramifications of breaching the agreement. It is a comprehensive document adhering to all applicable laws and regulations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-agreement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65535", "text": "{\n    \"policy_id\": \"WB-PM-2024-001\",\n    \"policy_title\": \"Employee Wellness and Performance Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being and enhancing performance through resources like mental health programs, flexible work arrangements, and professional development opportunities. It aims to foster a positive and productive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-pm-2024-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65535", "text": "{\n    \"policy_id\": \"DA-2023-005\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and performance issues, including warnings, suspensions, and termination. It ensures fair and consistent treatment of all employees.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/da-2023-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65536", "text": "{\n    \"policy_id\": \"WB-PM-2023-001\",\n    \"policy_title\": \"Employee Wellness and Performance Support\",\n    \"policy_description\": \"This policy outlines the resources available to employees to support their overall well-being and enhance performance, including mental health resources, flexible work arrangements, and professional development opportunities. It focuses on proactive support and growth.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-pm-2023-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65536", "text": "{\n    \"policy_id\": \"CMP-2023-002\",\n    \"policy_title\": \"Performance Improvement Plan and Disciplinary Actions\",\n    \"policy_description\": \"This policy details the process for addressing performance issues, including performance improvement plans, warnings, and potential disciplinary actions up to and including termination. It is designed to ensure accountability and consistent performance standards.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/cmp-2023-002.pdf\"\n}"}
