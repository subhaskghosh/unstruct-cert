{"_id": "human_resources--hr_policies:_doc--p--62360", "text": "{\n    \"policy_id\": \"BNF-2023-01\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the various wellness benefits available to employees, including gym memberships, mental health resources, and preventative care programs.  Designed to promote a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-09-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_benefits_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62360", "text": "{\n    \"policy_id\": \"TRV-2023-02\",\n    \"policy_title\": \"Business Travel Reimbursement\",\n    \"policy_description\": \"This policy details the guidelines for reimbursing employees for expenses incurred during business travel. Includes procedures for booking travel, submitting expense reports, and allowable expenses.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-08-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_reimbursement_policy.pdf\"\n}"}
