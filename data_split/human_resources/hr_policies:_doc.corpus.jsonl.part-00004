{"_id": "human_resources--hr_policies:_doc--p--65385", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical health, and financial wellness. It details access to gym memberships, counseling services, and financial planning workshops.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65385", "text": "{\n    \"policy_id\": \"DA-2024-005\",\n    \"policy_title\": \"Employee Disciplinary Action\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct, including warnings, suspension, and termination. It outlines the steps for conducting investigations and documenting disciplinary actions.\",\n    \"effective_date\": \"2024-04-01\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65386", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the health and well-being of all employees through resources like gym memberships, mental health support, and wellness workshops. It aims to foster a positive and productive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65386", "text": "{\n    \"policy_id\": \"LEGAL-2023-102\",\n    \"policy_title\": \"Non-Disclosure Agreement and Confidentiality Protocol\",\n    \"policy_description\": \"This document details the legal obligations of employees regarding confidential company information, intellectual property, and trade secrets. Strict adherence to the terms outlined herein is mandatory to avoid legal repercussions. Any breach will be subject to disciplinary action up to and including termination of employment.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-protocol\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65387", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being and provides guidelines for flexible work options, including remote work, flextime, and compressed workweeks. It aims to promote work-life balance and reduce employee stress.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-flexibility\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65387", "text": "{\n    \"policy_id\": \"EXEC-001\",\n    \"policy_title\": \"Executive Compensation and Benefits Package\",\n    \"policy_description\": \"This policy details the compensation and benefits package available to executive leadership team members, including stock options, performance bonuses, and premium health insurance plans.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-compensation\"\n}"}
