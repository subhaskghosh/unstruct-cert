{"_id": "human_resources--hr_policies:_doc--n--68467", "text": "{\n    \"policy_id\": \"LEGAL-COMP-005\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"Detailed documentation regarding the company’s adherence to the Employee Retirement Income Security Act (ERISA), including reporting requirements, fiduciary responsibilities, and plan administration guidelines. This is a highly technical document intended for HR professionals and legal counsel.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/erisa-compliance.pdf\"\n}"}
