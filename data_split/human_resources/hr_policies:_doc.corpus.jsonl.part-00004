{"_id": "human_resources--hr_policies:_doc--p--67229", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees must enroll within 30 days of their start date.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67229", "text": "{\n    \"policy_id\": \"COMP-0005\",\n    \"policy_title\": \"Compensation and Performance Review\",\n    \"policy_description\": \"This comprehensive policy details the company's approach to employee compensation, performance reviews, bonus structures, and promotion guidelines. It includes detailed information on the performance management cycle, goal setting, and feedback processes, as well as the criteria for salary adjustments and bonuses. This policy addresses all levels of employees, from entry-level to executive management. It also covers the company's policy on equity and stock options. The policy aims to promote transparency, fairness, and motivation within the organization. It contains detailed explanations of the various performance metrics used, including both quantitative and qualitative measures.\",\n    \"effective_date\": \"2023-09-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-review-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67230", "text": "{\n    \"policy_id\": \"BP-2024-007\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for sales representatives, including tiers, targets, and payout schedules. This policy ensures fair and transparent compensation for sales performance.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-07-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_structure.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67230", "text": "{\n    \"policy_id\": \"BP-2023-012\",\n    \"policy_title\": \"Remote Work Guidelines\",\n    \"policy_description\": \"Outlines the guidelines for employees working remotely, including eligibility, security protocols, and communication expectations.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work_guidelines.pdf\"\n}"}
