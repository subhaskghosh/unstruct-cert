{"_id": "human_resources--hr_policies:_doc--n--68147", "text": "{\n    \"policy_id\": \"LEGL-2022-005\",\n    \"policy_title\": \"Legal Compliance - Data Privacy\",\n    \"policy_description\": \"A comprehensive document detailing the company's adherence to all relevant data privacy regulations, including GDPR, CCPA, and others. It includes detailed legal definitions and procedures.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68148", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, covering health screenings, gym memberships, and mental health resources.  It aims to support a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68148", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Details the vesting schedule, exercise options, and tax implications of the company’s stock option plan.  Utilizes Black-Scholes model for valuation and requires understanding of 409A compliance.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-plan.pdf\"\n}"}
