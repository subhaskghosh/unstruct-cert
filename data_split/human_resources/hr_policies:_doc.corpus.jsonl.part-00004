{"_id": "human_resources--hr_policies:_doc--p--68372", "text": "{\n    \"policy_id\": \"BEN-PTO-2023\",\n    \"policy_title\": \"Paid Time Off and Vacation Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize paid time off for vacation, personal days, and sick leave. It aims to provide employees with flexibility and support work-life balance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68372", "text": "{\n    \"policy_id\": \"BEN-HEALTH-2024\",\n    \"policy_title\": \"Health Insurance Benefits Plan\",\n    \"policy_description\": \"Detailed legal documentation outlining the specifics of the company's health insurance plans, including coverage details, provider networks, and compliance information.  This is a comprehensive legal document relating to healthcare benefits.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68373", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision care. Employees are responsible for understanding their plan options and enrolling during the open enrollment period.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68373", "text": "{\n    \"policy_id\": \"TERM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"This policy details the procedures for employee termination, including notice periods, final paychecks, and benefits continuation. It outlines the responsibilities of both the employee and the company during the termination process. Comprehensive legal review is required for all termination cases.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination/procedures\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68374", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels, premiums, and eligibility requirements. This policy aims to provide comprehensive healthcare support to our valued team members.\",\n    \"effective_date\": \"2022-07-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68374", "text": "{\n    \"policy_id\": \"INT-ASG-001\",\n    \"policy_title\": \"International Assignment Policy\",\n    \"policy_description\": \"Outlines the guidelines and procedures for employees assigned to work in international locations. This includes details on relocation allowances, housing support, and tax implications.\",\n    \"effective_date\": \"2023-02-20\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/international_assignment.pdf\"\n}"}
