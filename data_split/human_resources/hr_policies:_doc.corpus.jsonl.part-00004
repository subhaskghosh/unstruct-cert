{"_id": "human_resources--hr_policies:_doc--n--67110", "text": "{\n    \"policy_id\": \"LGL-2023-002\",\n    \"policy_title\": \"Comprehensive Employee Leave Policy\",\n    \"policy_description\": \"A detailed overview of all leave options available to employees, including sick leave, vacation, parental leave, and bereavement leave. Covers all legal requirements and internal procedures. Includes extensive FAQs and scenarios.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/comprehensive-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67111", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels, deductibles, and co-pays are provided in the linked document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67111", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Comprehensive Stock Option Plan\",\n    \"policy_description\": \"A detailed guide outlining the company's stock option plan, including vesting schedules, exercise procedures, tax implications, and eligibility criteria for different employee levels. This document also includes several legal disclaimers and appendices, providing an exhaustive overview of the stock option program. It is crucial to read this document carefully and consult with a financial advisor before making any decisions related to stock options. The plan is designed to reward long-term commitment and align employee interests with shareholder value, while adhering to all relevant regulations and compliance standards.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67112", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67112", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"A detailed document outlining the company's 401k plan, including eligibility, vesting schedules, investment options, loan provisions, and distribution rules. It covers various scenarios and potential tax implications, and includes information on financial planning resources. This policy is designed to support employees in their long-term financial security, offering a range of options to cater to individual needs and risk tolerances. It outlines the company's matching contributions, enrollment procedures, and the process for making changes to investment allocations. Furthermore, it details the procedures for hardship withdrawals and the requirements for qualified domestic relations orders (QDROs).\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67113", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67113", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A highly detailed and complex plan outlining the compensation structure for executive-level employees, including stock options, performance bonuses, and deferred compensation arrangements.  Requires expert legal interpretation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67114", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the company's health insurance benefits for all eligible employees. It covers medical, dental, and vision care. Employees must enroll within 30 days of hire.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67114", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k plan, including eligibility requirements, contribution matching, vesting schedules, loan provisions, and withdrawal options. It also addresses qualified domestic relations orders (QDROs) and compliance with ERISA regulations.  Furthermore, it outlines procedures for beneficiaries and investment choices. The plan aims to provide a secure financial future for our employees, encouraging long-term savings and financial well-being.  We also provide access to financial advisors for personalized guidance and support.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-01-05\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
