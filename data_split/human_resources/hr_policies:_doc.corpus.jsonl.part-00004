{"_id": "human_resources--hr_policies:_doc--p--71293", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the full range of benefits offered to employees, including health insurance, retirement plans, and paid time off. It covers eligibility, enrollment procedures, and plan details.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-v2.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71293", "text": "{\n    \"policy_id\": \"REM-WORK-002\",\n    \"policy_title\": \"Remote Work Arrangement Guidelines\",\n    \"policy_description\": \"This policy details the procedures and expectations for employees working remotely, including equipment requirements and security protocols.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-guidelines.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71294", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the procedures for employees to enroll in the company's health insurance plan. It covers eligibility requirements, enrollment deadlines, and available plan options. Employees are encouraged to review the plan details carefully before making a selection. Further details are available in the linked document.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71294", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Long-Term Disability Benefits\",\n    \"policy_description\": \"This policy provides detailed information regarding the company’s Long-Term Disability (LTD) benefits program.  It covers eligibility criteria, benefit levels, the application process, required documentation, appeal procedures, coordination with other benefits, and potential tax implications. It also contains comprehensive information on definitions of disability, waiting periods, and limitations. The policy adheres to all applicable federal and state regulations.  It outlines the rights and responsibilities of both the employee and the company in the event of a long-term disability. A complete description of the program, including required forms, is available at the link below. This policy is reviewed annually to ensure compliance with current laws and best practices. The plan is administered by a third-party administrator. Employees are encouraged to familiarize themselves with the details of this program to ensure they understand their coverage.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71295", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and provides details on health insurance, wellness programs, and related benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71295", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Complex Stock Option Grant Agreement\",\n    \"policy_description\": \"This policy details the terms and conditions for stock option grants to eligible employees.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-legal-agreement.docx\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71296", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee well-being, including gym membership subsidies, mental health resources, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71296", "text": "{\n    \"policy_id\": \"EMP-RET-001\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including contribution matching and investment options.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71297", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, vision, and wellness programs available to all eligible employees. It emphasizes preventative care and mental health support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71297", "text": "{\n    \"policy_id\": \"TRA-0005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for business-related travel expenses.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71298", "text": "{\n    \"policy_id\": \"EB-2024-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, paid time off, and wellness programs. It aims to promote employee wellbeing and attract top talent.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71298", "text": "{\n    \"policy_id\": \"EB-2022-005\",\n    \"policy_title\": \"Basic Sick Leave Policy\",\n    \"policy_description\": \"This policy provides a limited number of sick days per year for eligible employees. It is a standard policy following legal requirements.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/sick-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71299", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's health insurance, wellness programs, and employee assistance programs. It details coverage levels, eligibility requirements, and procedures for accessing benefits. The policy covers medical, dental, and vision care, as well as mental health resources and preventative wellness initiatives. Employees are encouraged to utilize these benefits to maintain their overall health and well-being. This policy also details the process for requesting accommodations related to health conditions.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71299", "text": "{\n    \"policy_id\": \"RET-PLAN-002\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including eligibility, contribution limits, investment options, and vesting schedule.  Employees can contribute a percentage of their salary to the plan. The company provides a matching contribution up to a certain percentage.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71300", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for physical, mental, and financial wellness.  It includes details on health insurance, employee assistance programs (EAPs), and wellness challenges.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71300", "text": "{\n    \"policy_id\": \"WB-2022-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees experiencing personal or work-related challenges.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2022-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-2022\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71301", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits offered to employees. It includes details on eligibility, coverage levels, and enrollment procedures. It also outlines our employee assistance program.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
