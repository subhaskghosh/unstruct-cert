{"_id": "human_resources--hr_policies:_doc--n--65293", "text": "{\n    \"policy_id\": \"AT-2023-012\",\n    \"policy_title\": \"Attendance and Tardiness Policy\",\n    \"policy_description\": \"Outlines the procedures for reporting absences and tardiness. Strict penalties apply for repeated violations, including disciplinary action and potential termination.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65294", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Mental Health and Wellbeing\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the mental health and overall wellbeing of its employees. It includes resources for counseling, stress management, and work-life balance initiatives.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/hr/wellbeing-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65294", "text": "{\n    \"policy_id\": \"LEAVE-2023-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Details the procedures for applying for and managing extended leaves of absence for various reasons, including medical, family, and personal situations.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-06-01\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/hr/extended-leave-policy?version=1.2&details=comprehensive_guide_for_employees_and_managers_regarding_leaves_of_absence_and_related_procedures\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65295", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance and enhance productivity. It aims to provide a supportive environment for employees while maintaining business needs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work_arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65295", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"This document details the company's Employee Stock Option Plan, including eligibility criteria, vesting schedules, and exercise procedures. This is a complex plan designed for long-term retention and incentivization of key personnel.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Executive Management\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_option_plan.pdf\"\n}"}
