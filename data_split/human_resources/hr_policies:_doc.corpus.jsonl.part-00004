{"_id": "human_resources--hr_policies:_doc--p--71613", "text": "{\n    \"policy_id\": \"WB-2023-ENG-PROD-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health. It includes details on our Employee Assistance Program (EAP), wellness workshops, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
