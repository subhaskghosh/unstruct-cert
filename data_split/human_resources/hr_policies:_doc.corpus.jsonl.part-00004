{"_id": "human_resources--hr_policies:_doc--p--71519", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides eligible employees with up to 16 weeks of paid parental leave following the birth or adoption of a child. It aims to support employees in balancing work and family responsibilities.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Software Development\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/parental_leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71519", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Travel Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for reimbursing employees for travel expenses incurred while conducting company business. It details acceptable expense types and reimbursement procedures.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
