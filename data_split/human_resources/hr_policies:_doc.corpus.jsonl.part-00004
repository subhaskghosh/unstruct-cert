{"_id": "human_resources--hr_policies:_doc--p--70038", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees seeking flexible work arrangements, including remote work, compressed workweeks, and flexible hours. It aims to enhance work-life balance and employee productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work.pdf\"\n}"}
