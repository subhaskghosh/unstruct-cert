{"_id": "human_resources--hr_policies:_doc--p--67695", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy details the health insurance options available to all full-time employees, including medical, dental, and vision coverage. It outlines eligibility requirements, enrollment procedures, premium contributions, and claim filing instructions. This policy aims to provide comprehensive healthcare benefits to support employee well-being and productivity. Specific details regarding plan options and costs are available in the attached document. Updates to provider networks will be communicated annually.  Employees are encouraged to review the plan documents carefully to understand their coverage.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee_health_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67695", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Sales Training Program\",\n    \"policy_description\": \"This policy outlines the requirements and guidelines for the sales training program. All new sales representatives must complete this program within their first 30 days of employment.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales_training.docx\"\n}"}
