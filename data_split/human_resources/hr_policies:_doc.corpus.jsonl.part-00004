{"_id": "human_resources--hr_policies:_doc--p--65825", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the options available to employees for flexible work arrangements, including remote work, flextime, and compressed workweeks, aiming to improve work-life balance and employee satisfaction.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65825", "text": "{\n    \"policy_id\": \"LG-2023-005\",\n    \"policy_title\": \"Non-Disclosure Agreement - Confidential Information\",\n    \"policy_description\": \"This legally binding agreement details the protection of confidential company information and intellectual property.  It outlines strict protocols for handling sensitive data and consequences for breaches of confidentiality. This policy is intended to comply with all applicable state and federal regulations regarding data privacy.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/nda\"\n}"}
