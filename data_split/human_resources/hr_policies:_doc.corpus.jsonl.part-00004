{"_id": "human_resources--hr_policies:_doc--n--62162", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Employee Compensation and Performance Review\",\n    \"policy_description\": \"This detailed policy covers all aspects of employee compensation, including salary structure, bonus programs, performance review processes, and equity options. It addresses various compensation scenarios and legal requirements related to pay equity and wage transparency. The policy includes sections on merit increases, cost-of-living adjustments, and promotion guidelines.  This is a very extensive document outlining all pay related matters for all employees.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62163", "text": "{\n    \"policy_id\": \"PTO-2024-001\",\n    \"policy_title\": \"Vacation and Personal Time Off\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing vacation and personal time off. It covers accrual rates, approval processes, and carryover limitations.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-06-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-policy.pdf\"\n}"}
