{"_id": "human_resources--hr_policies:_doc--p--71612", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Performance Bonus Program\",\n    \"policy_description\": \"This policy outlines the criteria and process for awarding performance-based bonuses to eligible employees. The program is designed to incentivize high performance and reward contributions to company success. It focuses on clear goals and measurable results.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/bonus-program.pdf\"\n}"}
