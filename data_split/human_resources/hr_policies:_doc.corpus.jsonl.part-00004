{"_id": "human_resources--hr_policies:_doc--p--65531", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Remote Work and Employee Benefits\",\n    \"policy_description\": \"This policy outlines the benefits available to employees working remotely, including health insurance, retirement plans, and stipends for home office equipment. It details eligibility requirements and procedures for accessing these benefits while maintaining compliance with relevant regulations.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/remote-work-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65531", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the procedures for enrolling in company-sponsored health insurance plans. Includes information on coverage options, premium costs, and enrollment deadlines.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance.pdf\"\n}"}
