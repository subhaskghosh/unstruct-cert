{"_id": "human_resources--hr_policies:_doc--p--71625", "text": "{\n    \"policy_id\": \"BP-2023-015\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, and a 401k retirement plan. It details eligibility requirements, enrollment procedures, and coverage details. Includes a new wellness program focusing on mental and physical health.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/bp-2023-015.pdf\"\n}"}
