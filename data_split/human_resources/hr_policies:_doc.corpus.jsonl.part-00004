{"_id": "human_resources--hr_policies:_doc--n--62128", "text": "{\n    \"policy_id\": \"REMOTE-WORK-002\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy defines the guidelines and procedures for employees working remotely, including eligibility criteria, security protocols, and performance expectations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62129", "text": "{\n    \"policy_id\": \"EMP-BEN-0012\",\n    \"policy_title\": \"Employee 401k Contribution Matching\",\n    \"policy_description\": \"This policy outlines the company's contribution matching program for employee 401k plans, aimed at supporting long-term financial security.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62129", "text": "{\n    \"policy_id\": \"EMP-BEN-0005\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"Detailed explanation of health, dental, and vision benefits including provider networks, claim procedures, and coverage levels. This includes information on preventative care, specialist visits, emergency services, and prescription drug coverage.  It also covers eligibility requirements, enrollment processes, and potential cost-sharing arrangements for employees and their dependents. The policy details limitations, exclusions, and procedures for appealing coverage decisions. It also addresses compliance with relevant healthcare regulations. Additionally, it contains comprehensive information about wellness programs and resources available to employees to promote their overall health and wellbeing. A section is also dedicated to addressing frequently asked questions and providing contact information for benefit administrators and insurance providers. This document is regularly updated to reflect changes in healthcare laws and company benefits offerings. There is also information pertaining to COBRA and other continuing coverage options.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62130", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the complete range of employee benefits, including health insurance, retirement plans, and paid time off. Updated to reflect changes in the Affordable Care Act.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/emp-ben-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62130", "text": "{\n    \"policy_id\": \"REM-POL-005\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"Outlines the guidelines for employees working remotely, including eligibility, equipment, and security protocols.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2024-01-28\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work/rem-pol-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62131", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all full-time employees, designed to promote long-term employee well-being and financial security. It includes health insurance, retirement plans, and paid time off.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/employee_benefits_package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62131", "text": "{\n    \"policy_id\": \"TEMP-BEN-002\",\n    \"policy_title\": \"Temporary Staff Benefits\",\n    \"policy_description\": \"Details benefits offered to temporary employees during their assignment. This is a streamlined package focusing on immediate needs.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-06-01\",\n    \"applicable_departments\": [\n        \"Contractors\",\n        \"Temporary Staffing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/temp_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62132", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Details on plan options and enrollment are available in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62132", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This comprehensive plan details the terms and conditions governing the granting of stock options to executive-level employees. It includes vesting schedules, exercise prices, and other relevant financial information. This is a legally binding document and requires careful review by all participants. It is extremely complex and may be confusing to some. The plan is designed to incentivize long-term commitment and align employee interests with shareholder value.  It covers details about tax implications and reporting requirements.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62133", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee 401k Contribution Matching\",\n    \"policy_description\": \"This policy outlines the company's 401k contribution matching program. The company matches 50% of employee contributions up to 6% of their salary. Eligibility requirements and vesting schedules are detailed in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62133", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy provides detailed information regarding the company's comprehensive health insurance plan, including coverage levels, deductible amounts, co-pays, out-of-pocket maximums, provider networks, and claim submission procedures. The plan offers a range of options including HMO, PPO, and HSA plans.  It also details provisions for mental health coverage, preventative care, and prescription drug benefits.  This policy is subject to change annually based on renewal negotiations with the insurance provider.  Furthermore, it covers the procedures for appealing claim denials and accessing additional resources for healthcare navigation.  This document also outlines the process for adding dependents to the plan and the associated costs.  It's a very complex document due to legal requirements and plan design variations.  ...\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62134", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy details the Employee Assistance Program, providing confidential support for employees experiencing personal or work-related challenges.  It includes access to counseling services, resources for stress management, and work-life balance initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62134", "text": "{\n    \"policy_id\": \"DISC-002\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy outlines the process for addressing employee performance issues, including verbal warnings, written warnings, and potential termination. It emphasizes the importance of documentation and fair treatment. A performance improvement plan will be implemented for employees who do not meet expectations.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62135", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, focusing on mental and physical health, and promoting work-life balance. It provides resources for stress management, fitness programs, and confidential counseling services.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62135", "text": "{\n    \"policy_id\": \"TRVL-2022-012\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to claim reimbursement for business travel expenses, including airfare, accommodation, and meals. It emphasizes cost-effectiveness and adherence to company guidelines.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
