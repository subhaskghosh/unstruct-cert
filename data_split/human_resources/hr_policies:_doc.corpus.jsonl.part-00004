{"_id": "human_resources--hr_policies:_doc--n--62247", "text": "{\n    \"policy_id\": \"EMP-TRAIN-012\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program designed to enhance the leadership skills of managers and high-potential employees. This multi-stage program includes workshops, mentoring, and project assignments. Detailed curriculum and assessment criteria are provided in the attached document. The program is intended to foster innovation and strategic thinking throughout the organization. It also covers change management techniques and effective communication strategies. Participants will be evaluated based on their ability to apply learned concepts to real-world scenarios. The program concludes with a capstone project and a formal presentation to senior leadership.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program.pdf\"\n}"}
