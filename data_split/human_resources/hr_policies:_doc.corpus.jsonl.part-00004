{"_id": "human_resources--hr_policies:_doc--n--67053", "text": "{\n    \"policy_id\": \"LEGAL-COMP-005\",\n    \"policy_title\": \"Comprehensive Legal Compliance for International Operations\",\n    \"policy_description\": \"This policy details the legal requirements for all international operations, covering a wide range of regulatory issues including data privacy, labor laws, and intellectual property protection.  It requires significant training and legal review.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/legal-compliance.pdf\"\n}"}
