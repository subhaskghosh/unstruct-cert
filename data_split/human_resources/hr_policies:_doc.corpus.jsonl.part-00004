{"_id": "human_resources--hr_policies:_doc--p--64304", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees in achieving a healthy work-life balance through flexible work arrangements, including remote work options, flextime, and compressed workweeks.  It aims to improve employee wellbeing and reduce stress.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-engineering.pdf\"\n}"}
