{"_id": "human_resources--hr_policies:_doc--p--68700", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the health and wellness benefits available to all employees, including medical, dental, and vision coverage. It emphasizes preventative care and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68700", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Advanced Stock Option Grant Policy\",\n    \"policy_description\": \"This is a complex policy detailing the terms and conditions for advanced stock option grants to key personnel. It includes vesting schedules, exercise windows, and tax implications. A comprehensive understanding of financial regulations is necessary.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/stock-options\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68701", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, offering resources for physical and mental health support. Includes gym membership discounts and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68701", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"Detailed plan covering 401k matching, pension options, and financial planning resources. This outlines all aspects of the employee retirement benefit program. Including vesting schedules and contribution limits. And information on rollovers, hardship withdrawals and taxation. It has a lot of legal requirements that need to be met to maintain compliance.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68702", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, covering gym memberships, mental health resources, and health screenings.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68702", "text": "{\n    \"policy_id\": \"EMP-LEAV-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Details the procedures for requesting and approving extended leaves of absence for various reasons, including medical and personal circumstances. This is a highly complex policy, requiring extensive documentation.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-02-22\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave.pdf\"\n}"}
