{"_id": "human_resources--hr_policies:_doc--p--61905", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the company's health insurance benefits for eligible employees. It covers medical, dental, and vision care. Details on coverage levels, premiums, and enrollment procedures are available in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61905", "text": "{\n    \"policy_id\": \"EB-2022-001\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to all full-time employees, including 401k matching contributions, vesting schedules, and loan options. It outlines eligibility requirements, investment choices, and procedures for withdrawing funds. This is a detailed document covering multiple aspects of retirement planning.  It also outlines the company’s commitment to financial wellness and provides resources for employees to help them plan for their future. This plan is constantly evolving to remain competitive within the industry and to meet the changing needs of our employees.  This plan aims to provide employees with the resources and support necessary to achieve their financial goals during and after their employment with the company. It details specific contribution levels, eligibility rules, and procedures for accessing funds.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61906", "text": "{\n    \"policy_id\": \"POL-007\",\n    \"policy_title\": \"Paid Time Off (PTO) Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize paid time off for vacation, sick leave, and personal reasons.  It aims to support employee well-being and work-life balance.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy.pdf\"\n}"}
