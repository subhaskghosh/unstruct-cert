{"_id": "human_resources--hr_policies:_doc--p--61533", "text": "{\n    \"policy_id\": \"RW-2023-ENG-PROD-001\",\n    \"policy_title\": \"Remote Work Policy - Engineering & Product\",\n    \"policy_description\": \"This policy outlines the guidelines and expectations for employees in the Engineering and Product departments who work remotely. It emphasizes trust, accountability, and maintaining productivity while allowing for flexible work arrangements to promote work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy-eng-prod\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61533", "text": "{\n    \"policy_id\": \"PTO-2022-ALL-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"Details regarding accrual rates, usage, and carryover of paid time off for all employees.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61534", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, physical fitness, and financial planning.  It focuses on preventative care and support for a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61534", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the procedures for enrolling in company-sponsored health insurance plans. This document outlines eligibility requirements, plan options, and deadlines for enrollment. No specific benefits support is mentioned.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61535", "text": "{\n    \"policy_id\": \"BNF-2023-101\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees must enroll within 30 days of hire. Details regarding coverage levels and costs are available on the company intranet.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61535", "text": "{\n    \"policy_id\": \"BNF-2022-050\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This document details the company's 401k plan, including eligibility requirements, contribution matching, vesting schedules, investment options, and withdrawal procedures.  It also covers related tax implications and provides guidance on financial planning. The plan is administered by Fidelity Investments and subject to ERISA regulations.  Detailed information regarding investment options is available within the Fidelity portal and in appendices A, B, and C.  Employees are encouraged to consult with a financial advisor regarding their investment choices. The plan is reviewed annually, and amendments will be communicated to all participants.  This policy addresses several potential scenarios regarding early withdrawal, hardship distributions, and rollovers to other qualified plans.  Any questions should be directed to the HR Benefits department.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61536", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym membership reimbursements and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
