{"_id": "human_resources--hr_policies:_doc--p--71852", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides extended paid parental leave to eligible employees to support family wellbeing and work-life balance. It covers both maternity and paternity leave.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental_leave_policy.pdf\"\n}"}
