{"_id": "human_resources--hr_policies:_doc--p--71158", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"Details the complete employee benefits package including health insurance, retirement plans, and paid time off. Covers eligibility, enrollment procedures, and plan details. Addresses frequent employee queries regarding benefits options and costs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71158", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Outlines the process for reimbursing employees for travel expenses incurred while on company business. Includes guidelines on allowable expenses, documentation requirements, and approval procedures.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71159", "text": "{\n    \"policy_id\": \"EB-2024-003\",\n    \"policy_title\": \"Health Insurance Benefits for New Employees\",\n    \"policy_description\": \"Details regarding health, dental, and vision insurance options available to new employees, including enrollment procedures and coverage details. Addresses common questions from new hires regarding benefits packages.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/eb-2024-003\"\n}"}
