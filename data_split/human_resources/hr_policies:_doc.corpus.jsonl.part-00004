{"_id": "human_resources--hr_policies:_doc--n--65648", "text": "{\n    \"policy_id\": \"LOA-2022-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details procedures for extended leaves of absence, including medical leave, family leave, and personal leave. It includes extensive legal disclaimers and detailed eligibility criteria.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_of_absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65649", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources and programs to support a healthy lifestyle. It covers topics like mental health support, fitness initiatives, and ergonomic assessments.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65649", "text": "{\n    \"policy_id\": \"LE-002\",\n    \"policy_title\": \"Legal Compliance - Data Privacy\",\n    \"policy_description\": \"This policy details the company's adherence to data privacy regulations, including GDPR and CCPA. It covers data collection, storage, processing, and security protocols, and outlines employee responsibilities related to data protection. This is a very detailed and extensive document.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2024-01-05\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65650", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees. The EAP provides confidential support and resources for personal and work-related challenges. It aims to promote employee wellbeing and a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65650", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence - Detailed Guidelines\",\n    \"policy_description\": \"This document provides a comprehensive overview of all types of extended leave, including eligibility requirements, application procedures, documentation needs, and return-to-work protocols. It encompasses all legal and company compliance regulations related to extended leave, covering a broad range of scenarios. This document also details the interplay between various leave types and benefits continuation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended_leave_guide.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65651", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's health insurance plan, including coverage, eligibility, and enrollment procedures. It's designed to be straightforward and easy to follow.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65651", "text": "{\n    \"policy_id\": \"COM-005\",\n    \"policy_title\": \"Complex Stock Option Grant Agreement\",\n    \"policy_description\": \"This policy details the complex terms and conditions of stock option grants for executive-level employees, including vesting schedules, tax implications, and exercise procedures. Legal review is highly recommended before making any decisions based on this policy.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65652", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"Details the extended parental leave benefits available to eligible employees, including provisions for both birth and adoption. Aligns with current best practices to support work-life balance.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental_leave_enhanced.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65652", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Code of Conduct Policy\",\n    \"policy_description\": \"Outlines the expected ethical behavior and professional conduct for all employees. Covers areas such as conflicts of interest, confidentiality, and harassment.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/code_of_conduct.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65653", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details all benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It emphasizes employee wellbeing and provides resources for maximizing benefit utilization.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
