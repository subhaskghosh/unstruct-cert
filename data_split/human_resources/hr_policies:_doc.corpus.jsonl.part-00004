{"_id": "human_resources--hr_policies:_doc--n--64266", "text": "{\n    \"policy_id\": \"EMP-COND-002\",\n    \"policy_title\": \"Employee Conduct Guidelines\",\n    \"policy_description\": \"Outlines the expected behavior and professional conduct of all employees.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/conduct-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64267", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can enroll during the open enrollment period or upon hire. Details regarding coverage levels and costs are available in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64267", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including contribution matching, vesting schedules, investment options, and withdrawal procedures. It also covers eligibility requirements, loan provisions, and beneficiary designations. This plan is designed to help employees save for their future financial security, and includes extensive information regarding applicable tax laws, regulations, and compliance requirements. Furthermore, it addresses scenarios involving job changes, disability, and estate planning.  The plan is regularly reviewed and updated to ensure it remains competitive and compliant with all applicable laws. Employee training resources are also available. Detailed information can be found in the attached documentation. This policy also covers considerations for international assignments and expatriate benefits, as well as options for early retirement. In addition, the policy describes the process for rollovers from other retirement plans and the options for receiving distributions. It also addresses the impact of qualified domestic relations orders (QDROs) and other legal issues that may arise.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64268", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for the Sales department, including targets, payout rates, and performance reviews.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission.pdf\"\n}"}
