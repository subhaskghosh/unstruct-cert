{"_id": "human_resources--hr_policies:_doc--n--68967", "text": "{\n    \"policy_id\": \"EXEC-COMP-001\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Outlines the terms and conditions of the stock option plan for senior executives, including vesting schedules, exercise prices, and tax implications. Requires significant financial and legal expertise.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive_stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68968", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness benefits available to all employees, including gym memberships, mental health resources, and preventative care programs. It aims to support employee health and well-being. This policy includes information on health savings accounts and flexible spending accounts.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp_wellness_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68968", "text": "{\n    \"policy_id\": \"EMP-LEAV-005\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy details the provisions for employees taking time off due to the death of a family member. It outlines eligibility requirements, duration of leave, and related procedures. The process is straightforward and intended to provide support during difficult times.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/bereavement_leave.pdf\"\n}"}
