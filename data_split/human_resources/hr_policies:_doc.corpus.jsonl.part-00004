{"_id": "human_resources--hr_policies:_doc--n--65013", "text": "{\n    \"policy_id\": \"LEG-COMP-002\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"Detailed legal guidelines concerning the Employee Retirement Income Security Act of 1974, including specific reporting requirements and fiduciary responsibilities. This document is intended for HR specialists and legal counsel.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/erisa_compliance.pdf\"\n}"}
