{"_id": "human_resources--hr_policies:_doc--p--64503", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Stress Management\",\n    \"policy_description\": \"This policy outlines resources and support available to employees to promote wellbeing and manage work-related stress. It includes information on mental health benefits, employee assistance programs, and stress reduction techniques.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-wb2024-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64503", "text": "{\n    \"policy_id\": \"TR-2023-005\",\n    \"policy_title\": \"Travel Reimbursement Guidelines\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business travel expenses. It covers topics such as airfare, lodging, and mileage.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement-tr2023-005\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64504", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee financial health through educational resources, financial planning tools, and access to benefit programs designed to improve financial literacy and stability.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/financialwellnessprogram.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64504", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Policy\",\n    \"policy_description\": \"This policy details the health insurance coverage options available to employees and their families.\",\n    \"effective_date\": \"2022-10-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/healthinsurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64505", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Sales Commission Plan\",\n    \"policy_description\": \"Details the commission structure for the Sales department, including performance targets and payout schedules. It also outlines eligibility for bonus incentives.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64505", "text": "{\n    \"policy_id\": \"BP-2022-012\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"Outlines the guidelines and procedures for employees requesting a remote work arrangement.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64506", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the procedures for enrolling in company-sponsored health insurance plans. Employees are eligible after 30 days of employment. Details on plan options and costs are available on the benefits portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64506", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to all eligible employees, including 401k matching, pension options, and financial planning resources. It covers vesting schedules, contribution limits, loan provisions, and distribution options.  This policy aims to provide a secure financial future for our employees by offering a variety of investment choices and planning support. Employees are encouraged to participate in regular financial wellness seminars offered by the company. The policy also addresses issues related to beneficiary designations and early withdrawals, along with the associated tax implications.  Further details, including investment performance reports, are available on the benefits portal.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64507", "text": "{\n    \"policy_id\": \"EMP-BEN-MED-2024\",\n    \"policy_title\": \"Medical Benefits Plan\",\n    \"policy_description\": \"Details regarding health insurance coverage for employees.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/medical-benefits-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64507", "text": "{\n    \"policy_id\": \"EMP-BEN-STK-2023\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"Guidelines for granting and exercising employee stock options.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64508", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Spending Account (FSA) Policy\",\n    \"policy_description\": \"This policy details the guidelines for employees to utilize Flexible Spending Accounts for eligible healthcare and dependent care expenses. It supports a modern work-life balance and promotes employee wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/fsa_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64508", "text": "{\n    \"policy_id\": \"EMP-PERF-002\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"This policy outlines the process for conducting annual performance reviews for all employees. It details the evaluation criteria and feedback mechanisms.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance_review.pdf\"\n}"}
