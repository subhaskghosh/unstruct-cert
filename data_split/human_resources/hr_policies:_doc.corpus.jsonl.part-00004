{"_id": "human_resources--hr_policies:_doc--p--62826", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee 401k Contribution Matching\",\n    \"policy_description\": \"This policy outlines the company's contribution matching program for employees participating in the 401k retirement plan. The company matches 50% of employee contributions up to 6% of their salary.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62826", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy provides a detailed overview of all employee benefits, including health insurance, dental insurance, vision insurance, life insurance, disability insurance, paid time off, sick leave, parental leave, employee assistance programs, wellness programs, and financial planning resources. It also covers eligibility requirements, enrollment procedures, and cost-sharing arrangements. The policy is regularly updated to comply with changing regulations and market conditions. Detailed information about each benefit is available in separate policy documents. This comprehensive guide is meant to answer all possible questions. \",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/full-benefits-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62827", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Comprehensive Health & Wellness Benefits\",\n    \"policy_description\": \"Details of health, dental, vision, and wellness programs for employees. Includes information on coverage, eligibility, and enrollment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62827", "text": "{\n    \"policy_id\": \"TR-2023-012\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"Guidelines for reimbursing employees for travel expenses incurred during business trips.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement_policy.pdf\"\n}"}
