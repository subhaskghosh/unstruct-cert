{"_id": "human_resources--hr_policies:_doc--n--67023", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Compensation and Benefits\",\n    \"policy_description\": \"Comprehensive details regarding executive compensation packages, including stock options, bonuses, and long-term incentives. This policy also outlines the eligibility requirements and performance criteria for executive benefits programs.  A highly detailed and lengthy document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/executive-compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67024", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Covers a range of issues including stress, anxiety, and work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wb-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67024", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy outlines procedures for requesting and granting extended leaves of absence for various reasons, including medical leave, family care leave, and personal leave. It details eligibility requirements, documentation needed, and the impact on benefits and job security. This policy includes complex procedures for international assignments, multiple types of leave, and return-to-work arrangements with detailed legal compliance notes. It aims to provide flexibility while ensuring operational continuity.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/lv-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67025", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67025", "text": "{\n    \"policy_id\": \"EMP-LEAVE-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details procedures for requesting and taking extended leaves of absence for various reasons, including medical leave, parental leave, and personal leave. It covers eligibility requirements, documentation processes, and benefits continuation during the leave period. Includes detailed legal considerations and compliance requirements spanning multiple jurisdictions and providing detailed scenarios and a comprehensive checklist for managers.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67026", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage details, enrollment procedures, and claim submission guidelines are provided.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67026", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Compensation & Equity Grants\",\n    \"policy_description\": \"This policy details the compensation structure, including base salary, performance bonuses, and equity grants, for executive-level employees. It covers vesting schedules, stock option exercises, and related tax implications.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67027", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the various benefits available to employees, including health insurance, paid time off, and wellness programs. It aims to support employees' overall wellbeing and foster a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-benefits.pdf\"\n}"}
