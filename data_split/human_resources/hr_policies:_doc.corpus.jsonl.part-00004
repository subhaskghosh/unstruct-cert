{"_id": "human_resources--hr_policies:_doc--n--64584", "text": "{\n    \"policy_id\": \"PTO-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy describes the guidelines for requesting and utilizing paid time off for vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64585", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the full range of benefits available to employees, including health insurance, retirement plans, paid time off, parental leave, and wellness programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64585", "text": "{\n    \"policy_id\": \"PTO-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the accrual and usage of paid time off for vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/pto_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64586", "text": "{\n    \"policy_id\": \"BP-2023-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for employees seeking flexible work arrangements, including remote work, flextime, and compressed workweeks. It aims to support employee work-life balance and improve overall productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64586", "text": "{\n    \"policy_id\": \"BP-2022-012\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process and guidelines for employees to submit and receive reimbursement for business-related travel expenses.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64587", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to promote work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
