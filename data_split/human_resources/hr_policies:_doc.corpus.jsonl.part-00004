{"_id": "human_resources--hr_policies:_doc--p--71932", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits - Employee & Family\",\n    \"policy_description\": \"This policy outlines the comprehensive health insurance benefits available to all eligible employees and their families. It details coverage options, premium contributions, and claim procedures. We strive to provide accessible and affordable healthcare.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-ben0012.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71932", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"401k Retirement Plan - Compliance Details\",\n    \"policy_description\": \"Detailed legal compliance information regarding the company's 401k retirement savings plan. This document outlines specific regulatory requirements and administrative procedures as per ERISA guidelines. Contributions, vesting schedules, and withdrawal rules are detailed.  This is a technical document intended for plan administrators.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k-compliance-ben0005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71933", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the employee wellness benefit program, including gym membership discounts, mental health resources, and annual health screenings. It aims to promote employee well-being and reduce healthcare costs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefit-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71933", "text": "{\n    \"policy_id\": \"COMP-0005\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This policy details the compensation structure for executive-level employees, including salary, bonus, stock options, and other equity grants. It covers eligibility criteria and performance-based incentives.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation\"\n}"}
