{"_id": "human_resources--hr_policies:_doc--p--68310", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering flexible work options, wellness programs, and resources for mental health support. It details eligibility, application procedures, and guidelines for remote work, compressed workweeks, and other flexible arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-flex-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68310", "text": "{\n    \"policy_id\": \"COMP-003\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for the Sales department, including targets, payout rates, and performance metrics. It outlines the process for calculating and distributing commissions, as well as dispute resolution procedures.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68311", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Tuition Reimbursement Program\",\n    \"policy_description\": \"This policy outlines the process for employees to apply for tuition reimbursement for approved courses related to their role or career development.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/tuition-reimbursement-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68311", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Paid Time Off (PTO) Policy\",\n    \"policy_description\": \"Details regarding the accrual and usage of paid time off for employees.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68312", "text": "{\n    \"policy_id\": \"WELL-003\",\n    \"policy_title\": \"Employee Mental Health Support\",\n    \"policy_description\": \"This policy outlines resources and procedures for employees experiencing mental health challenges, promoting a supportive work environment and providing access to counseling services. It emphasizes proactive wellbeing practices and manager training.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/mental_health_support.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68312", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Comprehensive Benefits Package - 2024\",\n    \"policy_description\": \"Details the full range of employee benefits including health insurance, retirement plans, and paid time off.  This document is a comprehensive listing of available benefits and does not offer guidance on usage or wellbeing.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/2024_benefits_package.pdf\"\n}"}
