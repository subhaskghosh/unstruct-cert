{"_id": "human_resources--hr_policies:_doc--n--61971", "text": "{\n    \"policy_id\": \"TRAV-2022-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This comprehensive policy details the procedures for submitting and processing travel expense reports. It covers allowable expenses, documentation requirements, and reimbursement timelines.  It also includes details on per diem rates, transportation policies, and approval workflows for international travel. The document outlines specific guidelines for different travel classes, entertainment allowances, and the handling of unexpected travel disruptions.  It's important to adhere to these guidelines to ensure prompt and accurate reimbursement.  Further details are available in the attached appendix covering specific country regulations and tax implications. This policy is applicable to all employees travelling on company business, and requires pre-approval via the Concur system.  Repeated violations may result in disciplinary action.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61972", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, aimed at promoting work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61972", "text": "{\n    \"policy_id\": \"BP-2022-012\",\n    \"policy_title\": \"Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for legitimate business expenses.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/expense-reimbursement.pdf\"\n}"}
