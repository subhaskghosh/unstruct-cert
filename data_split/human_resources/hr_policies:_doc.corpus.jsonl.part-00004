{"_id": "human_resources--hr_policies:_doc--p--65931", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Spending Account (FSA) Guidelines\",\n    \"policy_description\": \"Details the guidelines for utilizing Flexible Spending Accounts for eligible employee expenses, including healthcare and dependent care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/fsa-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65931", "text": "{\n    \"policy_id\": \"EMP-LEAVE-001\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"Outlines the procedures and eligibility requirements for employees requesting sick leave.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Operations\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65932", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential counseling and support services for personal and work-related issues. The EAP aims to promote employee wellbeing and address stress, anxiety, and other mental health concerns.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65932", "text": "{\n    \"policy_id\": \"LE-005\",\n    \"policy_title\": \"Legal Compliance for International Assignments\",\n    \"policy_description\": \"This policy details the complex legal requirements and procedures for employees on international assignments, covering visa applications, tax regulations, and employment law considerations across various jurisdictions. It requires significant legal expertise for implementation and interpretation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Finance\",\n        \"International Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/international-assignment-policy\"\n}"}
