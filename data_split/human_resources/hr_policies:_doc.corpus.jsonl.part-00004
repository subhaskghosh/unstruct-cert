{"_id": "human_resources--hr_policies:_doc--n--62047", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"Detailed explanation of the compensation structure for senior executive leadership, including performance-based bonuses, stock options, and other benefits. This is a complex document covering multiple tiers and vesting schedules.  It is intended for internal HR use only, and outlines the criteria for evaluating executive performance and determining incentive payouts. Legal review is required for any changes.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/executive_plan.pdf\"\n}"}
