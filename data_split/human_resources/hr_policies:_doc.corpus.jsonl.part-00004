{"_id": "human_resources--hr_policies:_doc--n--65972", "text": "{\n    \"policy_id\": \"IT-005\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"Details the guidelines for appropriate use of company-owned computers, software, and network resources.  Covers security protocols, data privacy, and acceptable online behavior. This document includes detailed legal disclaimers.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/acceptable-use-policy.pdf\"\n}"}
