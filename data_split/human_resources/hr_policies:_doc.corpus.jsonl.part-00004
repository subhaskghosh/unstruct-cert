{"_id": "human_resources--hr_policies:_doc--p--64529", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the process for employees to enroll in company-sponsored health insurance plans. Includes details on plan options, eligibility, and enrollment deadlines.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64529", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Details the company's stock option and restricted stock unit (RSU) grant program, including vesting schedules, exercise procedures, and tax implications. Requires extensive legal review and compliance checks.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan\"\n}"}
