{"_id": "human_resources--hr_policies:_doc--p--70273", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Professional Development Reimbursement\",\n    \"policy_description\": \"This policy outlines the process for employees to request reimbursement for approved professional development courses and certifications. It supports continuous learning and skill enhancement.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/development_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70273", "text": "{\n    \"policy_id\": \"WB-2022-001\",\n    \"policy_title\": \"Employee Wellness Program - Gym Membership\",\n    \"policy_description\": \"This policy details the company's contribution towards employee gym memberships to promote physical health.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/gym_membership.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70274", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees. It includes details on medical, dental, vision, and mental health coverage, as well as wellness programs and resources. The company is committed to supporting the health and wellbeing of its employees, and this policy is designed to provide access to high-quality, affordable care. Employees are encouraged to utilize these benefits to maintain their physical and mental health. Coverage options are updated annually during open enrollment. Details regarding eligibility, enrollment procedures, and plan summaries are available on the HR portal. This policy also covers preventative care, prescription drug coverage, and out-of-network care guidelines.  Employees can contact the HR department with questions.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70274", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Short-Term Disability\",\n    \"policy_description\": \"This policy provides short-term disability benefits to eligible employees who are unable to work due to illness or injury. Benefits are paid for a limited period, as defined in the policy. Employees must meet certain requirements to qualify for benefits. Contact HR for claim forms and more information.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70275", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym memberships, mental health resources, and annual health screenings. It aims to create a supportive work environment and boost employee morale.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70275", "text": "{\n    \"policy_id\": \"EMP-TRAIN-012\",\n    \"policy_title\": \"Leadership Development Training\",\n    \"policy_description\": \"This policy details the training programs available to managers and supervisors to enhance their leadership skills. It covers topics like conflict resolution, performance management, and team building.\",\n    \"effective_date\": \"2023-02-20\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-training.pdf\"\n}"}
