{"_id": "human_resources--hr_policies:_doc--n--67341", "text": "{\n    \"policy_id\": \"LTO-2024-001\",\n    \"policy_title\": \"Long-Term Overtime Approval\",\n    \"policy_description\": \"A comprehensive document detailing the approval process for long-term overtime requests, including justifications, managerial approvals, and impact assessments.  It covers various scenarios, legal compliance considerations, and financial implications, and provides a detailed step-by-step guide for both employees and managers. The policy also contains links to relevant legal documentation and internal training materials. It is meant to be a complete guide to navigating overtime requests that exceed the standard limit.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/lto\"\n}"}
