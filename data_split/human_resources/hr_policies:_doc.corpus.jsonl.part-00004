{"_id": "human_resources--hr_policies:_doc--p--65099", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for employees requesting a remote work arrangement to support work-life balance and reduce commute-related stress.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-wb-001\"\n}"}
