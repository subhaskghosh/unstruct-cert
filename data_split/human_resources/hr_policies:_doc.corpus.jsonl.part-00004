{"_id": "human_resources--hr_policies:_doc--p--67764", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the comprehensive health, dental, and vision benefits offered to all eligible employees. It includes information on coverage levels, eligibility requirements, enrollment procedures, and wellness programs.  It also outlines the company's commitment to supporting employee well-being and provides resources for preventative care. Specific details regarding premium contributions are also available in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67764", "text": "{\n    \"policy_id\": \"LVE-2022-005\",\n    \"policy_title\": \"Leave of Absence Procedures\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and taking various types of leave, including sick leave, personal leave, and family leave. It is intended to ensure compliance with all applicable laws and regulations.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/leave-procedures.pdf\"\n}"}
