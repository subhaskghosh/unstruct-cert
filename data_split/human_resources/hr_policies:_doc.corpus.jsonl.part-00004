{"_id": "human_resources--hr_policies:_doc--p--70034", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to promote work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70034", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans. Covers eligibility, plan options, and enrollment deadlines.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment.pdf\"\n}"}
