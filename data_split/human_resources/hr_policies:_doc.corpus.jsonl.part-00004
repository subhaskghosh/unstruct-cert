{"_id": "human_resources--hr_policies:_doc--p--67233", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through flexible work arrangements, wellness resources, and employee assistance programs. It aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-program.pdf\"\n}"}
