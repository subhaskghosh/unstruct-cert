{"_id": "human_resources--hr_policies:_doc--p--67319", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees are responsible for a portion of the premium, as detailed in the benefits enrollment guide.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67319", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including eligibility requirements, contribution matching, vesting schedule, and investment options. Employees are encouraged to participate to secure their financial future.  The plan provides a variety of investment choices, with professional guidance available through our financial advisor.  This also outlines rules surrounding hardship withdrawals, loan options, and rollovers to other accounts. Detailed information on fund performance and fees are available in the plan document. It includes information about qualified domestic relations orders and beneficiary designations.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
