{"_id": "human_resources--hr_policies:_doc--n--61920", "text": "{\n    \"policy_id\": \"EB-2022-010\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61921", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the procedures for employees to enroll in the company's health insurance plan. It covers eligibility, enrollment deadlines, and available plan options. Employees can find more details on the HR portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61921", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company’s comprehensive retirement plan, including 401(k) contributions, vesting schedules, loan provisions, and distribution options. It aims to provide employees with a secure financial future post-retirement. Eligibility requirements, contribution limits, and investment choices are clearly defined. Employees are encouraged to attend financial planning workshops to maximize their benefits. This plan is subject to ERISA regulations and is regularly audited to ensure compliance. Amendments will be communicated promptly to all participants.  The plan administrator is available to answer questions and provide support.  Detailed enrollment information and beneficiary designation forms can be found on the HR portal. It also includes details about stock options, restricted stock units, and other equity-based compensation plans. Finally, it outlines the process for rollovers and transfers of funds from other retirement accounts.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61922", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines comprehensive health, dental, and vision benefits available to all employees, with a strong focus on preventative care and employee well-being. We strive to create a supportive environment where employees can thrive.\",\n    \"effective_date\": \"2022-11-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61922", "text": "{\n    \"policy_id\": \"TRAV-005\",\n    \"policy_title\": \"Corporate Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the guidelines and procedures for reimbursing employees for travel expenses incurred during business trips. It focuses on cost control and compliance with company travel regulations.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement\"\n}"}
