{"_id": "human_resources--hr_policies:_doc--n--64967", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, including 401k matching, pension options, and financial planning resources. It covers eligibility requirements, vesting schedules, investment options, and withdrawal procedures. It also outlines the responsibilities of both employees and the company in managing the retirement plan.  Detailed regulations pertaining to taxation and compliance with ERISA are also described.  Furthermore, this policy outlines procedures for hardship withdrawals and qualified domestic relations orders (QDROs).\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
