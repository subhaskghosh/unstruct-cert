{"_id": "human_resources--hr_policies:_doc--n--64484", "text": "{\n    \"policy_id\": \"TRVL-2023-11-01\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for submitting and reimbursing travel expenses.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64485", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP), providing confidential support services for employees dealing with personal or work-related issues. It covers counseling, legal assistance, and financial advice, promoting employee well-being and resilience.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64485", "text": "{\n    \"policy_id\": \"TR-2023-012\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for employees to request reimbursement for travel expenses incurred during business trips. It outlines allowable expenses, submission guidelines, and approval processes.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
