{"_id": "human_resources--hr_policies:_doc--p--65605", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance and increase productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work_arrangements.pdf\"\n}"}
