{"_id": "human_resources--hr_policies:_doc--n--67420", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Outlines the process for employees to submit and receive reimbursement for work-related travel expenses. Includes details on allowable expenses, required documentation, and approval procedures.  This is a highly detailed policy covering all aspects of travel reimbursement.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel_expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67421", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to employees, including coverage details and eligibility requirements.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67421", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Comprehensive Travel Reimbursement\",\n    \"policy_description\": \"A detailed policy covering all aspects of travel reimbursement, including pre-trip approval, expense reporting, per diem rates, and specific allowances for various travel-related costs. It also includes guidelines on preferred vendors and compliance with travel regulations.  This policy is a highly detailed document spanning multiple pages.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67422", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It provides details on coverage options, premiums, and claims procedures. This is designed to be straightforward and easy to understand.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67422", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Equity Compensation Plan - Restricted Stock Units\",\n    \"policy_description\": \"This policy details the terms and conditions governing the grant and vesting of Restricted Stock Units (RSUs) to eligible employees. This is a comprehensive legal document and requires understanding of securities law and tax implications.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan\"\n}"}
