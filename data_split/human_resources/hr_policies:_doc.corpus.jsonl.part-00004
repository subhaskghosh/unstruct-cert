{"_id": "human_resources--hr_policies:_doc--n--71609", "text": "{\n    \"policy_id\": \"EMP-DIS-001\",\n    \"policy_title\": \"Disciplinary Action and Performance Improvement\",\n    \"policy_description\": \"This policy details the procedures for addressing employee performance issues, including verbal warnings, written warnings, and potential termination. It also outlines the steps for performance improvement plans. Legal review completed on 2024-02-10.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action\"\n}"}
