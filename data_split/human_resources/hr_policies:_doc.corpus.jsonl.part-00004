{"_id": "human_resources--hr_policies:_doc--n--68491", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Details the procedures for reimbursing employees for business-related travel expenses. Strict adherence to company guidelines is required. All receipts must be submitted within 30 days of travel completion.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-09-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement\"\n}"}
