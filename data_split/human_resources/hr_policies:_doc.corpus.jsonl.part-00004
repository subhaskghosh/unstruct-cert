{"_id": "human_resources--hr_policies:_doc--n--65132", "text": "{\n    \"policy_id\": \"LEAVE-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing sick leave benefits. Strict adherence to documentation requirements is expected.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65133", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support and resources to employees facing personal or work-related challenges. It covers counseling, legal advice, and financial guidance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy.pdf\"\n}"}
