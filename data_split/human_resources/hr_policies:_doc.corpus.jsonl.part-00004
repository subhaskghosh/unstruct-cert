{"_id": "human_resources--hr_policies:_doc--n--65413", "text": "{\n    \"policy_id\": \"TR-2024-001\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Detailed guidelines on expense reimbursement for employee travel, including permissible expenses, documentation requirements, and approval processes.  Covers international travel, lodging, and per diem rates. Extensive appendix with varying conditions per region.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65414", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental and emotional well-being through a confidential Employee Assistance Program. It provides access to counseling, resources, and support services to help employees manage personal and work-related challenges, preventing burnout and promoting a healthy work-life balance.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
