{"_id": "human_resources--hr_policies:_doc--p--68835", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the confidential Employee Assistance Program (EAP) available to all employees. The EAP provides support for personal and work-related challenges, including stress, anxiety, and mental health concerns.  We aim to foster a supportive and caring workplace where employees can thrive.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
