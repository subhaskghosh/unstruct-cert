{"_id": "human_resources--hr_policies:_doc--n--67070", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A comprehensive document outlining the compensation structure for executive-level employees, including stock options, bonuses, and performance-based incentives. This is a multi-layered and highly detailed policy.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-comp-plan\"\n}"}
