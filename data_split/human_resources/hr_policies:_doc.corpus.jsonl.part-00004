{"_id": "human_resources--hr_policies:_doc--p--70178", "text": "{\n    \"policy_id\": \"PTO-2023-ENG-PROD\",\n    \"policy_title\": \"Paid Time Off Policy - Engineering & Product\",\n    \"policy_description\": \"This policy outlines the guidelines for employees in the Engineering and Product departments regarding the accrual and use of paid time off, including vacation, sick leave, and personal days. It aims to support a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-engineering-product-2023\"\n}"}
