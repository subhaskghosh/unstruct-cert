{"_id": "human_resources--hr_policies:_doc--p--62477", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, and vision benefits available to all eligible employees. It also includes provisions for employee assistance programs and wellness initiatives.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp_bnf_007.pdf\"\n}"}
