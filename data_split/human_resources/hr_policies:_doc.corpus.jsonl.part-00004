{"_id": "human_resources--hr_policies:_doc--n--65072", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Employee Compensation Review\",\n    \"policy_description\": \"This policy details the annual process for employee salary and bonus reviews, ensuring fair and competitive compensation.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-review\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65073", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential support and counseling services to employees facing personal or work-related challenges. Focuses on mental health and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65073", "text": "{\n    \"policy_id\": \"LOA-2022-005\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Details procedures for requesting and managing extended leaves of absence for various reasons, including medical leave and personal leave. A comprehensive document covering all leave-related scenarios.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/loa-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65074", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for mental health support, fitness programs, and stress management.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65074", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Detailed procedures and eligibility requirements for extended leaves of absence, covering medical, personal, and family-related situations. This is a comprehensive document with several sub-clauses and legal considerations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65075", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including gym membership subsidies, mental health resources, and wellness workshops. It aims to promote a healthy and productive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65075", "text": "{\n    \"policy_id\": \"ENG-PROC-005\",\n    \"policy_title\": \"Engineering Department Project Documentation Standards\",\n    \"policy_description\": \"This policy details the requirements for documenting all engineering projects, ensuring code maintainability and knowledge transfer.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/engineering-docs.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65076", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65076", "text": "{\n    \"policy_id\": \"SALES-BONUS-2024\",\n    \"policy_title\": \"Sales Commission and Bonus Policy\",\n    \"policy_description\": \"Details the commission structure and bonus eligibility for the Sales team, aligning with revenue targets and individual performance.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales-bonus-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65077", "text": "{\n    \"policy_id\": \"WELL-DEV-2024-001\",\n    \"policy_title\": \"Employee Wellness and Growth Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being and professional development. It covers mental health resources, training opportunities, and career advancement programs. The policy promotes a supportive and inclusive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Research & Development\",\n        \"Data Science\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-growth-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65077", "text": "{\n    \"policy_id\": \"LEAVE-PROC-1998-005\",\n    \"policy_title\": \"Sick Leave Procedure\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing sick leave benefits. It outlines documentation requirements and reporting guidelines.\",\n    \"effective_date\": \"1998-07-01\",\n    \"last_updated\": \"2005-11-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-procedure\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65078", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage, premiums, and claim procedures. We aim to provide comprehensive and accessible healthcare options to our team.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65078", "text": "{\n    \"policy_id\": \"LEG-COMP-005\",\n    \"policy_title\": \"Non-Disclosure Agreement and Confidentiality\",\n    \"policy_description\": \"This policy details the legal obligations of employees regarding the protection of confidential company information. It includes detailed clauses concerning intellectual property, trade secrets, and non-compete agreements.  Strict adherence to this policy is mandatory, and any breaches will be subject to legal action in accordance with applicable statutes.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65079", "text": "{\n    \"policy_id\": \"EB-2024-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the full range of employee benefits including health insurance, retirement plans, and paid time off. Covers eligibility, enrollment procedures, and plan details.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/eb-2024-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65079", "text": "{\n    \"policy_id\": \"LV-2023-002\",\n    \"policy_title\": \"Employee Leave Policy\",\n    \"policy_description\": \"Outlines procedures for requesting and approving various types of employee leave, including vacation, sick leave, and personal leave.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/lv-2023-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65080", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to mental health resources, fitness programs, and health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65080", "text": "{\n    \"policy_id\": \"FIN-EXP-003\",\n    \"policy_title\": \"Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the process for employees to submit and receive reimbursement for work-related expenses.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Accounting\",\n        \"Procurement\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65081", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, dental, vision, paid time off, parental leave, and retirement plans. It aims to provide employees with financial security and support their overall well-being, promoting a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65081", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related travel and expenses. It covers topics such as mileage, lodging, meals, and entertainment.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65082", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential support for personal and work-related issues. The EAP offers counseling, referrals, and resources to promote employee well-being and mental health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65082", "text": "{\n    \"policy_id\": \"WFH-002\",\n    \"policy_title\": \"Work From Home Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees requesting and participating in a work-from-home arrangement. It covers eligibility, equipment requirements, security protocols, and performance expectations. Detailed sections on data privacy and remote access are included.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wfh-policy\"\n}"}
