{"_id": "human_resources--hr_policies:_doc--p--65134", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy details the Employee Assistance Program (EAP) available to all employees, providing confidential support for personal and work-related issues.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65134", "text": "{\n    \"policy_id\": \"PR-2023-002\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"This policy outlines the process for conducting annual performance reviews, including goal setting and feedback.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65135", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health, including gym memberships and counseling services.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65135", "text": "{\n    \"policy_id\": \"LEAVE-2022-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Details the procedures for employees requesting extended leave, including medical leave, sabbatical, and personal leave. This policy also includes complex eligibility requirements and detailed documentation guidelines.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65136", "text": "{\n    \"policy_id\": \"WELLB-2023-005\",\n    \"policy_title\": \"Employee Mental Health and Wellbeing\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the mental health and overall wellbeing of its employees. It provides resources for stress management, resilience building, and access to confidential counseling services. It encourages a supportive work environment and prioritizes work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-mental-health.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65136", "text": "{\n    \"policy_id\": \"COMP-2024-001\",\n    \"policy_title\": \"Performance-Based Bonus Program\",\n    \"policy_description\": \"This policy details the criteria and procedures for awarding performance-based bonuses to eligible employees. It outlines the key performance indicators (KPIs) used to evaluate employee contributions and the corresponding bonus amounts. This is tightly tied to financial rewards.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/bonus-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65137", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources and programs to support physical, mental, and financial wellness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
