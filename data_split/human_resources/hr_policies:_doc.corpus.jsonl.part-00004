{"_id": "human_resources--hr_policies:_doc--p--62314", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can choose from several plans with varying levels of coverage and cost. Details regarding eligibility, enrollment, and claims procedures are provided in the linked document.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62314", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This document details the terms and conditions of the Executive Stock Option Plan, including eligibility criteria, vesting schedules, exercise procedures, and tax implications. It provides a comprehensive framework for granting stock options to key executives as part of their compensation package.  The plan is designed to align the interests of executives with the long-term success of the company. It includes complex formulas for option valuation and detailed legal disclaimers. This is a highly regulated area and should be reviewed with legal counsel before any action is taken.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62315", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to all eligible employees. It covers medical, dental, and vision care.  Employees must enroll within 30 days of their start date. Details regarding premium contributions and coverage levels are available in the full policy document.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62315", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This comprehensive program is designed to foster leadership skills within the organization. It involves a series of workshops, mentoring sessions, and project assignments. Participants will be evaluated based on their performance and feedback. A detailed schedule and application process are available. This is a long-term investment in our employees' future. The program requires significant time commitment and dedication.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"HR\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/training/leadership_dev.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62316", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Bereavement Leave\",\n    \"policy_description\": \"This policy outlines the guidelines for employees taking time off due to the death of a family member.  It aims to provide support during a difficult time and ensure employees can grieve and attend to necessary arrangements.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement_leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62316", "text": "{\n    \"policy_id\": \"EMP-DISC-001\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"This policy details the steps taken when addressing employee misconduct. It includes warnings, performance improvement plans, and potential termination.\",\n    \"effective_date\": \"2021-03-10\",\n    \"last_updated\": \"2023-08-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary_procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62317", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Employee Wellness Benefits Program\",\n    \"policy_description\": \"This policy outlines the various wellness benefits available to employees, including gym memberships, mental health resources, and flexible work arrangements. It is designed to promote a healthy work-life balance and overall employee well-being.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62317", "text": "{\n    \"policy_id\": \"RLC-2023-005\",\n    \"policy_title\": \"Employee Relocation Assistance\",\n    \"policy_description\": \"This policy details the assistance provided to employees who are relocating for work purposes. It covers expenses such as moving costs, temporary housing, and school enrollment.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/relocation-assistance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62318", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"Details the full range of employee benefits including health insurance, retirement plans, and paid time off. Focuses on supporting employee financial and physical wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-v2.pdf\"\n}"}
