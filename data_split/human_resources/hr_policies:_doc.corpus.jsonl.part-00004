{"_id": "human_resources--hr_policies:_doc--n--67271", "text": "{\n    \"policy_id\": \"EMP-DISC-005\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"Comprehensive guidelines outlining the process for addressing employee misconduct, including warnings, performance improvement plans, and termination procedures. This document is over 50 pages long and contains numerous legal disclaimers.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-procedure-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67272", "text": "{\n    \"policy_id\": \"EB-2024-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage, premiums, and enrollment procedures. Employees can choose from a variety of plans to meet their individual needs. The company contributes 75% of the premium cost.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67272", "text": "{\n    \"policy_id\": \"LTO-2023-005\",\n    \"policy_title\": \"Long-Term Outplacement Assistance\",\n    \"policy_description\": \"This comprehensive policy details the outplacement services offered to employees affected by restructuring or layoffs.  It covers career counseling, resume writing workshops, job search assistance, and access to a network of potential employers.  The policy also outlines eligibility criteria, service levels, and associated costs.  It includes a detailed section on legal considerations and compliance requirements and includes procedures for both voluntary and involuntary separations. Further details regarding specific service provider contracts are available in Appendix A. The policy is intended to support affected employees in their transition to new employment opportunities, while also mitigating the company’s legal exposure.  It also describes how the company will communicate and manage the outplacement process to maintain positive employee relations and brand reputation. We strive to provide a dignified and supportive experience for all impacted individuals, and this policy serves as a cornerstone of that commitment.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/lto-policy\"\n}"}
