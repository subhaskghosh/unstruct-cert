{"_id": "human_resources--hr_policies:_doc--p--62881", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including gym membership discounts and mental health resources. Participation is encouraged but voluntary.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62881", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Employee Compensation and Benefits - Legal Addendum\",\n    \"policy_description\": \"This document provides a comprehensive legal review of all employee compensation and benefits plans, detailing compliance with ERISA, ACA, and other applicable federal and state regulations. It outlines specific requirements for plan administration, reporting, and fiduciary responsibilities.  Contains clauses regarding non-discrimination, COBRA, and 401k plan management.  Consult legal counsel for interpretation.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation_legal.pdf\"\n}"}
