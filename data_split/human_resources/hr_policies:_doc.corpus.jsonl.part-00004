{"_id": "human_resources--hr_policies:_doc--p--70448", "text": "{\n    \"policy_id\": \"EMP-BEN-2023-001\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the comprehensive health and wellness benefits available to all eligible employees. It includes information on medical, dental, vision, and life insurance, as well as employee assistance programs and wellness initiatives. Employees are encouraged to review the full policy document for detailed coverage information and eligibility requirements. The company is committed to providing a supportive and healthy work environment, and these benefits are a key component of that commitment. This policy supersedes all prior benefits documentation and is subject to change based on regulatory updates and company performance.  Specific plan details, including co-pays, deductibles, and out-of-pocket maximums, are available on the benefits portal.  Regular communication will be provided regarding any changes to these benefits.  Employees are encouraged to reach out to HR with any questions or concerns.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70448", "text": "{\n    \"policy_id\": \"EMP-LEAVE-2022-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees taking sick leave. Employees are entitled to a certain number of sick days per year, which can be used for personal illness or to care for sick family members. Documentation may be required for extended absences. This policy aims to provide employees with the necessary time off to recover from illness without facing financial hardship.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Operations\",\n        \"HR\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/sick-leave-2022.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70449", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym memberships, mental health resources, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
