{"_id": "human_resources--hr_policies:_doc--n--65815", "text": "{\n    \"policy_id\": \"AT-2022-012\",\n    \"policy_title\": \"Attendance and Tardiness\",\n    \"policy_description\": \"This policy details the procedures for reporting absences and tardiness, outlining disciplinary actions for repeated violations. Strict adherence to scheduled work hours is expected.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Operations\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance_policy_2022.pdf\"\n}"}
