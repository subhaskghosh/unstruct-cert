{"_id": "human_resources--hr_policies:_doc--n--62852", "text": "{\n    \"policy_id\": \"RW-2022-005\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"Outlines the guidelines and procedures for employees working remotely, including eligibility, equipment, and security protocols.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remotework.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62853", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Healthcare Benefits Enrollment\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored healthcare plans. Covers eligibility, plan options, and enrollment deadlines. Written in plain language for easy understanding.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/healthcare-enrollment.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62853", "text": "{\n    \"policy_id\": \"EMP-RET-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Outlines the details of the company's 401k retirement savings plan, including contribution limits, vesting schedules, and investment options. Includes complex financial terminology.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
