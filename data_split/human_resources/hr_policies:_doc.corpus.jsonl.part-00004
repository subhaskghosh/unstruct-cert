{"_id": "human_resources--hr_policies:_doc--p--67131", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the process for employees to enroll in company-sponsored health insurance plans. It covers eligibility, enrollment periods, and available plan options.  Employees are encouraged to review the plan details carefully before making a selection.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67131", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This policy details the executive compensation program, including base salary, performance bonuses, stock options, and restricted stock units. It governs the eligibility criteria for equity grants, vesting schedules, and performance metrics. This document is extensive and contains detailed legal provisions concerning executive pay structures and compliance with relevant regulations. It also includes information regarding tax implications and reporting requirements. Further, it specifies the roles and responsibilities of the Compensation Committee, the Board of Directors, and executive management in the administration of this program. It's crucial for all executives to understand the contents of this document before participating in any of the covered programs.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-policy\"\n}"}
