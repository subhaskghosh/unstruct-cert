{"_id": "human_resources--hr_policies:_doc--n--64672", "text": "{\n    \"policy_id\": \"RET-002\",\n    \"policy_title\": \"Retirement Plan Details\",\n    \"policy_description\": \"This comprehensive policy details the company's 401k plan, including eligibility, contribution matching, vesting schedules, loan provisions, and withdrawal rules. It also covers the process for rollovers and required minimum distributions, with appendices outlining various investment options and associated risks. Detailed information on beneficiary designations is also included.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-09-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64673", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees, as well as wellness programs promoting employee wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits\"\n}"}
