{"_id": "human_resources--hr_policies:_doc--n--67778", "text": "{\n    \"policy_id\": \"CMP-REG-005\",\n    \"policy_title\": \"Compliance Regulations for International Assignments\",\n    \"policy_description\": \"A comprehensive document outlining all compliance requirements for employees on international assignments, including tax implications, visa regulations, and legal considerations. This is a very detailed policy with many sections.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/international_compliance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67779", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and improve productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67779", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"This policy details the procedures for enrolling in company-sponsored health insurance plans. It covers eligibility, enrollment deadlines, and plan options.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67780", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees must enroll during the annual open enrollment period. Details regarding coverage levels, premiums, and claim procedures are available in the linked document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67780", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while conducting company business. It covers transportation, lodging, meals, and other related costs. All expenses must be pre-approved by a manager and submitted with supporting documentation. This comprehensive policy includes clauses about per diem rates, allowable expense categories, and the process for appealing denied claims. It also includes guidelines for booking travel through approved vendors and compliance with company travel safety protocols, detailing specific insurance coverage requirements for international travel, and outlining the consequences for non-compliance with these procedures, including potential disciplinary action. Extensive tables illustrate different expense limits based on employee level and destination. The policy also addresses the reporting requirements for mileage and the documentation needed for car rentals.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67781", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage levels, provider networks, and claims procedures.  We aim to provide comprehensive and affordable healthcare options.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67781", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Details the stock option grant process, vesting schedules, and tax implications for equity compensation. This plan is governed by section 409A of the Internal Revenue Code.  Detailed calculations and legal disclosures are included.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-06-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67782", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
