{"_id": "human_resources--hr_policies:_doc--p--71499", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the full suite of benefits offered to employees, including health insurance, retirement plans, and paid time off. This policy aims to support the long-term financial and physical wellbeing of our team.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-09-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-v2.pdf\"\n}"}
