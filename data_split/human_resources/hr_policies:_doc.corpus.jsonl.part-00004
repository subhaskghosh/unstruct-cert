{"_id": "human_resources--hr_policies:_doc--n--67236", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"Detailed guidelines for reimbursing employees for business-related travel and expenses. Includes per diem rates, approved vendors, and documentation requirements.  Covers multiple scenarios including international travel, client entertainment, and accommodation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
