{"_id": "human_resources--hr_policies:_doc--p--62416", "text": "{\n    \"policy_id\": \"BNF-2024-003\",\n    \"policy_title\": \"Employee Wellbeing Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to employees, including health insurance, retirement plans, and wellness programs. It's designed to support employee wellbeing and promote a healthy work-life balance.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellbeing-package.pdf\"\n}"}
