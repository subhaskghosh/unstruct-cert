{"_id": "human_resources--hr_policies:_doc--p--67893", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.  Employees can choose from several plans with varying levels of coverage. Details regarding premiums and eligibility requirements are available in the full policy document.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67893", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, including 401(k) contributions, pension options, and financial planning resources. It provides information on eligibility, vesting schedules, investment choices, and withdrawal procedures. The policy also addresses spousal benefits and beneficiary designations, and compliance with relevant regulations like ERISA and the IRS. This is a very extensive policy document. It details numerous scenarios. It has a long history of modifications. It provides comprehensive coverage for all employees. It is subject to legal review annually.  It has many appendices.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
