{"_id": "human_resources--hr_policies:_doc--n--65343", "text": "{\n    \"policy_id\": \"EMP-PERF-002\",\n    \"policy_title\": \"Employee Performance Review Process\",\n    \"policy_description\": \"This policy details the process for conducting employee performance reviews, including frequency, documentation, and feedback mechanisms. It is designed to foster continuous improvement and employee development.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-performance-review.pdf\"\n}"}
