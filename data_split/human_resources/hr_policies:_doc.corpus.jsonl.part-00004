{"_id": "human_resources--hr_policies:_doc--n--62014", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Stock Option Grant Policy\",\n    \"policy_description\": \"Detailed procedures for granting stock options to eligible employees, covering vesting schedules, exercise terms, and tax implications.  This is a lengthy document that requires careful review by legal counsel.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62015", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"Provides up to 12 weeks of paid parental leave for eligible employees, supporting work-life balance and family well-being.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/parental-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62015", "text": "{\n    \"policy_id\": \"PERF-0005\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"Outlines the annual performance review cycle and feedback procedures.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62016", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee wellbeing, offering resources for mental and physical health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62016", "text": "{\n    \"policy_id\": \"LEAVE-2022-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"Details the procedures for requesting and utilizing sick leave.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62017", "text": "{\n    \"policy_id\": \"PTO-2024-001\",\n    \"policy_title\": \"Flexible Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize paid time off, emphasizing flexibility and employee well-being. It allows employees to accrue PTO based on tenure and utilize it for vacation, personal days, or sick leave. Approval is based on business needs and team coverage.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62017", "text": "{\n    \"policy_id\": \"MAT-2023-002\",\n    \"policy_title\": \"Maternity Leave Policy\",\n    \"policy_description\": \"This policy details the guidelines and benefits for employees taking maternity leave. It covers leave duration, pay, and job protection.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/maternity-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62018", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision care. Details regarding premiums, deductibles, and co-pays are available in the full policy document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62018", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy provides income replacement benefits to employees who become disabled and unable to work. It details eligibility requirements, benefit levels, and the claims process. This is a comprehensive plan covering a range of potential disability scenarios and includes provisions for rehabilitation and return-to-work assistance.  The policy also addresses coordination with other benefits, such as worker's compensation and social security, and outlines the procedures for appealing claim denials.  It further describes the criteria for determining disability, including the medical evidence required and the role of independent medical evaluations. Finally, it specifies the policy's duration and renewal terms.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62019", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It emphasizes preventative care and employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62019", "text": "{\n    \"policy_id\": \"EMP-TERM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"This policy details the process for employee termination, including notice periods, severance pay, and exit interviews.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination/procedure.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62020", "text": "{\n    \"policy_id\": \"BEN-HLTH-2023-001\",\n    \"policy_title\": \"Health Insurance Benefits Policy\",\n    \"policy_description\": \"This comprehensive policy outlines the health insurance benefits available to all eligible employees, including coverage details, eligibility criteria, and enrollment procedures. It provides a detailed explanation of plan options and associated costs, ensuring employees understand their healthcare benefits. The policy is designed to be straightforward and easy to navigate, with clear explanations of key terms.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62020", "text": "{\n    \"policy_id\": \"BEN-PTO-2022-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the accrual rates, usage guidelines, and approval processes for paid time off (PTO). It is a relatively simple policy focused on vacation and sick leave.  PTO requests require manager approval.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/pto_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62021", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to all eligible employees. Covers medical, dental, and vision plans.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-07-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62021", "text": "{\n    \"policy_id\": \"EMP-BEN-008\",\n    \"policy_title\": \"Retirement Savings Plan\",\n    \"policy_description\": \"Outlines the company's 401k plan and eligibility requirements. Includes information on contribution matching and investment options.\",\n    \"effective_date\": \"2020-06-01\",\n    \"last_updated\": \"2022-05-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62022", "text": "{\n    \"policy_id\": \"BEN-401K-2023\",\n    \"policy_title\": \"401K Contribution Policy\",\n    \"policy_description\": \"This policy outlines the company's 401K plan, including contribution limits and vesting schedules. Focus is on employee financial well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62022", "text": "{\n    \"policy_id\": \"LEAVE-PTO-2022\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"A comprehensive policy detailing accrual rates, usage guidelines, and carryover rules for Paid Time Off (PTO). This document provides detailed guidance for all employees on utilizing their earned time off for vacation, sick leave, or personal matters. It covers all aspects of PTO, including eligibility, request procedures, and potential limitations. This is a lengthy document.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62023", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to employees. It covers medical, dental, and vision plans.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62023", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive and detailed program designed for developing leadership skills within the organization, covering topics such as strategic planning, team management, conflict resolution, and change management. It involves multiple workshops, mentorship sessions, and practical exercises.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62024", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing. It provides resources and programs focused on physical and mental health, including gym membership discounts and access to mental health counseling. The program aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62024", "text": "{\n    \"policy_id\": \"LOA-2022-005\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving extended leaves of absence, including medical leave, parental leave, and personal leave. It covers eligibility requirements, documentation procedures, and continuation of benefits. Detailed legal considerations are outlined.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62025", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"Details the company's health insurance, wellness programs, and employee assistance programs (EAP). Focuses on preventative care and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/healthwellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62025", "text": "{\n    \"policy_id\": \"TRV-2022-012\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Outlines the rules and procedures for reimbursing employee travel expenses. Includes detailed guidelines on allowable expenses and required documentation.\",\n    \"effective_date\": \"2022-10-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62026", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits provided to eligible employees. It covers medical, dental, and vision care. Details on coverage levels and enrollment procedures are available in the linked document.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62026", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Company Compensation Guidelines\",\n    \"policy_description\": \"This document provides a comprehensive overview of the company's compensation philosophy, including salary ranges, bonus structures, and equity options. It details performance review processes and guidelines for salary adjustments. This is a highly detailed document covering all aspects of employee compensation including potential legal ramifications, specific tax implications, different types of leave, benefits packages, and more.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62027", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Healthcare Benefits Update\",\n    \"policy_description\": \"This policy outlines the changes to healthcare benefits effective January 15, 2023, including new provider options and wellness programs. It aims to offer comprehensive and flexible healthcare choices for employees.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/healthcare-benefits-update.pdf\"\n}"}
