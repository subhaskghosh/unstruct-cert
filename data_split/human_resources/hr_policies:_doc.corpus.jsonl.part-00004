{"_id": "human_resources--hr_policies:_doc--p--62362", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellbeing and Support Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, encompassing physical, mental, and emotional health. It includes resources for stress management, mental health support, and preventative health screenings. We promote a healthy work-life balance and offer various programs to support employee wellness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62362", "text": "{\n    \"policy_id\": \"DA-2022-005\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and performance issues. It outlines the steps involved in issuing warnings, conducting investigations, and implementing disciplinary actions. It is essential that all managers follow these procedures to ensure fairness and consistency.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62363", "text": "{\n    \"policy_id\": \"BEN-PTO-2024-001\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"Details the guidelines for employees to request and utilize paid time off, including vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62363", "text": "{\n    \"policy_id\": \"BEN-TEMP-HOURS-2023-002\",\n    \"policy_title\": \"Temporary Staffing Hours and Compensation\",\n    \"policy_description\": \"Outlines the hourly rates and working conditions for temporary employees.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/temp_staffing.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62364", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, offering resources and support for physical and mental health. It includes gym membership discounts, mental health counseling, and wellness workshops. The program aims to improve employee morale and productivity.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62364", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"A detailed explanation of the company's comprehensive health insurance plan, including coverage options, premiums, deductibles, co-pays, and out-of-pocket maximums. This document provides a complete overview of the health benefits available to employees and their dependents. Includes information about pre-existing conditions, network providers, and claim submission procedures. This is a very detailed document designed to cover all aspects of healthcare eligibility and utilization.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
