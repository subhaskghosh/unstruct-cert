{"_id": "human_resources--hr_policies:_doc--p--62949", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care, including details on premium contributions, coverage levels, and claims procedures. This policy is designed to promote the health and well-being of our employees and their families.  Employees can find detailed information about providers, covered services, and enrollment procedures on the company intranet.  The policy includes provisions for preventative care, specialist visits, and emergency services. Changes to this policy will be communicated well in advance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62949", "text": "{\n    \"policy_id\": \"REM-0015\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving remote work arrangements. It covers eligibility criteria, equipment requirements, and performance expectations for remote employees. The aim is to facilitate a flexible work environment while maintaining productivity and communication. Remote work requests must be submitted through the HR portal and approved by the employee's manager.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Technology\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62950", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees must enroll during the annual open enrollment period. Details regarding coverage levels and costs are available in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62950", "text": "{\n    \"policy_id\": \"EMP-ETH-002\",\n    \"policy_title\": \"Code of Conduct\",\n    \"policy_description\": \"Our company is committed to maintaining a respectful and inclusive work environment for all employees, contractors, and visitors. This comprehensive Code of Conduct outlines the expected standards of behavior and ethical conduct, covering areas such as anti-harassment, conflict of interest, confidentiality, and data security. All employees are required to acknowledge and adhere to this code.  Violations may result in disciplinary action, up to and including termination of employment. Detailed examples and reporting procedures are included in the full policy document, along with information on relevant legal frameworks and compliance requirements. We regularly review and update this policy to ensure it remains aligned with best practices and legal standards. It promotes a positive work environment.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62951", "text": "{\n    \"policy_id\": \"WB-2023-101\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee physical and mental well-being, including access to resources and programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62951", "text": "{\n    \"policy_id\": \"LEAVE-2022-050\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"Details regarding time off allowed for employees experiencing the loss of a family member.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave.pdf\"\n}"}
