{"_id": "human_resources--hr_policies:_doc--n--65063", "text": "{\n    \"policy_id\": \"CMP-CON-005\",\n    \"policy_title\": \"Complex Compliance Regulation - Data Privacy\",\n    \"policy_description\": \"A detailed and extensive policy covering all aspects of data privacy in accordance with GDPR, CCPA, and other relevant regulations.  Requires mandatory training for all personnel handling sensitive data.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Security\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/data_privacy_compliance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65064", "text": "{\n    \"policy_id\": \"EB-2024-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness benefits available to all eligible employees, including mental health support, gym reimbursements, and preventative care. It aims to promote a healthy work-life balance and employee well-being.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/eb-2024-001.pdf\"\n}"}
