{"_id": "human_resources--hr_policies:_doc--p--71639", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various health and wellness initiatives, including gym memberships, mental health resources, and health screenings.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71639", "text": "{\n    \"policy_id\": \"EB-2024-001\",\n    \"policy_title\": \"Complex Benefits Enrollment Guide\",\n    \"policy_description\": \"A detailed guide outlining all benefit enrollment procedures and options, including complex tax implications and eligibility requirements.\",\n    \"effective_date\": \"2024-01-10\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/complex-benefits-guide\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71640", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health and Wellness Benefits Policy\",\n    \"policy_description\": \"Details coverage for medical, dental, and vision insurance, as well as wellness programs and employee assistance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71640", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Professional Development Reimbursement\",\n    \"policy_description\": \"Outlines the process for employees to request reimbursement for approved professional development courses and conferences.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/training-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71641", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee 401k Contribution Matching\",\n    \"policy_description\": \"This policy outlines the company's contribution matching program for employee 401k plans. The company will match 50% of employee contributions up to 6% of their salary. This helps employees save for retirement and promotes financial wellbeing.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71641", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance plan offered to all eligible employees, including medical, dental, and vision coverage. It provides a detailed overview of plan options, eligibility requirements, claim procedures, and cost-sharing arrangements. It also covers preventative care, specialist visits, emergency services, and prescription drug benefits. Includes provisions for dependent coverage and out-of-network care. Detailed network provider lists and claim forms are available on the HR portal. This document is lengthy and comprehensive, covering all aspects of our healthcare benefits.  Specific pre-authorization requirements are listed in Appendix A, and information regarding the appeals process can be found in Appendix B.  The plan is governed by federal and state regulations, including HIPAA and ERISA. The policy also addresses wellness programs and resources available to employees for maintaining their health. Further details can be found on the insurance provider's website. \",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-09-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71642", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health, including gym memberships and counseling services. It focuses on preventative care and creating a supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71642", "text": "{\n    \"policy_id\": \"LEGL-2022-110\",\n    \"policy_title\": \"Complex Leave of Absence Regulations\",\n    \"policy_description\": \"Detailed regulations regarding various types of leave, including FMLA, sick leave, and personal leave, with extensive legal disclaimers and compliance requirements. This document is primarily for legal and HR use.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-regulations.pdf\"\n}"}
