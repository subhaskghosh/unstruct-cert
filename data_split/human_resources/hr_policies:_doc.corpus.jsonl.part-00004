{"_id": "human_resources--hr_policies:_doc--n--68490", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Outlines the terms and conditions for stock option grants to executive-level employees, including vesting schedules, exercise prices, and tax implications. This plan is designed to incentivize long-term performance and alignment with shareholder interests.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-04-10\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
