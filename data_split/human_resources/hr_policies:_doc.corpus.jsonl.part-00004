{"_id": "human_resources--hr_policies:_doc--n--67858", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"A detailed description of the company's retirement plan, including vesting schedules, investment options, and withdrawal procedures.  This plan offers a wide array of investment choices and eligibility requirements that may be complex. It includes information on 401k matching, pension plans, and financial planning resources. Employees are encouraged to attend informational seminars. The plan adheres to all relevant regulations. There are numerous contribution limit details, tax implications, and beneficiary designation options. The policy also outlines procedures for loan applications and hardship withdrawals.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
