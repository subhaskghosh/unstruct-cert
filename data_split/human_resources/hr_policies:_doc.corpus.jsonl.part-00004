{"_id": "human_resources--hr_policies:_doc--n--68485", "text": "{\n    \"policy_id\": \"LEG-007\",\n    \"policy_title\": \"HIPAA Compliance and Protected Health Information\",\n    \"policy_description\": \"This policy details the company's procedures for complying with the Health Insurance Portability and Accountability Act (HIPAA) regarding the handling of protected health information.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/hipaa-policy\"\n}"}
