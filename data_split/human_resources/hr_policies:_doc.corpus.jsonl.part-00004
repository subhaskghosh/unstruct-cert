{"_id": "human_resources--hr_policies:_doc--p--62968", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Financial Wellbeing Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee financial health through resources like financial planning workshops, retirement plan options, and employee assistance programs.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/financial-wellbeing-policy.pdf\"\n}"}
