{"_id": "human_resources--hr_policies:_doc--p--71016", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to providing employees with robust health, dental, and vision insurance, as well as wellness programs. It emphasizes preventative care and employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness.pdf\"\n}"}
