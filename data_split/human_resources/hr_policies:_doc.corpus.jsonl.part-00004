{"_id": "human_resources--hr_policies:_doc--p--67248", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Benefits Eligibility\",\n    \"policy_description\": \"Details the eligibility criteria for various employee benefits, including health insurance, retirement plans, and paid time off. Covers benefits for all full-time and part-time employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_eligibility.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67248", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"Guidelines for employees regarding travel arrangements and expense reimbursement. Outlines procedures for booking travel, submitting expense reports, and allowable expenses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67249", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Remote Work and Home Office Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees working remotely or from a home office, including eligibility, equipment, security, and expense reimbursement.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-policy\"\n}"}
