{"_id": "human_resources--hr_policies:_doc--p--70765", "text": "{\n    \"policy_id\": \"POL-2023-005\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"This policy outlines the commission structure for the Sales department, ensuring fair and transparent compensation based on performance metrics. It details eligibility criteria, commission rates, payment schedules, and dispute resolution processes. This policy aims to motivate sales representatives and drive revenue growth while maintaining ethical sales practices. All sales personnel are expected to fully understand and adhere to the guidelines within this document. Regular review and updates will occur to align with market changes and company objectives.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_2023.pdf\"\n}"}
