{"_id": "human_resources--hr_policies:_doc--p--68421", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources and support for physical and mental health. It covers gym membership reimbursements and access to online wellness platforms.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68421", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"A comprehensive guide detailing the terms and conditions of the company's Long-Term Disability Insurance plan, including eligibility criteria, benefit levels, claim procedures, and coordination with other benefits. This document covers a wide range of scenarios and includes legal disclaimers and detailed actuarial information.  Due to its complexity, all employees are required to attend a mandatory training session regarding the policy. This policy is subject to frequent regulatory changes and updates.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68422", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68422", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Compensation and Performance Review\",\n    \"policy_description\": \"This policy details the company's approach to employee compensation, including salary ranges, bonus structures, and performance review processes. It covers all aspects of performance management, from goal setting to feedback and development planning. The document also explains the different compensation components and how they are linked to individual and company performance. It also includes details on equity and stock options and the process for requesting salary adjustments.  Detailed explanation of how different teams will be evaluated along with numerous tables containing information. This policy is a comprehensive guide for all employees and managers.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68423", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, aiming to enhance work-life balance and employee satisfaction.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
