{"_id": "human_resources--hr_policies:_doc--n--71502", "text": "{\n    \"policy_id\": \"PERF-REV-001\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"Outlines the process for conducting annual performance reviews and providing feedback to employees.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71503", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial planning. It aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71503", "text": "{\n    \"policy_id\": \"TRA-0005\",\n    \"policy_title\": \"Leadership Development Training\",\n    \"policy_description\": \"Details the company-sponsored leadership training programs and eligibility criteria for employees seeking to advance their managerial skills.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-training.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71504", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for mental and physical health. It includes access to an Employee Assistance Program (EAP) and wellness workshops. \",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71504", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including eligibility, contribution matching, vesting schedules, and investment options. The plan is governed by ERISA and requires adherence to all applicable federal regulations. Detailed information regarding investment choices, loan provisions, and hardship withdrawals is available in the plan document. A full legal review was conducted on December 31, 2023, to ensure compliance with current laws. Furthermore, employees are encouraged to seek independent financial advice when making investment decisions. This plan benefits employees across all departments and aims to secure their financial future during and after employment. \",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71505", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Remote Work and Home Office Expenses\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements, including eligibility, required equipment, and reimbursement for reasonable home office expenses.  It promotes flexibility while ensuring productivity and compliance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-ben-007\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71505", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the annual health insurance enrollment process and available plans.  Includes information on premiums, coverage options, and required documentation.  A comprehensive, detailed explanation of all benefits.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-05\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-ben-001\"\n}"}
