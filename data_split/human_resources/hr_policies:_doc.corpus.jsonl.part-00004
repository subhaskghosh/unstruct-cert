{"_id": "human_resources--hr_policies:_doc--p--71712", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, and wellness programs.  Covers flexible spending accounts and remote work stipends.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-07-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/package2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71712", "text": "{\n    \"policy_id\": \"TRM-2023-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"Outlines the procedures for employee termination, including documentation requirements and exit interviews.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination/procedure\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71713", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding employee health insurance coverage, including plan options, eligibility, and enrollment procedures. This policy ensures employees have access to quality healthcare. It outlines cost sharing, dependent coverage, and claims processes. Approximately 350 words.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71713", "text": "{\n    \"policy_id\": \"EMP-TRV-002\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy details the process for reimbursing employees for business-related travel expenses. It covers allowable expenses, required documentation, and reimbursement timelines. It includes detailed guidelines on airfare, lodging, meals, and transportation. Approximately 600 words.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-reimbursement.pdf\"\n}"}
