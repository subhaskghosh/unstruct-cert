{"_id": "human_resources--hr_policies:_doc--p--62476", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health & Wellness Program\",\n    \"policy_description\": \"Details the company's comprehensive health and wellness benefits, including medical, dental, vision, and mental health support. It outlines eligibility, coverage details, and resources for employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-wellness-policy\"\n}"}
