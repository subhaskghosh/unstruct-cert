{"_id": "human_resources--hr_policies:_doc--n--64352", "text": "{\n    \"policy_id\": \"LB-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This detailed policy outlines all types of leave available to employees, including sick leave, parental leave, and bereavement leave, covering eligibility requirements, application procedures, and associated benefits. It also details interaction with state and federal laws, and processes for extended leave. A comprehensive guide to managing employee absences.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64353", "text": "{\n    \"policy_id\": \"WELLBEING-SM-2024\",\n    \"policy_title\": \"Employee Wellness Program for Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the mental and physical well-being of employees in the Sales and Marketing departments. It includes details on available resources and programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-sm-policy\"\n}"}
