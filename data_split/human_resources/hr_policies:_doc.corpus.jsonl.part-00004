{"_id": "human_resources--hr_policies:_doc--p--70153", "text": "{\n    \"policy_id\": \"TP-2023-005\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the guidelines for employee travel, including approved expenses, reimbursement procedures, and pre-trip authorization requirements. It aims to ensure employees can travel safely and comfortably while representing the company.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70153", "text": "{\n    \"policy_id\": \"HP-2022-010\",\n    \"policy_title\": \"Hardware Provisioning and Security\",\n    \"policy_description\": \"This policy details the procedures for requesting, receiving, and maintaining company-provided hardware, including laptops, mobile phones, and other devices. It also covers security protocols to protect company data.\",\n    \"effective_date\": \"2022-10-20\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/hardware-policy-2022\"\n}"}
