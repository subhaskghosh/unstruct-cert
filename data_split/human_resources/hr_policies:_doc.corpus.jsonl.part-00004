{"_id": "human_resources--hr_policies:_doc--p--61994", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the complete range of benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It outlines eligibility requirements, enrollment procedures, and coverage details for each benefit. This policy is reviewed annually to ensure competitiveness and compliance.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61994", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the guidelines for reimbursing employees for travel expenses incurred during business trips. It covers topics such as allowable expenses, documentation requirements, and reimbursement procedures.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expenses.pdf\"\n}"}
