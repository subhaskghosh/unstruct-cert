{"_id": "human_resources--hr_policies:_doc--p--71339", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including mental health resources, physical health initiatives, and flexible work arrangements. It promotes a supportive work environment and aims to improve work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71339", "text": "{\n    \"policy_id\": \"DA-2024-002\",\n    \"policy_title\": \"Disciplinary Action Guidelines\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and performance issues, including verbal warnings, written warnings, and termination. It outlines the steps to be taken in cases of rule violations.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-actions.pdf\"\n}"}
