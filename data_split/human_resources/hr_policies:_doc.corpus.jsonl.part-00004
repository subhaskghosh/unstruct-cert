{"_id": "human_resources--hr_policies:_doc--p--62456", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Financial Assistance Program\",\n    \"policy_description\": \"This policy outlines the financial assistance available to employees facing hardship, including loans, grants, and budgeting resources. It supports employee wellbeing by reducing financial stress.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-07-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/financial-assistance-policy\"\n}"}
