{"_id": "human_resources--hr_policies:_doc--p--64961", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees in achieving a healthy work-life balance through flexible work arrangements, including remote work options and flexible hours. It aims to reduce stress and improve employee wellbeing.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-2024\"\n}"}
