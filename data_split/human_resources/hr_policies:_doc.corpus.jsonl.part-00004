{"_id": "human_resources--hr_policies:_doc--n--64647", "text": "{\n    \"policy_id\": \"BP-0045\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"A comprehensive document detailing the executive stock option plan, including vesting schedules, exercise procedures, tax implications, and legal considerations. This document contains significant detail regarding stock grants, performance criteria, and associated regulations. It requires careful review and is intended for senior management only.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock_option_plan.pdf\"\n}"}
