{"_id": "human_resources--hr_policies:_doc--p--62631", "text": "{\n    \"policy_id\": \"WELL-REMOTE-20240115\",\n    \"policy_title\": \"Remote Work & Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements while promoting employee well-being through resources like mental health support, ergonomic assessments, and virtual team-building activities.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-wellness-2024.pdf\"\n}"}
