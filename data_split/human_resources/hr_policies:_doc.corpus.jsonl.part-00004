{"_id": "human_resources--hr_policies:_doc--n--65087", "text": "{\n    \"policy_id\": \"CMP-002\",\n    \"policy_title\": \"Performance-Based Bonus Structure\",\n    \"policy_description\": \"This policy details the performance-based bonus structure for employees, outlining eligibility criteria, bonus calculation methods, and payout schedules. The goal is to incentivize high performance and reward employees for their contributions to company success.\",\n    \"effective_date\": \"2023-01-20\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/bonus\"\n}"}
