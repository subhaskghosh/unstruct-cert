{"_id": "human_resources--hr_policies:_doc--n--67595", "text": "{\n    \"policy_id\": \"EMP-TRA-002\",\n    \"policy_title\": \"Employee Training Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to request reimbursement for approved training courses. It includes eligibility criteria and maximum reimbursement amounts.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-training-reimbursement\"\n}"}
