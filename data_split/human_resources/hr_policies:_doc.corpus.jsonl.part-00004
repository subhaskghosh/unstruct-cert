{"_id": "human_resources--hr_policies:_doc--p--64265", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the benefits available to all eligible employees, including health insurance, retirement plans, and paid time off. It focuses on providing a holistic support system for employee well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/package\"\n}"}
