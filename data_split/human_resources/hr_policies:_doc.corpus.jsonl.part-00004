{"_id": "human_resources--hr_policies:_doc--p--62115", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Health Savings Account (HSA) Contribution\",\n    \"policy_description\": \"Details the company's contribution to employee HSAs, eligibility requirements, and claim procedures. Promotes financial wellness.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/hsa-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62115", "text": "{\n    \"policy_id\": \"LVE-2022-002\",\n    \"policy_title\": \"Leave of Absence - Extended Medical\",\n    \"policy_description\": \"This policy outlines the procedures and eligibility requirements for employees requesting an extended leave of absence due to medical reasons. It covers various aspects, including documentation, benefits continuation, and return-to-work protocols.  Detailed guidelines for all employee levels and situations are included, ensuring consistent and compliant application of leave requests. The policy aims to provide comprehensive support and clarity during challenging personal circumstances, aligning with the company's commitment to employee well-being.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62116", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support services to employees experiencing personal or work-related challenges.  It emphasizes mental health and overall well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-09-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62116", "text": "{\n    \"policy_id\": \"LEGL-2024-010\",\n    \"policy_title\": \"Non-Disclosure Agreement\",\n    \"policy_description\": \"This legally binding agreement details the confidentiality requirements for all employees regarding company trade secrets, proprietary information, and client data.  Violation of this policy may result in legal action.\",\n    \"effective_date\": \"2024-01-05\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62117", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health and wellness benefits available to all eligible employees. It covers medical, dental, and vision insurance, as well as wellness programs such as gym membership discounts and employee assistance programs. The company is committed to supporting the health and well-being of its employees. Details regarding eligibility, coverage levels, and claim procedures are provided in the attached document. This policy aims to provide comprehensive coverage and promote a healthy work-life balance for our workforce. Employees are encouraged to utilize these resources to maintain their physical and mental health. Any questions should be directed to the HR Benefits team.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62117", "text": "{\n    \"policy_id\": \"EMP-STOCK-001\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the Employee Stock Option Plan (ESOP). It outlines eligibility requirements, vesting schedules, and procedures for exercising stock options. The ESOP is designed to align employee interests with the long-term success of the company.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan.pdf\"\n}"}
