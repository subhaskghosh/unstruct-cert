{"_id": "human_resources--hr_policies:_doc--n--71284", "text": "{\n    \"policy_id\": \"LT-2022-005\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy details the provisions for employees who become disabled and are unable to work. It covers eligibility criteria, benefit amounts, and the claims process. Detailed information regarding the interaction with short-term disability and other leave programs is included, along with applicable legal compliance requirements and documentation.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability-insurance\"\n}"}
