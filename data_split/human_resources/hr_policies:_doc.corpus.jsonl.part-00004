{"_id": "human_resources--hr_policies:_doc--p--70166", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"This policy details the commission structure for all Sales Representatives and Account Managers, including tiers, targets, and payout schedules. It also outlines eligibility criteria and performance review processes related to commission earnings. It covers details about benefits eligibility related to commission earnings.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_2023.pdf\"\n}"}
