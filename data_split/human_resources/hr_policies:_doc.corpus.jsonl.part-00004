{"_id": "human_resources--hr_policies:_doc--n--68110", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Legacy 401k Plan\",\n    \"policy_description\": \"Outlines the details of the company's previous 401k retirement plan.  This plan is no longer actively contributing but has stipulations for vested amounts.\",\n    \"effective_date\": \"2018-11-01\",\n    \"last_updated\": \"2024-01-25\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/legacy-401k-plan\"\n}"}
