{"_id": "human_resources--hr_policies:_doc--p--71802", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support and resources for employees experiencing personal or work-related challenges. It covers mental health, stress management, and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71802", "text": "{\n    \"policy_id\": \"CMP-2023-002\",\n    \"policy_title\": \"Performance-Based Bonus Structure\",\n    \"policy_description\": \"Details the criteria and process for awarding performance-based bonuses to eligible employees.  Includes information on payout schedules and performance review requirements.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/bonus_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71803", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources for physical and mental health support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71803", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the complete health insurance plan available to all eligible employees, including coverage details, premium contributions, and claim procedures. It covers various aspects of health insurance, including medical, dental, vision, and prescription drug benefits. It also includes information on out-of-pocket maximums, deductibles, and co-pays. There are sections on pre-existing conditions, preventative care, and emergency services. Furthermore, the plan outlines procedures for appealing claim denials and accessing healthcare resources. A detailed FAQ section addresses common employee queries. The policy also specifies the coverage for family members and dependents. Finally, it covers the process of enrolling in and changing the health insurance plan. \",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71804", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It also covers wellness programs and resources.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71804", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the requirements and procedures for participation in the Leadership Development Program.\",\n    \"effective_date\": \"2022-09-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/training/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71805", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels, costs, and enrollment procedures.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71805", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Complex Retirement Plan\",\n    \"policy_description\": \"A comprehensive guide to the company's 401k plan, including vesting schedules, investment options, and withdrawal rules.  Includes detailed legal disclaimers and compliance information.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71806", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage levels, premiums, deductibles, and procedures for filing claims. Employees have a choice of several plans, including HMO, PPO, and HSA options. The policy also covers vision and dental care.  It is the company's commitment to provide a comprehensive health package to our employees, fostering well-being and productivity.  Specific details on eligibility and enrollment are included in the attached document.  This policy aims to ensure our employees have access to quality healthcare services. Coverage also extends to dependents as defined by the policy.  We regularly review our health insurance options to provide competitive benefits.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71806", "text": "{\n    \"policy_id\": \"REM-0015\",\n    \"policy_title\": \"Remote Work Equipment Allowance\",\n    \"policy_description\": \"This policy outlines the allowance provided to employees working remotely for the purchase of necessary equipment such as laptops, monitors, and ergonomic chairs.  The allowance is a one-time payment of $500.  Employees must submit receipts for reimbursement. This policy ensures that remote employees have the tools they need to perform their jobs effectively. The policy applies to all full-time employees approved for remote work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Technology\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote_work/equipment_allowance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71807", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Domestic Health Insurance Plan\",\n    \"policy_description\": \"Details regarding the health insurance benefits available to all eligible employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance-plan\"\n}"}
