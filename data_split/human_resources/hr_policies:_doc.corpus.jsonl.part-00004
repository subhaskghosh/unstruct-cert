{"_id": "human_resources--hr_policies:_doc--p--64039", "text": "{\n    \"policy_id\": \"PD-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health, physical fitness, and work-life balance. It supports professional development through workshops and training opportunities.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
