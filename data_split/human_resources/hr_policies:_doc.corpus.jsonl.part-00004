{"_id": "human_resources--hr_policies:_doc--p--64343", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Employee Wellbeing and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including flexible work options, mental health resources, and wellness programs. It aims to promote a healthy work-life balance for all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-flexible-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64343", "text": "{\n    \"policy_id\": \"BP-2022-012\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business-related travel expenses. It covers transportation, lodging, and meals.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64344", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It includes details on coverage, enrollment, and claims procedures.  It prioritizes employee wellbeing and preventative care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64344", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for submitting and receiving reimbursement for business travel expenses.  It covers eligible expenses, limits, and required documentation.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64345", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through various programs, including mental health resources, fitness initiatives, and flexible work arrangements. The goal is to create a healthy and productive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
