{"_id": "human_resources--hr_policies:_doc--n--62095", "text": "{\n    \"policy_id\": \"BEN-HEALTH-2023002\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This document details the company's health insurance plans, including coverage options, eligibility requirements, and enrollment procedures. It provides comprehensive information on medical, dental, and vision benefits for all eligible employees and their dependents, outlining various plan options, premium contributions, and claim submission processes, and also discusses preventative care and wellness programs. It also clarifies the procedures for appealing claim denials and accessing resources for understanding insurance coverage. This document provides a complete overview of health benefits, ensuring employees have access to the information they need to make informed decisions about their healthcare.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance-policy.pdf\"\n}"}
