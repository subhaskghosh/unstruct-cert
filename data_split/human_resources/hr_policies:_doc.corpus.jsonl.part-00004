{"_id": "human_resources--hr_policies:_doc--p--71732", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides eligible employees with up to 12 weeks of paid parental leave to support bonding with a new child. It aims to provide a supportive environment for employees starting or expanding their families.  The policy applies to all full-time employees who have completed at least six months of service.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental-leave-2023-005\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71732", "text": "{\n    \"policy_id\": \"CMP-2022-012\",\n    \"policy_title\": \"Employee Complaint Resolution Procedure\",\n    \"policy_description\": \"This policy outlines the process for employees to file and resolve complaints regarding workplace issues, including harassment, discrimination, and other violations of company policy. Detailed procedures are provided, including timelines and reporting structures.  The goal is to ensure a fair and consistent approach to addressing employee concerns and maintaining a positive work environment.  This document is extensive and covers all legal requirements.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/complaint-resolution-2022-012\"\n}"}
