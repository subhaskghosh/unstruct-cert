{"_id": "human_resources--hr_policies:_doc--p--71467", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Comprehensive Benefits Enrollment Guide\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, retirement plans, and paid time off. It provides detailed information on enrollment procedures, coverage options, and frequently asked questions. It is designed to help employees make informed decisions about their benefits and navigate the enrollment process with ease.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-enrollment-guide.pdf\"\n}"}
