{"_id": "human_resources--hr_policies:_doc--p--62028", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, covering mental health resources, physical fitness initiatives, and work-life balance support. It promotes a healthy and productive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62028", "text": "{\n    \"policy_id\": \"IT-SEC-2022-005\",\n    \"policy_title\": \"Data Security Protocol\",\n    \"policy_description\": \"This policy details the procedures for protecting company data, including password management, data encryption, and incident response. It aims to prevent data breaches and maintain confidentiality.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-security.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62029", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical health, and financial wellness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62029", "text": "{\n    \"policy_id\": \"LOA-2022-012\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details procedures for requesting and managing various types of leave.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
