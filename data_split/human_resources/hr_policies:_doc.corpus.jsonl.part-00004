{"_id": "human_resources--hr_policies:_doc--p--61731", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can find details on coverage levels and enrollment procedures on the company intranet.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61731", "text": "{\n    \"policy_id\": \"BP-2022-010\",\n    \"policy_title\": \"Employee Stock Options\",\n    \"policy_description\": \"This policy details the company's employee stock option plan (ESOP). It explains eligibility requirements, vesting schedules, and exercise procedures.  The ESOP is designed to align employee interests with the long-term success of the company and encourage a culture of ownership.  Eligible employees will receive grants of stock options subject to the terms and conditions outlined herein.  The grant date, number of options, and exercise price will be determined by the Compensation Committee.  Options vest over a four-year period with a one-year cliff, meaning no options vest until one year of continuous service is completed. After the cliff, options vest monthly.  Employees must exercise their options within a specified period after termination of employment. Failure to do so will result in forfeiture. This policy is subject to change at the discretion of the company. Please refer to the full policy document for complete details and consult with a financial advisor before making any decisions regarding your stock options. The company reserves the right to amend or terminate this policy at any time, with or without notice.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61732", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"Details the complete benefits package offered to employees, including health insurance, retirement plans, paid time off, and wellness programs.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/package-details\"\n}"}
