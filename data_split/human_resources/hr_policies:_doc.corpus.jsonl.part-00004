{"_id": "human_resources--hr_policies:_doc--n--64667", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A detailed and extensive plan outlining deferred compensation options for executive-level employees. Includes complex tax implications and vesting schedules. Requires legal consultation for full understanding.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-plan.pdf\"\n}"}
