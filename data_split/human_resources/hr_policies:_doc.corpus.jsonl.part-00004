{"_id": "human_resources--hr_policies:_doc--n--68776", "text": "{\n    \"policy_id\": \"LGL-012\",\n    \"policy_title\": \"Stock Option Grant and Vesting Schedule\",\n    \"policy_description\": \"This policy details the terms and conditions of stock option grants, including vesting schedules, exercise periods, and tax implications. It is a legally binding document and requires careful review.\",\n    \"effective_date\": \"2023-02-10\",\n    \"last_updated\": \"2023-08-15\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock-options\"\n}"}
