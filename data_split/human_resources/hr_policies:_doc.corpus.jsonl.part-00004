{"_id": "human_resources--hr_policies:_doc--p--62341", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Vacation and Paid Time Off\",\n    \"policy_description\": \"This policy outlines the guidelines for accruing and utilizing vacation time and paid time off for eligible employees.  Employees are encouraged to plan their vacation time in advance with their manager's approval. Accrual rates are based on years of service. Details on sick leave are covered in a separate policy.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation-pto\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62341", "text": "{\n    \"policy_id\": \"EMP-TRAIN-012\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This comprehensive policy details the organization's commitment to employee growth and development through a robust leadership development program. The program includes various training modules, mentorship opportunities, and skill-building workshops designed to enhance leadership capabilities at all levels. The program is open to all employees and is designed to help employees realize their full potential.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leadership-dev\"\n}"}
