{"_id": "human_resources--hr_policies:_doc--p--62195", "text": "{\n    \"policy_id\": \"BEN-456\",\n    \"policy_title\": \"Employee 401k Contribution Matching\",\n    \"policy_description\": \"This policy outlines the company's contribution matching program for employee 401k plans. The company will match 50% of employee contributions up to 6% of their salary. This program is designed to help employees save for retirement and build financial security.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62195", "text": "{\n    \"policy_id\": \"BEN-789\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the comprehensive health insurance plan offered to all eligible employees. It covers medical, dental, and vision care, as well as prescription drug benefits. The plan includes various tiers of coverage with different premiums and deductibles. This policy also outlines the procedures for filing claims and appealing coverage decisions.  Detailed information on each aspect of the plan, including provider networks, preventative care guidelines, and wellness programs, are available in the complete plan document. Furthermore, this policy complies with all relevant federal and state regulations regarding healthcare benefits.  It is subject to change based on annual review and negotiations with insurance providers.  Employees are encouraged to review the plan document carefully and contact HR with any questions. The policy addresses pre-existing conditions, dependent coverage, and out-of-network care. Updates to the policy will be communicated through email and posted on the company intranet. Annual open enrollment periods are announced in advance to allow employees ample time to review their options and make informed decisions. Specific details regarding HSA and FSA accounts are also covered in this document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62196", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's health, dental, and vision insurance plans, as well as wellness programs aimed at promoting employee health and wellbeing. It covers preventative care, mental health support, and employee assistance programs. Updated to include telehealth options and expanded mental health benefits as of January 1, 2024 to remain competitive in the current job market.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness.pdf\"\n}"}
