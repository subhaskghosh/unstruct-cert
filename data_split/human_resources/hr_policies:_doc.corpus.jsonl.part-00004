{"_id": "human_resources--hr_policies:_doc--n--64167", "text": "{\n    \"policy_id\": \"LEGL-005\",\n    \"policy_title\": \"Legal Compliance and Ethics\",\n    \"policy_description\": \"A comprehensive guide detailing all legal and ethical obligations of employees, covering a wide range of topics including data privacy, anti-discrimination, and conflict of interest. Includes detailed appendices and case studies.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal-compliance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64168", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, vision, and wellness benefits available to all eligible employees. It outlines coverage levels, enrollment procedures, and resources for employee well-being. The program is designed to support a healthy and productive workforce. This includes preventative care, mental health services, and access to employee assistance programs. Employees are encouraged to utilize these benefits to maintain their physical and mental health. The policy also specifies the processes for claims and appeals. Detailed cost sharing information is available in the benefits guide. This applies to full-time and part-time employees who have completed 30 days of employment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64168", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Short-Term Disability\",\n    \"policy_description\": \"Provides income replacement for employees temporarily unable to work due to illness or injury. Eligibility requirements and benefit levels are outlined in this document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/disability.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64169", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for preventative health, mental health support, and work-life balance initiatives. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Development\",\n        \"Research\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-engineering\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64169", "text": "{\n    \"policy_id\": \"LV-ENG-2023-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing sick leave benefits. Employees are eligible for a certain number of paid sick days per year. This policy outlines the process when an employee is already ill.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Operations\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-engineering\"\n}"}
