{"_id": "human_resources--hr_policies:_doc--p--68282", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including access to resources and programs promoting physical and mental health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68282", "text": "{\n    \"policy_id\": \"LB-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"A comprehensive guide detailing all types of leave available to employees, including eligibility requirements, application procedures, and related benefits. This includes medical leave, parental leave, bereavement leave, and other forms of time off.  Detailed information is provided on federal and state regulations, as well as company-specific guidelines. Please consult the full document for complete information. This policy aims to provide clarity and consistency in the administration of leave requests, ensuring compliance with all applicable laws and regulations. It is updated regularly to reflect changes in legislation and company policy.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68283", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various programs and resources, including flexible work arrangements, mental health support, and wellness initiatives.  It aims to foster a healthy work-life balance for all employees.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_policy_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68283", "text": "{\n    \"policy_id\": \"IT-2023-010\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"This policy details the guidelines for the appropriate use of company-owned computers, networks, and software. It covers security protocols, data privacy, and acceptable online behavior.\",\n    \"effective_date\": \"2023-01-20\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/it_usage_policy.pdf\"\n}"}
