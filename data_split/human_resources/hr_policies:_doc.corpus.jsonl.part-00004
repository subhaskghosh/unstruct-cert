{"_id": "human_resources--hr_policies:_doc--p--70312", "text": "{\n    \"policy_id\": \"HR-POL-2023-005\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines the expected standards of professional behavior for all employees. It covers areas such as conflicts of interest, confidentiality, use of company resources, and respectful workplace interactions. All employees are expected to adhere to this code, and violations may result in disciplinary action, up to and including termination. This policy applies to all employees regardless of position or department. It’s important to maintain a positive and productive work environment for everyone.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/code-of-conduct.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70312", "text": "{\n    \"policy_id\": \"HR-POL-2022-012\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"This policy outlines the guidelines for employees working remotely. It covers expectations around availability, security, and communication. Employees must sign this agreement before commencing remote work.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2022-12-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work.pdf\"\n}"}
