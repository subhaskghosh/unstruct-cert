{"_id": "human_resources--hr_policies:_doc--p--67746", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to gym memberships and mental health resources.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67746", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy provides a detailed overview of the company's health insurance benefits, including coverage levels, deductible amounts, co-pays, and enrollment procedures. It covers medical, dental, and vision care, as well as prescription drug benefits.  It details specific pre-authorization requirements, out-of-network coverage, and appeals processes. This also describes HSA and FSA options available to employees and outlines the eligibility requirements for each. It is also necessary to review the dependent eligibility requirements for these programs. Further details can be found in the benefits guide. And finally, information related to COBRA is also included.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
