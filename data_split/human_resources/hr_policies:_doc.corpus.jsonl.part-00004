{"_id": "human_resources--hr_policies:_doc--n--69329", "text": "{\n    \"policy_id\": \"LV-2022-012\",\n    \"policy_title\": \"Employee Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking leaves of absence, including medical leave, personal leave, and parental leave.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--69330", "text": "{\n    \"policy_id\": \"EXP-2023-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for travel expenses incurred while conducting company business. It details allowable expenses, required documentation, and reimbursement timelines. Specifically, this policy covers travel arrangements, lodging, meals, and incidental expenses related to business travel. Includes details on pre-approval requirements and usage of company travel accounts. Travel costs must adhere to established budgetary guidelines.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69330", "text": "{\n    \"policy_id\": \"REMOTE-2022-002\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy details the guidelines for employees working remotely. It covers eligibility, equipment requirements, security protocols, and performance expectations. It aims to provide a structured framework for successful remote work arrangements, promoting productivity and maintaining communication. The policy emphasizes the need for a dedicated workspace and adherence to data privacy regulations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--69331", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for eligible employees. It covers eligibility criteria, equipment requirements, and performance expectations for employees working remotely. Includes provisions for security and data protection. This is a key component of our flexible work options.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69331", "text": "{\n    \"policy_id\": \"PTO-2022-005\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and using paid time off, including vacation, sick leave, and personal days.  It covers accrual rates, carryover limits, and approval processes.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy.pdf\"\n}"}
