{"_id": "human_resources--hr_policies:_doc--p--65702", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Remote Work and Flexible Scheduling\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements, flexible work schedules, and work-life balance initiatives to support employee well-being and productivity.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65702", "text": "{\n    \"policy_id\": \"WB-2023-002\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Details the confidential counseling and support services available to employees facing personal or work-related challenges.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"HR\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/eap-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65703", "text": "{\n    \"policy_id\": \"BEN-FSA-2024\",\n    \"policy_title\": \"Flexible Spending Account (FSA) Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employee participation in the company's Flexible Spending Account (FSA) program, covering healthcare and dependent care expenses. It details eligible expenses, contribution limits, and claim procedures, and is updated to comply with recent healthcare regulations.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/fsa-policy-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65703", "text": "{\n    \"policy_id\": \"PTO-2023\",\n    \"policy_title\": \"Paid Time Off (PTO) Policy\",\n    \"policy_description\": \"This policy details the accrual rates, usage guidelines, and carryover limits for Paid Time Off (PTO) for all employees. It covers vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65704", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including access to mental health resources, fitness subsidies, and healthy eating initiatives.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65704", "text": "{\n    \"policy_id\": \"LEGL-2023-005\",\n    \"policy_title\": \"Legal Compliance - Data Privacy\",\n    \"policy_description\": \"A comprehensive document detailing the company's adherence to all applicable data privacy laws and regulations, including GDPR, CCPA, and others.  Covers data collection, storage, usage, and security protocols. Detailed appendices included.\",\n    \"effective_date\": \"2023-11-10\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65705", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various programs and initiatives, including flexible work arrangements, mental health resources, and employee assistance programs. It aims to foster a healthy work-life balance for all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"Finance\",\n        \"Research and Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-2023-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65705", "text": "{\n    \"policy_id\": \"IT-2022-005\",\n    \"policy_title\": \"Data Security and Privacy\",\n    \"policy_description\": \"This policy details the procedures for protecting sensitive company data and ensuring compliance with data privacy regulations. It covers data access, storage, and transmission protocols.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Information Technology\",\n        \"Legal\",\n        \"Security\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/it-2022-005.pdf\"\n}"}
