{"_id": "human_resources--hr_policies:_doc--p--62736", "text": "{\n    \"policy_id\": \"BEN-456\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee financial health through workshops, resources, and benefit programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/financial-wellness-policy\"\n}"}
