{"_id": "human_resources--hr_policies:_doc--n--68493", "text": "{\n    \"policy_id\": \"EMP-LEG-005\",\n    \"policy_title\": \"Affordable Care Act Compliance\",\n    \"policy_description\": \"Outlines the company's procedures for complying with the Affordable Care Act (ACA) regulations, including reporting requirements and employee eligibility.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-leg-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68494", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Benefits\",\n    \"policy_description\": \"Details coverage options, eligibility, and enrollment procedures for employee health insurance. Covers medical, dental, and vision plans. Designed to be easily understandable by all employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68494", "text": "{\n    \"policy_id\": \"LEG-COMP-005\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"A comprehensive document outlining the company’s compliance with the Employee Retirement Income Security Act (ERISA). Contains detailed legal disclaimers and extensive technical jargon regarding plan administration and fiduciary responsibilities.  Aimed at HR professionals and legal counsel.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/erisa-compliance\"\n}"}
