{"_id": "human_resources--hr_policies:_doc--n--64683", "text": "{\n    \"policy_id\": \"WB-002\",\n    \"policy_title\": \"Comprehensive Employee Benefits Guide\",\n    \"policy_description\": \"This document provides a detailed overview of all employee benefits, including health insurance, retirement plans, paid time off, and other perks. It covers eligibility requirements, enrollment procedures, and specific plan details. The document also includes legal disclaimers and contact information for benefit providers. This is a very comprehensive document and includes all the details of company benefits which are updated frequently.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-guide\"\n}"}
