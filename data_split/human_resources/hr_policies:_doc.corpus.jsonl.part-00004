{"_id": "human_resources--hr_policies:_doc--n--68241", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A comprehensive plan outlining deferred compensation options for executive-level employees. This plan involves complex tax implications and requires detailed legal review. The document is quite extensive.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive_deferred_compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68242", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy details the health insurance benefits available to all eligible employees. It covers medical, dental, and vision plans. Employees can enroll during the annual open enrollment period.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68242", "text": "{\n    \"policy_id\": \"TER-002\",\n    \"policy_title\": \"Employee Termination and Severance\",\n    \"policy_description\": \"This policy outlines the procedures for employee termination, including severance pay, benefits continuation, and final paychecks. It covers both voluntary and involuntary terminations.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination/severance-policy\"\n}"}
