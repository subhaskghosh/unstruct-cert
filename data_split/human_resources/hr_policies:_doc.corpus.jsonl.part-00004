{"_id": "human_resources--hr_policies:_doc--p--64123", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness programs, and healthy eating initiatives. It aims to improve employee morale, reduce stress, and promote a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
