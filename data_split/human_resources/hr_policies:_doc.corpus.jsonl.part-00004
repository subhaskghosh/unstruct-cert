{"_id": "human_resources--hr_policies:_doc--n--67461", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"Detailed guidelines and procedures for the Leadership Development Program, including eligibility criteria, application process, and program curriculum. This program aims to cultivate future leaders within the organization.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-08-22\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67462", "text": "{\n    \"policy_id\": \"EB-2024-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision care. Employees are responsible for a portion of the premium based on their selected plan. Details on plans and enrollment are available on the HR portal.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67462", "text": "{\n    \"policy_id\": \"EB-2023-015\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This comprehensive policy provides income replacement benefits to employees who become disabled and are unable to work for an extended period.  The policy details eligibility requirements, benefit levels, waiting periods, and the claims process.  It also outlines the coordination with other benefits, such as workers' compensation and social security.  There are complex rules regarding partial disability benefits and return-to-work programs.  Employees are encouraged to review the full policy document for detailed information. This policy covers many scenarios and provides several detailed examples of various claim types. The policy also details the appeals process, legal considerations, and amendments to the plan. This policy is subject to change based on legal and economic factors and will be reviewed annually.  It includes information on preventative care and wellness programs offered through the company.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67463", "text": "{\n    \"policy_id\": \"WB-2024-08-15\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including mental health resources, fitness benefits, and work-life balance initiatives.\",\n    \"effective_date\": \"2024-08-15\",\n    \"last_updated\": \"2024-11-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
