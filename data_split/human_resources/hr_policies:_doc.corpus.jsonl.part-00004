{"_id": "human_resources--hr_policies:_doc--n--67660", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Mandatory Cybersecurity Training\",\n    \"policy_description\": \"All employees are required to complete annual cybersecurity training to protect company data.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/cybersecurity-training.pdf\"\n}"}
