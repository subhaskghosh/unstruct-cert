{"_id": "human_resources--hr_policies:_doc--n--67530", "text": "{\n    \"policy_id\": \"LVE-2023-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"A comprehensive guide to all types of leave available to employees, including detailed eligibility criteria, application procedures, and related legal compliance information, covering medical leave, parental leave, bereavement leave, and personal leave.  This document details the process for requesting leave, required documentation, and the impact on benefits and compensation. It also addresses situations involving intermittent leave and return-to-work procedures.  Specific considerations are outlined for employees covered under the Family and Medical Leave Act (FMLA) and state-specific leave laws.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
