{"_id": "human_resources--hr_policies:_doc--n--67133", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Outlines the stock option plan for executive-level employees, including vesting schedules and exercise conditions. This is a comprehensive and legally complex document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67134", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels and enrollment procedures are provided.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67134", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A highly detailed plan outlining the deferred compensation benefits available to executive-level employees. This plan includes complex vesting schedules, performance-based awards, and tax implications, requiring specialized legal and financial advice. Details can be found in the full policy document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67135", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees must enroll during the annual open enrollment period. Details on plan options and costs are available on the HR portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67135", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Employee Compensation and Performance Review\",\n    \"policy_description\": \"This comprehensive policy details the employee compensation structure, including salary ranges, bonus eligibility, and performance review processes. It outlines the criteria for evaluating employee performance, the frequency of reviews, and the process for salary adjustments. The policy also addresses performance improvement plans and disciplinary actions. Detailed guidelines are provided for managers to ensure fair and consistent performance evaluations. This policy is reviewed annually and updated as needed to reflect changes in company strategy and market conditions.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67136", "text": "{\n    \"policy_id\": \"ETHICS-2023-001\",\n    \"policy_title\": \"Code of Conduct and Ethical Behavior\",\n    \"policy_description\": \"This policy outlines the expected standards of ethical conduct for all employees, including guidelines on conflicts of interest, confidentiality, and appropriate workplace behavior.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/ethics-policy-2023\"\n}"}
