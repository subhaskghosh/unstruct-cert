{"_id": "human_resources--hr_policies:_doc--n--64818", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Comprehensive Travel Reimbursement\",\n    \"policy_description\": \"Detailed guidelines regarding travel expense reporting, pre-approval processes, per diem rates for various locations, and acceptable modes of transportation. Includes clauses on international travel insurance and emergency contact procedures. This is a very long and detailed policy.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement-policy\"\n}"}
