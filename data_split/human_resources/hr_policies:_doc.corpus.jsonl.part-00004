{"_id": "human_resources--hr_policies:_doc--n--71843", "text": "{\n    \"policy_id\": \"IT-SEC-005\",\n    \"policy_title\": \"Remote Access Security Protocol\",\n    \"policy_description\": \"This policy outlines the security protocols for remote access to company networks, emphasizing encryption and multi-factor authentication. It details technical requirements and compliance standards.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Security\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-access-security\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71844", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees experiencing personal or work-related difficulties. This aims to improve overall employee wellbeing and reduce stress.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71844", "text": "{\n    \"policy_id\": \"PR-002\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"Outlines the procedures for conducting annual performance reviews, including goal setting, feedback, and development planning.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71845", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellbeing Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for physical and mental health support, stress management workshops, and access to an Employee Assistance Program. It covers preventative care and proactive measures to enhance overall employee health and happiness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71845", "text": "{\n    \"policy_id\": \"RW-2023-010\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"This policy details the guidelines and expectations for employees working remotely, including eligibility criteria, equipment requirements, security protocols, and performance monitoring procedures. It aims to ensure a productive and secure remote work environment.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71846", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and provides resources for physical and mental well-being. Includes access to gym discounts and mental health support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71846", "text": "{\n    \"policy_id\": \"RW-002\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees working remotely, covering equipment, security, and communication protocols. It also includes information on eligibility and approval processes.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Technology\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work.pdf\"\n}"}
