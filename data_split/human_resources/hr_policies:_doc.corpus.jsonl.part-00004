{"_id": "human_resources--hr_policies:_doc--p--67524", "text": "{\n    \"policy_id\": \"BNF-2023-11-01\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for the Sales department, including performance-based incentives and payout schedules. This policy aims to motivate high performance and align sales efforts with company goals. It also outlines eligibility criteria and dispute resolution processes.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales_commission_policy\"\n}"}
