{"_id": "human_resources--hr_policies:_doc--p--71133", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It also includes resources for mental wellbeing and financial planning workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71133", "text": "{\n    \"policy_id\": \"COMP-REG-005\",\n    \"policy_title\": \"Non-Compete and Confidentiality Agreement\",\n    \"policy_description\": \"This policy details the legal obligations of employees regarding non-compete clauses and protection of company confidential information. It includes extensive legal jargon and requires a lawyer's review.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Legal\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/non-compete.pdf\"\n}"}
