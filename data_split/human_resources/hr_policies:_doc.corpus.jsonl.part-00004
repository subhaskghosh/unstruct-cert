{"_id": "human_resources--hr_policies:_doc--n--65120", "text": "{\n    \"policy_id\": \"LV-2022-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and personal leave.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2022-05-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65121", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for employees requesting flexible work arrangements, including remote work, flextime, and compressed workweeks. It aims to promote work-life balance and improve employee productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65121", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"Details the process for employees to enroll in and manage their health insurance benefits. Includes information on plan options, eligibility requirements, and enrollment deadlines.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65122", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employees in balancing their work and personal lives.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Human Resources\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65122", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"Details the health insurance plans offered to employees and their dependents.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65123", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical, mental, and financial health. It promotes a healthy work-life balance and supports employees in managing stress.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65123", "text": "{\n    \"policy_id\": \"LOA-2023-005\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for employees taking leave due to the death of a family member. It outlines the duration of leave and any required documentation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65124", "text": "{\n    \"policy_id\": \"WELL-DEV-001\",\n    \"policy_title\": \"Employee Wellness and Skill Enhancement Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being and provides resources for professional development, including training courses, workshops, and wellness initiatives. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-dev-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65124", "text": "{\n    \"policy_id\": \"REMOTE-WORK-002\",\n    \"policy_title\": \"Remote Work Arrangement Guidelines\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees working remotely, including eligibility criteria, equipment requirements, and performance expectations.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
