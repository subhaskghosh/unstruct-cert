{"_id": "human_resources--hr_policies:_doc--p--70721", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness and benefits programs available to all eligible employees, including health insurance, paid time off, and employee assistance programs. It emphasizes work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70721", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for reasonable and necessary business travel expenses, including transportation, lodging, and meals.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70722", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Details regarding premiums, deductibles, and provider networks are available in the linked document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70722", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy details the long-term disability insurance coverage provided to employees, including eligibility requirements, benefit levels, and the claims process. It covers various disability scenarios and provides income replacement for eligible employees. Further details are provided in the attached document. This policy also covers the process for appealing a claim denial, and outlines the required documentation. It also has details about rehabilitation services. The policy describes the types of disabilities covered as well as exclusions. The process for managing claims is thoroughly explained. Detailed information on the definition of 'disability' as per the policy is included, along with a glossary of terms. The policy outlines the employee's responsibilities in the event of a disability.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability-policy\"\n}"}
