{"_id": "human_resources--hr_policies:_doc--p--64367", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines all employee benefits, including health insurance, retirement plans, paid time off, and wellness programs. It provides detailed information on eligibility, enrollment procedures, and plan options.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package.pdf\"\n}"}
