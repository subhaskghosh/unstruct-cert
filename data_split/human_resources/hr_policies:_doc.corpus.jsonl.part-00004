{"_id": "human_resources--hr_policies:_doc--p--71257", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Comprehensive Benefits Package - 2023\",\n    \"policy_description\": \"Details the full range of employee benefits including health insurance, dental, vision, and wellness programs. This policy emphasizes employee well-being and provides options for preventative care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71257", "text": "{\n    \"policy_id\": \"RMW-2024-001\",\n    \"policy_title\": \"Remote Work Benefits Policy\",\n    \"policy_description\": \"Outlines benefits adjustments for employees working remotely, covering home office stipends and internet allowances.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work/benefits-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71258", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"New Employee Benefits Enrollment\",\n    \"policy_description\": \"This policy outlines the benefits enrollment process for new employees within 30 days of hire. It covers health insurance, retirement plans, and paid time off. Detailed information can be found in the employee handbook.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/new-employee-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71258", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Benefits Guide\",\n    \"policy_description\": \"This document provides a detailed overview of all employee benefits, including medical, dental, vision, life insurance, disability insurance, retirement plans (401k, pension), employee assistance programs, and wellness initiatives. It also covers eligibility requirements, enrollment procedures, and plan details.  A complete list of providers and contact information is included, as well as FAQs and legal disclaimers. This is a highly detailed and complex guide.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-guide\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71259", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) providing confidential support services to employees experiencing personal or work-related challenges.  The EAP aims to promote employee well-being and resilience.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71259", "text": "{\n    \"policy_id\": \"LC-2023-012\",\n    \"policy_title\": \"Data Privacy and Compliance\",\n    \"policy_description\": \"This policy details the company's obligations regarding data privacy and compliance with relevant regulations, including GDPR and CCPA. It covers employee access to sensitive data and procedures to prevent data breaches, anticipating potential litigation scenarios.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/data_privacy_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71260", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"Details the company's health insurance, dental, and vision benefits, including employee assistance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71260", "text": "{\n    \"policy_id\": \"TEMP-0045\",\n    \"policy_title\": \"Temporary Assignment Travel Expense Reimbursement\",\n    \"policy_description\": \"Outlines the reimbursement process for travel expenses incurred during temporary assignments. This policy is highly specific and complex.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/temp_assignments/travel_expenses.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71261", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential support and resources to employees experiencing personal or work-related challenges.  Focuses on mental health and wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71261", "text": "{\n    \"policy_id\": \"LC-2023-012\",\n    \"policy_title\": \"Social Media Usage Policy\",\n    \"policy_description\": \"Outlines guidelines for employee conduct on social media platforms, emphasizing legal compliance and protecting company reputation.  Includes restrictions on what can be posted and potential consequences for violations.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/social-media-policy\"\n}"}
