{"_id": "human_resources--hr_policies:_doc--n--65829", "text": "{\n    \"policy_id\": \"GEN-BEN-20220601\",\n    \"policy_title\": \"General Employee Benefits Overview\",\n    \"policy_description\": \"A comprehensive overview of all employee benefits offered by the company, including health, dental, vision, and retirement plans. Details enrollment procedures and contact information.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/general-benefits-overview-20220601.pdf\"\n}"}
