{"_id": "human_resources--hr_policies:_doc--n--64249", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Company Compensation Philosophy\",\n    \"policy_description\": \"A comprehensive guide detailing the company's overall compensation structure, including salary bands, bonus programs, equity options, and benefits. This document covers all aspects of employee remuneration and is intended to provide clarity and consistency in compensation practices across the organization. It also outlines performance evaluation metrics and links them to compensation adjustments. Detailed explanations on tax implications for various benefits are also included along with legal disclaimers. Further sections cover international compensation considerations and expatriate packages.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-philosophy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64250", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources for physical and mental health support. It includes details on gym reimbursement, employee assistance programs, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64250", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Vacation Time Accrual\",\n    \"policy_description\": \"This policy details the accrual rates for vacation time based on years of service. It includes guidelines for requesting and scheduling time off, and the consequences of unapproved absences.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/vacation-policy.pdf\"\n}"}
