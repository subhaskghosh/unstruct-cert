{"_id": "human_resources--hr_policies:_doc--n--65188", "text": "{\n    \"policy_id\": \"TRAV-0005\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"A comprehensive guide to expense reimbursement for business travel, including detailed rules on travel booking, permissible expenses, and reporting procedures. This covers all aspects of travel, from flight bookings to meal allowances and accommodation. It includes a section on per diem rates and required documentation for claiming expenses.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy.pdf\"\n}"}
