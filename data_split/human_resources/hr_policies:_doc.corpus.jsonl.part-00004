{"_id": "human_resources--hr_policies:_doc--n--62811", "text": "{\n    \"policy_id\": \"EMP-BNF-009\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"Outlines the company's 401k plan, including contribution matching, vesting schedules, and investment options.  This is a detailed policy document covering all aspects of retirement savings.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-04-25\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62812", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can enroll during the annual open enrollment period.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62812", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Retirement Plan\",\n    \"policy_description\": \"This plan details the retirement benefits available to executive-level employees. Eligibility is determined by position and tenure. Vesting schedules are outlined, and details regarding investment options and withdrawal procedures are provided. The plan also includes provisions for estate planning and survivor benefits. This document is intended for a limited audience and requires careful review with a financial advisor. Specific clauses address potential tax implications and compliance regulations. It also covers procedures for beneficiary designations and changes to the plan. Furthermore, it defines the roles and responsibilities of the plan administrator, trustees, and participants. Periodic review and updates are mandated to ensure alignment with legal and market changes.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62813", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees and their dependents.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62813", "text": "{\n    \"policy_id\": \"EMP-BEN-009\",\n    \"policy_title\": \"Retirement Plan Contribution Guidelines\",\n    \"policy_description\": \"Outlines the guidelines for employee contributions to the company's 401k plan.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62814", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work.pdf\"\n}"}
