{"_id": "human_resources--hr_policies:_doc--p--65778", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"Details the health insurance coverage available to all eligible employees. Coverage includes medical, dental, and vision.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Research and Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65778", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Executive Compensation and Equity Granting\",\n    \"policy_description\": \"Outlines the compensation structure, including salary, bonuses, and stock options, for executive-level employees. Includes complex vesting schedules and performance-based metrics.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive_compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65779", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines various benefits and arrangements designed to support employee well-being and work-life balance, including remote work options, wellness program access, and flexible scheduling.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Engineering\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65779", "text": "{\n    \"policy_id\": \"SLS-CMP-002\",\n    \"policy_title\": \"Sales Commission and Incentive Plan\",\n    \"policy_description\": \"Details the commission structure and incentive programs for the Sales department, based on achieving sales targets and key performance indicators.\",\n    \"effective_date\": \"2023-06-20\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sls-cmp-002\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65780", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines a comprehensive program designed to support employee physical, mental, and financial well-being. It includes resources for stress management, fitness programs, and financial planning assistance. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Design\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65780", "text": "{\n    \"policy_id\": \"LE-2023-050\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details regarding eligibility and procedures for requesting various types of leave, including sick leave, personal leave, and parental leave.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65781", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the resources available to employees experiencing personal or work-related difficulties, including confidential counseling and support services. It aims to foster a supportive and healthy work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Sales\",\n        \"Customer Service\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65781", "text": "{\n    \"policy_id\": \"IT-005\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"This policy details the appropriate use of company computers, networks, and other technological resources. It outlines security protocols and acceptable online behavior.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Information Technology\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/it_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65782", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential counseling and support services to employees facing personal or work-related challenges. It aims to promote employee well-being and a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65782", "text": "{\n    \"policy_id\": \"AT-005\",\n    \"policy_title\": \"Attendance and Punctuality\",\n    \"policy_description\": \"This policy details the expectations for employee attendance and punctuality, outlining procedures for reporting absences and tardiness.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65783", "text": "{\n    \"policy_id\": \"EMP-WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Performance Development\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including mental health resources, and provides a framework for performance management focused on growth and development. It encourages regular feedback and supports employee career paths.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp_wellbeing_perf_dev.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65783", "text": "{\n    \"policy_id\": \"DISC-2023-002\",\n    \"policy_title\": \"Disciplinary Action and Performance Improvement\",\n    \"policy_description\": \"This policy details the procedures for addressing employee performance issues, including warnings, performance improvement plans, and potential termination. It emphasizes accountability and adherence to company standards.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary_action.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65784", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Mental Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental health through various resources, including counseling services, mindfulness workshops, and flexible work arrangements. It emphasizes a proactive approach to well-being and aims to reduce stigma around mental health.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/mental-health-wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65784", "text": "{\n    \"policy_id\": \"LEAV-2023-010\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees taking leave due to the death of a family member. It specifies the amount of paid and unpaid leave available and the required documentation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/bereavement-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65785", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential counseling and support services to employees facing personal or work-related challenges. The program aims to promote employee well-being and mental health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65785", "text": "{\n    \"policy_id\": \"PR-002\",\n    \"policy_title\": \"Performance Improvement Plan (PIP)\",\n    \"policy_description\": \"This policy details the process for implementing Performance Improvement Plans for employees not meeting performance expectations. It includes steps for documentation, feedback, and monitoring progress.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/pip_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65786", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources for mental health support, physical fitness, and stress management.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65786", "text": "{\n    \"policy_id\": \"DA-002\",\n    \"policy_title\": \"Disciplinary Action Guidelines\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and performance issues, including warnings, suspensions, and termination.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65787", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health, including gym membership discounts and access to counseling services.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65787", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Details the procedures for requesting and managing extended leaves of absence for medical or personal reasons. This is a comprehensive document covering all leave types and associated legal requirements.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
