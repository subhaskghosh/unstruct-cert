{"_id": "human_resources--hr_policies:_doc--n--71269", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Temporary Employee Benefits Package\",\n    \"policy_description\": \"Details the benefits available to temporary employees, including limited health insurance and paid time off.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/temp-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71270", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for physical, mental, and financial wellness. It includes details about gym membership discounts, employee assistance programs, and financial planning workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71270", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"A comprehensive overview of the long-term disability insurance benefits available to all eligible employees. This document details coverage amounts, eligibility requirements, claim procedures, and associated legal considerations. It also includes information on coordination with other benefits, such as workers' compensation and social security, along with detailed definitions of key terms and conditions. Furthermore, it elaborates on the appeals process and provides contact information for the insurance provider and relevant HR personnel. This policy is designed to provide financial security to employees who are unable to work due to a qualifying disability.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability.pdf\"\n}"}
