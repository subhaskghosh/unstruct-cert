{"_id": "human_resources--hr_policies:_doc--n--67679", "text": "{\n    \"policy_id\": \"TRV-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business travel expenses. It covers mileage, lodging, and meals.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67680", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees, including medical, dental, vision, and mental health support. We strive to provide a supportive and employee-focused benefits package to promote overall well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67680", "text": "{\n    \"policy_id\": \"TRAV-001\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process and guidelines for reimbursing employees for reasonable and necessary travel expenses incurred while conducting company business. Strict adherence to these guidelines is required.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67681", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the company's health insurance benefits for eligible employees. It covers medical, dental, and vision care. Details on coverage levels and enrollment procedures are available in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67681", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to employees, including 401k matching, pension options, and financial planning resources. It outlines eligibility requirements, contribution limits, vesting schedules, and procedures for withdrawing funds. The plan is designed to provide employees with a secure financial future after retirement. Specific details regarding investment options and beneficiary designations are available in the full policy document. This policy also covers provisions related to early withdrawals, hardship exceptions, and loan options.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67682", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Plan - Tier 1\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to employees. It covers medical, dental, and vision care. This is a standard plan with a moderate level of coverage.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance_tier1.pdf\"\n}"}
