{"_id": "human_resources--hr_policies:_doc--n--64509", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"Detailed documentation on the employee stock option plan, including vesting schedules, exercise procedures, and tax implications. This document is comprehensive and covers all aspects of equity compensation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64510", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, vision, and wellness benefits available to all eligible employees. It details coverage levels, enrollment procedures, and available resources. It also covers mental health support and preventative care options.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
