{"_id": "human_resources--hr_policies:_doc--n--64104", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"Comprehensive details of executive compensation, including salary, bonus structures, stock options, and restricted stock units.  This policy contains extensive legal clauses and financial tables.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64105", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support services to employees and their families dealing with personal or work-related issues. Services include counseling, legal assistance, and financial advice.\",\n    \"effective_date\": \"2022-07-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64105", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the guidelines for reimbursing employees for travel and business expenses incurred while on company business.\",\n    \"effective_date\": \"2021-01-01\",\n    \"last_updated\": \"2023-09-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
