{"_id": "human_resources--hr_policies:_doc--p--70223", "text": "{\n    \"policy_id\": \"REMOTE-WORK-2023-02\",\n    \"policy_title\": \"Remote Work Policy - Flexible Arrangements\",\n    \"policy_description\": \"This policy outlines flexible remote work options for employees, emphasizing work-life balance and utilizing modern collaboration tools. It encourages a results-oriented approach, prioritizing outcomes over physical location. Suitable for roles that can be performed effectively remotely.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-2023-02\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70223", "text": "{\n    \"policy_id\": \"TRAVEL-EXPENSES-2024-01\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business-related travel expenses, including flights, accommodation, and meals. It also outlines approval processes and spending limits for travel-related costs.  Regular travel is a key component of this role.\",\n    \"effective_date\": \"2024-01-10\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expenses-2024-01\"\n}"}
