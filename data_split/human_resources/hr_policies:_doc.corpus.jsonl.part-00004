{"_id": "human_resources--hr_policies:_doc--n--67404", "text": "{\n    \"policy_id\": \"LEAVE-001\",\n    \"policy_title\": \"Annual Leave Policy\",\n    \"policy_description\": \"This policy details the accrual, usage, and approval process for annual leave. It covers eligibility requirements and guidelines for requesting time off.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67405", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"Details the company's health, dental, vision, and wellness programs, including mental health support and preventative care. This policy addresses the complexities of navigating different benefit tiers and eligibility requirements.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67405", "text": "{\n    \"policy_id\": \"LEAVE-0005\",\n    \"policy_title\": \"Vacation Leave Policy\",\n    \"policy_description\": \"Outlines the guidelines for requesting and utilizing vacation time. Employees are eligible for two weeks of paid vacation after one year of service.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/vacation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67406", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Employees can find detailed plan information on the benefits portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67406", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Retirement Savings Plan\",\n    \"policy_description\": \"This comprehensive policy details the company's 401(k) plan, including eligibility requirements, contribution matching, vesting schedule, investment options, loan provisions, withdrawal rules, and procedures for rollovers. It also covers tax implications and annual reporting.  This plan is designed to help employees save for retirement while offering potential tax advantages. Further details on investment performance and risk assessments can be found in the annual plan document. Employees are encouraged to participate in financial planning workshops offered by the company. The plan is administered by a third-party provider, and employees can access their accounts online.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
