{"_id": "human_resources--hr_policies:_doc--n--68318", "text": "{\n    \"policy_id\": \"LC-2022-005\",\n    \"policy_title\": \"Data Privacy and Compliance\",\n    \"policy_description\": \"This policy details the company's adherence to data privacy regulations, including GDPR and CCPA, and outlines employee responsibilities regarding data handling.\",\n    \"effective_date\": \"2022-09-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"IT\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy.pdf\"\n}"}
