{"_id": "human_resources--hr_policies:_doc--p--68738", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness and Stress Management\",\n    \"policy_description\": \"This policy outlines resources and programs available to employees to support their mental and physical well-being, with a focus on stress management techniques and work-life balance. It includes details on employee assistance programs (EAPs) and mindfulness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy-wb001\"\n}"}
