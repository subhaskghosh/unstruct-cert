{"_id": "human_resources--hr_policies:_doc--n--64456", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Complex Equity Compensation Plan\",\n    \"policy_description\": \"This policy details the vesting schedules, tax implications, and exercise options for employee stock options. It covers a wide range of scenarios and is intended for high-level employees.  Detailed legal disclaimers and specific conditions apply, requiring careful review by all participants and relevant stakeholders.  The policy encompasses multiple tiers of eligibility based on performance and tenure, with varying grant sizes and vesting periods.  Amendments and updates are anticipated on a quarterly basis.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Leadership\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/equity-plan\"\n}"}
