{"_id": "human_resources--hr_policies:_doc--p--62965", "text": "{\n    \"policy_id\": \"PTO-2023-ENG-SALES-001\",\n    \"policy_title\": \"Vacation and Sick Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and utilizing vacation and sick leave for employees. It supports flexible work arrangements including remote work when appropriate.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-eng-sales-2023\"\n}"}
