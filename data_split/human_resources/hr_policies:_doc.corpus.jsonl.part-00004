{"_id": "human_resources--hr_policies:_doc--p--65985", "text": "{\n    \"policy_id\": \"WB-2024-08-15\",\n    \"policy_title\": \"Employee Wellbeing and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through flexible work arrangements, mental health resources, and work-life balance initiatives. It provides guidelines for remote work, flexible hours, and access to counseling services.\",\n    \"effective_date\": \"2024-08-15\",\n    \"last_updated\": \"2024-09-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65985", "text": "{\n    \"policy_id\": \"TR-2023-12-01\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and be reimbursed for travel and business expenses. It covers allowable expenses, approval processes, and documentation requirements.\",\n    \"effective_date\": \"2023-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65986", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65986", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Travel Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business-related travel expenses, including transportation, lodging, and meals.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65987", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the company's Employee Assistance Program (EAP), providing confidential counseling and support services to employees dealing with personal or work-related challenges. It aims to promote a healthy and supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/eap.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65987", "text": "{\n    \"policy_id\": \"RW-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees who wish to work remotely. It covers eligibility, equipment, security, and performance expectations.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65988", "text": "{\n    \"policy_id\": \"WELLBEING-ENG-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources for physical and mental health support, including gym memberships and counseling services. It aims to foster a positive work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65988", "text": "{\n    \"policy_id\": \"LEAVE-ALL-005\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details procedures for requesting and obtaining extended leaves of absence for various reasons, including medical conditions, family emergencies, or personal circumstances. It covers eligibility criteria, documentation requirements, and the impact on benefits and employment status. This is a very detailed document spanning 30+ pages.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65989", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health, physical health, and financial wellness. It focuses on preventative care and a supportive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
