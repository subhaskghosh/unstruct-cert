{"_id": "human_resources--hr_policies:_doc--n--71966", "text": "{\n    \"policy_id\": \"EMP-TERM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"Outlines the steps to be followed when terminating an employee, including documentation requirements and final pay procedures.  This policy is designed to ensure legal compliance and a respectful termination process.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71967", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy details the employee wellness benefits available, including gym reimbursements, mental health resources, and preventative care. It's designed to support employee well-being and improve overall health. This policy is relatively straightforward and intended to be easily understood by all employees.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits\"\n}"}
