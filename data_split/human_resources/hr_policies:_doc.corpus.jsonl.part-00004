{"_id": "human_resources--hr_policies:_doc--n--71998", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"Details the full health insurance coverage offered to employees, including medical, dental, and vision benefits. Covers eligibility, enrollment procedures, claims processing, and provider networks. This is a very detailed and complex plan with various tiers and options. It also covers dependent benefits and COBRA regulations. \",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
