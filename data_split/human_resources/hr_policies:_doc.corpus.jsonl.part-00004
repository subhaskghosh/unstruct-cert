{"_id": "human_resources--hr_policies:_doc--p--68976", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage, premiums, and enrollment procedures.  We aim to provide comprehensive and affordable healthcare options for our team.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68976", "text": "{\n    \"policy_id\": \"EB-2018-005\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"This plan outlines the deferred compensation arrangements available to executive-level employees, conforming to section 409A of the Internal Revenue Code. Eligibility is contingent upon meeting specific performance metrics and satisfying vesting schedules. This document contains comprehensive legal disclosures and requires consultation with a qualified financial advisor.\",\n    \"effective_date\": \"2018-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/deferred-comp-plan\"\n}"}
