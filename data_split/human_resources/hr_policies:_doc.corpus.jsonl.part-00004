{"_id": "human_resources--hr_policies:_doc--n--62805", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to request and receive reimbursement for business-related travel expenses. It outlines approved expense categories, documentation requirements, and reimbursement timelines.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62806", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including mental health resources, gym reimbursements, and flexible work arrangements.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
