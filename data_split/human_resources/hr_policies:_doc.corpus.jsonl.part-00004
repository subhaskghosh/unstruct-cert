{"_id": "human_resources--hr_policies:_doc--p--68065", "text": "{\n    \"policy_id\": \"WB-2024-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for mental and physical health. It promotes a healthy work-life balance and provides support for employees facing personal challenges.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68065", "text": "{\n    \"policy_id\": \"COMP-2023-001\",\n    \"policy_title\": \"Salary Adjustment Guidelines\",\n    \"policy_description\": \"This policy details the process for annual salary adjustments, performance-based bonuses, and equity grants. It outlines the criteria for eligibility and the approval process.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-22\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/salary-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68066", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellbeing and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing and promotes flexible work arrangements to support work-life balance. It encourages managers to consider individual needs and facilitate a supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy\"\n}"}
