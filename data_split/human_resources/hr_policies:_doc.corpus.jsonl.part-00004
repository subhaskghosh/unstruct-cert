{"_id": "human_resources--hr_policies:_doc--p--61371", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides up to 16 weeks of paid parental leave for eligible employees, exceeding the standard 12 weeks mandated by law. It aims to support employees in balancing work and family responsibilities.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/parentalleave\"\n}"}
