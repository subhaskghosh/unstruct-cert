{"_id": "human_resources--hr_policies:_doc--n--62715", "text": "{\n    \"policy_id\": \"EMP-GEN-0005\",\n    \"policy_title\": \"General Employee Conduct\",\n    \"policy_description\": \"This policy details expected standards of behavior for all employees, including guidelines on professional communication, ethical conduct, and adherence to company values. It encompasses all aspects of employment and ensures a respectful and productive work environment. It addresses conflict resolution procedures, use of company resources, and adherence to legal and regulatory requirements.  This lengthy document is essential for maintaining a positive and compliant workplace culture and ensures clarity regarding expectations for every employee within the organization.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-conduct.pdf\"\n}"}
