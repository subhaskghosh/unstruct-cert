{"_id": "human_resources--hr_policies:_doc--p--68192", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources for mental, physical, and financial wellness. It supports flexible work arrangements and promotes a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68192", "text": "{\n    \"policy_id\": \"AT-2023-002\",\n    \"policy_title\": \"Attendance and Time-Off Policy\",\n    \"policy_description\": \"This policy details the procedures for reporting attendance, requesting time off, and managing leave balances. Strict adherence to scheduled work hours is expected. Unauthorized absences will be subject to disciplinary action.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Operations\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68193", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee health and well-being, including gym membership reimbursements, mental health resources, and wellness workshops. Designed to support a healthy work-life balance and boost morale.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Marketing\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68193", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"This policy outlines the details of employee stock option grants, vesting schedules, and tax implications. It covers eligibility criteria and the process for exercising options.\",\n    \"effective_date\": \"2023-02-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Legal\",\n        \"Executive Team\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68194", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, and vision benefits available to all eligible employees. It provides clear guidelines on enrollment, coverage, and claims processes. It emphasizes preventive care and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/hr/benefits/health-wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68194", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy outlines the terms and conditions for granting stock options to executive-level employees. It includes vesting schedules, exercise prices, and other relevant details. Requires legal counsel review.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/hr/compensation/stock-options.pdf\"\n}"}
