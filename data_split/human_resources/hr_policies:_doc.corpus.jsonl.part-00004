{"_id": "human_resources--hr_policies:_doc--p--62305", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness & Flexible Work Arrangement\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering flexible work options like remote work and adjusted hours to promote work-life balance. It also details resources available for mental health and physical wellness.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-flexible-work\"\n}"}
