{"_id": "human_resources--hr_policies:_doc--p--68663", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the full range of benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It emphasizes work-life balance through flexible work arrangements and mental health resources.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package\"\n}"}
