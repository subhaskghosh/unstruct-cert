{"_id": "human_resources--hr_policies:_doc--p--71566", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Sick Leave Policy\",\n    \"policy_description\": \"This policy provides employees with 10 paid sick days per year, increasing to 15 days after 5 years of service. It also covers mental health days and family care sick leave.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick-leave-enhanced.pdf\"\n}"}
