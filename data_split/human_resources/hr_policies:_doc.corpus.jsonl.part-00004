{"_id": "human_resources--hr_policies:_doc--n--71733", "text": "{\n    \"policy_id\": \"LEAV-REQ-003\",\n    \"policy_title\": \"Extended Leave of Absence Request Process\",\n    \"policy_description\": \"This policy outlines the detailed procedures and required documentation for requesting extended leaves of absence, including medical leave, parental leave, and personal leave. It includes specific forms and approval workflows.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
