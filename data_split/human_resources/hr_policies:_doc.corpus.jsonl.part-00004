{"_id": "human_resources--hr_policies:_doc--p--61938", "text": "{\n    \"policy_id\": \"TRVL-2023-001\",\n    \"policy_title\": \"Travel Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for reimbursing employees for travel expenses incurred while on company business. It includes details on eligible expenses, approval processes, and documentation requirements. This is to promote employee wellbeing by ensuring a stress-free travel experience.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-2023\"\n}"}
