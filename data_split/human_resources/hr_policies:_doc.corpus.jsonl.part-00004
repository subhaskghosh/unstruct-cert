{"_id": "human_resources--hr_policies:_doc--p--70428", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can choose from several plans. The company contributes 75% of the premium cost.\",\n    \"effective_date\": \"2022-11-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70428", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Leave Policy\",\n    \"policy_description\": \"This policy details various leave options including sick leave, vacation leave, parental leave, bereavement leave, and unpaid leave of absence.  Eligibility requirements, accrual rates, and procedures for requesting leave are fully outlined. Specific details regarding long-term disability are also included, along with information on FMLA compliance and state-specific leave laws. The policy also covers extended leave for jury duty and military service. Employees are expected to adhere to the guidelines outlined in this document to ensure smooth and fair leave management. Failure to comply may result in disciplinary action. This policy is reviewed and updated annually to reflect changes in legislation and best practices. It also details the process for appealing a leave denial. Finally, it provides resources and contact information for employees needing further assistance with leave-related matters.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70429", "text": "{\n    \"policy_id\": \"POL-2023-007\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the guidelines for employee travel expenses, including approved methods of travel, reimbursement procedures, and spending limits. It aims to ensure cost-effectiveness while providing a comfortable and safe travel experience for employees.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-2023\"\n}"}
