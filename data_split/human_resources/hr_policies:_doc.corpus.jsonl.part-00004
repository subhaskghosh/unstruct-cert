{"_id": "human_resources--hr_policies:_doc--p--68871", "text": "{\n    \"policy_id\": \"HB-2023-005\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance, wellness programs, and related benefits available to employees. It covers medical, dental, and vision plans, as well as resources for mental health and physical well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/hb-2023-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68871", "text": "{\n    \"policy_id\": \"HB-2022-012\",\n    \"policy_title\": \"Comprehensive Benefits Package - Legacy Plan\",\n    \"policy_description\": \"This document details the full range of benefits previously offered under the legacy benefits program, including details on stock options, profit sharing, and complex retirement plans. It is designed for historical reference.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/hb-2022-012.pdf\"\n}"}
