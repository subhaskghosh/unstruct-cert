{"_id": "human_resources--hr_policies:_doc--n--65973", "text": "{\n    \"policy_id\": \"IT-2023-002\",\n    \"policy_title\": \"Data Security Protocol\",\n    \"policy_description\": \"This policy details the procedures for protecting sensitive company data, including acceptable use of devices and access controls. All employees are required to adhere to these strict guidelines to prevent data breaches.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Information Technology\",\n        \"Legal\",\n        \"Finance\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-security.pdf\"\n}"}
