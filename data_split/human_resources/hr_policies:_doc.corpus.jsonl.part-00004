{"_id": "human_resources--hr_policies:_doc--p--62851", "text": "{\n    \"policy_id\": \"BNF-2023-007\",\n    \"policy_title\": \"Flexible Benefits Program\",\n    \"policy_description\": \"This policy outlines the company's flexible benefits program, allowing employees to choose benefits that best suit their needs. It represents a modern approach to employee wellbeing, with options for health, dental, vision, and lifestyle support. The goal is to provide a competitive and employee-centric benefits package.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/flexible-benefits-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62851", "text": "{\n    \"policy_id\": \"STO-2022-012\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the employee stock option plan, including vesting schedules and exercise procedures.  It's a comprehensive plan designed to align employee interests with company performance.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options/employee-stock-option-plan.pdf\"\n}"}
