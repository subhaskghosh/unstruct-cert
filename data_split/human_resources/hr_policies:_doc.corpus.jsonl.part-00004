{"_id": "human_resources--hr_policies:_doc--p--67316", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Policy\",\n    \"policy_description\": \"This policy outlines the health insurance benefits provided to employees, including coverage details, eligibility, and enrollment procedures. It emphasizes comprehensive coverage for employees and their families.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67316", "text": "{\n    \"policy_id\": \"EMP-DISC-002\",\n    \"policy_title\": \"Employee Disciplinary Action Policy\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and outlines the disciplinary actions that may be taken. It ensures fair and consistent treatment of all employees.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action-policy\"\n}"}
