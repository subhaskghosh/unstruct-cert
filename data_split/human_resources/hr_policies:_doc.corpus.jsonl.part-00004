{"_id": "human_resources--hr_policies:_doc--p--68054", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Healthcare Benefits Enrollment\",\n    \"policy_description\": \"Details the annual enrollment process for employee healthcare benefits, including plan options and eligibility requirements. Covers critical aspects of employee wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/healthcare-benefits-enrollment.pdf\"\n}"}
