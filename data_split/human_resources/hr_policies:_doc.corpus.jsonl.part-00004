{"_id": "human_resources--hr_policies:_doc--p--62787", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health Savings Account (HSA) Contribution Policy\",\n    \"policy_description\": \"This policy outlines the company's contribution guidelines for employees enrolled in a qualifying High-Deductible Health Plan (HDHP) and participating in a Health Savings Account.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/hsa-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62787", "text": "{\n    \"policy_id\": \"TRA-0005\",\n    \"policy_title\": \"Comprehensive Leadership Development Program\",\n    \"policy_description\": \"A detailed, multi-stage program designed to cultivate leadership skills within the organization, encompassing workshops, mentoring, and project-based learning. The program is strategically aligned with the company's long-term growth objectives and seeks to create a pipeline of future leaders prepared to address complex challenges and drive innovation. It includes a thorough assessment process and ongoing performance evaluation to ensure effectiveness.\",\n    \"effective_date\": \"2023-11-10\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62788", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and adjusted hours, to support employee work-life balance.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy.pdf\"\n}"}
