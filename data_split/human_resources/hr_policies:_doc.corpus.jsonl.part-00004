{"_id": "human_resources--hr_policies:_doc--n--68986", "text": "{\n    \"policy_id\": \"EMP-TRA-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program for identifying and nurturing future leaders within the organization. This program includes multi-stage assessments, mentoring opportunities, and intensive training modules focused on strategic thinking, people management, and change leadership. Eligibility is based on performance and managerial potential. The program aims to build a strong leadership pipeline to support the company's long-term growth strategy. Detailed participation requirements and evaluation criteria are provided in the full document.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
