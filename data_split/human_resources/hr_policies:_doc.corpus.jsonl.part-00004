{"_id": "human_resources--hr_policies:_doc--p--65138", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and well-being through various programs, including gym memberships, mental health resources, and healthy eating initiatives.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65138", "text": "{\n    \"policy_id\": \"EMP-RET-002\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including eligibility, contribution limits, and investment options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65139", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits Program\",\n    \"policy_description\": \"This policy details the various wellness benefits available to employees, including gym memberships, mental health resources, and preventative care programs. It aims to support employee health and well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65139", "text": "{\n    \"policy_id\": \"LEAV-005\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures and guidelines for employees taking leave due to the death of a family member.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65140", "text": "{\n    \"policy_id\": \"WB-REM-ENG-001\",\n    \"policy_title\": \"Remote Work and Wellbeing Guidelines\",\n    \"policy_description\": \"This policy outlines guidelines for remote work arrangements, emphasizing employee wellbeing and work-life balance. It provides resources for mental health, ergonomic assessments, and communication best practices while working remotely.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2022-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-wellbeing-eng\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65140", "text": "{\n    \"policy_id\": \"WB-REM-MKT-002\",\n    \"policy_title\": \"Remote Work and Wellbeing Initiative\",\n    \"policy_description\": \"This policy promotes employee wellbeing for remote workers, with a focus on ergonomic setups and regular check-ins.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-wellbeing-mkt\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65141", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential counseling and support services to employees facing personal or work-related challenges. Services include mental health support, stress management, and resources for dealing with family issues. Focus is on holistic wellbeing and early intervention.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65141", "text": "{\n    \"policy_id\": \"FIN-BEN-012\",\n    \"policy_title\": \"Emergency Loan Program\",\n    \"policy_description\": \"This policy details the process for employees to apply for short-term, interest-free loans during financial emergencies. Eligibility criteria and repayment terms are clearly defined. This is a financial support mechanism.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/loan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65142", "text": "{\n    \"policy_id\": \"WELLB-005\",\n    \"policy_title\": \"Employee Development Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to providing employees with opportunities for professional growth through training, mentorship, and tuition reimbursement.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-development-program.pdf\"\n}"}
