{"_id": "human_resources--hr_policies:_doc--p--68577", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68577", "text": "{\n    \"policy_id\": \"DISC-001\",\n    \"policy_title\": \"Employee Disciplinary Action Policy\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and disciplinary actions. It includes guidelines for warnings, suspensions, and termination.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary-action.pdf\"\n}"}
