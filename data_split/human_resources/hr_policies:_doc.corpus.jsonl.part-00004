{"_id": "human_resources--hr_policies:_doc--p--65764", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Mental Health Support\",\n    \"policy_description\": \"This policy outlines the resources and support available to employees regarding mental health, including access to counseling, stress management programs, and employee assistance programs. It emphasizes a supportive and inclusive work environment.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"Finance\",\n        \"Research and Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/mental-health-support.pdf\"\n}"}
