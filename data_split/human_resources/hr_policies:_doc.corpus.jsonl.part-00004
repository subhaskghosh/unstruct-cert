{"_id": "human_resources--hr_policies:_doc--p--64202", "text": "{\n    \"policy_id\": \"PTO-2023-001\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off, including vacation, sick leave, and personal days.  It aims to provide employees with opportunities to rest and recharge, promoting work-life balance and overall well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy.pdf\"\n}"}
