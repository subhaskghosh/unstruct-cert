{"_id": "human_resources--hr_policies:_doc--p--70698", "text": "{\n    \"policy_id\": \"RW-2023-005\",\n    \"policy_title\": \"Remote Work and Wellbeing\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements, emphasizing work-life balance and employee wellbeing. It details expectations for communication, performance management, and technology usage while working remotely.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-wellbeing-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70698", "text": "{\n    \"policy_id\": \"LOA-2022-010\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details procedures for requesting and managing various types of leave of absence, including medical leave, personal leave, and parental leave.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70699", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, to support employees' work-life balance and promote a productive work environment.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70699", "text": "{\n    \"policy_id\": \"EMP-TRA-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the company's leadership development program, outlining eligibility criteria, program components, and performance expectations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leadership_dev.pdf\"\n}"}
