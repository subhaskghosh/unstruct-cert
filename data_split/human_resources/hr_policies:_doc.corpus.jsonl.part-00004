{"_id": "human_resources--hr_policies:_doc--p--71233", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and wellbeing through various programs, including gym memberships, mental health resources, and health screenings. It aims to foster a positive and productive work environment.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71233", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and reimbursing travel expenses incurred by employees on company business. It covers eligible expenses, documentation requirements, and approval processes. This is a detailed policy with specific expense limits.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expenses\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71234", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health and Wellness Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees, including medical, dental, vision, and mental health resources. It emphasizes preventative care and employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71234", "text": "{\n    \"policy_id\": \"REM-0005\",\n    \"policy_title\": \"Remote Work Arrangement Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees requesting and participating in remote work arrangements. It covers eligibility, equipment, security, and performance expectations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71235", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"Details the company's health insurance plan, including coverage options, premiums, and eligibility requirements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71235", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Complex Stock Option Plan\",\n    \"policy_description\": \"A highly detailed and technical document outlining the vesting schedule, exercise prices, and tax implications of the company's stock option plan. Requires specialized financial knowledge to fully comprehend.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71236", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels, premiums, and enrollment procedures.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71236", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Outlines the details of the company's 401k retirement savings plan, including contribution limits, investment options, and vesting schedules.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71237", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources for physical and mental health. Includes gym membership discounts and stress management workshops.  Supports work-life balance initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71237", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Details regarding stock options, restricted stock units, and other equity-based compensation for eligible employees.  Complex calculations involved, legal review required. Doesn't focus on wellness.\",\n    \"effective_date\": \"2023-10-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71238", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the various benefits available to employees, including health insurance, paid time off, wellness programs, and professional development opportunities. It aims to support employee wellbeing and attract top talent.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-benefits-package.pdf\"\n}"}
