{"_id": "human_resources--hr_policies:_doc--p--68011", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, paid time off, and retirement plans. It aims to attract and retain top talent by providing competitive and supportive benefits.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68011", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Basic Health Insurance Policy\",\n    \"policy_description\": \"This policy provides a minimum level of health insurance coverage as required by law. It covers essential medical expenses but does not include comprehensive benefits.\",\n    \"effective_date\": \"2024-03-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/basic-health\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68012", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various programs and resources, including mental health support, fitness initiatives, and stress management workshops. The program aims to foster a positive work-life balance and enhance employee morale.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68012", "text": "{\n    \"policy_id\": \"LC-2023-002\",\n    \"policy_title\": \"Data Privacy and Legal Compliance\",\n    \"policy_description\": \"This policy details the procedures for handling sensitive employee data in compliance with relevant data protection regulations and to mitigate potential litigation risks. It includes guidelines on data access, storage, and disposal, as well as protocols for responding to data breaches. It is crucial for avoiding legal issues related to employee information.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy.pdf\"\n}"}
