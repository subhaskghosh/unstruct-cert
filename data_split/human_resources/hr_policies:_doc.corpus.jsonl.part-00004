{"_id": "human_resources--hr_policies:_doc--p--62493", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Comprehensive Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee health and well-being, including mental health resources, gym membership discounts, and preventative care initiatives. It provides a holistic approach to supporting employee wellness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
