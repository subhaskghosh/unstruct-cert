{"_id": "human_resources--hr_policies:_doc--n--67747", "text": "{\n    \"policy_id\": \"EMP-PROC-005\",\n    \"policy_title\": \"Complex Expense Reimbursement Procedures\",\n    \"policy_description\": \"A comprehensive guide outlining the detailed expense reimbursement process, including allowable expenses, documentation requirements, and approval workflows.  This policy is quite extensive and covers numerous scenarios.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-reimbursement-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67748", "text": "{\n    \"policy_id\": \"EB-2024-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the comprehensive health and wellness benefits available to all eligible employees, including medical, dental, vision, and mental health support. It promotes a culture of wellbeing and preventative care.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-wellness-benefits.pdf\"\n}"}
