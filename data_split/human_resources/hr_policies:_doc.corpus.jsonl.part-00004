{"_id": "human_resources--hr_policies:_doc--n--67776", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A detailed plan outlining the compensation structure for executive-level employees, including base salary, bonuses, stock options, and benefits. Requires significant legal review.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/executive-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67777", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, vision, and wellness benefits available to all eligible employees. It includes information on enrollment, coverage levels, and provider networks. This policy aims to ensure employees have access to comprehensive healthcare and resources to promote their well-being. Details include eligibility requirements and procedures for filing claims.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67777", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Short-Term Disability Benefits\",\n    \"policy_description\": \"This policy outlines the provisions for short-term disability leave. It defines eligibility criteria, benefit amounts, and the process for filing a claim.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/short-term-disability.pdf\"\n}"}
