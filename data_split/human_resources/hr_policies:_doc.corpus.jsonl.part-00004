{"_id": "human_resources--hr_policies:_doc--n--67982", "text": "{\n    \"policy_id\": \"EMP-DISC-002\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"A detailed description of the disciplinary process for employees, including warnings, suspensions, and termination.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary_procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67983", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental insurance, vision insurance, life insurance, disability insurance, paid time off, and retirement savings plans. Details regarding eligibility requirements, enrollment procedures, and plan options are provided within this document.  We are committed to providing our employees with a competitive and valuable benefits package to support their well-being and financial security.  This includes details on dependent coverage, wellness programs, and resources for navigating the benefits system.  Further, information on FSA and HSA options is included.  Employees are encouraged to review this policy carefully and contact HR with any questions. Regular reviews and updates will occur to align with market trends and employee needs. This policy aims to foster a healthy and productive work environment by prioritizing employee welfare.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67983", "text": "{\n    \"policy_id\": \"TRAV-0005\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to submit travel expense reports and receive reimbursement for authorized business travel. It covers acceptable travel expenses, documentation requirements, and reimbursement timelines.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_reimbursement.pdf\"\n}"}
