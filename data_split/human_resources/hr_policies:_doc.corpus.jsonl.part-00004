{"_id": "human_resources--hr_policies:_doc--n--65745", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details various types of leave available to employees, including sick leave, vacation time, and parental leave. Comprehensive documentation covering all scenarios.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_of_absence_policy_detailed.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65746", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing. It includes resources for mental health support, physical fitness initiatives, and work-life balance programs. The goal is to promote a healthy and productive workforce.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65746", "text": "{\n    \"policy_id\": \"LEGL-2023-005\",\n    \"policy_title\": \"Legal Compliance - Data Privacy\",\n    \"policy_description\": \"This document details the comprehensive data privacy procedures that the company adheres to.  It covers all aspects of data collection, storage, processing, and disposal, in compliance with GDPR, CCPA, and other relevant regulations.  It includes detailed definitions of Personally Identifiable Information (PII), data security protocols, incident response procedures, employee training requirements, and legal considerations.  Failure to comply with this policy may result in disciplinary action, up to and including termination of employment.  This policy also outlines the processes for handling data subject access requests, including rights to access, rectification, erasure, and data portability. A detailed impact assessment is required for any new data processing activities.  The policy is subject to regular review and updates to reflect changes in legislation and industry best practices.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Legal\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/data_privacy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65747", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through a range of health and wellness initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65747", "text": "{\n    \"policy_id\": \"EMP-LEAVE-001\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures and eligibility requirements for employees requesting an extended leave of absence, covering various scenarios such as medical leave, parental leave, and personal leave.  It also contains extensive details on documentation, benefits continuation, and return-to-work procedures, spanning over 20 pages in the full policy document. A detailed section covers FMLA compliance and related legal requirements, as well as internal grievance procedures.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended_leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65748", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employees in balancing their work and personal lives.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65748", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Sales Incentive Program\",\n    \"policy_description\": \"Details the commission structure and bonus eligibility for the Sales department based on achieving sales targets.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales-incentive-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65749", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including medical, dental, and vision coverage.  Covers eligibility, enrollment procedures, and plan summaries.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65749", "text": "{\n    \"policy_id\": \"EMP-RET-001\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Outlines the details of the company's 401k plan, including contribution limits, vesting schedules, and investment options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65750", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, enrollment procedures, and claim processes.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
