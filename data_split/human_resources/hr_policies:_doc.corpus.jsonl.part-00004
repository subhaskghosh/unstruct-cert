{"_id": "human_resources--hr_policies:_doc--n--64564", "text": "{\n    \"policy_id\": \"ATT-GEN-2023002\",\n    \"policy_title\": \"Attendance and Punctuality\",\n    \"policy_description\": \"This policy details expectations regarding employee attendance and punctuality. It outlines procedures for reporting absences and tardiness.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Operations\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance/general\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64565", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete range of benefits available to employees, including health insurance, dental and vision coverage, retirement plans (401k), paid time off (PTO), sick leave, parental leave, and life insurance. It details eligibility requirements, enrollment procedures, and specific plan details for each benefit. The policy also addresses changes in benefits and provides contact information for benefits administration.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64565", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy provides details on the company's wellness initiatives, including gym membership discounts and health screenings.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-07-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64566", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Vacation and Paid Time Off\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing vacation time, sick leave, and personal days for all eligible employees.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation_pto.pdf\"\n}"}
