{"_id": "human_resources--hr_policies:_doc--p--71752", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Enhanced Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering comprehensive health, dental, and vision insurance, along with wellness program access and mental health support. It encourages proactive health management and preventative care.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-policy.pdf\"\n}"}
