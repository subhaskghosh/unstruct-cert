{"_id": "human_resources--hr_policies:_doc--p--68645", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial wellness. It promotes a healthy work-life balance through flexible work arrangements and wellness initiatives.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
