{"_id": "human_resources--hr_policies:_doc--n--62054", "text": "{\n    \"policy_id\": \"TRAIN-1234\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive leadership program designed to enhance the skills and capabilities of managers and supervisors across all departments. It includes workshops, mentoring opportunities, and assessments. The program aims to foster a culture of continuous learning and development within the organization, preparing individuals for future leadership roles and responsibilities. It details eligibility criteria, program structure, evaluation methods, and funding considerations.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadershipdev\"\n}"}
