{"_id": "human_resources--hr_policies:_doc--p--71745", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Focuses on preventative mental health support.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
