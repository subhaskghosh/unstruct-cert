{"_id": "human_resources--hr_policies:_doc--n--67201", "text": "{\n    \"policy_id\": \"IT-2023-012\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"This policy details the guidelines for the appropriate use of company-owned computers, software, and internet access.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-09-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/it-policy-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67202", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees. Coverage includes medical, dental, and vision.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67202", "text": "{\n    \"policy_id\": \"EMP-TRA-012\",\n    \"policy_title\": \"Comprehensive Leadership Development Program\",\n    \"policy_description\": \"This policy details the comprehensive leadership development program offered to high-potential employees. It encompasses a multi-stage curriculum, mentorship opportunities, and executive coaching, aiming to cultivate future leaders within the organization. The program includes detailed eligibility criteria, application processes, performance evaluation metrics, and ongoing support mechanisms. Participation is subject to approval from departmental heads and HR leadership. This policy also outlines the budgetary allocation for the program and reporting requirements for participants and sponsors. It is reviewed annually to ensure alignment with organizational goals and industry best practices.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-development-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67203", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing access to gym memberships, mental health resources, and preventative care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67203", "text": "{\n    \"policy_id\": \"EMP-RET-001\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including contribution matching, vesting schedules, and withdrawal options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67204", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical, mental, and financial health. It includes details on gym memberships, EAP access, and financial planning workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67204", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"This policy details the health insurance plans available to employees and their dependents. It covers medical, dental, and vision benefits.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67205", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels and enrollment procedures are included.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67205", "text": "{\n    \"policy_id\": \"EMP-ETH-002\",\n    \"policy_title\": \"Code of Conduct & Ethical Guidelines\",\n    \"policy_description\": \"This comprehensive document details the company's expectations regarding employee conduct, ethical behavior, and adherence to legal regulations. It covers a broad range of topics including conflict of interest, confidentiality, and data security. It's a lengthy document that requires a full review from each employee.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct\"\n}"}
