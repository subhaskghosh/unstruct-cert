{"_id": "human_resources--hr_policies:_doc--n--68393", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the procedures for enrolling in company-sponsored health insurance plans, adhering to all legal compliance standards and regulatory requirements.  Outlines eligibility, plan options, and enrollment deadlines. Requires careful attention to compliance guidelines.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-enrollment.pdf\"\n}"}
