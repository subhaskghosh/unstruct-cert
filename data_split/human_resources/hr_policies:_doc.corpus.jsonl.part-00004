{"_id": "human_resources--hr_policies:_doc--p--71194", "text": "{\n    \"policy_id\": \"EMP-BEN-0042\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's employee wellness program, including gym membership discounts, health screenings, and mental health resources. It aims to promote a healthy and productive workforce.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_program.pdf\"\n}"}
