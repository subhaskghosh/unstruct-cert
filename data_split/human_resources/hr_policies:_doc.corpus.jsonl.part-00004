{"_id": "human_resources--hr_policies:_doc--n--67626", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Compensation and Performance Review\",\n    \"policy_description\": \"A comprehensive guide detailing salary structures, performance review processes, bonus eligibility, stock options, and long-term incentive plans. This document covers all aspects of employee compensation and is designed to ensure fairness and transparency throughout the organization. It includes detailed formulas, examples, and escalation procedures for performance-related issues.  It is a very detailed document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-review-policy\"\n}"}
