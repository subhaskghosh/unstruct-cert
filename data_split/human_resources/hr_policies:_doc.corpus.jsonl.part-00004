{"_id": "human_resources--hr_policies:_doc--p--68487", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial wellness. It emphasizes a supportive work environment and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68487", "text": "{\n    \"policy_id\": \"WB-2018-001\",\n    \"policy_title\": \"Employee Assistance Program (Legacy)\",\n    \"policy_description\": \"This policy details the Employee Assistance Program. While still active, this policy is undergoing revisions and utilizes an older system. It offers limited mental health resources compared to the newer wellness program.\",\n    \"effective_date\": \"2018-01-10\",\n    \"last_updated\": \"2019-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/legacy-eap\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68488", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
