{"_id": "human_resources--hr_policies:_doc--p--67658", "text": "{\n    \"policy_id\": \"EMP-COND-001\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines the expected standards of behavior for all employees, emphasizing professionalism, respect, and ethical conduct. It includes guidelines on conflict of interest, confidentiality, and appropriate workplace interactions. It allows for reasonable personal use of social media.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-conduct-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67658", "text": "{\n    \"policy_id\": \"SOC-MEDIA-002\",\n    \"policy_title\": \"Social Media Usage Policy\",\n    \"policy_description\": \"This policy strictly governs employee use of social media, both personal and professional. It prohibits any discussion of company matters online and requires pre-approval for all social media posts related to the company.  All social media activity is monitored.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Public Relations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/social-media-002\"\n}"}
