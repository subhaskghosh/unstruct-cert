{"_id": "human_resources--hr_policies:_doc--p--64412", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee work-life balance through flexible work options such as remote work, flextime, and compressed workweeks. It aims to improve employee wellbeing and productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance.pdf\"\n}"}
