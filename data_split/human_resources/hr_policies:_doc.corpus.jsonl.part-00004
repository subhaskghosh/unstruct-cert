{"_id": "human_resources--hr_policies:_doc--p--65654", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, offering confidential counseling and support services for personal and work-related challenges.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65654", "text": "{\n    \"policy_id\": \"LS-002\",\n    \"policy_title\": \"Leave of Absence Procedures\",\n    \"policy_description\": \"Detailed procedures for requesting and managing various types of leave, including sick leave, vacation, and personal leave. Covers eligibility requirements, application processes, and documentation standards. Includes complex scenarios involving FMLA and state-specific laws.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy_detailed.pdf\"\n}"}
