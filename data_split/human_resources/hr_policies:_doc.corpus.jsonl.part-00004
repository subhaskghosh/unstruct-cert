{"_id": "human_resources--hr_policies:_doc--p--61488", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness and benefits program available to all eligible employees, including health insurance, retirement plans, and employee assistance programs. It emphasizes support for employee wellbeing and work-life integration.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-benefits.pdf\"\n}"}
