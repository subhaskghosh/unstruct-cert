{"_id": "human_resources--hr_policies:_doc--p--67208", "text": "{\n    \"policy_id\": \"BP-2023-007\",\n    \"policy_title\": \"New Hire Benefits Enrollment\",\n    \"policy_description\": \"This policy outlines the benefits enrollment process for new employees, including health insurance, retirement plans, and paid time off. It emphasizes the importance of timely enrollment and provides resources for assistance.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/benefits_new_hires.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67208", "text": "{\n    \"policy_id\": \"BP-2022-012\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"This policy details the guidelines and expectations for employees working remotely, including security protocols, communication standards, and performance metrics.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67209", "text": "{\n    \"policy_id\": \"WB-2024-08-15\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including access to mental health resources, fitness programs, and flexible work arrangements.\",\n    \"effective_date\": \"2024-08-15\",\n    \"last_updated\": \"2024-09-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67209", "text": "{\n    \"policy_id\": \"LEAVE-2023-01-10\",\n    \"policy_title\": \"Vacation and Sick Leave\",\n    \"policy_description\": \"Details regarding vacation accrual, sick leave usage, and holiday schedules.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67210", "text": "{\n    \"policy_id\": \"BP-2024-007\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"This policy outlines the commission structure for the Sales team, including tiers, targets, and payout schedules. It covers bonus eligibility and performance-based incentives.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission-2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67210", "text": "{\n    \"policy_id\": \"IT-2023-012\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"This policy details the acceptable use of company-owned computers, networks, and software. It outlines security protocols and employee responsibilities regarding data protection.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/it-acceptable-use.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67211", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Eligibility\",\n    \"policy_description\": \"This policy outlines the eligibility requirements for employees to enroll in the company's health insurance plan. Full-time employees working at least 30 hours per week are eligible after 90 days of employment. Dependents are also eligible for coverage according to the plan guidelines.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67211", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan Details\",\n    \"policy_description\": \"This document provides extensive information about the company's 401(k) plan, including investment options, contribution matching, vesting schedules, loan provisions, and withdrawal rules. It also covers compliance with ERISA and relevant tax regulations. Detailed explanations of each fund option and performance data are included. Furthermore, it outlines the process for beneficiaries and estate planning considerations. This comprehensive plan is designed to assist employees in planning for their long-term financial security during and after their employment with the company. It is imperative that all employees review this document thoroughly to understand the options available to them. Specific rules apply to employees in different departments.  Eligibility is determined by seniority and performance reviews...\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67212", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing access to gym memberships, mental health resources, and health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
