{"_id": "human_resources--hr_policies:_doc--p--65302", "text": "{\n    \"policy_id\": \"BEN-401K-2024\",\n    \"policy_title\": \"401(k) Retirement Savings Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401(k) retirement savings plan, including eligibility, contribution limits, investment options, and vesting schedule.  It is designed to promote long-term financial security for our employees.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65302", "text": "{\n    \"policy_id\": \"LEAV-SICK-2023\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the guidelines for employees to utilize sick leave benefits, including accrual rates, usage procedures, and reporting requirements. It covers short-term illness and medical appointments.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/sick_leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65303", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness and benefits programs offered to employees, including health insurance, paid time off, and flexible work arrangements designed to promote work-life balance. It details eligibility criteria, enrollment procedures, and available resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-benefits.pdf\"\n}"}
