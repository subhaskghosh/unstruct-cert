{"_id": "human_resources--hr_policies:_doc--p--65792", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines all employee benefits, including health insurance, retirement plans, paid time off, and wellness programs. It details eligibility criteria, enrollment procedures, and coverage levels.  It also describes the process for benefit modifications and terminations.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Account Management\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/eb-2023-005.pdf\"\n}"}
