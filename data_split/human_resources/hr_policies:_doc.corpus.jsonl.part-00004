{"_id": "human_resources--hr_policies:_doc--n--68162", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Employee Separation and Benefits Continuation\",\n    \"policy_description\": \"This policy details the continuation of benefits following employee termination, including COBRA eligibility and final paycheck procedures. It outlines the steps employees should take upon leaving the company.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/separation_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68163", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, to support employee work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68163", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans, including eligibility requirements and coverage options. This policy is highly detailed and lengthy.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2024-01-05\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment.pdf\"\n}"}
