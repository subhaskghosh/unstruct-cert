{"_id": "human_resources--hr_policies:_doc--p--64763", "text": "{\n    \"policy_id\": \"WB-SLS-2024-001\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the resources and programs available to employees to support their physical, mental, and emotional well-being, with a focus on achieving a healthy work-life balance. It includes details on flexible work arrangements, employee assistance programs, and wellness initiatives.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-worklife-balance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64763", "text": "{\n    \"policy_id\": \"TR-GEN-2023-005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for reasonable and necessary travel expenses incurred while conducting company business. It covers topics such as airfare, accommodation, meals, and transportation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64764", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees seeking flexible work arrangements, including remote work, flextime, and compressed workweeks, to support work-life balance and improve employee morale.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
