{"_id": "human_resources--hr_policies:_doc--p--64813", "text": "{\n    \"policy_id\": \"WB-ENG-001\",\n    \"policy_title\": \"Employee Wellbeing and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the mental and emotional wellbeing of all employees, particularly those in high-stress roles. It details resources available, including counseling services, stress management workshops, and flexible work arrangements. Focuses on a supportive work environment and proactive prevention.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-eng\"\n}"}
