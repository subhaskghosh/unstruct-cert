{"_id": "human_resources--hr_policies:_doc--n--62801", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Executive Retirement Plan\",\n    \"policy_description\": \"This comprehensive retirement plan outlines eligibility criteria, contribution limits, vesting schedules, and payout options for executive-level employees.  It incorporates advanced financial planning resources and personalized investment advice to ensure optimal long-term financial security and aligns with the company's commitment to attracting and retaining top talent. The plan includes provisions for early retirement, disability benefits, and spousal coverage, subject to specific regulations and internal guidelines.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement\"\n}"}
