{"_id": "human_resources--hr_policies:_doc--n--65091", "text": "{\n    \"policy_id\": \"PERF-001\",\n    \"policy_title\": \"Performance Management and Reviews\",\n    \"policy_description\": \"This policy details the process for performance reviews, goal setting, and employee development. It outlines the frequency of reviews, the criteria used for evaluation, and the process for addressing performance issues.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance/management.pdf\"\n}"}
