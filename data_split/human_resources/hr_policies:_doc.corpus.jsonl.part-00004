{"_id": "human_resources--hr_policies:_doc--n--67057", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"A detailed overview of the company's 401k plan, including vesting schedules, investment options, and withdrawal procedures. This document includes numerous legal disclaimers and complex financial details.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67058", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all full-time employees. It covers medical, dental, and vision care. Employees are eligible after 90 days of employment.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67058", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"This plan details the deferred compensation options available to executive-level employees. It encompasses various investment strategies, taxation implications, and vesting schedules, requiring careful consideration of individual financial goals and risk tolerance. The plan is subject to Section 409A of the Internal Revenue Code and is administered by a third-party trustee. Detailed enrollment instructions and plan documents are available through the trustee's website. Eligibility criteria include holding a leadership position for at least five years and meeting specific performance metrics. The plan is reviewed annually by the Compensation Committee and legal counsel to ensure compliance with all applicable laws and regulations. Any changes to the plan require board approval and written notification to participants. This policy is intended to attract, retain, and incentivize key executives by providing a long-term financial reward linked to the company's success.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67059", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing access to gym memberships, mental health resources, and health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67059", "text": "{\n    \"policy_id\": \"EMP-LV-001\",\n    \"policy_title\": \"Vacation and Paid Time Off\",\n    \"policy_description\": \"This policy details the accrual, scheduling, and usage of vacation time and other paid time off for all employees.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/vacation-policy.pdf\"\n}"}
