{"_id": "human_resources--hr_policies:_doc--n--68344", "text": "{\n    \"policy_id\": \"TERM-002\",\n    \"policy_title\": \"Employee Termination and Separation Procedures\",\n    \"policy_description\": \"This policy details the procedures for employee termination, including required documentation, exit interviews, and final pay calculations. It also covers severance packages and COBRA eligibility.  This policy is quite detailed and involves legal considerations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination/procedures\"\n}"}
