{"_id": "human_resources--hr_policies:_doc--p--70767", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, dental, vision, and retirement plans. It covers eligibility requirements, enrollment procedures, and plan details. The description clearly details a holistic approach to employee wellbeing.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-005\"\n}"}
