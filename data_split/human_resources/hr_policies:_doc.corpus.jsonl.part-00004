{"_id": "human_resources--hr_policies:_doc--p--62347", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness benefits, and health screenings. It aims to foster a supportive work environment and promote a healthy lifestyle.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62347", "text": "{\n    \"policy_id\": \"LE-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"A comprehensive guide detailing all types of leave available to employees, including medical leave, parental leave, bereavement leave, and unpaid leave. Includes complex eligibility criteria and required documentation. Detailed procedures are outlined for each type of leave request and approval process. Adherence to federal and state regulations regarding leave is paramount.  This policy is subject to frequent updates based on legal changes.  Detailed instructions on filing for short-term and long-term disability are included.  Contact your benefits administrator for specific questions.  Includes legal disclaimers and liability waivers. This policy is aligned with employee protection laws and aims to ensure fair treatment. It is expected that all employees will understand and comply with the procedures outlined in this document.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62348", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Health Insurance Eligibility\",\n    \"policy_description\": \"Details eligibility requirements for company-sponsored health insurance plans. Covers full-time employees and their dependents.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62348", "text": "{\n    \"policy_id\": \"EMP-TRAIN-001\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive overview of the company's Leadership Development Program, outlining eligibility criteria, program components, and selection processes. Includes details on mentorship opportunities, training workshops, and assessment methods. The program aims to foster future leaders within the organization by equipping them with the necessary skills and knowledge to excel in their roles.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62349", "text": "{\n    \"policy_id\": \"EC-2023-005\",\n    \"policy_title\": \"Employee Code of Conduct - Updated\",\n    \"policy_description\": \"This policy outlines expected standards of behavior for all employees, promoting a respectful and productive work environment. It emphasizes ethical conduct, professionalism, and compliance with all applicable laws and regulations.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/ec-2023-005.pdf\"\n}"}
