{"_id": "human_resources--hr_policies:_doc--p--71011", "text": "{\n    \"policy_id\": \"BEN-456-2023\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees' financial health through resources such as financial planning workshops, retirement savings plans, and debt consolidation assistance. It covers eligibility, program details, and available support services.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial_wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71011", "text": "{\n    \"policy_id\": \"LV-123-2022\",\n    \"policy_title\": \"Vacation and Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing vacation and sick leave. It outlines accrual rates, approval processes, and notification requirements.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71012", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources for physical and mental health. It includes details on gym membership discounts, mental health support, and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71012", "text": "{\n    \"policy_id\": \"EXEC-COMP-001\",\n    \"policy_title\": \"Executive Compensation and Bonus Plan\",\n    \"policy_description\": \"Details the compensation structure for executive-level employees, including bonus eligibility and stock option grants.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive_compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71013", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"This policy details the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care, with details on coverage levels, premiums, and enrollment procedures. The plan aims to provide comprehensive and affordable healthcare options.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71013", "text": "{\n    \"policy_id\": \"EXEC-COMP-005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy outlines the terms and conditions for granting stock options to executive-level employees. It details vesting schedules, exercise prices, and other relevant financial considerations.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71014", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Guide\",\n    \"policy_description\": \"This policy details all employee benefits including health insurance, retirement plans, paid time off, and wellness programs. It provides clear instructions on how to enroll and utilize each benefit.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_guide_2024.pdf\"\n}"}
