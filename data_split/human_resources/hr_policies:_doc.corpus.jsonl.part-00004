{"_id": "human_resources--hr_policies:_doc--n--64112", "text": "{\n    \"policy_id\": \"RW-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"Outlines the guidelines and procedures for employees working remotely.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote_work_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64113", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Eligibility\",\n    \"policy_description\": \"This policy outlines the eligibility requirements for employees to enroll in the company's health insurance plan. Full-time employees are eligible after 30 days of employment. Dependents can also be covered under the plan. Details on plan options and costs are available on the HR portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64113", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Compensation and Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive compensation and benefits package offered to executive-level employees, including stock options, performance bonuses, long-term incentive plans, enhanced health insurance coverage, and retirement planning assistance. Eligibility criteria, vesting schedules, and performance metrics are clearly defined within this document, alongside specific stipulations regarding confidentiality and non-compete agreements. This is a complex document that should be carefully reviewed by all executives.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64114", "text": "{\n    \"policy_id\": \"BP-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Employees can find detailed plan information on the benefits portal.  Enrollment is typically during the annual open enrollment period.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64114", "text": "{\n    \"policy_id\": \"BP-0035\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the Executive Stock Option Plan, including eligibility requirements, vesting schedules, exercise procedures, and tax implications.  It's a comprehensive plan designed to incentivize long-term performance and align executive interests with shareholder value.  The plan covers a wide array of scenarios, including changes in control, termination of employment, and disability. Detailed legal counsel was involved in its creation. This policy is subject to change based on market conditions and company performance.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
