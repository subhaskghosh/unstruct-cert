{"_id": "human_resources--hr_policies:_doc--n--65344", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A comprehensive document outlining the compensation structure for executive-level employees, including stock options, bonuses, and benefits. This is a complex document designed for a select group of employees.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65345", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and work-life balance. It encourages employees to prioritize their health and provides support for achieving a healthy lifestyle.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Design\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65345", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and personal leave. It ensures compliance with applicable labor laws and provides guidelines for managing employee absences.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
