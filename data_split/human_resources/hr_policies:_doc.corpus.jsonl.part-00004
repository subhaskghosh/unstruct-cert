{"_id": "human_resources--hr_policies:_doc--p--70330", "text": "{\n    \"policy_id\": \"RW-2023-005\",\n    \"policy_title\": \"Remote Work and Employee Wellness\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements, emphasizing the importance of maintaining employee well-being, work-life balance, and mental health while working remotely. It details procedures for setting up a home office and accessing support resources. It also discusses expectations regarding communication and performance.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-wellness-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70330", "text": "{\n    \"policy_id\": \"TRV-2022-012\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while on company business. It outlines allowable expenses, documentation requirements, and approval processes. It is applicable to all departments that involve client visits or conferences.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-reimbursement-2022.pdf\"\n}"}
