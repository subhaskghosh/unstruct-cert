{"_id": "human_resources--hr_policies:_doc--p--67172", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Employees can choose from several plans. Details regarding premiums, deductibles, and co-pays are outlined in the full policy document. This policy emphasizes preventative care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67172", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"The Leadership Development Program is designed to identify and cultivate future leaders within the organization. This program provides comprehensive training, mentoring, and development opportunities. It covers a wide range of topics, including strategic thinking, communication skills, team building, conflict resolution, and performance management. Participants will engage in workshops, simulations, and real-world projects. The program aims to equip participants with the necessary skills and knowledge to effectively lead and manage teams. The program is open to all employees with at least three years of experience.  It is a rigorous and demanding program that requires a significant time commitment. Eligibility criteria include a performance review rating of 'meets expectations' or higher, a demonstrated commitment to personal and professional growth, and a recommendation from a manager. The program involves multiple phases, each with specific objectives and deliverables. Regular assessments will be conducted to track participant progress and identify areas for improvement. Successful completion of the program will be recognized with a certificate of completion and potential opportunities for advancement within the organization. There is also a follow-up mentorship component to ensure sustained growth. The cost of the program is substantial, but the company believes the investment is worthwhile given the potential benefits.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-development.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67173", "text": "{\n    \"policy_id\": \"BP-2023-11-05\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"This policy details the commission structure for all Sales team members, including bonus eligibility and payout schedules.\",\n    \"effective_date\": \"2023-11-05\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission-2023-11-05.pdf\"\n}"}
