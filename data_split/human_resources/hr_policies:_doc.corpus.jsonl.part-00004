{"_id": "human_resources--hr_policies:_doc--p--62888", "text": "{\n    \"policy_id\": \"EB-2023-007\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees' financial health through workshops, resources, and access to financial advisors.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial-wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62888", "text": "{\n    \"policy_id\": \"LEAV-2022-001\",\n    \"policy_title\": \"Employee Leave of Absence\",\n    \"policy_description\": \"Details the procedures for requesting and managing various types of employee leave.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62889", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, offering subsidized gym memberships and mental health resources. It aims to promote a healthy work-life balance and reduce stress. Participation is encouraged for all employees.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62889", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy details the complete benefits package offered to employees, including health insurance, dental coverage, vision plans, 401k matching, paid time off, parental leave, and long-term disability. It covers eligibility requirements, enrollment procedures, and plan details for each benefit. The policy is subject to change based on annual reviews and legal requirements. Detailed information on each benefit can be found in the respective plan documents. This policy also includes guidelines on utilizing benefits and resolving any related issues. Employees are encouraged to carefully review the complete benefits guide and consult with HR for personalized assistance. A comprehensive FAQ is available on the company intranet. Please see the attached supplemental documentation for specific plan limitations and exclusions.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62890", "text": "{\n    \"policy_id\": \"EC-2024-001\",\n    \"policy_title\": \"Code of Conduct\",\n    \"policy_description\": \"This policy outlines acceptable behavior for all employees, covering topics such as professionalism, ethical conduct, and conflict resolution.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/conduct_policy\"\n}"}
