{"_id": "human_resources--hr_policies:_doc--p--65358", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy provides confidential counseling and support services to employees facing personal or work-related challenges. It aims to promote employee well-being and resilience. Access to services is readily available and designed to be user-friendly.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Legal\",\n        \"Engineering\",\n        \"Data Science\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65358", "text": "{\n    \"policy_id\": \"LC-005\",\n    \"policy_title\": \"Data Breach Incident Response\",\n    \"policy_description\": \"This policy details the legal and procedural requirements following a confirmed or suspected data breach. It outlines reporting obligations, containment procedures, and forensic investigation protocols. Strict adherence to these guidelines is mandatory to ensure compliance with relevant regulations.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT Security\",\n        \"Compliance\",\n        \"Data Science\"\n    ],\n    \"policy_document_url\": \"https://example.com/data_breach_policy.pdf\"\n}"}
