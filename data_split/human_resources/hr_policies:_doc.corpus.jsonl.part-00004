{"_id": "human_resources--hr_policies:_doc--p--61740", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the various wellness programs and benefits available to employees, including health insurance, paid time off, and employee assistance programs. It emphasizes work-life integration.\",\n    \"effective_date\": \"2022-11-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-program\"\n}"}
