{"_id": "human_resources--hr_policies:_doc--p--64629", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including resources for mental health, physical fitness, and financial wellness. It aims to create a supportive and positive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64629", "text": "{\n    \"policy_id\": \"LO-2023-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details the procedures and eligibility requirements for employees requesting a leave of absence, including medical leave, parental leave, and personal leave.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64630", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing, including access to mental health resources, stress management programs, and flexible work arrangements. It emphasizes a positive and inclusive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64630", "text": "{\n    \"policy_id\": \"TR-2023-012\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related travel and expenses. It covers allowable expenses, documentation requirements, and approval processes.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
