{"_id": "human_resources--hr_policies:_doc--n--64852", "text": "{\n    \"policy_id\": \"VAC-001\",\n    \"policy_title\": \"Vacation Time Policy\",\n    \"policy_description\": \"Outlines the guidelines for requesting and taking vacation time, including accrual rates and approval processes.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation_time.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64853", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees are responsible for understanding their plan options and associated costs. Details regarding enrollment and claim procedures are available on the company intranet.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64853", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This document details the company's Executive Stock Option Plan, outlining eligibility requirements, vesting schedules, exercise procedures, and tax implications. The plan is designed to incentivize key executives and align their interests with those of the shareholders. It covers various scenarios including change of control, termination of employment, and retirement. A comprehensive legal review is recommended before exercising any options. This plan is subject to amendment and modification at the discretion of the Compensation Committee of the Board of Directors. This is a very complex legal document, and all executives are expected to consult with their financial advisors.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64854", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to promote work-life balance for employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64854", "text": "{\n    \"policy_id\": \"EMP-COMP-002\",\n    \"policy_title\": \"Employee Compensation Policy\",\n    \"policy_description\": \"This policy details the compensation structure, including salary ranges, bonus eligibility, and performance-based increases for all employees.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-compensation.pdf\"\n}"}
