{"_id": "human_resources--hr_policies:_doc--p--70368", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the complete range of employee benefits offered, including health insurance, retirement plans, paid time off, and wellness programs. It aims to attract and retain top talent by providing a competitive and supportive benefits environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_v1.pdf\"\n}"}
