{"_id": "human_resources--hr_policies:_doc--n--64991", "text": "{\n    \"policy_id\": \"CMP-PLN-005\",\n    \"policy_title\": \"Compensation and Performance Review\",\n    \"policy_description\": \"A comprehensive document detailing the company's compensation philosophy, performance review process, bonus structures, and equity programs. This includes intricate details on merit increases, stock option grants, and long-term incentive plans, and covers various performance metrics and goal-setting methodologies.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64992", "text": "{\n    \"policy_id\": \"WB-SALES-2024-001\",\n    \"policy_title\": \"Employee Wellness Program - Sales\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the physical and mental well-being of employees in the Sales department. It includes resources for stress management, flexible work arrangements, and access to wellness programs.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-sales-2024-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64992", "text": "{\n    \"policy_id\": \"LEAVE-SALES-2023-002\",\n    \"policy_title\": \"Sales Department Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving various types of leave, including vacation, sick leave, and personal leave, for employees within the Sales department.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-sales-2023-002.pdf\"\n}"}
