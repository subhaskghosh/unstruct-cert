{"_id": "human_resources--hr_policies:_doc--p--62513", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"Provides extended paid parental leave to all eligible employees to support family bonding and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/parental-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62513", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Traditional Sick Leave Policy\",\n    \"policy_description\": \"Outlines the process for requesting and utilizing sick leave benefits.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62514", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides expanded parental leave benefits to support employees welcoming new children. It focuses on flexible arrangements and financial support to ensure a smooth transition for both parents and the company. We aim to be a family-friendly employer.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/parental-leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62514", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Standard Health Insurance Policy\",\n    \"policy_description\": \"This document outlines the standard health insurance benefits offered to all eligible employees. All terms and conditions are subject to legal compliance.  Employees are required to enroll during the open enrollment period.  Failure to comply will result in loss of benefits. See Schedule A for covered services and limitations.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62515", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, including gym memberships, mental health resources, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62515", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Data Privacy Compliance\",\n    \"policy_description\": \"Details the company's compliance with GDPR and other data privacy regulations. All employees must adhere to this policy.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Legal\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy.pdf\"\n}"}
