{"_id": "human_resources--hr_policies:_doc--p--67853", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Employees must enroll during the annual open enrollment period. Details on plan options and costs can be found in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67853", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to employees, including 401(k) contributions, pension plans, and investment options. It covers eligibility requirements, vesting schedules, and procedures for accessing retirement funds. It also details the regulations around early withdrawal, required minimum distributions, and beneficiary designations. Detailed information about specific investment fund performance is available in the accompanying documents. This policy is subject to change based on market conditions and legal requirements. Employees are encouraged to consult with a financial advisor to make informed decisions about their retirement savings. The plan also includes provisions for hardship withdrawals and loan options. This document outlines the responsibilities of both the employer and the employee in maintaining the plan's compliance with all applicable laws. The policy is reviewed annually and updated as needed to reflect changes in regulations or investment strategies.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67854", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67854", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Details the stock option plan for executive-level employees, including vesting schedules and exercise conditions. This is a highly complex financial arrangement.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
