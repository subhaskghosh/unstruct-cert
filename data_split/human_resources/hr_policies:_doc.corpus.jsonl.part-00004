{"_id": "human_resources--hr_policies:_doc--n--62807", "text": "{\n    \"policy_id\": \"PERF-REV-001\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"Outlines the process for conducting performance reviews and providing feedback to employees.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance/review_process.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62808", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing access to resources such as gym memberships, mental health support, and health screenings. The program is designed to promote a healthy lifestyle and improve employee morale.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62808", "text": "{\n    \"policy_id\": \"EMP-LEAVE-005\",\n    \"policy_title\": \"Extended Sick Leave\",\n    \"policy_description\": \"This policy details the process for requesting and approving extended sick leave, exceeding the standard allotted sick days. It covers eligibility criteria, required documentation, and the duration of leave available. This is a complex policy detailing various scenarios and legal compliance requirements related to extended leave and return to work processes. It is designed to ensure fair and consistent application of leave benefits in line with federal, state and local regulations.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Operations\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended_sick_leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62809", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for physical, mental, and financial wellness.  It includes details on gym reimbursement, mental health counseling, and financial planning workshops. This is designed to promote a healthy and productive workforce.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62809", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details on enrolling in health insurance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-enrollment.pdf\"\n}"}
