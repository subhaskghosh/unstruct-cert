{"_id": "human_resources--hr_policies:_doc--p--61484", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through various programs and resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61484", "text": "{\n    \"policy_id\": \"LEAVE-2022-005\",\n    \"policy_title\": \"Vacation Leave Policy\",\n    \"policy_description\": \"Details regarding the accrual and usage of vacation leave.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61485", "text": "{\n    \"policy_id\": \"TP-2023-005\",\n    \"policy_title\": \"Employee Travel Expense Policy\",\n    \"policy_description\": \"This policy outlines guidelines for reimbursable travel expenses for employees. It covers transportation, lodging, and meal allowances while on company business.  All travel must be pre-approved by a manager. Receipts are required for all expenses over $25.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61485", "text": "{\n    \"policy_id\": \"LP-2022-012\",\n    \"policy_title\": \"Employee Leave Policy\",\n    \"policy_description\": \"This comprehensive policy details all types of leave available to employees, including vacation, sick leave, personal leave, and bereavement leave. It covers eligibility requirements, accrual rates, request procedures, and any applicable state or federal laws. It further outlines how leave interacts with other benefits such as health insurance and retirement plans. Managers are responsible for ensuring consistent application of this policy across their teams.  The policy also includes guidelines for extended leave of absence and return-to-work procedures. Detailed information regarding specific leave types and scenarios can be found in the attached appendices.  It's crucial to understand this policy to ensure compliance with company standards and legal requirements. Updates may occur frequently to align with changing regulations. Employees should refer to the HR portal for the latest version and clarifications.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61486", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to employees, including medical, dental, and vision coverage. It details eligibility, enrollment procedures, and cost-sharing arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61486", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"This detailed policy governs the grant, vesting, and exercise of stock options, restricted stock units (RSUs), and other forms of equity compensation to eligible employees, incorporating complex tax implications and legal considerations. It applies to executive level employees and high performers.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan\"\n}"}
