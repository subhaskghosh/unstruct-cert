{"_id": "human_resources--hr_policies:_doc--n--65234", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"A comprehensive guide detailing all types of extended leaves, including medical, family, and personal leave, outlining eligibility requirements, application processes, and associated benefits and liabilities. It also covers the interplay with federal and state regulations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65235", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits provided to eligible employees. It covers medical, dental, and vision care. The policy is designed to be straightforward and easy to understand.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65235", "text": "{\n    \"policy_id\": \"LEG-005\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"This detailed policy describes the company's equity compensation plan, including stock options, restricted stock units, and employee stock purchase plans. It outlines eligibility requirements, vesting schedules, and tax implications.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/equity-compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65236", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Remote Work Benefit Eligibility\",\n    \"policy_description\": \"This policy outlines the benefits eligibility for employees working remotely, including health insurance, stipends, and other allowances. It's designed to be concise and easy to understand.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65236", "text": "{\n    \"policy_id\": \"EMP-GEN-012\",\n    \"policy_title\": \"Comprehensive Employee Handbook\",\n    \"policy_description\": \"A detailed compilation of all company policies, covering a wide range of topics including conduct, attendance, and benefits. It includes extensive legal disclaimers and detailed procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-handbook.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65237", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, to support employee work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65237", "text": "{\n    \"policy_id\": \"EXEC-COMP-002\",\n    \"policy_title\": \"Executive Compensation and Benefits\",\n    \"policy_description\": \"Details the compensation and benefits package for executive-level employees, including stock options, performance bonuses, and enhanced health benefits.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65238", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Remote Work and Flexible Scheduling Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements and flexible scheduling options available to employees, aimed at promoting work-life balance and employee wellbeing. It covers eligibility criteria, required equipment, security protocols, and performance expectations.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65238", "text": "{\n    \"policy_id\": \"IT-SEC-2023-010\",\n    \"policy_title\": \"IT Security Protocol for Remote Access\",\n    \"policy_description\": \"This policy details the security measures required when accessing company resources remotely, including VPN usage, password management, and data encryption. It ensures the confidentiality and integrity of company data during remote work scenarios.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Security\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/it-security-remote-access\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65239", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness programs, and stress management workshops. It aims to foster a supportive and healthy work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65239", "text": "{\n    \"policy_id\": \"RW-2023-002\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"This policy details the guidelines for employees working remotely, including eligibility, equipment, security, and performance expectations.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65240", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits - Tier 1\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels and contribution amounts. This policy focuses on standard plans and procedures for enrollment and claims.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65240", "text": "{\n    \"policy_id\": \"CMP-ETH-001\",\n    \"policy_title\": \"Code of Conduct & Ethical Guidelines\",\n    \"policy_description\": \"Comprehensive guide outlining ethical behavior expectations for all employees. Includes detailed sections on conflicts of interest, data privacy, and anti-discrimination policies. This document is extensive and covers a broad range of ethical considerations.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/cmp-eth-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65241", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being, promoting work-life balance, and preventing burnout. It includes resources for mental health, flexible work arrangements, and time off options.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Design\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65241", "text": "{\n    \"policy_id\": \"PT-2024-010\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"This policy details the procedures for conducting regular performance reviews and providing feedback to employees.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65242", "text": "{\n    \"policy_id\": \"WB-PM-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various resources and programs, including mental health support, fitness incentives, and work-life balance initiatives. It aims to foster a positive and productive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65242", "text": "{\n    \"policy_id\": \"LG-COMP-2023-012\",\n    \"policy_title\": \"Non-Compete Agreement\",\n    \"policy_description\": \"This document details the legal obligations and restrictions placed upon employees regarding post-employment competition, intellectual property rights, and confidentiality. It is a legally binding agreement and subject to applicable state and federal laws. Consult legal counsel for interpretation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/non-compete\"\n}"}
