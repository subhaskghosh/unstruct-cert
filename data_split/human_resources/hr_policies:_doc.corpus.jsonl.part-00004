{"_id": "human_resources--hr_policies:_doc--p--70325", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee health and well-being, including gym membership discounts, mental health resources, and preventative care support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70325", "text": "{\n    \"policy_id\": \"VAC-001\",\n    \"policy_title\": \"Vacation and Paid Time Off\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and taking vacation time, as well as guidelines for paid time off.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/vacation-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70326", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It provides details on coverage, enrollment, and claims procedures.  We aim to provide comprehensive and affordable healthcare options for our team.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70326", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"401k Plan Compliance and Regulations\",\n    \"policy_description\": \"This policy details the complex regulatory framework governing the company's 401k plan, including ERISA compliance, non-discrimination testing, and annual reporting requirements as stipulated by the Department of Labor.  Furthermore, it addresses various IRS code sections pertaining to qualified retirement plans.  This document is for internal compliance purposes only and may require legal counsel for interpretation.\",\n    \"effective_date\": \"2023-04-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-compliance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70327", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"Details regarding health insurance, wellness programs, and employee assistance programs designed to support employee wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness-policy\"\n}"}
