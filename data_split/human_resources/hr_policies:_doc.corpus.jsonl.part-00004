{"_id": "human_resources--hr_policies:_doc--n--64771", "text": "{\n    \"policy_id\": \"EMP-LEAVE-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and utilizing sick leave benefits.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick-leave-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64772", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees in achieving a healthy work-life balance through flexible work options, including remote work, flextime, and compressed workweeks. It aims to reduce stress and improve overall well-being.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64772", "text": "{\n    \"policy_id\": \"COMP-2023-005\",\n    \"policy_title\": \"Compensation and Benefits Review\",\n    \"policy_description\": \"This policy details the process for annual compensation and benefits reviews. It covers salary adjustments, bonus eligibility, and benefits enrollment procedures.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64773", "text": "{\n    \"policy_id\": \"PD-2023-007\",\n    \"policy_title\": \"Performance Improvement Plan (PIP) Policy\",\n    \"policy_description\": \"This policy outlines the process for implementing Performance Improvement Plans for employees not meeting performance expectations. It includes guidelines for setting goals, providing feedback, and monitoring progress.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pip-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64773", "text": "{\n    \"policy_id\": \"PD-2022-001\",\n    \"policy_title\": \"Employee Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for approved business expenses.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-policy\"\n}"}
