{"_id": "human_resources--hr_policies:_doc--n--68325", "text": "{\n    \"policy_id\": \"COMP-012\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A comprehensive plan detailing compensation packages for executive-level employees, including stock options, bonuses, and performance-based incentives. This is a highly detailed document covering complex financial instruments.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-compensation.pdf\"\n}"}
