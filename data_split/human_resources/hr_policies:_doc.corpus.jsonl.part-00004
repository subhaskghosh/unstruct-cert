{"_id": "human_resources--hr_policies:_doc--n--68201", "text": "{\n    \"policy_id\": \"BNF-003\",\n    \"policy_title\": \"Equity and Stock Option Plan\",\n    \"policy_description\": \"Outlines the company's stock option plan, eligibility criteria, vesting schedules, and tax implications for eligible employees. Includes information on grant agreements and exercise procedures.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68202", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive employee benefits program, including health insurance, paid time off, and wellness initiatives designed to support work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68202", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Legacy Health Benefits Plan\",\n    \"policy_description\": \"Details of the older health benefits plan, now superseded by the Employee Wellness and Benefits Program. This plan offers limited coverage.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/archive/legacy-health-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68203", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.  Benefits are designed to support employee well-being and provide access to quality healthcare.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68203", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Details regarding the company's equity compensation plan, including stock options, restricted stock units (RSUs), and vesting schedules. This plan leverages complex actuarial calculations and financial modeling to determine grant values and payout structures.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68204", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"Details the company's health insurance benefits, including coverage options, premiums, and claims procedures. This policy is designed to be easy to understand and provides comprehensive health coverage for employees and their families.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68204", "text": "{\n    \"policy_id\": \"LE-2022-105\",\n    \"policy_title\": \"Equity Compensation Plan for Senior Executives\",\n    \"policy_description\": \"Outlines the terms and conditions for equity-based compensation for senior executive team members, including stock options, restricted stock units, and performance-based equity awards. Contains significant legal disclaimers.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan\"\n}"}
