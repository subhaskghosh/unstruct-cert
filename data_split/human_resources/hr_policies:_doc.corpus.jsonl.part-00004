{"_id": "human_resources--hr_policies:_doc--p--65721", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources for mental health, physical health, and financial wellness. It focuses on preventative measures and early intervention.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
