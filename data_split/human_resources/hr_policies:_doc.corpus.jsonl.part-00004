{"_id": "human_resources--hr_policies:_doc--p--71741", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, and vision benefits available to all eligible employees, including details on coverage levels, enrollment procedures, and wellness programs. It also covers mental health resources and employee assistance programs. This policy aims to provide employees with access to quality healthcare and promote a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-benefits-health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71741", "text": "{\n    \"policy_id\": \"TEMP-PAY-002\",\n    \"policy_title\": \"Temporary Worker Compensation and Benefits\",\n    \"policy_description\": \"This policy details the compensation and limited benefits package offered to temporary and contract workers. It includes information on hourly rates, overtime pay, and access to basic health insurance options.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-04-22\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/temporary-worker-compensation.pdf\"\n}"}
