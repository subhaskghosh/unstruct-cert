{"_id": "human_resources--hr_policies:_doc--p--62262", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness. It provides details on available resources, including gym membership discounts, mental health support, and annual health screenings. The program aims to promote a healthy work-life balance and improve overall employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62262", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the comprehensive health insurance plan offered to all eligible employees. It outlines coverage levels, deductibles, co-pays, and out-of-pocket maximums. Specific provisions include coverage for medical, dental, and vision care, as well as prescription drug benefits. Detailed information regarding provider networks and claim submission procedures is also included. This plan complies with all relevant federal and state regulations, including the Affordable Care Act (ACA). Employees are encouraged to review the Summary Plan Description (SPD) for a complete understanding of their benefits.  This policy applies to all full-time and part-time employees who have completed 30 days of employment. Pre-existing conditions are covered according to ACA guidelines. Contact HR for assistance with enrollment and benefit questions.  Further details on dependent coverage, special enrollment periods, and appeal processes are available on the company intranet.  The plan is administered by XYZ Insurance Company.  This policy incorporates several amendments to address evolving healthcare laws and employee needs.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62263", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including gym reimbursements, mental health resources, and healthy lifestyle incentives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
