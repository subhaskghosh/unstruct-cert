{"_id": "human_resources--hr_policies:_doc--p--62644", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details on coverage levels and enrollment procedures are available in the policy document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62644", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Employee Wellness Program\",\n    \"policy_description\": \"This comprehensive policy details a wide range of employee wellness initiatives, including health insurance options, retirement plans, mental health support, financial wellness workshops, and ergonomic assessments. It also describes the process for requesting accommodations related to wellness needs. The program aims to promote a healthy and productive work environment and encourages employee participation in various wellness activities. Detailed guidelines for each component of the wellness program are outlined below. The company also offers employee assistance program (EAP) services, and this policy covers those details as well. The EAP details are provided by a third party.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
