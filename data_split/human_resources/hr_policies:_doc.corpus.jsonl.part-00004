{"_id": "human_resources--hr_policies:_doc--p--70036", "text": "{\n    \"policy_id\": \"RW-2023-005\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for eligible employees, ensuring productivity and maintaining team collaboration. It covers requirements for home office setup, security protocols, and communication expectations. This supports a flexible work environment to improve employee satisfaction and work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy-v2.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70036", "text": "{\n    \"policy_id\": \"TRVL-2023-010\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to claim reimbursement for business travel expenses, including transportation, lodging, and meals.  All expenses must be pre-approved by a manager and submitted with original receipts. This policy aims to maintain fiscal responsibility and compliance.\",\n    \"effective_date\": \"2023-02-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy.pdf\"\n}"}
