{"_id": "human_resources--hr_policies:_doc--n--65686", "text": "{\n    \"policy_id\": \"CMP-2024-002\",\n    \"policy_title\": \"Comprehensive Compensation and Equity Plan\",\n    \"policy_description\": \"A detailed and extensive document outlining the organization's total compensation strategy, including salary bands, bonus structures, equity grants, and long-term incentive plans. Covers all levels of employment and requires detailed understanding of financial modeling.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/equity_plan.pdf\"\n}"}
