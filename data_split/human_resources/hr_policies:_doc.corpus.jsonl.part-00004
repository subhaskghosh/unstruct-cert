{"_id": "human_resources--hr_policies:_doc--n--65883", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Detailed procedures and eligibility criteria for employees requesting extended leave for medical, personal, or family reasons. Includes comprehensive documentation requirements and approval processes.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65884", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy outlines the guidelines and support available to employees experiencing the loss of a family member. It provides paid time off and resources for emotional well-being.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement_leave_policy.pdf\"\n}"}
