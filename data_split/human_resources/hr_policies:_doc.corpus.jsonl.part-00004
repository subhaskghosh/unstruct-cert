{"_id": "human_resources--hr_policies:_doc--p--64832", "text": "{\n    \"policy_id\": \"PTO-2023-FT\",\n    \"policy_title\": \"Full-Time Employee Paid Time Off\",\n    \"policy_description\": \"This policy outlines the guidelines for paid time off (PTO) for all full-time employees. It covers vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-fulltime-2023\"\n}"}
