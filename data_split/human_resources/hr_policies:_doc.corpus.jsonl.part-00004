{"_id": "human_resources--hr_policies:_doc--p--71986", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the various wellness programs and benefits available to employees, including health insurance, paid time off, and flexible work arrangements. It promotes a healthy work-life balance and employee well-being.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71986", "text": "{\n    \"policy_id\": \"REL-001\",\n    \"policy_title\": \"Relocation Assistance Policy\",\n    \"policy_description\": \"Details the process and financial assistance available to employees who are relocating for company business. Covers travel expenses, temporary housing, and other related costs.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/relocation/assistance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71987", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to promote work-life balance and employee well-being.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71987", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"Details the process for employees to enroll in and manage their health insurance benefits.\",\n    \"effective_date\": \"2021-01-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71988", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health and wellness benefits available to all eligible employees, including medical, dental, vision, and mental health support. It focuses on employee well-being and preventative care, aiming to create a supportive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71988", "text": "{\n    \"policy_id\": \"REM-WORK-005\",\n    \"policy_title\": \"Remote Work Arrangement Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees requesting and participating in remote work arrangements. It covers eligibility, equipment, security, and performance expectations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/rem-work-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71989", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing. It details access to gym memberships, mental health resources, and annual health screenings. The program aims to promote a healthy work-life balance and improve overall employee health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71989", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy details the provisions for long-term disability insurance, including eligibility criteria, benefit amounts, and the claims process. This is a comprehensive document covering all aspects of the insurance plan, including legal disclaimers and detailed policy schedules. The full documentation can be found at the provided URL.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71990", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including mental health resources, physical health initiatives, and financial wellness programs. It aims to create a supportive and healthy work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-2024\"\n}"}
