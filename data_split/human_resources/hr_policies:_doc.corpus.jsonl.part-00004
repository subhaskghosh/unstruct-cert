{"_id": "human_resources--hr_policies:_doc--n--65979", "text": "{\n    \"policy_id\": \"RW-ENG-002\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy details the guidelines and expectations for employees working remotely, including eligibility criteria, security protocols, and communication procedures.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
