{"_id": "human_resources--hr_policies:_doc--p--71371", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program available to all employees, providing confidential support services for personal and work-related challenges.  It includes access to counseling, legal advice, and financial resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71371", "text": "{\n    \"policy_id\": \"CO-2022-005\",\n    \"policy_title\": \"Code of Conduct\",\n    \"policy_description\": \"Detailed guidelines on ethical behavior, conflicts of interest, and professional conduct for all employees. This document covers a broad range of situations and is essential for maintaining a respectful and compliant workplace. It's a comprehensive, in-depth resource for all company activities and expectations.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-10-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/code_of_conduct.pdf\"\n}"}
