{"_id": "human_resources--hr_policies:_doc--n--62854", "text": "{\n    \"policy_id\": \"EMP-DISC-002\",\n    \"policy_title\": \"Employee Disciplinary Action\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and performance issues. It outlines the steps involved in issuing warnings, implementing performance improvement plans, and, if necessary, terminating employment.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62855", "text": "{\n    \"policy_id\": \"EC-2023-SM\",\n    \"policy_title\": \"Employee Code of Conduct - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines expected standards of professional behavior for all employees within the Sales and Marketing departments, covering areas such as ethical sales practices, responsible marketing communications, and respectful workplace interactions.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/ec_sm_2023.pdf\"\n}"}
