{"_id": "human_resources--hr_policies:_doc--n--65847", "text": "{\n    \"policy_id\": \"RET-PLAN-005\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including eligibility, contribution limits, and investment options. This plan is designed to help employees save for their retirement.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65848", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees experiencing personal or work-related difficulties. Focuses on mental health and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65848", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details the procedures for requesting and taking various types of leave, including medical leave, parental leave, and personal leave. Covers eligibility requirements and benefits continuation. This is a very extensive document with a complex set of rules.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65849", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, aiming to improve work-life balance and employee well-being. It provides clear instructions and examples to ensure easy understanding.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-arrangements.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65849", "text": "{\n    \"policy_id\": \"CO-005\",\n    \"policy_title\": \"Company Code of Conduct\",\n    \"policy_description\": \"This document details the ethical standards and expected behaviors for all employees, ensuring a professional and compliant work environment.  It is a formal document with legal terminology.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65850", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Focuses on proactive well-being and preventative care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65850", "text": "{\n    \"policy_id\": \"LE-005\",\n    \"policy_title\": \"Leave of Absence - Extended Medical\",\n    \"policy_description\": \"Outlines the procedures and requirements for employees needing extended medical leave. Details eligibility criteria and documentation requirements.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-medical-leave\"\n}"}
