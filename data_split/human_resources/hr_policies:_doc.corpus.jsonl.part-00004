{"_id": "human_resources--hr_policies:_doc--p--70998", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to employees, including health insurance, retirement plans, and wellness programs. It aims to support employees' overall well-being and provide financial security.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
