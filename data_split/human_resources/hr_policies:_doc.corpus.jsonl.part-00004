{"_id": "human_resources--hr_policies:_doc--p--64788", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits provided to eligible employees. Coverage includes medical, dental, and vision.  Employees must enroll within 30 days of hire.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64788", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This highly complex plan details the granting of stock options to executive-level employees. It includes vesting schedules, exercise prices, and tax implications. Detailed legal counsel is recommended before making any decisions related to this plan. This policy is over 50 pages in length.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64789", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64789", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Advanced Leadership Training Program\",\n    \"policy_description\": \"This comprehensive policy details the requirements, eligibility criteria, and reimbursement procedures for employees participating in the Advanced Leadership Training Program. It includes detailed information on pre-approval processes, training providers, and post-training evaluations.  This program is designed to equip high-potential employees with the skills needed to assume leadership roles within the organization.  The policy covers various aspects such as training duration, location, accommodation, and travel expenses, with specific guidelines for each.  A full list of approved training courses is available in Appendix A.  Compliance with this policy is mandatory for all participants, and any deviations must be reported to the HR department.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/training/leadership\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64790", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and well-being through various programs including gym memberships, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64790", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Employee Computer Usage\",\n    \"policy_description\": \"This policy details the acceptable use of company computers, software, and internet access.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/computer-usage\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64791", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health, including gym memberships, mindfulness workshops, and stress management training.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64791", "text": "{\n    \"policy_id\": \"LC-2023-002\",\n    \"policy_title\": \"Leave of Absence - Medical\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking medical leave, including required documentation and benefits continuation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/medical-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64792", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including flexible work arrangements, mental health resources, and wellness programs. It aims to foster a supportive work environment that promotes a healthy work-life balance.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-eng-2024-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64792", "text": "{\n    \"policy_id\": \"LEAVE-ALL-2023-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, parental leave, and personal leave. It covers eligibility requirements, documentation needs, and return-to-work procedures.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-all-2023-002\"\n}"}
