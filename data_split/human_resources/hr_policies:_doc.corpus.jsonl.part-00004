{"_id": "human_resources--hr_policies:_doc--p--65731", "text": "{\n    \"policy_id\": \"BEN-LEAD-001\",\n    \"policy_title\": \"Leadership Benefits and Wellness Program\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to employees in leadership roles, with a strong emphasis on mental and physical well-being, including access to wellness programs, extended health benefits, and financial planning services.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Management\",\n        \"Leadership Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/benefits/leadership-benefits.pdf\"\n}"}
