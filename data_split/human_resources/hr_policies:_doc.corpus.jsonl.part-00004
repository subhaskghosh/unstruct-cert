{"_id": "human_resources--hr_policies:_doc--p--64341", "text": "{\n    \"policy_id\": \"WELLBEING-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including mental health resources, stress management programs, and work-life balance initiatives. It covers access to counseling services, mindfulness workshops, and flexible work arrangements. It also details procedures for requesting support and maintaining confidentiality.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Research\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-eng-2024-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64341", "text": "{\n    \"policy_id\": \"PTO-ENG-2023-002\",\n    \"policy_title\": \"Paid Time Off Policy - Engineering\",\n    \"policy_description\": \"This policy details the guidelines for requesting and utilizing paid time off (PTO) for employees in the Engineering department. It outlines accrual rates, request procedures, and maximum carryover limits.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-eng-2023-002\"\n}"}
