{"_id": "human_resources--hr_policies:_doc--n--62876", "text": "{\n    \"policy_id\": \"TRA-DEV-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"Outlines the process for identifying and developing future leaders within the organization. Includes detailed eligibility criteria and training schedules.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-dev.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62877", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Health Benefits Program\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on medical, dental, and vision coverage. Employees can find additional information on the HR portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62877", "text": "{\n    \"policy_id\": \"LGL-2022-005\",\n    \"policy_title\": \"Legal Compliance - Data Privacy\",\n    \"policy_description\": \"This policy details the company’s commitment to data privacy and compliance with all applicable regulations, including GDPR and CCPA. It outlines procedures for data collection, storage, usage, and protection. All employees are required to adhere to these guidelines to maintain the confidentiality and integrity of sensitive information. Non-compliance may result in disciplinary action.  Detailed guidance is available on the legal department's intranet page, including specifics on data breach reporting and employee training requirements. This policy encompasses all departments and covers various aspects of data handling, from customer information to employee records.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/dataprivacy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62878", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"Details regarding medical, dental, vision, and wellness programs available to all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62878", "text": "{\n    \"policy_id\": \"EXEC-COMP-002\",\n    \"policy_title\": \"Executive Bonus & Equity Plan\",\n    \"policy_description\": \"Outlines the bonus structure and equity options for executive-level employees.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/exec-comp/bonus-equity\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62879", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work_arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62879", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"Details the procedures for employees to enroll in company-sponsored health insurance plans. Includes information on eligibility, coverage options, and enrollment deadlines.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62880", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health, physical fitness, and financial wellness. It details eligibility, program benefits, and participation guidelines.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
