{"_id": "human_resources--hr_policies:_doc--p--68121", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, and vision benefits available to all eligible employees. It covers preventative care, prescription drugs, and mental health services. The goal is to promote employee well-being and provide comprehensive health coverage.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68121", "text": "{\n    \"policy_id\": \"RET-0005\",\n    \"policy_title\": \"Pre-Retirement Planning Assistance\",\n    \"policy_description\": \"This policy outlines the resources available to employees preparing for retirement, including financial planning workshops and access to retirement advisors.  It's designed to help employees make informed decisions about their future financial security.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement/pre-retirement.pdf\"\n}"}
