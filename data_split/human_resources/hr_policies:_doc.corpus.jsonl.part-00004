{"_id": "human_resources--hr_policies:_doc--p--65716", "text": "{\n    \"policy_id\": \"WFH-MH-2024-001\",\n    \"policy_title\": \"Remote Work Mental Health Support\",\n    \"policy_description\": \"This policy outlines resources and support available to remote employees to maintain their mental well-being. It includes guidelines on work-life balance, access to counseling services, and manager training on recognizing and addressing signs of stress in remote teams.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wfh-mental-health.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65716", "text": "{\n    \"policy_id\": \"LEAVE-GEN-2023-012\",\n    \"policy_title\": \"General Leave Policy\",\n    \"policy_description\": \"This policy details the various types of leave available to all employees, including sick leave, vacation leave, and parental leave. It outlines eligibility requirements, accrual rates, and the process for requesting leave.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/general-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65717", "text": "{\n    \"policy_id\": \"BNF-003\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Engineering\",\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65717", "text": "{\n    \"policy_id\": \"EXC-BNF-001\",\n    \"policy_title\": \"Executive Benefits Package\",\n    \"policy_description\": \"Details the comprehensive benefits package available to executive leadership, including enhanced health insurance, retirement plans, and executive-level perks.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"C-Suite\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65718", "text": "{\n    \"policy_id\": \"EB-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources and programs to promote physical and mental health. It covers gym memberships, mental health support, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65718", "text": "{\n    \"policy_id\": \"CMP-001\",\n    \"policy_title\": \"Salary Adjustment Guidelines\",\n    \"policy_description\": \"This policy details the process for salary reviews, adjustments, and promotions based on performance and market value.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/salary_guidelines.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65719", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy details the comprehensive wellness benefits available to employees, including gym memberships, mental health support, and employee assistance programs focused on well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001.pdf\"\n}"}
