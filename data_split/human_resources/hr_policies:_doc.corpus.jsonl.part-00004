{"_id": "human_resources--hr_policies:_doc--n--68721", "text": "{\n    \"policy_id\": \"EMP-TERM-003\",\n    \"policy_title\": \"Employee Termination and Exit Procedures\",\n    \"policy_description\": \"This policy details the procedures for terminating an employee, including notice periods, final paychecks, and return of company property.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/termination_procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68722", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance benefits offered to employees, including coverage options, premiums, and eligibility requirements. This policy aims to provide comprehensive health coverage for all eligible employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
