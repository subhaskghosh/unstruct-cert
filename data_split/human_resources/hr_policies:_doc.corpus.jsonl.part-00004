{"_id": "human_resources--hr_policies:_doc--p--69949", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for eligible employees. It covers eligibility criteria, security protocols, and performance expectations for employees working remotely.  Includes details on expense reimbursement and communication best practices.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69949", "text": "{\n    \"policy_id\": \"ETH-2022-005\",\n    \"policy_title\": \"Ethics and Conduct Policy\",\n    \"policy_description\": \"This policy details the ethical standards and expected conduct for all employees of the organization, covering topics such as conflicts of interest, confidentiality, and professional behavior. It emphasizes the importance of integrity and accountability.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-03-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/ethics-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--69950", "text": "{\n    \"policy_id\": \"POL-007\",\n    \"policy_title\": \"Employee Attendance and Conduct\",\n    \"policy_description\": \"This policy outlines the expectations for employee attendance, punctuality, and professional conduct. It emphasizes the importance of consistent attendance and appropriate behavior in the workplace. Regular attendance is critical for team performance, and all employees are expected to adhere to this policy. This includes guidelines around reporting absences and tardiness, and acceptable conduct during work hours. It also details consequences for non-compliance.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/attendance_conduct.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69950", "text": "{\n    \"policy_id\": \"POL-003\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy details the guidelines for employees who wish to work remotely. It covers eligibility requirements, equipment provisions, security protocols, and performance expectations. Remote work is a privilege, not a right, and is subject to manager approval. It ensures employees have access to necessary resources to perform their jobs effectively while working from home.\",\n    \"effective_date\": \"2023-02-20\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work.pdf\"\n}"}
