{"_id": "human_resources--hr_policies:_doc--n--70049", "text": "{\n    \"policy_id\": \"BP-2022-010\",\n    \"policy_title\": \"Expense Reimbursement Guidelines\",\n    \"policy_description\": \"This policy details the procedures for submitting and processing employee expense reports. Strict adherence to the outlined guidelines is required for all reimbursement requests. Any deviation will not be approved.  Detailed documentation, including receipts, is mandatory.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-policy.pdf\"\n}"}
