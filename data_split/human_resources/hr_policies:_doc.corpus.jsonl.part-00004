{"_id": "human_resources--hr_policies:_doc--p--62619", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks. It aims to promote work-life balance and employee productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-arrangement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62619", "text": "{\n    \"policy_id\": \"LEG-COMP-001\",\n    \"policy_title\": \"Non-Disclosure Agreement Policy\",\n    \"policy_description\": \"This policy details the requirements for maintaining the confidentiality of company information.  Violation may result in legal action.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62620", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels and enrollment procedures. Addresses common concerns about healthcare costs.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62620", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Employee Discount Program\",\n    \"policy_description\": \"Outlines discounts available to employees on company products.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/discount-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62621", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and adjusted work schedules, to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62621", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Expense Reimbursement Policy\",\n    \"policy_description\": \"Details the process and limitations for employee expense reimbursements. All expenses require pre-approval and detailed receipts.\",\n    \"effective_date\": \"2022-12-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/expense-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62622", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, offering resources for physical and mental wellness. Includes gym reimbursement and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62622", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Leave Policy\",\n    \"policy_description\": \"This policy details all types of leave available to employees, including vacation, sick leave, parental leave, bereavement leave, and jury duty.  It covers eligibility requirements, accrual rates, request procedures, and payment information. It also outlines specific procedures for extended leave of absence due to medical reasons, including FMLA compliance. The policy also covers leave donation programs and other related provisions. Detailed coverage is provided for all possible leave scenarios, including international travel, emergency situations, and leaves without pay.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62623", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental and vision coverage, paid time off, and retirement plan options. It aims to promote employee wellbeing and attract top talent.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62623", "text": "{\n    \"policy_id\": \"EXP-0017\",\n    \"policy_title\": \"Employee Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for authorized business expenses.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-22\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/expenses/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62624", "text": "{\n    \"policy_id\": \"PTO-2023-SM\",\n    \"policy_title\": \"Paid Time Off Policy - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and using paid time off for employees in the Sales and Marketing departments. It includes details on vacation, sick leave, and personal days, and how it affects compensation and benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_sm_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62624", "text": "{\n    \"policy_id\": \"PTO-2021-ALL\",\n    \"policy_title\": \"Paid Time Off Policy - All Employees\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and using paid time off for all employees.\",\n    \"effective_date\": \"2021-01-01\",\n    \"last_updated\": \"2021-12-31\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_all_2021.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62625", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health Benefits Policy\",\n    \"policy_description\": \"This policy details the health, dental, and vision benefits available to all eligible employees. It includes information on coverage levels, provider networks, and enrollment procedures.  We aim to provide extensive coverage for employee health and wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62625", "text": "{\n    \"policy_id\": \"EMP-EQT-003\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"This policy outlines the terms and conditions of the employee stock option plan, including eligibility, vesting schedules, and exercise procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62626", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to mental health resources, gym reimbursements, and healthy lifestyle workshops. It’s designed to support a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62626", "text": "{\n    \"policy_id\": \"TRAV-0005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Details the procedures for reimbursing employees for business-related travel expenses, including mileage, lodging, and meals. Requires pre-approval for trips exceeding $1000.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62627", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing access to resources such as gym memberships, mental health support, and wellness workshops. It aims to promote a healthy work-life balance and improve overall employee satisfaction.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62627", "text": "{\n    \"policy_id\": \"CMP-003\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"Detailed guidelines for bonus structures, stock options, and other forms of remuneration for executive leadership. Includes complex formulas and vesting schedules.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-comp\"\n}"}
