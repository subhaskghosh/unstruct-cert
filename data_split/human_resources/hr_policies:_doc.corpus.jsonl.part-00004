{"_id": "human_resources--hr_policies:_doc--p--71567", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to supporting employee well-being through various health and wellness initiatives, including gym memberships, mental health resources, and preventative care programs. We aim to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71567", "text": "{\n    \"policy_id\": \"TERM-0005\",\n    \"policy_title\": \"Termination and Exit Procedures\",\n    \"policy_description\": \"This policy outlines the procedures for terminating employment, including notice periods, severance packages, and final paychecks. It ensures compliance with all applicable labor laws during employee departures.\",\n    \"effective_date\": \"2023-07-20\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-policy.pdf\"\n}"}
