{"_id": "human_resources--hr_policies:_doc--n--64078", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A comprehensive plan outlining deferred compensation benefits for executive-level employees, covering various investment options, vesting schedules, and tax implications. Includes detailed legal disclaimers and complex calculation methodologies.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/deferred-compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64079", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the procedures for employees to enroll in the company's health insurance plan. It covers eligibility, enrollment deadlines, and available plan options. Please contact HR for any assistance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64079", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan Details\",\n    \"policy_description\": \"This policy details the company's 401k plan, including investment options, vesting schedules, employer matching contributions, loan provisions, and withdrawal rules. It also covers eligibility requirements, enrollment procedures, and beneficiary designations. A full legal review was conducted prior to implementation and annual updates are made to remain compliant with all applicable regulations. Furthermore, this policy coordinates with other financial wellness programs offered by the company. It provides detailed guidance on maximizing retirement savings and achieving financial security. The policy also includes information on hardship withdrawals and qualified domestic relations orders (QDROs).\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64080", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64080", "text": "{\n    \"policy_id\": \"TRA-DEV-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program designed to cultivate future leaders within the organization. Includes detailed descriptions of all program components, eligibility criteria, and evaluation metrics. This policy is a large document with many subsections.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leadership_development.pdf\"\n}"}
