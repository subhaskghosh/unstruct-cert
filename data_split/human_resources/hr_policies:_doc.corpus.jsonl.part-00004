{"_id": "human_resources--hr_policies:_doc--p--62226", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It details coverage levels, enrollment procedures, and wellness program options.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62226", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This document details the company's 401k plan, including eligibility, contribution limits, investment options, and withdrawal procedures.  It is a comprehensive guide to maximizing retirement savings and outlines the fiduciary responsibilities of the plan administrator. The plan details are subject to change based on regulatory updates and company performance. We strongly encourage all employees to carefully review the accompanying documentation and consult with a financial advisor. This plan contains provisions for hardship withdrawals, loan eligibility, and required minimum distributions. It also provides information on beneficiary designations and the process for updating them.  Detailed information about vesting schedules, fund performance reports, and plan fees can be found in the Summary Plan Description (SPD).\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62227", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"Details regarding health insurance coverage for employees.\",\n    \"effective_date\": \"2023-05-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62227", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"New Employee Stock Option Plan\",\n    \"policy_description\": \"Details regarding stock options for new hires.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62228", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellness, providing resources for preventative care, mental health support, and healthy lifestyle choices. It includes details on gym membership reimbursement and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62228", "text": "{\n    \"policy_id\": \"EB-2022-005\",\n    \"policy_title\": \"Legacy Health Insurance Plan\",\n    \"policy_description\": \"Details regarding the previously offered health insurance plan, including coverage tiers, deductible amounts, and claim procedures. This plan is no longer available to new hires.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/legacy-health-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62229", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing through various benefits including gym memberships, mental health resources, and healthy lifestyle workshops. It aims to promote a positive and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62229", "text": "{\n    \"policy_id\": \"BNF-2022-005\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"Details the procedures for filing claims and receiving benefits under the company's long-term disability insurance plan. Covers eligibility requirements, benefit amounts, and the appeals process. A comprehensive document detailing all legal aspects of the insurance policy.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability_insurance.pdf\"\n}"}
