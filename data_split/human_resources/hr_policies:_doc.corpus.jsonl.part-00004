{"_id": "human_resources--hr_policies:_doc--n--65933", "text": "{\n    \"policy_id\": \"LEAVE-2023-005\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing sick leave benefits. It specifies documentation requirements and limitations on consecutive sick days. It does not directly address employee well-being, but manages time off when ill.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave.pdf\"\n}"}
