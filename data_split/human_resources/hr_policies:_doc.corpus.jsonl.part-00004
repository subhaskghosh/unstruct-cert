{"_id": "human_resources--hr_policies:_doc--n--68473", "text": "{\n    \"policy_id\": \"STK-001\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"Comprehensive guide to the company's stock option plan, including vesting schedules, exercise procedures, and tax implications.  Extremely detailed and includes legal disclaimers.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity/stock-options\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68474", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellness, including access to gym memberships, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68474", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Plan Details\",\n    \"policy_description\": \"Detailed information regarding the company's health insurance plans, including coverage options, premiums, and claims procedures. This is a lengthy and complex document.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-details.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68475", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Covers mental health, financial difficulties, and legal concerns. Aims to improve employee wellbeing and productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68475", "text": "{\n    \"policy_id\": \"LC-007\",\n    \"policy_title\": \"Data Privacy and Security Policy\",\n    \"policy_description\": \"Details the company's policies regarding the collection, use, and protection of employee data. Covers GDPR compliance, data breach procedures, and employee responsibilities.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/data_privacy_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68476", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees. The EAP provides confidential counseling and support services to help employees address personal and work-related challenges.  Services include short-term counseling, referral services, and legal/financial consultation. Access to the EAP is free and confidential.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68476", "text": "{\n    \"policy_id\": \"LOA-2022-012\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and obtaining extended leaves of absence, including medical leave, parental leave, and personal leave. It covers eligibility requirements, documentation needed, benefits continuation during leave, and return-to-work processes.  The policy aims to provide employees with the necessary support during significant life events while ensuring business continuity.  Specific details regarding state and federal regulations are included as appendices.  This document is a comprehensive guide to all leave options available at the company, covering various scenarios and outlining the steps for each.  It's updated yearly to remain compliant with evolving legislation.  A full FAQ section is provided at the end of the document, addressing common employee questions. Employees are encouraged to review the full policy document available on the HR portal before initiating a leave request.  Failure to follow these procedures may result in a denial of leave. Further clarification can be sought from the HR department.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2024-02-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/loa-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68477", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, enrollment procedures, and claim submission guidelines.  The company provides a choice of PPO and HMO plans. Employees are responsible for a portion of the monthly premium.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68477", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy provides income replacement benefits to employees who become disabled and are unable to work for an extended period. Eligibility requirements, benefit levels, and claim procedures are detailed in this document. It covers a wide range of disability scenarios, including accidental injuries and illnesses, and provides options for both short-term and long-term coverage. The policy also addresses potential return-to-work scenarios and provides resources for rehabilitation and support.  The specific terms and conditions are subject to the governing insurance contract.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68478", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding the company's health insurance plan, including coverage options, premiums, and claim procedures. This policy aims to provide employees with comprehensive healthcare benefits.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68478", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Outlines the guidelines and procedures for reimbursing employees for business-related travel expenses. This includes acceptable expenses, documentation requirements, and reimbursement timelines. It is a lengthy and complex document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68479", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance coverage available to employees, including options, costs, and eligibility requirements. Focuses on employee well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68479", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Outlines the procedures for employees to submit and receive reimbursement for travel expenses incurred during business trips. Includes detailed requirements and documentation procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
