{"_id": "human_resources--hr_policies:_doc--p--64670", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees seeking flexible work arrangements, including remote work, flextime, and compressed workweeks, to promote work-life balance and improve employee satisfaction.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64670", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Employee Compensation Review\",\n    \"policy_description\": \"This policy details the annual process for reviewing employee compensation, including performance evaluations and salary adjustments.  It focuses on performance-based pay and market competitiveness.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-review\"\n}"}
