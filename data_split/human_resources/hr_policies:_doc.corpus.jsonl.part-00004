{"_id": "human_resources--hr_policies:_doc--p--71465", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, offering resources for physical, mental, and financial wellness. It includes details on gym memberships, EAP services, and financial planning workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71465", "text": "{\n    \"policy_id\": \"DISC-001\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy details the expected standards of behavior for all employees, including guidelines on professionalism, ethics, and conflict of interest. It also covers disciplinary procedures for violations.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2024-06-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct\"\n}"}
