{"_id": "human_resources--hr_policies:_doc--p--68152", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources for mental health, physical fitness, and work-life balance. It includes details on subsidized gym memberships, mindfulness workshops, and employee assistance programs.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68152", "text": "{\n    \"policy_id\": \"LC-2023-012\",\n    \"policy_title\": \"Data Privacy and Compliance\",\n    \"policy_description\": \"This policy details the company's procedures for handling sensitive employee data in accordance with GDPR and other relevant regulations. It outlines data access restrictions, data retention policies, and breach notification procedures.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"IT\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy\"\n}"}
