{"_id": "human_resources--hr_policies:_doc--n--70733", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Comprehensive Travel Expense Reimbursement\",\n    \"policy_description\": \"A detailed policy covering all aspects of travel expense reimbursement, including per diem rates, approved vendors, and expense report submission procedures. This policy applies to all employees traveling on company business and includes specific guidelines for international travel, conference attendance, and client entertainment. It also details the process for appealing denied expense claims and provides examples of acceptable and unacceptable expenses. Compliance with this policy is mandatory and violations may result in disciplinary action.  Detailed information about required documentation is found in Appendix A.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
