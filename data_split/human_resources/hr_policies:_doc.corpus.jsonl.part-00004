{"_id": "human_resources--hr_policies:_doc--n--68001", "text": "{\n    \"policy_id\": \"LD-2022-005\",\n    \"policy_title\": \"Non-Disclosure Agreement and Confidentiality\",\n    \"policy_description\": \"This policy legally binds all employees to maintain the confidentiality of company information, trade secrets, and customer data. Violation of this policy may result in legal prosecution and termination of employment. Detailed clauses regarding intellectual property are included.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda.pdf\"\n}"}
