{"_id": "human_resources--hr_policies:_doc--p--62871", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Mental Health and Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental health and provides resources for accessing counseling, stress management programs, and other well-being initiatives. It also details procedures for requesting accommodations related to mental health.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/mental-health-support.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62871", "text": "{\n    \"policy_id\": \"PH-2022-010\",\n    \"policy_title\": \"Company Gym Membership Reimbursement\",\n    \"policy_description\": \"This policy details the company's reimbursement program for employee gym memberships and fitness-related expenses. It aims to encourage employees to maintain a healthy lifestyle.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/gym-reimbursement.pdf\"\n}"}
