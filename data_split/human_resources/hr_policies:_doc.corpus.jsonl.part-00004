{"_id": "human_resources--hr_policies:_doc--p--62856", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to gym memberships, mental health resources, and flexible work arrangements.  It's designed to support a healthy work-life balance.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62856", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"Details the process for employees to submit and receive reimbursement for travel and business expenses.  Adheres to all legal and accounting standards.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy.pdf\"\n}"}
