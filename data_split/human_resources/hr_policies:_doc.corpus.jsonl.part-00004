{"_id": "human_resources--hr_policies:_doc--p--71176", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Health Insurance Benefits - Comprehensive Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance benefits offered to eligible employees, including coverage details, enrollment procedures, and claim processes. It addresses scenarios involving pre-existing conditions, specialist referrals, and out-of-network care, providing clear guidance for both employees and HR personnel.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71176", "text": "{\n    \"policy_id\": \"RW-2024-002\",\n    \"policy_title\": \"Remote Work Agreement and Guidelines\",\n    \"policy_description\": \"This policy outlines the guidelines for employees working remotely, including eligibility criteria, security protocols, and performance expectations. It details procedures for requesting remote work arrangements and ensuring effective communication and collaboration.\",\n    \"effective_date\": \"2024-01-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-agreement.pdf\"\n}"}
