{"_id": "human_resources--hr_policies:_doc--n--67441", "text": "{\n    \"policy_id\": \"EMP-TRAIN-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy outlines the requirements and procedures for participation in the company's Leadership Development Program. It details the selection criteria, training modules, and performance expectations. This is a very detailed program with 3 years of modules and regular check-ins.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67442", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to all eligible employees. Coverage includes medical, dental, and vision. Employees are responsible for a portion of the premium, as detailed in the benefits enrollment guide. The policy aims to provide comprehensive healthcare access.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67442", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Comprehensive Travel Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while on company business. It covers airfare, lodging, meals, transportation, and other incidental costs. Employees must adhere to pre-approved budgets and submit detailed expense reports with receipts.  The policy includes specific guidelines for different travel classes, per diem rates, and approval hierarchies. Detailed stipulations regarding lodging and meal allowances based on location and trip duration are outlined, as well as procedures for emergency travel situations and exceptions. It also outlines approved vendors and procurement processes. This policy applies to all departments and all levels of employees, contractors, and consultants.\",\n    \"effective_date\": \"2023-06-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67443", "text": "{\n    \"policy_id\": \"WB-2024-07-15\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including mental health resources, fitness benefits, and work-life balance initiatives.\",\n    \"effective_date\": \"2024-07-15\",\n    \"last_updated\": \"2024-09-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-2024\"\n}"}
