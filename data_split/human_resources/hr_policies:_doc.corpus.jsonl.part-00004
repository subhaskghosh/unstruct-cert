{"_id": "human_resources--hr_policies:_doc--n--68253", "text": "{\n    \"policy_id\": \"EMP-TERM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"This policy details the process for terminating an employee, including required documentation and exit interviews. It also covers final pay and benefits continuation.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-procedures.pdf\"\n}"}
