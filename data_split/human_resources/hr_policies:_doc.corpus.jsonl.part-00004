{"_id": "human_resources--hr_policies:_doc--p--71765", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing access to mental health resources, fitness benefits, and stress management workshops. It emphasizes proactive support for employee well-being and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71765", "text": "{\n    \"policy_id\": \"WB-2022-001\",\n    \"policy_title\": \"General Employee Assistance Program\",\n    \"policy_description\": \"This policy details the Employee Assistance Program available to all employees, providing confidential counseling and support services. The program covers a wide range of personal and work-related issues, and strives to provide comprehensive assistance.\",\n    \"effective_date\": \"2022-12-10\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-2022.pdf\"\n}"}
