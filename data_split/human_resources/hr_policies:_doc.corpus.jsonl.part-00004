{"_id": "human_resources--hr_policies:_doc--p--64177", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. The description is intentionally concise and focuses on key benefits.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64177", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"A comprehensive plan detailing stock options granted to executive-level employees, including vesting schedules, exercise conditions, and tax implications. The document includes complex legal language and multiple scenarios.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64178", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health, physical fitness, and financial wellness.\",\n    \"effective_date\": \"2023-12-15\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64178", "text": "{\n    \"policy_id\": \"LE-2023-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details regarding various types of leave available to employees, including sick leave, parental leave, and personal leave.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64179", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can choose from a variety of plans to meet their individual needs. Details regarding coverage levels and premiums can be found in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64179", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, encompassing 401(k) contributions, pension plans, and financial planning resources. It also covers vesting schedules, eligibility requirements, and procedures for accessing retirement funds. The plan is designed to provide employees with financial security during their retirement years and to attract and retain top talent. A detailed breakdown of investment options and associated risks is available in the full policy document. This is a highly complex plan with multiple tiers and regulatory considerations. Changes to this policy require legal review. Specific information regarding hardship withdrawals and loan provisions are also included. We provide regular workshops to educate employees on maximizing their retirement benefits. Furthermore, the policy includes details on beneficiary designations and required minimum distributions. \",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64180", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-08-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64180", "text": "{\n    \"policy_id\": \"EMP-PRO-005\",\n    \"policy_title\": \"Employee Performance Review Process\",\n    \"policy_description\": \"A comprehensive guide outlining the annual performance review process, including goal setting, self-assessment, manager review, and development planning. Includes detailed scoring rubrics and performance improvement plan procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-process.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64181", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, dental, vision, life insurance, and retirement plans. It details eligibility requirements, enrollment procedures, and coverage details.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64181", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Limited Medical Benefits for Part-Time Employees\",\n    \"policy_description\": \"This policy details the medical benefits available to part-time employees. Coverage is limited compared to full-time employees and does not include dental or vision.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/parttime_medical.pdf\"\n}"}
