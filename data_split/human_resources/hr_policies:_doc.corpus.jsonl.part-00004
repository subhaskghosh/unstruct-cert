{"_id": "human_resources--hr_policies:_doc--p--64066", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the mental and emotional wellbeing of its employees. It details available resources such as counseling services, employee assistance programs, and mental health training. It also clarifies procedures for requesting accommodations related to mental health.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-detailed.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64066", "text": "{\n    \"policy_id\": \"LE-2023-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy provides information about different types of leave available to employees, including sick leave, vacation leave, and parental leave. It outlines eligibility requirements and procedures for requesting leave.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy-summary.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64067", "text": "{\n    \"policy_id\": \"EMP-BEN-2024-001\",\n    \"policy_title\": \"Enhanced Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including mental health resources, fitness subsidies, and nutritional guidance. It is designed to attract and retain top talent and increase overall productivity.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Product Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64067", "text": "{\n    \"policy_id\": \"TRAV-EXP-2023-002\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for travel and business expenses. It covers topics such as allowable expenses, documentation requirements, and approval processes.\",\n    \"effective_date\": \"2023-07-20\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy-2023\"\n}"}
