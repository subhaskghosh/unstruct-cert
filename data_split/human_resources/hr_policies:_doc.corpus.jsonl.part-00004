{"_id": "human_resources--hr_policies:_doc--p--64931", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Family Leave and Support Policy\",\n    \"policy_description\": \"This policy outlines the provisions for family leave, including parental leave, sick leave for family members, and flexible work arrangements to support employees with family care responsibilities. It also details available benefits and resources.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/family-leave-policy\"\n}"}
