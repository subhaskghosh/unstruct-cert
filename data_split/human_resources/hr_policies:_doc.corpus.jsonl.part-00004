{"_id": "human_resources--hr_policies:_doc--p--68387", "text": "{\n    \"policy_id\": \"BEN-HEALTH-20231027\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Detailed guidelines on health insurance coverage, eligibility, and claims processes for all eligible employees. Includes information on deductibles, co-pays, and out-of-pocket maximums. Covers both medical, dental, and vision benefits. This policy aims to provide employees with comprehensive health coverage.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
