{"_id": "human_resources--hr_policies:_doc--n--65923", "text": "{\n    \"policy_id\": \"GEN-POL-001\",\n    \"policy_title\": \"Company Code of Conduct\",\n    \"policy_description\": \"Outlines the expected standards of behavior for all employees, including ethical conduct and compliance with company policies.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65924", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy provides confidential support services to employees experiencing personal or work-related challenges. Services include counseling, legal assistance, and financial advice. We aim to foster a supportive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65924", "text": "{\n    \"policy_id\": \"AT-2023-012\",\n    \"policy_title\": \"Attendance and Tardiness\",\n    \"policy_description\": \"This policy outlines the company's expectations regarding employee attendance and punctuality. Strict penalties apply for unauthorized absences and repeated tardiness.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Operations\",\n        \"Logistics\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65925", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details about enrollment, coverage levels, and claims procedures are provided in the linked document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65925", "text": "{\n    \"policy_id\": \"GEN-CMP-005\",\n    \"policy_title\": \"Company Code of Conduct\",\n    \"policy_description\": \"A comprehensive document detailing the ethical guidelines and expected behavior of all employees. This policy addresses conflict of interest, confidentiality, anti-harassment, and other essential ethical principles to ensure a respectful and compliant work environment. It also includes detailed procedures for reporting violations and disciplinary actions.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65926", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels and enrollment procedures are available in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
