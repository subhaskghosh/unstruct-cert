{"_id": "human_resources--hr_policies:_doc--p--71839", "text": "{\n    \"policy_id\": \"EMP-BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's wellness program, including gym membership discounts, mental health resources, and annual health screenings. It is designed to promote employee health and well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71839", "text": "{\n    \"policy_id\": \"EMP-BEN-0005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy outlines the terms and conditions of the executive stock option plan, including vesting schedules, exercise prices, and tax implications. It's governed by SEC regulations and requires extensive legal review.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71840", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. We strive to provide comprehensive and easy-to-understand benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71840", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k retirement plan, including eligibility requirements, contribution limits, and investment options. The plan involves a complicated vesting schedule and numerous investment choices.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
