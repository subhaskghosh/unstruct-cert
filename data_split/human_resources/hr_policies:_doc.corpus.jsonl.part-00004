{"_id": "human_resources--hr_policies:_doc--n--62820", "text": "{\n    \"policy_id\": \"LVE-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and family leave. It covers eligibility requirements and responsibilities of both employees and managers.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/leave_policy.docx\"\n}"}
