{"_id": "human_resources--hr_policies:_doc--n--62828", "text": "{\n    \"policy_id\": \"EXEC-COMP-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy outlines the terms and conditions for granting stock options to executive-level employees as part of their compensation package. It includes vesting schedules and exercise guidelines.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62829", "text": "{\n    \"policy_id\": \"BEN-4567\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"Details the full range of benefits available to full-time employees, including health insurance, retirement plans, and paid time off. Focuses on financial wellbeing through robust 401k matching and employee stock purchase plans.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62829", "text": "{\n    \"policy_id\": \"BEN-1234\",\n    \"policy_title\": \"Short-Term Disability Insurance\",\n    \"policy_description\": \"Outlines the provisions for short-term disability benefits for eligible employees.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/std-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62830", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Flexible Work Arrangement\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work and adjusted work hours, to promote work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible_work_arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62830", "text": "{\n    \"policy_id\": \"TR-2022-005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Detailed procedures for reimbursing employees for travel expenses incurred during business trips. This includes guidelines for accommodation, meals, transportation, and incidentals. Please submit all receipts for accurate and timely processing. Adherence to these guidelines is mandatory for all employees undertaking business travel.\",\n    \"effective_date\": \"2022-10-20\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_reimbursement.pdf\"\n}"}
