{"_id": "human_resources--hr_policies:_doc--p--62722", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to employees. It also includes resources for mental wellness and stress management.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/healthwellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62722", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This comprehensive policy details the compensation structure for executive-level employees, including base salary, bonus eligibility, stock options, and restricted stock units. It covers performance-based incentives, long-term equity awards, and clawback provisions. Detailed clauses regarding vesting schedules and change-of-control scenarios are included. Legal counsel review is mandatory for all executive compensation arrangements. This policy complies with all applicable regulations and company governance standards. Amendment procedures are defined within. It also includes detailed information on taxation implications of equity grants.  The policy provides a detailed framework for executive compensation, aimed at attracting, retaining, and motivating key leaders to drive long-term company success.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive_comp\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62723", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care, including details on coverage levels, premiums, and claims procedures. This includes information on deductibles, co-pays, and out-of-pocket maximums.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2022-12-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62723", "text": "{\n    \"policy_id\": \"EMP-EXP-002\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while on company business. It covers topics such as allowable expenses, documentation requirements, and reimbursement timelines.\",\n    \"effective_date\": \"2024-01-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_expense_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62724", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, including gym membership discounts, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
