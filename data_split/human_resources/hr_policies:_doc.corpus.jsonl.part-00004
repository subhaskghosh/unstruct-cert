{"_id": "human_resources--hr_policies:_doc--p--64544", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy details the company's commitment to employee wellbeing, including access to mental health resources, gym memberships, and healthy lifestyle programs. It aims to create a supportive work environment that prioritizes the physical and emotional health of all employees.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-policy\"\n}"}
