{"_id": "human_resources--hr_policies:_doc--p--65483", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the employee wellness benefits offered by the company, including gym memberships, mental health resources, and preventative care options. The goal is to promote employee well-being and reduce healthcare costs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-wellness-policy\"\n}"}
