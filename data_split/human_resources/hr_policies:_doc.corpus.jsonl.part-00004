{"_id": "human_resources--hr_policies:_doc--p--71315", "text": "{\n    \"policy_id\": \"EMP-BNF-005\",\n    \"policy_title\": \"Comprehensive Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness benefits available to all employees, including health insurance, mental health resources, and wellness program participation. It emphasizes preventative care and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits.pdf\"\n}"}
