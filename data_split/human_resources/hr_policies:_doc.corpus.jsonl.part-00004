{"_id": "human_resources--hr_policies:_doc--p--61601", "text": "{\n    \"policy_id\": \"PTO-2023-SM\",\n    \"policy_title\": \"Paid Time Off Policy - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off for employees in the Sales and Marketing departments. It covers vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-sm\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61601", "text": "{\n    \"policy_id\": \"LEAVE-2022-ALL\",\n    \"policy_title\": \"Extended Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the comprehensive procedures and legal requirements for extended leaves of absence, including FMLA, parental leave, and other statutory entitlements.  It requires detailed documentation and adherence to all applicable federal and state regulations. All employees are covered.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave\"\n}"}
