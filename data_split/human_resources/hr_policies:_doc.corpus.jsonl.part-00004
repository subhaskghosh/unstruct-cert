{"_id": "human_resources--hr_policies:_doc--p--70322", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, to support employee work-life balance and productivity.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
