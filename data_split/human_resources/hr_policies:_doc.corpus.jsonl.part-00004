{"_id": "human_resources--hr_policies:_doc--n--70210", "text": "{\n    \"policy_id\": \"EMP-DISC-001\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and performance issues. It includes a progressive discipline process and outlines the consequences of violating company rules.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-procedures\"\n}"}
