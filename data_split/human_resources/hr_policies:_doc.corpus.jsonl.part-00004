{"_id": "human_resources--hr_policies:_doc--p--68535", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy outlines the enhanced parental leave benefits available to all eligible employees, including paid leave and flexible return-to-work options. It is designed to support employees during significant life events and promote work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental_leave_enhanced.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68535", "text": "{\n    \"policy_id\": \"GEN-PROC-012\",\n    \"policy_title\": \"Expense Reimbursement Procedure\",\n    \"policy_description\": \"This document details the process for submitting and approving employee expense reports, outlining allowable expenses and required documentation.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/expense_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68536", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Benefits Package - Comprehensive\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, retirement plans, and paid time off.  It is designed to support employees' well-being and provide financial security.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68536", "text": "{\n    \"policy_id\": \"TRN-2022-005\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"This policy details the guidelines for reimbursing employees for business-related travel expenses.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68537", "text": "{\n    \"policy_id\": \"EMP-BEN-0042\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision plans.  Details regarding eligibility and enrollment are included. This policy promotes employee well-being and provides access to quality healthcare.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68537", "text": "{\n    \"policy_id\": \"EMP-COMP-0015\",\n    \"policy_title\": \"Executive Compensation Plan (Including Stock Options)\",\n    \"policy_description\": \"This policy details the compensation structure for executive-level employees, including base salary, bonuses, and stock options. Eligibility criteria and vesting schedules are outlined in this document.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68538", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the company's health insurance plans, eligibility, and enrollment procedures.  Covers medical, dental, and vision benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68538", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Outlines the terms and conditions for stock option grants to executive-level employees. Includes vesting schedules and exercise procedures.\",\n    \"effective_date\": \"2022-12-10\",\n    \"last_updated\": \"2023-10-01\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68539", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing access to resources and programs promoting physical and mental health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
