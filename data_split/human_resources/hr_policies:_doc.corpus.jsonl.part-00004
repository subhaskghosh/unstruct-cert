{"_id": "human_resources--hr_policies:_doc--n--68570", "text": "{\n    \"policy_id\": \"EB-2023-002\",\n    \"policy_title\": \"New 401k Matching Program\",\n    \"policy_description\": \"A comprehensive overview of the enhanced 401k matching program, including eligibility requirements, contribution limits, vesting schedules, and investment options.  Detailed guidance on enrollment and managing your 401k account is also provided.  This program is designed to help employees save for their retirement while receiving a generous company match. Includes numerous appendices detailing financial planning resources.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
