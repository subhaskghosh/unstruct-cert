{"_id": "human_resources--hr_policies:_doc--p--62336", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision plans. Employees are responsible for understanding their coverage options and associated costs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62336", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This comprehensive policy details the long-term disability insurance benefits offered to employees, covering various scenarios and claim procedures. It includes detailed information regarding eligibility criteria, benefit amounts, waiting periods, and the appeals process. A thorough understanding of this policy is crucial for employees to ensure they are adequately protected in the event of a long-term disability. It also specifies the interaction with other leave policies, such as sick leave and short-term disability. Moreover, it describes the company's responsibilities and the employee's obligations throughout the claims process. The policy is reviewed annually and updated to reflect changes in legislation and best practices.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62337", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"Details the health, dental, vision, and wellness programs available to employees. Includes information on eligibility, coverage levels, and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-07-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62337", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Temporary Pandemic Sick Leave\",\n    \"policy_description\": \"Outlines the sick leave policy during the COVID-19 pandemic.  Provides additional paid time off for employees impacted by illness or quarantine.\",\n    \"effective_date\": \"2020-03-15\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/pandemic_leave.pdf\"\n}"}
