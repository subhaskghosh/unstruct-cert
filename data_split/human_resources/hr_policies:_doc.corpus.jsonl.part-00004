{"_id": "human_resources--hr_policies:_doc--p--71736", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges.  Aims to promote employee well-being and resilience.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
