{"_id": "human_resources--hr_policies:_doc--p--65062", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness and Work-Life Integration\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various programs, including flexible work arrangements, mental health resources, and paid time off for family care.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-2023-001\"\n}"}
