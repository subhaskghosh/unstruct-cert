{"_id": "human_resources--hr_policies:_doc--p--67713", "text": "{\n    \"policy_id\": \"BP-2023-007\",\n    \"policy_title\": \"Enhanced Employee Bonus Program\",\n    \"policy_description\": \"This policy outlines the enhanced bonus structure for employees in the Sales and Marketing departments, focusing on performance-based incentives and recognizing outstanding contributions. The program aims to boost morale and incentivize higher sales targets.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/bonus_program_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67713", "text": "{\n    \"policy_id\": \"IT-2023-012\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"This policy details the appropriate use of company-owned computers, software, and network resources. It covers data security, privacy, and responsible online behavior. This policy applies to all employees.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"HR\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/tech_usage_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67714", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage, premiums, and how to enroll. We aim to provide comprehensive and affordable healthcare options.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67714", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions governing the grant and exercise of stock options to executive officers of the company.  Section 3.2(b) outlines the vesting schedule and transfer restrictions, requiring adherence to SEC Rule 16b-3.  This plan is subject to amendment as deemed necessary by the Compensation Committee.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67715", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including gym reimbursements and mental health resources.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
