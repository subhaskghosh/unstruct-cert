{"_id": "human_resources--hr_policies:_doc--p--64076", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, and retirement plans. It aims to provide robust financial and well-being support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64076", "text": "{\n    \"policy_id\": \"BP-2022-001\",\n    \"policy_title\": \"Employee Discount Program\",\n    \"policy_description\": \"This policy details the employee discount program offered on company products. It provides limited financial savings on purchases.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2022-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/discount_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64077", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial planning. It aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64077", "text": "{\n    \"policy_id\": \"TR-002\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred during business trips.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement.pdf\"\n}"}
