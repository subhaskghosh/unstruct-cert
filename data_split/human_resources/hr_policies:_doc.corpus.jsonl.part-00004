{"_id": "human_resources--hr_policies:_doc--p--62969", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee 401k Contribution Policy\",\n    \"policy_description\": \"This policy outlines the company's 401k plan, including eligibility, contribution limits, and vesting schedule. Employees are eligible to contribute a percentage of their salary, and the company will match up to 5%.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62969", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Healthcare Benefits Package\",\n    \"policy_description\": \"This document details the comprehensive healthcare benefits package offered to employees, including medical, dental, and vision coverage. It outlines eligibility requirements, plan options, premium costs, and procedures for filing claims. It also covers dependent coverage, wellness programs, and out-of-network care. Further details can be found on the benefits portal. This package also covers life insurance, disability insurance, and employee assistance programs (EAPs). The policy is subject to change based on regulatory updates and market conditions.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/healthcare-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62970", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and work-life balance. It emphasizes a supportive and inclusive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62970", "text": "{\n    \"policy_id\": \"LC-2022-005\",\n    \"policy_title\": \"Data Privacy and Compliance\",\n    \"policy_description\": \"This policy details the procedures for handling employee data in accordance with GDPR and other relevant privacy regulations. It includes extensive legal disclaimers and compliance requirements.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy\"\n}"}
