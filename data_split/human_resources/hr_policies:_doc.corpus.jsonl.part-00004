{"_id": "human_resources--hr_policies:_doc--p--62185", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee health and well-being, offering resources and programs to support a healthy lifestyle.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62185", "text": "{\n    \"policy_id\": \"TERM-001\",\n    \"policy_title\": \"Employee Termination Procedure\",\n    \"policy_description\": \"This policy outlines the process for terminating an employee's employment with the company.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-procedure\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62186", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee 401k Contribution Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employee contributions to the company's 401k retirement savings plan.  Employees may contribute a percentage of their pre-tax salary up to the IRS limit. The company will match 50% of contributions up to 6% of salary.  See the full plan document for details.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62186", "text": "{\n    \"policy_id\": \"EMP-TRAIN-002\",\n    \"policy_title\": \"Leadership Development Program Policy\",\n    \"policy_description\": \"This policy details the company's commitment to employee development, outlining the procedures for nominating and participating in the Leadership Development Program. The program is designed to cultivate future leaders within the organization through a combination of training sessions, mentorship opportunities, and project assignments.  It covers a range of skills including strategic thinking, communication, and team management. The selection process is competitive and based on performance reviews, leadership potential, and demonstrated commitment to the company's values. Participants will be assessed throughout the program based on their progress and contributions.  Further details regarding eligibility criteria, program schedule, and application procedures can be found in the full program guidelines. This is a multi-year program with continuous evaluation.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62187", "text": "{\n    \"policy_id\": \"WB-2023-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources and support for physical, mental, and financial health.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
