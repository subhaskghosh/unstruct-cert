{"_id": "human_resources--hr_policies:_doc--p--67360", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67360", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67361", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Eligibility\",\n    \"policy_description\": \"This policy outlines the eligibility criteria for employees to enroll in the company's health insurance plan. Full-time employees are eligible after 30 days of employment. Dependents can be added during open enrollment. \",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67361", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k plan, including contribution matching, vesting schedules, investment options, loan provisions, and withdrawal rules. It also covers information on financial planning resources available to employees and outlines the process for changing beneficiary designations. The plan aims to provide a secure retirement income for all eligible employees. Legal disclaimers are included at the end of the document, and the plan is subject to change based on regulatory updates. This is a lengthy document designed to be exhaustive in its coverage of retirement planning, and employees are encouraged to consult with a financial advisor for personalized guidance. Further, amendments to the plan will be communicated through separate notices and updates to this document. A detailed FAQ section is also available on the company intranet. This policy aims for complete clarity on all retirement-related matters. \",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement_plan_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67362", "text": "{\n    \"policy_id\": \"BP-2023-015\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"This policy outlines the commission structure for all Sales team members, including bonus eligibility and performance metrics.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission-structure\"\n}"}
