{"_id": "human_resources--hr_policies:_doc--n--62436", "text": "{\n    \"policy_id\": \"RET-PLAN-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Outlines the company's 401k plan, including contribution limits and investment options.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement/401k.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62437", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees, designed to promote employee wellbeing and a healthy work-life balance. It includes provisions for preventative care, mental health resources, and flexible spending accounts.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62437", "text": "{\n    \"policy_id\": \"LEGL-2022-005\",\n    \"policy_title\": \"Non-Disclosure and Confidentiality Agreement\",\n    \"policy_description\": \"This legally binding agreement details the obligations of employees regarding the protection of company confidential information, trade secrets, and intellectual property. Strict adherence to the terms outlined herein is required to avoid legal repercussions.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/nda.pdf\"\n}"}
