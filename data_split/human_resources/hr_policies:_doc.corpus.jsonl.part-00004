{"_id": "human_resources--hr_policies:_doc--n--71163", "text": "{\n    \"policy_id\": \"COMP-0005\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This policy details the compensation structure for executive-level employees, including salary, bonus eligibility, stock options, and other equity-based incentives. It is governed by specific performance metrics and legal regulations.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation.pdf\"\n}"}
