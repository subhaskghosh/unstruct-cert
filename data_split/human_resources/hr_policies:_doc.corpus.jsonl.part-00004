{"_id": "human_resources--hr_policies:_doc--n--65852", "text": "{\n    \"policy_id\": \"EMP-TRA-002\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"Outlines the process for conducting performance reviews, setting goals, and providing feedback to employees.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65853", "text": "{\n    \"policy_id\": \"WB-ENG-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees and their families to address personal and work-related challenges, promoting mental and emotional wellbeing.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Research\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65853", "text": "{\n    \"policy_id\": \"RW-ENG-002\",\n    \"policy_title\": \"Remote Work Arrangement Policy\",\n    \"policy_description\": \"Outlines the guidelines and procedures for employees who wish to work remotely, including eligibility criteria, equipment requirements, and performance expectations.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65854", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees are responsible for a portion of the premium, which is deducted from their paycheck. Detailed information on coverage levels and provider networks can be found in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65854", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Retirement Plan\",\n    \"policy_description\": \"This is a comprehensive retirement plan exclusively available to executive-level employees. The plan includes a combination of 401(k) contributions, profit sharing, and supplemental executive retirement benefits. Eligibility is determined based on job title and years of service. The plan is designed to provide a secure financial future for our leadership team. Complex calculations and legal compliance requirements are involved in administering this plan. Vesting schedules and payout options are subject to specific terms and conditions, as detailed in the full plan document. Investment options are managed by a third-party administrator. All plan documents and amendments are subject to change based on regulatory updates and company performance. Employee questions should be directed to the Benefits Department. The plan adheres to all applicable ERISA regulations. Further details regarding tax implications and distribution rules can be found in the plan summary.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65855", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health and Wellness Benefit Updates\",\n    \"policy_description\": \"This policy outlines the updated health and wellness benefits available to all employees, including expanded mental health resources and preventative care options. It promotes employee well-being and supports a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellness-update-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65855", "text": "{\n    \"policy_id\": \"PERF-REV-001\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"This policy details the annual performance review process, including goal setting, feedback mechanisms, and performance improvement plans. The aim is to foster employee growth and development.\",\n    \"effective_date\": \"2023-02-28\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance/review-process\"\n}"}
