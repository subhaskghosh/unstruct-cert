{"_id": "human_resources--hr_policies:_doc--p--70080", "text": "{\n    \"policy_id\": \"BNF-2023-12\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, and retirement plans. It also details procedures for enrollment and changes to benefits.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package-2023.pdf\"\n}"}
