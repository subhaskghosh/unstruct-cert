{"_id": "human_resources--hr_policies:_doc--p--70256", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, and vision benefits available to all eligible employees. It includes details on coverage levels, enrollment procedures, and wellness programs.  The policy also describes employee assistance programs and resources for mental health support.  This is updated annually to reflect changes in plan offerings and regulations.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70256", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related travel and expenses. It covers allowable expenses, documentation requirements, and approval processes.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel_expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70257", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It provides details on coverage options, premiums, and claim procedures. We aim to provide accessible and comprehensive health care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70257", "text": "{\n    \"policy_id\": \"LEGAL-COMP-005\",\n    \"policy_title\": \"Non-Disclosure Agreement Compliance\",\n    \"policy_description\": \"Detailed legal framework outlining the obligations of employees regarding confidential company information, encompassing all forms of intellectual property and trade secrets. Strict adherence to these provisions is legally mandated. Includes clauses on non-compete and liability. Subject to ongoing legal review.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-compliance\"\n}"}
