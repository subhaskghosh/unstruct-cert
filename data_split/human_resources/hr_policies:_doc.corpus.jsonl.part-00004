{"_id": "human_resources--hr_policies:_doc--n--70041", "text": "{\n    \"policy_id\": \"TMP-2024-010\",\n    \"policy_title\": \"Temporary Assignment Policy\",\n    \"policy_description\": \"This policy details the procedures for temporary assignments and secondments within the organization.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/tmp-2024-010.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70042", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Employee Health Benefits Plan\",\n    \"policy_description\": \"This policy outlines the health benefits available to all full-time employees. It covers medical, dental, and vision insurance, as well as wellness programs. Employees are eligible for benefits after 90 days of employment. The plan includes options for individual and family coverage. Detailed information about coverage levels, co-pays, and deductibles can be found in the plan documents linked below. This policy is regularly reviewed to ensure it remains competitive and meets the needs of our employees. Updates are communicated annually during open enrollment.  This policy aims to support employee well-being and attract and retain top talent.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_plan_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70042", "text": "{\n    \"policy_id\": \"BP-2022-012\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to submit and be reimbursed for travel expenses incurred while on company business. All travel must be pre-approved by a manager.  Reimbursement rates are outlined in the policy.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70043", "text": "{\n    \"policy_id\": \"TRVL-EXP-2023\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for reasonable and necessary expenses incurred while traveling on company business. It covers transportation, lodging, meals, and other incidental expenses.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70043", "text": "{\n    \"policy_id\": \"LEAV-2022\",\n    \"policy_title\": \"Employee Leave of Absence\",\n    \"policy_description\": \"This policy details the different types of leave available to employees, including sick leave, vacation leave, and personal leave. It also outlines the procedures for requesting and approving leave.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"HR\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
