{"_id": "human_resources--hr_policies:_doc--p--61745", "text": "{\n    \"policy_id\": \"PTO-SM-202401\",\n    \"policy_title\": \"Paid Time Off - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the paid time off benefits available to employees in the Sales and Marketing departments. It includes vacation, sick leave, and personal days.  Employees are encouraged to utilize this time to maintain a healthy work-life balance.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-sm-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61745", "text": "{\n    \"policy_id\": \"PTO-GEN-202312\",\n    \"policy_title\": \"General Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the basic paid time off benefits available to all employees. It includes vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2023-12-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/general-pto-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61746", "text": "{\n    \"policy_id\": \"RW-2023-ENG-PROD-001\",\n    \"policy_title\": \"Remote Work and Employee Wellness\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements, prioritizing employee well-being and work-life balance. It includes provisions for ergonomic assessments, regular check-ins with managers, and access to mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-wellness-policy\"\n}"}
