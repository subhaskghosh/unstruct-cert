{"_id": "human_resources--hr_policies:_doc--p--69623", "text": "{\n    \"policy_id\": \"RW-2023-SM\",\n    \"policy_title\": \"Remote Work Policy - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for employees in the Sales and Marketing departments. It details eligibility, security protocols, and performance expectations for remote workers. The policy addresses both fully remote and hybrid work models.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-sales-marketing.pdf\"\n}"}
