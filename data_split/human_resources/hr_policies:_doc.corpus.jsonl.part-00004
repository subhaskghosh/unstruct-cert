{"_id": "human_resources--hr_policies:_doc--p--64369", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness Program - Engineering\",\n    \"policy_description\": \"This policy outlines the wellness resources available to all Engineering department employees, including access to mental health support, ergonomic assessments, and fitness reimbursement programs. It aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-engineering.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64369", "text": "{\n    \"policy_id\": \"LOA-HR-2023-005\",\n    \"policy_title\": \"Extended Leave of Absence - All Departments\",\n    \"policy_description\": \"This comprehensive policy details the procedures for requesting and taking extended leaves of absence, covering various scenarios such as medical leave, parental leave, and personal leave. It includes detailed eligibility criteria, documentation requirements, and benefit continuation information.  This is a complex document covering many situations.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/extended-leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64370", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Employee Hardship Assistance Program\",\n    \"policy_description\": \"This policy outlines the support available to employees facing unforeseen financial or personal hardships. It includes details on emergency loans, counseling services, and flexible work arrangements.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/BEN-005.pdf\"\n}"}
