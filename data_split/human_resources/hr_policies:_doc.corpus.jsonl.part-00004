{"_id": "human_resources--hr_policies:_doc--n--68734", "text": "{\n    \"policy_id\": \"EMP-COMP-002\",\n    \"policy_title\": \"Employee Compensation and Performance Review\",\n    \"policy_description\": \"This policy details the company's compensation structure, performance review process, and bonus eligibility. It covers salary ranges, merit increases, and stock options. A highly detailed document outlining complex calculations and procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation.pdf\"\n}"}
