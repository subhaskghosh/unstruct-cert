{"_id": "human_resources--hr_policies:_doc--n--64183", "text": "{\n    \"policy_id\": \"LOA-2023-005\",\n    \"policy_title\": \"Bereavement Leave\",\n    \"policy_description\": \"This policy details the provisions for employees taking leave due to the death of a family member. It outlines the amount of paid and unpaid leave available and the required documentation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave\"\n}"}
