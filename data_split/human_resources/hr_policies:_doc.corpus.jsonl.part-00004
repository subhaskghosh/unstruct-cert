{"_id": "human_resources--hr_policies:_doc--n--67622", "text": "{\n    \"policy_id\": \"LEGAL-COMP-005\",\n    \"policy_title\": \"Compliance with Sarbanes-Oxley Act\",\n    \"policy_description\": \"This policy details the company's compliance procedures regarding the Sarbanes-Oxley Act of 2002. It includes complex legal jargon and specific requirements for financial reporting.  It is intended for a limited audience within the Finance department.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/sox-compliance-policy\"\n}"}
