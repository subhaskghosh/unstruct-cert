{"_id": "human_resources--hr_policies:_doc--p--67879", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision plans. Employees can enroll during the annual open enrollment period or upon experiencing a qualifying life event. Details regarding plan options, premiums, and coverage levels can be found in the linked document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67879", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, including 401(k) contributions, vesting schedules, investment options, and loan provisions. It outlines eligibility requirements, contribution limits, and procedures for accessing retirement funds. The plan is designed to help employees save for a secure financial future. Detailed information about investment choices, fees, and risk factors are also covered. Please refer to the complete plan document for full details and consult with a financial advisor for personalized guidance. This policy also covers details related to hardship withdrawals, qualified domestic relations orders (QDROs), and beneficiary designations.  The policy covers compliance with all relevant ERISA regulations.  There are also provisions for early retirement incentives and supplemental executive retirement plans.  The policy is updated annually to reflect changes in tax law. The plan administrator is responsible for ensuring proper administration and compliance with the plan document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
