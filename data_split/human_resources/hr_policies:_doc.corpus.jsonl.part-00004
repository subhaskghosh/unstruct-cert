{"_id": "human_resources--hr_policies:_doc--n--65125", "text": "{\n    \"policy_id\": \"LEAVE-2022-005\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Details the procedures and eligibility criteria for employees requesting extended leave for medical or personal reasons. This is a comprehensive document covering all types of extended leave.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended_leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65126", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental and physical health, including gym membership discounts and access to counseling services. It aims to promote a healthy work-life balance and boost employee morale.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65126", "text": "{\n    \"policy_id\": \"LEGL-001\",\n    \"policy_title\": \"Comprehensive Legal Compliance Guide\",\n    \"policy_description\": \"A detailed document covering all legal aspects of HR, including employment law, data privacy, and discrimination. It is intended for legal counsel and HR professionals.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-01-05\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal-compliance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65127", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, and vision benefits available to all eligible employees, emphasizing preventative care and employee wellbeing.\",\n    \"effective_date\": \"2022-11-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65127", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for submitting and receiving reimbursement for employee travel expenses.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65128", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the resources available to employees to support their mental and emotional well-being, including confidential counseling services and stress management programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65128", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Leave of Absence Procedures\",\n    \"policy_description\": \"Detailed procedures for all types of leave of absence, including medical leave, parental leave, and personal leave, with extensive documentation requirements and eligibility criteria.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\",\n        \"Operations\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_of_absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65129", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for mental health, physical fitness, and financial wellness. It details eligibility, program benefits, and how to access available resources. This promotes a positive work-life balance and supports employee career development through skill-building workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65129", "text": "{\n    \"policy_id\": \"TRA-012\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business travel expenses, including allowable costs, documentation requirements, and approval processes. It covers transportation, lodging, meals, and other incidental expenses.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65130", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details all employee benefits including health insurance, retirement plans, paid time off, and wellness programs. It aims to attract and retain top talent by offering a competitive benefits package.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits.pdf\"\n}"}
