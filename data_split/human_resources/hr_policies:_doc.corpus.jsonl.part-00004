{"_id": "human_resources--hr_policies:_doc--p--64839", "text": "{\n    \"policy_id\": \"PTO-2023-001\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize paid time off, including vacation, sick leave, and personal days. It covers eligibility requirements, accrual rates, request procedures, and approval processes. Detailed information is available in the linked document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64839", "text": "{\n    \"policy_id\": \"TRAV-2022-005\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to submit and receive reimbursement for business travel expenses, including transportation, lodging, and meals. It covers pre-approval requirements, expense reporting deadlines, and allowable expense limits.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy_2022.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64840", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines all benefits available to employees, including health insurance, retirement plans, paid time off, and employee assistance programs. Detailed eligibility requirements and enrollment procedures are included. It aims to attract and retain top talent by offering a competitive and supportive benefits structure.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/package-details\"\n}"}
