{"_id": "human_resources--hr_policies:_doc--p--68482", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines all employee benefits, including health insurance, retirement plans, paid time off, and wellness programs. It aims to provide employees with a comprehensive support system to ensure their well-being and productivity.\",\n    \"effective_date\": \"2023-06-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/package-details\"\n}"}
