{"_id": "human_resources--hr_policies:_doc--p--71717", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. This policy emphasizes mental health and overall wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71717", "text": "{\n    \"policy_id\": \"IT-SEC-002\",\n    \"policy_title\": \"Data Security Protocol\",\n    \"policy_description\": \"Outlines the procedures for protecting sensitive company data and maintaining a secure IT infrastructure. Covers all aspects of data handling, access controls, and incident response.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Security\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/data_security_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71718", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for mental and physical health. It includes details on gym reimbursements, mindfulness workshops, and employee assistance programs.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71718", "text": "{\n    \"policy_id\": \"WB-2022-002\",\n    \"policy_title\": \"Ergonomic Assessment Guidelines\",\n    \"policy_description\": \"Details the process for requesting and receiving ergonomic assessments for workstations to prevent repetitive strain injuries.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-01-05\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/ergonomics-guidelines-2022\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71719", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health. It covers gym membership discounts, mental health support, and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71719", "text": "{\n    \"policy_id\": \"EB-2022-005\",\n    \"policy_title\": \"Severance and Termination Benefits\",\n    \"policy_description\": \"This policy details the benefits available to employees upon termination of employment, including severance pay and continuation of health insurance. It also covers eligibility criteria and procedures for requesting severance.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/severance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71720", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, paid time off, and wellness programs. It aims to support employee well-being and work-life balance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-v2.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71720", "text": "{\n    \"policy_id\": \"REMOTE-WORK-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for employees working remotely, including eligibility, equipment, and security requirements.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71721", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding health, dental, and vision insurance coverage for employees.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71721", "text": "{\n    \"policy_id\": \"EMP-RET-005\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Information about the company's 401k retirement savings plan.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71722", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee 401k Matching Program\",\n    \"policy_description\": \"This policy outlines the company's 401k matching contribution program, designed to help employees save for retirement.  The company matches 50% of employee contributions up to 6% of their salary. Eligibility requires at least 6 months of service. Details on investment options and withdrawal procedures are available in the full policy document.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71722", "text": "{\n    \"policy_id\": \"EB-2022-005\",\n    \"policy_title\": \"Comprehensive Health Insurance Benefits\",\n    \"policy_description\": \"This document details the full range of health insurance benefits offered to employees, including medical, dental, and vision coverage. It includes information on plan options, premiums, deductibles, co-pays, and out-of-pocket maximums.  Coverage is available for employees and eligible dependents. A detailed explanation of each benefit plan is provided. This policy also covers mental health benefits, prescription drug coverage, and wellness programs. Please refer to the attached appendices for specific plan details. This document also includes information on COBRA and HIPAA regulations.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71723", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Employee Health Insurance Benefits\",\n    \"policy_description\": \"Details coverage options for medical, dental, and vision care. Includes information on premium contributions and provider networks.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71723", "text": "{\n    \"policy_id\": \"BNF-2022-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401(k) plan, including eligibility requirements, contribution limits, vesting schedules, investment options, and loan provisions. It also covers information regarding withdrawals, rollovers, and beneficiary designations.  This plan is designed to help employees save for their retirement and build financial security. The plan includes a matching contribution from the company, up to a certain percentage of the employee's salary.  Employees are encouraged to participate in the plan and take advantage of the opportunities it offers to build a comfortable retirement. Detailed information on investment options can be found in the plan document.  Contact HR for assistance with enrollment or any questions regarding the plan. The plan complies with all applicable federal and state regulations. Periodic updates and amendments will be communicated to all participants.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71724", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding health insurance coverage for employees, including eligibility, plan options, and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-07-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
