{"_id": "human_resources--hr_policies:_doc--p--70517", "text": "{\n    \"policy_id\": \"WFH-2023-SM\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and adjusted hours, for employees in the Sales and Marketing departments. It aims to improve work-life balance and productivity. It does not cover compensation details.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wfh-sales-marketing-2023\"\n}"}
