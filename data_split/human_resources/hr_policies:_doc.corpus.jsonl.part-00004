{"_id": "human_resources--hr_policies:_doc--p--64060", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides employees with 16 weeks of paid parental leave, exceeding the minimum legal requirements. It aims to support employees in balancing work and family life.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/parental-leave-policy\"\n}"}
