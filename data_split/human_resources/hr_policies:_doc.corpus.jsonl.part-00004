{"_id": "human_resources--hr_policies:_doc--n--61808", "text": "{\n    \"policy_id\": \"PTO-ALL-2022\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the accrual rates, usage guidelines, and request procedures for paid time off for all employees. Comprehensive rules and stipulations apply.  It covers vacation, sick leave, and personal days. Extensive documentation regarding state-specific requirements and departmental approval processes are included.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy\"\n}"}
