{"_id": "human_resources--hr_policies:_doc--n--64511", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program designed to foster leadership skills among high-potential employees, encompassing mentoring, workshops, and project assignments. Detailed guidelines are included regarding eligibility, program duration, and evaluation criteria.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
