{"_id": "human_resources--hr_policies:_doc--p--67490", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. The plan offers a choice of providers and flexible coverage options to meet individual needs.  We strive to make this as straightforward as possible.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67490", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"401(k) Retirement Savings Plan\",\n    \"policy_description\": \"This document details the provisions of the company's 401(k) retirement savings plan, including eligibility requirements, contribution limits (IRC Section 401(k)(11)), vesting schedules, investment options, and loan provisions.  Details are provided regarding RMDs and associated compliance requirements.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k-plan\"\n}"}
