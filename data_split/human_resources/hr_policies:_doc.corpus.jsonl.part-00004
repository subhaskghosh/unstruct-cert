{"_id": "human_resources--hr_policies:_doc--n--67555", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Comprehensive Benefits Package - Legal Review\",\n    \"policy_description\": \"Detailed legal documentation outlining the complexities of the comprehensive benefits package, including ACA compliance, ERISA regulations, and fiduciary responsibilities. This document is intended for HR specialists and legal counsel.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-legal.pdf\"\n}"}
