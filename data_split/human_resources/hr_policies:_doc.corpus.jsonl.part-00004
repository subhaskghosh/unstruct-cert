{"_id": "human_resources--hr_policies:_doc--n--67396", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the full scope of health insurance coverage available to employees, including details on deductibles, co-pays, network providers, out-of-network coverage, prescription drug benefits, and the appeals process. It also covers special enrollment periods, continuation of benefits, and employee responsibilities. This policy is a comprehensive guide to all aspects of health insurance offered by the company, including preventative care, mental health services, and emergency care. The policy also includes detailed information regarding the company's commitment to complying with all applicable laws and regulations, and provides contact information for assistance with any questions or concerns.  A full listing of covered services can be found in the attached appendix.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance.pdf\"\n}"}
