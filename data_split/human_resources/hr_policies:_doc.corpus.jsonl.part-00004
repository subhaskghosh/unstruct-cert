{"_id": "human_resources--hr_policies:_doc--n--68546", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Employee Compensation and Legal Compliance\",\n    \"policy_description\": \"This policy details employee compensation structures, including base salary, bonuses, and stock options. It also addresses legal requirements related to wage and hour laws and potential litigation arising from compensation disputes.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Legal\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
