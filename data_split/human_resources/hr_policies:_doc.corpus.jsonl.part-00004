{"_id": "human_resources--hr_policies:_doc--p--62666", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and adjusted hours, designed to support employee work-life balance and productivity. It aims to provide employees with greater flexibility while maintaining business needs.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-arrangement-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62666", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance plan available to all full-time employees. It covers medical, dental, and vision care, and includes information on eligibility, enrollment, and coverage details. This is a very detailed document with many clauses and requirements.  It is a substantial and complex policy covering a wide array of health-related benefits and provider networks, ensuring employees have access to quality healthcare services.  The policy includes detailed sections on preventative care, emergency services, prescription drug coverage, and mental health resources.  Specific attention is given to understanding the annual open enrollment process and navigating the healthcare marketplace.  The policy also outlines procedures for submitting claims, appealing denials, and understanding employee cost-sharing responsibilities.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62667", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, vision, and wellness programs available to all eligible employees. It emphasizes preventative care and resources for maintaining a healthy lifestyle.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62667", "text": "{\n    \"policy_id\": \"TRAV-0017\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to request reimbursement for business-related travel expenses.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement\"\n}"}
