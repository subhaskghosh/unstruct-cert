{"_id": "human_resources--hr_policies:_doc--p--69021", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for eligible employees. It covers eligibility criteria, equipment requirements, security protocols, and performance expectations for remote workers. The purpose is to provide a flexible work environment while maintaining productivity and data security.  Details on claiming home office expenses are also provided.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69021", "text": "{\n    \"policy_id\": \"VL-2022-005\",\n    \"policy_title\": \"Vacation Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking vacation leave. Employees are entitled to a certain number of vacation days per year based on their tenure with the company. Requests must be submitted through the HR portal and approved by their manager. Unused vacation days may be carried over to the next year, subject to certain limitations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation_leave_policy.pdf\"\n}"}
