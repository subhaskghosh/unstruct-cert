{"_id": "human_resources--hr_policies:_doc--p--67401", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, eligibility requirements, enrollment procedures, and cost-sharing arrangements. It also covers information on pre-existing conditions, claims processing, and appeals. This policy is reviewed annually to ensure compliance with relevant regulations and to provide competitive benefits to our employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
