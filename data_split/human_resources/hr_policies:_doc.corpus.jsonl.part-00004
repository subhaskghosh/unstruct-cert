{"_id": "human_resources--hr_policies:_doc--p--62757", "text": "{\n    \"policy_id\": \"BEN-WEL-2023-01\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through access to gym memberships, mental health resources, and annual health screenings. The goal is to promote a healthy work-life balance and reduce healthcare costs. Reimbursement details are available in the linked document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_benefit_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62757", "text": "{\n    \"policy_id\": \"BEN-RET-2022-05\",\n    \"policy_title\": \"Retirement Savings Plan - 401k\",\n    \"policy_description\": \"Detailed explanation of the 401k retirement savings plan including eligibility, contribution limits, investment options, vesting schedules, loan provisions, and procedures for withdrawal. This plan is administered by Fidelity Investments and provides employees with a valuable tool for long-term financial security. Comprehensive documentation covering all aspects of the plan is provided at the following URL.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_plan_details.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62758", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, covering gym memberships, mental health resources, and preventative care. It aligns with current trends in holistic employee benefits.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
