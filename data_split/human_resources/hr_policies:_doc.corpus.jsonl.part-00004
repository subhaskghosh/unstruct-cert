{"_id": "human_resources--hr_policies:_doc--p--65265", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for physical, mental, and financial health. It includes access to counseling services, gym memberships, and financial planning workshops.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65265", "text": "{\n    \"policy_id\": \"LEAVE-2023-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"Details regarding the allocation and usage of sick leave for employees.  Requires detailed medical documentation for absences exceeding three days.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65266", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to promoting employee health and well-being through preventative programs, resources, and support. It covers mental health, physical fitness, and financial wellness.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
