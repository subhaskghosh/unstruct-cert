{"_id": "human_resources--hr_policies:_doc--p--70444", "text": "{\n    \"policy_id\": \"WB-SLS-MKT-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health support, physical fitness, and work-life balance. It details available benefits, programs, and employee responsibilities for participation.  We believe a healthy and supported workforce is a productive workforce. This program is designed to foster a positive work environment and reduce stress. The company will provide regular workshops and training sessions on topics related to well-being.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
