{"_id": "human_resources--hr_policies:_doc--p--62615", "text": "{\n    \"policy_id\": \"HB-2024-005\",\n    \"policy_title\": \"Employee Health Benefits Program\",\n    \"policy_description\": \"This policy outlines the health insurance options available to employees, including medical, dental, and vision coverage. It details eligibility requirements, enrollment procedures, and cost-sharing arrangements. We aim to provide comprehensive and affordable healthcare to all our valued team members.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/healthbenefits2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62615", "text": "{\n    \"policy_id\": \"HB-2023-001\",\n    \"policy_title\": \"Health and Wellness Initiative\",\n    \"policy_description\": \"A comprehensive guide detailing all aspects of employee wellness including gym memberships, mental health resources, nutritional guidance, and stress management workshops. This policy aims to foster a culture of health and well-being within the organization. It also covers detailed guidelines for preventative care, health risk assessments, and participation in wellness programs. Includes information on employee assistance programs (EAPs) and available support services. Covers eligibility, program details, and contact information for relevant resources.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellnessinitiative.pdf\"\n}"}
