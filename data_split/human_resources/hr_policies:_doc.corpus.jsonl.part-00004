{"_id": "human_resources--hr_policies:_doc--n--62461", "text": "{\n    \"policy_id\": \"CMP-0015\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Outlines the commission structure for the Sales department, including targets and payout calculations.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales-commission\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62462", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellbeing and Mental Health\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health support, stress management, and work-life balance initiatives. It promotes a supportive and inclusive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62462", "text": "{\n    \"policy_id\": \"CMP-002\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for the Sales department, including targets, payout rates, and performance metrics.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/commission-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62463", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can enroll during the annual open enrollment period or upon qualifying life events.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62463", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including eligibility requirements, contribution limits, vesting schedules, and investment options. It also covers the process for loaning from or withdrawing funds. This plan is designed to help employees prepare for a financially secure retirement. The specifics of the plan are subject to change based on market conditions and regulatory updates. The investment options available are carefully selected by a team of financial professionals. Employees are encouraged to participate in financial planning workshops to make informed decisions. The plan also includes provisions for beneficiary designations and hardship withdrawals. Furthermore, it outlines the procedures for transferring funds from other retirement accounts. Detailed information can be found in the plan document. Please read it carefully before making any investment decisions.  This document also contains information regarding qualified domestic relations orders (QDROs).\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62464", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Employee Health & Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including details on health insurance, wellness initiatives, and mental health resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62464", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Legacy Sick Leave Policy\",\n    \"policy_description\": \"Details the sick leave accrual and usage rules for employees hired before the current PTO system.\",\n    \"effective_date\": \"2018-06-01\",\n    \"last_updated\": \"2019-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick-leave-legacy.pdf\"\n}"}
