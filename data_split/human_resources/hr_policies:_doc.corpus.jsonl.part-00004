{"_id": "human_resources--hr_policies:_doc--p--64903", "text": "{\n    \"policy_id\": \"WB-2024-07-15\",\n    \"policy_title\": \"Employee Wellbeing and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including flexible work options, mental health resources, and work-life balance initiatives.\",\n    \"effective_date\": \"2024-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-flexible-work.pdf\"\n}"}
