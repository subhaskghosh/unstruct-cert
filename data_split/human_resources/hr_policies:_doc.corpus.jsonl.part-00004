{"_id": "human_resources--hr_policies:_doc--n--65243", "text": "{\n    \"policy_id\": \"LE-005\",\n    \"policy_title\": \"Legal Compliance - Data Privacy\",\n    \"policy_description\": \"Detailed guidelines on data privacy regulations, including GDPR and CCPA compliance.  Covers data collection, storage, access, and deletion procedures. This is a comprehensive legal document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy.pdf\"\n}"}
