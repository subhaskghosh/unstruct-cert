{"_id": "human_resources--hr_policies:_doc--p--71088", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including access to gym memberships, mental health resources, and annual health screenings. It is designed to promote a healthy work-life balance and improve overall employee well-being.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71088", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance plan offered to all eligible employees. It covers medical, dental, and vision care, and includes information on deductibles, co-pays, and out-of-pocket maximums.  The plan is administered by ABC Insurance and is subject to change annually based on negotiations. This is a detailed outline of the entire benefits package, including information on prescription drug coverage, specialist referrals, and emergency care procedures. Furthermore, details are included on how to appeal denied claims and understand your rights as a patient. This plan is fully compliant with all applicable federal and state regulations. Detailed provisions regarding pre-existing conditions, preventative care, and the appeals process are also covered within this document.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance.docx\"\n}"}
