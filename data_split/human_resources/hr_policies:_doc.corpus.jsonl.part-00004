{"_id": "human_resources--hr_policies:_doc--p--70192", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, and retirement plans. It emphasizes employee wellbeing and offers resources for work-life balance.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70192", "text": "{\n    \"policy_id\": \"TRA-0005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and receiving reimbursements for business-related travel expenses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70193", "text": "{\n    \"policy_id\": \"TRV-POL-2023-001\",\n    \"policy_title\": \"Travel Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for reimbursing employees for reasonable and necessary expenses incurred while traveling on company business. It covers pre-trip authorization, eligible expenses (transportation, lodging, meals), expense reporting procedures, and reimbursement timelines. Detailed provisions are provided for international travel, and adherence to this policy is mandatory for all employees and managers. This policy aims to ensure fair and consistent treatment of all employees regarding travel expenses while maintaining budgetary control.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70193", "text": "{\n    \"policy_id\": \"LEAV-POL-2022-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"Employees are entitled to a certain number of paid sick days per year, as outlined in this document. Please refer to the employee handbook for further details.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70194", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flexible start/end times, aiming to support employee work-life balance.\",\n    \"effective_date\": \"2022-11-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements.pdf\"\n}"}
