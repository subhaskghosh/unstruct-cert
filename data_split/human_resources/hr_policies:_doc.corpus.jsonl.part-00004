{"_id": "human_resources--hr_policies:_doc--p--67044", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. The policy is designed to be straightforward and easy to understand.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67044", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the executive stock option plan, including vesting schedules, exercise prices, and tax implications. The plan is highly complex and requires legal consultation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/stock-options\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67045", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, and retirement plans. It outlines eligibility requirements, enrollment procedures, and plan details. This includes information on wellness programs and employee assistance programs.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67045", "text": "{\n    \"policy_id\": \"LVE-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and taking various types of leave of absence, including sick leave, personal leave, and family leave. It covers eligibility requirements, documentation needed, and pay during leave.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/leave_of_absence.pdf\"\n}"}
