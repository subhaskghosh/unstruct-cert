{"_id": "human_resources--hr_policies:_doc--n--67799", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"A comprehensive document detailing executive compensation structures, including base salaries, bonuses, stock options, restricted stock units, and long-term incentive plans. This policy also addresses the vesting schedules and performance criteria associated with equity grants. It further outlines the processes for amending and terminating executive compensation agreements. Detailed legal reviews are attached as appendices. It also covers deferred compensation plans, severance agreements, and change-in-control provisions, alongside an in-depth analysis of tax implications for both the company and the executive recipients.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/executive-compensation\"\n}"}
