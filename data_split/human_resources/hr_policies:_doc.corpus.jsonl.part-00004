{"_id": "human_resources--hr_policies:_doc--p--65954", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Stress Management\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources and guidelines for managing workplace stress. It includes information on access to mental health services, flexible work arrangements, and stress reduction workshops.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy\"\n}"}
