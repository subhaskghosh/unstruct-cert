{"_id": "human_resources--hr_policies:_doc--p--68316", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"Details the company's employee wellness benefits, including gym memberships and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
