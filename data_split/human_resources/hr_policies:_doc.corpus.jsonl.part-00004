{"_id": "human_resources--hr_policies:_doc--p--67549", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees seeking flexible work arrangements, including remote work, adjusted hours, and compressed workweeks, designed to support work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67549", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Employee Compensation Review Policy\",\n    \"policy_description\": \"This policy details the process for annual employee performance reviews and subsequent compensation adjustments. It outlines eligibility criteria, review timelines, and performance metrics.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-review.pdf\"\n}"}
