{"_id": "human_resources--hr_policies:_doc--p--67849", "text": "{\n    \"policy_id\": \"BP-2023-08-01\",\n    \"policy_title\": \"Sales Commission Structure & Bonus Policy\",\n    \"policy_description\": \"This policy outlines the commission structure for the Sales department and details bonus eligibility criteria based on performance metrics. It includes details on quarterly targets, payout schedules, and dispute resolution processes. It was revised to align with updated market compensation standards.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_policy.pdf\"\n}"}
