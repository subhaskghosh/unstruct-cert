{"_id": "human_resources--hr_policies:_doc--p--68581", "text": "{\n    \"policy_id\": \"WB-2023-101\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness programs, and flexible work arrangements. It aims to promote a healthy work-life balance and reduce employee stress.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68581", "text": "{\n    \"policy_id\": \"WFH-2022-050\",\n    \"policy_title\": \"Work From Home Policy\",\n    \"policy_description\": \"This policy details the procedures and guidelines for employees requesting to work from home, including eligibility requirements, equipment provisioning, and security protocols.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/wfh_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68582", "text": "{\n    \"policy_id\": \"EMP-DEV-2023-005\",\n    \"policy_title\": \"Employee Professional Development Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee growth through training, mentorship, and educational opportunities. It covers eligibility, application procedures, and reimbursement guidelines.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp_dev_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68582", "text": "{\n    \"policy_id\": \"EMP-BEN-2022-010\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"Details the health insurance, wellness programs, and employee assistance programs available to all employees. Includes information on coverage, eligibility, and claims procedures. Requires extensive form filling and approvals.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68583", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Mental Health and Wellbeing\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental health and wellbeing. It provides resources for counseling, stress management, and work-life balance. It also details procedures for requesting accommodations related to mental health conditions.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-2023-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68583", "text": "{\n    \"policy_id\": \"LOA-2022-010\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking leaves of absence, including medical leave, personal leave, and bereavement leave. It also covers the impact of leave on benefits and compensation.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/loa-2022-010.pdf\"\n}"}
