{"_id": "human_resources--hr_policies:_doc--p--62725", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Spending Account (FSA) Guidelines\",\n    \"policy_description\": \"Detailed guidelines for utilizing Flexible Spending Accounts for eligible medical and dependent care expenses. Promotes employee well-being and financial flexibility.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/fsa-guidelines\"\n}"}
