{"_id": "human_resources--hr_policies:_doc--p--65154", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Remote Work Benefit Eligibility\",\n    \"policy_description\": \"This policy outlines the benefits available to employees working remotely, including home office allowances and internet reimbursement. It aims to provide equitable benefits regardless of work location and supports a flexible work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65154", "text": "{\n    \"policy_id\": \"LEGAL-COMP-012\",\n    \"policy_title\": \"Compliance with ERISA and ACA Regulations\",\n    \"policy_description\": \"This comprehensive document details the organization's adherence to the Employee Retirement Income Security Act (ERISA) and the Affordable Care Act (ACA), outlining fiduciary responsibilities, reporting requirements, and legal disclaimers. It covers detailed regulatory interpretations and potential liabilities.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Finance\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/erisa-aca-compliance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65155", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental and physical health. It includes details about gym reimbursements, mindfulness workshops, and employee assistance programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65155", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking extended leaves of absence, including medical leave, parental leave, and personal leave. It encompasses eligibility criteria, required documentation, and impact on benefits.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65156", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing access to resources for physical and mental health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65156", "text": "{\n    \"policy_id\": \"LE-002\",\n    \"policy_title\": \"Legal Compliance and Risk Management\",\n    \"policy_description\": \"A comprehensive document detailing legal obligations and risk mitigation strategies for the organization, including sections on data privacy, intellectual property, and regulatory adherence.  Extensive details on legal procedures and compliance reporting.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-01-05\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal-compliance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65157", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the details of the company-sponsored health insurance plan, including coverage, premiums, and eligibility requirements.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65157", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and reimbursing business travel expenses.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65158", "text": "{\n    \"policy_id\": \"WELLB-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources for mental health, physical fitness, and stress management. It aims to create a supportive work environment and improve employee morale.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\",\n        \"Public Relations\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65158", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Annual Salary Review and Compensation Guidelines\",\n    \"policy_description\": \"Details the process for annual salary reviews, bonus eligibility, and overall compensation structure. Includes guidelines for performance-based pay increases and equity awards.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65159", "text": "{\n    \"policy_id\": \"WB-2024-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources for mental and physical health. It covers topics like stress management, healthy eating, and access to wellness programs.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65159", "text": "{\n    \"policy_id\": \"LOA-2023-010\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving extended leaves of absence for various reasons, including medical leave, family care, and personal reasons. It contains detailed legal and compliance information, and specific requirements for documentation and benefits continuation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65160", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It provides clear details on coverage levels, co-pays, and provider networks. The language is designed to be simple and easy to understand.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65160", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details regarding employee contributions, company matching, and investment options for the 401k retirement savings plan. Complex financial jargon may be present.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan-document\"\n}"}
