{"_id": "human_resources--hr_policies:_doc--p--62057", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Benefits Enrollment & Usage\",\n    \"policy_description\": \"Details enrollment procedures, coverage options, and usage guidelines for all employee benefits including health insurance, retirement plans, and paid time off. This policy aims to provide a comprehensive overview of available benefits and support employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_policy_v2.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62057", "text": "{\n    \"policy_id\": \"EMP-BNF-005\",\n    \"policy_title\": \"Remote Work Benefit Stipend\",\n    \"policy_description\": \"Provides a stipend for remote employees to set up their home offices. Limited to a one-time payment.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote_work_stipend.pdf\"\n}"}
