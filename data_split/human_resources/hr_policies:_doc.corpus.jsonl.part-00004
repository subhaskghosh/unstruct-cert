{"_id": "human_resources--hr_policies:_doc--n--70407", "text": "{\n    \"policy_id\": \"EMP-LEAVE-001\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures and eligibility requirements for employees requesting an extended leave of absence. It covers various scenarios, including medical leave, family leave, and personal leave, adhering to all federal and state regulations.  It is a comprehensive document covering all potential scenarios and legal requirements impacting employee leave.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
