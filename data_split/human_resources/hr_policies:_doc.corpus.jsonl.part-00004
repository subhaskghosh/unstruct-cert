{"_id": "human_resources--hr_policies:_doc--p--67428", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all full-time employees. Coverage includes medical, dental, and vision. Details regarding eligibility, enrollment, and plan options are provided in the policy document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67428", "text": "{\n    \"policy_id\": \"BP-2022-010\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This policy governs the compensation structure for executive-level employees, including base salary, performance bonuses, stock options, and restricted stock units. The policy details the eligibility criteria, grant schedules, and vesting provisions for equity awards. It aims to align executive compensation with company performance and long-term shareholder value. Complex calculations and legal considerations are included.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-policy\"\n}"}
