{"_id": "human_resources--hr_policies:_doc--n--65379", "text": "{\n    \"policy_id\": \"LEG-COMP-002\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"This policy outlines the company's compliance procedures with the Employee Retirement Income Security Act (ERISA). It is a highly technical document detailing legal requirements and reporting obligations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leg-comp-002.pdf\"\n}"}
