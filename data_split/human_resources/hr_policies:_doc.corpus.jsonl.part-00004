{"_id": "human_resources--hr_policies:_doc--n--62538", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This detailed policy provides comprehensive guidelines for employee travel arrangements, expense reporting, and reimbursement procedures. It covers all aspects of business travel, including booking flights and hotels, claiming expenses, and adhering to budget limitations. This includes advanced travel booking requirements, per diem rates, acceptable receipts, and audit procedures. This policy aims to ensure compliance with company financial regulations and to manage travel costs effectively.\",\n    \"effective_date\": \"2023-02-01\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement\"\n}"}
