{"_id": "human_resources--hr_policies:_doc--p--71855", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the company's health insurance, retirement plans, and wellness programs designed to support employee well-being. It includes details on medical, dental, vision, and 401k options, as well as resources for mental health and stress management.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71855", "text": "{\n    \"policy_id\": \"EXP-002\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit and receive reimbursement for business-related travel expenses, including transportation, lodging, and meals.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-08-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71856", "text": "{\n    \"policy_id\": \"EMP-BNF-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees, including details on coverage, premiums, and enrollment procedures. It also details options for family coverage and wellness programs. This policy is intended to support employee well-being and attract/retain top talent.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71856", "text": "{\n    \"policy_id\": \"VAC-POL-001\",\n    \"policy_title\": \"Vacation Time Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking vacation time. Employees are entitled to a certain number of vacation days per year based on their length of service.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation-time-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71857", "text": "{\n    \"policy_id\": \"WB-2023-01\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various programs and resources, focusing on preventative measures like stress management workshops and flexible work arrangements to promote work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy-2023-01\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71857", "text": "{\n    \"policy_id\": \"LEAVE-2022-05\",\n    \"policy_title\": \"Sick Leave and Absence Management\",\n    \"policy_description\": \"This policy details the procedures for employees requesting sick leave or other absences due to illness. It focuses on documenting absences and processing leave requests according to legal requirements.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave-policy-2022-05\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71858", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym membership reimbursements, mental health resources, and annual health screenings. Details on eligibility and reimbursement procedures are provided. This program is designed to support a healthy and productive workforce.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71858", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Health Insurance Plan Details\",\n    \"policy_description\": \"This comprehensive document details all aspects of the company's health insurance plan, including coverage levels, provider networks, claim submission processes, and pre-authorization requirements. It covers medical, dental, and vision benefits, and outlines employee responsibilities. It contains a detailed glossary of terms, a schedule of benefits, and information about wellness programs. This document also includes information regarding COBRA and HIPAA regulations. Extensive appendices with detailed provider information are included. This is a long and complex document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71859", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"Details the company's commitment to employee health and wellbeing, including gym membership discounts and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71859", "text": "{\n    \"policy_id\": \"TR-2015-005\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Outlines the procedures for claiming travel expenses, including detailed requirements for receipts and approvals.\",\n    \"effective_date\": \"2015-07-01\",\n    \"last_updated\": \"2018-11-08\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement\"\n}"}
