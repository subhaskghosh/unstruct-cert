{"_id": "human_resources--hr_policies:_doc--p--61677", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Health Benefits Plan\",\n    \"policy_description\": \"This policy details the health, dental, and vision benefits available to all eligible employees. It covers eligibility, enrollment procedures, plan options, and cost-sharing details. It also outlines procedures for claiming benefits and appeals processes.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/healthplan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61677", "text": "{\n    \"policy_id\": \"TRAV-EXP-001\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for business-related travel and expenses. It covers allowable expenses, documentation requirements, and reimbursement timelines.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense.pdf\"\n}"}
