{"_id": "human_resources--hr_policies:_doc--p--61767", "text": "{\n    \"policy_id\": \"POL-2023-005\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the guidelines for employee travel, including expense reimbursement, booking procedures, and safety protocols. It emphasizes the well-being of employees while traveling on company business.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
