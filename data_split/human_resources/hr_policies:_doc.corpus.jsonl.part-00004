{"_id": "human_resources--hr_policies:_doc--p--68004", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It covers plan options, enrollment procedures, and associated costs. Additionally, it details the company's wellness program and resources for employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits.pdf\"\n}"}
