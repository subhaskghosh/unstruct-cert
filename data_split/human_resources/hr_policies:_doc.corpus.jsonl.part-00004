{"_id": "human_resources--hr_policies:_doc--n--68623", "text": "{\n    \"policy_id\": \"LEGAL-COMP-002\",\n    \"policy_title\": \"Compliance with FMLA and Leave Regulations\",\n    \"policy_description\": \"A comprehensive guide detailing the company’s adherence to the Family and Medical Leave Act (FMLA) and other federal and state leave regulations.  This document covers eligibility requirements, notification procedures, and employee rights under applicable laws. It also addresses interactions with state-specific leave laws and potential legal ramifications of non-compliance. It details complex interaction between different jurisdictions and employee classifications. \",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/fmla-compliance.pdf\"\n}"}
