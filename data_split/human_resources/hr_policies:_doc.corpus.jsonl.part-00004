{"_id": "human_resources--hr_policies:_doc--n--71917", "text": "{\n    \"policy_id\": \"LVT-2022-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This comprehensive policy details all types of leave available to employees, including vacation, sick leave, parental leave, and personal leave. It covers eligibility requirements, application processes, and accrual rates. This policy is subject to federal, state, and local laws and is reviewed annually to ensure compliance.\",\n    \"effective_date\": \"2022-12-20\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71918", "text": "{\n    \"policy_id\": \"BEN-401K-2024\",\n    \"policy_title\": \"401(k) Retirement Savings Plan\",\n    \"policy_description\": \"This policy outlines the company's 401(k) plan, including eligibility, contribution limits, vesting schedules, and investment options. It is designed to help employees save for their retirement and achieve long-term financial security.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k_plan_document.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71918", "text": "{\n    \"policy_id\": \"ADM-LEAVE-2023\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing sick leave, including documentation requirements and notification protocols. It covers all full-time and part-time employees.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/admin/sick_leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71919", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, dental insurance, vision insurance, paid time off, parental leave, and retirement savings plans. It details eligibility requirements, enrollment procedures, and coverage details for each benefit.  It also includes information on wellness programs and resources available to promote employee health and well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71919", "text": "{\n    \"policy_id\": \"TRAV-0005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for reasonable and necessary travel expenses incurred while conducting company business. It covers travel arrangements, expense reporting, and reimbursement rates.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71920", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, offering resources for mental health, physical fitness, and financial wellness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71920", "text": "{\n    \"policy_id\": \"EXP-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel-related expenses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71921", "text": "{\n    \"policy_id\": \"WB-2023-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and improve overall well-being.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71921", "text": "{\n    \"policy_id\": \"BA-2023-012\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the procedures for employees to enroll in and manage their health insurance benefits.\",\n    \"effective_date\": \"2023-10-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71922", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellbeing and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through flexible work arrangements, mental health resources, and wellness programs. We aim to create a supportive environment where employees can thrive both professionally and personally.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71922", "text": "{\n    \"policy_id\": \"LEGL-2022-010\",\n    \"policy_title\": \"Non-Disclosure and Confidentiality Agreement\",\n    \"policy_description\": \"This legally binding agreement details the terms and conditions regarding the protection of company confidential information.  All employees are required to review and acknowledge the terms outlined herein.  Violation of this agreement may result in disciplinary action, up to and including termination of employment.  Specific clauses address intellectual property, trade secrets, and proprietary data.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71923", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"Details the comprehensive health, dental, and vision benefits available to employees, including wellness program participation guidelines.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71923", "text": "{\n    \"policy_id\": \"DIS-0005\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"Outlines the process for addressing employee misconduct and performance issues.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary/procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71924", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy outlines the enhanced parental leave benefits available to all eligible employees, including paid leave and flexible return-to-work options. It aims to support employees during a significant life event and promote work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71924", "text": "{\n    \"policy_id\": \"EMP-DISC-001\",\n    \"policy_title\": \"Disciplinary Action and Performance Improvement\",\n    \"policy_description\": \"This policy details the procedures for addressing employee performance issues, including verbal warnings, written warnings, and potential termination. It aims to ensure fair and consistent treatment of all employees.\",\n    \"effective_date\": \"2022-12-20\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary-action\"\n}"}
