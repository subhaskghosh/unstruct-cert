{"_id": "human_resources--hr_policies:_doc--p--68106", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees experiencing personal or work-related challenges, promoting mental and emotional well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68106", "text": "{\n    \"policy_id\": \"EL-2022-010\",\n    \"policy_title\": \"Executive Compensation Guidelines\",\n    \"policy_description\": \"Outlines the compensation structure and performance-based incentives for senior leadership positions.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-comp-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68107", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health, providing details on health insurance coverage, wellness initiatives, and mental health resources. It encourages preventative care and a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68107", "text": "{\n    \"policy_id\": \"EXEC-COMP-001\",\n    \"policy_title\": \"Executive Equity and Bonus Plan\",\n    \"policy_description\": \"This policy details the equity grants and performance-based bonuses awarded to executive-level employees, including stock options and restricted stock units. It outlines vesting schedules and performance criteria.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive_compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68108", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding employee health insurance coverage, including eligibility, premiums, and claims procedures. This policy promotes employee well-being and provides access to quality healthcare.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68108", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Employee Benefits and Termination Procedures\",\n    \"policy_description\": \"This policy outlines employee benefits packages and the procedures to be followed during employee termination. It details final paychecks, COBRA continuation, and other post-employment benefits.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/termination-benefits.pdf\"\n}"}
