{"_id": "human_resources--hr_policies:_doc--n--71428", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Comprehensive Employee Compliance Guidelines\",\n    \"policy_description\": \"This comprehensive document details all aspects of employee compliance, including data protection, anti-harassment, and ethical conduct.  It includes legal disclaimers and intricate details regarding regulatory requirements.  This policy requires mandatory annual training for all employees. Lengthy and detailed legal information regarding employee conduct is covered here.\",\n    \"effective_date\": \"2023-06-10\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Human Resources\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/compliance-guidelines.pdf\"\n}"}
