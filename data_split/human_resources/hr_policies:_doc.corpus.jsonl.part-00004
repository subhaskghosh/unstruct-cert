{"_id": "human_resources--hr_policies:_doc--p--64040", "text": "{\n    \"policy_id\": \"BEN-401K-2024\",\n    \"policy_title\": \"401(k) Retirement Savings Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401(k) retirement savings plan, including eligibility, contribution limits, vesting schedules, and investment options. It's designed to support employees' long-term financial security.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k-policy.pdf\"\n}"}
