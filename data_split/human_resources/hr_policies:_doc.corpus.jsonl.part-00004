{"_id": "human_resources--hr_policies:_doc--n--71280", "text": "{\n    \"policy_id\": \"RET-001\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"This policy details the company's 401k retirement savings plan, including contribution matching, vesting schedules, and investment options. Eligibility is based on years of service and full-time status.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71281", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health, covering medical, dental, and vision benefits. It promotes preventative care and well-being initiatives.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71281", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the leadership development program offered to employees at the manager level and above. It includes training opportunities, mentorship programs, and career path guidance. It is a very extensive program.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71282", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources and support for physical and mental health. It covers gym memberships, stress management workshops, and employee assistance programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
