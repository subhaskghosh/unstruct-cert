{"_id": "human_resources--hr_policies:_doc--p--64107", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Retirement Savings Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401(k) plan, including eligibility, contribution limits, and vesting schedule. It's designed to help employees save for retirement and secure their financial future.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64107", "text": "{\n    \"policy_id\": \"EMP-TRA-012\",\n    \"policy_title\": \"Professional Development Reimbursement\",\n    \"policy_description\": \"This policy describes the procedures for employees to request reimbursement for approved professional development courses and certifications.  It aims to enhance employee skills and contribute to career growth.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/professional-development\"\n}"}
