{"_id": "human_resources--hr_policies:_doc--n--65146", "text": "{\n    \"policy_id\": \"PER-005\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"A comprehensive guide to the annual performance review process, including goal setting, self-assessment, manager feedback, and performance improvement plans. This document outlines the steps, timelines, and expectations for both employees and managers. It also details the process for handling performance issues and provides resources for professional development.  Detailed information on appeals process included.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-reviews\"\n}"}
