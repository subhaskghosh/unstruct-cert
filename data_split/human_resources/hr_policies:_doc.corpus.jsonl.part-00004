{"_id": "human_resources--hr_policies:_doc--n--62660", "text": "{\n    \"policy_id\": \"REM-001\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy outlines the guidelines and requirements for employees requesting to work remotely, including eligibility criteria, equipment provisioning, and performance expectations.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62661", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness benefits available to all eligible employees, including gym memberships, mental health resources, and preventative care options.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefit-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62661", "text": "{\n    \"policy_id\": \"TRAV-0011\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"Details the process for submitting and reimbursing travel expenses for business trips. Strict adherence to pre-approved budgets is required.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62662", "text": "{\n    \"policy_id\": \"EB-2024-007\",\n    \"policy_title\": \"Employee 401k Contribution Matching\",\n    \"policy_description\": \"Details the company's policy on matching employee contributions to the 401k retirement savings plan.  This aims to support employees' financial wellbeing.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k_matching.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62662", "text": "{\n    \"policy_id\": \"EB-2023-012\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Details the terms and conditions for stock options granted to executive-level employees. Includes complex vesting schedules and legal disclaimers.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
