{"_id": "human_resources--hr_policies:_doc--p--61505", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Life & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive life and wellness benefits available to all eligible employees, including life insurance, disability coverage, and employee assistance programs. It provides support during difficult life events such as illness, family loss, and financial hardship.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/life_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61505", "text": "{\n    \"policy_id\": \"TRAV-0011\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and reimbursing employee travel expenses. It covers airfare, lodging, meals, and other travel-related costs.\",\n    \"effective_date\": \"2023-01-05\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense_reimbursement.pdf\"\n}"}
