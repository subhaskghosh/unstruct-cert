{"_id": "human_resources--hr_policies:_doc--p--65482", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellbeing and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the resources and support available to employees to promote their mental and emotional wellbeing. It includes details on counseling services, stress management workshops, and a confidential reporting mechanism.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Account Management\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-2023-005\"\n}"}
