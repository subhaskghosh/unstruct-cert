{"_id": "human_resources--hr_policies:_doc--p--67996", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines comprehensive health insurance benefits available to all eligible employees, including medical, dental, and vision coverage. It emphasizes employee well-being and provides multiple plan options to suit individual needs. We strive to provide affordable and high-quality healthcare to all our team members.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67996", "text": "{\n    \"policy_id\": \"EMP-LEAV-001\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing sick leave. Employees are entitled to a certain number of sick days per year, as outlined in the policy document. Usage of sick leave must be approved by the employee's manager.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick-leave.pdf\"\n}"}
