{"_id": "human_resources--hr_policies:_doc--p--61355", "text": "{\n    \"policy_id\": \"RW-2023-10-27\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for remote work arrangements, including eligibility, equipment, security, and performance expectations. It significantly expands remote work options for eligible employees.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61355", "text": "{\n    \"policy_id\": \"WFH-2022-05-10\",\n    \"policy_title\": \"Work From Home Protocol\",\n    \"policy_description\": \"A brief overview of the work from home protocol during inclement weather conditions. Primarily focuses on IT security concerns.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/wfh-protocol\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61356", "text": "{\n    \"policy_id\": \"CMP-BNF-2023-001\",\n    \"policy_title\": \"Sales Commission and Bonus Plan\",\n    \"policy_description\": \"Details the commission structure and bonus eligibility for Sales team members, aligning with company performance and individual achievements. Includes information on benefits related to achieving sales targets.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61356", "text": "{\n    \"policy_id\": \"GEN-POL-2022-005\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"Outlines the guidelines for remote work arrangements, including eligibility criteria, security protocols, and communication expectations.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work_2022.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61357", "text": "{\n    \"policy_id\": \"PTO-2023-001\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for accruing, requesting, and using paid time off (PTO) for eligible employees. It covers vacation, sick leave, and personal days.  Detailed procedures are provided, including how to submit requests, approval processes, and carryover limitations.  This is intended to be a full guide to PTO for all employees.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61357", "text": "{\n    \"policy_id\": \"SICK-2022-002\",\n    \"policy_title\": \"Sick Leave Notification\",\n    \"policy_description\": \"Employees are required to notify their manager as soon as possible if they are unable to come to work due to illness.  A brief form must be completed upon return.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick_leave_notification.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61358", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the various wellness benefits available to employees, including gym memberships, mental health resources, and health screenings.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61358", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and processing travel and expense reports.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61359", "text": "{\n    \"policy_id\": \"PTO-2023-001\",\n    \"policy_title\": \"Enhanced Vacation Policy\",\n    \"policy_description\": \"This policy outlines the vacation time accrual and usage guidelines for employees. It provides a more generous allowance than the standard policy.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-enhanced-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61359", "text": "{\n    \"policy_id\": \"PTO-2022-002\",\n    \"policy_title\": \"Standard Vacation Policy\",\n    \"policy_description\": \"This policy details the standard vacation accrual rates and usage guidelines for all employees.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-standard-2022.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61360", "text": "{\n    \"policy_id\": \"BP-2023-007\",\n    \"policy_title\": \"Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive employee benefits package offered to all eligible employees, including health insurance, dental insurance, vision insurance, life insurance, paid time off, sick leave, and retirement plan options. It details eligibility requirements, enrollment procedures, and coverage details. This policy aims to attract and retain top talent by offering competitive and valuable benefits. Employees are encouraged to review the full details available at the policy document URL. Any questions should be directed to the HR benefits team.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61360", "text": "{\n    \"policy_id\": \"BP-2022-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy details the health insurance options available to employees.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_2022.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61361", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61361", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and reimbursing employee travel expenses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61362", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to all eligible employees.  It includes details on medical, dental, and vision coverage. Employees can enroll during the open enrollment period each year. Details regarding co-pays, deductibles and out-of-pocket maximums are clearly stated within the full policy document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61362", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"This comprehensive policy details procedures for expense reimbursement related to business travel. It covers all aspects of travel, including airfare, lodging, meals, and transportation.  It addresses pre-approval requirements, acceptable expense limits, documentation needed for submission, and the process for submitting expense reports. It also has detailed guidelines for international travel, including currency exchange rates and visa requirements. A complete schedule of per diem rates based on location can be found in Appendix A. The policy emphasizes adherence to company travel guidelines and ethical considerations. It also covers booking procedures through approved travel vendors and the consequences of non-compliance.  This policy aims to ensure fair and consistent reimbursement for legitimate business travel expenses while maintaining cost-effectiveness and accountability. It also outlines procedures for emergency travel situations.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61363", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all employees, aiming to support their overall well-being and provide peace of mind. It details medical, dental, and vision coverage, as well as resources for mental health and fitness.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61363", "text": "{\n    \"policy_id\": \"EXP-001\",\n    \"policy_title\": \"Employee Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for reimbursing employees for legitimate business expenses, including accommodation, meals, and transportation costs incurred while on company travel.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/expenses/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61364", "text": "{\n    \"policy_id\": \"RW-2024-01\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements, emphasizing work-life balance and employee mental health. It promotes flexible schedules and provides resources for setting up a productive home office.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61364", "text": "{\n    \"policy_id\": \"COMP-2023-08\",\n    \"policy_title\": \"Compensation and Benefits Policy\",\n    \"policy_description\": \"This policy details the company's compensation structure, including salary ranges, bonus eligibility, and benefits packages. It aims to attract and retain top talent through competitive offerings.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2024-06-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"HR\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
