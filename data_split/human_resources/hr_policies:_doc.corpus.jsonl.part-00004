{"_id": "human_resources--hr_policies:_doc--n--65409", "text": "{\n    \"policy_id\": \"TRA-LEAD-202205\",\n    \"policy_title\": \"Leadership Development Program Guidelines\",\n    \"policy_description\": \"Detailed guidelines for the company's Leadership Development Program, covering eligibility criteria, training modules, mentoring opportunities, and performance evaluation metrics. The program is designed to cultivate future leaders within the organization. It involves extensive documentation and requires significant time commitment.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program-guidelines.pdf\"\n}"}
