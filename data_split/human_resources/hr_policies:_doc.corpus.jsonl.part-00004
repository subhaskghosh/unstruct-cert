{"_id": "human_resources--hr_policies:_doc--p--71241", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee wellness, offering resources for physical, mental, and financial security. It includes gym membership discounts, mental health support, and financial planning workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits\"\n}"}
