{"_id": "human_resources--hr_policies:_doc--n--65272", "text": "{\n    \"policy_id\": \"LB-2022-005\",\n    \"policy_title\": \"Leave of Absence - Extended Medical\",\n    \"policy_description\": \"Detailed procedures for employees requiring extended leave for medical reasons, covering eligibility, documentation requirements, and benefits continuation.  Includes extensive legal disclaimers and cross-references to state and federal regulations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy.pdf\"\n}"}
