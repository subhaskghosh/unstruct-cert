{"_id": "human_resources--hr_policies:_doc--p--64765", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through confidential counseling, resources, and referrals during personal or work-related challenges. It covers a wide range of issues including stress, anxiety, grief, and financial difficulties.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
