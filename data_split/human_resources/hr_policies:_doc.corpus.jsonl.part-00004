{"_id": "human_resources--hr_policies:_doc--p--68249", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees' financial health through workshops, resources, and access to financial advisors. It includes details on retirement planning, debt management, and investment education.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/financial-wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68249", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"Details regarding employee health insurance plans, including coverage options, premiums, and claims procedures.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68250", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including access to mental health resources, gym memberships, and wellness workshops. It aims to foster a positive and supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Research and Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68250", "text": "{\n    \"policy_id\": \"EXEC-COMP-001\",\n    \"policy_title\": \"Executive Compensation and Bonus Structure\",\n    \"policy_description\": \"Details the bonus structure and compensation packages for executive-level employees, based on performance metrics and company profitability. Includes stock options and other benefits.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-comp\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68251", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for stress management, mental health support, and work-life balance. It provides details on available counseling services, wellness workshops, and flexible work arrangements.\",\n    \"effective_date\": \"2024-02-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-program-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68251", "text": "{\n    \"policy_id\": \"LO-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving various types of leave of absence, including sick leave, family leave, and personal leave. It covers eligibility requirements, documentation needed, and the impact on benefits.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-2022\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68252", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental and physical health, and promoting a healthy work-life balance. Includes access to counseling services and fitness benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68252", "text": "{\n    \"policy_id\": \"HR-2022-105\",\n    \"policy_title\": \"Remote Work Arrangement Guidelines\",\n    \"policy_description\": \"This policy details the procedures and requirements for employees requesting remote work arrangements, including eligibility criteria and performance expectations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-guidelines\"\n}"}
