{"_id": "human_resources--hr_policies:_doc--p--67929", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Eligibility\",\n    \"policy_description\": \"This policy outlines the eligibility requirements for employees to enroll in the company's health insurance plan. Full-time employees are eligible after 30 days of employment.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67929", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program designed to foster leadership skills among mid-level managers. This includes mentorship, workshops, and external training opportunities, spanning a 12-month period with detailed modules on strategic planning, team building, conflict resolution, and advanced communication techniques. The program is evaluated based on 360-degree feedback and key performance indicators aligned with company goals.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67930", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Remote Work & Benefit Eligibility\",\n    \"policy_description\": \"This policy clarifies benefit eligibility for employees working remotely, outlining options for healthcare, retirement plans, and other perks. It emphasizes support for flexible work arrangements and maintaining employee wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67930", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the annual health insurance enrollment process, including plan options, deadlines, and premium contributions. This policy applies to all full-time employees.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment.pdf\"\n}"}
