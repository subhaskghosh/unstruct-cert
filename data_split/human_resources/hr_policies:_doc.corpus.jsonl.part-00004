{"_id": "human_resources--hr_policies:_doc--n--65857", "text": "{\n    \"policy_id\": \"CMP-2023-012\",\n    \"policy_title\": \"Social Media Compliance\",\n    \"policy_description\": \"This policy details the guidelines for employee conduct on social media, ensuring brand representation and legal compliance. It prohibits the disclosure of confidential company information.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Legal\",\n        \"Communications\"\n    ],\n    \"policy_document_url\": \"https://example.com/social-media-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65858", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness programs, and healthy eating options.  It aims to foster a positive and supportive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65858", "text": "{\n    \"policy_id\": \"LE-2022-012\",\n    \"policy_title\": \"Legal Compliance and Data Protection\",\n    \"policy_description\": \"A comprehensive document detailing all legal requirements related to data privacy, security, and compliance with relevant regulations (GDPR, CCPA, etc.). It includes detailed procedures for data handling, breach notification, and employee training. This is a very long and detailed policy.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Finance\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal-compliance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65859", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the full range of benefits offered to employees, including health insurance, retirement plans, paid time off, and other perks. This policy aims to attract and retain top talent by providing a competitive benefits package.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Research and Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65859", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Minor Update to Health Insurance Copays\",\n    \"policy_description\": \"A brief update to the existing health insurance policy regarding copay amounts for specific medical procedures. Does not change the overall benefits structure.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Research and Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/copay-update.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65860", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering flexible work options, wellness program details, and resources for maintaining a healthy work-life balance. It supports employees in managing personal and professional commitments effectively.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-flex-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65860", "text": "{\n    \"policy_id\": \"PERF-001\",\n    \"policy_title\": \"Performance Review and Improvement Plan\",\n    \"policy_description\": \"This policy details the performance review process, including goal setting, feedback mechanisms, and procedures for performance improvement plans. It aims to foster a high-performance culture and address performance gaps.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/performance-review.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65861", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for physical, mental, and financial wellness. Includes gym memberships, mindfulness workshops, and financial planning assistance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Marketing\",\n        \"Public Relations\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65861", "text": "{\n    \"policy_id\": \"RET-SAV-001\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including eligibility, contribution limits, and investment options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65862", "text": "{\n    \"policy_id\": \"FIN-WEL-001\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee financial health through resources like budgeting workshops, retirement planning assistance, and access to financial advisors.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/financialwellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65862", "text": "{\n    \"policy_id\": \"LEAVE-005\",\n    \"policy_title\": \"Parental Leave Policy\",\n    \"policy_description\": \"Details regarding parental leave benefits for new parents.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/parentalleave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65863", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employees in balancing their work and personal lives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Engineering\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65863", "text": "{\n    \"policy_id\": \"SLS-CMP-005\",\n    \"policy_title\": \"Sales Commission Plan\",\n    \"policy_description\": \"Details the commission structure for the Sales team, outlining targets, payout percentages, and performance metrics.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65864", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through various programs like gym memberships, mental health resources, and healthy lifestyle workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Research and Development\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65864", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Equal Employment Opportunity (EEO) and Non-Discrimination\",\n    \"policy_description\": \"This policy details the company's commitment to equal employment opportunity and prohibits discrimination based on protected characteristics. It outlines procedures for reporting and investigating discrimination complaints.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/eeo_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65865", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Plan\",\n    \"policy_description\": \"This policy details the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care, including details on premiums, deductibles, and coverage levels. Employees are encouraged to review the full policy document for complete information.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-08-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65865", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"New Employee Wellness Program\",\n    \"policy_description\": \"A short description outlining a new wellness initiative.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65866", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Vacation and Sick Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and utilizing vacation and sick leave benefits for all eligible employees. It includes details on accrual rates, maximum carryover, and reporting requirements.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation_sick_leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65866", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan - Tier 3\",\n    \"policy_description\": \"A highly detailed plan outlining stock option grants for executive-level employees, including vesting schedules, exercise procedures, and tax implications. This document requires specialized legal and financial understanding.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options_tier3.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65867", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Work-Life Balance Support Policy\",\n    \"policy_description\": \"This policy outlines the various programs and resources available to employees to support their work-life balance, including flexible work arrangements, employee assistance programs, and wellness initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/worklifebalancepolicy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65867", "text": "{\n    \"policy_id\": \"LEAVE-2022-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"Details regarding the accrual and use of sick leave for employees.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/sickleavepolicy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65868", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, dental, vision, 401k, and paid time off. It aims to provide a supportive and rewarding work environment.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65868", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel and business-related expenses.  It covers eligible expenses and the required documentation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65869", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering flexible work options, mental health resources, and promoting a healthy work-life balance. It aims to support employees in managing their personal and professional commitments effectively.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-flexibility.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65869", "text": "{\n    \"policy_id\": \"AT-2022-012\",\n    \"policy_title\": \"Attendance and Punctuality\",\n    \"policy_description\": \"This policy details the company's expectations regarding employee attendance, punctuality, and timekeeping. Strict adherence to scheduled work hours is mandatory, and unauthorized absences will be subject to disciplinary action. Tardiness will result in warnings, and repeated offenses may lead to termination.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Manufacturing\",\n        \"Operations\",\n        \"Logistics\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/attendance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65870", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources and support for physical and mental health.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65870", "text": "{\n    \"policy_id\": \"LOA-2023-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Detailed procedures and guidelines for requesting and managing extended leaves of absence, covering various scenarios and legal requirements. This is a comprehensive document outlining the entire leave process from start to finish and includes several appendices.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65871", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellbeing and Stress Management\",\n    \"policy_description\": \"This policy outlines the resources available to employees experiencing work-related stress, including access to counseling services, mindfulness workshops, and flexible work arrangements. It aims to create a supportive work environment and promote employee mental health.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-stress-management\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65871", "text": "{\n    \"policy_id\": \"IT-2023-007\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"This policy details the guidelines for the appropriate use of company-owned computers, software, and internet access. It covers security protocols, data privacy, and acceptable online behavior.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-22\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/acceptable-use-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65872", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for physical, mental, and financial wellness. It aims to promote a healthy work-life balance and a supportive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65872", "text": "{\n    \"policy_id\": \"LEGL-2023-005\",\n    \"policy_title\": \"Non-Disclosure Agreement & Intellectual Property Protection\",\n    \"policy_description\": \"A comprehensive legal document detailing the terms and conditions regarding confidential information, trade secrets, and intellectual property rights of the company and its employees. Requires mandatory annual review.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-ip-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65873", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels, premiums, and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65873", "text": "{\n    \"policy_id\": \"REM-0005\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"Outlines the guidelines and requirements for employees working remotely, including eligibility, equipment, and security protocols.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65874", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, and vision benefits available to all eligible employees. It also includes wellness program details.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65874", "text": "{\n    \"policy_id\": \"EMP-TRA-001\",\n    \"policy_title\": \"Employee Training and Development\",\n    \"policy_description\": \"This policy details the company's commitment to employee training, including reimbursement guidelines and approved training providers.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-tra-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65875", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health and Wellness Benefits Update\",\n    \"policy_description\": \"This policy outlines the health and wellness benefits available to all employees, including details on medical, dental, and vision coverage, as well as wellness programs. Updated to comply with the latest Affordable Care Act regulations.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits-update\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65875", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details regarding the company's 401k retirement plan, including eligibility, contribution limits, and investment options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k-retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65876", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Spending Account (FSA) Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to utilize a Flexible Spending Account for eligible healthcare and dependent care expenses. It aims to provide employees with tax advantages and greater control over their benefit dollars.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/fsa-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65876", "text": "{\n    \"policy_id\": \"TRAV-EXP-001\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related travel and expenses. Strict adherence to pre-approved budgets is required.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy.pdf\"\n}"}
