{"_id": "human_resources--hr_policies:_doc--p--67072", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can enroll during the annual open enrollment period or upon qualifying life events.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67072", "text": "{\n    \"policy_id\": \"EB-2022-010\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to all eligible employees, including 401(k) contributions, employer matching, vesting schedules, and investment options. It also addresses pre-retirement counseling services and withdrawal procedures.  It covers various investment strategies, risk tolerances, and provides detailed financial planning resources. This policy is regularly reviewed to ensure compliance with all relevant regulations and to optimize benefits for our employees. Detailed information about each investment option is provided in the appendix.  Eligibility requirements and enrollment procedures are outlined in Section 2.  Furthermore, it describes the process for beneficiaries to claim benefits in the event of an employee's passing.  Tax implications and reporting requirements are also covered in detail.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67073", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67073", "text": "{\n    \"policy_id\": \"LVE-2023-002\",\n    \"policy_title\": \"Leave of Absence\",\n    \"policy_description\": \"This policy details procedures for requesting and taking various types of leave, including sick leave, vacation leave, and personal leave. It also outlines eligibility requirements, documentation needed, and the impact of leave on benefits and compensation. This policy applies to all full-time and part-time employees after a probationary period. Specific rules for each leave type are outlined in the appendix. Furthermore, compliance with state and federal laws is detailed in section 4.2.b.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
