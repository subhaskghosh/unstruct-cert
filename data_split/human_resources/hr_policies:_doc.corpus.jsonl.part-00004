{"_id": "human_resources--hr_policies:_doc--n--64210", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Complex Compensation Plan for Executive Leadership\",\n    \"policy_description\": \"This policy details the intricate compensation structure for executive-level employees, including performance-based bonuses, stock options, and deferred compensation plans. It encompasses a multi-tiered performance evaluation process and is subject to annual review by the Compensation Committee of the Board of Directors. The complete details are outlined in the attached document which details complex eligibility criteria and payout schedules.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-05\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-plan\"\n}"}
