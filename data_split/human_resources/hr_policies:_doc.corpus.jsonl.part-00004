{"_id": "human_resources--hr_policies:_doc--n--67464", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Expense Reimbursement Policy\",\n    \"policy_description\": \"A comprehensive guide detailing the procedures for submitting and receiving reimbursements for authorized business expenses, including travel, meals, and entertainment. Includes detailed guidelines for receipts, approvals, and reporting.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-reimbursement-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67465", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision care. Employees are responsible for a portion of the premium, as detailed in the benefits enrollment guide. Details regarding co-pays and deductibles can be found on the insurance provider's website.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67465", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"The Equity Compensation Plan details the various options for employee stock ownership, including stock options, restricted stock units (RSUs), and employee stock purchase plans (ESPPs). This plan is designed to align employee interests with long-term company performance. Eligibility requirements, vesting schedules, and tax implications are outlined in detail. Participants are encouraged to consult with a financial advisor before making any decisions related to their equity awards. Further details regarding stock option exercises and RSU settlements are available in the plan document. The policy also covers changes in control events and their impact on equity awards. This document also outlines the provisions for accelerated vesting in the event of a change in control or termination without cause. The plan administration is handled by the compensation committee. Regular reviews are conducted to ensure compliance with applicable regulations. This is a highly complex policy regarding stock compensation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67466", "text": "{\n    \"policy_id\": \"BP-2023-11-01\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"This policy outlines the commission structure for the Sales department, including performance-based incentives and bonus eligibility. It details how sales targets are set and how commissions are calculated.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales-commission-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67466", "text": "{\n    \"policy_id\": \"IT-2022-05-10\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"This policy details the acceptable use of company-owned computers, software, and network resources. It covers security protocols and data privacy guidelines.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/it-acceptable-use-policy\"\n}"}
