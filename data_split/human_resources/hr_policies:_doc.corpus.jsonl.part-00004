{"_id": "human_resources--hr_policies:_doc--p--71242", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, covering physical health, mental health resources, and financial wellness workshops. It details access to gym memberships, employee assistance programs, and financial planning consultations.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
