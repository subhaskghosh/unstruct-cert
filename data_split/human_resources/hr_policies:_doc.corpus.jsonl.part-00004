{"_id": "human_resources--hr_policies:_doc--p--64838", "text": "{\n    \"policy_id\": \"BP-2023-005\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy details the comprehensive health insurance benefits available to all eligible employees, including medical, dental, and vision coverage. It outlines eligibility requirements, enrollment procedures, coverage levels, and claims processes. It also includes information on wellness programs and employee assistance programs.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-benefits-policy\"\n}"}
