{"_id": "human_resources--hr_policies:_doc--n--62502", "text": "{\n    \"policy_id\": \"BEN-RMT-202205\",\n    \"policy_title\": \"Remote Work Reimbursement\",\n    \"policy_description\": \"This detailed policy covers the reimbursement procedures for employees working remotely, including allowances for home office setup, internet costs, and ergonomic equipment.  It includes detailed guidelines on eligible expenses, documentation requirements, and approval workflows, encompassing scenarios such as occasional remote work, full-time remote work, and temporary remote work arrangements due to unforeseen circumstances. It also addresses security considerations and data protection protocols for remote workers. A separate section outlines the process for claiming reimbursement and the expected turnaround time for processing claims. The policy also details the company’s liability regarding remote work setups.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62503", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, and vision benefits available to all eligible employees. It details coverage levels, eligibility requirements, and procedures for enrollment. Includes information on wellness programs and employee assistance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness.pdf\"\n}"}
