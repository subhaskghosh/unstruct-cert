{"_id": "human_resources--hr_policies:_doc--n--68639", "text": "{\n    \"policy_id\": \"CMP-LEG-005\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"This policy details the company's adherence to the Employee Retirement Income Security Act (ERISA) and associated regulations. It covers fiduciary responsibilities, reporting requirements, and penalties for non-compliance. Highly technical and legal in nature.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Finance\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/cmp-leg-005\"\n}"}
