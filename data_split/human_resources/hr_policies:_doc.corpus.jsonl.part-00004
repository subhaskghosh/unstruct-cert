{"_id": "human_resources--hr_policies:_doc--p--70446", "text": "{\n    \"policy_id\": \"CMP-BNF-2023-001\",\n    \"policy_title\": \"Compensation and Benefits Policy - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the compensation structure, benefits packages, and performance-based incentives for employees in the Sales and Marketing departments. It aims to provide a fair and equitable rewards system based on individual contributions and market competitiveness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/cmp-bnf-2023-001.pdf\"\n}"}
