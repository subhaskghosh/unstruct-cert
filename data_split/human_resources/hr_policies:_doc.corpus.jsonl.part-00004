{"_id": "human_resources--hr_policies:_doc--n--62952", "text": "{\n    \"policy_id\": \"VAC-2024-002\",\n    \"policy_title\": \"Vacation Time Accrual\",\n    \"policy_description\": \"Guidelines for accruing and requesting vacation time, including blackout periods and approval processes.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/vacation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62953", "text": "{\n    \"policy_id\": \"PTO-2023-SM\",\n    \"policy_title\": \"Paid Time Off Policy - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and using paid time off for employees in the Sales and Marketing departments. Employees accrue PTO based on years of service.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-sm\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62953", "text": "{\n    \"policy_id\": \"CMP-2022-ALL\",\n    \"policy_title\": \"Complex Compensation and Benefits Plan\",\n    \"policy_description\": \"A comprehensive document detailing all aspects of employee compensation, including base salary, bonus structures, stock options, health insurance, retirement plans, and other benefits.  This policy is reviewed annually and requires detailed understanding of legal and financial regulations. It contains several complex clauses related to performance-based incentives and equity grants.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-plan\"\n}"}
