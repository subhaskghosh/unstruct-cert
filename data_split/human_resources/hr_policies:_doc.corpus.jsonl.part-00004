{"_id": "human_resources--hr_policies:_doc--p--70409", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Enhanced Wellness Benefits Program\",\n    \"policy_description\": \"This policy outlines the enhanced wellness benefits offered to employees, including gym memberships, mental health resources, and preventative care programs. It aims to promote a healthy and balanced lifestyle among our workforce.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70409", "text": "{\n    \"policy_id\": \"TS-2022-012\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursements for business travel and related expenses.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70410", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy details the health insurance benefits available to eligible employees, including coverage levels, enrollment procedures, and claim submission guidelines. It covers medical, dental, and vision plans.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70410", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401k retirement plan, including eligibility requirements, contribution limits, vesting schedules, and investment options. It provides employees with a means to save for their retirement.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70411", "text": "{\n    \"policy_id\": \"TRVL-2023-001\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit and receive reimbursement for travel expenses incurred while conducting company business.\",\n    \"effective_date\": \"2022-10-26\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70411", "text": "{\n    \"policy_id\": \"IT-SEC-2022-005\",\n    \"policy_title\": \"Acceptable Use of Company IT Resources\",\n    \"policy_description\": \"This policy details the acceptable use of company-owned computers, networks, and software.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"All Employees\"\n    ],\n    \"policy_document_url\": \"https://example.com/it-security-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70412", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to all eligible employees. It covers medical, dental, and vision plans.  Employees can enroll during the annual open enrollment period or upon qualifying life events. Details on plan coverage and costs can be found on the HR portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70412", "text": "{\n    \"policy_id\": \"BNF-2022-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy provides income replacement benefits to employees who are unable to work due to a qualifying disability. Eligibility requirements, benefit levels, and claim procedures are detailed in this document. The policy ensures comprehensive support to employees facing long-term health challenges, including access to rehabilitation services and assistance with financial planning.  It encompasses a detailed understanding of various disability types and their potential impact on an employee's ability to perform their job duties. A lengthy appendix details specific medical conditions and their coverage limitations.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/long-term-disability.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70413", "text": "{\n    \"policy_id\": \"WELLBEING-SM-20231026\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources and support for physical, mental, and emotional health. It covers programs like stress management workshops, gym reimbursements, and mental health resources.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70413", "text": "{\n    \"policy_id\": \"COMPENSATION-SM-20230510\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for the Sales and Marketing teams, outlining targets, payout rates, and performance metrics.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/commission-structure.pdf\"\n}"}
