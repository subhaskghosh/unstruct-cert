{"_id": "human_resources--hr_policies:_doc--p--65789", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for physical and mental health. It covers gym membership reimbursements, stress management workshops, and access to an Employee Assistance Program.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65789", "text": "{\n    \"policy_id\": \"WB-002\",\n    \"policy_title\": \"Comprehensive Mental Health Benefits\",\n    \"policy_description\": \"A detailed overview of all mental health resources available to employees, including coverage details, provider networks, and claim procedures. This document is extensive and complex, covering all aspects of mental healthcare benefits.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/mental-health-benefits\"\n}"}
