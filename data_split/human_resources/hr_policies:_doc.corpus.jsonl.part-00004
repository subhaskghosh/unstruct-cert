{"_id": "human_resources--hr_policies:_doc--p--64713", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the options available to employees for flexible work arrangements, including remote work, compressed workweeks, and flexible hours, to support work-life balance and employee well-being. It also details the process for requesting and approving these arrangements.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-engineering\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64713", "text": "{\n    \"policy_id\": \"PTO-GEN-2023-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the company's guidelines for requesting and utilizing paid time off, including vacation, sick leave, and personal days. It covers eligibility requirements, accrual rates, and request procedures.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/paid-time-off\"\n}"}
