{"_id": "human_resources--hr_policies:_doc--p--67458", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Plan Details\",\n    \"policy_description\": \"This policy outlines the details of the company's health insurance plan, including coverage options, eligibility requirements, and enrollment procedures. It provides employees with access to quality healthcare services at affordable rates. Employees are encouraged to review the plan documents for a comprehensive understanding of their benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67458", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy details the long-term disability insurance benefits available to eligible employees. It covers a percentage of an employee’s salary in the event they become unable to work due to a qualifying disability. The policy includes information on eligibility criteria, benefit amounts, waiting periods, and claim procedures.  Employees should consult the full policy document for detailed information on coverage limits, exclusions, and other important provisions.  This policy covers scenarios ranging from temporary illness and injury to chronic conditions impacting work capacity.  The application process involves submitting medical documentation from a qualified healthcare professional.  Benefit payments are subject to applicable taxes.  Regular reviews of the policy are conducted to ensure compliance with relevant legislation and best practices. We strive to provide comprehensive support to employees during challenging times, recognizing the importance of financial security. This policy aims to minimize the financial burden associated with long-term disability and facilitate a smooth transition back to work whenever possible.  Specific provisions address pre-existing conditions and the coordination of benefits with other insurance plans. Further details regarding appeals and grievance procedures are also included within the document. The maximum benefit period is 24 months.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67459", "text": "{\n    \"policy_id\": \"EMP-COND-001\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines the expected standards of behavior for all employees, covering areas such as ethical conduct, professional interactions, conflict of interest, data privacy, and social media usage.  It aims to foster a respectful and productive work environment. Violations of this policy may result in disciplinary action, up to and including termination of employment. The company is committed to maintaining a workplace free from harassment and discrimination. All employees are responsible for understanding and adhering to this code. Specific examples of unacceptable behavior are detailed in the accompanying handbook. This policy is designed to protect the company’s reputation and ensure a positive experience for all stakeholders. We will continuously review and update this policy to reflect changes in law and best practices. Employees are encouraged to seek clarification from HR if they have any questions.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-conduct-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67459", "text": "{\n    \"policy_id\": \"REM-EXP-005\",\n    \"policy_title\": \"Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit expense reports and receive reimbursement for authorized business expenses. It covers travel, meals, and other incidental costs. All expense reports must be submitted with original receipts and approved by the employee's manager.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-reimbursement-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67460", "text": "{\n    \"policy_id\": \"BEN-WEL-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, offering benefits such as gym membership discounts, mental health resources, and annual health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
