{"_id": "human_resources--hr_policies:_doc--p--68432", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for physical and mental health, including gym discounts and mindfulness workshops. It also details the Employee Assistance Program (EAP).\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68432", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"401k Contribution Guidelines\",\n    \"policy_description\": \"Detailed legal guidelines concerning 401k contributions, vesting schedules, and compliance with ERISA regulations.  Includes specific references to IRS code section 401(k).\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-guidelines.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68433", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, adjusted hours, and compressed workweeks, aiming to promote work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68433", "text": "{\n    \"policy_id\": \"WB-2022-002\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"The Employee Assistance Program provides confidential counseling and referral services to employees facing personal or work-related challenges. This comprehensive program covers a wide range of issues, including stress, anxiety, depression, substance abuse, and family problems. Detailed information on eligibility, services offered, and access procedures is outlined in this document. The EAP is committed to supporting the well-being of our employees and fostering a healthy and productive work environment. The program is administered by an external provider and is available 24/7.  Employees are encouraged to utilize the EAP as a valuable resource for managing life's challenges.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68434", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym membership subsidies and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68434", "text": "{\n    \"policy_id\": \"LGL-2022-005\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Details the stock option grants and vesting schedules for eligible employees. This document contains complex legal terminology.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2022-08-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68435", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It includes details on coverage, eligibility, and enrollment procedures. The policy supports flexible work arrangements and remote work options for benefit access.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68435", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Legacy Employee Pension Plan\",\n    \"policy_description\": \"Details the historical pension plan for employees hired before 2000. This plan is no longer available to new hires and has limited applicability due to updated retirement options.\",\n    \"effective_date\": \"1995-01-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-002\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68436", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellbeing and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental health and overall wellbeing. It includes resources for counseling, stress management, and work-life balance. It is important to foster a positive and inclusive work environment where employees feel comfortable seeking support.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-wb2023-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68436", "text": "{\n    \"policy_id\": \"LOA-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details procedures for requesting and managing various types of leave, including sick leave, vacation, and personal leave. Adherence to legal requirements regarding leave is essential.\",\n    \"effective_date\": \"2022-09-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy-loa2022-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68437", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance, wellness programs, and other benefits available to all eligible employees. It focuses on preventative care and employee well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68437", "text": "{\n    \"policy_id\": \"TERM-002\",\n    \"policy_title\": \"Employee Termination and Benefits Continuation\",\n    \"policy_description\": \"This policy details the procedures for employee termination, including final pay, benefits continuation options (COBRA), and return of company property.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/termination-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68438", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Health Savings Account (HSA) Contribution Policy\",\n    \"policy_description\": \"This policy outlines the company's contribution guidelines for employee Health Savings Accounts (HSAs). It details eligibility criteria, contribution limits, and how to enroll. The goal is to encourage employees to proactively manage their healthcare expenses.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/hsa-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68438", "text": "{\n    \"policy_id\": \"EMP-TERM-002\",\n    \"policy_title\": \"Involuntary Termination and Severance Policy\",\n    \"policy_description\": \"This policy details the procedures for involuntary termination of employment, including severance package eligibility and final pay calculations. It covers legal compliance and best practices for handling terminations with sensitivity and fairness.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-policy\"\n}"}
