{"_id": "human_resources--hr_policies:_doc--n--67616", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Company Vehicle Usage\",\n    \"policy_description\": \"This policy details the guidelines for using company-provided vehicles, including authorized drivers, permitted use cases, and reporting procedures. It is a comprehensive document addressing all facets of company vehicle operations and associated liabilities.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Logistics\"\n    ],\n    \"policy_document_url\": \"https://example.com/vehicle-policy\"\n}"}
