{"_id": "human_resources--hr_policies:_doc--p--67806", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Wellbeing Benefits\",\n    \"policy_description\": \"This policy details the company's commitment to employee wellbeing, encompassing medical, dental, vision, mental health resources, and financial planning support. It emphasizes preventative care and holistic health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellbeing-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67806", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Basic Health Insurance Policy\",\n    \"policy_description\": \"This policy outlines the minimum health insurance coverage provided to eligible employees. It covers essential medical services but does not include extensive wellness programs or mental health support.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/basic-health-insurance.pdf\"\n}"}
