{"_id": "human_resources--hr_policies:_doc--p--71711", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the full range of employee benefits, including health insurance, paid time off, wellness programs, and flexible work options. This policy aims to attract and retain top talent by offering a competitive and supportive benefits package.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2023.pdf\"\n}"}
