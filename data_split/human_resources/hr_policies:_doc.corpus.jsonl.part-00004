{"_id": "human_resources--hr_policies:_doc--n--62452", "text": "{\n    \"policy_id\": \"ADM-005\",\n    \"policy_title\": \"Expense Reimbursement Procedure\",\n    \"policy_description\": \"Detailed guidelines and instructions for employees submitting expense reports, including eligible expenses, required documentation, and reimbursement timelines.  This procedure covers all departments and expense types, including travel, meals, and office supplies, and is crucial for maintaining accurate financial records and compliance with company policies. It also includes information on per diem rates, approval processes, and potential audit procedures.\",\n    \"effective_date\": \"2023-02-10\",\n    \"last_updated\": \"2023-09-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62453", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Health & Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellness, including details on health insurance, wellness programs, and preventative care initiatives. It encourages a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62453", "text": "{\n    \"policy_id\": \"TERM-001\",\n    \"policy_title\": \"Employee Termination Procedure\",\n    \"policy_description\": \"This policy details the procedures for terminating an employee, including grounds for termination, notification requirements, and final pay procedures. Includes details on severance packages.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/termination.pdf\"\n}"}
