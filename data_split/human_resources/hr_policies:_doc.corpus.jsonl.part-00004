{"_id": "human_resources--hr_policies:_doc--p--65485", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Mental Health and Support\",\n    \"policy_description\": \"This policy outlines the resources available to employees to support their mental health, including counseling services, employee assistance programs, and stress management workshops. It promotes a supportive work environment and encourages employees to prioritize their well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65485", "text": "{\n    \"policy_id\": \"PF-002\",\n    \"policy_title\": \"Corporate Wellness Program - Gym Membership\",\n    \"policy_description\": \"This policy provides employees with subsidized gym memberships and promotes physical fitness as part of a comprehensive wellness program. Includes details on reimbursement procedures and approved gyms.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pf-002\"\n}"}
