{"_id": "human_resources--hr_policies:_doc--n--62381", "text": "{\n    \"policy_id\": \"TRN-2023-015\",\n    \"policy_title\": \"Travel Reimbursement Guidelines\",\n    \"policy_description\": \"Detailed guidelines for employee travel reimbursement, including per diem rates, approved travel methods, and expense reporting procedures.  This policy aims to provide clarity and consistency in travel expense management, ensuring fair and equitable treatment of all employees while adhering to budgetary constraints. It covers domestic and international travel, specifying different allowances and requirements for each. Detailed procedures for submitting expense reports, along with required documentation, are outlined. The policy also addresses scenarios involving unexpected expenses or changes to travel plans.  Any deviation from these guidelines requires prior approval from the employee's manager and the finance department.\",\n    \"effective_date\": \"2023-05-15\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
