{"_id": "human_resources--hr_policies:_doc--p--67061", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision care. Employees can enroll during the annual open enrollment period or upon hire. Details regarding premiums and coverage levels are available in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67061", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, including 401(k) contributions, pension options, and investment guidance.  Eligibility requirements are outlined based on tenure.  The plan also covers details of beneficiary designations, hardship withdrawals, and required minimum distributions. This document provides a detailed legal framework and is intended for careful review by all eligible employees. Furthermore, the plan aligns with all relevant state and federal regulations, and annual updates are provided to reflect market conditions and legislative changes. Employees are encouraged to seek professional financial advice when making investment decisions within the plan.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
