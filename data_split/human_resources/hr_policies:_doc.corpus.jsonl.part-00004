{"_id": "human_resources--hr_policies:_doc--p--64497", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, providing resources and programs to support a healthy lifestyle. It includes details on gym membership discounts, mental health resources, and preventative care initiatives.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64497", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details regarding the company's 401k retirement savings plan, including eligibility, contribution matching, and investment options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64498", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness and Stress Management\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources and support for stress management, mental health, and work-life balance. It includes details on counseling services, mindfulness programs, and flexible work arrangements.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-2024-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64498", "text": "{\n    \"policy_id\": \"LEAV-2023-002\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures and provisions for employees taking bereavement leave due to the death of a family member. It covers eligibility, duration of leave, and required documentation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-2023-002.pdf\"\n}"}
