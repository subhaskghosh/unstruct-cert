{"_id": "human_resources--hr_policies:_doc--n--64054", "text": "{\n    \"policy_id\": \"LEG-GEN-005\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"This policy details the company's adherence to the Employee Retirement Income Security Act of 1974 (ERISA), including detailed stipulations regarding fiduciary responsibilities, reporting requirements, and prohibited transactions. Legal counsel must be consulted for any interpretation or application of this policy.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/erisa_compliance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64055", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits available to employees, including health insurance, mental health resources, wellness programs, and financial planning assistance. It aims to support employee wellbeing and promote a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64055", "text": "{\n    \"policy_id\": \"EMP-TRA-002\",\n    \"policy_title\": \"Sales Team Training Reimbursement\",\n    \"policy_description\": \"This policy details the process for sales team members to request reimbursement for approved training courses and certifications. It supports professional development within the sales department.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-06-01\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-training-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64056", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, vision, and wellness benefits available to all eligible employees. It includes details on preventative care, mental health resources, and employee assistance programs. The policy emphasizes employee well-being and work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64056", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Basic Health Insurance\",\n    \"policy_description\": \"This policy describes the basic health insurance plan offered to employees. Coverage is limited to doctor visits and hospitalization. Details on specific limitations and exclusions are available in the full policy document.\",\n    \"effective_date\": \"2010-06-01\",\n    \"last_updated\": \"2012-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64057", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being and provides guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks. It aims to promote work-life balance and improve employee satisfaction.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-flex-work.pdf\"\n}"}
