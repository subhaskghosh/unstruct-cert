{"_id": "human_resources--hr_policies:_doc--p--64118", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the process for employees to enroll in company-sponsored health insurance plans. It details eligibility requirements, plan options, and enrollment deadlines. Employees are encouraged to review the plan details carefully before making a selection. Contact HR for assistance. This policy aims to ensure all eligible employees have access to comprehensive health coverage.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64118", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy provides detailed information regarding the company's 401(k) plan, including eligibility, contribution limits, vesting schedules, investment options, loan provisions, and withdrawal procedures. Employees are encouraged to participate in the plan to secure their financial future. The plan is administered by a third-party provider, and further details can be found on their website. This policy also covers stock option grants, restricted stock units, and other equity-based compensation. A full legal disclaimer is included at the end of the document. Detailed explanations of each investment vehicle are available. Consult with a financial advisor for personalized guidance. This plan adheres to all relevant ERISA regulations. The company reserves the right to amend or terminate the plan at any time.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/retirement_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64119", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and well-being through various programs, including health insurance, gym memberships, and mental health resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp_ben_001.pdf\"\n}"}
