{"_id": "human_resources--hr_policies:_doc--p--67371", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Employees can enroll during the annual open enrollment period. Details on plan options and costs are available in the policy document.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67371", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This document details the company's 401(k) plan, including eligibility, contribution limits, vesting schedules, investment options, loan provisions, and withdrawal rules. It also addresses compliance with relevant regulations such as ERISA and IRS guidelines.  The plan provides a variety of investment vehicles to suit different risk tolerances and retirement goals. This is a very complex policy with detailed legal information.  Employees are encouraged to consult with a financial advisor. The policy details also cover hardship withdrawals, qualified domestic relations orders (QDROs), and plan administration procedures. Furthermore, it outlines the process for beneficiary designations and any potential tax implications. We also have a section on the plan's annual nondiscrimination testing requirements.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
