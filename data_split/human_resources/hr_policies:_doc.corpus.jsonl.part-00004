{"_id": "human_resources--hr_policies:_doc--p--65113", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, detailing benefits such as health insurance, wellness programs, and employee assistance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65113", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Equity Incentive Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the company's equity incentive plan, including stock options, restricted stock units, and performance-based awards. It is a highly complex document and should be reviewed with legal counsel.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity/incentive-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65114", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support and resources for employees facing personal or work-related challenges.  It includes counseling services, legal advice, and financial guidance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65114", "text": "{\n    \"policy_id\": \"CT-2022-010\",\n    \"policy_title\": \"Company Travel Expenses\",\n    \"policy_description\": \"This policy details the guidelines and procedures for reimbursing employees for business-related travel expenses.  It covers transportation, lodging, and meals.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65115", "text": "{\n    \"policy_id\": \"EMP-BEN-401K-2024\",\n    \"policy_title\": \"401K Retirement Savings Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401K retirement savings plan, including eligibility, contribution limits, investment options, and withdrawal procedures. It aims to assist employees in planning for their financial future.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65115", "text": "{\n    \"policy_id\": \"EMP-LEAVE-MAT-2023\",\n    \"policy_title\": \"Maternity Leave Policy\",\n    \"policy_description\": \"This policy details the provisions for maternity leave, including eligibility criteria, duration of leave, and benefits continuation. It ensures compliance with relevant labor laws.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/maternity-leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65116", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Family Leave and Benefits\",\n    \"policy_description\": \"This policy outlines the benefits available to employees taking leave to care for family members, including sick leave, parental leave, and bereavement leave.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/family-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65116", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred during business trips.\",\n    \"effective_date\": \"2023-01-20\",\n    \"last_updated\": \"2022-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65117", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"Details coverage options and eligibility for employee health insurance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65117", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Comprehensive Employee Compensation and Equity Plan\",\n    \"policy_description\": \"A detailed plan outlining all aspects of employee compensation including base salary, bonuses, stock options, and long-term incentives.  Covers multiple employee levels and performance metrics. This is a very lengthy document.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65118", "text": "{\n    \"policy_id\": \"WB-ENG-2023-001\",\n    \"policy_title\": \"Work-Life Balance Support for Engineers\",\n    \"policy_description\": \"This policy outlines resources and guidelines to help Engineering employees achieve a healthy work-life balance, including flexible work arrangements, parental leave support, and wellness program access.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-eng-2023-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65118", "text": "{\n    \"policy_id\": \"WB-GEN-2018-005\",\n    \"policy_title\": \"General Employee Wellness Program\",\n    \"policy_description\": \"This policy describes the company's general wellness initiatives, including gym membership discounts and health screenings.\",\n    \"effective_date\": \"2018-08-01\",\n    \"last_updated\": \"2019-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-gen-2018-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65119", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for mental health, physical fitness, and financial planning. It aims to create a supportive work environment and promote work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65119", "text": "{\n    \"policy_id\": \"PR-002\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"This policy details the annual performance review process, including goal setting, feedback mechanisms, and performance improvement plans. It focuses on evaluating employee performance against established objectives.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review\"\n}"}
