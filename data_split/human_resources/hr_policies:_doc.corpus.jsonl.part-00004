{"_id": "human_resources--hr_policies:_doc--n--62496", "text": "{\n    \"policy_id\": \"REM-002\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"Details the procedures and guidelines for employees working remotely, including eligibility criteria, equipment allowances, and performance expectations.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62497", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee 401k Contribution Matching\",\n    \"policy_description\": \"This policy details the company's 401k contribution matching program, designed to help employees save for retirement. The company matches 50% of employee contributions up to 6% of their salary.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62497", "text": "{\n    \"policy_id\": \"BNF-2022-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy provides details on the comprehensive health insurance plan offered to all eligible employees. It covers medical, dental, and vision care, as well as prescription drug benefits. Detailed information on coverage levels, co-pays, and deductibles are outlined in the attached document. The plan includes provisions for preventative care, emergency services, and specialist visits. It also outlines the process for filing claims and appealing denied coverage.  Furthermore, information regarding out-of-network care and international coverage is available. Employee assistance program (EAP) details are included, and information pertaining to wellness initiatives such as gym membership discounts and health risk assessments is also provided.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62498", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources for physical, mental, and financial wellness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62498", "text": "{\n    \"policy_id\": \"LOA-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, family leave, and personal leave.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/loa-policy.pdf\"\n}"}
