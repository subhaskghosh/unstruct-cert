{"_id": "human_resources--hr_policies:_doc--p--71153", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Employee 401k Contribution Matching\",\n    \"policy_description\": \"This policy outlines the company's matching contributions to employee 401k plans, up to 6% of their salary.  It aims to encourage long-term financial security for our employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k_matching.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71153", "text": "{\n    \"policy_id\": \"BNF-2022-010\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance plan offered to all employees, including medical, dental, and vision coverage. This document extensively covers various aspects of the plan, including eligibility, enrollment procedures, coverage details, claims processing, and cost-sharing arrangements. It also addresses pre-existing conditions, network providers, out-of-pocket expenses, and grievance procedures. Furthermore, it outlines the plan's compliance with relevant regulations, such as HIPAA and ACA. Appendices provide detailed information on specific coverage limits and provider directories.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71154", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various programs like mental health resources, fitness reimbursements, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71154", "text": "{\n    \"policy_id\": \"WB-2023-006\",\n    \"policy_title\": \"Comprehensive Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy details the extensive services provided by the EAP, including confidential counseling, legal consultation, and financial planning assistance.\",\n    \"effective_date\": \"2023-02-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-details.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71155", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, and paid time off. It also outlines procedures for enrolling in and utilizing these benefits. This has been updated to include mental health support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71155", "text": "{\n    \"policy_id\": \"EMP-TRAV-002\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for reasonable and necessary travel expenses incurred while on company business. It covers topics like mileage, lodging, and meals.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71156", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"Details the company's commitment to employee health and wellness, including gym memberships and health screenings.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
