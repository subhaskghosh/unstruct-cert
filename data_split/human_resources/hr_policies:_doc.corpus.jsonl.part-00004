{"_id": "human_resources--hr_policies:_doc--p--61466", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels, premiums, and enrollment procedures are outlined in the attached document.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61466", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to all full-time employees, including 401k matching contributions, vesting schedules, and investment options. It also includes information on early withdrawal penalties and tax implications. A detailed booklet with specific fund performance data is available. This document also outlines the guidelines for beneficiary designations and required paperwork. Additionally, it addresses the process for rollovers from previous retirement accounts and explains the company's commitment to financial wellness for its employees. It covers a wide range of scenarios and provides detailed explanations for each.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61467", "text": "{\n    \"policy_id\": \"BP-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various benefits and resources, including gym memberships, mental health support, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
