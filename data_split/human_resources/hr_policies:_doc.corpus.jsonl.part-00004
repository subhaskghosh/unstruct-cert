{"_id": "human_resources--hr_policies:_doc--p--71786", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides extended paid parental leave to eligible employees, exceeding standard legal requirements. It includes provisions for both primary and secondary caregivers.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental_leave_enhanced.pdf\"\n}"}
