{"_id": "human_resources--hr_policies:_doc--n--71965", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans and understand their coverage options. Contains detailed legal disclaimers and complex enrollment procedures.\",\n    \"effective_date\": \"2023-01-05\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
