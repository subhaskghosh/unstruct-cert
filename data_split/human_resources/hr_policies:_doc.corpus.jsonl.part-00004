{"_id": "human_resources--hr_policies:_doc--p--64736", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Covers a wide range of issues including stress, anxiety, depression, and family matters.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64736", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Tuition Reimbursement Program\",\n    \"policy_description\": \"Provides financial assistance to employees pursuing job-related education. Reimbursement is capped at $5,000 per year.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/tuition-policy\"\n}"}
