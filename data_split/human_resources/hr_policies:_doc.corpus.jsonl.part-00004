{"_id": "human_resources--hr_policies:_doc--n--68290", "text": "{\n    \"policy_id\": \"EMP-TERM-002\",\n    \"policy_title\": \"Employee Termination Benefits\",\n    \"policy_description\": \"Outlines benefits provided to employees upon termination of employment, including final paychecks, accrued vacation time, and continuation of health insurance (COBRA).\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/termination_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68291", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It also includes information on wellness programs and employee assistance programs designed to support employee wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-health-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68291", "text": "{\n    \"policy_id\": \"PERF-EVAL-002\",\n    \"policy_title\": \"Annual Performance Evaluation Process\",\n    \"policy_description\": \"This policy details the process for conducting annual performance evaluations, including goal setting, feedback mechanisms, and performance improvement plans.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-evaluation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68292", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and improve productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-arrangement-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68292", "text": "{\n    \"policy_id\": \"EMP-DISC-001\",\n    \"policy_title\": \"Disciplinary Action Policy\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct, including warnings, suspensions, and termination. It outlines the steps for investigation and documentation.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Management\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68293", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance benefits available to all eligible employees, including coverage options, premiums, and enrollment procedures.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68293", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Legacy Retirement Plan\",\n    \"policy_description\": \"Outlines the details of the previous retirement plan offered to employees before the implementation of the 401k. References policy REV-1998-001.\",\n    \"effective_date\": \"2015-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement-legacy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68294", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"Details regarding health insurance coverage options for employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68294", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Comprehensive details on the stock option plan available to executive-level employees.  Includes detailed legal clauses and vesting schedules.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68295", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources for mental and physical health. It includes details on the Employee Assistance Program (EAP), wellness workshops, and gym membership discounts.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68295", "text": "{\n    \"policy_id\": \"AD-005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Detailed procedures for submitting and processing travel expense reports, including allowable expenses, documentation requirements, and approval workflows. This policy adheres to all relevant tax regulations and internal accounting standards. A comprehensive list of per diem rates are included. This is a long and complex document.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68296", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various health and wellness initiatives. It details coverage for gym memberships, mental health resources, and preventative care.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68296", "text": "{\n    \"policy_id\": \"COMP-0005\",\n    \"policy_title\": \"Complex Stock Option Grant Agreement\",\n    \"policy_description\": \"This document details the specifics of stock option grants, including vesting schedules, exercise prices, and tax implications.  It is intended for senior leadership and requires legal consultation.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68297", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential counseling and support services for personal and work-related challenges.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68297", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"A detailed document outlining all benefits offered including health, dental, vision, 401k, and various other perks. Includes complex eligibility requirements and multiple contribution tiers. Requires extensive reading and understanding of legal stipulations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-18\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68298", "text": "{\n    \"policy_id\": \"BNF-2023-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the full range of benefits available to all eligible employees, including health insurance, retirement plans, paid time off, and wellness programs. It is designed to promote employee well-being and attract/retain top talent.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68298", "text": "{\n    \"policy_id\": \"BNF-2022-001\",\n    \"policy_title\": \"Basic Health Insurance Policy\",\n    \"policy_description\": \"This policy details the company's standard health insurance plan. It covers essential medical expenses but does not include vision or dental.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2022-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/basic-health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68299", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing access to resources like gym memberships, mental health support, and health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68299", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details of the company's 401k plan, including eligibility, contribution limits, and investment options. This is a very detailed document covering all possible scenarios.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68300", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It includes information on coverage levels, enrollment procedures, and available resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/healthwellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68300", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Details the terms and conditions for granting stock options to executive-level employees. This is a highly specialized benefits program.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/stockoptions.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68301", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial wellness. It promotes a supportive and healthy work environment and encourages employees to prioritize their overall health.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68301", "text": "{\n    \"policy_id\": \"RW-2023-005\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"This policy defines the guidelines and expectations for employees working remotely, including eligibility criteria, security protocols, and communication standards.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-agreement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68302", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the confidential Employee Assistance Program, providing resources for employees facing personal or work-related challenges, including counseling and support services.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
