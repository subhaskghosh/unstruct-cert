{"_id": "human_resources--hr_policies:_doc--p--61941", "text": "{\n    \"policy_id\": \"EB-2024-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym membership discounts and mental health resources. It aims to promote a healthy work-life balance and boost employee morale. Resources available are detailed in the policy document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61941", "text": "{\n    \"policy_id\": \"EB-2022-001\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This comprehensive document details all aspects of the employee benefits package, including health insurance, dental, vision, life insurance, 401k plans, paid time off, parental leave, disability benefits, and other supplemental benefits. It provides detailed information regarding eligibility, enrollment procedures, contribution rates, and claim processes. The policy includes information regarding company-sponsored wellness programs and resources available to employees. It also outlines the process for appealing benefit decisions and provides contact information for relevant benefit providers. Regular reviews and updates are conducted to ensure compliance with applicable laws and regulations. Employees are encouraged to carefully review this policy to understand their benefits options and responsibilities.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/comprehensive-benefits\"\n}"}
