{"_id": "human_resources--hr_policies:_doc--p--62444", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Details on enrollment and plan options are available in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62444", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"A detailed explanation of the company's retirement savings plan, including eligibility requirements, contribution limits, investment options, vesting schedules, loan provisions, and distribution rules.  This plan is intended to provide employees with a secure financial future. It covers a wide array of scenarios and tax implications, requiring careful consideration and planning. There are multiple tiers of contribution matching based on years of service.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
