{"_id": "human_resources--hr_policies:_doc--p--65228", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, to support employee work-life balance and well-being.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
