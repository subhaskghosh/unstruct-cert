{"_id": "human_resources--hr_policies:_doc--p--71058", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees seeking flexible work arrangements, including remote work, flextime, and compressed workweeks. It aims to enhance work-life balance and employee satisfaction while maintaining productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
