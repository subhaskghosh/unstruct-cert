{"_id": "human_resources--hr_policies:_doc--p--71725", "text": "{\n    \"policy_id\": \"BEN-PTO-2023\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off, including vacation, sick leave, and personal days. It also details eligibility requirements and approval processes. Covers health insurance implications during PTO.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71725", "text": "{\n    \"policy_id\": \"DISC-001-2023\",\n    \"policy_title\": \"Employee Disciplinary Action\",\n    \"policy_description\": \"This policy details the process for addressing employee misconduct, including verbal warnings, written warnings, and potential termination.  It ensures fair and consistent application of disciplinary measures.  Addresses attendance issues and performance deficiencies.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary_policy.pdf\"\n}"}
