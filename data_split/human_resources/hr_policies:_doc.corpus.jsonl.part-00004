{"_id": "human_resources--hr_policies:_doc--p--62844", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee 401k Contribution Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employee contributions to the company 401k plan, including matching contributions and vesting schedules.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62844", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Comprehensive Healthcare Benefits Plan\",\n    \"policy_description\": \"A detailed explanation of all healthcare benefits offered to employees, including medical, dental, and vision coverage, as well as wellness programs, preventative care guidelines, and claims procedures. This document provides complete coverage information, including provider networks, co-pays, deductibles, out-of-pocket maximums, and eligibility criteria. It also addresses specific scenarios like pre-existing conditions, emergency care, and international travel, and offers guidance on navigating the healthcare system effectively. The document contains a section on mental health resources and support, including employee assistance programs and confidential counseling services. Furthermore, it covers health savings accounts (HSAs) and flexible spending accounts (FSAs), explaining contribution limits, eligible expenses, and tax advantages. Includes information about COBRA and HIPAA regulations.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/healthcare_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62845", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, including gym membership subsidies and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62845", "text": "{\n    \"policy_id\": \"LEGAL-COMP-001\",\n    \"policy_title\": \"Non-Disclosure Agreement and Confidentiality\",\n    \"policy_description\": \"Detailed legal framework regarding confidential information protection. This document outlines all requirements for employee data security and intellectual property.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62846", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through initiatives like gym memberships, mental health resources, and wellness workshops. It aims to create a supportive work environment and promote a healthy lifestyle.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62846", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance plan offered to all eligible employees. It includes details on coverage, premiums, deductibles, and claims procedures. The plan offers various options, including HMO, PPO, and HSA. Specific details regarding eligibility and enrollment are outlined in the attached document. This policy also covers dependent care, and preventative care options.  It further details the process for appealing claims, and addresses HIPAA compliance.  It also addresses pre-existing conditions and the coverage limitations associated with them.  Finally, it addresses the employee's responsibilities in maintaining accurate records and communicating any changes to their health status.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62847", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, fitness, and financial planning.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62847", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"Details regarding the company's Long-Term Disability insurance benefits.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62848", "text": "{\n    \"policy_id\": \"EB-2024-07-01\",\n    \"policy_title\": \"Employee Benefits Package - Comprehensive\",\n    \"policy_description\": \"This policy details the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, 401k, and wellness programs. It outlines eligibility requirements, enrollment procedures, and plan details. Focus is given to employee wellness initiatives and resources.\",\n    \"effective_date\": \"2024-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/eb-2024-07-01.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62848", "text": "{\n    \"policy_id\": \"LEAV-2023-11-10\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for employees taking leave due to the death of a family member. It details the amount of leave granted and required documentation.\",\n    \"effective_date\": \"2023-11-10\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/bereavement.pdf\"\n}"}
