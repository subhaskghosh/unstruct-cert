{"_id": "human_resources--hr_policies:_doc--p--64733", "text": "{\n    \"policy_id\": \"BNF-001\",\n    \"policy_title\": \"Employee Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to all eligible employees. It covers medical, dental, and vision care. The policy is designed to be straightforward and easy to understand.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64733", "text": "{\n    \"policy_id\": \"LGL-005\",\n    \"policy_title\": \"Compliance with ERISA Regulations Regarding Benefit Plans\",\n    \"policy_description\": \"A comprehensive legal document detailing the company's compliance with the Employee Retirement Income Security Act (ERISA) concerning all benefit plans. Contains extensive legal jargon and detailed regulatory information. Requires specialized knowledge to interpret.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/erisa-compliance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64734", "text": "{\n    \"policy_id\": \"WB-SLS-2024-001\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees in achieving a healthy work-life balance through flexible work options such as remote work, flextime, and compressed workweeks. It also details resources available to employees for stress management and well-being.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-sales\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64734", "text": "{\n    \"policy_id\": \"HR-GEN-2023-010\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy defines the expected ethical behavior and professional conduct for all employees of the company. It covers areas such as conflicts of interest, confidentiality, and respectful workplace interactions.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/code-of-conduct\"\n}"}
