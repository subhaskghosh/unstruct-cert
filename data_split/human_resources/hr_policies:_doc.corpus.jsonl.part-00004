{"_id": "human_resources--hr_policies:_doc--n--62365", "text": "{\n    \"policy_id\": \"COMP-0015\",\n    \"policy_title\": \"Compensation and Equity Review Policy\",\n    \"policy_description\": \"Detailed legal framework outlining the process for annual compensation reviews, equity grants, and performance-based bonuses.  Includes specific clauses related to compliance with labor laws and equity regulations.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"HR\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation_review.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62366", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It also includes information on employee assistance programs and wellness initiatives.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62366", "text": "{\n    \"policy_id\": \"EMP-STOCK-005\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the company's employee stock option plan. It covers eligibility, vesting schedules, and exercise procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62367", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness and Health Benefits Program\",\n    \"policy_description\": \"This policy details the comprehensive health and wellness benefits available to all eligible employees, including medical, dental, vision, and mental health coverage. It outlines eligibility criteria, enrollment procedures, and coverage details.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62367", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Short-Term Disability Benefits\",\n    \"policy_description\": \"This policy provides short-term disability benefits to eligible employees who are temporarily unable to work due to illness or injury.\",\n    \"effective_date\": \"2021-12-01\",\n    \"last_updated\": \"2022-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-004.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62368", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62368", "text": "{\n    \"policy_id\": \"TERM-002\",\n    \"policy_title\": \"Termination and Exit Procedures\",\n    \"policy_description\": \"Outlines the process for employee termination, including notice periods, final paychecks, and benefits continuation.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62369", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness benefits, and stress management workshops. It promotes a healthy work-life balance and provides support for employees facing personal challenges.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
