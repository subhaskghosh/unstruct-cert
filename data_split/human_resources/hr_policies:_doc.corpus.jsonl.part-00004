{"_id": "human_resources--hr_policies:_doc--n--64869", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Compensation and Long-Term Incentive Plan\",\n    \"policy_description\": \"A comprehensive document outlining the compensation structure, including stock options, performance bonuses, and other incentives for executive-level employees.  It includes complex formulas for calculating bonus amounts and detailed vesting schedules. Requires legal review for understanding.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/executive-compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64870", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the procedures for enrolling in company-sponsored health insurance plans. It details eligibility requirements, enrollment deadlines, and available plan options. Employees are encouraged to review the plan details carefully before making their selections. Contact HR for assistance. This policy supports employee wellbeing by providing access to quality healthcare.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64870", "text": "{\n    \"policy_id\": \"LEAV-001\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This comprehensive policy details all types of extended leave available to employees, including medical leave, family leave, sabbatical leave, and personal leave. It outlines eligibility criteria, application procedures, documentation requirements, and the impact of leave on benefits and compensation. The policy also addresses return-to-work procedures and accommodations for employees with disabilities. Detailed provisions cover legal compliance with FMLA, ADA, and other applicable regulations. Specific scenarios and frequently asked questions are addressed in the appendix.  (Approximately 350 words)\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64871", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the various wellness benefits available to employees, including gym membership discounts, mental health resources, and health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-policy\"\n}"}
