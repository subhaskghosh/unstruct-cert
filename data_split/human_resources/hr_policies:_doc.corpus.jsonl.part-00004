{"_id": "human_resources--hr_policies:_doc--p--68320", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Financial Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee financial wellbeing, providing access to financial planning resources, workshops, and a retirement savings plan match.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial-wellness-2023-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68320", "text": "{\n    \"policy_id\": \"VAC-2022-012\",\n    \"policy_title\": \"Vacation and Paid Time Off\",\n    \"policy_description\": \"This policy details the company's guidelines for accruing and using vacation time, sick leave, and personal days.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation-policy-2022-012.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68321", "text": "{\n    \"policy_id\": \"BEN-WL-2023-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, designed to support employee work-life balance and increase productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68321", "text": "{\n    \"policy_id\": \"TERM-PROC-2023-001\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"This policy details the procedures for terminating an employee, including documentation requirements, exit interviews, and final pay calculations.\",\n    \"effective_date\": \"2023-01-20\",\n    \"last_updated\": \"2023-04-05\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/termination-procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68322", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, retirement plans, and paid time off. It addresses flexible spending accounts and wellness programs, supporting a healthy work-life balance and modern employee needs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68322", "text": "{\n    \"policy_id\": \"REM-WRK-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees working remotely. It covers eligibility, equipment, security, and performance expectations for remote workers.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote_work_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68323", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines all employee benefits, including health insurance, retirement plans, paid time off, parental leave, and disability benefits. It provides detailed information on eligibility, enrollment procedures, and benefit levels.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68323", "text": "{\n    \"policy_id\": \"ADMIN-001\",\n    \"policy_title\": \"Expense Reimbursement Procedure\",\n    \"policy_description\": \"This policy details the process for employees to submit and receive reimbursement for business-related expenses. It includes guidelines on acceptable expenses, required documentation, and reimbursement timelines.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/admin/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68324", "text": "{\n    \"policy_id\": \"EMP-BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including mental health resources, fitness benefits, and work-life balance initiatives. It aims to foster a supportive work environment and promote employee health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68324", "text": "{\n    \"policy_id\": \"COMP-0005\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for the Sales department based on revenue generated. Includes targets, payout schedules, and performance review criteria.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-06-10\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales_commission.pdf\"\n}"}
