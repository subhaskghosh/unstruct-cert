{"_id": "human_resources--hr_policies:_doc--p--67047", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health, fitness, and financial planning. It covers eligibility, program details, and participation guidelines.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67047", "text": "{\n    \"policy_id\": \"TRAV-EXP-001\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related travel and expenses. It includes guidelines on allowable expenses, documentation requirements, and approval processes.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67048", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Designed for simplicity and clarity, it's readily understandable for new employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67048", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the requirements and process for participating in the company's Leadership Development Program. It involves a rigorous selection process and long-term commitment.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/training/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67049", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans. Includes eligibility criteria and coverage options.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67049", "text": "{\n    \"policy_id\": \"EMP-COM-005\",\n    \"policy_title\": \"Comprehensive Employee Compensation and Benefits Guide\",\n    \"policy_description\": \"A detailed guide outlining all aspects of employee compensation, including salary structures, bonus programs, stock options, health insurance, retirement plans, and paid time off. It also covers performance review processes and career development opportunities, with comprehensive legal disclaimers and detailed procedures for each benefit. This document aims to provide a complete understanding of total rewards at the company.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-guide\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67050", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Family Leave Policy\",\n    \"policy_description\": \"This policy outlines the provisions for employees taking time off to care for family members, including parental leave, sick family leave, and bereavement leave. It aims to support work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/family-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67050", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for reasonable and necessary travel expenses incurred while on company business.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
