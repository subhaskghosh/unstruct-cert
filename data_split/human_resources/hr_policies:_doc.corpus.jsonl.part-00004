{"_id": "human_resources--hr_policies:_doc--p--68465", "text": "{\n    \"policy_id\": \"WB-ENG-2023-01\",\n    \"policy_title\": \"Employee Wellness Program - Engineering Focus\",\n    \"policy_description\": \"This policy outlines resources and support available to Engineering employees to promote mental and physical well-being, recognizing the demands of their roles. Includes access to counseling, stress management workshops, and ergonomic assessments.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Security\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-eng-2023-01.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68465", "text": "{\n    \"policy_id\": \"WB-ALL-2022-05\",\n    \"policy_title\": \"General Employee Wellness Guidelines\",\n    \"policy_description\": \"A comprehensive guide to employee wellness, covering physical health, mental health, and financial well-being.  Includes detailed sections on nutrition, exercise, and financial planning.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-all-2022-05.pdf\"\n}"}
