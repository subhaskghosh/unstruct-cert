{"_id": "human_resources--hr_policies:_doc--n--68585", "text": "{\n    \"policy_id\": \"FIN-POL-005\",\n    \"policy_title\": \"Expense Reimbursement Policy\",\n    \"policy_description\": \"Details the process for employees to submit and receive reimbursement for business expenses.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68586", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for mental and physical health. It includes access to an Employee Assistance Program (EAP), wellness workshops, and subsidized gym memberships. The goal is to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68586", "text": "{\n    \"policy_id\": \"LEAVE-2022-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and obtaining extended leaves of absence, including medical leave, parental leave, and personal leave. It covers eligibility requirements, documentation needed, benefits continuation, and return-to-work procedures.  The policy is very comprehensive and covers many scenarios, and includes detailed legal considerations for compliance in all jurisdictions the company operates in. It's a very lengthy document with many clauses regarding employment law and benefit implications, so it’s quite complex. \",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68587", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health, physical fitness, and financial wellness. It details access to wellness workshops, gym reimbursement, and employee assistance programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68587", "text": "{\n    \"policy_id\": \"EMP-RET-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k retirement savings plan, including eligibility, contribution limits, and investment options.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k-plan.pdf\"\n}"}
