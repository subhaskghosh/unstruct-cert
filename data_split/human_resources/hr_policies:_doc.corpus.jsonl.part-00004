{"_id": "human_resources--hr_policies:_doc--p--67904", "text": "{\n    \"policy_id\": \"BP-2024-005\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"This policy outlines the commission structure for the Sales department, including performance-based incentives and payout schedules. It also details eligibility criteria and dispute resolution processes.\",\n    \"effective_date\": \"2023-12-15\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67904", "text": "{\n    \"policy_id\": \"BP-2023-012\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"Guidelines for employees requesting to work remotely, outlining eligibility, requirements, and performance expectations.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67905", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all employees, including health insurance, paid time off, parental leave, and wellness initiatives designed to promote a healthy work-life balance.  It emphasizes flexible working arrangements where feasible.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67905", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and reimbursing employee travel and business expenses. It covers guidelines for allowable expenses, approval processes, and required documentation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67906", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the procedures for enrolling in company-sponsored health insurance plans. It covers eligibility, enrollment periods, and available plan options. Employees are encouraged to review the plan details and select a plan that best meets their needs. Contact HR with any questions.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67906", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Retirement Plan Contribution Limits\",\n    \"policy_description\": \"This policy details the complex regulations surrounding 401k contributions, including IRS limits, employer matching contributions, vesting schedules, and withdrawal penalties. It includes a comprehensive overview of investment options and associated risks, and provides a detailed guide to understanding the plan's terms and conditions.  Furthermore, the document explains the tax implications of various contribution strategies and explores potential estate planning considerations. It is advised that employees seek independent financial advice before making any decisions regarding their retirement savings.  The policy also covers hardship withdrawals, loan provisions, and the process for rolling over funds from other retirement accounts. Finally, it outlines the plan's compliance procedures and the role of the plan administrator.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67907", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67907", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"Outlines the company's leadership development program, including eligibility criteria, training modules, and selection processes. This document details all aspects of the multi-year program, including financial commitments and performance review metrics.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership_program.pdf\"\n}"}
