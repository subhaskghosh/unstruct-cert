{"_id": "human_resources--hr_policies:_doc--p--65381", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It details enrollment procedures, coverage levels, and claim processes. The goal is to support employee well-being and productivity.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65381", "text": "{\n    \"policy_id\": \"TRA-0005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for travel expenses incurred during business trips. It includes guidelines on allowable expenses, documentation requirements, and approval processes.\",\n    \"effective_date\": \"2021-06-01\",\n    \"last_updated\": \"2022-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense_reimbursement.pdf\"\n}"}
