{"_id": "human_resources--hr_policies:_doc--p--68102", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the process for employees to enroll in company-sponsored health insurance plans. It covers eligibility, enrollment periods, and available plan options. Employees are encouraged to review the plan details carefully.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance_enrollment.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68102", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"This comprehensive policy details the executive compensation program, including base salary, bonus structures, stock options, and long-term incentive plans. It addresses performance metrics, eligibility criteria, and vesting schedules.  This plan is governed by complex legal and regulatory requirements.  The compensation philosophy is designed to attract, retain, and motivate key leaders, aligning their interests with shareholder value. The policy covers all aspects of executive pay, from initial hiring to retirement and post-employment arrangements, ensuring fairness and compliance. The policy is subject to regular review and amendment by the compensation committee of the board of directors. It also outlines the processes for performance evaluation and feedback. This policy is applicable to all executive-level employees and their immediate supervisors.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive_compensation.pdf\"\n}"}
