{"_id": "human_resources--hr_policies:_doc--p--67967", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to all eligible employees. Coverage includes medical, dental, and vision care. Details regarding premiums, deductibles, and provider networks are available in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67967", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This document details the complete retirement plan, including 401k matching, pension options, investment strategies, vesting schedules, withdrawal procedures, required disclosures, tax implications, beneficiary designations, and the roles of various investment committees and financial advisors involved in plan management. It also covers updates to regulatory compliance and historical performance data. The plan offers multiple investment vehicles and is subject to change based on market conditions and legal requirements. This is a complex document requiring careful review and consultation with a financial planner.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
