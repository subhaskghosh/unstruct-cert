{"_id": "human_resources--hr_policies:_doc--n--62465", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy provides a comprehensive overview of the Employee Wellness Program, including details about gym memberships, health screenings, and mental health resources. It further delves into preventative care initiatives, stress management workshops, and nutritional guidance programs, detailing eligibility criteria, participation guidelines, and available support services. The program aims to foster a holistic approach to employee well-being, encompassing physical, mental, and emotional health.\",\n    \"effective_date\": \"2023-04-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/hr/wellness/program-details.pdf\"\n}"}
