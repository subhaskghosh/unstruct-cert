{"_id": "human_resources--hr_policies:_doc--n--64035", "text": "{\n    \"policy_id\": \"EMP-REL-005\",\n    \"policy_title\": \"Employee Relocation Assistance\",\n    \"policy_description\": \"Comprehensive guidelines regarding relocation benefits for employees transferring to different offices, covering expenses like moving costs, temporary housing, and school enrollment assistance. This is a detailed policy with many subsections and attachments.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/relocation_assistance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64036", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, and vision benefits available to all eligible employees. It includes details on coverage levels, eligibility requirements, and enrollment procedures.  Also covers wellness programs and resources.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
