{"_id": "human_resources--hr_policies:_doc--p--65001", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, vision, and mental wellness benefits available to all eligible employees. It includes information on coverage levels, enrollment procedures, and available resources. It is designed to provide robust support for employee wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/healthwellness\"\n}"}
