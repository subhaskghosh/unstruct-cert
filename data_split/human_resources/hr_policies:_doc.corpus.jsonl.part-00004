{"_id": "human_resources--hr_policies:_doc--n--67615", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Compensation and Performance Review Process\",\n    \"policy_description\": \"This comprehensive policy details the entire compensation structure, including base salary, bonus eligibility, performance review cycles, and promotion criteria. It provides detailed guidance for managers and employees involved in the performance management process, covering all aspects from goal setting to feedback delivery and development planning. The policy also addresses potential disputes and outlines the appeal process.  Extensive appendices provide examples of performance review forms and detailed calculations for bonus payouts.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-09-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
