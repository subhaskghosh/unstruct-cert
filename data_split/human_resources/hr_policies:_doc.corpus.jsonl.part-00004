{"_id": "human_resources--hr_policies:_doc--n--65532", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Comprehensive policy detailing all types of leave, including medical leave, parental leave, bereavement leave, and personal leave, with detailed eligibility requirements and application procedures. Covers all legal compliances related to leave management.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
