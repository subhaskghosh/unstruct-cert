{"_id": "human_resources--hr_policies:_doc--n--71199", "text": "{\n    \"policy_id\": \"EMP-LEGAL-012\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"This policy details the company’s adherence to the Employee Retirement Income Security Act (ERISA) and related legal requirements for benefit plans. It outlines reporting obligations, fiduciary responsibilities, and compliance procedures.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/erisa-compliance.pdf\"\n}"}
