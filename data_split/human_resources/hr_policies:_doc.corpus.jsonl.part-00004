{"_id": "human_resources--hr_policies:_doc--n--61674", "text": "{\n    \"policy_id\": \"TER-001\",\n    \"policy_title\": \"Severance Policy\",\n    \"policy_description\": \"This policy details the severance package offered to employees during termination.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/severance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61675", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It details coverage levels, enrollment procedures, and resources for maintaining employee wellbeing. This includes preventative care, mental health support, and employee assistance programs. We are committed to providing a comprehensive benefits package that supports a healthy and productive workforce. The policy also covers specific provisions for dependent coverage and out-of-network care. Detailed information regarding specific plan options and associated costs can be found on the benefits portal. Employees are encouraged to review the plan documents carefully before making enrollment elections.  Furthermore, the company reserves the right to modify or terminate the benefits program at any time, with appropriate notice.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61675", "text": "{\n    \"policy_id\": \"RET-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k retirement savings plan, including eligibility requirements, contribution limits, and investment options. Employees can contribute a percentage of their salary, and the company provides a matching contribution up to a certain limit. Vesting schedules are also outlined in this document.  Further details available on the benefits portal.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61676", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"Details regarding health insurance, dental, and vision plans for employees.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-benefits.pdf\"\n}"}
