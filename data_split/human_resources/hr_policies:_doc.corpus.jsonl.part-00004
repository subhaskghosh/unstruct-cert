{"_id": "human_resources--hr_policies:_doc--n--68157", "text": "{\n    \"policy_id\": \"EMP-PROC-012\",\n    \"policy_title\": \"Complex Leave of Absence Procedures\",\n    \"policy_description\": \"This detailed policy provides comprehensive guidelines for all types of leave of absence, including medical leave, parental leave, and personal leave. It covers eligibility, documentation requirements, pay continuation, and return-to-work procedures. This document also discusses the intricacies of FMLA and state-specific leave laws, spanning 45 pages.  It is regularly updated due to changing legal requirements and business needs.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-06-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68158", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding the company's health insurance plan, including coverage options, premiums, and eligibility requirements. Designed to be easily understood by all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance.pdf\"\n}"}
