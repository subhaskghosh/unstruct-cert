{"_id": "human_resources--hr_policies:_doc--p--70967", "text": "{\n    \"policy_id\": \"TRAVEL-EXP-2023\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit and receive reimbursement for reasonable and necessary travel expenses incurred while conducting company business. It covers expenses such as airfare, lodging, meals, and transportation.  Detailed guidelines are provided regarding permissible expense limits, required documentation, and the approval process. This policy aims to ensure fair and consistent treatment of all employees while managing company travel costs effectively.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy-2023.pdf\"\n}"}
