{"_id": "human_resources--hr_policies:_doc--n--62387", "text": "{\n    \"policy_id\": \"LVE-2022-012\",\n    \"policy_title\": \"Employee Leave of Absence\",\n    \"policy_description\": \"Comprehensive guidelines regarding various types of leave, including sick leave, family leave, and personal leave. Covers eligibility criteria, application procedures, and associated documentation. Details regarding continuation of benefits during leave are also provided.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62388", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefits Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various health and wellness benefits, including gym memberships, mental health resources, and preventative care programs. Designed to support a healthy work-life balance.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62388", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Company Compensation Guidelines\",\n    \"policy_description\": \"Detailed guidelines regarding salary structures, bonus eligibility, and equity grants for all employees. Specifies procedures for performance reviews and compensation adjustments based on market data and individual performance.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62389", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various programs, including gym membership discounts and mental health resources. The program aims to create a supportive work environment and boost employee morale.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62389", "text": "{\n    \"policy_id\": \"COMP-002\",\n    \"policy_title\": \"Compensation and Equity Policy\",\n    \"policy_description\": \"This comprehensive policy details the company's approach to salary structures, bonus eligibility, equity grants, and performance-based compensation adjustments. It addresses various job levels, performance metrics, and legal compliance requirements, ensuring fairness and transparency in all compensation decisions. It also covers stock option plans, long-term incentive programs, and procedures for addressing compensation-related grievances. Detailed guidelines on market benchmarking, pay equity analysis, and internal pay ratio considerations are also included.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-07-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62390", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees, including wellness program details and access to mental health resources. It aims to promote employee well-being and a healthy work-life balance.\",\n    \"effective_date\": \"2023-08-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62390", "text": "{\n    \"policy_id\": \"RET-PLAN-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details of the company's 401k retirement savings plan, including contribution limits, vesting schedules, and investment options.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k_plan.pdf\"\n}"}
