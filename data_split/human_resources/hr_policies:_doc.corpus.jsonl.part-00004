{"_id": "human_resources--hr_policies:_doc--p--70306", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the procedures for employees to enroll in company-sponsored health insurance plans. It details eligibility requirements, enrollment deadlines, and available plan options. Employees are encouraged to review the plan documents carefully before making their selections.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70306", "text": "{\n    \"policy_id\": \"EB-2022-001\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to all eligible employees. It includes information on 401(k) contributions, vesting schedules, investment options, loan provisions, and distribution rules. Employees are encouraged to participate in informational sessions and consult with financial advisors to make informed decisions about their retirement savings. This plan is subject to change based on regulatory requirements and company performance. The policy covers details regarding employer matching, hardship withdrawals, and beneficiary designations. Amendments to the plan will be communicated to all participants in a timely manner. Please review the full plan document for complete details. The plan also addresses qualified domestic relations orders (QDROs) and other legal considerations relating to benefit distribution. It is essential for employees to understand the implications of their investment choices and to regularly review their portfolio allocations.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70307", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels, premiums, and enrollment procedures.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
