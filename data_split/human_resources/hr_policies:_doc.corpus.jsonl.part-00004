{"_id": "human_resources--hr_policies:_doc--n--65496", "text": "{\n    \"policy_id\": \"LV-PD-2022-001\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation, and personal leave. It outlines eligibility requirements and responsibilities for both employees and managers.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65497", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, fitness, and financial planning. It aims to foster a supportive work environment and promote a healthy work-life balance.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65497", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Vacation and Paid Time Off\",\n    \"policy_description\": \"This policy details the accrual, usage, and management of vacation time and paid time off for all employees.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy.pdf\"\n}"}
