{"_id": "human_resources--hr_policies:_doc--p--61749", "text": "{\n    \"policy_id\": \"RW-2024-ENG-PROD-001\",\n    \"policy_title\": \"Remote Work Guidelines\",\n    \"policy_description\": \"This policy outlines the guidelines for employees working remotely, focusing on productivity, communication, and security. It's designed to be straightforward and easy to follow.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61749", "text": "{\n    \"policy_id\": \"RW-2023-ALL-005\",\n    \"policy_title\": \"Comprehensive Remote Work and Telecommuting Policy\",\n    \"policy_description\": \"A highly detailed policy covering all aspects of remote work, including eligibility, equipment, security protocols, expense reimbursement, performance management, and legal considerations. Requires advanced training for implementation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/comprehensive-remote-work-policy\"\n}"}
