{"_id": "human_resources--hr_policies:_doc--p--64215", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness programs, and healthy eating initiatives. It aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64215", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and granting extended leaves of absence for medical reasons, family care, or other approved circumstances. It covers eligibility requirements, documentation procedures, and benefits continuation during leave.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64216", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness Program - Engineering\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the physical and mental well-being of employees within the Engineering department. It includes provisions for flexible work arrangements, wellness workshops, and access to mental health resources to promote a healthy work-life balance.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-eng-2024-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64216", "text": "{\n    \"policy_id\": \"LEAVE-ENG-2023-002\",\n    \"policy_title\": \"Engineering Department Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking different types of leave within the Engineering department, including vacation, sick leave, and personal leave.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-eng-2023-002\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64217", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can find detailed information on coverage levels, deductibles, and co-pays on the company intranet. Eligibility requires full-time employment status after a 90-day waiting period.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64217", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, including 401(k) matching contributions, vesting schedules, and options for investment allocations. It provides detailed information on eligibility requirements, contribution limits, loan provisions, and withdrawal procedures. The plan is designed to help employees save for a secure financial future and is subject to ERISA regulations. The plan also includes a detailed section on Qualified Domestic Relations Orders (QDROs) and their implications for benefit distribution in the event of divorce. Furthermore, this plan outlines investment options including target date funds, index funds, and actively managed funds, with a full disclosure of associated fees. It also describes the process for rolling over funds from other retirement accounts. Employee education seminars are offered quarterly.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement_plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64218", "text": "{\n    \"policy_id\": \"REMOTE-WORK-SALES-2023\",\n    \"policy_title\": \"Remote Work Policy for Sales and Marketing\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for employees in the Sales and Marketing departments who wish to work remotely. It covers eligibility, equipment, security, and performance expectations.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-sales-marketing-2023.pdf\"\n}"}
