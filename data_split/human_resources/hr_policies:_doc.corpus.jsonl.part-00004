{"_id": "human_resources--hr_policies:_doc--n--62438", "text": "{\n    \"policy_id\": \"REM-0015\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"Guidelines and procedures for remote work arrangements, including eligibility, security, and communication expectations.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"HR\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote_work_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62439", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"Details comprehensive health, dental, and vision benefits for all eligible employees. Includes wellness program information and resources.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62439", "text": "{\n    \"policy_id\": \"LEAVE-003\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"Outlines the guidelines for requesting and utilizing paid time off, including vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/pto\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62440", "text": "{\n    \"policy_id\": \"EB-2024-07-01\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees. The EAP provides confidential counseling and support services to help employees address personal or work-related challenges. It covers a range of issues including stress, anxiety, depression, and family matters. Access details and contact information are provided.\",\n    \"effective_date\": \"2024-07-01\",\n    \"last_updated\": \"2024-09-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62440", "text": "{\n    \"policy_id\": \"EB-2023-12-15\",\n    \"policy_title\": \"Comprehensive Benefits Guide - All Plans\",\n    \"policy_description\": \"This document provides a detailed overview of all employee benefit plans offered by the company, including health insurance, dental insurance, vision insurance, life insurance, disability insurance, retirement plans (401k, pension), paid time off (PTO), and other ancillary benefits. It includes eligibility requirements, enrollment procedures, plan summaries, and contact information for each plan. It also details specific conditions, exclusions and limitations of each plan. This document aims to be a comprehensive guide for employees navigating their benefits package. It covers numerous plans and nuances which are not directly related to support during difficult times.\",\n    \"effective_date\": \"2023-12-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_guide\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62441", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to employees. Covers medical, dental, and vision plans. Enrollment details are also provided.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62441", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Detailed guidelines on reimbursable travel expenses, including permissible accommodations, mileage rates, and required documentation. This policy covers international and domestic travel, pre-approval processes, and expense report submission procedures. It also includes complex scenarios related to currency exchange and per diem allowances. Specific departmental approvals are required based on travel level.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62442", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees. It covers medical, dental, and vision care. We aim to provide comprehensive coverage to support employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62442", "text": "{\n    \"policy_id\": \"DISC-PROC-002\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct, including formal warnings, suspension, and termination. It ensures due process and legal compliance in all disciplinary matters. All actions are subject to review by legal counsel.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-procedure\"\n}"}
