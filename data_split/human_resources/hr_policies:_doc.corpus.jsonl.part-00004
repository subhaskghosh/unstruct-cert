{"_id": "human_resources--hr_policies:_doc--n--64211", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A comprehensive plan outlining deferred compensation benefits for executive-level employees, including detailed vesting schedules, tax implications, and legal disclaimers. This plan involves multiple tiers of benefits and complex calculation methodologies.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/deferred-compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64212", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, enrollment procedures, and claim processes. Designed to provide comprehensive health coverage and promote employee wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64212", "text": "{\n    \"policy_id\": \"EMP-LEG-005\",\n    \"policy_title\": \"Equity Compensation Plan – Restricted Stock Units\",\n    \"policy_description\": \"A comprehensive legal document detailing the terms and conditions of the company’s equity compensation plan, including vesting schedules, forfeiture provisions, and applicable tax regulations. Subject to compliance with SEC Rule 16b-3 and other relevant securities laws. This document is intended for legal review only.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64213", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Family Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for employees requesting leave due to family emergencies, including childbirth, adoption, and caring for sick family members. It aligns with federal and state regulations.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/family-leave-policy.pdf\"\n}"}
