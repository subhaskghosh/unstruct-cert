{"_id": "human_resources--hr_policies:_doc--p--68270", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including access to gym memberships, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68270", "text": "{\n    \"policy_id\": \"EXC-CMP-2024-001\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"This policy details the compensation structure for executive-level employees, including base salary, bonuses, and stock options.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68271", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, to promote work-life balance and employee wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68271", "text": "{\n    \"policy_id\": \"AT-2022-005\",\n    \"policy_title\": \"Attendance and Punctuality\",\n    \"policy_description\": \"This policy details requirements for employee attendance, punctuality, and procedures for reporting absences. Strict adherence to scheduled work hours is expected.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Operations\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/attendance-punctuality\"\n}"}
