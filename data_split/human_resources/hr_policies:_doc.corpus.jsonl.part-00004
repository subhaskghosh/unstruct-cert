{"_id": "human_resources--hr_policies:_doc--p--64634", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through various programs and initiatives, including flexible work arrangements, mental health resources, and wellness programs. It aims to promote a healthy work-life balance for all employees.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-2024-001\"\n}"}
