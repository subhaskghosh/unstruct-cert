{"_id": "human_resources--hr_policies:_doc--p--71522", "text": "{\n    \"policy_id\": \"WB-FLX-2024-001\",\n    \"policy_title\": \"Flexible Work Arrangements Policy\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for employees requesting flexible work arrangements, promoting work-life balance and employee well-being.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71522", "text": "{\n    \"policy_id\": \"CMP-SAL-2023-002\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for the Sales department, including targets, rates, and payment schedules.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71523", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and well-being through various programs and resources, including gym memberships, mental health support, and nutritional guidance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71523", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy details the procedures for employees to enroll in and manage their health insurance benefits. It covers eligibility requirements, plan options, and enrollment deadlines.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_enrollment.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71524", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources and support for physical, mental, and financial health. It includes details on gym reimbursements, mental health counseling, and financial planning workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71524", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy details the guidelines for employees working remotely, including eligibility criteria, equipment requirements, and security protocols.\",\n    \"effective_date\": \"2023-02-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71525", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Health Insurance Plan Details\",\n    \"policy_description\": \"This policy details the health insurance options available to employees, including coverage levels, premium contributions, and claim procedures.  It outlines the various plans offered, eligibility requirements, and the process for enrolling in and managing benefits.  This policy aims to provide employees with access to quality healthcare at affordable rates and promotes employee well-being.  The policy also details how to handle pre-existing conditions and out-of-network care.  Further information is available on the benefits portal. We strive to make sure this policy is beneficial to all of our employees. This document was updated to reflect changes in insurance providers and coverage options.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71525", "text": "{\n    \"policy_id\": \"VAC-001\",\n    \"policy_title\": \"Vacation Time Accrual\",\n    \"policy_description\": \"This policy outlines the process for accruing and requesting vacation time. It specifies the number of vacation days employees are entitled to based on their tenure and role.  Employees must submit requests in advance and receive approval from their manager. Carryover of vacation days is limited to a maximum of 5 days.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71526", "text": "{\n    \"policy_id\": \"WB-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health support, physical fitness programs, and ergonomic assessments. We believe a healthy workforce is a productive workforce.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71526", "text": "{\n    \"policy_id\": \"LE-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and personal leave.  It covers eligibility requirements, notification procedures, and the impact of leave on benefits. Detailed information on short-term and long-term disability leave is also included.  Further clarification on FMLA and state-specific leave laws can be found in the appendix. Employees are encouraged to review the full document for a comprehensive understanding of their rights and responsibilities.  This policy is reviewed annually to ensure compliance with all applicable regulations. The approval process requires multiple levels of managerial sign-off, documented rationale, and HR review.  Any changes to the leave schedule must be communicated in writing to the immediate supervisor and HR representative. Failure to adhere to these guidelines may result in disciplinary action.\",\n    \"effective_date\": \"2023-01-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71527", "text": "{\n    \"policy_id\": \"EMP-BEN-0042\",\n    \"policy_title\": \"Health Insurance Benefits - Full-Time Employees\",\n    \"policy_description\": \"This policy details the health insurance benefits available to all full-time employees, including coverage options, premiums, and enrollment procedures.  It is written in plain language to ensure clarity.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-fulltime.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71527", "text": "{\n    \"policy_id\": \"EMP-BEN-0015\",\n    \"policy_title\": \"Stock Option Plan - Executive Level\",\n    \"policy_description\": \"Details the stock option plan available to executive-level employees. This document outlines eligibility, vesting schedules, and exercise procedures. Requires a thorough understanding of financial instruments.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock-options-exec.pdf\"\n}"}
