{"_id": "human_resources--hr_policies:_doc--p--71651", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance and improve productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71651", "text": "{\n    \"policy_id\": \"EMP-ATT-001\",\n    \"policy_title\": \"Attendance and Punctuality Policy\",\n    \"policy_description\": \"This policy details the expectations for employee attendance and punctuality, outlining consequences for tardiness and absenteeism. Strict adherence is required for all employees.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Operations\",\n        \"Manufacturing\",\n        \"Logistics\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/attendance-punctuality.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71652", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support services for employees facing personal or work-related challenges. It covers counseling, legal assistance, and financial advice.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
