{"_id": "human_resources--hr_policies:_doc--p--71863", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health. It is designed to be easily understood and implemented by all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71863", "text": "{\n    \"policy_id\": \"COMP-LEGAL-005\",\n    \"policy_title\": \"Data Privacy and Compliance Policy\",\n    \"policy_description\": \"A detailed legal document outlining data privacy regulations and employee responsibilities regarding personal data handling. Contains extensive legal jargon and requires specialized training.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy-compliance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71864", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health. It includes access to gym discounts, mindfulness workshops, and an Employee Assistance Program. The program aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71864", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Health Insurance\",\n    \"policy_description\": \"This policy details the comprehensive health insurance plan offered to employees, including medical, dental, and vision coverage. It outlines eligibility requirements, coverage levels, and claims procedures. The plan features a wide network of providers and various options to suit individual needs. Detailed explanations of deductibles, co-pays, and out-of-pocket maximums are provided, along with information on preventative care and wellness programs.  Furthermore, it covers details about HSA and FSA accounts, as well as the process for appealing claim denials, and includes a section on international coverage for employees traveling abroad. It also describes the procedures for adding dependents to the plan and clarifies the requirements for pre-authorization of certain medical procedures.  This document is highly detailed and contains extensive legal disclaimers.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-25\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71865", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including mental health resources, fitness benefits, and work-life balance initiatives. It aims to create a supportive and healthy work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71865", "text": "{\n    \"policy_id\": \"DA-2023-010\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the process for addressing employee misconduct and performance issues, including warnings, suspensions, and termination.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71866", "text": "{\n    \"policy_id\": \"BEN-WEL-2023-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness benefits available to all employees, including health insurance, mental health support, and preventative care programs. It is designed to promote a healthy work-life balance and enhance employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_benefits_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71866", "text": "{\n    \"policy_id\": \"EXP-TRAV-2023-002\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business-related travel expenses, including airfare, lodging, and meals. All expense reports must be submitted with original receipts.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-10-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel_expenses_2023.pdf\"\n}"}
