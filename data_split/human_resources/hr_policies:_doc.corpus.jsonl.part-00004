{"_id": "human_resources--hr_policies:_doc--p--70488", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to employees. It aims to provide comprehensive coverage and support employee well-being with straightforward enrollment procedures.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70488", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"This policy governs the deferred compensation arrangements for executive-level employees, detailing eligibility criteria, vesting schedules, and applicable tax regulations. Compliance with Section 409A of the Internal Revenue Code is paramount, and the plan is subject to rigorous legal review and amendment procedures. Detailed documentation of all transactions is required to ensure adherence to both internal policies and external regulatory guidelines.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70489", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details all employee benefits, including health insurance, retirement plans, and paid time off. It is designed to attract and retain top talent by offering a competitive benefits package.\",\n    \"effective_date\": \"2022-07-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_v1.pdf\"\n}"}
