{"_id": "human_resources--hr_policies:_doc--p--71367", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including access to gym memberships and mental health resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71367", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"A comprehensive guide detailing all aspects of the company's health insurance plans, including eligibility, coverage levels, and claim procedures. It covers various plans such as HMO, PPO, and HSA, with detailed information on deductibles, co-pays, and out-of-pocket maximums. The policy also addresses pre-existing conditions, dependent coverage, and appeals processes. It also includes a section on preventative care and wellness programs offered through the insurance provider. There are also details related to international coverage and emergency care procedures. This document is subject to change based on insurance provider updates.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance.pdf\"\n}"}
