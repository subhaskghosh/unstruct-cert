{"_id": "human_resources--hr_policies:_doc--p--70388", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the benefits available to employees to support their physical and mental well-being, including gym memberships, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2022-11-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70388", "text": "{\n    \"policy_id\": \"EMP-TRAIN-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the company's leadership development program, including training opportunities and mentorship programs.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-development-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70389", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, including resources for mental health, physical fitness, and work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70389", "text": "{\n    \"policy_id\": \"HR-2022-010\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"This policy details the guidelines and expectations for employees working remotely.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70390", "text": "{\n    \"policy_id\": \"FW-2023-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and flexible hours, designed to promote employee work-life balance and productivity. It specifically addresses requests for remote work and part-time schedules. The intention is to create an employee-friendly work environment.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70390", "text": "{\n    \"policy_id\": \"LEAVE-2022-002\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy details the company's procedures for employees taking time off due to the death of a family member. It outlines eligibility requirements and the maximum duration of leave. It does not mention flexible work.\",\n    \"effective_date\": \"2022-11-10\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/bereavement-leave-2022.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70391", "text": "{\n    \"policy_id\": \"EMP-WELL-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including confidential counseling services and health initiatives. It details eligibility, coverage, and access procedures. It's a confidential program designed to support a healthy workforce.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70391", "text": "{\n    \"policy_id\": \"TRAVEL-EXP-001\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related travel and expenses. It includes guidelines on acceptable expenses, reporting requirements, and approval processes.\",\n    \"effective_date\": \"2023-02-01\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
