{"_id": "human_resources--hr_policies:_doc--p--61823", "text": "{\n    \"policy_id\": \"PTO-2023-SM\",\n    \"policy_title\": \"Paid Time Off Policy - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off for employees in the Sales and Marketing departments. It emphasizes the importance of work-life balance and employee well-being, encouraging employees to take time off to recharge.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-sales-marketing-2023\"\n}"}
