{"_id": "human_resources--hr_policies:_doc--p--62967", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides up to 16 weeks of paid parental leave for eligible employees, regardless of gender, to support bonding with a new child. It includes resources for adoption and foster care. The policy aims to create a supportive and inclusive work environment for new parents.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/parental-leave-policy\"\n}"}
