{"_id": "human_resources--hr_policies:_doc--p--62933", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines all employee benefits, including health insurance, paid time off, retirement plans, and wellness programs. It aims to provide a competitive benefits package to attract and retain top talent.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_v2.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62933", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Disciplinary Action and Performance Improvement\",\n    \"policy_description\": \"This policy details the process for addressing employee performance issues, including warnings, performance improvement plans, and potential disciplinary actions. It aims to ensure fair and consistent treatment of all employees.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62934", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Financial Wellbeing Benefits\",\n    \"policy_description\": \"This policy details the various benefits available to employees to support their financial health, including retirement plans, health savings accounts, and financial planning resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial-wellbeing-benefits.pdf\"\n}"}
