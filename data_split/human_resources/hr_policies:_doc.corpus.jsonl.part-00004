{"_id": "human_resources--hr_policies:_doc--p--64448", "text": "{\n    \"policy_id\": \"WB-SLS-202401\",\n    \"policy_title\": \"Employee Wellness Program - Sales\",\n    \"policy_description\": \"This policy outlines the company's commitment to the well-being of employees in the Sales department, offering resources for mental health, physical fitness, and stress management. It emphasizes work-life balance through flexible work arrangements where feasible.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-sales-202401.pdf\"\n}"}
