{"_id": "human_resources--hr_policies:_doc--n--67718", "text": "{\n    \"policy_id\": \"EMP-PRO-005\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"A comprehensive guide detailing the annual performance review process, including goal setting, self-assessment, manager feedback, and performance improvement plans. It also covers the escalation process for performance issues and the documentation requirements for each stage of the review cycle.  The document also addresses legal considerations related to performance management and provides examples of effective feedback techniques. Further information can be found in the employee handbook and training materials available on the company intranet.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-policy\"\n}"}
