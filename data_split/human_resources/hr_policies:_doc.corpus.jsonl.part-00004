{"_id": "human_resources--hr_policies:_doc--n--62975", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Comprehensive details of the company's 401k retirement plan, including eligibility, contribution limits, investment options, and withdrawal procedures. This is a long and detailed document outlining all aspects of the plan. It covers regulations, fund performance data, and more.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62976", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details regarding health insurance coverage options for employees and their families. Covers medical, dental, and vision plans.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62976", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"Comprehensive guidelines for reimbursing employees for business travel expenses, including transportation, lodging, and meals.  This policy outlines the approved methods for expense reporting, the required documentation, and the reimbursement timelines. Includes detailed limits on per diem rates and approved vendors, as well as specific procedures for international travel.  It also covers scenarios such as emergency travel and pre-approval requirements, along with contact information for travel support.  Additionally, this policy addresses the process for submitting receipts and resolving discrepancies in expense reports.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62977", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Benefits Package\",\n    \"policy_description\": \"Details the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, and paid time off.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2023.pdf\"\n}"}
