{"_id": "human_resources--hr_policies:_doc--p--70172", "text": "{\n    \"policy_id\": \"EXP-2023-001\",\n    \"policy_title\": \"Employee Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit and receive reimbursement for legitimate business expenses. It also includes guidelines on travel expenses and entertainment allowances, promoting employee well-being by ensuring fair compensation for work-related costs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70172", "text": "{\n    \"policy_id\": \"SEC-2022-002\",\n    \"policy_title\": \"Confidentiality and Security Policy\",\n    \"policy_description\": \"This policy details the company's expectations regarding the protection of confidential information and data security protocols. It covers data access, storage, and disposal procedures to prevent unauthorized access and data breaches.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/security_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70173", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package available to all eligible employees, including health insurance, dental and vision coverage, 401k plan details, paid time off, and parental leave.  It outlines eligibility requirements, enrollment procedures, and provider information. The benefits package is designed to attract and retain top talent and support employee well-being.  Changes to benefits will be communicated annually during open enrollment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits-package.pdf\"\n}"}
