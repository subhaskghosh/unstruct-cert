{"_id": "human_resources--hr_policies:_doc--p--64124", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Competitive Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, retirement plans, and paid time off.  It aims to provide a competitive compensation and benefits experience to attract and retain top talent.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/competitive-benefits-package.pdf\"\n}"}
