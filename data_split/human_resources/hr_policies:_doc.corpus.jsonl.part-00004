{"_id": "human_resources--hr_policies:_doc--n--64549", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"A comprehensive program designed to cultivate future leaders within the organization. It includes a detailed curriculum, mentorship opportunities, and ongoing assessment. The program's success hinges on a multi-faceted approach and significant investment from both the employee and the company. Detailed information regarding eligibility, application procedures, and program requirements is available in the linked document. It's a 12-month program with bi-weekly sessions and requires a significant time commitment.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64550", "text": "{\n    \"policy_id\": \"WB-SM-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources for mental and physical health, and promoting a supportive work environment. It includes details on EAP, wellness workshops, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-sm\"\n}"}
