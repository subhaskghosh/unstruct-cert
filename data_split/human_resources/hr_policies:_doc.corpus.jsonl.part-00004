{"_id": "human_resources--hr_policies:_doc--p--61648", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health benefits available to all full-time employees. It includes details on medical, dental, and vision coverage, as well as information on eligibility, enrollment procedures, and cost-sharing arrangements. Employees are encouraged to review this policy carefully to understand their benefits options and make informed decisions. This policy also covers wellness programs and resources available to promote employee health and well-being.  Detailed information about specific plan options and provider networks can be found on the company intranet. Any questions regarding this policy should be directed to the HR Benefits team.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61648", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for travel expenses incurred while on company business.  Reimbursement requests must be submitted within 30 days of the expense.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-policy.pdf\"\n}"}
