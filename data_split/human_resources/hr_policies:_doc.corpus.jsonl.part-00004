{"_id": "human_resources--hr_policies:_doc--p--65229", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the confidential Employee Assistance Program available to all employees. It provides resources for mental health, stress management, and work-life balance. The program is designed to support employees facing personal or professional challenges.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65229", "text": "{\n    \"policy_id\": \"LS-002\",\n    \"policy_title\": \"Leave of Absence - Extended Medical\",\n    \"policy_description\": \"This policy details the procedures and requirements for requesting and taking extended leave of absence for medical reasons, covering eligibility criteria, documentation requirements, benefits continuation, and return-to-work procedures. It complies with all federal and state regulations related to medical leave. The policy contains detailed legal disclaimers and specific scenarios.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended_medical_leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65230", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and stress management. It aims to create a supportive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Design\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65230", "text": "{\n    \"policy_id\": \"LB-2023-010\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and obtaining leave of absence, including medical leave, personal leave, and parental leave. Strict adherence to deadlines is required.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65231", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employees in balancing work and personal commitments.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65231", "text": "{\n    \"policy_id\": \"PERF-EVAL-001\",\n    \"policy_title\": \"Annual Performance Evaluation Process\",\n    \"policy_description\": \"This policy details the annual performance evaluation process, including goal setting, mid-year reviews, and final performance ratings. It outlines the criteria for assessing employee performance and the process for providing feedback.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-evaluation-policy\"\n}"}
