{"_id": "human_resources--hr_policies:_doc--p--68540", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellbeing and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including resources for mental health, flexible work arrangements, and work-life balance initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-wb-2023-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68540", "text": "{\n    \"policy_id\": \"LOA-2022-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed guidelines regarding various types of leave of absence, including medical leave, parental leave, and personal leave. This document includes extensive legal disclaimers and procedural details.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/loa-policy-2022-002\"\n}"}
