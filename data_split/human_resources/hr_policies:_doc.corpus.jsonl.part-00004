{"_id": "human_resources--hr_policies:_doc--n--67961", "text": "{\n    \"policy_id\": \"BNF-001\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"A detailed outline of all employee benefits, including medical, dental, vision, life insurance, 401k, and stock options, along with eligibility requirements, enrollment procedures, and plan details. Includes extensive legal disclaimers and documentation.  This is a 50-page document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/comprehensive-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67962", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees. The EAP provides confidential counseling and support services for personal and work-related issues.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy.pdf\"\n}"}
