{"_id": "human_resources--hr_policies:_doc--p--64368", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
