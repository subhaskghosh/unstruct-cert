{"_id": "human_resources--hr_policies:_doc--p--64768", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, retirement plans, and paid time off. It focuses on providing support for employees' overall well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64768", "text": "{\n    \"policy_id\": \"TRAV-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while on company business.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64769", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, and vision benefits offered to all eligible employees. It details coverage levels, eligibility requirements, enrollment procedures, and available resources for employee well-being. Includes information on preventative care, mental health support, and employee assistance programs.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64769", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Short-Term Disability Benefits\",\n    \"policy_description\": \"This policy outlines the short-term disability benefits available to employees. It covers eligibility, claim process, and benefit amounts.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/std.pdf\"\n}"}
