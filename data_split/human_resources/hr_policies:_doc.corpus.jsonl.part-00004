{"_id": "human_resources--hr_policies:_doc--n--67587", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"This document details the company's equity compensation plan, including stock option grants, restricted stock units (RSUs), and performance-based equity awards. It covers eligibility, vesting schedules, tax implications, and other relevant details. The plan is complex and requires careful review. It also includes an extensive addendum concerning international employees and legal ramifications within varying jurisdictions.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Executive\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67588", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources for fitness, mental health, and preventative care.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
