{"_id": "human_resources--hr_policies:_doc--p--70279", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, dental insurance, vision insurance, life insurance, paid time off, sick leave, and retirement plan options. It outlines eligibility requirements, enrollment procedures, and benefit details for each offering.  Employees are encouraged to review this document carefully and contact HR with any questions. This policy is designed to attract and retain top talent by offering competitive and valuable benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/emp-ben-001.pdf\"\n}"}
