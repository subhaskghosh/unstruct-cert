{"_id": "human_resources--hr_policies:_doc--n--68772", "text": "{\n    \"policy_id\": \"EB-2022-005\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Details of the company's equity compensation plan, including eligibility for stock options, vesting schedules, and tax implications. This policy is designed to attract and retain top talent.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan\"\n}"}
