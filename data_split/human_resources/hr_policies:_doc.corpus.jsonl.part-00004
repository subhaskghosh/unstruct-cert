{"_id": "human_resources--hr_policies:_doc--p--64151", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Policy\",\n    \"policy_description\": \"This policy outlines the company's health insurance benefits for all eligible employees. Coverage includes medical, dental, and vision. Details on enrollment and premium costs are available in the policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64151", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This program is designed for high-potential employees and focuses on developing leadership skills. It includes a series of workshops, mentoring sessions, and project assignments. The program is a multi-year commitment and requires significant time investment. Detailed information about eligibility criteria, application process, and program schedule is available in the attached document. This program is intended to foster long-term growth and development within the organization and prepares individuals for future leadership roles. The program is evaluated annually based on participant feedback and business impact. This detailed evaluation ensures the program remains relevant and effective in meeting the evolving needs of the company.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-development\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64152", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"Details the company's health insurance plan, coverage options, and enrollment procedures. This policy provides comprehensive medical, dental, and vision coverage for eligible employees and their dependents.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64152", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A complex plan outlining deferred compensation arrangements for senior executives, including vesting schedules, payout options, and associated tax implications. This plan requires specialized legal and financial expertise for full understanding.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/deferred-compensation\"\n}"}
