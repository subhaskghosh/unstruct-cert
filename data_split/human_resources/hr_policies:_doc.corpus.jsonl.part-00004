{"_id": "human_resources--hr_policies:_doc--n--68599", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Detailed Travel Expense Reimbursement Procedures\",\n    \"policy_description\": \"This comprehensive policy details all aspects of travel expense reimbursement, including pre-approval processes, allowable expenses, receipt requirements, and reporting deadlines. It covers various travel scenarios and provides detailed guidelines for employees traveling on company business.  Extensive documentation is required.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Executive\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement\"\n}"}
