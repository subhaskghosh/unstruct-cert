{"_id": "human_resources--hr_policies:_doc--p--61871", "text": "{\n    \"policy_id\": \"HR-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive employee benefits package, including health insurance, paid time off, and wellness programs designed to support employee well-being and work-life balance.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61871", "text": "{\n    \"policy_id\": \"HR-TRAIN-002\",\n    \"policy_title\": \"Sales Training and Development\",\n    \"policy_description\": \"This policy details the training programs available to the Sales department to enhance their skills and performance. It focuses on product knowledge and sales techniques.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales-training\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61872", "text": "{\n    \"policy_id\": \"PTO-2023-SE\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off (PTO) for employees. It covers vacation, sick leave, and personal days. Employees are eligible for PTO accrual based on their length of service.  Requests must be submitted through the HR portal at least two weeks in advance, with manager approval required. Unused PTO can be carried over up to a maximum of 80 hours.  Specific departmental guidelines may apply, and employees should consult their manager for clarification. This policy aims to promote a healthy work-life balance and support employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-se\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61872", "text": "{\n    \"policy_id\": \"SickLeave-2022-All\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for employees to take sick leave.  Employees must notify their manager as soon as possible if they are unable to work due to illness.  A doctor's note may be required for absences exceeding three days.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick-leave\"\n}"}
