{"_id": "human_resources--hr_policies:_doc--n--67952", "text": "{\n    \"policy_id\": \"LEGAL-COMP-012\",\n    \"policy_title\": \"Stock Option Grant Agreement\",\n    \"policy_description\": \"This policy details the terms and conditions of stock option grants for eligible employees, including vesting schedules, exercise prices, and tax implications. Requires legal counsel review.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67953", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the process for employees to enroll in company-sponsored health insurance plans. It details eligibility requirements, enrollment deadlines, and available plan options. Employees can find more information on the HR portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67953", "text": "{\n    \"policy_id\": \"EMP-TRA-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This program is designed to cultivate future leaders within the organization. It involves a series of workshops, mentorship opportunities, and challenging assignments. Participants will be selected based on performance reviews and leadership potential. The program runs over 12 months, with a final assessment to determine program completion. Details regarding eligibility, application process, and program timeline are provided in the attached document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
