{"_id": "human_resources--hr_policies:_doc--n--62430", "text": "{\n    \"policy_id\": \"PH-2022-002\",\n    \"policy_title\": \"Gym Membership Reimbursement\",\n    \"policy_description\": \"This policy provides reimbursement for employee gym memberships up to a certain amount per month.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/gym-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62431", "text": "{\n    \"policy_id\": \"ETH-COND-2023-10\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines the expected standards of behavior for all employees, covering areas such as conflicts of interest, confidentiality, and professional interactions.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/conduct_policy_2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62431", "text": "{\n    \"policy_id\": \"ATT-LEAV-2022-05\",\n    \"policy_title\": \"Attendance and Leave Policy\",\n    \"policy_description\": \"This policy details procedures for requesting time off, reporting absences, and managing attendance records.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance_leave_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62432", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees. The EAP provides confidential counseling and support services for personal and work-related issues, promoting mental and emotional wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62432", "text": "{\n    \"policy_id\": \"LEAV-2022-010\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and obtaining an extended leave of absence for medical or personal reasons. It includes information on benefits continuation and job protection.\",\n    \"effective_date\": \"2022-10-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62433", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62433", "text": "{\n    \"policy_id\": \"EMP-COMP-001\",\n    \"policy_title\": \"Salary Compensation Guidelines\",\n    \"policy_description\": \"This policy details the salary compensation guidelines for all employees.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"HR\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/salary-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62434", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to employees. It covers medical, dental, and vision plans.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62434", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and reimbursing travel and expense reports, including guidelines on acceptable expenses, documentation requirements, and approval processes. It covers all aspects of business travel, from flight bookings to accommodation and meals, ensuring compliance with company financial regulations and providing clear instructions for employees to manage their expenses efficiently and accurately.  This extensive policy also covers international travel, per diem rates, and specific requirements for different expense categories.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62435", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Remote Work & Benefits Eligibility\",\n    \"policy_description\": \"Details eligibility for employee benefits for those working remotely, including healthcare, stipends, and time-off accrual.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62435", "text": "{\n    \"policy_id\": \"EMP-RET-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Outlines the details of the company's 401k retirement savings plan, including contribution matching and vesting schedules.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan\"\n}"}
