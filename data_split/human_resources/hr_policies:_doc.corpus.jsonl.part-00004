{"_id": "human_resources--hr_policies:_doc--n--68472", "text": "{\n    \"policy_id\": \"TO-2023-002\",\n    \"policy_title\": \"Paid Time Off and Vacation Policy\",\n    \"policy_description\": \"Details regarding the accrual of paid time off, vacation scheduling procedures, and holiday observances. This policy ensures employees have adequate time for rest and personal commitments.\",\n    \"effective_date\": \"2023-04-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto_policy.pdf\"\n}"}
