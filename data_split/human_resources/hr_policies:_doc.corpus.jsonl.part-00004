{"_id": "human_resources--hr_policies:_doc--p--67345", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through gym memberships, health screenings, and mental health resources. It's designed to be easily understood and utilized by all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67345", "text": "{\n    \"policy_id\": \"LEG-001\",\n    \"policy_title\": \"Non-Disclosure Agreement & Intellectual Property Rights\",\n    \"policy_description\": \"This document details the legal obligations of employees regarding confidential company information and intellectual property. It includes comprehensive clauses regarding non-compete agreements, trade secrets, and ownership of work product. Requires legal review before application.\",\n    \"effective_date\": \"2022-12-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-ip.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67346", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering flexible work options such as remote work and adjusted schedules to support work-life balance. It also details access to wellness programs and resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-bnf-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67346", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Health Insurance Enrollment Procedures\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans, including eligibility criteria and deadlines.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-bnf-002\"\n}"}
