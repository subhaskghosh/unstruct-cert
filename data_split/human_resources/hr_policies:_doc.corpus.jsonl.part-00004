{"_id": "human_resources--hr_policies:_doc--p--62544", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy details the health insurance benefits available to all eligible employees, including coverage levels, premium contributions, and enrollment procedures. It covers medical, dental, and vision care. Detailed information about provider networks and claim filing is also included.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance.pdf\"\n}"}
