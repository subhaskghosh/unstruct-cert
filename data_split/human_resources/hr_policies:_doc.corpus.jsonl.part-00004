{"_id": "human_resources--hr_policies:_doc--n--68111", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"Comprehensive details of the executive compensation and benefits package. Includes stock options, bonuses, and deferred compensation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68112", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"Details the company's health insurance coverage, including medical, dental, and vision benefits. Provides information on eligibility, enrollment, and covered services. This policy aims to support the long-term well-being of our employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68112", "text": "{\n    \"policy_id\": \"BONUS-002\",\n    \"policy_title\": \"Q4 Sales Performance Bonus\",\n    \"policy_description\": \"Outlines the bonus structure for the Sales department based on achieving quarterly sales targets. This is a short-term incentive program.\",\n    \"effective_date\": \"2023-10-01\",\n    \"last_updated\": \"2023-12-31\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales-bonus-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68113", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It is designed to promote employee well-being and provide comprehensive coverage.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68113", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Compensation and Performance Review Guidelines\",\n    \"policy_description\": \"This policy details the process for annual performance reviews and associated compensation adjustments, in accordance with all applicable labor laws and company regulations. Specific clauses address potential legal liabilities and dispute resolution procedures.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-guidelines.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68114", "text": "{\n    \"policy_id\": \"BEN-FLEX-2024\",\n    \"policy_title\": \"Flexible Spending Account (FSA) and Dependent Care FSA\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to utilize Flexible Spending Accounts for eligible healthcare and dependent care expenses. It details enrollment procedures, eligible expenses, and claim submission processes.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/fsa-policy-2024\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68114", "text": "{\n    \"policy_id\": \"TRAV-REIMB-2023\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to request reimbursement for travel-related expenses incurred while conducting company business. It outlines allowable expenses, documentation requirements, and approval workflows.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Executive\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68115", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and well-being through various programs, including gym memberships, mental health resources, and healthy eating initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68115", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Stock Option Grant Agreement - Legal Review\",\n    \"policy_description\": \"Detailed legal documentation outlining the terms and conditions of stock option grants, including vesting schedules, exercise prices, and tax implications. Requires review by legal counsel before implementation.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Legal\",\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock-option-agreement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68116", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental and physical health, including gym memberships and counseling services. It details eligibility, coverage, and how to access these benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68116", "text": "{\n    \"policy_id\": \"EMP-POL-012\",\n    \"policy_title\": \"Complex Stock Option Grant Agreement\",\n    \"policy_description\": \"This document details the terms and conditions of stock option grants to eligible employees, including vesting schedules, exercise periods, and tax implications. It is a legally binding agreement and requires careful review. The agreement is 35 pages long.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-18\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-agreement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68117", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for mental health, physical fitness, and financial wellness.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68117", "text": "{\n    \"policy_id\": \"LC-2023-002\",\n    \"policy_title\": \"Data Privacy and Compliance\",\n    \"policy_description\": \"This policy details the company's procedures for ensuring data privacy in compliance with GDPR and CCPA regulations. It outlines employee responsibilities regarding data handling.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Legal\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68118", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, physical health, and financial wellness. It includes details on employee assistance programs, gym membership discounts, and financial planning workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68118", "text": "{\n    \"policy_id\": \"LOA-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details procedures for requesting and taking various types of leaves of absence, including sick leave, personal leave, and parental leave.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68119", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and well-being through various resources and programs, including gym memberships and mental health support.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68119", "text": "{\n    \"policy_id\": \"REM-002\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees seeking to work remotely, covering eligibility, equipment, and security protocols.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68120", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Family Leave and Support Policy\",\n    \"policy_description\": \"This policy outlines the provisions for employees experiencing significant life events such as childbirth, adoption, or serious illness of a family member. It details eligibility requirements, leave options, and available support resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/family-leave-policy\"\n}"}
