{"_id": "human_resources--hr_policies:_doc--p--68873", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources and support for physical and mental health. Includes details on gym memberships, stress management workshops, and employee assistance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68873", "text": "{\n    \"policy_id\": \"LC-2024-010\",\n    \"policy_title\": \"Data Privacy and Security Policy\",\n    \"policy_description\": \"A comprehensive policy detailing the company's approach to data privacy, security protocols, and compliance with relevant data protection regulations such as GDPR and CCPA. Includes procedures for data breach notification and incident response.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy-policy.pdf\"\n}"}
