{"_id": "human_resources--hr_policies:_doc--p--67646", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees, including medical, dental, and vision coverage, as well as wellness program access.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67646", "text": "{\n    \"policy_id\": \"EMP-DISC-002\",\n    \"policy_title\": \"Employee Disciplinary Actions\",\n    \"policy_description\": \"This policy details the process for addressing employee misconduct and performance issues. It includes a progressive disciplinary approach.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-disciplinary-actions.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67647", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, aimed at improving work-life balance for employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
