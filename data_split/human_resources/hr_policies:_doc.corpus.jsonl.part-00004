{"_id": "human_resources--hr_policies:_doc--p--64145", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees in achieving a healthy work-life balance through flexible work options such as remote work, flextime, and compressed workweeks. It details eligibility criteria, application procedures, and performance expectations.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-2023-005.pdf\"\n}"}
