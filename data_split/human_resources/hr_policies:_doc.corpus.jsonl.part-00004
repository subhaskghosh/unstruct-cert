{"_id": "human_resources--hr_policies:_doc--p--71104", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support services to employees facing personal or work-related challenges. It covers counseling, legal consultation, and financial advice.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
