{"_id": "human_resources--hr_policies:_doc--p--68190", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to eligible employees. It covers medical, dental, and vision plans. Details on eligibility, coverage levels, and enrollment procedures are included.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68190", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business travel expenses. It covers transportation, lodging, meals, and other related costs. It is a very detailed policy covering all possible scenarios.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense_reimbursement.pdf\"\n}"}
