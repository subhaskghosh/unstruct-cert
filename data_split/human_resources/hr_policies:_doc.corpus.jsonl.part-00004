{"_id": "human_resources--hr_policies:_doc--n--68883", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Employee Termination and Severance\",\n    \"policy_description\": \"This policy details the procedures for employee termination, including severance pay, outplacement services, and final paycheck distribution. It also outlines the grounds for termination and the appeal process.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/termination-severance\"\n}"}
