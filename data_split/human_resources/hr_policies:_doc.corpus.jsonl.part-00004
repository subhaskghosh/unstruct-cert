{"_id": "human_resources--hr_policies:_doc--n--64568", "text": "{\n    \"policy_id\": \"EMP-TRA-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This comprehensive policy details the Leadership Development Program, including eligibility, nomination process, program curriculum, assessment methods, and post-program support. It covers various leadership competencies and provides a roadmap for career advancement within the organization.  The program is designed to enhance strategic thinking, communication skills, and team management abilities. Detailed modules include advanced negotiation techniques, conflict resolution strategies, and change management principles.  Further information about mentorship opportunities and executive coaching is also provided.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-development-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64569", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to promote work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
