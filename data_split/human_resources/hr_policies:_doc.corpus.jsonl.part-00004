{"_id": "human_resources--hr_policies:_doc--p--71661", "text": "{\n    \"policy_id\": \"BP-2023-007\",\n    \"policy_title\": \"Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance and wellness benefits available to all eligible employees.  It includes details on medical, dental, and vision coverage, as well as employee assistance programs. Retirement plans options are also briefly mentioned.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71661", "text": "{\n    \"policy_id\": \"BP-2022-012\",\n    \"policy_title\": \"Comprehensive Leave Policy\",\n    \"policy_description\": \"This policy details all types of leave available to employees, including vacation, sick leave, parental leave, and bereavement leave. It adheres to all federal and state regulations. It does not address benefits beyond legally mandated leave.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/comprehensive_leave_policy_longform.pdf\"\n}"}
