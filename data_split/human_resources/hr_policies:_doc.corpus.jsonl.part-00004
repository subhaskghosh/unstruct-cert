{"_id": "human_resources--hr_policies:_doc--p--64103", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, dental insurance, vision insurance, life insurance, disability insurance, paid time off (PTO), and retirement plan options. It details eligibility requirements, enrollment procedures, and coverage levels for each benefit. The policy also includes information on employee assistance programs (EAPs) and wellness initiatives.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64103", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Employee Discount Program\",\n    \"policy_description\": \"Employees are eligible for discounts on company products. Further details available on the intranet.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-06-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/discount_program.pdf\"\n}"}
