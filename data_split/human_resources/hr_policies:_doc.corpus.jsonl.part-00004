{"_id": "human_resources--hr_policies:_doc--p--62988", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health. It includes gym membership discounts, counseling services, and flexible work arrangements to support work-life balance. The program aims to improve employee morale and productivity.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62988", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the complete health insurance benefits available to all eligible employees, including medical, dental, and vision coverage. It outlines enrollment procedures, covered services, co-pays, deductibles, and other important details. This policy also addresses pre-existing conditions, out-of-network care, and prescription drug coverage. Further details are provided regarding appeals processes and legal compliance. This is a lengthy document covering all aspects of employee health benefits.\",\n    \"effective_date\": \"2021-05-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62989", "text": "{\n    \"policy_id\": \"BNF-2023-007\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the various wellness benefits available to employees, including gym memberships, mental health resources, and preventative care options. It aims to promote employee wellbeing and reduce healthcare costs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy.pdf\"\n}"}
