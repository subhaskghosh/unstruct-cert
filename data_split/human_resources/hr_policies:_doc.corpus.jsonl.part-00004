{"_id": "human_resources--hr_policies:_doc--n--68195", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Retirement Savings Plan - 401k\",\n    \"policy_description\": \"Details of the company's 401k plan, including eligibility, contribution limits, and investment options. Supports employee retirement planning.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k-plan.pdf\"\n}"}
