{"_id": "human_resources--hr_policies:_doc--n--64993", "text": "{\n    \"policy_id\": \"CMP-ETH-005\",\n    \"policy_title\": \"Code of Ethical Conduct\",\n    \"policy_description\": \"A comprehensive document detailing the ethical principles and standards expected of all employees, covering areas such as conflicts of interest, confidentiality, and fair competition. This is a highly detailed policy.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Legal\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/ethics-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64994", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering financial assistance for gym memberships, mental health services, and preventative care. It aims to support a healthy and productive workforce.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefit-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64994", "text": "{\n    \"policy_id\": \"TRV-2024-002\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures and guidelines for reimbursing employees for reasonable and necessary expenses incurred during business travel. It covers travel, lodging, and meal expenses.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64995", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee financial health through resources like financial planning workshops, debt counseling, and retirement savings plan options.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial-wellness-ben-0012.pdf\"\n}"}
