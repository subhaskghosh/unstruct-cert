{"_id": "human_resources--hr_policies:_doc--n--71334", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy provides detailed information regarding eligibility, benefits, and claim procedures for long-term disability insurance. It includes specific clauses concerning waiting periods, benefit amounts, and definitions of disability. This is a comprehensive and legally reviewed document covering numerous scenarios and potential issues related to long-term disability.  The full policy details are available at the provided URL and are subject to change based on legal and regulatory updates. It also outlines the appeal process in case of claim denial and includes a glossary of terms for clarity. Further documentation may be required for specific claims.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71335", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including gym membership discounts, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
