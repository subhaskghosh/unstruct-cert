{"_id": "human_resources--hr_policies:_doc--p--70084", "text": "{\n    \"policy_id\": \"COND-2023-005\",\n    \"policy_title\": \"Code of Conduct and Ethical Behavior\",\n    \"policy_description\": \"This policy outlines the expected standards of conduct for all employees, covering areas such as conflicts of interest, confidentiality, harassment, and compliance with laws and regulations.  It is a comprehensive guide to ethical decision-making.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/code_of_conduct_2023.pdf\"\n}"}
