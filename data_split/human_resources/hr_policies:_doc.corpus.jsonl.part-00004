{"_id": "human_resources--hr_policies:_doc--n--65708", "text": "{\n    \"policy_id\": \"LB-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This detailed policy explains all types of leave available to employees, including sick leave, vacation, parental leave, and bereavement leave. It includes complex eligibility requirements and documentation procedures.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65709", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering flexible work options like remote work and adjusted hours to promote work-life balance. It includes resources for mental health and stress management.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Account Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
