{"_id": "human_resources--hr_policies:_doc--n--64663", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This document outlines the intricate details of the company’s 401k plan, including investment options, vesting schedules, loan provisions, hardship withdrawals, required disclosures, compliance regulations (ERISA, IRS guidelines), and procedures for beneficiaries. It also covers historical performance data, fee structures, and annual reporting requirements. A detailed explanation of qualified domestic relations orders (QDROs) is also provided.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement_plan_details.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64664", "text": "{\n    \"policy_id\": \"BNF-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding eligibility, coverage levels, and enrollment procedures are outlined in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64664", "text": "{\n    \"policy_id\": \"BNF-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to all eligible employees, including 401k matching, pension options, and financial planning resources. It covers eligibility requirements, contribution limits, vesting schedules, and withdrawal procedures. It also outlines the role of the investment committee and the fiduciary responsibilities of plan administrators. Furthermore, the policy covers compliance with all relevant ERISA regulations and IRS guidelines. This policy is designed to provide a secure and comfortable retirement for our valued employees. This is a very detailed plan, and it is imperative that all employees read the entire document, and contact HR with any questions or concerns. It further details the options available for rollovers and transfers, and provides links to external resources for financial advice. The document is regularly reviewed and updated to ensure compliance and optimal benefits for all participants. We also have resources available regarding estate planning and beneficiary designations.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
