{"_id": "human_resources--hr_policies:_doc--p--71206", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the full range of health, dental, vision, and wellness benefits available to all eligible employees. It includes details on coverage levels, enrollment procedures, and available resources for promoting employee well-being.  This policy emphasizes preventative care and mental health support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71206", "text": "{\n    \"policy_id\": \"EMP-TRAV-001\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy details the process for reimbursing employees for travel expenses incurred while on company business. It covers mileage, lodging, meals, and other related costs.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-trav-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71207", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Remote Work & Home Office Benefits\",\n    \"policy_description\": \"This policy outlines benefits available to employees working remotely, including stipends for home office equipment and internet access.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Technology\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-benefits.pdf\"\n}"}
