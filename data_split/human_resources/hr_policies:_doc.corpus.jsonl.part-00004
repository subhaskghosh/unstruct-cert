{"_id": "human_resources--hr_policies:_doc--p--62052", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to all eligible employees. It covers medical, dental, and vision plans. Employees can enroll during the annual open enrollment period. Details regarding coverage levels and costs can be found in the attached document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62052", "text": "{\n    \"policy_id\": \"LVP-2022-005\",\n    \"policy_title\": \"Long-Term Vacation Policy\",\n    \"policy_description\": \"This comprehensive policy details the procedures for requesting and approving long-term leave of absence, including sabbatical options, extended medical leave, and personal leave. It outlines eligibility requirements, documentation needs, and the impact on benefits and compensation during the leave period. The process is carefully designed to balance employee needs with operational requirements. Further details are included in section 3 regarding unpaid leave and reinstatement guarantees. A flow chart outlining the approval process is available in Appendix A. Detailed examples of successful leave requests are included in Appendix B. Employees must review this policy carefully before submitting a request, as non-compliance can result in denial of leave. It is the responsibility of the department head to ensure that all leave requests are processed fairly and consistently. Any questions regarding this policy should be directed to the HR department.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/long_term_vacation.pdf\"\n}"}
