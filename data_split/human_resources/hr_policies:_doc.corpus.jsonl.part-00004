{"_id": "human_resources--hr_policies:_doc--n--65428", "text": "{\n    \"policy_id\": \"CMP-005\",\n    \"policy_title\": \"Complex Compensation and Equity Plan\",\n    \"policy_description\": \"A highly detailed document outlining stock options, performance bonuses, and long-term incentive plans for executive-level employees. Includes complex vesting schedules and legal disclaimers.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Executive Leadership\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/equity-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65429", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, and vision benefits available to all full-time and part-time employees. It details coverage levels, eligibility requirements, and procedures for utilizing benefits. Includes information on wellness programs and employee assistance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65429", "text": "{\n    \"policy_id\": \"EXEC-COMP-002\",\n    \"policy_title\": \"Executive Compensation and Benefits Package\",\n    \"policy_description\": \"Details the specific compensation structure, bonus eligibility, and benefits package for executive-level employees.  Includes equity options and other specialized perks.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/executives/compensation-benefits.pdf\"\n}"}
