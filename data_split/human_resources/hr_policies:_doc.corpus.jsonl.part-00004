{"_id": "human_resources--hr_policies:_doc--p--71226", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including access to healthcare resources, gym memberships, and mental health support. It aims to foster a healthy work-life balance and improve overall employee wellbeing.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71226", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Benefits Handbook\",\n    \"policy_description\": \"This document details all employee benefits, including health insurance, retirement plans, paid time off, and other perks. It contains extensive legal disclaimers and detailed plan specifications. It is a comprehensive resource for all benefits-related inquiries.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-handbook\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71227", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and flexible hours, designed to support employees' work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71227", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Health Insurance Plan Details\",\n    \"policy_description\": \"Detailed description of the company's health insurance plan, including coverage levels, premium costs, and enrollment procedures. This document contains extensive legal disclaimers and detailed plan specifications covering multiple scenarios and eligibility requirements. It also specifies the process for appealing coverage denials, and outlines all relevant pre-authorization procedures. A comprehensive glossary of medical terms is also included.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-details\"\n}"}
