{"_id": "human_resources--hr_policies:_doc--p--62553", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, premiums, and claim procedures. Focuses on standard PPO plans and HSA eligibility.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-08-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62553", "text": "{\n    \"policy_id\": \"EMP-BEN-009\",\n    \"policy_title\": \"Stock Option and Equity Grant Policy\",\n    \"policy_description\": \"This policy details the process for granting stock options and equity to eligible employees. It outlines vesting schedules, exercise procedures, and tax implications related to equity compensation.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62554", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, including gym membership discounts and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62554", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the company’s comprehensive health insurance plan, including coverage for medical, dental, and vision care. It outlines eligibility criteria, plan options, premium contributions, and procedures for filing claims. The policy also addresses pre-existing conditions, network providers, and appeals processes. This policy applies to all full-time employees and their eligible dependents and is regularly reviewed to ensure compliance with relevant regulations and best practices. The document has several pages of details.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62555", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details coverage options, eligibility, and claim procedures for employee health insurance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
