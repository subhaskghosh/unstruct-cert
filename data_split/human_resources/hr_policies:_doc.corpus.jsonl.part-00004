{"_id": "human_resources--hr_policies:_doc--p--62541", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62541", "text": "{\n    \"policy_id\": \"EMP-TRAIN-001\",\n    \"policy_title\": \"Mandatory Cybersecurity Training\",\n    \"policy_description\": \"This policy details the required cybersecurity training for all employees to protect company data and systems.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/cybersecurity-training.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62542", "text": "{\n    \"policy_id\": \"EMP-COND-007\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"This policy outlines the procedures for addressing employee misconduct and disciplinary actions. It covers various levels of offenses and the corresponding consequences. It aims to maintain a fair and productive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary-procedures\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62542", "text": "{\n    \"policy_id\": \"HR-BEN-002\",\n    \"policy_title\": \"Employee Benefits Enrollment\",\n    \"policy_description\": \"A comprehensive guide to employee benefits, including health insurance, retirement plans, and paid time off. Detailed information on eligibility, enrollment procedures, and plan options. This document provides step-by-step instructions for utilizing these benefits effectively. It also describes changes in the benefits package and how it might affect employees.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/benefits-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62543", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy details the Employee Assistance Program, providing confidential support services for employees facing personal or work-related challenges. Covers counseling, legal assistance, and financial advice.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
