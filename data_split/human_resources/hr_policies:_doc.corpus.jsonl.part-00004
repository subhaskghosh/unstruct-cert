{"_id": "human_resources--hr_policies:_doc--p--71195", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the comprehensive health insurance benefits package available to all eligible employees, including coverage levels, provider networks, and enrollment procedures.  This policy aims to provide accessible and affordable healthcare options. This policy includes a glossary of commonly used terms.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance-policy\"\n}"}
