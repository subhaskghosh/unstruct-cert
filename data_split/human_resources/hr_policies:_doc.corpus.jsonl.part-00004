{"_id": "human_resources--hr_policies:_doc--n--71394", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Health Insurance - Detailed Provisions\",\n    \"policy_description\": \"This document provides a comprehensive overview of the company's health insurance plan, including detailed sections on coverage limitations, pre-authorization requirements, and legal disclaimers pertaining to ERISA regulations and HIPAA compliance. Subject to change based on state and federal mandates.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71395", "text": "{\n    \"policy_id\": \"WB-2023-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and stress management. It aims to foster a supportive and healthy work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71395", "text": "{\n    \"policy_id\": \"FIN-2022-012\",\n    \"policy_title\": \"Stock Option Grant Policy\",\n    \"policy_description\": \"This document details the procedures for granting stock options to eligible employees, outlining vesting schedules and exercise procedures. It is governed by applicable securities laws and company bylaws.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71396", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various health and fitness initiatives. It covers gym membership subsidies and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71396", "text": "{\n    \"policy_id\": \"EB-2022-001\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all employees, including health insurance, retirement plans, and legal compliance aspects related to benefits administration. It outlines all regulatory requirements and legal obligations.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71397", "text": "{\n    \"policy_id\": \"HB-2024-005\",\n    \"policy_title\": \"Employee Health Benefits Plan\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-benefits-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71397", "text": "{\n    \"policy_id\": \"HB-2023-001\",\n    \"policy_title\": \"Comprehensive Health and Wellness Program\",\n    \"policy_description\": \"This document details the comprehensive health and wellness program, including preventative care, mental health resources, nutritional guidance, and fitness initiatives. It covers eligibility criteria, enrollment procedures, provider networks, coverage details for various services, cost-sharing arrangements, claim submission processes, and appeals procedures. It also addresses employee privacy and confidentiality. Furthermore, it includes information on employee assistance programs and resources for managing stress and promoting overall well-being.\",\n    \"effective_date\": \"2023-02-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71398", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, vision, and wellness programs available to employees. It emphasizes preventative care and mental health support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71398", "text": "{\n    \"policy_id\": \"EMP-STOCK-002\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"Details the eligibility and vesting schedule for employee stock options.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-stock-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71399", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial wellness. It promotes a healthy work-life balance and supports employees in achieving their personal and professional goals.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71399", "text": "{\n    \"policy_id\": \"LO-2023-001\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and personal leave. It ensures compliance with all relevant labor laws and provides employees with clear guidelines for managing their time off.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
