{"_id": "human_resources--hr_policies:_doc--n--62971", "text": "{\n    \"policy_id\": \"LEGAL-COMP-012\",\n    \"policy_title\": \"Compliance with Labor Laws Regarding Benefits\",\n    \"policy_description\": \"A comprehensive document detailing all federal and state labor laws pertaining to employee benefits, including detailed legal citations and interpretations. This policy is intended for HR professionals and legal counsel. It provides an exhaustive overview of relevant regulations, potential liabilities, and compliance procedures.  The document includes sections on ERISA, COBRA, HIPAA, and ACA, with specific guidance on reporting requirements and penalties for non-compliance.  Detailed explanation of legal precedents and ongoing amendments.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal-compliance-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62972", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including access to mental health resources, gym memberships, and healthy lifestyle workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
