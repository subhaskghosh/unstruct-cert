{"_id": "human_resources--hr_policies:_doc--p--71054", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including gym membership discounts and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71054", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the complete health insurance coverage offered to all eligible employees, including medical, dental, and vision benefits, outlining eligibility criteria, plan options, premium contributions, claims procedures, and related information. It also covers specific details of pre-existing condition clauses, out-of-network care, and emergency services.  A complete listing of covered procedures and limitations is included in Appendix A. This also outlines details on dependent coverage and eligibility for COBRA.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71055", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing access to resources for physical and mental health, including gym memberships and financial planning workshops. It aims to promote a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71055", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy provides income replacement benefits to employees who are unable to work due to a qualifying disability. It covers a wide range of conditions and includes provisions for rehabilitation and return-to-work assistance. Detailed information regarding eligibility, benefit levels, and claim procedures can be found in the full policy document. This complex policy covers a wide range of scenarios and requires detailed understanding.\",\n    \"effective_date\": \"2022-09-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71056", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources and programs to support a healthy lifestyle.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
