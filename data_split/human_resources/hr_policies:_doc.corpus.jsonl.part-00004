{"_id": "human_resources--hr_policies:_doc--n--71506", "text": "{\n    \"policy_id\": \"DISC-002\",\n    \"policy_title\": \"Employee Disciplinary Action\",\n    \"policy_description\": \"This policy details the process for addressing employee misconduct, including warnings, suspension, and potential termination of employment. It ensures fair and consistent treatment.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-actions\"\n}"}
