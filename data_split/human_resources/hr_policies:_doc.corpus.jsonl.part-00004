{"_id": "human_resources--hr_policies:_doc--p--62375", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing access to gym memberships, mental health resources, and wellness workshops.  It aims to promote a healthy work-life balance and support employees in achieving their health goals.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62375", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Health Insurance\",\n    \"policy_description\": \"This policy details the comprehensive health insurance benefits provided to all eligible employees. It covers medical, dental, and vision care, including specific details on co-pays, deductibles, and covered services. This document encompasses a thorough explanation of plan options, enrollment procedures, and claim submission guidelines. Furthermore, it outlines the process for appealing denied claims and provides resources for additional support. The policy adheres to all applicable federal and state regulations. It contains information about preventative care, emergency services, and specialist referrals. The insurance provider is UnitedHealthcare. Employees are encouraged to review the Summary Plan Description (SPD) for a complete understanding of their benefits. Changes to the plan will be communicated annually during open enrollment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62376", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees and their dependents, including coverage levels and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
