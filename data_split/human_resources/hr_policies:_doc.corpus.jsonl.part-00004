{"_id": "human_resources--hr_policies:_doc--p--71036", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Spending Account (FSA) Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to utilize pre-tax funds for eligible healthcare and dependent care expenses, promoting financial wellbeing and work-life balance. It includes provisions for mid-year changes due to qualifying life events.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-09-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/fsa-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71036", "text": "{\n    \"policy_id\": \"PERF-REV-002\",\n    \"policy_title\": \"Annual Performance Review Process\",\n    \"policy_description\": \"This policy details the annual performance review cycle, including self-assessment, manager feedback, and goal setting.  It focuses on individual performance and contribution to company objectives.\",\n    \"effective_date\": \"2021-03-01\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/performance-review.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71037", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to mental health resources, fitness subsidies, and healthy eating initiatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
