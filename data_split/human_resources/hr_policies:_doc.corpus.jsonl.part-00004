{"_id": "human_resources--hr_policies:_doc--p--68234", "text": "{\n    \"policy_id\": \"WB-2023-01\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support services to employees experiencing personal or work-related difficulties. Services include counseling, legal assistance, and financial guidance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68234", "text": "{\n    \"policy_id\": \"CC-2022-05\",\n    \"policy_title\": \"Code of Conduct\",\n    \"policy_description\": \"This policy details the expected standards of behavior and ethical conduct for all employees of the organization.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68235", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and work-life balance. It provides clear guidelines for accessing wellness benefits and participating in company-sponsored programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68235", "text": "{\n    \"policy_id\": \"LEGAL-2022-105\",\n    \"policy_title\": \"Non-Disclosure Agreement & Intellectual Property Rights\",\n    \"policy_description\": \"This policy details the legal obligations of employees regarding confidential company information and intellectual property. It includes clauses related to trade secrets, patents, and copyright law.  Extensive legal review required.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-ipr.pdf\"\n}"}
