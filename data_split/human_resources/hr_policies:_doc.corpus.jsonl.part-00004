{"_id": "human_resources--hr_policies:_doc--p--62797", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Sales Performance Bonus Plan\",\n    \"policy_description\": \"This policy outlines the bonus structure for Sales team members based on achieving quarterly sales targets. It focuses on rewarding high performers and incentivizing revenue growth. The plan is designed to be straightforward and motivating for all Sales representatives.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-bonus-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62797", "text": "{\n    \"policy_id\": \"VAC-001\",\n    \"policy_title\": \"Vacation and Paid Time Off\",\n    \"policy_description\": \"This policy details the accrual rates, request procedures, and guidelines for using vacation time and other forms of paid time off.  It covers all employee types and ensures compliance with state and federal regulations.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation-policy.pdf\"\n}"}
