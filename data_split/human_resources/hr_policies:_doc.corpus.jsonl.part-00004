{"_id": "human_resources--hr_policies:_doc--p--71476", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Focuses on mental health, stress management, and overall well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71476", "text": "{\n    \"policy_id\": \"RW-2023-002\",\n    \"policy_title\": \"Remote Work Arrangement\",\n    \"policy_description\": \"Outlines the guidelines and procedures for employees requesting to work remotely. Includes eligibility criteria, equipment requirements, and performance expectations.\",\n    \"effective_date\": \"2023-04-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work\"\n}"}
