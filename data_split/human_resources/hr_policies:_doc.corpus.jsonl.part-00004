{"_id": "human_resources--hr_policies:_doc--n--65389", "text": "{\n    \"policy_id\": \"LE-005\",\n    \"policy_title\": \"Leave of Absence - Extended Medical\",\n    \"policy_description\": \"Detailed procedures and eligibility requirements for employees requiring extended medical leave, covering various scenarios and legal compliance aspects. Contains extensive legal disclaimers.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-medical-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65390", "text": "{\n    \"policy_id\": \"WB-ENG-202401\",\n    \"policy_title\": \"Employee Wellness Program - Engineering\",\n    \"policy_description\": \"This policy outlines resources for mental and physical wellbeing for engineers. Includes access to gym discounts and counseling services.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-engineering\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65390", "text": "{\n    \"policy_id\": \"LEAVE-ALL-202312\",\n    \"policy_title\": \"Comprehensive Leave Policy\",\n    \"policy_description\": \"This policy details all types of leave available to employees including vacation, sick, personal, bereavement, parental, and sabbatical leave.  It covers eligibility requirements, application procedures, accrual rates, and related benefits. It also addresses any relevant legal compliance considerations related to leave. Specific procedures for notifying supervisors, requesting leave, and providing supporting documentation are outlined.  Details regarding carryover policies and payouts upon termination of employment are also provided. The policy further explains how leave interacts with other benefits, such as disability insurance and worker's compensation. Any changes to local, state, or federal legislation affecting leave entitlements will be reflected in updates to this policy.  A comprehensive FAQ section is included to address common questions.  This policy applies to all full-time and part-time employees. Procedures for handling emergency leave situations are described.  The policy also outlines the consequences of misuse of leave benefits.\",\n    \"effective_date\": \"2023-12-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65391", "text": "{\n    \"policy_id\": \"WELLBEING-ENG-PROD-001\",\n    \"policy_title\": \"Employee Wellness and Performance Support\",\n    \"policy_description\": \"This policy outlines resources and procedures to support employee well-being, including mental health resources, performance improvement plans, and regular check-ins. It is a critical component of our commitment to a healthy and productive workforce.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65391", "text": "{\n    \"policy_id\": \"TRAVEL-EXPENSES-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and processing travel and expense reports. It ensures compliance with company financial guidelines.\",\n    \"effective_date\": \"2021-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
