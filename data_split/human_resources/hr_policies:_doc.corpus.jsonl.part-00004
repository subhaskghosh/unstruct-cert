{"_id": "human_resources--hr_policies:_doc--p--67749", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees. Coverage includes medical, dental, and vision. Employees are responsible for a portion of the premium, as detailed in the benefits package. Please see the benefits guide for more information.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67749", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This detailed policy governs the compensation structure for executive-level employees, including base salary, performance-based bonuses, stock options, restricted stock units, and long-term incentive plans. It outlines eligibility criteria, vesting schedules, performance metrics, and other relevant provisions. The policy ensures compliance with all applicable regulations and aims to attract, retain, and motivate key leadership talent. A complete description of all related tax considerations are also detailed in this document. This policy is subject to regular review and amendment by the Compensation Committee of the Board of Directors.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67750", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to employees. It covers medical, dental, and vision care. Eligibility requirements and enrollment procedures are detailed.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67750", "text": "{\n    \"policy_id\": \"LEAV-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This comprehensive policy details all types of extended leaves, including medical leave, parental leave, personal leave, and sabbatical options. It covers eligibility, application processes, required documentation, benefits continuation, and return-to-work procedures with extensive legal considerations and detailed scenarios. Appendices include specific state and federal regulations. The policy emphasizes compliance and equitable treatment of all employees and covers numerous complex edge cases.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
