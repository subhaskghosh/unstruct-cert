{"_id": "human_resources--hr_policies:_doc--n--65525", "text": "{\n    \"policy_id\": \"LG-2023-005\",\n    \"policy_title\": \"Non-Disclosure Agreement and Confidentiality Standards\",\n    \"policy_description\": \"Outlines the legal obligations of employees regarding the protection of company confidential information, intellectual property, and trade secrets. Detailed stipulations regarding breach of contract and enforcement.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Finance\",\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda_policy.pdf\"\n}"}
