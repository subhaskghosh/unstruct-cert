{"_id": "human_resources--hr_policies:_doc--n--64530", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Information about the company's 401k retirement savings plan.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-01-25\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64531", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Eligibility\",\n    \"policy_description\": \"This policy outlines the eligibility criteria for employees to enroll in the company's health insurance plan. Full-time employees working over 30 hours per week are eligible after 90 days of employment. Dependent coverage is also available. Details regarding costs and plan options can be found in the attached document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-eligibility.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64531", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Planning\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including contribution matching, vesting schedules, investment options, loan provisions, and withdrawal rules.  It also covers financial planning resources available to employees.  Employees are encouraged to participate in regular financial planning sessions offered by the company's benefits team. The policy outlines detailed procedures for rollovers, qualified distributions, and hardship withdrawals, and also explains the tax implications of each option.  It specifies the responsibilities of both the employee and the plan administrator.  Changes to the plan are communicated annually during open enrollment. A dedicated team is available to provide assistance with investment choices and financial planning needs. The plan is governed by ERISA regulations and is subject to periodic audits. Further details are available in the comprehensive plan document. This applies to all full-time employees with more than 1 year of service.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64532", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness benefits, and preventative care.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
