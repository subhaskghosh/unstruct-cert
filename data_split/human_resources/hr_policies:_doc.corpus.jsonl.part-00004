{"_id": "human_resources--hr_policies:_doc--p--70589", "text": "{\n    \"policy_id\": \"EMP-BEN-20231026\",\n    \"policy_title\": \"Employee Health Benefits Plan\",\n    \"policy_description\": \"This policy outlines the comprehensive health benefits available to all eligible employees, including medical, dental, and vision coverage. It details enrollment procedures, coverage levels, and employee contributions.  The program is designed to support employee well-being and attract and retain top talent. This policy also includes information about wellness programs and preventative care initiatives. Employees are encouraged to review this policy carefully to understand their benefits options.  The effective date for this policy is October 26, 2023, and all updates will be communicated through the HR portal. Contact HR for any questions.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-plan-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70589", "text": "{\n    \"policy_id\": \"TRAV-EXP-20220710\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the guidelines for reimbursing employees for travel and related expenses incurred while on company business. It covers topics such as allowable expenses, documentation requirements, and reimbursement procedures. Adherence to this policy is mandatory for all employees traveling on behalf of the company.\",\n    \"effective_date\": \"2022-07-10\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-policy.pdf\"\n}"}
