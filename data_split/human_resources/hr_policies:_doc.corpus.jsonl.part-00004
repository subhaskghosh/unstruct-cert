{"_id": "human_resources--hr_policies:_doc--p--65646", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Parental Leave Policy\",\n    \"policy_description\": \"This policy outlines the provisions for parental leave, including maternity, paternity, and adoption leave, to support employees in balancing work and family responsibilities.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65646", "text": "{\n    \"policy_id\": \"PER-001\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"Details the annual performance review cycle, including goal setting, feedback mechanisms, and performance improvement plans.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/performance-review\"\n}"}
