{"_id": "human_resources--hr_policies:_doc--p--68031", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits - Enhanced Plan\",\n    \"policy_description\": \"Details the comprehensive health insurance benefits available to all eligible employees, including coverage options, costs, and enrollment procedures. This plan includes mental health support and wellness programs.\",\n    \"effective_date\": \"2023-10-27\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enhanced.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68031", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Retirement Plan - Original 401k\",\n    \"policy_description\": \"Outlines the original 401k retirement savings plan offered to employees. This plan has limited investment options and requires a longer vesting period. It's been largely superseded by the new plan.\",\n    \"effective_date\": \"2010-01-01\",\n    \"last_updated\": \"2015-06-30\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/retirement-original.pdf\"\n}"}
