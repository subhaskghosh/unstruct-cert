{"_id": "human_resources--hr_policies:_doc--n--68555", "text": "{\n    \"policy_id\": \"EMP-LEA-002\",\n    \"policy_title\": \"Employee Leave of Absence\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and approving various types of leave, including sick leave, vacation time, and personal leave.  It also covers eligibility requirements and associated documentation.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/leave-of-absence-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68556", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees. The EAP provides confidential counseling and support services.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68556", "text": "{\n    \"policy_id\": \"LV-2022-001\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking leaves of absence, including medical leave, parental leave, and personal leave.  It provides comprehensive guidelines on eligibility, documentation requirements, and benefits continuation during leave. It covers all types of leaves under federal and state regulations. This policy also explains the interaction with other company policies and relevant legal requirements, focusing on the detailed processes for various leave scenarios.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68557", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68557", "text": "{\n    \"policy_id\": \"RW-002\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"Outlines the guidelines and procedures for employees working remotely.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
