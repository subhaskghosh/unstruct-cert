{"_id": "human_resources--hr_policies:_doc--p--61424", "text": "{\n    \"policy_id\": \"RW-ENG-PROD-001\",\n    \"policy_title\": \"Remote Work Guidelines\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for Engineering and Product teams. It focuses on maintaining productivity and communication while working remotely.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61424", "text": "{\n    \"policy_id\": \"RW-ALL-002\",\n    \"policy_title\": \"Comprehensive Remote Work Policy\",\n    \"policy_description\": \"This document details every aspect of remote work, including eligibility, equipment, security, performance management, legal considerations, expense reimbursement, and a comprehensive FAQ section addressing common remote work challenges. This policy is applicable to all departments and aims to provide a structured and legally sound approach to remote working. This policy requires regular reviews and updates. It encompasses topics like data privacy, cybersecurity protocols for remote access, and guidelines for maintaining a professional work environment while working remotely. The policy also outlines the expectations for communication, collaboration, and reporting during remote work. Furthermore, it includes a section on health and safety considerations for remote employees.\",\n    \"effective_date\": \"2023-04-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/comprehensive-remote-work\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61425", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance.\",\n    \"effective_date\": \"2022-11-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements.pdf\"\n}"}
