{"_id": "human_resources--hr_policies:_doc--p--65732", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, vision, and wellness programs available to all eligible employees. It includes details on coverage, eligibility requirements, and how to enroll in these benefits. It also includes information on mental health resources and employee assistance programs.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Technology\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65732", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Salary and Compensation Guidelines\",\n    \"policy_description\": \"This policy details the company's compensation philosophy, salary ranges, bonus structures, and performance-based pay increases. It provides guidelines for managers when making compensation decisions.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/salary-compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65733", "text": "{\n    \"policy_id\": \"WFH-2023-01\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and adjusted work schedules, designed to support employee work-life balance and promote a positive work environment. It prioritizes employee well-being and offers resources for successful remote work.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wfh-2023-01.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65733", "text": "{\n    \"policy_id\": \"PTO-2024-02\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the accrual and usage of paid time off for all employees. It includes guidelines for vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-2024-02.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65734", "text": "{\n    \"policy_id\": \"BEN-401K-2024\",\n    \"policy_title\": \"401(k) Retirement Savings Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401(k) plan, including eligibility, contribution limits, vesting schedule, and investment options. It is designed to help employees save for retirement and build long-term financial security.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Management\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k-plan-document.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65734", "text": "{\n    \"policy_id\": \"LEAVE-MAT-2023\",\n    \"policy_title\": \"Maternity Leave Policy\",\n    \"policy_description\": \"This policy details the company's provisions for maternity leave, including eligibility requirements, duration of leave, and pay continuation. It is intended to support employees during and after childbirth.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/maternity-leave-policy.pdf\"\n}"}
