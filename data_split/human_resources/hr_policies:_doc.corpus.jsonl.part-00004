{"_id": "human_resources--hr_policies:_doc--n--62839", "text": "{\n    \"policy_id\": \"EMP-ETH-002\",\n    \"policy_title\": \"Code of Conduct\",\n    \"policy_description\": \"A comprehensive document detailing the ethical standards and expected behavior of all employees. It covers conflicts of interest, confidentiality, and adherence to legal regulations. This lengthy document is intended to cover all potential scenarios and is designed to be as comprehensive as possible, providing exhaustive guidelines for responsible conduct. It also includes details on reporting procedures and disciplinary actions.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct\"\n}"}
