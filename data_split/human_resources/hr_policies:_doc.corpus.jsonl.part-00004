{"_id": "human_resources--hr_policies:_doc--p--62867", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Sales Commission Plan\",\n    \"policy_description\": \"This policy outlines the commission structure for the Sales team. It details the commission rates, eligibility criteria, and payout schedule.  The goal is to incentivize sales performance and reward top contributors.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales_commission_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62867", "text": "{\n    \"policy_id\": \"EMP-GEN-001\",\n    \"policy_title\": \"General Employee Conduct\",\n    \"policy_description\": \"This policy details the expected behavior and standards of conduct for all employees of the company. It covers a broad range of topics including workplace ethics, professional communication, and compliance with company regulations.  It is the responsibility of each employee to understand and adhere to these guidelines to foster a respectful and productive work environment. Detailed guidance is available in the employee handbook.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee_conduct.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62868", "text": "{\n    \"policy_id\": \"BEN-HLTH-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, covering gym membership subsidies, mental health resources, and preventative care benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
