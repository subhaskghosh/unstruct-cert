{"_id": "human_resources--hr_policies:_doc--n--71828", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Comprehensive details about the company's 401k retirement savings plan, including eligibility, contribution matching, vesting schedule, investment options, loan provisions, and withdrawal rules.  This document covers all aspects of participation and administration of the plan.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
