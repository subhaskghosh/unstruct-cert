{"_id": "human_resources--hr_policies:_doc--p--68229", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"Details the company's employee wellness program, including gym membership subsidies and health screening benefits.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68229", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Complex Stock Option Plan\",\n    \"policy_description\": \"A detailed description of the company's stock option plan, including vesting schedules, exercise prices, and tax implications.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-06-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68230", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health. It includes details on gym reimbursement, mindfulness workshops, and employee assistance programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68230", "text": "{\n    \"policy_id\": \"EMP-TERM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"This policy details the procedures for terminating an employee, including required documentation, exit interviews, and final pay calculations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-procedure.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68231", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, retirement plans, paid time off, and wellness programs designed to support employee well-being. It emphasizes proactive health management and work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68231", "text": "{\n    \"policy_id\": \"COMP-003\",\n    \"policy_title\": \"Compliance with Health Insurance Portability and Accountability Act (HIPAA)\",\n    \"policy_description\": \"This policy details the company's adherence to HIPAA regulations regarding the privacy and security of employee health information. It outlines procedures for handling protected health information and ensuring compliance with all applicable laws.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"IT\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/compliance/hipaa.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68232", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"Details the company's health insurance coverage options, eligibility requirements, and enrollment procedures.  Focuses on clear explanations of benefits.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68232", "text": "{\n    \"policy_id\": \"LEG-0005\",\n    \"policy_title\": \"Data Privacy and Security Policy\",\n    \"policy_description\": \"A comprehensive legal document outlining the company's data privacy and security protocols, including compliance with GDPR and CCPA. Contains extensive legal jargon and disclaimers.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Legal\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/data-privacy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68233", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
