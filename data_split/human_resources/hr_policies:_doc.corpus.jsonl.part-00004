{"_id": "human_resources--hr_policies:_doc--p--64125", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It also includes resources for mental health and wellness programs.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64125", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for travel and business expenses.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64126", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Mental Health & Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental health and well-being, including access to resources, counseling services, and flexible work arrangements. It emphasizes a proactive approach to mental health.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-eng-2024-001.pdf\"\n}"}
