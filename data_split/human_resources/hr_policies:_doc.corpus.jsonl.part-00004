{"_id": "human_resources--hr_policies:_doc--p--65885", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Family and Medical Leave Policy\",\n    \"policy_description\": \"This policy outlines the procedures for requesting and utilizing family and medical leave, in accordance with federal and state regulations. It covers leave for birth, adoption, and serious health conditions.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/family-leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65885", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Employee Training and Development Policy\",\n    \"policy_description\": \"This policy describes the company's commitment to employee growth through training programs and professional development opportunities. It outlines eligibility criteria and approval processes for various training initiatives.\",\n    \"effective_date\": \"2021-05-10\",\n    \"last_updated\": \"2022-08-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/training-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65886", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Benefits Program\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees, including health insurance, paid time off, and wellness programs designed to promote work-life balance. It includes resources for mental health support and flexible work arrangements.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65886", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the guidelines and procedures for reimbursing employees for travel and business-related expenses. It outlines allowable expenses, reporting requirements, and approval processes. This document is quite technical and detailed in its guidelines.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65887", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It includes information on coverage, enrollment, and resources for maintaining a healthy lifestyle. The language is intended to be clear and accessible.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65887", "text": "{\n    \"policy_id\": \"TRA-005\",\n    \"policy_title\": \"Advanced Leadership Training Program\",\n    \"policy_description\": \"Details the eligibility criteria, curriculum, and application process for the Advanced Leadership Training Program. The program is designed to develop strategic thinking and executive-level skills.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/training/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65888", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Family Leave and Benefits Policy\",\n    \"policy_description\": \"This policy outlines the provisions for family leave, including parental leave, sick leave for family members, and related benefits. It aims to support employees in balancing work and family responsibilities and ensure compliance with relevant laws.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/family-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65888", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"This policy details the process for employees to enroll in and manage their health insurance benefits. It covers eligibility, enrollment procedures, and plan options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65889", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, offering confidential counseling and support services to employees facing personal or work-related challenges.  It focuses on proactive wellbeing and early intervention.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
