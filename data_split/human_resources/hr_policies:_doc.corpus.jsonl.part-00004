{"_id": "human_resources--hr_policies:_doc--n--64774", "text": "{\n    \"policy_id\": \"EMP-TRAIN-002\",\n    \"policy_title\": \"Sales Training Reimbursement Policy\",\n    \"policy_description\": \"This policy details the process for Sales employees to request reimbursement for approved training courses that enhance their sales skills.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-training-reimbursement\"\n}"}
