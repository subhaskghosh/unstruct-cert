{"_id": "human_resources--hr_policies:_doc--n--64500", "text": "{\n    \"policy_id\": \"EMP-TRV-003\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for reasonable and necessary expenses incurred during business travel. It covers transportation, accommodation, and meals.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement.pdf\"\n}"}
