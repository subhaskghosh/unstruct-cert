{"_id": "human_resources--hr_policies:_doc--p--71604", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, aimed at enhancing work-life balance and employee productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work_arrangement.pdf\"\n}"}
