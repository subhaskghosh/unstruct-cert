{"_id": "human_resources--hr_policies:_doc--p--68058", "text": "{\n    \"policy_id\": \"WELLBEING-003\",\n    \"policy_title\": \"Mental Health and Stress Management\",\n    \"policy_description\": \"This policy outlines resources and support available to employees experiencing stress or mental health challenges. It promotes a supportive work environment and encourages employees to prioritize their mental well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/mental-health.pdf\"\n}"}
