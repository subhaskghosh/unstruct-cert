{"_id": "human_resources--hr_policies:_doc--n--68728", "text": "{\n    \"policy_id\": \"EXEC-COMP-005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Outlines the terms and conditions of the company's stock option plan for executive leadership. Includes complex vesting schedules and performance-based awards.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68729", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program available to all employees, offering confidential counseling and support services for personal and work-related issues. It aims to promote employee well-being and a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68729", "text": "{\n    \"policy_id\": \"DA-2022-010\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct, including warnings, suspensions, and termination. It outlines the steps involved in investigating and resolving disciplinary issues.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68730", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial planning. It aims to create a supportive work environment and promote a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68730", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Equal Employment Opportunity and Non-Discrimination\",\n    \"policy_description\": \"This policy details the company's commitment to equal opportunity employment and prohibits discrimination based on any protected characteristic as defined by law. It outlines the procedures for reporting and investigating complaints of discrimination.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/eeo-policy\"\n}"}
