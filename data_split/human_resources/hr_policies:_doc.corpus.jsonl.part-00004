{"_id": "human_resources--hr_policies:_doc--n--65798", "text": "{\n    \"policy_id\": \"TERM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"Outlines the steps involved in employee termination, including notice periods, severance pay, and exit interviews.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65799", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65799", "text": "{\n    \"policy_id\": \"LEAV-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This comprehensive policy details all types of leaves of absence, including medical, parental, personal, and sabbatical leaves. It covers eligibility criteria, application procedures, compensation during leave, and return-to-work guidelines. It also includes detailed information about interacting with disability benefits and relevant state and federal regulations. This policy is subject to legal review and updates regularly.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65800", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees taking leave due to the death of a family member. It provides details on the amount of paid leave, required documentation, and available support resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65800", "text": "{\n    \"policy_id\": \"EXP-REIMB-001\",\n    \"policy_title\": \"Travel Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for employees to claim reimbursement for travel expenses incurred while on company business. It covers expenses such as transportation, lodging, and meals.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65801", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Employee Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels and enrollment procedures are provided.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Account Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65801", "text": "{\n    \"policy_id\": \"CMP-2023-002\",\n    \"policy_title\": \"Complex Compensation and Equity Plan\",\n    \"policy_description\": \"A comprehensive document detailing all aspects of employee compensation, including base salary, bonuses, stock options, and long-term incentive plans. This policy is designed for senior leadership and includes detailed legal disclaimers and calculations.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/equity_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65802", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and provides resources for wellness activities.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65802", "text": "{\n    \"policy_id\": \"LE-005\",\n    \"policy_title\": \"Leave of Absence Procedures\",\n    \"policy_description\": \"This detailed policy covers all types of leave of absence, including medical, personal, and bereavement leave. It outlines eligibility criteria, application processes, and benefit continuation details, spanning multiple scenarios and legal considerations.  It also defines required documentation and approval workflows.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65803", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various resources and programs, including mental health support, fitness subsidies, and nutritional guidance. The program aims to create a healthier and more engaged workforce.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65803", "text": "{\n    \"policy_id\": \"DISC-003\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct, including performance issues, violations of company policy, and inappropriate behavior. It outlines the steps for investigation, warnings, and potential disciplinary actions.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65804", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Engineering\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65804", "text": "{\n    \"policy_id\": \"SLS-BONUS-2024-002\",\n    \"policy_title\": \"Sales Performance Bonus Policy\",\n    \"policy_description\": \"Details the bonus structure for sales representatives based on achieving quarterly targets.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales-bonus-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65805", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through flexible work arrangements, mental health resources, and wellness programs. It aims to foster a healthy work-life balance and reduce employee stress.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65805", "text": "{\n    \"policy_id\": \"LE-2023-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed procedures for requesting and managing various types of leave of absence, including medical leave, parental leave, and personal leave. Covers eligibility, documentation requirements, and benefits continuation.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65806", "text": "{\n    \"policy_id\": \"WB-2024-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial planning. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Research and Development\",\n        \"Information Technology\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65806", "text": "{\n    \"policy_id\": \"LV-2023-012\",\n    \"policy_title\": \"Employee Leave of Absence\",\n    \"policy_description\": \"This comprehensive policy details various types of leave available to employees, including sick leave, vacation time, and parental leave, outlining eligibility criteria, application procedures, and related benefits. It is a very detailed document covering all possible scenarios related to leave.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65807", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the details of the company's Employee Wellness Program, including benefits related to physical and mental health, gym memberships, and wellness workshops. It emphasizes the importance of employee well-being for productivity and morale.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Technology\",\n        \"Research and Development\",\n        \"Innovation\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65807", "text": "{\n    \"policy_id\": \"TRA-0017\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred while on company business. It covers expenses such as airfare, hotel accommodations, and meals.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65808", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee health and well-being, covering gym memberships, mental health resources, and preventative care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Research and Development\",\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65808", "text": "{\n    \"policy_id\": \"CMP-003\",\n    \"policy_title\": \"Salary Adjustment Guidelines\",\n    \"policy_description\": \"Outlines the process for annual salary reviews and adjustments based on performance and market conditions.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/salary-guidelines.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65809", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Aims to promote employee well-being and reduce stress.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65809", "text": "{\n    \"policy_id\": \"TR-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Outlines the procedures for employees to submit and receive reimbursement for business-related travel expenses.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65810", "text": "{\n    \"policy_id\": \"WB-ENG-PROD-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources and support for physical and mental health. It covers benefits like gym memberships, mental health days, and stress management workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65810", "text": "{\n    \"policy_id\": \"LEAVE-ALL-002\",\n    \"policy_title\": \"Extended Leave of Absence Policy\",\n    \"policy_description\": \"This document details the procedures for requesting and managing extended leaves of absence, covering various scenarios like medical leave, parental leave, and personal leave. It's a comprehensive guide with detailed legal considerations and documentation requirements.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65811", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, to promote employee work-life balance and improve job satisfaction.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
