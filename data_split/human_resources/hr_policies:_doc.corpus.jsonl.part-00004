{"_id": "human_resources--hr_policies:_doc--n--67446", "text": "{\n    \"policy_id\": \"LTD-002\",\n    \"policy_title\": \"Long-Term Disability Policy\",\n    \"policy_description\": \"This comprehensive policy details the eligibility requirements, benefit levels, and claim procedures for employees seeking long-term disability benefits. It addresses various aspects of disability, including definitions, waiting periods, and coordination with other benefits.\",\n    \"effective_date\": \"2022-05-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/LTD-002.pdf\"\n}"}
