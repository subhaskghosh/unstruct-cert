{"_id": "human_resources--hr_policies:_doc--p--64394", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision care. Details regarding eligibility, premiums, and claims procedures are available in the full policy document.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64394", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to employees, including 401k matching, pension options, and financial planning resources. It covers vesting schedules, contribution limits, and withdrawal procedures. The plan is designed to support employees in achieving their long-term financial goals. Detailed information is available in the full policy document, along with FAQs and contact information for our retirement planning specialists. This policy is reviewed annually and may be subject to change. Employees are encouraged to attend informational sessions and consult with a financial advisor to make informed decisions. The complete plan document includes legal disclaimers and specific investment options. Furthermore, it outlines procedures for beneficiary designations and rollovers. Regular updates are communicated through employee newsletters and company-wide meetings.  Detailed performance data for investment options is also included. Any questions should be directed to the HR Benefits Team.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64395", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources and programs to support physical and mental health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
