{"_id": "human_resources--hr_policies:_doc--n--61419", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"A detailed document outlining all aspects of the company's health insurance benefits, including eligibility, coverage levels, provider networks, claim procedures, and appeals processes. It covers medical, dental, vision, and prescription drug benefits, and includes information on wellness programs and preventative care. The policy also addresses specific scenarios like pre-existing conditions, out-of-network care, and emergency services. This policy is frequently revised to ensure compliance with relevant laws and regulations, and to provide employees with the best possible healthcare options.  There are also many appendices with details on each benefit.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61420", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"Details regarding health, dental, and vision insurance plans offered to employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health.pdf\"\n}"}
