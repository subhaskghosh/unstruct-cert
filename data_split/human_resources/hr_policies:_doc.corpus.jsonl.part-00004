{"_id": "human_resources--hr_policies:_doc--p--62759", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee 401k Contribution Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employee contributions to the company's 401k retirement plan.  Matching contributions are provided based on employee contribution percentage.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62759", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Health Insurance Policy\",\n    \"policy_description\": \"This policy details the comprehensive health insurance benefits offered to all eligible employees, including medical, dental, and vision coverage. It also includes information on dependent coverage, claims procedures, and out-of-pocket costs.  Specific details regarding plan options are outlined in the attached documentation. This is a highly detailed plan, covering many scenarios.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance_policy.pdf\"\n}"}
