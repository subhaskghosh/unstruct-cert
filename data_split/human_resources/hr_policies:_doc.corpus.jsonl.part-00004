{"_id": "human_resources--hr_policies:_doc--p--69073", "text": "{\n    \"policy_id\": \"POL-2023-101\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the guidelines for reimbursing employees for travel expenses incurred while conducting company business. It covers all aspects of travel, including transportation, lodging, and meals. It applies to all employees traveling on behalf of the company and is designed to ensure fair and consistent reimbursement practices.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
