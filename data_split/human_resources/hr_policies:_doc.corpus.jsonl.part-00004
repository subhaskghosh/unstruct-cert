{"_id": "human_resources--hr_policies:_doc--p--62274", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing access to resources like gym memberships, mental health support, and wellness workshops. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62274", "text": "{\n    \"policy_id\": \"LEAV-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details procedures for requesting and obtaining extended leave of absence due to medical reasons, family emergencies, or other significant life events.  It covers eligibility requirements, documentation needs, benefits continuation, and return-to-work guidelines. The process is quite involved and needs careful attention to detail to ensure compliance with all applicable laws and regulations.  Further clarification can be found in the appendix regarding complex family medical leave cases, and the interaction with short and long-term disability insurance.  It also provides a detailed description of employee rights and employer responsibilities. This policy is lengthy and complex due to legal requirements.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave\"\n}"}
