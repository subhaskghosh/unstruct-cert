{"_id": "human_resources--hr_policies:_doc--p--70271", "text": "{\n    \"policy_id\": \"TRVL-2023-001\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the guidelines for employee travel, including booking procedures, expense reimbursement, and safety protocols. It aims to ensure comfortable and secure travel arrangements while adhering to budgetary constraints.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-2023\"\n}"}
