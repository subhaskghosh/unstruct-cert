{"_id": "human_resources--hr_policies:_doc--p--71532", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, retirement plans, paid time off, and wellness programs. It is designed to support employee well-being and long-term financial security.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71532", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Short-Term Incentive Bonus\",\n    \"policy_description\": \"This policy details the short-term incentive bonus program for employees who exceed sales targets. The bonus is awarded quarterly and is based on individual performance.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/bonus-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71533", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work and adjusted schedules, to support employee work-life balance and promote a productive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-09-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71533", "text": "{\n    \"policy_id\": \"EMP-COMP-001\",\n    \"policy_title\": \"Employee Compensation and Performance Review\",\n    \"policy_description\": \"This policy details the compensation structure, performance review process, and bonus eligibility for all employees. It includes complex calculations for merit increases and stock options. It is a comprehensive document outlining all aspects of employee pay.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"HR\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-review.pdf\"\n}"}
