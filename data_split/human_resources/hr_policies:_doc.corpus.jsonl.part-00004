{"_id": "human_resources--hr_policies:_doc--n--71672", "text": "{\n    \"policy_id\": \"ADM-007\",\n    \"policy_title\": \"Expense Reimbursement Guidelines\",\n    \"policy_description\": \"Outlines the procedures for submitting and processing employee expense reports. Includes details on allowable expenses, required documentation, and approval workflows.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Administration\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71673", "text": "{\n    \"policy_id\": \"WELLBEING-003\",\n    \"policy_title\": \"Mental Health & Resilience Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental health and building resilience through training, resources, and access to counseling services. It promotes a positive work-life balance and proactive mental well-being strategies.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-003\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71673", "text": "{\n    \"policy_id\": \"BENEFITS-007\",\n    \"policy_title\": \"Health Insurance Plan Details\",\n    \"policy_description\": \"This document details the specifics of the company's health insurance plan, including coverage levels, premiums, and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/benefits-007\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71674", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources and support for physical and mental health. It includes gym membership discounts, mental health counseling, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71674", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance\",\n    \"policy_description\": \"This detailed policy outlines the comprehensive health insurance benefits provided to all eligible employees, including medical, dental, and vision coverage. It specifies eligibility criteria, coverage levels, claim procedures, and associated costs. This policy is subject to change based on annual reviews and negotiations with insurance providers. Details regarding specific plans, deductibles, co-pays, and out-of-pocket maximums are available in the accompanying plan documents. Employees are encouraged to review these documents carefully to understand their coverage options.  The policy also includes information on preventative care, wellness programs, and emergency services. It covers both in-network and out-of-network providers, with varying levels of coverage.  Furthermore, it details the process for appealing denied claims.  The policy adheres to all applicable federal and state regulations, including HIPAA and the Affordable Care Act.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71675", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"Details the company's health insurance coverage options for employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71675", "text": "{\n    \"policy_id\": \"BEN-0045\",\n    \"policy_title\": \"Employee Termination and Severance Policy\",\n    \"policy_description\": \"Comprehensive guidelines regarding employee termination procedures, severance packages, and associated legal considerations. This policy outlines the process for both voluntary and involuntary terminations, ensuring compliance with all applicable labor laws and regulations. It also details eligibility criteria for severance benefits and provides a step-by-step guide for managers handling termination cases.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/termination-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71676", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Premium Reimbursement\",\n    \"policy_description\": \"This policy outlines the process for employees to receive reimbursement for health insurance premiums.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71676", "text": "{\n    \"policy_id\": \"EMP-DISC-002\",\n    \"policy_title\": \"Disciplinary Action Procedure\",\n    \"policy_description\": \"This policy details the steps taken in disciplinary proceedings against employees.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary_action.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71677", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health. Includes gym reimbursement and stress management workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71677", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"A detailed document outlining all aspects of the company’s health insurance coverage, including provider networks, co-pays, deductibles, and covered services. This plan also covers vision and dental care, and includes information on preventative care and wellness initiatives.  It details specific procedures for filing claims, appealing denials, and understanding your benefits.  It includes a glossary of terms for easy understanding. Furthermore, this outlines several complex scenarios for international coverage and pre-existing conditions. This includes information regarding COBRA and HIPAA compliance and the latest changes to healthcare regulations as of January 1, 2024. This also details the process for adding dependents to the plan, and the associated costs. It outlines procedures for medical emergencies both domestically and while traveling abroad. It explains the various tiers of coverage available and how to choose the best plan for your individual needs. This document is regularly updated to reflect changes in healthcare laws and regulations.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71678", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, offering resources such as gym memberships, mental health support, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71678", "text": "{\n    \"policy_id\": \"RET-PLAN-001\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including contribution matching, vesting schedules, and investment options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71679", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial planning. It aims to improve work-life balance and overall employee satisfaction.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71679", "text": "{\n    \"policy_id\": \"DIS-002\",\n    \"policy_title\": \"Performance Improvement Plan\",\n    \"policy_description\": \"This policy details the process for addressing employee performance issues, including documentation of concerns, corrective action plans, and potential disciplinary action.  It is designed to help employees improve their performance but may lead to termination if improvements are not made.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71680", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee wellness, outlining programs related to physical and mental health, including gym reimbursements and stress management resources.  It aims to create a healthy and supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71680", "text": "{\n    \"policy_id\": \"EMP-COMP-001\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"This policy outlines the compensation structure for executive-level employees, including salary, bonus, and stock options. Details around performance metrics and eligibility criteria are included. It's a highly detailed document.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive_compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71681", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, covering health screenings, gym memberships, and mental health resources. The program aims to promote a healthy work-life balance and enhance employee morale.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71681", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"401k Contribution Matching\",\n    \"policy_description\": \"Details the company's 401k plan, including contribution limits, vesting schedules, and investment options.  This document is intended for use by finance and HR professionals.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71682", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the employee wellness benefit program, including gym membership discounts and mental health resources. We encourage employees to prioritize their well-being. The program aims to support a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71682", "text": "{\n    \"policy_id\": \"EB-2022-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the complete health insurance plan offered to employees, including coverage details, enrollment procedures, and claim submission guidelines. It covers medical, dental, vision, and prescription drug benefits. This is a very complex document with extensive legal stipulations relating to deductibles, co-pays and out-of-network benefits. It requires specific attention to detail and regular review. The plan includes provisions for preventative care, specialist visits, emergency services, and hospitalization. Additionally, it outlines procedures for appealing claim denials and accessing additional resources. It is important to understand the limitations and exclusions of the plan. It also outlines the process for submitting pre-authorization requests for certain procedures.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71683", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, covering health, fitness, and mental health resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71683", "text": "{\n    \"policy_id\": \"RE-2022-010\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details of the company's 401k retirement savings plan, including contribution matching and vesting schedules.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71684", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Domestic Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees within the United States.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-domestic\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71684", "text": "{\n    \"policy_id\": \"INT-ASG-002\",\n    \"policy_title\": \"International Assignment Relocation\",\n    \"policy_description\": \"This policy details the procedures and benefits for employees on international assignments.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Legal\",\n        \"International Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/international-relocation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71685", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides up to 16 weeks of paid parental leave to eligible employees, supporting work-life balance and family wellbeing. It covers both birth and adoption scenarios.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/parentalleavepolicy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71685", "text": "{\n    \"policy_id\": \"RP-2022-012\",\n    \"policy_title\": \"401k Retirement Savings Plan\",\n    \"policy_description\": \"Details the company's 401k plan, including contribution matching and investment options.  This policy assists employees in planning for their financial future in retirement.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401kplan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71686", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance plans offered to employees, including coverage levels, premiums, and enrollment procedures. This policy complies with all current healthcare regulations.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71686", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"Outlines the terms and conditions of the company's Employee Stock Option Plan, including eligibility, vesting schedules, and exercise procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71687", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, physical fitness, and financial planning. It aims to foster a supportive work environment and improve overall employee satisfaction.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71687", "text": "{\n    \"policy_id\": \"EXP-001\",\n    \"policy_title\": \"Employee Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to submit and receive reimbursement for business-related expenses, including travel, meals, and lodging.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71688", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all full-time employees. It covers medical, dental, and vision care. Employees are eligible for coverage after 30 days of employment. Details regarding premiums and coverage levels are available in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71688", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Employee Compensation and Performance Review\",\n    \"policy_description\": \"This comprehensive policy details the company's compensation philosophy, performance review process, bonus structures, and stock option plans. It encompasses all levels of employment, from entry-level positions to executive leadership. The policy is designed to attract, retain, and motivate high-performing employees by providing fair and competitive compensation and opportunities for growth and development. This policy also outlines disciplinary actions and termination procedures related to performance issues. Detailed guidelines on goal setting, feedback mechanisms, and performance improvement plans are included. The company reserves the right to modify this policy at any time. Consult with HR for specific questions regarding your individual compensation and performance goals.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71689", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through health and fitness benefits.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71689", "text": "{\n    \"policy_id\": \"RET-PLAN-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Details regarding the company's 401k retirement savings plan.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71690", "text": "{\n    \"policy_id\": \"BEN-PTO-2023\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off, including vacation, sick leave, and personal days. It applies to all full-time and part-time employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71690", "text": "{\n    \"policy_id\": \"EXEC-STOCK-2023\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions for granting stock options to executive-level employees. It outlines vesting schedules, exercise prices, and other relevant information.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock_option_plan_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71691", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including flexible work options, mental health resources, and wellness programs. It aims to support a healthy work-life balance for all employees.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-flex-work.pdf\"\n}"}
