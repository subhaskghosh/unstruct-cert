{"_id": "human_resources--hr_policies:_doc--n--61715", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy details the eligibility, granting, vesting, and exercise of stock options for executive-level employees. It is a comprehensive document covering tax implications, transfer restrictions, and termination provisions, and is intended to align executive compensation with long-term company performance. It also outlines procedures for reporting and managing stock option activity. This is a complex document outlining stock options for higher level executives.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61716", "text": "{\n    \"policy_id\": \"PERF-MGMT-001\",\n    \"policy_title\": \"Performance Management & Improvement Plan\",\n    \"policy_description\": \"This policy outlines the process for performance reviews, improvement plans, and addressing performance issues within the company. It aims to foster a culture of continuous improvement and employee success.  Applicable to all employees.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/perf_mgmt_policy.pdf\"\n}"}
