{"_id": "human_resources--hr_policies:_doc--n--71556", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This comprehensive policy details the provisions for long-term disability insurance, including eligibility requirements, benefit levels, and the claim process.  It outlines the intricate details of coverage, including definitions of disability, waiting periods, and coordination with other benefits. The policy covers various scenarios and provides detailed guidelines for both employees and the company's administration.  It also includes information on appeal processes and legal considerations.  Further details concerning benefit calculations and coordination with state and federal programs are included as appendices to this document. This details the requirements for filing a claim and the process for reviewing and approving claims, including documentation requirements. A detailed description of the appeal process is provided, including timelines and required documentation. Finally, this policy aligns with the most recent legal and regulatory requirements concerning disability insurance.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71557", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including access to mental health resources, fitness benefits, and stress management programs. It aims to foster a supportive and healthy work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71557", "text": "{\n    \"policy_id\": \"LV-2024-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details the procedures for requesting and taking various types of leave, including sick leave, personal leave, and family leave.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71558", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, dental, vision, paid time off, parental leave, and wellness programs. It emphasizes work-life integration and employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-benefits.pdf\"\n}"}
