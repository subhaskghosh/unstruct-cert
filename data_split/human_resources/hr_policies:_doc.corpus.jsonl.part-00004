{"_id": "human_resources--hr_policies:_doc--p--64381", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Family Leave and Benefits Policy\",\n    \"policy_description\": \"This policy outlines the provisions for family leave, including parental leave, sick leave for family members, and related benefits. It supports employees in balancing work and family responsibilities.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/family-leave-policy\"\n}"}
