{"_id": "human_resources--hr_policies:_doc--p--64787", "text": "{\n    \"policy_id\": \"BP-2023-101\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission structure for the Sales department, including performance targets and payout schedules. This policy aligns with overall compensation strategies.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission.pdf\"\n}"}
