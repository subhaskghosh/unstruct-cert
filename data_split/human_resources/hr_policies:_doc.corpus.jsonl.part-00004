{"_id": "human_resources--hr_policies:_doc--n--64747", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A detailed plan outlining deferred compensation options for executive-level employees, including complex vesting schedules and tax implications.  Requires specialized legal review.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/deferred-comp-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64748", "text": "{\n    \"policy_id\": \"BP-0012\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64748", "text": "{\n    \"policy_id\": \"BP-0005\",\n    \"policy_title\": \"Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related expenses.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/expense_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64749", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on coverage, premiums, and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64749", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Retirement Plan\",\n    \"policy_description\": \"This policy details the retirement plan available to executive-level employees. It includes information on vesting schedules, contribution limits, and payout options. The plan is designed to attract and retain key leadership personnel. It also outlines the process for submitting claims and managing investments. Further details regarding the legal and tax implications of the plan are contained within the attached appendices, which cover specific scenarios and address potential questions. Detailed information is available regarding spousal benefits, early withdrawal penalties, and the process for transferring funds to other retirement accounts. The policy also covers the responsibilities of both the employee and the company in maintaining the plan's compliance with all applicable regulations. It is regularly reviewed by our legal and financial teams.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64750", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Plan\",\n    \"policy_description\": \"Details regarding the company's health insurance coverage, including eligibility, premiums, and claim procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64750", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A comprehensive plan outlining deferred compensation arrangements for executive-level employees, including vesting schedules, payout options, and tax implications. This document is very detailed and covers numerous scenarios and legal considerations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/deferred-compensation-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64751", "text": "{\n    \"policy_id\": \"WB-ENG-202401\",\n    \"policy_title\": \"Engineering Department - Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, for employees in the Engineering department. It is designed to promote work-life balance and employee well-being.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/engineering-flexible-work.pdf\"\n}"}
