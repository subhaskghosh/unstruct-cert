{"_id": "human_resources--hr_policies:_doc--n--64005", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Complex Compensation and Equity Plan\",\n    \"policy_description\": \"Details the comprehensive compensation structure, including base salary, bonuses, stock options, and long-term incentive plans for executive leadership. This policy covers performance metrics, vesting schedules, and eligibility criteria for all equity-based compensation. It is a detailed document outlining a complex process that requires expert knowledge to interpret correctly.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/equity-plan\"\n}"}
