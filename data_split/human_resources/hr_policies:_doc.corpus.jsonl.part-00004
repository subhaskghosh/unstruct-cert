{"_id": "human_resources--hr_policies:_doc--n--68833", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the complete health insurance coverage available to all full-time employees, including detailed information about deductibles, co-pays, and out-of-pocket maximums. It also covers dependent eligibility and various plan options. This policy is a lengthy and complex document outlining all aspects of healthcare benefits.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_plan.pdf\"\n}"}
