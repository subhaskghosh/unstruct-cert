{"_id": "human_resources--hr_policies:_doc--p--68274", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work and adjusted work schedules, designed to support employee work-life balance and enhance productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68274", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment Procedures\",\n    \"policy_description\": \"Detailed procedures for employees to enroll in company-sponsored health insurance plans, including deadlines, required documentation, and contact information for insurance providers. Covers eligibility criteria and cost-sharing arrangements.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment.pdf\"\n}"}
