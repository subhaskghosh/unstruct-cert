{"_id": "human_resources--hr_policies:_doc--n--64575", "text": "{\n    \"policy_id\": \"LEAV-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"A comprehensive guide detailing all types of leave available to employees, including eligibility, application procedures, and associated documentation requirements. Covers medical leave, parental leave, bereavement leave, and personal leave, with specific considerations for different employment statuses and collective bargaining agreements. This document contains detailed legal disclaimers and is subject to change based on state and federal regulations. Also details the interaction between different leave types and how they impact benefits continuation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/extended-leave\"\n}"}
