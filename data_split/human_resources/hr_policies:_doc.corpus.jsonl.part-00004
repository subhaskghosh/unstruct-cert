{"_id": "human_resources--hr_policies:_doc--n--67052", "text": "{\n    \"policy_id\": \"EMP-TRAIN-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This comprehensive leadership development program is designed to equip emerging leaders with the skills and knowledge they need to succeed. The program includes a series of workshops, mentoring sessions, and on-the-job training opportunities. It covers topics such as strategic thinking, decision-making, communication, and team building. Participants will also work on real-world projects to apply their learning. The program is a multi-year commitment, requiring significant time investment from participants.  It also involves external consultants and a detailed assessment process. This is a foundational program for all managers and high-potential employees and is critical for organizational growth.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
