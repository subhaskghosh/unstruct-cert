{"_id": "human_resources--hr_policies:_doc--p--71664", "text": "{\n    \"policy_id\": \"EMP-BEN-0012\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"Details the company's health insurance plan, including coverage options, premiums, and claims procedures. Designed for easy understanding by all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71664", "text": "{\n    \"policy_id\": \"EMP-BEN-0009\",\n    \"policy_title\": \"401k Contribution Matching\",\n    \"policy_description\": \"Outlines the details of the company's 401k plan, including eligibility requirements, contribution limits, and vesting schedules. Complex calculations involved.\",\n    \"effective_date\": \"2023-07-20\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71665", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides extended paid parental leave to all eligible employees, fostering a supportive work-life balance. It includes provisions for both mothers and fathers and aims to attract and retain top talent. The policy covers 16 weeks of paid leave.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental-leave\"\n}"}
