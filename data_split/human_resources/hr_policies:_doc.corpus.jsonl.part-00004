{"_id": "human_resources--hr_policies:_doc--n--68884", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Health Insurance Policy\",\n    \"policy_description\": \"Details regarding the company's health insurance coverage options for employees and their families.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2022-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68885", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68885", "text": "{\n    \"policy_id\": \"LTA-2022-005\",\n    \"policy_title\": \"Long Term Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and managing long-term absences due to illness, family emergencies, or other qualifying reasons. It encompasses leave of absence options, required documentation, benefit continuation, and return-to-work processes. The policy also addresses compliance with relevant federal, state, and local laws regarding employee leave entitlements and provides guidance to managers and employees on navigating these complex situations effectively. It outlines the roles and responsibilities of all parties involved and emphasizes the importance of clear communication and adherence to established guidelines throughout the leave process.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2022-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68886", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health, including gym memberships, stress management workshops, and employee assistance programs. It is written in plain language for easy comprehension.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
