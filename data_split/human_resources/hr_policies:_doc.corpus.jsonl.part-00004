{"_id": "human_resources--hr_policies:_doc--n--65502", "text": "{\n    \"policy_id\": \"PERF-REV-002\",\n    \"policy_title\": \"Annual Performance Review Process\",\n    \"policy_description\": \"Details the procedures for conducting annual performance reviews, including goal setting, self-assessment, manager evaluation, and feedback sessions. This is used to evaluate employee contributions and identify areas for improvement.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65503", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health. It covers access to employee assistance programs, wellness workshops, and flexible work arrangements.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Marketing\",\n        \"Public Relations\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65503", "text": "{\n    \"policy_id\": \"LTV-2023-012\",\n    \"policy_title\": \"Long-Term Vacation Policy\",\n    \"policy_description\": \"Details the eligibility, accrual, and usage of long-term vacation benefits for employees with 10+ years of service.  Includes complex rules around carry-over and payout options.  The policy also details procedures for sabbatical requests and approvals.  Requires extensive documentation and approval chains. It aims to support long-term employee retention through flexible leave options.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Research & Development\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-vacation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65504", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, vision, and wellness benefits available to all eligible employees. It is written in plain language to ensure clarity and understanding. Regular reviews are conducted to ensure competitiveness and compliance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Technology\",\n        \"Engineering\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
