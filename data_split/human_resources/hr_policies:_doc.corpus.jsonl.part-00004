{"_id": "human_resources--hr_policies:_doc--n--65394", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans. Includes information on plan options, premiums, and eligibility requirements.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65395", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to promote work-life balance and employee well-being. It's designed to be easily understandable and accessible to all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Research and Development\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65395", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Employee Compensation Adjustment Policy\",\n    \"policy_description\": \"Details the process for periodic employee compensation reviews and adjustments based on performance and market data. Includes complex calculation formulas and eligibility criteria.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-adjustment.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65396", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential counseling and support services for personal and work-related issues. The aim is to promote a healthy work-life balance and improve employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65396", "text": "{\n    \"policy_id\": \"WB-002\",\n    \"policy_title\": \"Health Insurance Benefits and Regulations\",\n    \"policy_description\": \"Details regarding health insurance benefits, including coverage options, enrollment procedures, and compliance with all relevant healthcare regulations. This policy ensures adherence to legal requirements and provides employees with comprehensive healthcare support.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65397", "text": "{\n    \"policy_id\": \"WELLBEING-ENG-2022\",\n    \"policy_title\": \"Employee Wellbeing Program - Engineering\",\n    \"policy_description\": \"This policy outlines the resources and programs available to Engineering employees to support their mental and physical wellbeing. It includes details on EAP access, wellness workshops, and flexible work arrangements.\",\n    \"effective_date\": \"2022-03-15\",\n    \"last_updated\": \"2022-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-eng-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65397", "text": "{\n    \"policy_id\": \"REMOTE-ALL-2024\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy governs remote work arrangements for all employees, including eligibility criteria, equipment guidelines, and security protocols.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65398", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness programs, and healthy lifestyle initiatives. It aims to foster a supportive and healthy work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65398", "text": "{\n    \"policy_id\": \"LB-2022-100\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave of absence, including medical leave, parental leave, and personal leave. It covers eligibility requirements, documentation procedures, and benefits continuation.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65399", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Promotes mental and emotional well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65399", "text": "{\n    \"policy_id\": \"RW-002\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"Outlines the terms and conditions for employees working remotely, including eligibility, equipment, and security protocols.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote_work_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65400", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Work-Life Balance and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee work-life balance through flexible work options, including remote work, flextime, and compressed workweeks. It emphasizes the importance of employee well-being and provides guidelines for requesting and approving flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65400", "text": "{\n    \"policy_id\": \"BE-002\",\n    \"policy_title\": \"Health Benefits Enrollment Procedures\",\n    \"policy_description\": \"This policy details the procedures for employees to enroll in company-sponsored health benefits, including medical, dental, and vision insurance. It outlines eligibility requirements, enrollment deadlines, and instructions for selecting benefits plans.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/benefits-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65401", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and stress management. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65401", "text": "{\n    \"policy_id\": \"TR-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for travel expenses incurred during business trips. It covers transportation, lodging, meals, and other related costs.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65402", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"Details the full range of benefits offered to employees, including health insurance, dental, vision, and retirement plans. Designed to support employee wellbeing and attract/retain talent.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65402", "text": "{\n    \"policy_id\": \"LV-REQ-002\",\n    \"policy_title\": \"Vacation and Sick Leave Request Process\",\n    \"policy_description\": \"Outlines the procedure for requesting and approving vacation and sick leave. Includes details on accrual rates and required documentation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/request\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65403", "text": "{\n    \"policy_id\": \"WB-ENG-PROD-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources and support for physical and mental health. It includes details on gym reimbursements, mental health days, and employee assistance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65403", "text": "{\n    \"policy_id\": \"LTD-ALL-002\",\n    \"policy_title\": \"Long-Term Disability\",\n    \"policy_description\": \"This comprehensive policy details the benefits and procedures for employees who become unable to work due to a long-term illness or injury. It covers eligibility requirements, benefit amounts, and the claims process.  Detailed legal disclaimers are included.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65404", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance options available to employees, including coverage levels, premiums, and enrollment procedures. This policy aims to provide comprehensive healthcare support for all eligible personnel.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
