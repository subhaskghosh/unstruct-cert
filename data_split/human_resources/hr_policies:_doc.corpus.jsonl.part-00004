{"_id": "human_resources--hr_policies:_doc--p--62884", "text": "{\n    \"policy_id\": \"PTO-2023-08-15\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and use paid time off for vacation, personal days, and sick leave. It emphasizes the importance of planning time off in advance and communicating requests to managers. Focuses on supporting work-life balance through flexible leave options.\",\n    \"effective_date\": \"2023-08-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62884", "text": "{\n    \"policy_id\": \"BER-2023-11-01\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy details the provisions for employees taking time off due to the death of a family member. It outlines the amount of paid leave available and the required documentation. This policy addresses the emotional and practical challenges of grief.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-policy\"\n}"}
