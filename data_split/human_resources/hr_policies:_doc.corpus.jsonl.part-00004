{"_id": "human_resources--hr_policies:_doc--p--71482", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing access to resources such as mental health support, fitness programs, and ergonomic assessments. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71482", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Equal Employment Opportunity and Non-Discrimination\",\n    \"policy_description\": \"This policy details the company's commitment to equal employment opportunities and prohibits discrimination based on protected characteristics. It aligns with federal and state employment laws.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/eeo-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71483", "text": "{\n    \"policy_id\": \"EMP-BEN-0012\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees, including medical, dental, vision, and employee assistance programs. It details coverage levels, enrollment procedures, and employee responsibilities.  It also includes information on preventative care and wellness initiatives designed to promote employee health and wellbeing. The policy covers eligibility requirements, claim submission processes, and contact information for benefit providers.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71483", "text": "{\n    \"policy_id\": \"EMP-EQ-0005\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of the employee stock option plan, including eligibility, vesting schedules, and exercise procedures.\",\n    \"effective_date\": \"2021-05-20\",\n    \"last_updated\": \"2023-09-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Technology\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock-option-plan.pdf\"\n}"}
