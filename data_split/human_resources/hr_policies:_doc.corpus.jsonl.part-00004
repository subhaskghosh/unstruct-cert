{"_id": "human_resources--hr_policies:_doc--n--67511", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Employee Compensation and Performance Review\",\n    \"policy_description\": \"A comprehensive guide to the company's compensation philosophy, performance review process, salary adjustments, bonus structures, and equity options. Includes detailed information on goal setting, feedback mechanisms, and performance improvement plans. This document covers all levels of employment from entry-level positions to executive leadership, and provides specific guidance for managers and employees alike.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-review-policy\"\n}"}
