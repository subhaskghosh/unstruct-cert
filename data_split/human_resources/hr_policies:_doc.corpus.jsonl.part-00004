{"_id": "human_resources--hr_policies:_doc--n--61741", "text": "{\n    \"policy_id\": \"EMP-RET-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Outlines the company's 401k plan, including contribution matching and vesting schedules.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61742", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete benefits package available to all eligible employees, including health insurance, dental, vision, life insurance, 401k plans with company matching, paid time off (PTO), sick leave, parental leave, and employee assistance programs. Details regarding eligibility requirements, enrollment procedures, and plan options are provided. Specific information on each benefit plan can be found in the attached documents.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2024.pdf\"\n}"}
