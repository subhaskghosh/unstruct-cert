{"_id": "human_resources--hr_policies:_doc--n--70603", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"Outlines the company's leadership development program, focusing on skills training and career advancement opportunities. This policy aims to cultivate future leaders within the organization.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/training/leadership_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70604", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy details the health insurance options available to all eligible employees. It covers medical, dental, and vision care. Employees must enroll within 30 days of their start date.\",\n    \"effective_date\": \"2022-10-26\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70604", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"A detailed guide outlining the company's 401k plan, including contribution matching, vesting schedules, and investment options. This document covers all aspects of retirement planning within the organization, and includes complex legal disclaimers and investment strategy information. It also details the procedures for loan applications and hardship withdrawals. This is a very extensive policy designed to provide complete clarity to employees about their retirement savings options. It is crucial for financial planning and ensuring long-term security.\",\n    \"effective_date\": \"2022-11-15\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
