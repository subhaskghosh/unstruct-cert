{"_id": "human_resources--hr_policies:_doc--p--71830", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, providing details on health insurance, wellness initiatives, and preventative care benefits. It’s designed to be easily understood by all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/eb-2023-005\"\n}"}
