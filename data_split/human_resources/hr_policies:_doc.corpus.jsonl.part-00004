{"_id": "human_resources--hr_policies:_doc--n--68616", "text": "{\n    \"policy_id\": \"LEGAL-COMP-012\",\n    \"policy_title\": \"Compliance with ERISA Regulations\",\n    \"policy_description\": \"This document details the company’s adherence to all aspects of the Employee Retirement Income Security Act of 1974 (ERISA), including reporting requirements, fiduciary responsibilities, and plan documentation standards. It is a highly technical and legally binding document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/erisa-compliance.pdf\"\n}"}
