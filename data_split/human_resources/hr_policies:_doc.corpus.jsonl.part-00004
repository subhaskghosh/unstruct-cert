{"_id": "human_resources--hr_policies:_doc--p--64959", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program Guidelines\",\n    \"policy_description\": \"This policy outlines the details of the company's Employee Wellness Program, including resources for mental health, physical fitness, and financial well-being. It provides practical steps employees can take and details on reimbursement options.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64959", "text": "{\n    \"policy_id\": \"WB-002\",\n    \"policy_title\": \"Commitment to Employee Well-being\",\n    \"policy_description\": \"This policy expresses the company’s dedication to fostering a supportive and healthy work environment.  It emphasizes the importance of employee well-being as a core value.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-commitment\"\n}"}
