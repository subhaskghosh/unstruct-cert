{"_id": "human_resources--hr_policies:_doc--n--67703", "text": "{\n    \"policy_id\": \"LEAV-2023-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Comprehensive guidelines for extended leaves of absence, including medical leave, family leave, and sabbatical options. This is a very detailed and extensive policy.\",\n    \"effective_date\": \"2023-11-10\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
