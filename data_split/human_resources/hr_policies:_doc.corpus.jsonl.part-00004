{"_id": "human_resources--hr_policies:_doc--p--71701", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and adjusted work schedules, to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71701", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This detailed document outlines the comprehensive health insurance plan offered to employees, including coverage details, eligibility criteria, claim procedures, and a complete list of network providers. It also includes information regarding preventative care, specialist visits, and prescription drug coverage. Further details are available in the attached appendices regarding cost sharing and out-of-pocket maximums. This policy is subject to change based on annual negotiations with insurance providers and regulatory updates. This is a very extensive policy document.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
