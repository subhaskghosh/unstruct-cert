{"_id": "human_resources--hr_policies:_doc--n--68773", "text": "{\n    \"policy_id\": \"EMP-LV-002\",\n    \"policy_title\": \"Extended Leave of Absence - Medical\",\n    \"policy_description\": \"This comprehensive policy details procedures for employees requiring extended leave for medical reasons, including documentation requirements, benefit continuation, and return-to-work protocols. It covers various scenarios, including short-term and long-term disability, family medical leave, and related accommodations, adhering to all federal and state regulations.  This policy is intended to provide clarity and support for employees navigating challenging health situations and ensure compliance with legal obligations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68774", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Remote Work Benefit Stipend\",\n    \"policy_description\": \"This policy outlines the stipend provided to employees for setting up a functional and ergonomic home office while working remotely. It covers expenses such as internet, furniture and equipment. Stipend amounts are subject to annual review.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-benefit-stipend\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68774", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Legacy Health Insurance Plan\",\n    \"policy_description\": \"Details the company's health insurance plan as it existed prior to 2022. Contains complex clauses regarding pre-existing conditions and deductible structures.\",\n    \"effective_date\": \"2018-01-01\",\n    \"last_updated\": \"2022-12-31\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/legacy-health-insurance\"\n}"}
