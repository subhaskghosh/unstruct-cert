{"_id": "human_resources--hr_policies:_doc--p--65959", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, offering resources for mental health, physical fitness, and financial wellness. It includes details on Employee Assistance Programs (EAP), wellness workshops, and gym membership discounts.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Design\",\n        \"Research & Development\",\n        \"Content Creation\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65959", "text": "{\n    \"policy_id\": \"LOA-2023-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and parental leave. It complies with all applicable state and federal laws.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Operations\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65960", "text": "{\n    \"policy_id\": \"EB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to mental health resources, fitness benefits, and flexible work arrangements.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65960", "text": "{\n    \"policy_id\": \"IT-2023-005\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"This policy details the guidelines for appropriate use of company computers, networks, and software.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/tech-usage.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65961", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Remote Work and Benefits Eligibility\",\n    \"policy_description\": \"This policy outlines benefits eligibility for employees working remotely, including health insurance, retirement plans, and paid time off. It addresses potential challenges related to remote work and ensures equitable access to benefits for all eligible employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65961", "text": "{\n    \"policy_id\": \"EMP-TRA-001\",\n    \"policy_title\": \"Employee Training Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to request reimbursement for approved training courses and certifications. It covers eligible expenses and approval requirements.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/training-reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65962", "text": "{\n    \"policy_id\": \"WB-007\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support and resources for employees facing personal or work-related challenges. It covers counseling, legal assistance, and financial guidance. Resources include a 24/7 hotline and access to online tools.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65962", "text": "{\n    \"policy_id\": \"TR-002\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business-related travel expenses, including airfare, lodging, and meals.  All reimbursements require pre-approval and original receipts.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65963", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential support and resources to employees experiencing personal or work-related challenges.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wb-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65963", "text": "{\n    \"policy_id\": \"LV-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed guidelines regarding various types of leaves available to employees, including eligibility, application procedures, and benefits continuation. Covers FMLA, parental leave, sick leave, and personal leave. Extensive documentation included.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/lv-005-detailed.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65964", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including resources for mental health support, fitness programs, and healthy eating initiatives.  It is designed to promote a positive work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65964", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving extended leaves of absence, including medical leave, parental leave, and sabbatical leave. The policy adheres to all relevant federal and state regulations. It involves detailed documentation and approvals.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65965", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all full-time employees. It also details the company's wellness programs and resources for employee support.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/healthwellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65965", "text": "{\n    \"policy_id\": \"EXP-TRVL-002\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for business-related travel expenses, including airfare, lodging, and meals.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65966", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, aimed at improving employee work-life balance and well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65966", "text": "{\n    \"policy_id\": \"TR-2024-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures and guidelines for reimbursing employees for business travel expenses.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65967", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential support and resources to employees experiencing personal or work-related difficulties, promoting mental and emotional well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65967", "text": "{\n    \"policy_id\": \"LT-005\",\n    \"policy_title\": \"Long-Term Disability\",\n    \"policy_description\": \"Details the company's long-term disability benefits and procedures for application and claim processing. Covers a wide range of medical conditions and requires extensive documentation.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65968", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering flexible work options such as remote work and adjusted hours to support a healthy work-life balance. It also details available wellness programs and resources.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-flexible-work\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65968", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Health Insurance Enrollment Guidelines\",\n    \"policy_description\": \"This policy details the procedures for employees to enroll in company-sponsored health insurance plans, including eligibility requirements, coverage options, and deadlines.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-18\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65969", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65969", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This policy details the compensation structure, including salary, bonuses, stock options, and other equity grants, for executive-level employees.  It is a comprehensive document outlining complex eligibility criteria and vesting schedules.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive_compensation.pdf\"\n}"}
