{"_id": "human_resources--hr_policies:_doc--n--71875", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy details all employee benefits including health insurance, retirement plans, life insurance, disability insurance, paid time off, and employee assistance programs. It includes detailed information regarding eligibility, enrollment, and coverage levels for each benefit.  Specific provisions regarding stock options, performance-based bonuses, and relocation assistance are also outlined.  Furthermore, it describes the processes for benefits administration, claims resolution, and annual open enrollment periods.  It further details the regulations concerning COBRA and HIPAA compliance. This is a lengthy document. This covers a comprehensive suite of benefits for all employees.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/comprehensive-benefits\"\n}"}
