{"_id": "human_resources--hr_policies:_doc--p--70060", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements, including eligibility, equipment, and security protocols. It supports flexible working arrangements to improve employee work-life balance and productivity. Remote work is available to employees in good standing.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
