{"_id": "human_resources--hr_policies:_doc--p--67518", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees must enroll within 30 days of their start date.  Details on coverage levels and costs are available in the full policy document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67518", "text": "{\n    \"policy_id\": \"EMP-COND-002\",\n    \"policy_title\": \"Employee Conduct & Ethics\",\n    \"policy_description\": \"This comprehensive policy details the expected standards of conduct for all employees, covering areas such as conflict of interest, confidentiality, use of company resources, and adherence to legal and ethical principles. It outlines the consequences of violations, including disciplinary action up to and including termination of employment. A detailed appendix provides specific examples and scenarios. This policy is vital to maintaining a respectful and productive work environment and is based on comprehensive legal review to ensure full compliance.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/conduct-ethics-policy\"\n}"}
