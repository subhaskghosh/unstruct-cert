{"_id": "human_resources--hr_policies:_doc--n--65161", "text": "{\n    \"policy_id\": \"LE-2023-010\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"A comprehensive guide to all types of leave available to employees, including medical leave, parental leave, and personal leave. Contains detailed eligibility criteria and procedures.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65162", "text": "{\n    \"policy_id\": \"EMP-DEV-003\",\n    \"policy_title\": \"Employee Professional Development Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee growth through training, mentorship, and educational opportunities. It encourages employees to pursue certifications and advanced degrees relevant to their roles.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-dev-003.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65162", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Benefits Enrollment\",\n    \"policy_description\": \"Details the annual open enrollment process for employee health insurance, retirement plans, and other benefits. Includes information on eligibility, enrollment procedures, and plan options.\",\n    \"effective_date\": \"2022-10-20\",\n    \"last_updated\": \"2023-10-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65163", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including mental health resources, physical wellness initiatives, and work-life balance support.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65163", "text": "{\n    \"policy_id\": \"TR-2022-010\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"Details the procedures for employees to claim reimbursement for business travel expenses.\",\n    \"effective_date\": \"2022-09-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Marketing\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-2022\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65164", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical health, and financial wellness. It aims to foster a healthy work-life balance and prevent burnout.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65164", "text": "{\n    \"policy_id\": \"LV-2022-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and parental leave. Comprehensive and legally detailed.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65165", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential support services for personal and work-related issues. It includes counseling, legal assistance, and financial advice.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65165", "text": "{\n    \"policy_id\": \"AT-2023-005\",\n    \"policy_title\": \"Attendance and Punctuality\",\n    \"policy_description\": \"This policy details the requirements for employee attendance, punctuality, and procedures for reporting absences. Strict adherence is expected.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65166", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for employees seeking flexible work arrangements, including remote work, compressed workweeks, and flextime. It aims to promote work-life balance and employee well-being while maintaining productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65166", "text": "{\n    \"policy_id\": \"IT-SEC-012\",\n    \"policy_title\": \"Remote Access Security Policy\",\n    \"policy_description\": \"This policy details the security requirements for employees accessing company resources remotely, specifically within the IT department. It covers VPN usage, data encryption, and acceptable use of remote devices.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-access-security.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65167", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care, and details the enrollment process and coverage levels.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Research and Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65167", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Executive Equity Compensation Plan\",\n    \"policy_description\": \"This policy details the stock option and restricted stock unit grants for executive-level employees. It includes vesting schedules, exercise terms, and reporting requirements. It's a complex document related to long-term incentives.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/equity-compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65168", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Focuses on promoting mental health and overall well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65168", "text": "{\n    \"policy_id\": \"WB-002\",\n    \"policy_title\": \"Comprehensive Wellness Program\",\n    \"policy_description\": \"A detailed and multi-faceted wellness program encompassing health risk assessments, fitness challenges, nutritional guidance, and chronic disease management.  Includes extensive legal disclaimers and participation requirements.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellnessprogram.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65169", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Remote Work and Benefit Eligibility\",\n    \"policy_description\": \"This policy outlines the eligibility criteria for employee benefits while working remotely, including health insurance, retirement plans, and other perks. It covers provisions for maintaining benefits during temporary and permanent remote work arrangements.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-benefits.pdf\"\n}"}
