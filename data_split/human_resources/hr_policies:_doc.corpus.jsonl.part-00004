{"_id": "human_resources--hr_policies:_doc--p--64041", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees experiencing personal or work-related challenges. Covers mental health, stress management, and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
