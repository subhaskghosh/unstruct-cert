{"_id": "human_resources--hr_policies:_doc--n--68775", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"A detailed overview of the company's retirement plan, including eligibility, contribution options, vesting schedules, and investment choices. This document includes legal disclaimers and detailed financial projections. It covers various scenarios and potential tax implications for employees. This is a very long document. \",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
