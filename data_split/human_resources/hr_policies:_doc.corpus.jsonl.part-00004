{"_id": "human_resources--hr_policies:_doc--p--61444", "text": "{\n    \"policy_id\": \"RW-2023-01\",\n    \"policy_title\": \"Remote Work Guidelines\",\n    \"policy_description\": \"This policy outlines the guidelines for employees working remotely. It covers eligibility, required equipment, security protocols, and performance expectations. Remote work arrangements require manager approval. All remote employees must attend weekly team meetings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61444", "text": "{\n    \"policy_id\": \"RW-2022-01\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"This policy details the comprehensive remote work agreement for all eligible employees. It encompasses detailed legal clauses, IT security requirements, home office setup guidelines, expense reimbursement processes, performance monitoring metrics, communication protocols, and dispute resolution mechanisms.  It is a very lengthy and detailed document outlining all aspects of remote work including a section detailing tax implications for employees living in different states, and procedures for international remote work. It also covers detailed information on data privacy regulations and compliance requirements.  Remote work requests are reviewed on a case-by-case basis by the HR department and legal counsel.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-agreement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61445", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym memberships, mental health resources, and healthy lifestyle initiatives.\",\n    \"effective_date\": \"2022-11-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
