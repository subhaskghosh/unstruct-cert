{"_id": "human_resources--hr_policies:_doc--p--64700", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy outlines the procedures for enrolling in company-sponsored health insurance plans. Employees are eligible to enroll within 30 days of their hire date. Details regarding plan options and costs are available on the HR portal.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64700", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including eligibility requirements, contribution limits, vesting schedules, investment options, and loan provisions. It also covers the process for making beneficiary designations and accessing retirement funds. The plan adheres to all applicable ERISA regulations and is designed to help employees achieve their long-term financial goals. Detailed information is available in the plan document, which is updated annually to reflect changes in legislation and market conditions. Employees are encouraged to attend informational seminars and consult with financial advisors to make informed decisions about their retirement savings. This plan features multiple investment options across varying risk profiles. Specific information regarding fund performance and administrative fees is included in the annual plan report. The policy also addresses situations regarding qualified domestic relations orders (QDROs) and hardship withdrawals.  Furthermore, the plan outlines the process for resolving disputes and filing complaints.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64701", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial wellness. It covers eligibility, program details, and participation guidelines.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64701", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"This policy details the health insurance benefits offered to employees, including plan options, eligibility requirements, and enrollment procedures.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64702", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, dental, vision, life insurance, and retirement plans. It aims to provide substantial support and security to employees and their families.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64702", "text": "{\n    \"policy_id\": \"TRV-2024-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for reasonable and necessary travel expenses incurred while conducting company business. It covers transportation, lodging, and meals.\",\n    \"effective_date\": \"2024-02-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense_reimbursement.pdf\"\n}"}
