{"_id": "human_resources--hr_policies:_doc--p--61443", "text": "{\n    \"policy_id\": \"PTO-2023-001\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize paid time off, including vacation, sick leave, and personal days. It aims to provide a balanced work-life integration and supports employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-2023\"\n}"}
