{"_id": "human_resources--hr_policies:_doc--p--71050", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.  Employees are responsible for a portion of the premium, as detailed in the benefits guide. This policy aims to provide comprehensive healthcare coverage to support employee well-being.\",\n    \"effective_date\": \"2022-01-15\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71050", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Executive Compensation and Benefits Package\",\n    \"policy_description\": \"This highly detailed policy describes the compensation and benefits packages for executive level employees, including stock options, performance bonuses, supplemental insurance, and retirement plans.  Detailed eligibility requirements and vesting schedules are outlined. This package is designed to attract and retain top-level talent. It also covers specific tax implications and compliance regulations, requiring careful review by each executive.\",\n    \"effective_date\": \"2021-06-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71051", "text": "{\n    \"policy_id\": \"WB-2024-01\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being. It covers gym membership discounts, mental health resources, and annual health screenings. The program aims to promote a healthy lifestyle and reduce healthcare costs.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71051", "text": "{\n    \"policy_id\": \"BT-2023-05\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This document details the comprehensive benefits package offered to all full-time employees, including health insurance, dental insurance, vision insurance, life insurance, disability insurance, 401(k) plan, paid time off, and other perks.  It provides details on eligibility, enrollment procedures, contribution rates, and coverage details for each benefit. It also includes information about COBRA and other related regulations. Extensive explanations and legal disclaimers are included, making this a lengthy and legally dense document.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71052", "text": "{\n    \"policy_id\": \"EB-2023-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and well-being through various programs and resources, including gym memberships, mental health support, and preventative care.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71052", "text": "{\n    \"policy_id\": \"LEGL-2022-012\",\n    \"policy_title\": \"Non-Disclosure Agreement - Employee Confidentiality\",\n    \"policy_description\": \"This policy details the legal obligations of employees regarding the confidentiality of company information, intellectual property, and trade secrets. Violations may result in disciplinary action or legal proceedings.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-employee.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71053", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including gym memberships, mental health resources, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
