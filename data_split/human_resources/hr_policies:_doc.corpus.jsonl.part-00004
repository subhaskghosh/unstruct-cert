{"_id": "human_resources--hr_policies:_doc--p--62767", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62767", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Retirement Plan\",\n    \"policy_description\": \"A comprehensive retirement plan designed for executive-level employees, including detailed information on vesting schedules, contribution limits, and investment options.  This document covers all aspects of the plan, including eligibility requirements, benefit calculations, and procedures for claiming benefits. It also provides guidance on tax implications and financial planning considerations. Extensive appendices detail all relevant legal documentation and plan amendments. This plan is regularly updated to comply with all applicable laws and regulations and provides a strong foundation for a secure retirement.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62768", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Provides details on health, dental, and vision insurance options for employees. Covers premium costs and eligibility requirements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62768", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Retirement Planning and 401k Options\",\n    \"policy_description\": \"Details the company’s 401k plan, eligibility, matching contributions, and investment options. Includes information on retirement planning resources and consultations. This is a comprehensive guide to securing your financial future after employment.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
