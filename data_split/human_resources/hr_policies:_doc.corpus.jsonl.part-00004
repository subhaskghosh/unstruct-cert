{"_id": "human_resources--hr_policies:_doc--p--68007", "text": "{\n    \"policy_id\": \"WB-2024-005\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees experiencing personal or work-related challenges. Focuses on mental health and work-life balance.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/eap.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68007", "text": "{\n    \"policy_id\": \"LE-2023-012\",\n    \"policy_title\": \"Legal Compliance - Data Privacy\",\n    \"policy_description\": \"Details the company's procedures for handling employee and customer data in accordance with GDPR and other relevant regulations.  Includes complex data classification and access control matrices.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/data_privacy.pdf\"\n}"}
