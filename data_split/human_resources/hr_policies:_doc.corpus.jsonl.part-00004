{"_id": "human_resources--hr_policies:_doc--n--71215", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Health Insurance\",\n    \"policy_description\": \"Details the complete health insurance coverage available to all employees, including deductibles, co-pays, and covered services. Includes details on pre-existing conditions, out-of-network coverage, and appeals processes. This is a detailed document outlining all aspects of the company's healthcare plan.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71216", "text": "{\n    \"policy_id\": \"BEN-WEL-001\",\n    \"policy_title\": \"Employee Wellness Program Benefits\",\n    \"policy_description\": \"This policy outlines the benefits available to employees participating in the company's wellness program, including gym membership discounts, mental health resources, and annual health screenings. The goal is to promote employee wellbeing and preventative healthcare.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71216", "text": "{\n    \"policy_id\": \"COMP-LEAV-005\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and granting extended leaves of absence, including medical leave, parental leave, and personal leave. It covers eligibility requirements, documentation needed, and the impact on benefits and job security.  This is a comprehensive document outlining all applicable laws and regulations regarding leave, covering situations such as FMLA, state-specific provisions, and company-specific extensions. It also provides guidance on managing employee transitions during leave and ensuring a smooth return to work process.  Details include accrual rates, maximum leave durations, and procedures for appealing denial of leave requests. Furthermore, it addresses the interaction between different types of leave and the coordination of benefits. The policy also has a section on accommodating employees with disabilities and providing reasonable accommodations during leave.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71217", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, providing access to resources such as gym memberships, mental health support, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71217", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Life Insurance Policy\",\n    \"policy_description\": \"This policy details the company-provided life insurance benefits for all eligible employees. It covers accidental death, dismemberment, and natural causes. Includes detailed legal clauses, beneficiary designation procedures, and claim filing instructions. The document is quite extensive, covering various scenarios and stipulations.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/life-insurance.pdf\"\n}"}
