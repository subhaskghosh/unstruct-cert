{"_id": "human_resources--hr_policies:_doc--p--65173", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health and Retirement Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health insurance and retirement plan options available to all eligible employees. It covers medical, dental, vision, and 401k plans.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-retirement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65173", "text": "{\n    \"policy_id\": \"TRAV-001\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for submitting and receiving reimbursements for business-related travel expenses.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65174", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Work-Life Balance & Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, aimed at promoting work-life balance and employee well-being. It also details eligibility criteria and approval processes.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Customer Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65174", "text": "{\n    \"policy_id\": \"TRVL-2023-002\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and be reimbursed for travel expenses incurred while on company business. It includes guidelines on allowable expenses, documentation requirements, and approval limits.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Consulting\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65175", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Leadership Benefits Program\",\n    \"policy_description\": \"This policy outlines the enhanced benefits package available to employees in leadership roles, including executive health screenings, professional development allowances, and increased retirement contributions. It aims to attract and retain top talent.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Management\",\n        \"Leadership Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leadership-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65175", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Standard Employee Benefits Package\",\n    \"policy_description\": \"This policy details the standard benefits package offered to all full-time employees, including health insurance, paid time off, and basic retirement plan options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/standard-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65176", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial wellness. It encourages a healthy work-life balance and provides access to support services.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65176", "text": "{\n    \"policy_id\": \"LE-005\",\n    \"policy_title\": \"Legal Compliance for International Assignments\",\n    \"policy_description\": \"A comprehensive guide to legal requirements and compliance procedures for employees on international assignments, covering visa regulations, tax implications, and employment laws in various countries. This is a very detailed and complex document.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/international-assignment-compliance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65177", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial wellness.  It also details flexible work arrangements to support work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65177", "text": "{\n    \"policy_id\": \"LV-2022-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and personal leave.  It aims to ensure fair and consistent treatment of all employees.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65178", "text": "{\n    \"policy_id\": \"WB-ENG-2024001\",\n    \"policy_title\": \"Employee Wellness Program - Engineering\",\n    \"policy_description\": \"This policy outlines the wellness benefits available to Engineering department employees, including gym reimbursements and mental health resources. It focuses on preventative care and employee support.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-engineering-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65178", "text": "{\n    \"policy_id\": \"LEAVE-ALL-2023002\",\n    \"policy_title\": \"Extended Leave of Absence - Comprehensive\",\n    \"policy_description\": \"This detailed policy covers all types of extended leave, including medical leave, parental leave, and personal leave. It outlines eligibility requirements, application procedures, and benefits continuation. Includes detailed legal considerations and complex scenarios.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65179", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential support and resources for employees experiencing personal or work-related challenges. Focuses on mental health and well-being.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65179", "text": "{\n    \"policy_id\": \"ENG-2024-001\",\n    \"policy_title\": \"Engineering Department Remote Work Guidelines\",\n    \"policy_description\": \"Specific guidelines for remote work arrangements within the Engineering department. Covers equipment, security, and communication protocols.\",\n    \"effective_date\": \"2024-04-01\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/eng_remote_work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65180", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the holistic well-being of its employees, including access to mental health resources, wellness programs, and flexible work arrangements. It addresses burnout prevention, stress management, and promotes a healthy work-life balance.  The policy also covers procedures for requesting accommodations related to mental health and provides guidance for managers on supporting employee well-being. It is regularly reviewed and updated to reflect best practices and employee needs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-policy-wb-2023-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65180", "text": "{\n    \"policy_id\": \"LEAVE-2022-101\",\n    \"policy_title\": \"Vacation Leave Policy\",\n    \"policy_description\": \"Employees are entitled to two weeks of paid vacation leave per year, accruing based on length of service. Requests must be submitted to managers at least two weeks in advance. Unused vacation time does not roll over.\",\n    \"effective_date\": \"2022-10-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation-leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65181", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and well-being through various programs and resources. It covers mental health support, fitness initiatives, and preventative care.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
