{"_id": "human_resources--hr_policies:_doc--p--64065", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the various benefits available to employees to support their physical, mental, and financial wellbeing. This includes gym memberships, mental health resources, and financial planning assistance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
