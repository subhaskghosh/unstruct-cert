{"_id": "human_resources--hr_policies:_doc--n--62610", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the comprehensive leadership development program offered to employees at all levels. It includes workshops, mentoring opportunities, and external training courses designed to enhance leadership skills and prepare employees for future roles within the organization. The program is a significant investment in our employees' growth and aims to foster a culture of continuous learning and development.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-training\"\n}"}
