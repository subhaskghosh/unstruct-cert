{"_id": "human_resources--hr_policies:_doc--n--71359", "text": "{\n    \"policy_id\": \"RET-PLAN-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Information about the company's 401k retirement savings plan, including contribution limits and investment options.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71360", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can choose from a variety of plans to best suit their needs. The company contributes a percentage of the premium, with the remainder deducted from the employee's paycheck. Detailed information on coverage levels, deductibles, and co-pays can be found in the full policy document. This policy aims to ensure employees have access to high-quality healthcare and promotes employee well-being. Any changes to health insurance providers or coverage levels will be communicated at least 30 days in advance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71360", "text": "{\n    \"policy_id\": \"EMP-RET-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k retirement savings plan. Employees can contribute a percentage of their salary, and the company offers a matching contribution. Vesting schedules and withdrawal rules are outlined in the document. Employees are encouraged to consult with a financial advisor to determine the best investment strategy for their individual needs.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71361", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to employees. It also includes details on employee assistance programs and wellness initiatives designed to support employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness_benefits.pdf\"\n}"}
