{"_id": "human_resources--hr_policies:_doc--p--68589", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to providing employees with comprehensive health, dental, and vision insurance, as well as wellness programs aimed at promoting a healthy lifestyle. It covers preventative care, mental health services, and employee assistance programs.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001\"\n}"}
