{"_id": "human_resources--hr_policies:_doc--p--70701", "text": "{\n    \"policy_id\": \"HB-2023-005\",\n    \"policy_title\": \"Employee Health Benefits Program\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It includes details on medical, dental, and vision coverage.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_benefits_policy_2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70701", "text": "{\n    \"policy_id\": \"HB-2022-001\",\n    \"policy_title\": \"Comprehensive Health and Wellness Policy\",\n    \"policy_description\": \"A detailed guide to employee health and well-being, including preventative care, mental health resources, and wellness programs.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/comprehensive_health_wellness_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70702", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health. Includes gym membership discounts and access to counseling services.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70702", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"Detailed coverage information for Long-Term Disability Insurance benefits, including eligibility requirements, claim procedures, benefit amounts, and coordination with other insurance plans. This document contains comprehensive information on policy exclusions, waiting periods, and definitions of key terms.  The policy also details the appeals process and contact information for the insurance provider. This is a complex document designed to comply with all relevant legal standards and provide maximum clarity to employees. Further details concerning specific medical conditions are outlined in Appendix A.  We are committed to providing comprehensive protection for our employees in case of long-term disability. This document is intended for internal use only and does not constitute a legal agreement.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70703", "text": "{\n    \"policy_id\": \"WB-ENG-20240115\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, to promote employee work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-arrangements.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70703", "text": "{\n    \"policy_id\": \"LOA-HR-20221220\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave of absence, including medical leave, parental leave, and personal leave.\",\n    \"effective_date\": \"2022-12-20\",\n    \"last_updated\": \"2023-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70704", "text": "{\n    \"policy_id\": \"BEN-2023-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package offered to all eligible employees. It covers health insurance, dental insurance, vision insurance, life insurance, disability insurance, paid time off, sick leave, parental leave, and retirement plan options. Detailed information on each benefit, including eligibility requirements, enrollment procedures, and coverage details, is provided in the attached document. The company strives to provide competitive benefits to attract and retain top talent. Employees are encouraged to review this policy carefully and contact HR with any questions. This policy applies to all full-time and part-time employees who have completed their probationary period. Benefits are subject to change based on market conditions and company performance.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70704", "text": "{\n    \"policy_id\": \"TRAV-2022-002\",\n    \"policy_title\": \"Business Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for reasonable and necessary expenses incurred during business travel. Expenses include transportation, lodging, meals, and incidental expenses. All travel must be pre-approved by a manager. Receipts must be submitted for all expenses. This policy applies to all employees who are required to travel for business purposes.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-reimbursement.pdf\"\n}"}
