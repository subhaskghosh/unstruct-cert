{"_id": "human_resources--hr_policies:_doc--p--70079", "text": "{\n    \"policy_id\": \"EMP-GROWTH-001\",\n    \"policy_title\": \"Employee Development and Training\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee growth through training programs, mentorship opportunities, and skill development workshops. It aims to enhance employee capabilities and career progression within the organization.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-development.pdf\"\n}"}
