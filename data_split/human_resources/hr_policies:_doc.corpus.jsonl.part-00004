{"_id": "human_resources--hr_policies:_doc--p--62633", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being. It covers gym membership subsidies, mental health resources, and annual health checkups.  The goal is to promote a healthy and productive workforce.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62633", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k plan, including eligibility requirements, contribution matching, vesting schedules, investment options, and withdrawal procedures. It also addresses compliance with relevant federal and state regulations. The plan is designed to provide employees with a secure financial future during retirement, offering a range of investment opportunities and financial guidance. Detailed information regarding plan administration, enrollment, and participant rights are outlined in the attached documentation. Amendments to this plan are subject to legal review and approval by the finance committee. It's a highly complex plan.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
