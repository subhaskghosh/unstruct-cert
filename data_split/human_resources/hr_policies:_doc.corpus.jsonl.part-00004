{"_id": "human_resources--hr_policies:_doc--n--68075", "text": "{\n    \"policy_id\": \"EMP-REL-005\",\n    \"policy_title\": \"Employee Relocation Assistance\",\n    \"policy_description\": \"This policy details the procedures and financial assistance available to employees who are relocating for company business. It covers moving expenses, temporary housing, and other related costs. This policy is very comprehensive and detailed, spanning multiple scenarios and requirements. It aims to support employees who are experiencing geographic changes in their roles. The policy is regularly reviewed to ensure it remains competitive and compliant with current regulations. It includes detailed guidelines on eligibility, expense reimbursement, and approval processes. Employees are encouraged to review the complete policy document for a comprehensive understanding of their relocation benefits.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/relocation-policy\"\n}"}
