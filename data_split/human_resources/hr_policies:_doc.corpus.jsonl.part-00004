{"_id": "human_resources--hr_policies:_doc--p--71404", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details on enrollment and coverage levels are provided in the full document.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71404", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Employee Stock Option Plan\",\n    \"policy_description\": \"This policy details the employee stock option plan and eligibility requirements for receiving stock options. It outlines the vesting schedule and exercise procedures.\",\n    \"effective_date\": \"2021-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71405", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Spending Account (FSA) Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to utilize Flexible Spending Accounts for eligible healthcare and dependent care expenses. It aims to provide employees with tax advantages and greater control over their healthcare spending.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/fsa-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71405", "text": "{\n    \"policy_id\": \"REC-INT-002\",\n    \"policy_title\": \"Interview Process Guidelines\",\n    \"policy_description\": \"This policy details the standardized process for conducting interviews with potential candidates, including behavioral questions and assessment methods. Ensures a fair and consistent candidate experience.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Hiring Managers\"\n    ],\n    \"policy_document_url\": \"https://example.com/interview-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71406", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including access to gym memberships and mental health resources.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71406", "text": "{\n    \"policy_id\": \"EB-2022-010\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"Details the coverage and procedures for employees eligible for long-term disability benefits. This includes information on qualifying conditions, benefit levels, and the claims process. The policy aims to provide financial security to employees unable to work due to illness or injury, offering a comprehensive support system to navigate challenging life events and ensure continued well-being during periods of extended absence from the workplace. This covers eligibility criteria, benefit calculation, waiting periods, and required documentation.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71407", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, compressed workweeks, and flexible hours, designed to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible_work_arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71407", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment Policy\",\n    \"policy_description\": \"Details the process for enrolling in company-sponsored health insurance plans.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance_enrollment.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71408", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to providing employees with comprehensive health, dental, vision, and wellness benefits. It details coverage options, eligibility requirements, and procedures for enrollment and claims. The policy also includes information about employee assistance programs and mental health resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71408", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Employee Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for reimbursing employees for travel-related expenses incurred while on company business. It outlines eligible expenses, documentation requirements, and reimbursement procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expenses.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71409", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the full range of employee benefits, including health insurance, retirement plans, and paid time off. This policy emphasizes equitable access to benefits for all eligible employees and outlines procedures for enrollment and claims.\",\n    \"effective_date\": \"2022-07-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/employee-benefits-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71409", "text": "{\n    \"policy_id\": \"EMP-INT-005\",\n    \"policy_title\": \"Internship Benefits and Compensation\",\n    \"policy_description\": \"This policy details benefits and compensation packages specifically for interns within the company. It covers housing allowances, travel stipends, and other internship-specific benefits.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/internship-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71410", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee wellbeing, offering resources for mental health, physical fitness, and financial wellness. It outlines available programs, reimbursement options, and contact information for support.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71410", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"This policy outlines the guidelines for employees working remotely, including eligibility requirements, security protocols, and performance expectations.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71411", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, offering resources for mental and physical health. It includes access to an Employee Assistance Program (EAP) and wellness workshops.  It aims to foster a positive and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71411", "text": "{\n    \"policy_id\": \"LV-2022-010\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This comprehensive policy details all types of leaves of absence available to employees, including sick leave, parental leave, and personal leave. It covers eligibility requirements, application procedures, and benefits continuation. Detailed guidelines are provided for each type of leave, including required documentation and timelines. The policy also addresses compliance with relevant federal and state laws.  It further expands upon various leave scenarios and legal protections.  It outlines the complex interaction between different types of leave and the impact on employee benefits. It is a lengthy and detailed document designed to cover all possible scenarios.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71412", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance benefits available to all eligible employees, including coverage levels, premiums, and enrollment procedures. This policy has been updated to include telehealth options.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
