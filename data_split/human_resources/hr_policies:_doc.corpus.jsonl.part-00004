{"_id": "human_resources--hr_policies:_doc--p--70740", "text": "{\n    \"policy_id\": \"EXP-2023-001\",\n    \"policy_title\": \"Employee Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit and receive reimbursements for legitimate business expenses. It emphasizes ease of use and timely processing.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense-reimbursement-policy\"\n}"}
