{"_id": "human_resources--hr_policies:_doc--n--67016", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A comprehensive and detailed plan outlining compensation structures for executive-level employees, including salary, bonuses, stock options, and other benefits. It covers complex calculations and legal considerations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-plan\"\n}"}
