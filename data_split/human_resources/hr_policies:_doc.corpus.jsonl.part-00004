{"_id": "human_resources--hr_policies:_doc--p--68916", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, vision, and wellness benefits available to all eligible employees. It includes information on coverage levels, enrollment procedures, and preventative care programs. It also outlines the company's commitment to employee well-being and long-term health security.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68916", "text": "{\n    \"policy_id\": \"EMP-TIME-005\",\n    \"policy_title\": \"Vacation and Sick Leave Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing vacation and sick leave. It covers eligibility requirements, accrual rates, and approval processes.  It supports short term employee wellbeing.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-time-005\"\n}"}
