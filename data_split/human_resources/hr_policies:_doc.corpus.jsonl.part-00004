{"_id": "human_resources--hr_policies:_doc--n--62957", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"Detailed guidelines regarding executive compensation, including salary, bonus structures, stock options, and benefits. This policy includes complex calculations and eligibility criteria as defined by the Board of Directors. It also covers severance packages and performance-based incentives.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-comp\"\n}"}
