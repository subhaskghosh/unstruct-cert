{"_id": "human_resources--hr_policies:_doc--n--64205", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Equity Incentive Plan\",\n    \"policy_description\": \"This policy governs the grant and vesting of equity awards to eligible employees, including stock options and restricted stock units.  It is subject to the terms and conditions outlined in the underlying award agreements and relevant securities laws.  Detailed legal counsel was utilized in its creation. Compliance is mandatory.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-incentive-plan\"\n}"}
