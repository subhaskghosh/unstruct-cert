{"_id": "human_resources--hr_policies:_doc--p--62370", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Comprehensive Benefits Package - FY24\",\n    \"policy_description\": \"Details the comprehensive benefits package for all eligible employees, including health insurance, retirement plans, and paid time off. Focuses on financial wellbeing through robust 401k matching and employee stock purchase programs.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/eb-2023-005.pdf\"\n}"}
