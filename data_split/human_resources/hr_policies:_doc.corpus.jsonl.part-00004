{"_id": "human_resources--hr_policies:_doc--n--68817", "text": "{\n    \"policy_id\": \"LEAVE-2022-002\",\n    \"policy_title\": \"Extended Leave of Absence Procedures\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving extended leaves of absence, covering various scenarios such as medical leave, parental leave, and personal leave. This document is quite comprehensive and outlines legal requirements.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-2022-002.pdf\"\n}"}
