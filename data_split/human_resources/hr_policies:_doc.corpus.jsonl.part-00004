{"_id": "human_resources--hr_policies:_doc--p--62557", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health & Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including details on health insurance, wellness programs, and employee assistance services. Benefits include gym membership discounts and mental health resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62557", "text": "{\n    \"policy_id\": \"EMP-LEAV-005\",\n    \"policy_title\": \"Extended Leave of Absence Policy\",\n    \"policy_description\": \"This policy provides details regarding extended leaves of absence, including medical leave, family leave, and personal leave. It includes complex eligibility requirements, documentation procedures, and interactions with short-term and long-term disability insurance. The complete legal framework associated with FMLA and state-specific leave laws is contained within this document.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/extended_leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62558", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"Details coverage options for employee health insurance, including medical, dental, and vision. Covers eligibility, enrollment, and claims processes.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62558", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Employee Compensation and Performance Review\",\n    \"policy_description\": \"A comprehensive guide to the company’s compensation philosophy, performance review process, and bonus structures. Includes detailed information on salary bands, merit increases, and stock options. Also details disciplinary actions and termination policies.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/hr/compensation-review\"\n}"}
