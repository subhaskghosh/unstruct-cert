{"_id": "human_resources--hr_policies:_doc--p--61538", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Work-Life Balance & Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, remote work, and time-off requests to support employees in achieving a healthy work-life balance. Includes details on parental leave, personal days, and compressed workweeks.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-09-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/worklifebalance.pdf\"\n}"}
