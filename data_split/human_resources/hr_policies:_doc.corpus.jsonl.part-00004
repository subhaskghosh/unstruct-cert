{"_id": "human_resources--hr_policies:_doc--n--71992", "text": "{\n    \"policy_id\": \"EXEC-COMP-001\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Outlines the terms and conditions of the company's stock option plan for executive-level employees.  Focuses on long-term incentive alignment.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71993", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits - Enhanced Coverage\",\n    \"policy_description\": \"This policy outlines the comprehensive health insurance benefits available to all employees, designed to support their wellbeing and provide peace of mind. Coverage includes medical, dental, and vision, with flexible plan options. We believe this policy shows our commitment to our employees' health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-insurance-2024.pdf\"\n}"}
