{"_id": "human_resources--hr_policies:_doc--p--64723", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources for physical, mental, and financial wellness. It includes details on gym membership discounts, Employee Assistance Program (EAP) access, and financial planning workshops. The program is designed to support employees in achieving a healthy work-life balance and improving their overall quality of life. Participation is encouraged for all employees.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
