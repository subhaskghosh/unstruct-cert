{"_id": "human_resources--hr_policies:_doc--p--61917", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the employee wellness benefits program, including gym membership discounts, mental health resources, and annual health screenings. It's designed to promote employee well-being and reduce healthcare costs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_benefits_policy.pdf\"\n}"}
