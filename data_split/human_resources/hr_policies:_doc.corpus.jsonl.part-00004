{"_id": "human_resources--hr_policies:_doc--n--67424", "text": "{\n    \"policy_id\": \"LGL-2023-005\",\n    \"policy_title\": \"Comprehensive Employee Leave and Absence Policy\",\n    \"policy_description\": \"This policy details all forms of leave available to employees, including sick leave, vacation leave, parental leave, and unpaid leave. It also covers the legal requirements related to each type of leave, with detailed procedures and documentation requirements, and stipulations regarding eligibility and accrual rates.  It is a very complex and detailed document covering many legal scenarios.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/leave-policy\"\n}"}
