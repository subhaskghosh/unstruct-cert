{"_id": "human_resources--hr_policies:_doc--n--62709", "text": "{\n    \"policy_id\": \"LGL-003\",\n    \"policy_title\": \"Legal Compliance - Data Privacy\",\n    \"policy_description\": \"This comprehensive policy details the company's commitment to protecting employee and customer data in accordance with all applicable laws and regulations.  It covers data collection, storage, access, and disposal procedures, and includes detailed sections on GDPR, CCPA, and other relevant legislation. This document is critical for maintaining legal compliance and avoiding penalties. The policy also covers incident response procedures and employee training requirements.  It is reviewed annually by legal counsel and updated as necessary to reflect changes in the legal landscape.  A thorough understanding of this policy is mandatory for all employees handling sensitive data. Further detailed guidelines are available within the attached documentation.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Legal\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/data-privacy.pdf\"\n}"}
