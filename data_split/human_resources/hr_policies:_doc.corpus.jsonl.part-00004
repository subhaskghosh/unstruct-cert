{"_id": "human_resources--hr_policies:_doc--n--61914", "text": "{\n    \"policy_id\": \"PTO-2022-005\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"Outlines the procedures for requesting and utilizing paid time off, including vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto/pto-2022-005.pdf\"\n}"}
