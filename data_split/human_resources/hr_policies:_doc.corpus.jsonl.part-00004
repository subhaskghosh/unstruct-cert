{"_id": "human_resources--hr_policies:_doc--n--68554", "text": "{\n    \"policy_id\": \"EMP-INC-002\",\n    \"policy_title\": \"Sales Commission Plan\",\n    \"policy_description\": \"Outlines the commission structure for the Sales department, including targets and payout rates. This policy focuses on rewarding sales performance through variable compensation.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales/commission-plan.pdf\"\n}"}
