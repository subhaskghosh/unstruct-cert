{"_id": "human_resources--hr_policies:_doc--n--71975", "text": "{\n    \"policy_id\": \"LVE-2022-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This comprehensive document details all types of leave of absence available to employees, including medical leave, parental leave, and personal leave. It covers eligibility requirements, application procedures, and associated benefits. The policy also describes the process for returning to work after a leave of absence, ensuring compliance with all applicable laws and regulations. The documentation provides details on short-term and long-term disability options. It also contains information regarding FMLA compliance and other relevant legislation.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy.pdf\"\n}"}
