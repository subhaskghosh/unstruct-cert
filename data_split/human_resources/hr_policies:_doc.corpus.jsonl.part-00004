{"_id": "human_resources--hr_policies:_doc--p--70394", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various programs and resources, including mental health support, fitness initiatives, and work-life balance resources. It aims to foster a positive and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
