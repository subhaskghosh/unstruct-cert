{"_id": "human_resources--hr_policies:_doc--p--68327", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources and support for physical, mental, and emotional health. It includes provisions for flexible work arrangements, wellness workshops, and access to confidential counseling services.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68327", "text": "{\n    \"policy_id\": \"CD-2022-005\",\n    \"policy_title\": \"Code of Conduct - Performance Issues\",\n    \"policy_description\": \"This policy details the procedures for addressing employee performance issues, including verbal warnings, written warnings, and performance improvement plans. It outlines the steps involved in disciplinary action and termination.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68328", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential counseling and support services for personal and work-related issues. It focuses on promoting mental and emotional wellbeing.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68328", "text": "{\n    \"policy_id\": \"TMP-ASSIGN-005\",\n    \"policy_title\": \"Temporary Assignment Benefits\",\n    \"policy_description\": \"Details benefits available to employees on short-term assignments, including housing allowances and travel reimbursements. This policy involves complex calculations based on assignment length and location, and is designed for temporary employees only.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/temp_benefits.pdf\"\n}"}
