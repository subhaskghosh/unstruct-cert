{"_id": "human_resources--hr_policies:_doc--p--64382", "text": "{\n    \"policy_id\": \"WB-2023-101\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing, including mental health resources, physical wellness initiatives, and financial wellness tools. It aims to create a healthy and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64382", "text": "{\n    \"policy_id\": \"LEAV-2022-050\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy details the provisions for employees taking leave due to the death of a family member. It outlines the amount of paid leave available and the required documentation.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64383", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It provides details on coverage, premiums, and enrollment procedures. It is designed to be straightforward and easy to understand.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64383", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"This document details the terms and conditions of the company's equity compensation plan, including stock options, restricted stock units, and performance shares, as governed by Section 409A of the Internal Revenue Code. Complex legal terminology is used throughout.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-plan-document\"\n}"}
