{"_id": "human_resources--hr_policies:_doc--p--69488", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for eligible employees. It details eligibility criteria, equipment requirements, and performance expectations for employees working remotely. The policy supports flexible working and aims to enhance work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69488", "text": "{\n    \"policy_id\": \"TRVL-2022-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related travel expenses. It covers transportation, lodging, meals, and other eligible costs. Adherence to this policy ensures accurate expense reporting and compliance with company financial guidelines.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--69489", "text": "{\n    \"policy_id\": \"POL-007\",\n    \"policy_title\": \"Attendance and Punctuality\",\n    \"policy_description\": \"This policy outlines the expectations regarding employee attendance, punctuality, and procedures for reporting absences. It emphasizes the importance of consistent attendance for maintaining productivity and meeting business objectives. Details regarding remote work attendance are included.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/attendance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69489", "text": "{\n    \"policy_id\": \"POL-012\",\n    \"policy_title\": \"Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit expense reports for business-related expenses, including travel, meals, and other allowable costs. It outlines the required documentation and approval process.\",\n    \"effective_date\": \"2023-01-20\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/expenses.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--69490", "text": "{\n    \"policy_id\": \"RW-2024-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees engaging in remote work arrangements. It covers eligibility, equipment, security, and performance expectations. This policy aims to facilitate flexible work options while maintaining productivity and data protection.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--69490", "text": "{\n    \"policy_id\": \"ATT-2023-002\",\n    \"policy_title\": \"Attendance and Punctuality Policy\",\n    \"policy_description\": \"This policy details expectations regarding employee attendance, punctuality, and reporting of absences. It emphasizes the importance of consistent presence for maintaining operational efficiency.\",\n    \"effective_date\": \"2023-04-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--69491", "text": "{\n    \"policy_id\": \"EXP-REIMB-SALES-2023\",\n    \"policy_title\": \"Sales & Marketing Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing expenses incurred by Sales and Marketing employees during business travel. It details allowable expenses, submission requirements, and approval processes. All travel must be pre-approved. Covers mileage, lodging, and meals.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/exp_reimb_sales_marketing_2023.pdf\"\n}"}
