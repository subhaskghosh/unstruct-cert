{"_id": "human_resources--hr_policies:_doc--n--65436", "text": "{\n    \"policy_id\": \"LEGL-2022-010\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Detailed legal framework governing stock options, restricted stock units, and other equity-based compensation methods.  Includes complex vesting schedules and tax implications.  Requires legal counsel for full understanding.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Executive Leadership\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/equity_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65437", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, aimed at improving work-life balance and employee productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Product Development\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65437", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Standard Leave Policy\",\n    \"policy_description\": \"This policy details the standard leave entitlements for employees, including vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/standard-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65438", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources and support for physical, mental, and financial wellness. It covers gym memberships, mental health counseling, and financial planning workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65438", "text": "{\n    \"policy_id\": \"EMP-COMP-002\",\n    \"policy_title\": \"Employee Compensation and Performance Review\",\n    \"policy_description\": \"This policy details the procedures for employee performance reviews, salary adjustments, and bonus eligibility. It outlines performance metrics and the evaluation process.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-review.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65439", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health. It focuses on preventative care and a supportive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Research & Development\",\n        \"New Product Innovation\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65439", "text": "{\n    \"policy_id\": \"COMP-2023-005\",\n    \"policy_title\": \"Comprehensive Compensation and Benefits Policy\",\n    \"policy_description\": \"A detailed document outlining all aspects of employee compensation, including salary structures, bonus schemes, equity options, and benefits packages. It covers complex scenarios and legal requirements.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Legal\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65440", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Mental Health and Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental health and well-being, providing access to resources and promoting a healthy work-life balance.  It includes proactive measures like mindfulness workshops and stress management training.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"IT Security\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/mental-health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65440", "text": "{\n    \"policy_id\": \"LE-2023-012\",\n    \"policy_title\": \"Data Breach Incident Response\",\n    \"policy_description\": \"This policy details the procedures to be followed in the event of a data breach, including containment, notification, and remediation steps.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"IT Security\",\n        \"Legal\",\n        \"Compliance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/data-breach-response.pdf\"\n}"}
