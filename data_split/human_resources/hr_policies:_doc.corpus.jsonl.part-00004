{"_id": "human_resources--hr_policies:_doc--p--69324", "text": "{\n    \"policy_id\": \"HR-POL-0042\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for eligible employees, including requirements for equipment, security, and performance expectations. Remote work is encouraged to improve work-life balance.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote_work_policy.pdf\"\n}"}
