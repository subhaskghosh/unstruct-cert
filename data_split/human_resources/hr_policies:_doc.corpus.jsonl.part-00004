{"_id": "human_resources--hr_policies:_doc--p--67553", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the company's health insurance benefits for eligible employees. Coverage includes medical, dental, and vision. Employees can find details regarding plan options and enrollment procedures on the benefits portal. This policy is designed to provide comprehensive healthcare support to our workforce.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67553", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This comprehensive policy details procedures for submitting and receiving reimbursement for all work-related travel expenses. It covers pre-trip authorization, allowable expenses (including accommodation, meals, transportation, and incidental costs), documentation requirements, and the approval process. Specific mileage rates, per diem allowances, and expense limits are defined. Non-compliance with this policy may result in denial of reimbursement. Employees are responsible for familiarizing themselves with all aspects of this policy before undertaking any business travel. Includes detailed examples of claim submissions and supporting documentation needed for each expense category. This policy is subject to regular review and updates to ensure alignment with current travel industry standards and company financial guidelines. Appendix A contains a detailed breakdown of per diem rates by city. Appendix B provides a checklist for pre-trip authorization. Appendix C includes sample expense report forms.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67554", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67554", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A detailed plan outlining the deferred compensation benefits for executive-level employees, including complex vesting schedules and tax implications.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-plan\"\n}"}
