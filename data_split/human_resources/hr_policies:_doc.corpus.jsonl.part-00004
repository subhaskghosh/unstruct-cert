{"_id": "human_resources--hr_policies:_doc--p--65841", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing access to gym memberships, mental health resources, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65841", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the process for nominating and participating in the company's leadership development program.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-training\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65842", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Simple and straightforward enrollment process.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65842", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"Detailed policy governing executive compensation, including salary, bonuses, stock options, and restricted stock units. Contains complex legal clauses and vesting schedules.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65843", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources and support for physical, mental, and emotional health. Includes access to gym memberships and stress management workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65843", "text": "{\n    \"policy_id\": \"RW-002\",\n    \"policy_title\": \"Remote Work Agreement\",\n    \"policy_description\": \"This policy details the guidelines and expectations for employees working remotely, including eligibility, equipment, and security protocols.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65844", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering comprehensive benefits including mental health support, fitness reimbursements, and preventative care. It emphasizes a holistic approach to employee health, promoting work-life balance and reducing stress.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65844", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Expense Reimbursement Policy\",\n    \"policy_description\": \"Details the process for employees to submit and receive reimbursements for approved business expenses.  Includes guidelines on receipts, approvals, and allowable expense categories.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-01-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Administration\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/expense_reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65845", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee financial health through educational resources, workshops, and access to financial advisors. It aims to reduce financial stress and improve overall employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/financial_wellness_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65845", "text": "{\n    \"policy_id\": \"LVE-2022-002\",\n    \"policy_title\": \"Sick Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing sick leave benefits. It covers eligibility, accrual rates, and reporting requirements.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/sick_leave_policy\"\n}"}
