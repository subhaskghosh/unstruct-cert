{"_id": "human_resources--hr_policies:_doc--p--65031", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Mental Health and Well-being\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental health and overall well-being, including resources for stress management, resilience training, and access to counseling services. It aims to foster a positive and supportive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Human Resources\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-v1.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65031", "text": "{\n    \"policy_id\": \"LOA-2023-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details regarding different types of leave available to employees, including sick leave, parental leave, and personal leave. Procedures for requesting and approving leave are outlined.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65032", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete range of benefits available to all eligible employees, including health insurance, retirement plans, paid time off, and wellness programs. It provides detailed information on enrollment procedures, eligibility requirements, and benefit levels.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/package2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65032", "text": "{\n    \"policy_id\": \"TRV-2023-005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the guidelines for reimbursing employees for reasonable and necessary travel expenses incurred while on company business. It covers topics such as airfare, lodging, meals, and transportation.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Consulting\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65033", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and work-life balance. It promotes a supportive and healthy work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65033", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details procedures for requesting and managing extended leaves of absence, covering medical, family, and personal reasons. Includes detailed legal considerations and documentation requirements.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65034", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial wellness.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65034", "text": "{\n    \"policy_id\": \"LEAVE-2023-001\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"Details regarding time off granted to employees following the death of a family member.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65035", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including access to mental health resources, fitness programs, and ergonomic assessments. It promotes a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65035", "text": "{\n    \"policy_id\": \"LE-002\",\n    \"policy_title\": \"Legal Compliance Regarding Data Privacy\",\n    \"policy_description\": \"This comprehensive policy details the company's adherence to all relevant data privacy laws and regulations, including GDPR, CCPA, and HIPAA. It includes extensive guidelines on data collection, storage, processing, and security.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-01-05\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65036", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee physical and mental wellbeing through various resources and programs, including gym memberships, mental health counseling, and wellness workshops.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Research\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-engineering\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65036", "text": "{\n    \"policy_id\": \"LV-ENG-2022-002\",\n    \"policy_title\": \"Leave of Absence Procedures\",\n    \"policy_description\": \"Details procedures for requesting and managing various types of leave, including sick leave, personal leave, and family leave.  Focuses on compliance and documentation.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-procedures-engineering\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65037", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources and support for physical, mental, and financial health. It includes details on gym memberships, employee assistance programs, and financial planning workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65037", "text": "{\n    \"policy_id\": \"EXEC-COMP-005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Details the terms and conditions for stock options granted to executive-level employees. Includes vesting schedules and exercise procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-stock-option-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65038", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to gym memberships, mental health resources, and health screenings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65038", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"401k Contribution Matching\",\n    \"policy_description\": \"Details the company's 401k plan and contribution matching policy.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"HR\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65039", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance benefits offered to employees, including coverage options and enrollment procedures. This policy aims to support employee well-being and provide access to quality healthcare.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65039", "text": "{\n    \"policy_id\": \"EMP-COND-001\",\n    \"policy_title\": \"Employee Conduct and Ethics\",\n    \"policy_description\": \"Outlines the expected standards of conduct and ethical behavior for all employees, covering areas such as conflicts of interest, confidentiality, and workplace harassment. It includes a comprehensive section on legal compliance and disciplinary procedures. This is a very detailed document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/conduct-ethics-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65040", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Policy\",\n    \"policy_description\": \"Details coverage options for medical, dental, and vision insurance for employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65040", "text": "{\n    \"policy_id\": \"EMP-RET-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Information regarding the company's 401k retirement savings plan, including eligibility and contribution options.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-09-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65041", "text": "{\n    \"policy_id\": \"BNF-2024-003\",\n    \"policy_title\": \"Employee Wellness Benefits Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various health and wellness programs, including gym memberships, mental health support, and health insurance options. It aims to attract and retain top talent by providing a comprehensive benefits package.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65041", "text": "{\n    \"policy_id\": \"DSC-2023-007\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct, performance issues, and disciplinary actions. It outlines the steps involved in warnings, performance improvement plans, and potential termination of employment.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-procedures\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65042", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various programs and resources, including mental health support, fitness initiatives, and stress management workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65042", "text": "{\n    \"policy_id\": \"IT-2022-102\",\n    \"policy_title\": \"Acceptable Use of Company Technology\",\n    \"policy_description\": \"This policy details the acceptable use of company-owned computers, networks, and other technology resources. It covers security protocols, data privacy, and responsible online behavior. Includes detailed sections on encryption, data retention, and incident reporting.\",\n    \"effective_date\": \"2022-12-20\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Security\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/it-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65043", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the company's Employee Assistance Program (EAP), providing confidential support services for employees dealing with personal or work-related challenges. It covers counseling, legal advice, and financial guidance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65043", "text": "{\n    \"policy_id\": \"LOA-2022-005\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Detailed guidelines and procedures for employees requesting extended leaves of absence, including medical leave, family leave, and sabbatical options. Covers eligibility criteria, application processes, and benefits continuation during leave.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65044", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Mental Health and Wellbeing\",\n    \"policy_description\": \"This policy outlines resources and support available to employees for maintaining their mental health and overall wellbeing, including access to counseling services and flexible work arrangements.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65044", "text": "{\n    \"policy_id\": \"PR-2023-005\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"Details the annual performance review process, including goal setting, feedback mechanisms, and performance improvement plans.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65045", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Spending Account (FSA) Guidelines\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to participate in the Flexible Spending Account program, allowing pre-tax contributions for eligible medical and dependent care expenses. It aims to improve employee financial well-being and provide support for family needs.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Accounting\"\n    ],\n    \"policy_document_url\": \"https://example.com/fsa-guidelines\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65045", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Equity Compensation Plan - Restricted Stock Units\",\n    \"policy_description\": \"Details the company's equity compensation plan for executives, including vesting schedules, tax implications, and legal considerations for Restricted Stock Units (RSUs). This is a complex plan with strict eligibility criteria.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Legal\",\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/rsu-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65046", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for physical, mental, and financial health. It aims to create a supportive and positive work environment, reducing stress and enhancing overall job satisfaction.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65046", "text": "{\n    \"policy_id\": \"DISC-002\",\n    \"policy_title\": \"Disciplinary Action Policy\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and performance issues. It outlines a progressive discipline process to ensure fair and consistent treatment.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Management\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-action\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65047", "text": "{\n    \"policy_id\": \"BNF-2024-003\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees. This includes health insurance (medical, dental, and vision), life insurance, disability insurance, paid time off (vacation, sick leave, and holidays), and retirement savings plans (401k with company match). Eligibility requirements, enrollment procedures, and plan details are provided in full. The policy also details how to make changes to benefit elections during open enrollment or due to qualifying life events. We aim to provide our employees with the best possible benefits to support their well-being and financial security.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-2024.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65047", "text": "{\n    \"policy_id\": \"TRV-2023-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy governs the reimbursement of travel expenses incurred by employees while conducting company business. It covers transportation, lodging, meals, and other reasonable expenses. Employees must submit expense reports with supporting documentation to receive reimbursement. All travel must be pre-approved by the employee's manager.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65048", "text": "{\n    \"policy_id\": \"WB-2023-01\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-arrangements.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65048", "text": "{\n    \"policy_id\": \"EXEC-COMP-2022-05\",\n    \"policy_title\": \"Executive Compensation and Benefits\",\n    \"policy_description\": \"Details regarding compensation packages and benefits for executive-level employees.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65049", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, physical fitness, and financial wellness. It promotes a supportive work environment and encourages work-life balance.\",\n    \"effective_date\": \"2023-09-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65049", "text": "{\n    \"policy_id\": \"PM-2024-001\",\n    \"policy_title\": \"Performance Improvement Plan\",\n    \"policy_description\": \"This policy details the process for addressing employee performance issues, including documentation, coaching, and potential disciplinary action.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-04-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-improvement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65050", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and enhance productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65050", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the process for employees to enroll in and manage their health insurance benefits.  Includes information on plan options, premiums, and eligibility requirements.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65051", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential support and resources to employees experiencing personal or work-related challenges to promote mental and emotional well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy\"\n}"}
