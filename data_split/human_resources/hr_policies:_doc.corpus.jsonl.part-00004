{"_id": "human_resources--hr_policies:_doc--p--62154", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and adjusted schedules, aimed at improving work-life balance. It is designed to support employee well-being and increase productivity. Employees must submit a formal request and obtain manager approval.  All arrangements are subject to business needs.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62154", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This document details the company's comprehensive health insurance plan, covering medical, dental, and vision care for all eligible employees and their dependents. It outlines eligibility requirements, coverage levels, provider networks, and claims procedures. The plan is regularly reviewed to ensure it remains competitive and meets the needs of our workforce. Details about the health insurance provider and the specific coverage for various procedures are included in the linked document.  The policy also includes details regarding pre-authorization, out-of-network care, and appeals processes. Furthermore, it outlines the employee’s responsibilities regarding accurate reporting of dependent information and timely payment of premiums. This is a long, detailed document.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
