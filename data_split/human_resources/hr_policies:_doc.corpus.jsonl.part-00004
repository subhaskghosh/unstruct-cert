{"_id": "human_resources--hr_policies:_doc--p--65899", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete range of benefits offered to employees, including health insurance, retirement plans, paid time off, wellness programs, and tuition reimbursement. It details eligibility requirements, enrollment procedures, and coverage details for each benefit.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Marketing\",\n        \"Public Relations\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits.pdf\"\n}"}
