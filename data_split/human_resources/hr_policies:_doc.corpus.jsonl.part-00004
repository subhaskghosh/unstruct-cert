{"_id": "human_resources--hr_policies:_doc--n--61541", "text": "{\n    \"policy_id\": \"TRV-2022-002\",\n    \"policy_title\": \"Employee Travel Expenses\",\n    \"policy_description\": \"This policy details the reimbursement procedures for employee travel expenses related to business trips.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expenses-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61542", "text": "{\n    \"policy_id\": \"PTO-2023-SM\",\n    \"policy_title\": \"Paid Time Off Policy - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off (PTO) for employees within the Sales and Marketing departments. Eligible employees accrue PTO based on their years of service, as detailed in the accrual schedule. Requests must be submitted through the HRIS system at least two weeks in advance and are subject to manager approval. Unused PTO can be carried over up to a maximum of 80 hours.  This policy also covers bereavement leave, sick leave, and personal days, all falling under the PTO umbrella.  Specific requirements for each leave type are outlined, including documentation needs. We encourage employees to plan their time off effectively to ensure minimal disruption to business operations. This policy is designed to promote a healthy work-life balance and provide employees with the flexibility they need.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-sales-marketing-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61542", "text": "{\n    \"policy_id\": \"PTO-2023-GEN\",\n    \"policy_title\": \"General Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the basic PTO guidelines for all employees.  Employees accrue PTO based on tenure. Requests should be submitted via the HR portal.\",\n    \"effective_date\": \"2023-01-05\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Interns\"\n    ],\n    \"policy_document_url\": \"https://example.com/general-pto-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--61543", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to promote work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61543", "text": "{\n    \"policy_id\": \"EMP-DISC-002\",\n    \"policy_title\": \"Employee Disciplinary Action Policy\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and implementing disciplinary actions. It outlines the steps involved in investigation, warnings, and potential termination.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-09-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary-action.pdf\"\n}"}
