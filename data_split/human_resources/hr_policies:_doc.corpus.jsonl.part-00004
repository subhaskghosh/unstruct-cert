{"_id": "human_resources--hr_policies:_doc--p--67768", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential counseling and support services to employees facing personal or work-related challenges. It covers mental health, stress management, and work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
