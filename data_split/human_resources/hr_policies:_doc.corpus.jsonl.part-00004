{"_id": "human_resources--hr_policies:_doc--n--67080", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy details the provisions for long-term disability insurance, including eligibility criteria, benefit levels, and the claims process. It covers employees who are unable to work due to a qualifying disability as defined by the policy. The policy also includes a detailed explanation of the appeals process, coordination with other benefits, and the impact of other income sources on benefit payments. Furthermore, it addresses changes in marital status and other life events that may affect coverage. The policy is subject to periodic review and may be amended as necessary to comply with applicable laws and regulations.  The full document also contains extensive tables and legal disclaimers.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67081", "text": "{\n    \"policy_id\": \"PB-2023-005\",\n    \"policy_title\": \"Performance Bonus Policy\",\n    \"policy_description\": \"This policy outlines the criteria and process for awarding performance bonuses to eligible employees. It details the performance metrics, bonus calculation methodology, and eligibility requirements. This is to incentivize high performance and reward exceptional contributions.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Business Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pb-2023-005.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67081", "text": "{\n    \"policy_id\": \"LE-2022-012\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave of absence, including sick leave, parental leave, and personal leave. It ensures compliance with relevant labor laws and provides guidelines for maintaining employee benefits during leave.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2022-12-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/le-2022-012.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67082", "text": "{\n    \"policy_id\": \"COI-2023-SM\",\n    \"policy_title\": \"Conflicts of Interest - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines guidelines for employees in Sales and Marketing to avoid conflicts of interest that could compromise company revenue or ethical standards. It covers outside employment, personal financial interests, and acceptance of gifts.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/COI-2023-SM.pdf\"\n}"}
