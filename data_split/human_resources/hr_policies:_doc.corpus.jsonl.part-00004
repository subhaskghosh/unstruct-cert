{"_id": "human_resources--hr_policies:_doc--p--71776", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Enhanced Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package offered to all eligible employees, including health insurance, dental, vision, life insurance, 401k matching, and paid time off.  It aims to attract and retain top talent by offering competitive benefits.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71776", "text": "{\n    \"policy_id\": \"BNF-2022-005\",\n    \"policy_title\": \"Basic Health Insurance Policy\",\n    \"policy_description\": \"This policy outlines the standard health insurance options available to employees. It covers medical, dental, and vision care. Limited to basic coverage.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2022-06-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_basic.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71777", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Domestic Benefits Package - Standard\",\n    \"policy_description\": \"Details the standard domestic benefits package offered to eligible employees, including health insurance, paid time off, and retirement plan options.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71777", "text": "{\n    \"policy_id\": \"INT-BEN-002\",\n    \"policy_title\": \"International Employee Benefit Relocation\",\n    \"policy_description\": \"Outlines benefits for employees on international assignment, covering healthcare, housing, and relocation expenses.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/int-ben-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71778", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Comprehensive Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee well-being, offering extensive health, dental, and vision coverage, along with mental health resources and financial wellness programs. It includes support for remote and hybrid work arrangements.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71778", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Basic Health Insurance Policy\",\n    \"policy_description\": \"This policy outlines the minimum health insurance coverage provided to all full-time employees. It covers essential medical expenses but does not include wellness programs or comprehensive mental health support. The policy is designed for standard office settings.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Operations\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/basic-health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71779", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee wellness, including gym memberships, health screenings, and mental health resources. It provides benefits to support a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71779", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Benefits Package Overview\",\n    \"policy_description\": \"This document outlines all employee benefits including health insurance, retirement plans, and paid time off. It is a lengthy and very detailed resource for understanding your benefits.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-overview\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71780", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources for mental and physical health, including gym memberships, counseling services, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program_details.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71780", "text": "{\n    \"policy_id\": \"RW-002\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy details the guidelines for employees working remotely, including eligibility, equipment, and security protocols.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote_work_guidelines.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71781", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, including gym membership reimbursements and mental health resources.\",\n    \"effective_date\": \"2023-07-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71781", "text": "{\n    \"policy_id\": \"LEG-0011\",\n    \"policy_title\": \"Non-Disclosure Agreement and Intellectual Property Protection\",\n    \"policy_description\": \"A comprehensive legal document detailing the terms and conditions surrounding confidential information and intellectual property rights within the company. Requires legal review.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Engineering\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/nda-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71782", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, providing resources and programs to support physical and mental health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
