{"_id": "human_resources--hr_policies:_doc--p--67977", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees. It covers medical, dental, and vision care. Employees can enroll during the annual open enrollment period.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67977", "text": "{\n    \"policy_id\": \"EMP-LEAV-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures and eligibility requirements for employees requesting extended leave of absence, including medical leave, parental leave, and personal leave. It provides information on required documentation, notification timelines, and benefits continuation during the leave period.  This policy is comprehensive and covers various scenarios, including short-term and long-term disability, FMLA, and state-specific leave laws.  Detailed information on each type of leave is provided in the appendices.  It also includes guidelines for returning to work after a leave of absence, including reasonable accommodations and performance expectations. Employees are encouraged to consult with HR to understand their rights and responsibilities under this policy.  The policy also addresses potential disciplinary actions for non-compliance with notification or documentation requirements.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67978", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial planning.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67978", "text": "{\n    \"policy_id\": \"EMP-TRA-012\",\n    \"policy_title\": \"Sales Training Reimbursement\",\n    \"policy_description\": \"This policy outlines the reimbursement process for sales team members attending approved training programs.\",\n    \"effective_date\": \"2023-05-20\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales-training.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67979", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Remote Work Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the process for remote employees to request reimbursement for reasonable and necessary expenses incurred while working remotely, such as home office equipment and internet access.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67979", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"Details the process for employees to enroll in company-sponsored health insurance plans.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-10-27\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-enrollment\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67980", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Details on premiums, deductibles, and co-pays are available in the full policy document. Employees must enroll during the annual open enrollment period.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67980", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This comprehensive leadership development program is designed to cultivate future leaders within the organization. It includes a series of workshops, mentoring opportunities, and challenging assignments aimed at enhancing leadership skills, strategic thinking, and decision-making abilities. The program is highly selective and requires nomination from a manager. It consists of multiple phases: initial assessment, core leadership modules, specialized tracks, and executive coaching. Participants are evaluated based on their performance in each phase, their contributions to team projects, and their overall potential for leadership roles.  The program is continuously refined based on feedback from participants and organizational needs.  Successful completion of the program is a significant step towards advancement within the company.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67981", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"Provides comprehensive health insurance coverage to eligible employees.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67981", "text": "{\n    \"policy_id\": \"LVP-2023-002\",\n    \"policy_title\": \"Long-Term Vacation Policy\",\n    \"policy_description\": \"This document details the extensive guidelines and procedures for requesting and approving long-term leave, encompassing eligibility requirements, application processes, continuation of benefits, return-to-work procedures, and potential impact on performance evaluations. It also addresses scenarios involving extended medical leave and special circumstances requiring departmental approval. Furthermore, it outlines responsibilities for both employees and managers throughout the leave period, including communication protocols and documentation requirements. This policy aims to provide a clear and structured framework for managing long-term leave requests while ensuring business continuity and employee well-being.  The policy is subject to change with 30 days notice.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/long_term_vacation\"\n}"}
