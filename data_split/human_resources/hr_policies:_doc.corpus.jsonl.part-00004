{"_id": "human_resources--hr_policies:_doc--p--64727", "text": "{\n    \"policy_id\": \"BEN-SAL-001\",\n    \"policy_title\": \"Sales Department Employee Health Benefit\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all full-time employees within the Sales department. Coverage includes medical, dental, and vision plans. Details regarding eligibility, enrollment, and claim procedures can be found in the linked document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/sales_health.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64727", "text": "{\n    \"policy_id\": \"BEN-ALL-002\",\n    \"policy_title\": \"Comprehensive Employee Wellness Program\",\n    \"policy_description\": \"This policy details the company's comprehensive employee wellness program, including preventative care initiatives, mental health resources, financial wellness workshops, and employee assistance programs. It covers a wide range of services designed to support the overall well-being of our employees.  This policy is structured to support employee growth and holistic health.  We will continue to add services as employee needs dictate. The program is designed to be easily integrated into daily routines, and we encourage all employees to take advantage of these resources. Eligibility extends to all full-time and part-time employees and their dependents, with specific details outlined in the program guidelines.  Further clarification can be found on the HR intranet or by contacting the wellness team directly.  A detailed FAQ document is also available. The policy is reviewed annually to ensure its continued relevance and effectiveness. The wellness program also includes optional health risk assessments and personalized coaching sessions. Participation is voluntary, but highly encouraged.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness/program_details.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64728", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources and support for physical and mental health. Includes details on gym memberships, mental health counseling, and wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64728", "text": "{\n    \"policy_id\": \"EMP-LVE-002\",\n    \"policy_title\": \"Employee Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking leaves of absence, including medical leave, personal leave, and parental leave.  It outlines eligibility requirements and documentation needed.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64729", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Health Insurance Policy\",\n    \"policy_description\": \"Details the health insurance benefits available to all eligible employees, including coverage levels and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64729", "text": "{\n    \"policy_id\": \"EMP-TRV-002\",\n    \"policy_title\": \"Employee Travel Reimbursement Policy\",\n    \"policy_description\": \"Outlines the process and guidelines for reimbursing employees for business-related travel expenses.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_reimbursement_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64730", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial planning. It includes details on gym membership discounts, Employee Assistance Program (EAP), and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64730", "text": "{\n    \"policy_id\": \"TRAV-EXP-002\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business travel expenses, including airfare, lodging, and meals. It also outlines approved spending limits and required documentation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64731", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness Program - Engineering\",\n    \"policy_description\": \"This policy outlines the Employee Wellness Program specifically for the Engineering department, focusing on resources and initiatives to support physical and mental well-being, including flexible work arrangements and stress management training.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-eng-2024-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64731", "text": "{\n    \"policy_id\": \"LEAVE-ALL-2023-002\",\n    \"policy_title\": \"Annual Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving annual leave for all employees.\",\n    \"effective_date\": \"2023-12-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-all-2023-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64732", "text": "{\n    \"policy_id\": \"BNF-001\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including flexible work options such as remote work, compressed workweeks, and job sharing. It also details resources available for mental and physical health support.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-flexibility\"\n}"}
