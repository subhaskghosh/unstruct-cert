{"_id": "human_resources--hr_policies:_doc--p--67784", "text": "{\n    \"policy_id\": \"BNF-2023-001\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete benefits package available to all eligible employees, including health insurance, dental, vision, life insurance, 401k matching, paid time off, and employee assistance programs. It details eligibility requirements, enrollment procedures, and coverage levels for each benefit. This document also includes information on wellness initiatives and resources.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive_benefits_package.pdf\"\n}"}
