{"_id": "human_resources--hr_policies:_doc--n--62821", "text": "{\n    \"policy_id\": \"COMP-0015\",\n    \"policy_title\": \"Employee Compensation Guidelines\",\n    \"policy_description\": \"This policy outlines the company's approach to employee compensation, including salary ranges, bonus structures, and performance-based increases. It covers all levels of employees and is subject to regular review and updates to ensure fairness and competitiveness in the marketplace. This document provides a comprehensive overview of the compensation philosophy, procedures, and related guidelines.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62822", "text": "{\n    \"policy_id\": \"BNF-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing. It provides details on available resources such as gym memberships, mental health support, and annual health screenings. The program aims to promote a healthy work-life balance and reduce stress levels. It also covers financial wellness workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62822", "text": "{\n    \"policy_id\": \"BNF-2022-001\",\n    \"policy_title\": \"401k Plan Details\",\n    \"policy_description\": \"This document provides a comprehensive overview of the company's 401k retirement savings plan, including eligibility requirements, contribution limits, investment options, vesting schedules, loan provisions, and withdrawal rules. It also details the procedures for enrolling in the plan and making changes to contributions. This policy is very detailed and aims to cover every aspect of the 401k plan for all employees. It covers all changes to the plan since it was established in 2010.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62823", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellbeing Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources for mental health support, physical wellness initiatives, and work-life balance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-program\"\n}"}
