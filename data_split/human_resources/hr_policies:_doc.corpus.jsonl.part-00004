{"_id": "human_resources--hr_policies:_doc--p--62887", "text": "{\n    \"policy_id\": \"PTO-2024-SM\",\n    \"policy_title\": \"Paid Time Off Policy - Sales & Marketing\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and using paid time off for employees in the Sales and Marketing departments. It covers vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-sm.pdf\"\n}"}
