{"_id": "human_resources--hr_policies:_doc--n--62204", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy details the provisions for long-term disability insurance, including eligibility requirements, benefit amounts, and the claims process. This is a comprehensive document covering all aspects of LTD, including legal considerations and specific state regulations. The full document contains detailed information regarding benefit calculations, waiting periods, and the appeals process. It also specifies the roles and responsibilities of employees, managers, and the insurance provider.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/ltd-insurance\"\n}"}
