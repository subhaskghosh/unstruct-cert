{"_id": "human_resources--hr_policies:_doc--n--62171", "text": "{\n    \"policy_id\": \"LVE-2022-005\",\n    \"policy_title\": \"Long-Term Vacation Entitlement\",\n    \"policy_description\": \"This policy outlines the accrual rates and usage guidelines for long-term vacation leave, covering eligibility criteria, request procedures, carryover rules, and approval processes. It also details the impact of leave on benefits and performance reviews.  It is a comprehensive document designed to ensure fair and consistent application of vacation policies across all departments, ensuring employees are able to take adequate rest and rejuvenation time without compromising operational efficiency or project deliverables. Specific considerations are given to employees with differing tenure and performance levels, with extended leave options available for high-performing individuals. The policy also includes provisions for emergency leave and leave donation programs.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-08-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/long-term-vacation\"\n}"}
