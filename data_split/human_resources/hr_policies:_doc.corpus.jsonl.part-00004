{"_id": "human_resources--hr_policies:_doc--n--67580", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This comprehensive policy provides long-term disability benefits to eligible employees who are unable to work due to illness or injury. It details eligibility requirements, benefit levels, waiting periods, and the claims process.  The policy is designed to protect employees' income and provide financial security during periods of disability.  It also specifies coordination with other benefits, such as workers' compensation and Social Security. Furthermore, it outlines the appeals process for denied claims and provides contact information for the insurance provider and HR department. This policy is subject to periodic review and modification to ensure compliance with applicable laws and regulations. It also includes a detailed section on return-to-work programs and accommodations for employees with disabilities. The policy strives to maintain a balance between providing adequate protection for employees and managing costs effectively. Employee assistance programs and other resources are also highlighted within the document. Lastly, it clearly outlines the definition of 'disability' as it pertains to the policy.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67581", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits provided to eligible employees. Coverage includes medical, dental, and vision care. Employees are responsible for a portion of the premium, as detailed in the benefits enrollment guide. The policy aims to provide comprehensive healthcare options to support employee wellbeing.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67581", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Retirement Savings Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) retirement savings plan, including eligibility criteria, contribution limits, vesting schedules, investment options, and loan provisions.  Employees are encouraged to participate in the plan to secure their financial future. This policy also complies with all relevant ERISA regulations, and is subject to change based on legal and financial considerations.  It outlines the different investment options available, the procedures for making contributions, and the process for withdrawing funds.  Detailed information regarding the plan administration, including fees and expenses, is also provided. Further, this policy acknowledges the importance of financial literacy and offers resources for employees seeking to better understand their retirement planning options.  Finally, it addresses the role of the plan fiduciaries and their responsibilities in managing the plan for the benefit of all participants.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67582", "text": "{\n    \"policy_id\": \"ETH-2023-001\",\n    \"policy_title\": \"Employee Code of Conduct\",\n    \"policy_description\": \"This policy outlines the expected ethical behavior and professional standards for all employees.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/code-of-conduct\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67582", "text": "{\n    \"policy_id\": \"CMP-2024-002\",\n    \"policy_title\": \"Sales Commission Structure\",\n    \"policy_description\": \"Details the commission plan for Sales representatives, including targets and payout rates.\",\n    \"effective_date\": \"2024-03-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67583", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health. It includes gym membership discounts and access to an employee assistance program.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67583", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance plan offered to all eligible employees. It covers medical, dental, and vision care, with detailed information on deductibles, co-pays, and coverage limits.  It also includes information on pre-existing conditions, out-of-network care, and appeals processes. Detailed documentation on specific plan features, including HSA and FSA options, are outlined in the attachments. This is a lengthy document intended to provide complete information.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
