{"_id": "human_resources--hr_policies:_doc--p--61586", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees. It covers medical, dental, vision, and mental health services. The company is committed to supporting employee well-being and offers a range of resources to promote a healthy lifestyle. Eligibility requirements, enrollment procedures, and coverage details are fully described within this document. Changes to this policy will be communicated at least 30 days in advance.  Employees are encouraged to review this policy annually to ensure they are aware of their benefits.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
