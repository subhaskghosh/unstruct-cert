{"_id": "human_resources--hr_policies:_doc--n--68972", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"Detailed explanation of the company's 401k plan, including investment options, vesting schedules, and loan provisions.  This policy complies with all relevant ERISA regulations and incorporates complex actuarial calculations. Consult with a financial advisor for personalized guidance.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/401k_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68973", "text": "{\n    \"policy_id\": \"EMP-BEN-456\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee financial health through workshops, resources, and access to financial advisors.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial_wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68973", "text": "{\n    \"policy_id\": \"EMP-LEAV-789\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"Details the procedures for requesting and approving extended leave of absence for various personal or medical reasons. This is a very comprehensive document covering multiple scenarios.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/extended_leave_policy.pdf\"\n}"}
