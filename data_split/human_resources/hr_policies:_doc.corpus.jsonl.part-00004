{"_id": "human_resources--hr_policies:_doc--p--71854", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees' financial wellbeing through workshops, resources, and access to financial advisors. It covers topics such as budgeting, debt management, and retirement planning.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/financialwellnesspolicy\"\n}"}
