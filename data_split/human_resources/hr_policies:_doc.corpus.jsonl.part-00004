{"_id": "human_resources--hr_policies:_doc--n--71535", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"401k Contribution Guidelines\",\n    \"policy_description\": \"A comprehensive guide to the company's 401k plan, including eligibility, contribution limits, investment options, and withdrawal procedures. This document is 50 pages long and contains detailed legal disclaimers and complex financial information.  It is updated annually.\",\n    \"effective_date\": \"2022-12-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/401k_guidelines.pdf\"\n}"}
