{"_id": "human_resources--hr_policies:_doc--p--71202", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being. It provides details on access to mental health resources, gym membership discounts, and annual health screenings. The goal is to promote a healthy and productive work environment. The company will allocate a budget of $10,000 annually for wellness initiatives.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71202", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Health Insurance\",\n    \"policy_description\": \"This policy details the comprehensive health insurance benefits provided to all eligible employees. It covers medical, dental, and vision care. The policy includes information on deductibles, co-pays, and out-of-pocket maximums. It also outlines the process for submitting claims and appealing denied claims. Detailed information about each plan option, including provider networks, is available on the benefits portal. This policy also covers dependent benefits and provides information about COBRA continuation coverage. It also includes a section on preventative care and wellness programs. This is a very long and detailed document intended to cover all possibilities.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71203", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, covering medical, dental, and vision insurance, as well as wellness program access. It promotes a healthy work-life balance and provides resources for mental health support.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71203", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Equity Compensation and Stock Options\",\n    \"policy_description\": \"Details the company's stock option plan, vesting schedules, and related tax implications for eligible employees. This policy is quite detailed and may require external financial advice for understanding.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/stock-options.pdf\"\n}"}
