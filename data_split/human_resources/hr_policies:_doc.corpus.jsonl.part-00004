{"_id": "human_resources--hr_policies:_doc--p--64191", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellbeing and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing through flexible work arrangements, mental health resources, and wellness programs. It aims to help employees achieve a healthy balance between their work and personal lives.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-engineering\"\n}"}
