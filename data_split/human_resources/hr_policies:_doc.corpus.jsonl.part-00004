{"_id": "human_resources--hr_policies:_doc--n--65553", "text": "{\n    \"policy_id\": \"COMP-LEAV-005\",\n    \"policy_title\": \"Comprehensive Leave and Absence Management\",\n    \"policy_description\": \"A detailed policy outlining all leave types, eligibility criteria, procedures for requesting leave, and related legal compliance considerations.  Includes sections on FMLA, state leave laws, and company-specific leave options. Covers a wide variety of scenarios and complex interactions.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leave-005.pdf\"\n}"}
