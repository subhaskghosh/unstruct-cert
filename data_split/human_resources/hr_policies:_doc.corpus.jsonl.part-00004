{"_id": "human_resources--hr_policies:_doc--n--67206", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"401k Contribution and Vesting Schedule\",\n    \"policy_description\": \"Detailed information on 401k plan contributions, vesting schedules, and investment options, adhering to ERISA regulations. Complex calculations and legal disclaimers included.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67207", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, providing resources for mental and physical health, and promoting a healthy work-life balance.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
