{"_id": "human_resources--hr_policies:_doc--p--70639", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the complete benefits package offered to all eligible employees, including health insurance, dental, vision, 401k matching, paid time off, and sick leave. It details eligibility requirements, enrollment procedures, and coverage details for each benefit. It also covers changes due to life events and termination of benefits. This policy is reviewed and updated annually to remain compliant with legal requirements and competitive market standards.\",\n    \"effective_date\": \"2022-12-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_v2.pdf\"\n}"}
