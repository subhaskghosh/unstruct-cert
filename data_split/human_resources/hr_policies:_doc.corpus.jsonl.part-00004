{"_id": "human_resources--hr_policies:_doc--p--71486", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy outlines the provisions for employees taking leave due to the death of a family member. It aims to provide support during a challenging time and ensures employees can grieve and attend to personal matters without financial hardship.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/bereavement_leave.pdf\"\n}"}
