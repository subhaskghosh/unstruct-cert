{"_id": "human_resources--hr_policies:_doc--p--67729", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees are responsible for a portion of the premium, as detailed in the plan documents.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67729", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy details the long-term disability insurance benefits provided to employees. It covers situations where an employee is unable to work due to a qualifying disability, as defined by the insurance provider. Eligibility criteria, benefit levels, and claim procedures are outlined below. The policy adheres to all relevant legal regulations and provides a comprehensive safety net for our employees. It's crucial to understand the details of this plan to ensure you are prepared in the event of an unforeseen circumstance. We also provide access to resources that can help employees navigate the claims process, including a dedicated support line and online tutorials. The company has a strong commitment to employee well-being and considers this benefit a vital part of our overall compensation package.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/long-term-disability-policy\"\n}"}
