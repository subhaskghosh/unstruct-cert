{"_id": "human_resources--hr_policies:_doc--p--67507", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage includes medical, dental, and vision. Employees can find detailed information on the insurance provider's website. Enrollment is open annually during the benefits period.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67507", "text": "{\n    \"policy_id\": \"COMP-002\",\n    \"policy_title\": \"Compensation and Performance Review\",\n    \"policy_description\": \"This comprehensive policy details the compensation structure, performance review process, and promotion guidelines for all employees. It covers base salary, bonuses, stock options, and annual performance evaluations. This policy includes detailed explanations of the performance metrics, calibration processes, and associated forms, with a focus on legal compliance and fairness. It also incorporates all state and federal regulations regarding fair compensation practices. A detailed FAQ section is included at the end of this document. It's also a very complex and lengthy document.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67508", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67508", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"This policy details the compensation structure for executive-level employees, including salary, bonuses, stock options, and other equity-based incentives. It covers eligibility criteria, grant schedules, vesting periods, and performance-based payout mechanisms.  It is a very detailed and lengthy document covering multiple scenarios and legal considerations.\",\n    \"effective_date\": \"2022-11-10\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-compensation-policy\"\n}"}
