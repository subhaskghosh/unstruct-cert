{"_id": "human_resources--hr_policies:_doc--n--65441", "text": "{\n    \"policy_id\": \"ITSEC-2023-005\",\n    \"policy_title\": \"Remote Access Security Protocol\",\n    \"policy_description\": \"This policy details the security requirements for employees accessing company resources remotely. It covers VPN usage, data encryption, and acceptable use guidelines.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Security\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-access-security.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65442", "text": "{\n    \"policy_id\": \"WELL-ENG-2024001\",\n    \"policy_title\": \"Engineering Department Wellness Program\",\n    \"policy_description\": \"This policy outlines the wellness benefits available to employees in the Engineering department, focusing on mental and physical health resources and promoting a healthy work-life balance. It also details opportunities for skills development and internal mobility within the department.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellbeing-engineering.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65442", "text": "{\n    \"policy_id\": \"COMP-HR-2023005\",\n    \"policy_title\": \"Comprehensive Compensation and Benefits Guide\",\n    \"policy_description\": \"A detailed guide covering all aspects of employee compensation, including salary structures, bonus programs, equity options, and health insurance plans. Includes extensive legal disclaimers and detailed calculations.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-guide.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65443", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through a confidential Employee Assistance Program (EAP). It covers mental health, stress management, and work-life balance resources.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy\"\n}"}
