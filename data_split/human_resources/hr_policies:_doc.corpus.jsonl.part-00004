{"_id": "human_resources--hr_policies:_doc--n--65516", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation leave, and personal leave. It covers eligibility requirements and approval processes.\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65517", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, compressed workweeks, and flextime, designed to promote work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65517", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Traditional Vacation Policy\",\n    \"policy_description\": \"This policy outlines the standard vacation accrual and usage guidelines for all employees.\",\n    \"effective_date\": \"2018-05-10\",\n    \"last_updated\": \"2020-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65518", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential counseling and support services to employees facing personal or work-related challenges. It aims to promote employee well-being and improve overall job satisfaction.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65518", "text": "{\n    \"policy_id\": \"LB-2023-005\",\n    \"policy_title\": \"Leave of Absence - Extended Medical\",\n    \"policy_description\": \"Detailed procedures for employees requiring extended leave for medical reasons, including documentation requirements, benefits continuation, and return-to-work processes. Covers various scenarios, including short-term and long-term disability.\",\n    \"effective_date\": \"2023-11-20\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65519", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employee work-life balance and improve overall job satisfaction.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65519", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Compensation and Performance Review\",\n    \"policy_description\": \"This policy details the company's compensation structure, performance review process, and bonus eligibility criteria. It ensures fair and consistent compensation practices based on performance and contribution.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2023-06-30\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-review\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65520", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It includes details on preventative care, mental health resources, and a comprehensive wellness program designed to promote employee well-being. Recent updates reflect changes to federal healthcare regulations concerning preventative services and coverage.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65520", "text": "{\n    \"policy_id\": \"EMP-LV-002\",\n    \"policy_title\": \"Employee Leave Policy\",\n    \"policy_description\": \"This policy details the various types of leave available to employees, including sick leave, vacation time, and parental leave. It adheres to all applicable state and federal regulations regarding employee leave.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-lv-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65521", "text": "{\n    \"policy_id\": \"BNF-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym memberships, stress management resources, and financial planning workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65521", "text": "{\n    \"policy_id\": \"HLC-002\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"Details regarding medical, dental, and vision insurance plans offered to employees and their dependents.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65522", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines all benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It aims to provide a holistic benefits experience to attract and retain talent.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65522", "text": "{\n    \"policy_id\": \"PTO-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the guidelines for requesting and using paid time off, including vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65523", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and wellbeing.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-06-01\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Design\",\n        \"Research & Development\",\n        \"Content Creation\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements\"\n}"}
