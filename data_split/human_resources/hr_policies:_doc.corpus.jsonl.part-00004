{"_id": "human_resources--hr_policies:_doc--p--62183", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, premiums, and procedures for submitting claims. The company offers a range of plans to meet the diverse needs of its workforce, including HMO and PPO options. Employees are encouraged to review the plan documents carefully to understand their coverage. This policy emphasizes preventative care and wellness programs. Details regarding eligibility and enrollment can be found on the HR portal. It's crucial to note that this policy is regularly reviewed to ensure compliance with all applicable laws and regulations, and to adapt to changing healthcare landscape.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62183", "text": "{\n    \"policy_id\": \"RET-PLAN-001\",\n    \"policy_title\": \"401k Retirement Plan\",\n    \"policy_description\": \"This policy details the company's 401k retirement plan, including eligibility requirements, contribution limits, and investment options. Employees can contribute a percentage of their salary to the plan, and the company may offer a matching contribution. This plan is designed to help employees save for their future retirement needs.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62184", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Health & Wellness Benefit Program\",\n    \"policy_description\": \"Details the company's comprehensive health and wellness benefits, including medical, dental, and vision coverage, as well as employee assistance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_wellness.pdf\"\n}"}
