{"_id": "human_resources--hr_policies:_doc--n--68381", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Executive Compensation Policy\",\n    \"policy_description\": \"Comprehensive guidelines outlining compensation packages for executive-level employees, including stock options and performance bonuses. This policy is complex and requires legal review.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive_compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68382", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to improve work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68382", "text": "{\n    \"policy_id\": \"DA-2023-001\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and disciplinary actions.\",\n    \"effective_date\": \"2023-02-10\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Operations\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary-procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68383", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellbeing and Mental Health Support\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing, including mental health resources, stress management programs, and access to confidential counseling services. It provides detailed guidance on how to access these resources and encourages a culture of open communication and support.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-2023\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68383", "text": "{\n    \"policy_id\": \"LEAVE-2022-005\",\n    \"policy_title\": \"Bereavement Leave Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking bereavement leave following the death of a family member. It outlines the required documentation and the amount of leave granted.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/bereavement-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68384", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Enhanced Parental Leave Policy\",\n    \"policy_description\": \"This policy provides up to 12 weeks of paid parental leave for all eligible employees, regardless of gender, to support bonding with a new child. It aims to foster a supportive and inclusive work environment. The policy includes resources for transitioning back to work and maintaining work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/parental_leave_enhanced.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68384", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Standard Health Insurance Plan\",\n    \"policy_description\": \"Details the company’s standard health insurance plan options, including provider networks, coverage levels, and employee contribution rates. This policy is in compliance with all applicable state and federal regulations.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"HR\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance_standard.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68385", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support services to employees dealing with personal or work-related challenges. It covers counseling, legal assistance, and financial guidance. Promoting employee wellbeing and a positive work-life balance is a key objective.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68385", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and granting extended leaves of absence for medical, family, or personal reasons. It covers eligibility criteria, documentation requirements, and benefits continuation. This is a comprehensive document covering numerous scenarios.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68386", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"Details the full range of benefits available to full-time employees, including health insurance, retirement plans, and paid time off. Supports onboarding and employee well-being.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/employee-benefits-package.pdf\"\n}"}
