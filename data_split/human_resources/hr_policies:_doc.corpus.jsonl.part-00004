{"_id": "human_resources--hr_policies:_doc--n--62005", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This comprehensive policy details the leadership development program offered to mid-level and senior managers. It covers eligibility criteria, program structure, selection process, and performance expectations.  It includes detailed modules on change management, strategic thinking, emotional intelligence, and conflict resolution, spanning over several months with intensive workshops and coaching sessions. The goal is to cultivate future leaders within the organization.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
