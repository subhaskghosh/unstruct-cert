{"_id": "human_resources--hr_policies:_doc--p--65881", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Work-Life Balance & Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees in achieving a healthy work-life balance through flexible work arrangements, including remote work, flextime, and compressed workweeks. It aims to enhance employee well-being and productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/work-life-balance-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65881", "text": "{\n    \"policy_id\": \"BEN-2022-005\",\n    \"policy_title\": \"Health Insurance Benefits - 2023 Plan\",\n    \"policy_description\": \"Details the company's health insurance plan options, including medical, dental, and vision coverage. Explains eligibility, enrollment procedures, and premium contributions.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2022-12-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65882", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Aims to promote employee well-being and productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
