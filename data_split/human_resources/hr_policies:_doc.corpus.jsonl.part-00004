{"_id": "human_resources--hr_policies:_doc--p--62419", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care.  Details about coverage levels and enrollment procedures are provided. The aim of this policy is to support employee wellbeing and provide access to affordable healthcare.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62419", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the company's Leadership Development Program, designed to foster future leaders within the organization. It covers eligibility criteria, application procedures, program curriculum, and selection processes. It aims to enhance leadership skills and prepare employees for advancement opportunities. This is a detailed program with many components and takes multiple months to complete.\",\n    \"effective_date\": \"2023-06-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Management\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-program\"\n}"}
