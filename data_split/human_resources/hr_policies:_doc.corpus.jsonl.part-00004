{"_id": "human_resources--hr_policies:_doc--p--64163", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to eligible employees. It covers medical, dental, and vision plans. Details regarding eligibility, enrollment, and coverage levels are provided.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64163", "text": "{\n    \"policy_id\": \"EMP-TRAIN-002\",\n    \"policy_title\": \"Leadership Development Program\",\n    \"policy_description\": \"This policy details the company's Leadership Development Program, including eligibility criteria, program structure, and performance evaluation metrics. It's a comprehensive guide for managers and participants alike, aiming to foster future leaders within the organization. This is a very extensive document with a detailed curriculum.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/leadership-development.pdf\"\n}"}
