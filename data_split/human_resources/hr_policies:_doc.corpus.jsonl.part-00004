{"_id": "human_resources--hr_policies:_doc--p--69046", "text": "{\n    \"policy_id\": \"RW-SM-2024-001\",\n    \"policy_title\": \"Remote Work Policy for Sales & Marketing\",\n    \"policy_description\": \"This policy details the guidelines for remote work arrangements for employees in the Sales and Marketing departments. It outlines eligibility criteria, equipment requirements, and performance expectations for remote workers. This policy supports a flexible work environment while maintaining productivity and collaboration.  Remote work requests will be reviewed on a case-by-case basis.\",\n    \"effective_date\": \"2023-12-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/rw-sm-2024-001.pdf\"\n}"}
