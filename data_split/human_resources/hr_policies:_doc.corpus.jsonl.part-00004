{"_id": "human_resources--hr_policies:_doc--p--65827", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the company's Employee Assistance Program (EAP), providing confidential counseling and support services to employees experiencing personal or work-related challenges. It's designed to promote employee well-being and improve overall productivity.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65827", "text": "{\n    \"policy_id\": \"WB-002\",\n    \"policy_title\": \"Comprehensive Wellness Initiative\",\n    \"policy_description\": \"A detailed, multi-faceted wellness program encompassing preventative health screenings, fitness challenges, nutritional counseling, and mental health resources.  This policy includes extensive legal disclaimers and participation guidelines covering a wide range of scenarios. Extensive documentation is available covering many areas.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-initiative\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65828", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Mental Wellbeing Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee mental health through resources like counseling, stress management workshops, and flexible work arrangements.  It aims to create a supportive and inclusive environment where employees feel comfortable seeking help when needed.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-001\"\n}"}
