{"_id": "human_resources--hr_policies:_doc--n--71364", "text": "{\n    \"policy_id\": \"LGL-007\",\n    \"policy_title\": \"Data Privacy and Compliance\",\n    \"policy_description\": \"This policy details the company's adherence to all relevant data privacy regulations, including GDPR and CCPA. It outlines employee responsibilities regarding data handling and security.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-10-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/data-privacy.pdf\"\n}"}
