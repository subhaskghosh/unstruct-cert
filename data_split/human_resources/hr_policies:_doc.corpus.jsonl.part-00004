{"_id": "human_resources--hr_policies:_doc--n--67199", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Comprehensive details on the eligibility, vesting schedule, exercise procedures, and tax implications of stock options granted to executive-level employees. Requires specialized legal and financial understanding.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock_options.pdf\"\n}"}
