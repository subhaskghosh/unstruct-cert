{"_id": "human_resources--hr_policies:_doc--n--65546", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"A detailed and extensive guide to the company's retirement plan, including investment options, vesting schedules, loan provisions, and distribution rules. It also covers tax implications and regulatory compliance. This document contains several appendices with detailed information and FAQs.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/retirement-plan.pdf\"\n}"}
