{"_id": "human_resources--hr_policies:_doc--p--65676", "text": "{\n    \"policy_id\": \"EMP-BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, including details on gym membership reimbursements, mental health resources, and annual health screenings. It covers preventative care and promotes a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65676", "text": "{\n    \"policy_id\": \"TRAV-EXP-0005\",\n    \"policy_title\": \"Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to submit and receive reimbursement for business travel expenses, including airfare, lodging, and meals.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-07-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-expense-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65677", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees facing personal or work-related challenges. Focuses on mental health and overall well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65677", "text": "{\n    \"policy_id\": \"IT-SEC-005\",\n    \"policy_title\": \"Data Encryption Standard Policy\",\n    \"policy_description\": \"Details the mandatory data encryption protocols for all company devices and systems. Covers technical specifications and compliance requirements.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Security\",\n        \"Data Science\"\n    ],\n    \"policy_document_url\": \"https://example.com/encryption_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65678", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing. It includes provisions for gym memberships, mental health resources, and preventative care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65678", "text": "{\n    \"policy_id\": \"EMP-TERM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"This policy details the procedures for terminating an employee's employment with the company, including notice periods and final paychecks.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/termination-procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65679", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for employees seeking flexible work arrangements, including remote work, compressed workweeks, and flextime, to support work-life balance and employee well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65679", "text": "{\n    \"policy_id\": \"REL-001\",\n    \"policy_title\": \"Relocation Assistance\",\n    \"policy_description\": \"This policy details the company's guidelines and benefits provided to employees who are relocating for work-related purposes. It covers expenses such as moving costs, temporary housing, and travel.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/relocation-assistance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65680", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial wellness.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65680", "text": "{\n    \"policy_id\": \"LEGL-005\",\n    \"policy_title\": \"Extended Leave of Absence Procedures\",\n    \"policy_description\": \"Detailed procedures and documentation requirements for applying for extended leaves of absence, including medical, personal, and family care leaves. Compliance with all federal and state regulations is mandatory.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-procedures\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65681", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health and wellness benefits available to all employees, including medical, dental, and vision coverage. It details eligibility requirements, enrollment procedures, and coverage levels. Supports employee wellbeing and promotes a healthy work-life balance, offering support for physical and mental health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Customer Service\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65681", "text": "{\n    \"policy_id\": \"EMP-LEAVE-002\",\n    \"policy_title\": \"Vacation and Sick Leave Policy\",\n    \"policy_description\": \"This policy details the guidelines for requesting and taking vacation and sick leave. It covers eligibility, accrual rates, and approval processes. It also mentions the importance of proper documentation for leave requests and maintaining departmental coverage.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-leave-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65682", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Wellness Program - Engineering\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting the physical and mental well-being of employees in the Engineering department. It includes resources for stress management, fitness programs, and employee assistance.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-eng-2024-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65682", "text": "{\n    \"policy_id\": \"HR-GEN-2023-005\",\n    \"policy_title\": \"Comprehensive Compensation and Benefits Guide\",\n    \"policy_description\": \"A detailed guide covering all aspects of employee compensation, including salary structures, bonus programs, health insurance, retirement plans, and other benefits. This document is extensive and includes legal disclaimers, detailed plan descriptions, and contact information for benefits administrators.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compensation-benefits-guide.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65683", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential counseling and support services for personal and work-related issues.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
