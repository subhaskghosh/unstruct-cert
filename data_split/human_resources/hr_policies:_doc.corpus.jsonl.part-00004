{"_id": "human_resources--hr_policies:_doc--n--62231", "text": "{\n    \"policy_id\": \"LOA-2022-012\",\n    \"policy_title\": \"Extended Leave of Absence\",\n    \"policy_description\": \"This comprehensive policy details the procedures for requesting and managing extended leaves of absence for various reasons, including medical leave, family care leave, and personal leave. It covers eligibility requirements, documentation procedures, benefits continuation, and return-to-work guidelines. Detailed sections address compliance with federal, state, and local laws.  Further subsections detail specific leave types, including FMLA, parental leave, and short-term disability. It also covers the process for appealing leave requests and outlines the responsibilities of both employees and managers. The policy aims to ensure fair and consistent treatment of all employees while complying with legal obligations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62232", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Benefits Enrollment\",\n    \"policy_description\": \"Details the annual enrollment process for employee benefits, including health, dental, and vision insurance. Allows employees to customize their benefits package.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/flexible-enrollment\"\n}"}
