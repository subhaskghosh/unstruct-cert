{"_id": "human_resources--hr_policies:_doc--p--68197", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources for mental health, physical fitness, and financial wellness. It details access to an Employee Assistance Program (EAP) and subsidized gym memberships.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68197", "text": "{\n    \"policy_id\": \"TRVL-2023-002\",\n    \"policy_title\": \"Corporate Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for employees to request reimbursement for travel expenses incurred during business trips, including guidelines for airfare, accommodation, and per diem allowances. It includes a complex approval process requiring multiple levels of authorization.\",\n    \"effective_date\": \"2023-04-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68198", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, vision, and wellness benefits available to employees. It emphasizes resources for financial wellbeing like retirement planning and health savings accounts.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68198", "text": "{\n    \"policy_id\": \"EMP-LEAVE-002\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and utilizing paid time off for vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/pto\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68199", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, aimed at supporting employee work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Marketing\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68199", "text": "{\n    \"policy_id\": \"EMP-TRAIN-001\",\n    \"policy_title\": \"Mandatory Compliance Training\",\n    \"policy_description\": \"This policy details the mandatory compliance training requirements for all employees. It covers topics such as data privacy and ethical conduct.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-01-20\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Finance\",\n        \"Human Resources\",\n        \"IT\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/compliance-training.pdf\"\n}"}
