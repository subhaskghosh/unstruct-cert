{"_id": "human_resources--hr_policies:_doc--p--71025", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym memberships, mental health resources, and health screenings. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71025", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Complex Retirement Plan Details\",\n    \"policy_description\": \"This document provides comprehensive details regarding the company's 401(k) retirement plan, including vesting schedules, investment options, loan provisions, withdrawal rules, and associated tax implications. It covers a wide range of scenarios and legal considerations related to retirement savings, including hardship withdrawals, qualified domestic relations orders (QDROs), and compliance with ERISA regulations. Specific details about each investment fund are listed, along with performance data and associated fees. A detailed explanation of the plan's administrative process is also included, along with contact information for plan administrators and service providers. The document also outlines the procedures for making changes to the plan, such as updating beneficiary designations or adjusting contribution amounts. Furthermore, it provides guidance on how to navigate the plan's website and access online resources. This document is intended for plan participants and their advisors and should be reviewed carefully before making any investment decisions.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71026", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including gym reimbursements, mental health resources, and preventative care benefits. It supports a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-benefits.pdf\"\n}"}
