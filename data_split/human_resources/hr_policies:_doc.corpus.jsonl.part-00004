{"_id": "human_resources--hr_policies:_doc--p--68566", "text": "{\n    \"policy_id\": \"BEN-007\",\n    \"policy_title\": \"Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness benefits available to employees, including gym memberships, mental health resources, and preventative care. It aims to foster a healthy and productive workforce and mentions various wellness programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness_benefits.pdf\"\n}"}
