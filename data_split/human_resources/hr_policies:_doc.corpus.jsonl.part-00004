{"_id": "human_resources--hr_policies:_doc--p--71213", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the company's commitment to providing comprehensive health, dental, vision, and wellness benefits to eligible employees. It includes details on coverage levels, enrollment procedures, and available resources.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71213", "text": "{\n    \"policy_id\": \"RMT-WRK-002\",\n    \"policy_title\": \"Remote Work Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees working remotely to request reimbursement for necessary expenses such as internet, home office equipment, and ergonomic furniture.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-expenses\"\n}"}
