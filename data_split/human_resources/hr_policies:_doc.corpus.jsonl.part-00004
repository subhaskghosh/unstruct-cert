{"_id": "human_resources--hr_policies:_doc--p--71003", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Financial Assistance Policy\",\n    \"policy_description\": \"This policy outlines the process for employees to request financial assistance during times of hardship, including medical expenses and unexpected personal emergencies. It details eligibility criteria, application procedures, and repayment terms.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial-assistance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71003", "text": "{\n    \"policy_id\": \"VAC-0011\",\n    \"policy_title\": \"Vacation Time Accrual Policy\",\n    \"policy_description\": \"This policy details the accrual rates for vacation time based on years of service, eligibility requirements, and procedures for requesting time off. It also covers guidelines for carrying over unused vacation days.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/vacation-time-policy\"\n}"}
