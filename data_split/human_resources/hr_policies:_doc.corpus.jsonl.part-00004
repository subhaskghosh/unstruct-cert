{"_id": "human_resources--hr_policies:_doc--p--65617", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential counseling and support services for personal and work-related issues. The program aims to promote employee well-being and a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65617", "text": "{\n    \"policy_id\": \"DA-002\",\n    \"policy_title\": \"Attendance and Tardiness\",\n    \"policy_description\": \"This policy details the company's expectations regarding employee attendance and punctuality, including procedures for reporting absences and addressing tardiness. Repeated violations may result in disciplinary action.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65618", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the confidential support services available to employees to address personal or work-related challenges. Services include counseling, legal advice, and financial planning.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"Finance\",\n        \"IT Security\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65618", "text": "{\n    \"policy_id\": \"LO-005\",\n    \"policy_title\": \"Leave of Absence - Extended Medical\",\n    \"policy_description\": \"Detailed procedures for requesting and managing extended medical leaves of absence, including required documentation and approval processes. Includes specific guidelines for intermittent leave.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Benefits\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/extended_medical_leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65619", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including gym memberships, mental health resources, and healthy lifestyle initiatives.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-06-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65619", "text": "{\n    \"policy_id\": \"LEG-001\",\n    \"policy_title\": \"Data Privacy and Compliance\",\n    \"policy_description\": \"This policy details the procedures for handling sensitive employee data in accordance with GDPR and other relevant regulations.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65620", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, designed to support employees in balancing work and personal commitments. It aims to improve employee morale, productivity, and retention.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/flexible-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65620", "text": "{\n    \"policy_id\": \"PERF-001\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"This policy details the annual performance review process, including goal setting, feedback sessions, and performance evaluations. It is intended to ensure fair and consistent performance management practices.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65621", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential support and resources for employees dealing with personal or work-related challenges. It covers counseling, legal advice, and financial guidance.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65621", "text": "{\n    \"policy_id\": \"LC-2023-012\",\n    \"policy_title\": \"Data Privacy and Protection Policy\",\n    \"policy_description\": \"This policy details the company's procedures for collecting, storing, and processing employee data in accordance with applicable data privacy laws (GDPR, CCPA, etc.). It outlines employee responsibilities regarding data security.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65622", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program available to all employees, providing confidential support for personal and work-related issues. It covers counseling services, legal advice, and financial guidance.  We prioritize employee mental health and provide resources for a better work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65622", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Compensation and Benefits - Executive Level\",\n    \"policy_description\": \"Detailed policy regarding compensation structures, bonus eligibility, stock options, and benefits packages for executive-level employees. Includes information on performance-based incentives and long-term compensation plans. This is a comprehensive guide to executive compensation at the company.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive_compensation.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65623", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines all employee benefits, including health insurance, dental, vision, 401k matching, paid time off, and professional development allowances. It aims to attract and retain top talent by providing a competitive and comprehensive benefits package.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-v2.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65623", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Policy\",\n    \"policy_description\": \"Details the company's health insurance coverage options, including plan details, premiums, and eligibility requirements.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65624", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the comprehensive health, dental, vision, and wellness benefits available to all eligible employees. It includes information on enrollment, coverage levels, preventative care, and mental health resources. It outlines eligibility criteria, claim procedures, and contact information for benefit providers. This policy is intended to support employee wellbeing and attract top talent.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Account Management\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65624", "text": "{\n    \"policy_id\": \"EMP-TRAIN-003\",\n    \"policy_title\": \"New Employee Onboarding\",\n    \"policy_description\": \"This policy outlines the standard onboarding process for all new employees, including paperwork, IT setup, and initial training. It aims to ensure a smooth transition for new hires and familiarize them with company culture and expectations.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"IT\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-train-003.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65625", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellbeing and Stress Management\",\n    \"policy_description\": \"This policy outlines the resources available to employees to support their overall wellbeing, including programs for stress management, mental health support, and work-life balance. It aims to foster a healthy and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellbeing-policy-wb-2023-005\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65625", "text": "{\n    \"policy_id\": \"LEAVE-2022-001\",\n    \"policy_title\": \"Paid Time Off (PTO) Policy\",\n    \"policy_description\": \"This policy details the accrual, usage, and request process for paid time off for all employees. It covers vacation, sick leave, and personal days.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy-leave-2022-001\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65626", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to financial planning resources, gym memberships, and mental health support. It's designed to help employees achieve a healthy work-life balance and manage their financial health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65626", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Retirement Plan Contribution Limits\",\n    \"policy_description\": \"Details the annual contribution limits for the company's 401(k) retirement plan, including employer matching contributions and eligibility requirements.  This policy is highly detailed and covers complex tax implications.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Human Resources\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65627", "text": "{\n    \"policy_id\": \"BNF-2024-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage details, enrollment procedures, and contact information for the insurance provider are included.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65627", "text": "{\n    \"policy_id\": \"TRN-2023-002\",\n    \"policy_title\": \"Executive Compensation Plan\",\n    \"policy_description\": \"A detailed document outlining the compensation structure for executive-level employees, including base salary, bonus structures, equity grants, and long-term incentive plans.  This is a very lengthy and complex document.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/executive_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65628", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to mental health resources, fitness programs, and healthy eating initiatives.  It aims to foster a positive and supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65628", "text": "{\n    \"policy_id\": \"LEGL-2022-010\",\n    \"policy_title\": \"Comprehensive Legal Compliance Handbook\",\n    \"policy_description\": \"A detailed guide covering all legal aspects of employment, including discrimination, harassment, wage and hour laws, and privacy regulations. This document is highly comprehensive and intended for HR professionals and legal counsel.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal-handbook\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65629", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP) for High-Stress Teams\",\n    \"policy_description\": \"Provides confidential counseling and support services for employees experiencing work-related stress, particularly those involved in critical projects.  Focuses on mental health and work-life balance.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-highstress\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65629", "text": "{\n    \"policy_id\": \"VL-001\",\n    \"policy_title\": \"Vacation Leave Policy\",\n    \"policy_description\": \"Details the accrual and usage of vacation leave for all employees.  Includes guidelines for requesting time off and minimum staffing requirements.\",\n    \"effective_date\": \"2022-01-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/vacation-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65630", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, providing details on wellness initiatives, gym membership discounts, and mental health resources. This policy provides guidance for employees and managers on accessing and utilizing available wellness benefits.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65630", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the process for submitting and reimbursing employee travel expenses, including guidelines on acceptable expenses, documentation requirements, and approval procedures.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65631", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees experiencing personal or work-related challenges. Covers mental health, financial issues, and legal concerns.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65631", "text": "{\n    \"policy_id\": \"TR-005\",\n    \"policy_title\": \"Travel Reimbursement Guidelines\",\n    \"policy_description\": \"Details the procedures and limits for reimbursing employee travel expenses. Includes guidelines for booking flights, hotels, and other travel arrangements.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65632", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, aimed at promoting work-life balance and employee productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65632", "text": "{\n    \"policy_id\": \"EMP-BNF-002\",\n    \"policy_title\": \"Traditional Sick Leave Policy\",\n    \"policy_description\": \"This policy details the accrual and usage of traditional sick leave benefits.\",\n    \"effective_date\": \"2018-07-01\",\n    \"last_updated\": \"2019-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sick-leave.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65633", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial planning. It emphasizes work-life balance and offers flexible work arrangements where possible.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65633", "text": "{\n    \"policy_id\": \"LE-2023-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details the procedures for requesting and granting various types of leave, including sick leave, vacation, and personal leave.  Focuses on compliance and administrative details.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65634", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing access to gym memberships, mental health resources, and work-life balance initiatives like flexible work arrangements and paid time off for wellness activities. It's designed to promote a healthy and productive work environment.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65634", "text": "{\n    \"policy_id\": \"LOA-2023-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details procedures for requesting and managing various types of leave, including sick leave, parental leave, and personal leave.  This policy covers eligibility, application processes, and return-to-work guidelines.\",\n    \"effective_date\": \"2023-11-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65635", "text": "{\n    \"policy_id\": \"WB-2024-07-15\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and wellbeing, providing resources and incentives for participation in wellness activities.\",\n    \"effective_date\": \"2024-07-15\",\n    \"last_updated\": \"2024-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65635", "text": "{\n    \"policy_id\": \"LV-2023-01-01\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Details the procedures and guidelines for employees requesting a leave of absence.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65636", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can choose from several plans with varying levels of coverage. Details on enrollment and eligibility can be found in the full policy document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65636", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to all employees. It includes 401k matching contributions, pension plans, and financial planning assistance. The plan is designed to help employees save for a comfortable retirement. This policy also covers eligibility requirements, vesting schedules, and distribution options. The retirement plan is administered by a third-party provider, and employees can access detailed information through their online account. Contributions can be made pre-tax or post-tax. The plan includes various investment options. Employees are encouraged to meet with a financial advisor to make informed decisions. The plan has gone through multiple revisions and updates to ensure its compliance with all relevant regulations and its alignment with best practices in retirement planning. Further details can be found in the attached documentation. This policy also includes information on hardship withdrawals and loan options, as well as the implications of early retirement.\",\n    \"effective_date\": \"2023-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65637", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee health and well-being, including resources for mental and physical health.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65637", "text": "{\n    \"policy_id\": \"LEGL-005\",\n    \"policy_title\": \"Legal Compliance - Data Privacy\",\n    \"policy_description\": \"A comprehensive guide detailing all data privacy regulations and company procedures for handling sensitive information, covering GDPR, CCPA, and other relevant laws. This is a detailed legal document.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Finance\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65638", "text": "{\n    \"policy_id\": \"WB-2024-007\",\n    \"policy_title\": \"Employee Wellness and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee well-being through various programs, including flexible work arrangements, mental health resources, and wellness initiatives. It emphasizes the importance of maintaining a healthy work-life balance to enhance employee engagement and productivity.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-07-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-2024-007.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65638", "text": "{\n    \"policy_id\": \"LOA-2023-012\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, personal leave, and parental leave. It covers eligibility requirements, documentation procedures, and the impact on benefits.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2023-09-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/loa-2023-012.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65639", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"Provides comprehensive health insurance coverage for eligible employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65639", "text": "{\n    \"policy_id\": \"CMP-GNC-005\",\n    \"policy_title\": \"Code of Conduct Grievance Procedure\",\n    \"policy_description\": \"A detailed procedural guide outlining the steps for filing and resolving grievances related to violations of the company's code of conduct. Includes information on mediation, investigation, and potential disciplinary actions, as well as employee rights and responsibilities. This comprehensive document provides a framework for ensuring fair and transparent treatment of all employees.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/code-of-conduct-grievance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65640", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits provided to eligible employees. It includes details on coverage, premiums, and claim procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Technology\",\n        \"Engineering\",\n        \"Product Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65640", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"This policy details the company's equity compensation plan, including stock options, restricted stock units, and employee stock purchase program. It outlines eligibility, vesting schedules, and tax implications.  The legal jargon is substantial, and the documentation is extensive.\",\n    \"effective_date\": \"2022-11-10\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Technology\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-compensation-plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65641", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the complete health, dental, vision, and wellness benefits available to all eligible employees. It includes information on coverage levels, enrollment procedures, and available resources. We are committed to providing a supportive and healthy work environment.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65641", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for submitting and receiving reimbursement for travel expenses incurred during business trips. It covers allowable expenses and required documentation.\",\n    \"effective_date\": \"2022-06-10\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65642", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employees in achieving a better work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Marketing\",\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65642", "text": "{\n    \"policy_id\": \"EMP-BEN-012\",\n    \"policy_title\": \"Sales Commission Plan\",\n    \"policy_description\": \"This policy details the commission structure for the Sales department, including targets, payout rates, and performance reviews.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/sales-commission-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65643", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work and flexible hours, to support employee work-life balance and well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65643", "text": "{\n    \"policy_id\": \"LOA-002\",\n    \"policy_title\": \"Extended Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and approving extended leaves of absence for various reasons, including medical leave, family care, and personal reasons. It contains extensive legal disclaimers and detailed eligibility requirements.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/extended-leave-of-absence.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65644", "text": "{\n    \"policy_id\": \"WELL-DEV-001\",\n    \"policy_title\": \"Employee Growth and Development Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee growth through training, mentorship, and career advancement opportunities. It focuses on fostering a culture of continuous learning and provides resources for employees to enhance their skills and reach their full potential.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"Research & Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-growth-development\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65644", "text": "{\n    \"policy_id\": \"COMP-ETH-002\",\n    \"policy_title\": \"Code of Ethics and Conduct\",\n    \"policy_description\": \"This policy defines the ethical standards and expected conduct for all employees. It covers areas such as conflicts of interest, confidentiality, and compliance with applicable laws and regulations.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/code-of-ethics\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65645", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being through various resources and programs, including gym memberships, mental health support, and wellness workshops.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
