{"_id": "human_resources--hr_policies:_doc--n--65225", "text": "{\n    \"policy_id\": \"DISC-ACT-005\",\n    \"policy_title\": \"Employee Disciplinary Procedures\",\n    \"policy_description\": \"Outlines the process for addressing employee misconduct and implementing disciplinary actions.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Management\",\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary-actions\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65226", "text": "{\n    \"policy_id\": \"BEN-PTO-2023\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for requesting and utilizing paid time off, including vacation, sick leave, and personal days. It aims to provide employees with a healthy work-life balance and ensure adequate coverage during absences.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"All Departments\",\n        \"Leadership\",\n        \"Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto_policy_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65226", "text": "{\n    \"policy_id\": \"COMP-EXP-2024\",\n    \"policy_title\": \"Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy details the procedures for employees to submit and receive reimbursement for business-related expenses. It covers travel, meals, and other approved expenditures.\",\n    \"effective_date\": \"2024-03-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense_policy_2024.pdf\"\n}"}
