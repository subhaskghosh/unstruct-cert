{"_id": "human_resources--hr_policies:_doc--n--67234", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A comprehensive deferred compensation plan for executive level employees, detailing investment options, vesting schedules, and payout terms.  Includes detailed legal disclosures and complex financial calculations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/deferred_compensation_plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67235", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels, premiums, and enrollment procedures are provided in the attached document.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67235", "text": "{\n    \"policy_id\": \"EB-2022-001\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the comprehensive retirement plan offered to employees, including 401(k) contributions, employer matching, vesting schedules, and investment options. The plan is designed to help employees save for a financially secure future. It includes a detailed explanation of different investment strategies, risk assessments, and financial planning resources. The policy also outlines the process for withdrawals, loans, and rollovers. This document covers eligibility requirements, contribution limits, and the process for beneficiary designations. Please review this policy carefully to understand your retirement benefits and make informed decisions.  This document is also intended to clarify how changes in tax laws may affect your retirement savings. We encourage employees to attend informational sessions and seek professional financial advice to optimize their retirement planning strategy.  Finally, the document outlines the company's commitment to supporting employees in achieving their long-term financial goals.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy.pdf\"\n}"}
