{"_id": "human_resources--hr_policies:_doc--p--68238", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's health insurance plan, including coverage options, eligibility requirements, and enrollment procedures.  It's designed to be simple and straightforward for all employees.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68238", "text": "{\n    \"policy_id\": \"EXEC-COMP-005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This policy details the terms and conditions of stock option grants for executive leadership. It includes vesting schedules, exercise prices, and other complex financial details.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/stock-options\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68239", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the resources available to employees seeking support for personal or work-related challenges. It emphasizes confidentiality and proactive help-seeking.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Account Management\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68239", "text": "{\n    \"policy_id\": \"AT-2022-005\",\n    \"policy_title\": \"Attendance and Tardiness\",\n    \"policy_description\": \"This policy details the procedures for reporting absences and tardiness, as well as the consequences for violations.  It includes a detailed points-based system for tracking attendance issues and outlines disciplinary actions.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/attendance_policy.pdf\"\n}"}
