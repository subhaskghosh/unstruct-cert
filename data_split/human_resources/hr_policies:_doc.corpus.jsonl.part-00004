{"_id": "human_resources--hr_policies:_doc--n--68745", "text": "{\n    \"policy_id\": \"LEG-COMP-005\",\n    \"policy_title\": \"HIPAA Compliance and Protected Health Information\",\n    \"policy_description\": \"This policy details the company's compliance with the Health Insurance Portability and Accountability Act (HIPAA), outlining procedures for handling protected health information and ensuring patient privacy. It covers data security, access controls, and breach notification protocols. Includes specific legal disclaimers and obligations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"IT\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/hipaa-compliance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68746", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including mental health resources, fitness benefits, and work-life balance initiatives. It aims to create a supportive and healthy work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68746", "text": "{\n    \"policy_id\": \"LC-2023-005\",\n    \"policy_title\": \"Data Privacy Compliance\",\n    \"policy_description\": \"This policy details the company's procedures for collecting, storing, and protecting employee data in accordance with relevant data privacy regulations.  It establishes clear guidelines for data handling and security.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"IT\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68747", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Health Insurance Plan\",\n    \"policy_description\": \"This policy outlines the health insurance benefits offered to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels and enrollment procedures are available in the policy document.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68747", "text": "{\n    \"policy_id\": \"EB-2018-005\",\n    \"policy_title\": \"Comprehensive Retirement Savings Plan\",\n    \"policy_description\": \"This policy details the company's 401(k) plan, including eligibility requirements, contribution limits, vesting schedules, investment options, and loan provisions. It includes complex rules around employer matching, hardship withdrawals, and rollover procedures, and provides a detailed analysis of investment options and risk tolerance considerations.  This is a substantial document covering all aspects of retirement planning and is regularly updated to meet evolving regulatory requirements. Please see the complete documentation for a full understanding.\",\n    \"effective_date\": \"2018-06-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68748", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Flexible Work Arrangement Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees requesting flexible work arrangements, including remote work, adjusted hours, and compressed workweeks, to promote work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangement.pdf\"\n}"}
