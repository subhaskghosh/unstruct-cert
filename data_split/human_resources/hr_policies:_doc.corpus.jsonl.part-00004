{"_id": "human_resources--hr_policies:_doc--p--64570", "text": "{\n    \"policy_id\": \"BP-2023-007\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health and wellness benefits available to all eligible employees, including medical, dental, vision, and employee assistance programs. It emphasizes preventative care and promotes a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness-benefits\"\n}"}
