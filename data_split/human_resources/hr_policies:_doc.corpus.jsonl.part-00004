{"_id": "human_resources--hr_policies:_doc--p--68027", "text": "{\n    \"policy_id\": \"BNF-2024-003\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It covers eligibility requirements, enrollment procedures, and plan details. The policy aims to promote employee wellbeing and provide access to comprehensive healthcare.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
