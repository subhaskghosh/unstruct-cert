{"_id": "human_resources--hr_policies:_doc--n--68821", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"Outlines the procedures for submitting and reimbursing travel expenses incurred by employees on company business. Covers airfare, lodging, meals, and other travel-related costs.\",\n    \"effective_date\": \"2022-03-10\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/expense-policy.pdf\"\n}"}
