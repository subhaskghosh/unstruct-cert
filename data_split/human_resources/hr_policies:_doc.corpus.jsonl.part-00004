{"_id": "human_resources--hr_policies:_doc--p--68561", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness and Financial Assistance Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical, mental, and financial health. It includes details on gym membership reimbursements, employee assistance programs (EAP), and financial planning workshops.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-financial-assistance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68561", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"Details the health insurance plans available to employees and their dependents. Includes information on premiums, deductibles, and coverage options.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2022-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68562", "text": "{\n    \"policy_id\": \"EMP-BNF-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"Details the health insurance coverage provided to eligible employees, including plan options, costs, and enrollment procedures.  This policy aims to provide comprehensive and accessible healthcare benefits.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68562", "text": "{\n    \"policy_id\": \"EMP-TRM-002\",\n    \"policy_title\": \"Employee Termination Procedures\",\n    \"policy_description\": \"Outlines the steps and guidelines for terminating an employee's employment, including notice periods, severance pay, and final paychecks.  This policy ensures legal compliance and a consistent termination process.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Human Resources\",\n        \"Legal\",\n        \"Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/termination-procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68563", "text": "{\n    \"policy_id\": \"EMP-BEN-004\",\n    \"policy_title\": \"Health Insurance Coverage\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care, and details the process for enrollment and claims.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Customer Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
