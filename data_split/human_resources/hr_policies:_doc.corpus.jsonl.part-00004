{"_id": "human_resources--hr_policies:_doc--p--71991", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness and Financial Benefits\",\n    \"policy_description\": \"This policy outlines the various wellness programs and financial benefits available to employees, including health insurance, retirement plans, and employee assistance programs.  It aims to promote employee wellbeing and financial security.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-benefits.pdf\"\n}"}
