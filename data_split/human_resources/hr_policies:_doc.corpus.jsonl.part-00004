{"_id": "human_resources--hr_policies:_doc--p--70310", "text": "{\n    \"policy_id\": \"EXP-2023-001\",\n    \"policy_title\": \"Expense Reimbursement Policy\",\n    \"policy_description\": \"This policy outlines the procedures for employees to submit and receive reimbursement for business-related expenses, including travel and lodging. It applies to all departments requiring expense reporting.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/expense_policy.pdf\"\n}"}
