{"_id": "human_resources--hr_policies:_doc--p--61899", "text": "{\n    \"policy_id\": \"RW-2023-ENG-SALES-001\",\n    \"policy_title\": \"Remote Work Policy - Engineering & Sales\",\n    \"policy_description\": \"This policy outlines the guidelines for remote work arrangements for employees in the Engineering and Sales departments. It covers eligibility, equipment, security, and performance expectations. The policy aims to provide flexibility while ensuring productivity and collaboration.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy-eng-sales\"\n}"}
