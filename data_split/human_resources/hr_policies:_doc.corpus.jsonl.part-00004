{"_id": "human_resources--hr_policies:_doc--p--64386", "text": "{\n    \"policy_id\": \"WB-ENG-2024-001\",\n    \"policy_title\": \"Employee Assistance Program (EAP) - Engineering\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program available to all Engineering department employees, offering confidential counseling and support services for personal and work-related challenges. It emphasizes proactive wellbeing and stress management.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-engineering-policy\"\n}"}
