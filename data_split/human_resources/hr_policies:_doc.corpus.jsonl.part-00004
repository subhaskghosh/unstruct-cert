{"_id": "human_resources--hr_policies:_doc--p--61824", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels and eligibility requirements are included.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61824", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This policy details the company's comprehensive retirement plan, including 401(k) contributions, vesting schedules, and distribution options. It also covers pension benefits for long-term employees. The plan is designed to provide financial security during retirement and encourages employees to save for the future. It outlines various investment options, eligibility criteria, and required documentation. This is a complex and detailed plan with many provisions and stipulations. It is important to read the entire document carefully to understand your rights and obligations under the plan. The policy also covers topics like hardship withdrawals, loan provisions, and beneficiary designations. Regular updates are made to the plan to comply with changing regulations. Employees are encouraged to attend informational seminars and consult with financial advisors to make informed decisions about their retirement savings. Furthermore, the plan includes details about the process for filing claims and resolving disputes. Specific details on eligibility can be found in section 3.2, and investment options are described in Appendix A.\",\n    \"effective_date\": \"2023-11-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
