{"_id": "human_resources--hr_policies:_doc--p--69638", "text": "{\n    \"policy_id\": \"POL-2023-005\",\n    \"policy_title\": \"Employee Travel and Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to request and receive reimbursement for business-related travel expenses. It covers pre-approval requirements, allowable expenses, and documentation guidelines. It is important to adhere to these guidelines to ensure compliance and efficient expense management. Travel to client sites and conferences are covered.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/travel-expense-2023.pdf\"\n}"}
