{"_id": "human_resources--hr_policies:_doc--n--64697", "text": "{\n    \"policy_id\": \"EMP-BEN-008\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A comprehensive plan outlining deferred compensation for executive-level employees.  Includes complex vesting schedules, investment options, and tax implications.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/deferred-compensation-plan.pdf\"\n}"}
