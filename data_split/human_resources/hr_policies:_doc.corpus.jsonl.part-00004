{"_id": "human_resources--hr_policies:_doc--p--68484", "text": "{\n    \"policy_id\": \"WB-2024-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"Provides confidential counseling and support services to employees experiencing personal or work-related difficulties. Covers a range of issues, including stress, anxiety, and family concerns.  The policy is designed to be accessible and easy to navigate.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-05-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
