{"_id": "human_resources--hr_policies:_doc--p--62290", "text": "{\n    \"policy_id\": \"EB-2023-007\",\n    \"policy_title\": \"Employee Benefits Package\",\n    \"policy_description\": \"This policy outlines the comprehensive benefits package available to all eligible employees, including health insurance, retirement plans, and wellness programs. It emphasizes equitable access to benefits and fosters a supportive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits_package_2023.pdf\"\n}"}
