{"_id": "human_resources--hr_policies:_doc--p--71694", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Financial Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employees' financial health through workshops, resources, and benefits like financial planning assistance and student loan repayment programs. It applies to all full-time employees.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/financial-wellness-program\"\n}"}
