{"_id": "human_resources--hr_policies:_doc--p--70903", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Employee Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive wellness benefits available to all employees, including mental health support, gym membership reimbursement, and preventative care programs. We believe a healthy and supported workforce is a productive workforce. The program aims to provide resources to promote both physical and mental wellbeing, recognizing the importance of work-life balance and overall employee satisfaction. Details regarding eligibility, coverage levels, and claim procedures are included in the full policy document. This is a key component of our commitment to employee care and includes annual health screenings and workshops.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70903", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Employee Discount Program\",\n    \"policy_description\": \"This policy details the employee discount program offered through partnerships with local businesses. Employees are eligible for discounts on a variety of goods and services. The discounts are subject to change and are not guaranteed. More details are available in the attached document.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/discount-program\"\n}"}
