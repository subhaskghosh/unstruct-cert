{"_id": "human_resources--hr_policies:_doc--p--67832", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"Details the comprehensive health and wellness benefits package available to all employees, including medical, dental, and vision coverage. Also covers mental health resources and employee assistance programs.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/emp-ben-001\"\n}"}
