{"_id": "human_resources--hr_policies:_doc--p--61490", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Flexible Work Arrangements Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance and improve productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-08-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements\"\n}"}
