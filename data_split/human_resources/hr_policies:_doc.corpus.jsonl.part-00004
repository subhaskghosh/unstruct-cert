{"_id": "human_resources--hr_policies:_doc--n--68719", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Outlines the company's stock option and restricted stock unit (RSU) grant program for eligible employees. Details vesting schedules, exercise procedures, and tax implications. This policy covers stock options.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/equity_compensation.pdf\"\n}"}
