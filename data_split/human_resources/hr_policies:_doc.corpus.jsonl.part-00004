{"_id": "human_resources--hr_policies:_doc--p--65018", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees. It provides confidential counseling and support services for personal and work-related issues. The EAP aims to promote employee well-being and a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65018", "text": "{\n    \"policy_id\": \"IT-SEC-005\",\n    \"policy_title\": \"Data Encryption Protocol\",\n    \"policy_description\": \"This policy details the required data encryption protocols for all company data, both in transit and at rest. It outlines the approved encryption algorithms, key management procedures, and compliance requirements. This is a technical document for IT staff.\",\n    \"effective_date\": \"2022-08-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Security\",\n        \"Development\"\n    ],\n    \"policy_document_url\": \"https://example.com/encryption-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65019", "text": "{\n    \"policy_id\": \"WB-003\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential counseling and support services for personal and work-related issues.  It aims to support employee mental health and well-being.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65019", "text": "{\n    \"policy_id\": \"LO-007\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed procedures regarding all types of leave of absence including medical, personal, and family care leave.  Covers eligibility, application process, and required documentation. Includes complex sections on FMLA and state-specific leave laws.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"HR\",\n        \"Finance\",\n        \"Operations\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave_policy\"\n}"}
