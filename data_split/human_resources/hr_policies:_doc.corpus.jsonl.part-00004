{"_id": "human_resources--hr_policies:_doc--n--65071", "text": "{\n    \"policy_id\": \"PR-002\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"Details the annual performance review cycle, including goal setting, self-assessment, manager feedback, and development planning. This policy ensures regular performance conversations and opportunities for growth.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance_review_policy.pdf\"\n}"}
