{"_id": "human_resources--hr_policies:_doc--n--65684", "text": "{\n    \"policy_id\": \"LOA-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed procedures for requesting and managing various types of leave of absence, including medical leave, parental leave, and personal leave. This is a comprehensive document covering multiple scenarios.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product\",\n        \"HR\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65685", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including mental health resources, physical fitness initiatives, and stress management workshops. It aims to promote a healthy and balanced lifestyle for all employees.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
