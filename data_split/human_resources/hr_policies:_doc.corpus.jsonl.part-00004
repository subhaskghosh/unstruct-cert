{"_id": "human_resources--hr_policies:_doc--n--67596", "text": "{\n    \"policy_id\": \"EMP-BEN-002\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"A complex plan detailing deferred compensation for executive-level employees, including vesting schedules, tax implications, and forfeiture clauses. Requires specialized financial knowledge to comprehend.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/deferred_compensation.pdf\"\n}"}
