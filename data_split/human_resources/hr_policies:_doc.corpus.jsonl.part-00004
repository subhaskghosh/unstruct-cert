{"_id": "human_resources--hr_policies:_doc--p--64674", "text": "{\n    \"policy_id\": \"EMP-BNF-007\",\n    \"policy_title\": \"Employee 401k Retirement Plan\",\n    \"policy_description\": \"This policy outlines the details of the company's 401k retirement savings plan, including eligibility, contribution limits, and vesting schedule. It is designed to promote employee financial security and long-term savings.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64674", "text": "{\n    \"policy_id\": \"EMP-TRV-002\",\n    \"policy_title\": \"Employee Travel Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to submit and receive reimbursement for business-related travel expenses, including mileage, lodging, and meals.\",\n    \"effective_date\": \"2022-05-20\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64675", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being and provides guidelines for flexible work arrangements, including remote work, compressed workweeks, and flexible hours, aimed at promoting work-life balance.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-flexibility.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64675", "text": "{\n    \"policy_id\": \"TRA-001\",\n    \"policy_title\": \"Professional Development and Training Reimbursement\",\n    \"policy_description\": \"This policy details the process for employees to request reimbursement for approved professional development courses and training programs. The goal is to enhance employee skills and career growth.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/training-reimbursement.pdf\"\n}"}
