{"_id": "human_resources--hr_policies:_doc--p--71737", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for physical and mental health. It includes details on gym reimbursements and access to counseling services.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness_program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71737", "text": "{\n    \"policy_id\": \"BEN-0005\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy provides a detailed overview of the company's health insurance plan, including coverage options, premium costs, and eligibility requirements. It addresses various aspects of healthcare, including preventative care, specialist visits, and hospital stays. This document also details the appeal process for denied claims and outlines the responsibilities of both the employee and the insurance provider. Specific information regarding dependent coverage, pre-existing conditions, and out-of-network services are also covered. Furthermore, it includes a section on utilizing telehealth options and understanding the plan's deductible and co-pay structure. This plan is governed by federal and state regulations, and compliance information is provided. Updates regarding changes in plan provisions are announced annually during open enrollment.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2023-12-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71738", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Comprehensive Employee Wellness Benefits\",\n    \"policy_description\": \"This policy details the company's comprehensive employee wellness benefits, including mental health support, gym memberships, and health insurance options. It aims to promote a healthy and productive work environment.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/wellness-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71738", "text": "{\n    \"policy_id\": \"DISC-0011\",\n    \"policy_title\": \"Employee Disciplinary Action Procedures\",\n    \"policy_description\": \"This policy outlines the procedures for addressing employee misconduct and disciplinary actions. It covers warnings, suspensions, and terminations.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Operations\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/disciplinary/action-procedures.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71739", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health, and promoting a healthy work-life balance. It includes details on employee assistance programs, wellness workshops, and flexible work arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71739", "text": "{\n    \"policy_id\": \"WFH-2024-001\",\n    \"policy_title\": \"Work From Home Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees working remotely. It covers eligibility, equipment requirements, security protocols, and performance expectations.\",\n    \"effective_date\": \"2024-01-10\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"IT\",\n        \"Product\"\n    ],\n    \"policy_document_url\": \"https://example.com/wfh-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71740", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health, dental, and vision benefits available to all eligible employees. It also includes details on wellness programs and resources.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-wellness.pdf\"\n}"}
