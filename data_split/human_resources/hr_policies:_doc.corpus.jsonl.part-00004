{"_id": "human_resources--hr_policies:_doc--n--62527", "text": "{\n    \"policy_id\": \"LEGL-005\",\n    \"policy_title\": \"Equity Compensation Plan\",\n    \"policy_description\": \"Outlines the terms and conditions of the company's equity compensation plan, including stock options, restricted stock units (RSUs), and employee stock purchase plan (ESPP).\",\n    \"effective_date\": \"2022-03-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/equity-plan.pdf\"\n}"}
