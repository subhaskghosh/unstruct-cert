{"_id": "human_resources--hr_policies:_doc--n--67294", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Employee Compensation and Equity\",\n    \"policy_description\": \"A comprehensive guide detailing the compensation structure, including base salary, bonuses, stock options, and long-term incentive plans. This policy covers eligibility criteria, performance review processes, and vesting schedules for equity awards. It is designed to ensure fair and competitive compensation practices across all departments, aligning employee interests with company goals. Further detailed sections address specific scenarios such as merit increases, promotions, and adjustments for cost of living. Includes FAQs and legal disclaimers.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
