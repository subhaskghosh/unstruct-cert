{"_id": "human_resources--hr_policies:_doc--n--70316", "text": "{\n    \"policy_id\": \"LEG-005\",\n    \"policy_title\": \"Equity Compensation Plan - Restricted Stock Units\",\n    \"policy_description\": \"This policy details the terms and conditions governing the grant and vesting of Restricted Stock Units (RSUs) to eligible employees, including compliance requirements under Section 409A of the Internal Revenue Code and related tax implications.  Specific forfeiture provisions apply based on termination type and performance metrics. All grants are subject to Board approval.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Legal\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/rsu_plan\"\n}"}
