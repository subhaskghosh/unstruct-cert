{"_id": "human_resources--hr_policies:_doc--p--71208", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Your Guide to Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health benefits available to all eligible employees, including medical, dental, and vision coverage. It details enrollment procedures, coverage levels, and resources for assistance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/employee-health-benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71208", "text": "{\n    \"policy_id\": \"CMP-PRC-005\",\n    \"policy_title\": \"Compensation and Performance Review Procedures - Version 3.2\",\n    \"policy_description\": \"Detailed guidelines for conducting performance reviews, determining merit increases, and administering bonus programs. Includes complex calculations and legal disclaimers.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Finance\",\n        \"Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-review-procedures.docx\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71209", "text": "{\n    \"policy_id\": \"EB-2023-005\",\n    \"policy_title\": \"Employee Health & Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance and wellness programs available to all eligible employees. It includes details on medical, dental, and vision coverage, as well as resources for mental health support and preventative care. Retirement plans options are briefly mentioned.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_wellness_2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71209", "text": "{\n    \"policy_id\": \"EB-2022-012\",\n    \"policy_title\": \"Complex Benefits Litigation & Compliance\",\n    \"policy_description\": \"This policy details the complex legal and regulatory requirements related to employee benefits, including ERISA, COBRA, and HIPAA. It outlines procedures for handling benefit-related litigation and ensuring compliance with all applicable laws. It references health insurance provisions.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal/benefits_compliance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71210", "text": "{\n    \"policy_id\": \"BEN-0042\",\n    \"policy_title\": \"Health Insurance Benefits - Comprehensive Plan\",\n    \"policy_description\": \"This policy outlines the comprehensive health insurance benefits offered to all eligible employees. It covers medical, dental, and vision care, with details on co-pays, deductibles, and coverage limits. This plan is designed to promote employee health and well-being, offering a variety of options to meet individual needs.  Employees are encouraged to review the plan details and select the coverage that best suits their personal circumstances. Preventative care is strongly encouraged.\",\n    \"effective_date\": \"2023-07-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance-ben0042.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71210", "text": "{\n    \"policy_id\": \"REM-0015\",\n    \"policy_title\": \"Remote Work Arrangement Policy\",\n    \"policy_description\": \"This policy details the guidelines and procedures for employees requesting remote work arrangements. It outlines eligibility criteria, required equipment, security protocols, and performance expectations for remote workers. This is meant to ensure productivity and effective collaboration while working remotely.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/remote-work-rem0015.pdf\"\n}"}
