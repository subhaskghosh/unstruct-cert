{"_id": "human_resources--hr_policies:_doc--n--64239", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Health Insurance Enrollment\",\n    \"policy_description\": \"This policy details the procedures for enrolling in company-sponsored health insurance plans. It includes information on plan options, coverage details, and enrollment deadlines.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64240", "text": "{\n    \"policy_id\": \"EMP-BNF-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee health and well-being through various programs and resources, including gym memberships, mental health support, and preventative care.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64240", "text": "{\n    \"policy_id\": \"EMP-TRA-001\",\n    \"policy_title\": \"Leadership Development Training\",\n    \"policy_description\": \"This policy details the company's investment in developing leadership skills among its employees through training programs and mentorship opportunities.\",\n    \"effective_date\": \"2022-06-20\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leadership-training.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64241", "text": "{\n    \"policy_id\": \"WB-2024-007\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines guidelines for flexible work arrangements, including remote work, flextime, and compressed workweeks, to support employee work-life balance.\",\n    \"effective_date\": \"2024-03-15\",\n    \"last_updated\": \"2024-08-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64241", "text": "{\n    \"policy_id\": \"PD-2023-012\",\n    \"policy_title\": \"Performance Development Process\",\n    \"policy_description\": \"This policy details the process for performance reviews, goal setting, and employee development plans.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/performance-development.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64242", "text": "{\n    \"policy_id\": \"BP-0012\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy provides confidential counseling and support services to employees facing personal or work-related challenges. It covers a wide range of issues including stress, anxiety, grief, and financial difficulties.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64242", "text": "{\n    \"policy_id\": \"BP-0005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for reimbursing employees for travel expenses incurred while conducting company business.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-06-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64243", "text": "{\n    \"policy_id\": \"WB-ENG-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including resources for mental health, physical health, and financial well-being. It details available programs and support systems.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Product Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64243", "text": "{\n    \"policy_id\": \"RW-ENG-002\",\n    \"policy_title\": \"Remote Work and Home Office Setup\",\n    \"policy_description\": \"This policy details guidelines for remote work arrangements, including eligibility, equipment allowances, and security protocols. It also covers home office setup standards.\",\n    \"effective_date\": \"2023-03-20\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64244", "text": "{\n    \"policy_id\": \"BP-2023-007\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the full suite of benefits available to employees, including health insurance, retirement plans, paid time off, and wellness programs. It aims to provide a competitive and supportive benefits environment.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-2023.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64244", "text": "{\n    \"policy_id\": \"BP-2022-001\",\n    \"policy_title\": \"Limited Vacation Policy\",\n    \"policy_description\": \"This policy outlines the vacation accrual rates and approval process for employees. It's a basic policy focused solely on time off.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/vacation-policy.pdf\"\n}"}
