{"_id": "human_resources--hr_policies:_doc--p--70190", "text": "{\n    \"policy_id\": \"BEN-004\",\n    \"policy_title\": \"Employee Life Event Support Policy\",\n    \"policy_description\": \"This policy outlines support provided to employees experiencing significant life events such as marriage, birth of a child, or bereavement. It details available leave options, counseling services, and financial assistance programs.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/life-event-support.pdf\"\n}"}
