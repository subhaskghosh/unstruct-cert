{"_id": "human_resources--hr_policies:_doc--p--64403", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the comprehensive health, dental, vision, and wellness benefits available to all eligible employees. It details eligibility requirements, coverage levels, and procedures for utilizing benefits. It also includes information on employee assistance programs and preventative care initiatives. The company offers a variety of plans to meet individual employee needs.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64403", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy details the procedures for reimbursing employees for reasonable and necessary travel expenses incurred while conducting company business. It covers expenses such as transportation, lodging, and meals.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64404", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It provides details on coverage, premiums, and claims procedures. We strive to make healthcare accessible and understandable for our team.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64404", "text": "{\n    \"policy_id\": \"EMP-COMP-005\",\n    \"policy_title\": \"Equity Incentive Plan\",\n    \"policy_description\": \"This document details the terms and conditions governing the Company's Equity Incentive Plan, including stock option grants, vesting schedules, and tax implications, in full compliance with Section 409A of the Internal Revenue Code and all applicable securities laws. This is a highly technical document and requires legal counsel for interpretation.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/equity-incentive-plan\"\n}"}
