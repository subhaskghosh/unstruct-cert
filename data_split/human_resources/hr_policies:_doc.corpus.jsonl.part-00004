{"_id": "human_resources--hr_policies:_doc--n--61772", "text": "{\n    \"policy_id\": \"TRAV-2022-002\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This detailed policy outlines procedures for employees to submit travel expense reports, including permissible expenses, documentation requirements, and reimbursement timelines. It covers all aspects of business-related travel, from airfare and lodging to meals and incidental costs.  Adherence to this policy ensures compliance with company financial regulations and accurate expense tracking.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy\"\n}"}
