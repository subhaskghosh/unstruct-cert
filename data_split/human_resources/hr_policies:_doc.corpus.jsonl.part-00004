{"_id": "human_resources--hr_policies:_doc--p--65665", "text": "{\n    \"policy_id\": \"EB-2024-003\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the full range of employee benefits, including health insurance, retirement plans, paid time off, and wellness programs. It emphasizes long-term financial security and employee well-being.\",\n    \"effective_date\": \"2024-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/comprehensive-package\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65665", "text": "{\n    \"policy_id\": \"SI-2024-001\",\n    \"policy_title\": \"Sales Performance Bonus Plan\",\n    \"policy_description\": \"This policy outlines the criteria and payment structure for sales performance bonuses. It is a short-term incentive program designed to motivate sales representatives.\",\n    \"effective_date\": \"2024-03-01\",\n    \"last_updated\": \"2024-04-20\",\n    \"applicable_departments\": [\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/sales/bonus-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65666", "text": "{\n    \"policy_id\": \"BEN-0012\",\n    \"policy_title\": \"Comprehensive Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive benefits package available to all eligible employees, including health insurance, dental, vision, life insurance, and retirement plans. It outlines eligibility requirements, enrollment procedures, and coverage details.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits-package-v3.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65666", "text": "{\n    \"policy_id\": \"TRA-0005\",\n    \"policy_title\": \"Travel Expense Reimbursement\",\n    \"policy_description\": \"This policy outlines the procedures for employees to request reimbursement for travel expenses incurred while on company business.  It includes guidelines on allowable expenses, documentation requirements, and submission deadlines.\",\n    \"effective_date\": \"2023-03-10\",\n    \"last_updated\": \"2024-06-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel-policy-v2.pdf\"\n}"}
