{"_id": "human_resources--hr_policies:_doc--p--68636", "text": "{\n    \"policy_id\": \"WB-2023-01\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program, providing confidential counseling and support services to employees facing personal or work-related challenges. The EAP offers resources for stress management, mental health, and financial well-being.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
