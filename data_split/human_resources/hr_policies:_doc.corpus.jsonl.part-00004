{"_id": "human_resources--hr_policies:_doc--n--67661", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Retirement Plan\",\n    \"policy_description\": \"A comprehensive retirement plan for senior executives, including stock options and pension details. Requires thorough legal review.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement_plan.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67662", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"Provides confidential support and resources to employees facing personal or work-related challenges.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-07-20\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/wb-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67662", "text": "{\n    \"policy_id\": \"LE-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"Detailed guidelines regarding various types of leaves, including medical, parental, and personal leave, outlining eligibility requirements, application procedures, and related benefits. This policy covers all types of leave requests and ensures compliance with federal and state regulations.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-01-05\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Finance\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--67663", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels, premiums, and claim procedures are provided.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67663", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Executive Deferred Compensation Plan\",\n    \"policy_description\": \"This policy details the deferred compensation plan available to senior executives. It includes complex eligibility requirements, vesting schedules, and payout options. Legal counsel should be consulted for detailed understanding of this plan.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/deferred_comp.pdf\"\n}"}
