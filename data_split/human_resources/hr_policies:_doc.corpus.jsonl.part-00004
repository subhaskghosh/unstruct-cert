{"_id": "human_resources--hr_policies:_doc--p--65597", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, including resources for mental health, physical fitness, and financial wellness. It encourages a healthy work-life balance and provides access to support services.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65597", "text": "{\n    \"policy_id\": \"LV-2022-010\",\n    \"policy_title\": \"Employee Leave of Absence\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave of absence, including sick leave, family leave, and personal leave. It covers eligibility requirements, documentation needed, and pay continuation policies. Detailed legal clauses are included.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65598", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, providing resources for physical and mental health, and promoting a healthy work-life balance. Includes details on gym reimbursement, mindfulness programs, and flexible work arrangements.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee-wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65598", "text": "{\n    \"policy_id\": \"EMP-TRAIN-005\",\n    \"policy_title\": \"Leadership Development Training\",\n    \"policy_description\": \"This policy details the procedures for nominating and participating in leadership development programs offered by the company. It aims to foster future leaders within the organization.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/leadership-training\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65599", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental and physical health. It covers access to counseling, gym memberships, and wellness workshops.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Client Services\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65599", "text": "{\n    \"policy_id\": \"LEGAL-2023-005\",\n    \"policy_title\": \"Comprehensive Legal Compliance Handbook\",\n    \"policy_description\": \"A detailed legal guide covering all aspects of employment law, including discrimination, harassment, and data privacy.  This is an extensive document incorporating federal and state regulations and covering numerous scenarios.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Legal\",\n        \"Human Resources\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal-handbook.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65600", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Assistance Program\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program (EAP) available to all employees, providing confidential support for personal and work-related issues. It aims to promote employee wellbeing and a healthy work-life balance.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Customer Service\",\n        \"Sales\",\n        \"Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap_policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65600", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Compensation and Benefits - Executive Level\",\n    \"policy_description\": \"Detailed compensation structure for executive-level employees, including base salary, bonus potential, equity grants, and benefits eligibility.  This is a comprehensive policy covering numerous scenarios and requiring legal review.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive_compensation.pdf\"\n}"}
