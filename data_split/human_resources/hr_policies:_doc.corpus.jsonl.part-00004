{"_id": "human_resources--hr_policies:_doc--n--67564", "text": "{\n    \"policy_id\": \"COMP-005\",\n    \"policy_title\": \"Executive Compensation and Equity Grants\",\n    \"policy_description\": \"Comprehensive policy governing compensation packages for executive-level employees, including base salary, performance bonuses, stock options, and restricted stock units. Covers vesting schedules, clawback provisions, and compliance requirements.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive_compensation.pdf\"\n}"}
