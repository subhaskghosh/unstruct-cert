{"_id": "human_resources--hr_policies:_doc--p--64767", "text": "{\n    \"policy_id\": \"PTO-2023-007\",\n    \"policy_title\": \"Paid Time Off and Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the guidelines for employees requesting paid time off, including vacation, sick leave, and personal days. It also details options for flexible work arrangements, such as remote work and adjusted schedules, to promote a healthy work-life balance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/pto-flexible-work-2023-007\"\n}"}
