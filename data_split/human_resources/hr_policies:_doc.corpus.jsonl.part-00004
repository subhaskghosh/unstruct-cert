{"_id": "human_resources--hr_policies:_doc--n--65526", "text": "{\n    \"policy_id\": \"LE-005\",\n    \"policy_title\": \"Legal Compliance and Employee Rights\",\n    \"policy_description\": \"A comprehensive overview of all legal requirements relating to employee rights, including detailed sections on discrimination, harassment, wage and hour laws, and leave policies.  It includes numerous examples, case studies, and legal citations, covering a broad range of topics and compliance procedures, totaling over 50 pages.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/legal_compliance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--65527", "text": "{\n    \"policy_id\": \"WB-2024-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to mental health resources, fitness benefits, and healthy lifestyle initiatives. It aims to foster a positive and supportive work environment.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--65527", "text": "{\n    \"policy_id\": \"LC-2023-005\",\n    \"policy_title\": \"Data Privacy and Security Policy\",\n    \"policy_description\": \"This policy details the company's procedures for protecting employee data in compliance with relevant data privacy regulations, including GDPR and CCPA. It covers data collection, storage, access, and disposal.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy\"\n}"}
