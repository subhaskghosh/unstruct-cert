{"_id": "human_resources--hr_policies:_doc--p--71577", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It details coverage options, enrollment procedures, and cost-sharing arrangements.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-28\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71577", "text": "{\n    \"policy_id\": \"EXEC-COMP-002\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"Details regarding the stock option plan available to senior executives. This policy outlines eligibility criteria, vesting schedules, and exercise procedures.\",\n    \"effective_date\": \"2023-05-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Executive Management\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-option-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71578", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Comprehensive Employee Benefits Package\",\n    \"policy_description\": \"This policy details the comprehensive employee benefits package offered by the company, including health insurance, dental and vision coverage, retirement plans (401k), paid time off (PTO), parental leave, and employee assistance programs.  It outlines eligibility requirements, enrollment procedures, and plan details for each benefit. This is a core part of our commitment to employee well-being and attracting top talent. The policy is reviewed annually to ensure competitiveness and compliance with all applicable laws and regulations. Employees are encouraged to review the full documentation available at the provided URL.  Details on specific providers and coverage levels are also included. This policy aims to provide a secure and supportive financial and health safety net for all employees. It addresses frequently asked questions and provides contact information for benefit administrators.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/employee-benefits-package.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71578", "text": "{\n    \"policy_id\": \"RW-2024-002\",\n    \"policy_title\": \"Remote Work Arrangement Guidelines\",\n    \"policy_description\": \"This policy outlines the guidelines and procedures for employees requesting and participating in remote work arrangements. It covers eligibility criteria, equipment requirements, security protocols, and performance expectations for remote employees. The goal is to ensure a productive and secure remote work environment while maintaining team collaboration and communication.\",\n    \"effective_date\": \"2024-02-01\",\n    \"last_updated\": \"2024-03-10\",\n    \"applicable_departments\": [\n        \"Technology\",\n        \"Customer Support\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71579", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care, including details on coverage levels, premiums, and claim procedures. The policy includes information on preventative care, specialist visits, and emergency services.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
