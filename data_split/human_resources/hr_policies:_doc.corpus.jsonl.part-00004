{"_id": "human_resources--hr_policies:_doc--p--61891", "text": "{\n    \"policy_id\": \"BNF-2023-10\",\n    \"policy_title\": \"Employee Health Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance options available to all eligible employees. It covers medical, dental, and vision care. Details regarding coverage levels and enrollment procedures are available in the policy document.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-benefits-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--61891", "text": "{\n    \"policy_id\": \"LVT-2022-05\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This comprehensive policy details various types of leave available to employees, including sick leave, vacation leave, parental leave, and bereavement leave. It outlines eligibility requirements, application procedures, and associated benefits. The policy also addresses compliance with relevant federal and state laws regarding leave entitlements. Employees are encouraged to familiarize themselves with the complete policy document to ensure they understand their rights and responsibilities. This policy is subject to change based on legal updates and company needs. Amendments will be communicated to all employees in a timely manner.  Detailed information about specific leave types and associated documentation requirements can be found in the appendix.  Any questions should be directed to the HR department.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2023-02-20\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-of-absence-policy\"\n}"}
