{"_id": "human_resources--hr_policies:_doc--n--70999", "text": "{\n    \"policy_id\": \"BEN-0015\",\n    \"policy_title\": \"Retirement Savings Plan\",\n    \"policy_description\": \"Comprehensive details of the company's 401k plan, including contribution matching, vesting schedule, and investment options. A complete document of approximately 800 words.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71000", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources and support for physical and mental health.  It includes access to gym discounts, mental health counseling, and wellness workshops. The goal is to promote a healthy and balanced lifestyle for all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Engineering\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71000", "text": "{\n    \"policy_id\": \"BEN-005\",\n    \"policy_title\": \"Executive Stock Option Plan\",\n    \"policy_description\": \"This comprehensive plan details the terms and conditions for granting stock options to executive-level employees. It includes vesting schedules, exercise prices, and tax implications.  The plan aims to align executive interests with shareholder value and incentivize long-term performance. This is a complex document requiring legal counsel for full understanding.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-10\",\n    \"applicable_departments\": [\n        \"Executive\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/stock-options.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71001", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Enhanced Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellbeing, including access to mental health resources, gym membership discounts, and healthy lifestyle workshops. It's designed to support a healthy work-life balance and reduce stress.\",\n    \"effective_date\": \"2023-09-15\",\n    \"last_updated\": \"2024-01-26\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program-details\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71001", "text": "{\n    \"policy_id\": \"PERF-EVAL-001\",\n    \"policy_title\": \"Performance Evaluation Process\",\n    \"policy_description\": \"Details the annual performance review process, including goal setting, self-assessment, and manager feedback sessions.  Outlines the rating scale and potential consequences.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-guide\"\n}"}
