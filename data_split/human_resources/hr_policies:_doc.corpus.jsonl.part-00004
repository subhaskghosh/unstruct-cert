{"_id": "human_resources--hr_policies:_doc--p--67038", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being. It covers access to gym memberships, mental health resources, and annual health screenings. The program aims to promote a healthy work-life balance and reduce healthcare costs. Details regarding eligibility and participation are outlined in the full policy document.\",\n    \"effective_date\": \"2023-01-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67038", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Comprehensive Retirement and Investment Plan\",\n    \"policy_description\": \"This detailed policy outlines all aspects of the company's retirement and investment plan, including 401(k) contributions, vesting schedules, investment options, loan provisions, and distribution rules.  It includes specific sections on required minimum distributions (RMDs), beneficiary designations, and qualified domestic relations orders (QDROs). A comprehensive guide with detailed explanations and FAQs is provided. Includes compliance details related to ERISA and IRS regulations, with extensive legal disclaimers.  Furthermore, the policy covers several advanced investment strategies and associated risks. Updates will occur frequently to reflect changing regulations.\",\n    \"effective_date\": \"2022-07-01\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan.pdf\"\n}"}
