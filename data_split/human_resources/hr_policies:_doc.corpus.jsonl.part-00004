{"_id": "human_resources--hr_policies:_doc--p--62737", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering access to gym memberships, mental health resources, and annual health screenings. It aims to improve employee health and productivity.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62737", "text": "{\n    \"policy_id\": \"EMP-COMP-002\",\n    \"policy_title\": \"Employee Compensation and Equity Awards\",\n    \"policy_description\": \"This document details the legal framework governing employee compensation, including stock options, restricted stock units, and bonus structures. It adheres to all relevant regulatory guidelines and outlines the procedures for administering equity awards in compliance with applicable securities laws.  It further clarifies eligibility criteria and vesting schedules.\",\n    \"effective_date\": \"2023-05-10\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Finance\",\n        \"Legal\",\n        \"Executive\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--62738", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, providing resources and support for physical and mental health. Includes details on gym memberships, stress management workshops, and employee assistance programs.  Maximum 300 words.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-04-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--62738", "text": "{\n    \"policy_id\": \"EMP-BEN-003\",\n    \"policy_title\": \"Long-Term Disability Insurance\",\n    \"policy_description\": \"This policy details the terms and conditions of long-term disability insurance coverage for eligible employees.  It covers eligibility requirements, benefit levels, claim procedures, and other relevant information. This is a detailed legal document. 800 words.\",\n    \"effective_date\": \"2022-01-10\",\n    \"last_updated\": \"2024-05-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/disability-insurance.pdf\"\n}"}
