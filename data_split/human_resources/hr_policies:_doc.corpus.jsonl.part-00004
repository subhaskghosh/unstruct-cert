{"_id": "human_resources--hr_policies:_doc--n--71570", "text": "{\n    \"policy_id\": \"EB-2023-012\",\n    \"policy_title\": \"Comprehensive Health Insurance Plan\",\n    \"policy_description\": \"This policy details the comprehensive health insurance plan offered to all eligible employees, covering medical, dental, and vision care. It includes detailed information on coverage levels, provider networks, and claim procedures. Specific details are outlined in the attached 100+ page document. This plan complies with all applicable federal and state regulations and is reviewed annually to ensure compliance and competitiveness. Additional details are available in the employee handbook. The plan covers preventative care, emergency services, hospitalization, prescription drugs, and mental health services.  Employees are encouraged to review the plan documents carefully to understand their coverage options. The plan includes a deductible, co-pay, and co-insurance structure. The policy also addresses pre-existing conditions and appeals processes.\",\n    \"effective_date\": \"2023-03-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--71571", "text": "{\n    \"policy_id\": \"EMP-BEN-005\",\n    \"policy_title\": \"Flexible Work Arrangements\",\n    \"policy_description\": \"This policy outlines the options available to employees for flexible work arrangements, including remote work, flextime, and compressed workweeks.  It aims to support a healthy work-life balance and improve employee satisfaction.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/flexible-work-arrangements\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--71571", "text": "{\n    \"policy_id\": \"EMP-DISC-001\",\n    \"policy_title\": \"Employee Disciplinary Action\",\n    \"policy_description\": \"This policy details the procedures for addressing employee misconduct and performance issues. It outlines the steps involved in disciplinary action, including verbal warnings, written warnings, and termination.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/disciplinary-action\"\n}"}
