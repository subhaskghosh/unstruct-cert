{"_id": "human_resources--hr_policies:_doc--p--68988", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Wellness Benefit Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee wellness, including gym membership reimbursements, mental health resources, and annual health screenings.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68988", "text": "{\n    \"policy_id\": \"LO-2018-012\",\n    \"policy_title\": \"Leave of Absence Procedures\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave, including sick leave, vacation time, and parental leave.\",\n    \"effective_date\": \"2018-06-01\",\n    \"last_updated\": \"2022-12-10\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68989", "text": "{\n    \"policy_id\": \"EMP-BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision plans, eligibility requirements, and enrollment procedures.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Service\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health-insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68989", "text": "{\n    \"policy_id\": \"EXEC-COMP-005\",\n    \"policy_title\": \"Executive Equity Compensation Plan\",\n    \"policy_description\": \"Details the stock option and restricted stock unit grants for senior executives and outlines vesting schedules and performance criteria.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/executive-equity.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68990", "text": "{\n    \"policy_id\": \"WB-2023-001\",\n    \"policy_title\": \"Employee Wellness Program\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical fitness, and financial wellness. It promotes a supportive work environment and encourages employees to prioritize their health.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Customer Support\",\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-program\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68990", "text": "{\n    \"policy_id\": \"LP-2022-005\",\n    \"policy_title\": \"Data Privacy and Security Policy\",\n    \"policy_description\": \"This policy details the procedures for handling and protecting employee and customer data, ensuring compliance with all relevant data privacy regulations.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-05-10\",\n    \"applicable_departments\": [\n        \"IT\",\n        \"Human Resources\",\n        \"Legal\"\n    ],\n    \"policy_document_url\": \"https://example.com/data-privacy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68991", "text": "{\n    \"policy_id\": \"EB-2023-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Employees can enroll during open enrollment or upon qualifying life events. Details regarding coverage levels and costs are available in the policy document.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68991", "text": "{\n    \"policy_id\": \"EB-2022-005\",\n    \"policy_title\": \"Executive Retirement Plan\",\n    \"policy_description\": \"This policy details the retirement plan for executive-level employees. It includes information about vesting schedules, contribution limits, and investment options. Eligibility criteria and participation guidelines are outlined within. This is a comprehensive plan with many detailed subsections covering various scenarios and exceptions, including complex tax implications and benefit calculation methodologies. It aims to provide a robust and tailored retirement solution for our key leadership team. Specific rules are further defined in the addendums attached to this document. Furthermore, it complies with all relevant federal and state regulations pertaining to executive compensation and retirement planning.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-12-20\",\n    \"applicable_departments\": [\n        \"Executive Management\"\n    ],\n    \"policy_document_url\": \"https://example.com/executive-retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68992", "text": "{\n    \"policy_id\": \"BNF-003\",\n    \"policy_title\": \"Employee Health and Wellness Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance, wellness programs, and other benefits available to all eligible employees to promote their physical and mental well-being. It details coverage options, enrollment procedures, and resources for accessing benefits.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Support\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68992", "text": "{\n    \"policy_id\": \"EXC-001\",\n    \"policy_title\": \"Executive Equity Compensation Plan\",\n    \"policy_description\": \"This policy details the stock option and equity grant programs for senior executives, including vesting schedules, performance metrics, and compliance requirements. It is intended for a limited group of highly compensated individuals.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-20\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation/executive-equity\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68993", "text": "{\n    \"policy_id\": \"EMP-BEN-401K-2023\",\n    \"policy_title\": \"401k Contribution and Matching Policy\",\n    \"policy_description\": \"This policy outlines the company's 401k plan, including employee contribution limits, company matching contributions, and vesting schedule. It is designed to help employees save for retirement.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/401k-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68993", "text": "{\n    \"policy_id\": \"EMP-BEN-HLTH-2022\",\n    \"policy_title\": \"Comprehensive Health Insurance Policy\",\n    \"policy_description\": \"This document details the full scope of health insurance benefits offered to employees, including medical, dental, and vision coverage. It covers eligibility requirements, plan options, copays, deductibles, and claims procedures. A detailed overview of network providers, pre-authorization requirements and appeal processes is also included.  This policy is essential for understanding your healthcare options with the company and aims to provide a comprehensive package to employees and their families. It also details the cost sharing responsibilities for different plans.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-11-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68994", "text": "{\n    \"policy_id\": \"WB-2024-005\",\n    \"policy_title\": \"Employee Wellness and Work-Life Integration\",\n    \"policy_description\": \"This policy outlines the company's commitment to employee well-being, offering resources for mental health, physical health, and work-life balance. It includes provisions for flexible work arrangements, employee assistance programs, and wellness workshops.\",\n    \"effective_date\": \"2024-01-15\",\n    \"last_updated\": \"2024-05-10\",\n    \"applicable_departments\": [\n        \"Marketing\",\n        \"Sales\",\n        \"Human Resources\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy-2024-005\"\n}"}
