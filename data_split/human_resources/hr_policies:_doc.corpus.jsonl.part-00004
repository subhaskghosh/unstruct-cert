{"_id": "human_resources--hr_policies:_doc--n--64254", "text": "{\n    \"policy_id\": \"CMP-2022-002\",\n    \"policy_title\": \"Complex Compensation Plan\",\n    \"policy_description\": \"A detailed outline of the company's executive compensation structure, including stock options, bonuses, and performance-based incentives.  This document is extremely detailed and lengthy, covering many scenarios and legal considerations.\",\n    \"effective_date\": \"2022-06-15\",\n    \"last_updated\": \"2023-11-15\",\n    \"applicable_departments\": [\n        \"Executive Leadership\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/complex-compensation\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64255", "text": "{\n    \"policy_id\": \"WB-001\",\n    \"policy_title\": \"Employee Wellbeing and Work-Life Balance\",\n    \"policy_description\": \"This policy outlines the company's commitment to supporting employee wellbeing, including flexible working arrangements, mental health resources, and wellness programs. It aims to foster a positive work-life balance for all employees.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/wb-001.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64255", "text": "{\n    \"policy_id\": \"LV-002\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This policy details the procedures for requesting and taking various types of leave of absence, including sick leave, parental leave, and personal leave. It outlines eligibility criteria and required documentation.\",\n    \"effective_date\": \"2022-11-01\",\n    \"last_updated\": \"2023-08-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/lv-002.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64256", "text": "{\n    \"policy_id\": \"BEN-003\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the company's health insurance benefits for eligible employees. It covers medical, dental, and vision care.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64256", "text": "{\n    \"policy_id\": \"COMP-001\",\n    \"policy_title\": \"Compensation and Equity Awards\",\n    \"policy_description\": \"This policy details the company's comprehensive compensation structure, including salary bands, bonus programs, stock options, and long-term incentive plans, covering eligibility, vesting schedules, performance criteria, and tax implications. It also outlines the processes for equity award grants and administration, and the procedures for addressing compensation-related inquiries. The policy aims to align employee compensation with company performance and market competitiveness.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/compensation-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--64257", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to employees. It covers medical, dental, and vision care. Details regarding eligibility, coverage levels, and claim procedures are included.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-03-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"HR\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/health_insurance_benefits.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--64257", "text": "{\n    \"policy_id\": \"EMP-COMP-012\",\n    \"policy_title\": \"Employee Compensation and Equity\",\n    \"policy_description\": \"This policy details the compensation structure, including salary bands, bonus programs, stock options, and long-term incentive plans. It also covers equity grants and vesting schedules. This is a comprehensive guide to all aspects of employee compensation. It outlines various compensation philosophies, including performance-based pay, market competitiveness, and internal equity.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-04-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/employee_compensation.pdf\"\n}"}
