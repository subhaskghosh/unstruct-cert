{"_id": "human_resources--hr_policies:_doc--n--65970", "text": "{\n    \"policy_id\": \"LE-2022-005\",\n    \"policy_title\": \"Leave of Absence Policy\",\n    \"policy_description\": \"This comprehensive policy details all types of leaves of absence available to employees, including medical leave, parental leave, and personal leave. It covers eligibility requirements, application procedures, and benefits continuation during leave. This document is very detailed and lengthy.\",\n    \"effective_date\": \"2022-12-20\",\n    \"last_updated\": \"2023-10-26\",\n    \"applicable_departments\": [\n        \"All Departments\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave-policy\"\n}"}
