{"_id": "human_resources--hr_policies:_doc--p--70594", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Health Insurance Benefits\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. It covers medical, dental, and vision care. Details about coverage levels and enrollment procedures are provided in the linked document.\",\n    \"effective_date\": \"2023-10-26\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Finance\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health_insurance.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70594", "text": "{\n    \"policy_id\": \"TRA-002\",\n    \"policy_title\": \"Travel Reimbursement Policy\",\n    \"policy_description\": \"This comprehensive policy details all aspects of employee travel reimbursement, including permissible expenses, approval processes, and documentation requirements.  It covers domestic and international travel, including airfare, lodging, meals, and ground transportation. A detailed breakdown of per diem rates is provided for various locations. It also details the procedures for submitting expense reports, required receipts, and approval workflows. The policy also covers emergency travel situations and provides guidance on obtaining travel insurance. Furthermore, it specifies the limits on expenses and the consequences of non-compliance. It also includes a section on the use of company-issued credit cards for travel-related expenses.\",\n    \"effective_date\": \"2022-05-10\",\n    \"last_updated\": \"2024-03-01\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/travel/reimbursement.pdf\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70595", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Comprehensive Health and Wellness Benefits\",\n    \"policy_description\": \"This policy details the health, dental, vision, and wellness programs available to all eligible employees. It includes information on preventative care, mental health resources, and employee assistance programs.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/benefits/health-wellness\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--70595", "text": "{\n    \"policy_id\": \"LVE-002\",\n    \"policy_title\": \"Parental Leave Policy\",\n    \"policy_description\": \"This policy outlines the provisions for employees taking leave due to the birth or adoption of a child. It covers eligibility, duration of leave, and benefits continuation.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2023-12-01\",\n    \"applicable_departments\": [\n        \"All\"\n    ],\n    \"policy_document_url\": \"https://example.com/leave/parental-leave\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--70596", "text": "{\n    \"policy_id\": \"EMP-COND-007\",\n    \"policy_title\": \"Code of Conduct and Ethics\",\n    \"policy_description\": \"This policy outlines the expected standards of behavior for all employees, ensuring a respectful and productive work environment. It covers areas such as conflict of interest, confidentiality, and professional conduct.\",\n    \"effective_date\": \"2022-05-15\",\n    \"last_updated\": \"2023-03-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/policies/conduct-ethics.pdf\"\n}"}
