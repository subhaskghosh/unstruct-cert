{"_id": "human_resources--hr_policies:_doc--p--68952", "text": "{\n    \"policy_id\": \"WB-2023-11-01\",\n    \"policy_title\": \"Employee Wellness and Burnout Prevention\",\n    \"policy_description\": \"This policy outlines resources and procedures to support employee mental health and prevent burnout, including access to counseling, stress management workshops, and flexible work arrangements. It promotes a healthy work-life balance and encourages early intervention for employees experiencing stress.\",\n    \"effective_date\": \"2023-11-01\",\n    \"last_updated\": \"2024-02-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/wellness-policy-wb-2023-11-01\"\n}"}
