{"_id": "human_resources--hr_policies:_doc--p--62536", "text": "{\n    \"policy_id\": \"EMP-BEN-007\",\n    \"policy_title\": \"Paid Time Off Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees to request and utilize paid time off, including vacation, sick leave, and personal days. It aims to provide employees with adequate rest and recovery to maintain work-life balance.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-05-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Customer Success\"\n    ],\n    \"policy_document_url\": \"https://example.com/pto-policy\"\n}"}
