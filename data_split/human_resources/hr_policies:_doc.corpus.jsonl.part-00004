{"_id": "human_resources--hr_policies:_doc--p--61372", "text": "{\n    \"policy_id\": \"RW-2023-001\",\n    \"policy_title\": \"Remote Work Policy\",\n    \"policy_description\": \"This policy outlines the guidelines for employees working remotely, emphasizing flexibility and work-life balance. It supports a distributed workforce and promotes productivity through virtual collaboration. Eligibility is based on role and performance.\",\n    \"effective_date\": \"2023-02-15\",\n    \"last_updated\": \"2023-11-10\",\n    \"applicable_departments\": [\n        \"Engineering\",\n        \"Sales\"\n    ],\n    \"policy_document_url\": \"https://example.com/remote-work-policy\"\n}"}
