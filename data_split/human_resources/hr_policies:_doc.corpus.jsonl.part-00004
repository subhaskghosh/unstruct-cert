{"_id": "human_resources--hr_policies:_doc--p--67999", "text": "{\n    \"policy_id\": \"BEN-001\",\n    \"policy_title\": \"Employee Health Insurance\",\n    \"policy_description\": \"This policy outlines the health insurance benefits available to all eligible employees. Coverage details, eligibility requirements, and claim procedures are included.\",\n    \"effective_date\": \"2023-01-01\",\n    \"last_updated\": \"2024-01-15\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/health-insurance-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--67999", "text": "{\n    \"policy_id\": \"BEN-002\",\n    \"policy_title\": \"Comprehensive Retirement Plan\",\n    \"policy_description\": \"This document provides a detailed explanation of the company's 401(k) plan, including eligibility criteria, contribution matching, vesting schedules, investment options, loan provisions, withdrawal rules, and related tax implications. It also includes information about financial planning resources available to employees. This is a very extensive and detailed plan.\",\n    \"effective_date\": \"2022-06-01\",\n    \"last_updated\": \"2024-02-29\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/retirement-plan\"\n}"}
{"_id": "human_resources--hr_policies:_doc--p--68000", "text": "{\n    \"policy_id\": \"WB-2023-005\",\n    \"policy_title\": \"Employee Assistance Program (EAP)\",\n    \"policy_description\": \"This policy outlines the Employee Assistance Program available to all employees, providing confidential counseling and support services for personal and work-related issues. It's designed to help employees maintain their well-being and enhance their overall quality of life. Information is presented in simple, direct language.\",\n    \"effective_date\": \"2023-03-15\",\n    \"last_updated\": \"2024-01-20\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\"\n    ],\n    \"policy_document_url\": \"https://example.com/eap-policy\"\n}"}
{"_id": "human_resources--hr_policies:_doc--n--68000", "text": "{\n    \"policy_id\": \"PR-2023-012\",\n    \"policy_title\": \"Performance Review Process\",\n    \"policy_description\": \"This policy details the annual performance review process, including self-assessments, manager evaluations, and goal setting. It covers the criteria used for evaluating employee performance and the process for addressing performance issues. The document includes complex performance matrices and legal disclaimers.\",\n    \"effective_date\": \"2023-06-01\",\n    \"last_updated\": \"2024-02-10\",\n    \"applicable_departments\": [\n        \"Sales\",\n        \"Marketing\",\n        \"Engineering\"\n    ],\n    \"policy_document_url\": \"https://example.com/performance-review-policy\"\n}"}
