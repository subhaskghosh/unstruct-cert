{"_id": "llm_agent_and_tool--user_behavior_tr--p--68644", "text": "{\n    \"session_id\": \"session_12345\",\n    \"user_id\": \"user_7890\",\n    \"actions\": [\n        {\n            \"action_id\": \"action_001\",\n            \"action_type\": \"input\",\n            \"action_timestamp\": \"2024-01-27T10:00:00Z\",\n            \"metadata\": {\n                \"text\": \"I want to plan a trip to Italy in June.\"\n            }\n        },\n        {\n            \"action_id\": \"action_002\",\n            \"action_type\": \"click\",\n            \"action_timestamp\": \"2024-01-27T10:01:30Z\",\n            \"metadata\": {\n                \"element_id\": \"suggested_destinations\"\n            }\n        },\n        {\n            \"action_id\": \"action_003\",\n            \"action_type\": \"input\",\n            \"action_timestamp\": \"2024-01-27T10:03:00Z\",\n            \"metadata\": {\n                \"text\": \"Rome and Florence are good options.\"\n            }\n        },\n        {\n            \"action_id\": \"action_004\",\n            \"action_type\": \"navigate\",\n            \"action_timestamp\": \"2024-01-27T10:04:15Z\",\n            \"metadata\": {\n                \"url\": \"/flights/rome\"\n            }\n        },\n        {\n            \"action_id\": \"action_005\",\n            \"action_type\": \"click\",\n            \"action_timestamp\": \"2024-01-27T10:06:00Z\",\n            \"metadata\": {\n                \"element_id\": \"filter_price\"\n            }\n        },\n        {\n            \"action_id\": \"action_006\",\n            \"action_type\": \"input\",\n            \"action_timestamp\": \"2024-01-27T10:07:30Z\",\n            \"metadata\": {\n                \"text\": \"Book the cheapest flights.\"\n            }\n        }\n    ]\n}"}
