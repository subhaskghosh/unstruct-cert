{"_id": "llm_agent_and_tool--customer_support--p--70274", "text": "{\n    \"agent_id\": \"AS7892\",\n    \"customer_queries\": [\n        {\n            \"query_text\": \"My order hasn't arrived yet and the tracking link isn't working. Can you help me locate it?\",\n            \"customer_id\": \"C12345\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I'm having trouble setting up the new feature.  I followed the instructions, but it's still not working. Could you walk me through it?\",\n            \"customer_id\": \"C67890\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I was accidentally charged twice for my subscription. Could you please investigate?\",\n            \"customer_id\": \"C24680\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I'm not sure which plan would be best for my needs.  I currently have X and do Y.  What would you suggest?\",\n            \"customer_id\": \"C13579\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I see that a newer version of the software is available. What are the major changes?\",\n            \"customer_id\": \"C98765\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I'm having trouble with my account.  I believe it may have been compromised.\",\n            \"customer_id\": \"C45678\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I'm encountering an error message during checkout.  Can you assist?\",\n            \"customer_id\": \"C80246\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I want to upgrade my subscription, but I'm not sure about the process.\",\n            \"customer_id\": \"C36912\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I am interested in the new product line, what are the benefits of switching?\",\n            \"customer_id\": \"C74185\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"My payment method is not being accepted, please investigate.\",\n            \"customer_id\": \"C25814\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I am facing an issue while downloading the latest update.\",\n            \"customer_id\": \"C96325\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"Could you please help me with setting up two-factor authentication?\",\n            \"customer_id\": \"C85207\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I'm trying to link my account to a third-party service, is there documentation on this?\",\n            \"customer_id\": \"C14703\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I am considering switching providers. Is there anything you can do to retain me?\",\n            \"customer_id\": \"C63951\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"My profile information seems incorrect. Can you help me edit it?\",\n            \"customer_id\": \"C50628\",\n            \"resolution_status\": \"resolved\"\n        }\n    ],\n    \"resolution_time\": 2.1,\n    \"feedback_scores\": [\n        4.5,\n        4.8,\n        4.6,\n        4.3,\n        4.7,\n        4.9,\n        4.4,\n        4.6,\n        4.8,\n        4.2,\n        4.9,\n        4.7,\n        4.5,\n        4.6,\n        4.3\n    ]\n}"}
