{"_id": "llm_agent_and_tool--customer_support--p--68785", "text": "{\n    \"agent_id\": \"A12345\",\n    \"customer_queries\": [\n        {\n            \"query_text\": \"My account is showing an incorrect balance after a recent transaction. I've checked my records and the amount deducted is higher than what I authorized. This is a complex issue as it involves potential fraud and needs immediate attention.\",\n            \"customer_id\": \"C001\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I am having trouble integrating the API with my application. The documentation is unclear regarding authentication methods and error handling. I need guidance on how to properly implement this.\",\n            \"customer_id\": \"C002\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"The feature I requested in the last update is still not working as expected. I've followed the instructions, but the results are inconsistent. Could you please investigate?\",\n            \"customer_id\": \"C003\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"I'm getting a 'server error' message when trying to upload large files. I've tried different browsers and connection speeds, but the problem persists. Is there a file size limit?\",\n            \"customer_id\": \"C004\",\n            \"resolution_status\": \"resolved\"\n        },\n        {\n            \"query_text\": \"My subscription renewal failed, and I'm now unable to access premium features. I've verified my payment details, and they are correct. Please help me restore my access.\",\n            \"customer_id\": \"C005\",\n            \"resolution_status\": \"resolved\"\n        }\n    ],\n    \"resolution_time\": 2.5,\n    \"feedback_scores\": [\n        4.8,\n        5.0,\n        4.9,\n        4.7,\n        5.0\n    ]\n}"}
