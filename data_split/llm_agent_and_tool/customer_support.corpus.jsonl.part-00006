{"_id": "llm_agent_and_tool--customer_support--p--70474", "text": "{\n    \"agent_id\": \"AS78901\",\n    \"customer_queries\": [\n        {\n            \"query_text\": \"My account is locked and I'm unable to reset my password. I've tried the automated system, but it keeps saying my security questions are incorrect.\",\n            \"customer_id\": \"CU12345\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"I'm having trouble integrating the API with my application.  I'm receiving a 403 Forbidden error when attempting to authenticate. I’ve checked my API key and permissions.\",\n            \"customer_id\": \"CU67890\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"How do I configure two-factor authentication on my account? I want to add an extra layer of security.\",\n            \"customer_id\": \"CU24680\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"Can you explain the difference between the Pro and Enterprise plans?  I need a detailed breakdown of features and pricing.\",\n            \"customer_id\": \"CU13579\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"I'm getting a 'Disk Full' error when trying to upload files. How can I clear space in my account?\",\n            \"customer_id\": \"CU98765\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"My data is not syncing between devices. I've checked my internet connection and restarted both devices.\",\n            \"customer_id\": \"CU45678\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"I'm unable to access a specific report. I keep getting a permission denied error.\",\n            \"customer_id\": \"CU80291\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"I have forgotten my username. Can you help me recover it?\",\n            \"customer_id\": \"CU37592\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"I would like to understand the implications of upgrading to the latest version of the software.\",\n            \"customer_id\": \"CU74185\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"The application keeps crashing on startup. I've tried reinstalling it, but the problem persists.\",\n            \"customer_id\": \"CU29631\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"I need help setting up a VPN connection to access the corporate network.\",\n            \"customer_id\": \"CU51824\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"My email notifications are not being delivered. I've checked my spam folder and filters.\",\n            \"customer_id\": \"CU86420\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"I'm experiencing slow loading times for the web application. Can you investigate?\",\n            \"customer_id\": \"CU93716\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"How can I export my data in a CSV format?\",\n            \"customer_id\": \"CU15938\",\n            \"resolution_status\": \"Resolved\"\n        },\n        {\n            \"query_text\": \"I need assistance with configuring the advanced settings of the system.\",\n            \"customer_id\": \"CU62047\",\n            \"resolution_status\": \"Resolved\"\n        }\n    ],\n    \"resolution_time\": 2.1,\n    \"feedback_scores\": [\n        4.5,\n        4.7,\n        4.3,\n        4.6,\n        4.8\n    ]\n}"}
