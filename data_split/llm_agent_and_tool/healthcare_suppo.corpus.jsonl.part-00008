{"_id": "llm_agent_and_tool--healthcare_suppo--p--71806", "text": "{\n    \"agent_id\": \"HC-4287\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-01-15T14:30:00Z\",\n            \"content\": \"Patient reported improved heart function after medication adjustment. Expressed gratitude for follow-up.\",\n            \"patient_id\": \"PT-1022\",\n            \"sentiment\": \"positive\",\n            \"specialty\": \"cardiology\"\n        },\n        {\n            \"time\": \"2024-01-18T11:00:00Z\",\n            \"content\": \"Discussed complex case with patient regarding valve replacement options, answered all questions thoroughly.\",\n            \"patient_id\": \"PT-1045\",\n            \"sentiment\": \"neutral\",\n            \"specialty\": \"cardiology\"\n        },\n        {\n            \"time\": \"2024-01-22T09:00:00Z\",\n            \"content\": \"Follow up on post surgery recovery of the patient. Patient is doing well.\",\n            \"patient_id\": \"PT-1022\",\n            \"sentiment\": \"positive\",\n            \"specialty\": \"cardiology\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"record_id\": \"MR-8844\",\n            \"patient_id\": \"PT-1022\",\n            \"record_type\": \"EKG Report\"\n        },\n        {\n            \"record_id\": \"MR-9112\",\n            \"patient_id\": \"PT-1045\",\n            \"record_type\": \"Surgical History\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"patient_id\": \"PT-2001\",\n            \"time\": \"2024-02-01T10:30:00Z\",\n            \"type\": \"Follow-up\"\n        },\n        {\n            \"patient_id\": \"PT-2005\",\n            \"time\": \"2024-02-05T11:15:00Z\",\n            \"type\": \"Consultation\"\n        }\n    ]\n}"}
