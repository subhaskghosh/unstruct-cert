{"_id": "llm_agent_and_tool--healthcare_suppo--p--71851", "text": "{\n    \"agent_id\": \"HC-4782\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-01-15T10:00:00\",\n            \"content\": \"Follow-up call with Mr. Davies regarding his new medication for hypertension.\",\n            \"patient_id\": \"PD-1234\"\n        },\n        {\n            \"time\": \"2024-01-18T14:30:00\",\n            \"content\": \"Initiated contact with Ms. Rodriguez to schedule an EKG.\",\n            \"patient_id\": \"PR-5678\"\n        },\n        {\n            \"time\": \"2024-01-22T09:15:00\",\n            \"content\": \"Discussed lifestyle changes with Mr. Wilson to improve heart health.\",\n            \"patient_id\": \"WW-9012\"\n        },\n        {\n            \"time\": \"2024-01-25T11:00:00\",\n            \"content\": \"Provided information on cardiac rehabilitation programs.\",\n            \"patient_id\": \"SD-3456\"\n        },\n        {\n            \"time\": \"2024-01-29T16:45:00\",\n            \"content\": \"Followed up with Ms. Lee about her recent cardiology appointment.\",\n            \"patient_id\": \"LL-7890\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"record_id\": \"MR-1001\",\n            \"patient_id\": \"PD-1234\",\n            \"type\": \"Cardiology Report\",\n            \"date\": \"2024-01-10\",\n            \"summary\": \"Patient diagnosed with hypertension, medication prescribed.\"\n        },\n        {\n            \"record_id\": \"MR-1002\",\n            \"patient_id\": \"PR-5678\",\n            \"type\": \"EKG Results\",\n            \"date\": \"2024-01-18\",\n            \"summary\": \"Normal sinus rhythm.\"\n        },\n        {\n            \"record_id\": \"MR-1003\",\n            \"patient_id\": \"WW-9012\",\n            \"type\": \"Lifestyle Assessment\",\n            \"date\": \"2024-01-22\",\n            \"summary\": \"Patient advised to improve diet and exercise.\"\n        },\n        {\n            \"record_id\": \"MR-1004\",\n            \"patient_id\": \"SD-3456\",\n            \"type\": \"Cardiac Rehabilitation Referral\",\n            \"date\": \"2024-01-25\",\n            \"summary\": \"Patient referred to cardiac rehab program.\"\n        },\n        {\n            \"record_id\": \"MR-1005\",\n            \"patient_id\": \"LL-7890\",\n            \"type\": \"Follow-up Note\",\n            \"date\": \"2024-01-29\",\n            \"summary\": \"Patient reported feeling well after cardiology appointment.\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"patient_id\": \"AB-1122\",\n            \"date\": \"2024-02-05\",\n            \"time\": \"10:00\",\n            \"type\": \"Check-up\"\n        },\n        {\n            \"patient_id\": \"CD-3344\",\n            \"date\": \"2024-02-08\",\n            \"time\": \"14:00\",\n            \"type\": \"Consultation\"\n        }\n    ]\n}"}
{"_id": "llm_agent_and_tool--healthcare_suppo--n--71851", "text": "{\n    \"agent_id\": \"HC-9123\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-01-10T11:00:00\",\n            \"content\": \"Assisted with prescription refills for patient with diabetes.\",\n            \"patient_id\": \"EF-5678\"\n        },\n        {\n            \"time\": \"2024-01-12T15:30:00\",\n            \"content\": \"Responded to patient inquiry about billing.\",\n            \"patient_id\": \"GH-9012\"\n        },\n        {\n            \"time\": \"2024-01-17T09:00:00\",\n            \"content\": \"Updated patient information in the system.\",\n            \"patient_id\": \"IJ-3456\"\n        },\n        {\n            \"time\": \"2024-01-20T13:45:00\",\n            \"content\": \"Scheduled appointment for a routine physical.\",\n            \"patient_id\": \"KL-7890\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"record_id\": \"MR-2001\",\n            \"patient_id\": \"EF-5678\",\n            \"type\": \"Diabetes Management Plan\",\n            \"date\": \"2024-01-08\",\n            \"summary\": \"Patient's diabetes is well-controlled.\"\n        },\n        {\n            \"record_id\": \"MR-2002\",\n            \"patient_id\": \"GH-9012\",\n            \"type\": \"Billing Statement\",\n            \"date\": \"2024-01-11\",\n            \"summary\": \"Patient's outstanding balance.\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"patient_id\": \"MN-1122\",\n            \"date\": \"2024-02-01\",\n            \"time\": \"09:00\",\n            \"type\": \"Check-up\"\n        },\n        {\n            \"patient_id\": \"OP-3344\",\n            \"date\": \"2024-02-05\",\n            \"time\": \"11:00\",\n            \"type\": \"Consultation\"\n        },\n        {\n            \"patient_id\": \"QR-5566\",\n            \"date\": \"2024-02-10\",\n            \"time\": \"14:30\",\n            \"type\": \"Ph