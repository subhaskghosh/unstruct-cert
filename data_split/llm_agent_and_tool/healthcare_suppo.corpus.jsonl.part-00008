{"_id": "llm_agent_and_tool--healthcare_suppo--p--71729", "text": "{\n    \"agent_id\": \"HS0042\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-01-15T10:00:00\",\n            \"content\": \"Discussed medication adjustments with patient regarding recent angina. Encouraged lifestyle changes.\",\n            \"patient_id\": \"PT1234\"\n        },\n        {\n            \"time\": \"2024-01-18T14:30:00\",\n            \"content\": \"Followed up with patient after cardiology appointment, addressed concerns about side effects.\",\n            \"patient_id\": \"PT1234\"\n        },\n        {\n            \"time\": \"2024-02-01T09:15:00\",\n            \"content\": \"Provided information on heart-healthy diet to patient and family.\",\n            \"patient_id\": \"PT5678\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"patient_id\": \"PT1234\",\n            \"record_type\": \"Cardiology Report\",\n            \"date\": \"2023-12-10\",\n            \"summary\": \"Patient presents with stable angina. Prescribed new medication.\"\n        },\n        {\n            \"patient_id\": \"PT5678\",\n            \"record_type\": \"ECG Report\",\n            \"date\": \"2024-01-25\",\n            \"summary\": \"Normal sinus rhythm. No acute changes.\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"patient_id\": \"PT1234\",\n            \"date_time\": \"2024-02-10T11:00:00\",\n            \"type\": \"Follow-up Cardiology\"\n        },\n        {\n            \"patient_id\": \"PT5678\",\n            \"date_time\": \"2024-02-15T15:00:00\",\n            \"type\": \"General Check-up\"\n        }\n    ]\n}"}
