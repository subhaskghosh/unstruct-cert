{"_id": "llm_agent_and_tool--healthcare_suppo--p--71773", "text": "{\n    \"agent_id\": \"HS7892\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-03-08T10:00:00Z\",\n            \"content\": \"Following up on your cardiology appointment, are you experiencing any chest pain? We can schedule an ECG if needed.\",\n            \"patient_id\": \"P1234\"\n        },\n        {\n            \"time\": \"2024-03-07T14:30:00Z\",\n            \"content\": \"Just checking in after your cardiology consultation. Remember to take your medication as prescribed. Let me know if you have any questions.\",\n            \"patient_id\": \"P5678\"\n        },\n        {\n            \"time\": \"2024-03-06T09:15:00Z\",\n            \"content\": \"Regarding your cardiology results, Dr. Smith suggests a follow-up appointment. Would next Tuesday work for you?\",\n            \"patient_id\": \"P9012\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"record_id\": \"MR3456\",\n            \"patient_id\": \"P1234\",\n            \"record_type\": \"Cardiology Report\"\n        },\n        {\n            \"record_id\": \"MR7890\",\n            \"patient_id\": \"P5678\",\n            \"record_type\": \"ECG Results\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"appointment_id\": \"A1122\",\n            \"patient_id\": \"P1234\",\n            \"appointment_time\": \"2024-03-15T11:00:00Z\"\n        },\n        {\n            \"appointment_id\": \"A3344\",\n            \"patient_id\": \"P5678\",\n            \"appointment_time\": \"2024-03-12T14:00:00Z\"\n        }\n    ]\n}"}
