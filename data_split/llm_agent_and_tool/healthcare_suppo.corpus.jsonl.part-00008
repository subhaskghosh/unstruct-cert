{"_id": "llm_agent_and_tool--healthcare_suppo--p--71807", "text": "{\n    \"agent_id\": \"HS0012\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-01-15T10:00:00\",\n            \"content\": \"Patient reported chest pain. Advised to go to the emergency room and follow up with cardiology. Detailed notes on symptoms and patient history recorded.\",\n            \"patient_id\": \"PT0045\"\n        },\n        {\n            \"time\": \"2024-01-16T14:30:00\",\n            \"content\": \"Followed up with PT0045 regarding ER visit. Discussed medication adherence and scheduled a cardiology appointment for next week.\",\n            \"patient_id\": \"PT0045\"\n        },\n        {\n            \"time\": \"2024-02-01T09:00:00\",\n            \"content\": \"Addressed patient concerns about new medication for hypertension.\",\n            \"patient_id\": \"PT0112\"\n        },\n        {\n            \"time\": \"2024-02-05T11:15:00\",\n            \"content\": \"Scheduled follow-up appointment for PT0112.\",\n            \"patient_id\": \"PT0112\"\n        },\n        {\n            \"time\": \"2024-02-10T13:45:00\",\n            \"content\": \"Provided information on lifestyle changes for managing heart disease.\",\n            \"patient_id\": \"PT0078\"\n        },\n        {\n            \"time\": \"2024-02-15T16:00:00\",\n            \"content\": \"Coordinated care between primary care physician and cardiologist for PT0078.\",\n            \"patient_id\": \"PT0078\"\n        },\n        {\n            \"time\": \"2024-02-20T08:30:00\",\n            \"content\": \"Resolved billing inquiry for PT0045 regarding cardiology visit.\",\n            \"patient_id\": \"PT0045\"\n        },\n        {\n            \"time\": \"2024-02-21T12:00:00\",\n            \"content\": \"Discussed the importance of regular exercise with a patient.\",\n            \"patient_id\": \"PT0156\"\n        },\n        {\n            \"time\": \"2024-02-22T14:30:00\",\n            \"content\": \"Explained medication side effects to a patient.\",\n            \"patient_id\": \"PT0178\"\n        },\n        {\n            \"time\": \"2024-02-23T10:00:00\",\n            \"content\": \"Answered questions about a recent medical procedure.\",\n            \"patient_id\": \"PT0190\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"patient_id\": \"PT0045\",\n            \"record_type\": \"Cardiology Report\",\n            \"date\": \"2024-01-10\"\n        },\n        {\n            \"patient_id\": \"PT0112\",\n            \"record_type\": \"EKG Results\",\n            \"date\": \"2024-01-25\"\n        },\n        {\n            \"patient_id\": \"PT0078\",\n            \"record_type\": \"Blood Pressure Readings\",\n            \"date\": \"2024-02-08\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"patient_id\": \"PT0045\",\n            \"date\": \"2024-02-26\",\n            \"time\": \"11:00\",\n            \"type\": \"Cardiology Follow-up\"\n        },\n        {\n            \"patient_id\": \"PT0112\",\n            \"date\": \"2024-02-29\",\n            \"time\": \"09:30\",\n            \"type\": \"Check-up\"\n        }\n    ]\n}"}
