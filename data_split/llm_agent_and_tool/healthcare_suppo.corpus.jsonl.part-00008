{"_id": "llm_agent_and_tool--healthcare_suppo--p--71572", "text": "{\n    \"agent_id\": \"HC_Agent_123\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-01-15T10:00:00\",\n            \"content\": \"Discussed patient's concerns regarding medication side effects and provided links to reliable information about managing them. Explained the importance of adherence to the treatment plan.\",\n            \"patient_id\": \"PT_001\"\n        },\n        {\n            \"time\": \"2024-02-02T14:30:00\",\n            \"content\": \"Addressed patient's anxiety about an upcoming cardiac catheterization. Detailed the procedure step-by-step and answered all questions patiently.\",\n            \"patient_id\": \"PT_002\"\n        },\n        {\n            \"time\": \"2024-02-18T09:15:00\",\n            \"content\": \"Provided information about cardiac rehabilitation programs and connected the patient with a support group.\",\n            \"patient_id\": \"PT_003\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"record_id\": \"MR_101\",\n            \"patient_id\": \"PT_001\",\n            \"condition\": \"Heart Failure\"\n        },\n        {\n            \"record_id\": \"MR_102\",\n            \"patient_id\": \"PT_002\",\n            \"condition\": \"Heart Failure\"\n        },\n        {\n            \"record_id\": \"MR_103\",\n            \"patient_id\": \"PT_003\",\n            \"condition\": \"Heart Failure\"\n        },\n        {\n            \"record_id\": \"MR_104\",\n            \"patient_id\": \"PT_004\",\n            \"condition\": \"Arrhythmia\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"patient_id\": \"PT_001\",\n            \"time\": \"2024-03-01T11:00:00\",\n            \"type\": \"Cardiology Follow-up\"\n        }\n    ]\n}"}
