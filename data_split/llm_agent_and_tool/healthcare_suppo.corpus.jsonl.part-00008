tent\": \"Reviewed medication list with Mr. Carter.\",\n            \"patient_id\": \"PT-9900\"\n        },\n        {\n            \"time\": \"2024-02-12T10:00:00\",\n            \"content\": \"Discussed preventative care measures with Ms. Adams\",\n            \"patient_id\": \"PT-1212\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"record_type\": \"Lab Results\",\n            \"patient_id\": \"PT-1234\",\n            \"date_updated\": \"2024-01-28\"\n        },\n        {\n            \"record_type\": \"Medication List\",\n            \"patient_id\": \"PT-5678\",\n            \"date_updated\": \"2024-01-30\"\n        },\n        {\n            \"record_type\": \"Progress Notes\",\n            \"patient_id\": \"PT-9012\",\n            \"date_updated\": \"2024-02-05\"\n        },\n        {\n            \"record_type\": \"Imaging Reports\",\n            \"patient_id\": \"PT-3456\",\n            \"date_updated\": \"2024-02-08\"\n        },\n        {\n            \"record_type\": \"Allergy Information\",\n            \"patient_id\": \"PT-7890\",\n            \"date_updated\": \"2024-02-10\"\n        }\n    ],\n    \"appointment_schedule\": []\n}"}
