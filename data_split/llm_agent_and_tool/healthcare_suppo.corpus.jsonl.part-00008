{"_id": "llm_agent_and_tool--healthcare_suppo--p--71767", "text": "{\n    \"agent_id\": \"HS12345\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-01-26T10:00:00Z\",\n            \"content\": \"Patient reports ongoing chronic back pain. Discussed medication adherence and physical therapy options. Also noted patient is experiencing mild chest discomfort, potentially related to hypertension.\",\n            \"patient_id\": \"P98765\"\n        },\n        {\n            \"time\": \"2024-01-27T14:30:00Z\",\n            \"content\": \"Follow-up with P98765. Confirmed medication adjustments are helping with pain. Further investigated chest discomfort - ECG ordered. Emphasis on lifestyle changes for cardiovascular health.\",\n            \"patient_id\": \"P98765\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"record_id\": \"MR67890\",\n            \"patient_id\": \"P98765\",\n            \"record_type\": \"ECG Report\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"patient_id\": \"P98765\",\n            \"appointment_time\": \"2024-02-05T09:00:00Z\"\n        },\n        {\n            \"patient_id\": \"P11223\",\n            \"appointment_time\": \"2024-02-06T11:00:00Z\"\n        },\n        {\n            \"patient_id\": \"P33445\",\n            \"appointment_time\": \"2024-02-07T13:00:00Z\"\n        },\n        {\n            \"patient_id\": \"P55667\",\n            \"appointment_time\": \"2024-02-08T15:00:00Z\"\n        },\n        {\n            \"patient_id\": \"P77889\",\n            \"appointment_time\": \"2024-02-09T10:00:00Z\"\n        },\n        {\n            \"patient_id\": \"P99001\",\n            \"appointment_time\": \"2024-02-09T14:00:00Z\"\n        }\n    ]\n}"}
