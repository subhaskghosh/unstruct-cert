21\",\n            \"appointment_type\": \"Well-Child Checkup\"\n        }\n    ]\n}"}
{"_id": "llm_agent_and_tool--healthcare_suppo--p--71868", "text": "{\n    \"agent_id\": \"HS007\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-02-15T10:00:00Z\",\n            \"content\": \"I understand your concerns about the chest pain, Mr. Davies. We'll get to the bottom of this and ensure you receive the best possible care.  We’re going to run some tests and discuss the results thoroughly.\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"time\": \"2024-03-01T14:30:00Z\",\n            \"content\": \"It's completely normal to feel anxious after a diagnosis like this. Let's talk through your options and create a plan that you're comfortable with.\",\n            \"patient_id\": \"PT456\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"record_id\": \"MR001\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR002\",\n            \"patient_id\": \"PT456\"\n        },\n        {\n            \"record_id\": \"MR003\",\n            \"patient_id\": \"PT789\"\n        },\n        {\n            \"record_id\": \"MR004\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR005\",\n            \"patient_id\": \"PT999\"\n        },\n        {\n            \"record_id\": \"MR006\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR007\",\n            \"patient_id\": \"PT456\"\n        },\n        {\n            \"record_id\": \"MR008\",\n            \"patient_id\": \"PT789\"\n        },\n        {\n            \"record_id\": \"MR009\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR010\",\n            \"patient_id\": \"PT999\"\n        },\n        {\n            \"record_id\": \"MR011\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR012\",\n            \"patient_id\": \"PT456\"\n        },\n        {\n            \"record_id\": \"MR013\",\n            \"patient_id\": \"PT789\"\n        },\n        {\n            \"record_id\": \"MR014\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR015\",\n            \"patient_id\": \"PT999\"\n        },\n        {\n            \"record_id\": \"MR016\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR017\",\n            \"patient_id\": \"PT456\"\n        },\n        {\n            \"record_id\": \"MR018\",\n            \"patient_id\": \"PT789\"\n        },\n        {\n            \"record_id\": \"MR019\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR020\",\n            \"patient_id\": \"PT999\"\n        },\n        {\n            \"record_id\": \"MR021\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR022\",\n            \"patient_id\": \"PT456\"\n        },\n        {\n            \"record_id\": \"MR023\",\n            \"patient_id\": \"PT789\"\n        },\n        {\n            \"record_id\": \"MR024\",\n            \"patient_id\": \"PT123\"\n        },\n        {\n            \"record_id\": \"MR025\",\n            \"patient_id\": \"PT999\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"patient_id\": \"PT123\",\n            \"time\": \"2024-04-05T09:00:00Z\"\n        },\n        {\n            \"patient_id\": \"PT456\",\n            \"time\": \"2024-04-12T11:00:00Z\"\n        }\n    ]\n}"}
{"_id": "llm_agent_and_tool--healthcare_suppo--n--71868", "text": "{\n    \"agent_id\": \"HS012\",\n    \"patient_interactions\": [\n        {\n            \"time\": \"2024-02-20T11:30:00Z\",\n            \"content\": \"Your cardiology appointment is scheduled for next week. Please arrive 15 minutes early.\",\n            \"patient_id\": \"PT001\"\n        },\n        {\n            \"time\": \"2024-03-10T15:45:00Z\",\n            \"content\": \"Confirming your appointment with the cardiologist.  Do you have any questions about the location?\",\n            \"patient_id\": \"PT002\"\n        }\n    ],\n    \"medical_records\": [\n        {\n            \"record_id\": \"MR026\",\n            \"patient_id\": \"PT001\"\n        },\n        {\n            \"record_id\": \"MR027\",\n            \"patient_id\": \"PT002\"\n        },\n        {\n            \"record_id\": \"MR028\",\n            \"patient_id\": \"PT003\"\n        },\n        {\n            \"record_id\": \"MR029\",\n            \"patient_id\": \"PT001\"\n        },\n        {\n            \"record_id\": \"MR030\",\n            \"patient_id\": \"PT002\"\n        }\n    ],\n    \"appointment_schedule\": [\n        {\n            \"patient_id\": \"PT001\",\n            \"time\": \"2024-04-08T10:00:00Z\"\n        },\n        {\n            \"patient_id\": \"PT002\",\n            \"time\": \"2024-04-15T14:00:00Z\"\n        },\n        {\n            \"patient_id\": \"PT003\",\n            \"time\": \"2024-04-22T09:30:00Z\"\n        }\n    ]\n}"}
