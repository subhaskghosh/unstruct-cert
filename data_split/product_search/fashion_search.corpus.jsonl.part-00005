{"_id": "product_search--fashion_search--p--71418", "text": "{\n    \"product_id\": \"TSH-45678\",\n    \"product_name\": \"Autumn Breeze Cotton Tee\",\n    \"brand\": \"CozyThreads\",\n    \"category\": \"Tops\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This t-shirt is incredibly soft and comfortable! Perfect for layering in the fall. The color is a beautiful deep burgundy.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love the unique heathered texture of this tee. It's not just a plain shirt, it has a bit of style. Great quality cotton!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"material\": \"100% Cotton\",\n    \"size\": \"M\",\n    \"color\": \"Burgundy\",\n    \"pattern\": \"Heathered\",\n    \"care_instructions\": \"Machine wash cold, tumble dry low\",\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"neckline\": \"Crew Neck\",\n        \"sleeve_length\": \"Short Sleeve\"\n    }\n}"}
