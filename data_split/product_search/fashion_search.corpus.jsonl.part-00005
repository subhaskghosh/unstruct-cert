{"_id": "product_search--fashion_search--p--71318", "text": "{\n    \"product_id\": \"DRESS-12345\",\n    \"product_name\": \"Floral Cotton Midi Dress\",\n    \"category\": \"Dresses\",\n    \"brand\": \"Summer Bloom\",\n    \"material\": \"Cotton\",\n    \"size\": \"M\",\n    \"color\": \"Lavender\",\n    \"pattern\": \"Floral\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This dress is absolutely beautiful and perfect for a summer wedding! It's so comfortable and the floral pattern is stunning. Very elegant!\",\n            \"reviewer_name\": \"Sarah J.\"\n        },\n        {\n            \"review_text\": \"I received so many compliments wearing this dress. The cotton is lightweight and breathable, and the fit is perfect. Highly recommend!\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2024-05-15\",\n    \"attributes\": {\n        \"sleeve_length\": \"Sleeveless\",\n        \"dress_length\": \"Midi\"\n    },\n    \"care_instructions\": \"Machine wash cold, gentle cycle\"\n}"}
