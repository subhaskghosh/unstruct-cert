{"_id": "product_search--medical_supplies--p--71993", "text": "{\n    \"sterilization_standard\": \"USP\",\n    \"quantity_per_container\": 200,\n    \"usage\": \"Wound Care, Abrasions\",\n    \"product_id\": \"GP-4578-ST\",\n    \"product_name\": \"Sterile Gauze Pads\",\n    \"brand\": \"Medline\",\n    \"category\": \"Wound Care\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"These gauze pads are very soft and absorbent. Great for minor cuts and scrapes!\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Gentle on sensitive skin and stays in place. Highly recommend.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"material\": \"100% Cotton\",\n        \"size\": \"2x2 inches\",\n        \"ply\": 8\n    }\n}"}
