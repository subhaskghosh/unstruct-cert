{"_id": "product_search--restaurant_searc--p--68539", "text": "{\n    \"cuisine_type\": \"Italian\",\n    \"menu_items\": [\n        {\n            \"name\": \"Spaghetti Carbonara\",\n            \"price\": 22.5\n        },\n        {\n            \"name\": \"Margherita Pizza\",\n            \"price\": 18.0\n        },\n        {\n            \"name\": \"Tiramisu\",\n            \"price\": 10.0\n        }\n    ],\n    \"opening_hours\": {\n        \"Monday\": \"11:00-23:00\",\n        \"Tuesday\": \"11:00-23:00\",\n        \"Wednesday\": \"11:00-23:00\",\n        \"Thursday\": \"11:00-23:00\",\n        \"Friday\": \"11:00-00:00\",\n        \"Saturday\": \"12:00-00:00\",\n        \"Sunday\": \"12:00-22:00\"\n    },\n    \"location\": \"123 Main St, Downtown\",\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent Italian food in a cozy atmosphere. The service was impeccable, and the pasta was perfectly cooked.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"A hidden gem! Delicious food and a great wine list.  Not overly loud, which is a big plus.\",\n            \"reviewer_name\": \"Jane Doe\"\n        }\n    ]\n}"}
