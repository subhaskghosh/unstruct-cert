{"_id": "product_search--restaurant_searc--p--68707", "text": "{\n    \"cuisine_type\": \"Italian\",\n    \"menu_items\": [\n        {\n            \"name\": \"Spaghetti Carbonara\",\n            \"price\": 18.99\n        },\n        {\n            \"name\": \"Margherita Pizza\",\n            \"price\": 15.5\n        }\n    ],\n    \"opening_hours\": {\n        \"Monday\": \"11:00-22:00\",\n        \"Tuesday\": \"11:00-22:00\",\n        \"Wednesday\": \"11:00-22:00\",\n        \"Thursday\": \"11:00-23:00\",\n        \"Friday\": \"11:00-23:00\",\n        \"Saturday\": \"12:00-23:00\",\n        \"Sunday\": \"12:00-21:00\"\n    },\n    \"location\": \"123 Main Street, Anytown\",\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"A charming little Italian place. The food was delicious and the atmosphere was very cozy. Great service too!\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"Authentic Italian cuisine in a relaxing setting. Definitely recommend!\",\n            \"reviewer_name\": \"Jane Smith\"\n        }\n    ]\n}"}
