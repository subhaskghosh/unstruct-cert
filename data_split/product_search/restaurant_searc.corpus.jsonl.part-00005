{"_id": "product_search--restaurant_searc--p--71935", "text": "{\n    \"cuisine_type\": \"Italian\",\n    \"menu_items\": [\n        {\n            \"name\": \"Spaghetti Carbonara\",\n            \"price\": 25.99\n        },\n        {\n            \"name\": \"Vegetarian Lasagna\",\n            \"price\": 22.5\n        },\n        {\n            \"name\": \"Tiramisu\",\n            \"price\": 8.99\n        }\n    ],\n    \"opening_hours\": {\n        \"Monday\": \"11:00 - 23:00\",\n        \"Tuesday\": \"11:00 - 23:00\",\n        \"Wednesday\": \"11:00 - 23:00\",\n        \"Thursday\": \"11:00 - 23:00\",\n        \"Friday\": \"11:00 - 00:00\",\n        \"Saturday\": \"11:00 - 00:00\",\n        \"Sunday\": \"12:00 - 22:00\"\n    },\n    \"location\": \"123 Main Street, Downtown\",\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Fantastic Italian food and a really cozy atmosphere, perfect for a date night.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"Excellent service and delicious vegetarian options. Will definitely be back!\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ]\n}"}
