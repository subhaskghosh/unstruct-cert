{"_id": "product_search--office_supplies_--p--71995", "text": "{\n    \"product_id\": \"PW-BRW-500\",\n    \"product_name\": \"Bright White Report Paper\",\n    \"brand\": \"Premium Choice\",\n    \"category\": \"Paper\",\n    \"price\": 12.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent paper quality. Very bright and professional looking. Great for important documents.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"This paper is perfect for presentations and reports. No issues with printing or bleeding.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color\": \"Bright White\",\n        \"paper_weight\": \"20lb\",\n        \"sheet_count\": 500\n    },\n    \"quantity_per_pack\": 500,\n    \"material_type\": \"Wood Pulp\",\n    \"usage\": \"Reports, Presentations, Professional Documents\"\n}"}
