{"_id": "product_search--office_supplies_--p--71423", "text": "{\n    \"product_id\": \"PAPER-12345\",\n    \"product_name\": \"EcoPrint Premium Laser & Inkjet Paper\",\n    \"brand\": \"GreenLeaf Paper Co.\",\n    \"category\": \"Paper\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent paper quality! Works perfectly in my laser printer and gives vibrant colors with my inkjet. Feels substantial and not flimsy at all.\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"Great choice for important documents. The brightness is fantastic and the paper doesn't bleed or smudge.\",\n            \"reviewer_name\": \"Jane Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"brightness\": \"96\",\n        \"weight\": \"20lb\",\n        \"finish\": \"Smooth\",\n        \"printer_compatibility\": [\n            \"Laser\",\n            \"Inkjet\"\n        ]\n    },\n    \"quantity_per_pack\": 500,\n    \"material_type\": \"Paper\",\n    \"usage\": \"Printing, Copying, Documents\"\n}"}
