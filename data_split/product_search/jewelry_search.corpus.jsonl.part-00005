{"_id": "product_search--jewelry_search--p--65695", "text": "{\n    \"product_id\": \"NG00123\",\n    \"product_name\": \"Antique-Inspired Gold Pendant Necklace\",\n    \"brand\": \"Seraphina Jewels\",\n    \"category\": \"Necklaces\",\n    \"price\": 799.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Absolutely stunning necklace! The gold is beautiful and the amethyst is vibrant. It feels very well-made and I love the vintage design.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"A lovely delicate piece. I wear it every day. Excellent quality for the price.\",\n            \"reviewer_name\": \"Jessica Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"metal_color\": \"Yellow Gold\",\n        \"chain_length\": \"18 inches\",\n        \"pendant_height\": \"0.75 inches\",\n        \"pendant_width\": \"0.5 inches\"\n    },\n    \"material_type\": \"gold\",\n    \"gemstones\": [\n        {\n            \"gem_type\": \"amethyst\",\n            \"carat\": 0.5\n        }\n    ],\n    \"design_period\": \"Victorian Revival\"\n}"}
