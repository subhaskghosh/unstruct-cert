{"_id": "product_search--jewelry_search--p--65863", "text": "{\n    \"product_id\": \"GN00123\",\n    \"product_name\": \"Vintage Gold Diamond Pendant\",\n    \"brand\": \"Estate Jewelry\",\n    \"category\": \"Necklaces\",\n    \"material_type\": \"Gold\",\n    \"gemstones\": [\n        {\n            \"type\": \"Diamond\",\n            \"carat\": 0.5\n        }\n    ],\n    \"design_period\": \"Victorian\",\n    \"price\": 1850.0,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Absolutely stunning necklace! The gold is a beautiful color and the diamond sparkles. It feels very well-made and has a classic, elegant look.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I received so many compliments on this necklace. It's a perfect piece for special occasions.\",\n            \"reviewer_name\": \"Jessica Brown\"\n        }\n    ],\n    \"release_date\": \"2023-11-15\",\n    \"attributes\": {\n        \"chain_length\": \"18 inches\",\n        \"pendant_height\": \"0.75 inches\"\n    }\n}"}
{"_id": "product_search--jewelry_search--n--65863", "text": "{\n    \"product_id\": \"GN00456\",\n    \"product_name\": \"Modern Gold Diamond Collar Necklace\",\n    \"brand\": \"Shine Bright\",\n    \"category\": \"Necklaces\",\n    \"material_type\": \"Gold\",\n    \"gemstones\": [\n        {\n            \"type\": \"Diamond\",\n            \"carat\": 1.2\n        }\n    ],\n    \"design_period\": \"Contemporary\",\n    \"price\": 2500.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"The necklace is beautiful, but the clasp feels a little flimsy.\",\n            \"reviewer_name\": \"David Lee\"\n        },\n        {\n            \"review_text\": \"It's a modern design, which is what I wanted, but it's not as delicate as I expected.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"chain_length\": \"16 inches\",\n        \"pendant_height\": \"1.5 inches\"\n    }\n}"}
