{"_id": "product_search--toys_and_games_s--p--70534", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 872,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO-76955\",\n    \"product_name\": \"LEGO City Space Mars Research Shuttle\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Toys\",\n    \"price\": 119.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son loved this LEGO set! It kept him busy for hours, and he really enjoyed building the shuttle and exploring the Mars landscape. Highly recommend!\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Great quality and a challenging but rewarding build. The attention to detail is impressive.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-08-01\",\n    \"attributes\": {\n        \"dimensions\": \"18.9 x 14.6 x 4.7 inches\",\n        \"weight\": \"3.5 pounds\",\n        \"model_number\": \"76955\"\n    }\n}"}
