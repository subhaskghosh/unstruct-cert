{"_id": "product_search--toys_and_games_s--p--70334", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 872,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO-7669\",\n    \"product_name\": \"LEGO City Space Mars Research Shuttle\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Toys\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son loved this LEGO set! It was challenging but not too difficult, and he enjoyed building the shuttle and exploring the Mars base.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Great set! Excellent value for the price and a lot of fun to build.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"dimensions\": \"15 x 10 x 5 inches\",\n        \"color\": \"Multi-color\",\n        \"model_number\": \"7669\"\n    }\n}"}
