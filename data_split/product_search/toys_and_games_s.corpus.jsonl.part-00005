{"_id": "product_search--toys_and_games_s--p--68625", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 750,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO-SA-8765\",\n    \"product_name\": \"LEGO Space Explorer Shuttle\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Sets\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son absolutely loved this LEGO set! It was challenging enough to keep him engaged for hours, and the finished shuttle looks amazing.\",\n            \"reviewer_name\": \"David Miller\"\n        },\n        {\n            \"review_text\": \"Great set for any space enthusiast. The instructions were clear and easy to follow.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"dimensions\": \"15x8x4 inches\",\n        \"color\": \"Blue and Gray\",\n        \"model_number\": \"60354\"\n    }\n}"}
