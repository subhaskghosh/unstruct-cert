{"_id": "product_search--toys_and_games_s--p--71794", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 750,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO-SA789\",\n    \"product_name\": \"LEGO Space Explorer Mission\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Toys\",\n    \"price\": 89.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son absolutely loved this set! It kept him engaged for hours and he really enjoyed building the spaceship and exploring the alien planet.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great set, lots of details and fun to build. The instructions were clear and easy to follow.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"dimensions\": \"19.69 x 14.57 x 3.74 inches\",\n        \"weight\": \"3.2 pounds\",\n        \"model_number\": \"60351\"\n    }\n}"}
