{"_id": "product_search--toys_and_games_s--p--70050", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 754,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO-SA-754\",\n    \"product_name\": \"LEGO Space Explorer\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Sets\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son absolutely loved this LEGO set! The space theme is perfect for him, and he had a blast building it. Great quality and a lot of pieces for the price.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"Excellent set, very detailed and engaging. My kids spent hours putting it together and playing with it afterwards.\",\n            \"reviewer_name\": \"Alice Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"dimensions\": \"19.7 x 14.6 x 3.5 inches\",\n        \"color\": \"Blue, Gray, White\",\n        \"model_number\": \"754-SA\"\n    }\n}"}
