{"_id": "product_search--toys_and_games_s--p--71535", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 754,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO-76955\",\n    \"product_name\": \"LEGO City Space Mars Research Shuttle\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Toys\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son absolutely loves this LEGO set! It's a great size, and the space theme is perfect for him. Lots of details and fun to build.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"Excellent quality and a challenging but rewarding build. Highly recommended for LEGO fans.\",\n            \"reviewer_name\": \"Alice Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"dimensions\": \"15 x 10 x 5 inches\",\n        \"color\": \"Blue and Gray\",\n        \"model_number\": \"76955\"\n    }\n}"}
