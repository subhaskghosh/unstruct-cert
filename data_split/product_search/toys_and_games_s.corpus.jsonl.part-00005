{"_id": "product_search--toys_and_games_s--p--71525", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 872,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO7669\",\n    \"product_name\": \"LEGO City Space Port\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Sets\",\n    \"price\": 89.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son loves this LEGO set! It's challenging enough to keep him engaged, but not so difficult that he gets frustrated. The space theme is a big hit.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great quality and lots of fun to build. It looks fantastic on display.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-01\",\n    \"attributes\": {\n        \"dimensions\": \"19.6 x 14.5 x 3.5 inches\",\n        \"weight\": \"3.5 pounds\"\n    }\n}"}
