{"_id": "product_search--toys_and_games_s--p--70049", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 769,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO-SA-769\",\n    \"product_name\": \"LEGO Space Shuttle Adventure\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Sets\",\n    \"price\": 89.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son loves this LEGO set! It's challenging but not too difficult, and he's spent hours building and recreating space missions.\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"Great quality and a lot of fun. Encourages imagination and problem-solving.\",\n            \"reviewer_name\": \"Jane Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"dimensions\": \"15x10x5 inches\",\n        \"color\": \"Multi-colored\",\n        \"model_number\": \"769-SA\"\n    }\n}"}
