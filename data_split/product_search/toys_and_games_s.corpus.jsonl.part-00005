{"_id": "product_search--toys_and_games_s--p--71998", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 647,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO76955\",\n    \"product_name\": \"LEGO Space Shuttle Adventure\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Toys\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son loved this set! It was challenging but not too difficult, and he enjoyed building the shuttle and rover.\",\n            \"reviewer_name\": \"David Miller\"\n        },\n        {\n            \"review_text\": \"Great set with lots of details. The instructions were clear and easy to follow.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-06-15\",\n    \"attributes\": {\n        \"model_number\": \"76955\",\n        \"dimensions\": \"19.7 x 14.6 x 3.7 inches\",\n        \"color\": \"Blue, White, Grey\"\n    }\n}"}
