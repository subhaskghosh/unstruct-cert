{"_id": "product_search--toys_and_games_s--p--71399", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 750,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO-SA-9876\",\n    \"product_name\": \"LEGO Space Explorer Set\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Toys\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son loved this set! It was challenging but not too difficult, and he enjoyed building the spaceship and the alien landscape.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"Great quality and a lot of fun to put together. Highly recommend for any LEGO fan.\",\n            \"reviewer_name\": \"Emily Carter\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"attributes\": {\n        \"dimensions\": \"12x8x4 inches\",\n        \"color\": \"Multi-color\",\n        \"model_number\": \"SA9876\"\n    }\n}"}
