{"_id": "product_search--toys_and_games_s--p--71524", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 548,\n    \"theme\": \"Superhero\",\n    \"product_id\": \"LEGO76266\",\n    \"product_name\": \"Spider-Man’s Drone Attack\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Toys\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son loved this set! It was challenging but not too difficult for an 8-year-old. Great detail and fun to play with.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Excellent LEGO set. Spider-Man fans will be thrilled. Good value for the price.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-03-01\",\n    \"attributes\": {\n        \"color\": \"Red and Black\",\n        \"material\": \"Plastic\",\n        \"model_number\": \"76266\"\n    }\n}"}
