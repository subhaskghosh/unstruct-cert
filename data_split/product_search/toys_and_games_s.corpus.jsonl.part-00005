{"_id": "product_search--toys_and_games_s--p--68926", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 754,\n    \"theme\": \"Space Adventure\",\n    \"product_id\": \"LEGO-76555\",\n    \"product_name\": \"LEGO Space Shuttle Adventure\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Toys\",\n    \"price\": 89.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son loved this set! It was challenging but not too difficult for his age, and he's been playing with it for hours.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"A great LEGO set that encourages imaginative play. The space shuttle is well-designed and the minifigures are fun.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"dimensions\": \"14.5 x 10.5 x 3 inches\",\n        \"color\": \"Blue and Gray\",\n        \"model_number\": \"76555\"\n    }\n}"}
