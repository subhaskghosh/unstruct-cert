{"_id": "product_search--toys_and_games_s--p--68836", "text": "{\n    \"age_group\": \"8-12\",\n    \"pieces_included\": 750,\n    \"theme\": \"Space\",\n    \"product_id\": \"LEGO-9676-SpaceShuttle\",\n    \"product_name\": \"LEGO Space Shuttle Adventure\",\n    \"brand\": \"LEGO\",\n    \"category\": \"Building Sets\",\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My son absolutely loved this LEGO set! It was challenging but not too difficult, and he spent hours building it. Great quality and a really cool space shuttle.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"Fantastic set! The instructions were clear, and the finished product looks amazing. Highly recommend for any LEGO or space fan.\",\n            \"reviewer_name\": \"Jane Doe\"\n        }\n    ],\n    \"release_date\": \"2018-08-01\",\n    \"attributes\": {\n        \"dimensions\": \"15 x 10 x 5 inches\",\n        \"color\": \"Blue and White\",\n        \"model_number\": \"9676\"\n    }\n}"}
