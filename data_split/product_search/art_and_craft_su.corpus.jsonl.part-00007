{"_id": "product_search--art_and_craft_su--p--67378", "text": "{\n    \"product_id\": \"WCSET-BG-24\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great starter set! The colors are vibrant and blend well. Perfect for beginners like me.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Good quality for the price. My daughter loves it!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"Pan\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (24)\",\n        \"Paint Brush (1)\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--67378", "text": "{\n    \"product_id\": \"WCSET-PRO-12\",\n    \"product_name\": \"Professional Watercolor Paint Set - 12 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.0,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! Very pigmented and professional grade.\",\n            \"reviewer_name\": \"Sarah Jones\"\n        },\n        {\n            \"review_text\": \"A favorite of professional artists, these paints are worth the investment.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 12,\n        \"palette_type\": \"Tube\"\n    },\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (12)\",\n        \"Professional Brushes (3)\",\n        \"Porcelain Palette\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
