{"_id": "product_search--art_and_craft_su--p--68472", "text": "{\n    \"product_id\": \"WC-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning watercolor! The colors blend well and the price is perfect.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Exactly what I needed to start my watercolor journey. Very happy with the purchase.\",\n            \"reviewer_name\": \"John S.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Lavender\",\n        \"Sky Blue\",\n        \"Sea Green\",\n        \"Rose Pink\",\n        \"Lemon Yellow\",\n        \"Burnt Sienna\",\n        \"Indigo\",\n        \"Crimson Red\",\n        \"Peach\",\n        \"Olive Green\",\n        \"Gray\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--68472", "text": "{\n    \"product_id\": \"WC-202\",\n    \"product_name\": \"Professional Watercolor Pan Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality watercolors! Highly pigmented and perfect for professional artists.\",\n            \"reviewer_name\": \"Alice P.\"\n        },\n        {\n            \"review_text\": \"These paints are a dream to work with. The colors are vibrant and long-lasting.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"color_options\": [\n        \"Cerulean Blue\",\n        \"Ultramarine Blue\",\n        \"Viridian Green\",\n        \"Cadmium Red\",\n        \"Cadmium Yellow\",\n        \"Raw Sienna\",\n        \"Burnt Umber\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Purple Lake\",\n        \"Orange\",\n        \"Yellow Ochre\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Pans\",\n        \"2 Professional Brushes\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
