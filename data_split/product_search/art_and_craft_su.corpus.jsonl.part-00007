{"_id": "product_search--art_and_craft_su--n--68909", "text": "{\n    \"product_id\": \"WCSET-PR-12\",\n    \"product_name\": \"Professional Watercolor Paint Set - Vibrant\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 49.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"These paints are highly pigmented and great for experienced artists.\",\n            \"reviewer_name\": \"Sarah Jones\"\n        },\n        {\n            \"review_text\": \"Excellent quality, professional grade watercolors.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Viridian Green\",\n        \"Burnt Sienna\",\n        \"Ultramarine Blue\",\n        \"Magenta\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Brown\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"2 Watercolor Brushes\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"tube\",\n        \"number_of_colors\": 12\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--68910", "text": "{\n    \"product_id\": \"WP-48-PRO\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 42.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality for the price! Colors are vibrant and blend well. Perfect for beginners and professionals alike.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"A fantastic set, the paints are highly pigmented and a joy to use. Definitely worth the investment.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Violet\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Payne's Gray\",\n        \"Cadmium Red\",\n        \"Cadmium Yellow\",\n        \"Ultramarine Blue\",\n        \"Viridian\",\n        \"Magenta\",\n        \"Raw Umber\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"pigment_level\": \"artist grade\",\n        \"size\": \"12ml tubes\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--68910", "text": "{\n    \"product_id\": \"WS-12-STUD\",\n    \"product_name\": \"Student Watercolor Paint Set\",\n    \"brand\": \"Generic\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for school projects.\",\n            \"reviewer_name\": \"Alice Brown\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Brown\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Paint Brush\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"pigment_level\": \"student grade\",\n        \"size\": \"10ml tubes\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--68911", "text": "{\n    \"product_id\": \"WCSET-001\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 49.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints for the price. The colors are vibrant and blend well. Perfect for beginners and experienced artists alike.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I love this set! The pigment is rich and the paints are easy to use. Highly recommend.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Ultramarine Blue\",\n        \"Burnt Sienna\",\n        \"Viridian Green\",\n        \"Ivory Black\",\n        \"Purple\",\n        \"Orange\",\n        \"Pink\",\n        \"Brown\",\n        \"Gray\",\n        \"White\",\n        \"Magenta\",\n        \"Gold\",\n        \"Silver\",\n        \"Sky Blue\",\n        \"Forest Green\",\n        \"Peach\",\n        \"Lavender\",\n        \"Turquoise\",\n        \"Coral\",\n        \"Lime Green\",\n        \"Violet\",\n        \"Maroon\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"paper_weight\": \"140lb\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--68911", "text": "{\n    \"product_id\": \"WCSET-002\",\n    \"product_name\": \"Basic Watercolor Paint Set\",\n    \"brand\": \"GenericArt\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 3.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Decent for very basic use, but the colors are a bit pale and don't blend well.\",\n            \"reviewer_name\": \"Sarah Lee\"\n        },\n        {\n            \"review_text\": \"Okay for kids, but not for serious artists.\",\n            \"reviewer_name\": \"David Brown\"\n        }\n    ],\n    \"release_date\": \"2023-02-28\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Plastic Brush\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"tube\",\n        \"paper_weight\": \"60lb\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--68912", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning watercolor! The colors are vibrant and easy to blend.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for beginners like me.  The included brush is decent quality too.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Cerulean\",\n            \"Olive Green\",\n            \"Violet\",\n            \"Peach\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Payne's Grey\",\n            \"Lemon Yellow\",\n            \"Cadmium Red\",\n            \"Ultramarine\",\n            \"Viridian\",\n            \"Magenta\",\n            \"Coral\",\n            \"Indigo\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Brush\",\n            \"Mixing Palette\"\n        ],\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24\n    },\n    \"skill_level\": \"beginner\"\n}"}
