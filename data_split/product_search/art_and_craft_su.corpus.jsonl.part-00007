{"_id": "product_search--art_and_craft_su--n--68662", "text": "{\n    \"product_id\": \"WC-24P-PROF\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, perfect for professional artists.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"The pigments are highly concentrated and the colors are beautiful.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2022-11-20\",\n    \"color_options\": [\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Ultramarine Blue\",\n        \"Viridian\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Alizarin Crimson\",\n        \"Phthalo Green\",\n        \"Dioxazine Violet\",\n        \"Yellow Ochre\",\n        \"Payne's Gray\",\n        \"Cerulean Blue\",\n        \"Sap Green\",\n        \"Magenta\",\n        \"Orange\",\n        \"Violet\",\n        \"Brown\",\n        \"Indigo\",\n        \"Crimson\",\n        \"Purple\",\n        \"Gold\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"3 Brushes\",\n        \"Mixing Palette\",\n        \"Water Brush\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--68663", "text": "{\n    \"product_id\": \"WC-101\",\n    \"product_name\": \"Watercolor Paint Set - Serenity Collection\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Perfect for beginners! The colors are beautiful and blend easily.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great quality for the price. The included brushes are a good size for starting out.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"color_options\": [\n        \"Lavender\",\n        \"Sky Blue\",\n        \"Seafoam Green\",\n        \"Peach\",\n        \"Cream\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"3 Brushes (Size 8, 6, 4)\",\n        \"Watercolor Paper Pad (140lb)\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"paper_weight\": \"140lb\",\n        \"brush_type\": \"synthetic\"\n    }\n}"}
