{"_id": "product_search--art_and_craft_su--n--68033", "text": "{\n    \"product_id\": \"WC-PRO-456\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 75.0,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! Very pigmented and professional results.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"Best watercolor set I've ever used.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"watercolor\",\n        \"palette_type\": \"tube\",\n        \"color_options\": [\n            \"reds\",\n            \"yellows\",\n            \"blues\",\n            \"black\"\n        ]\n    },\n    \"color_options\": [\n        \"reds\",\n        \"yellows\",\n        \"blues\",\n        \"black\"\n    ],\n    \"set_includes\": [\n        \"paint tubes\",\n        \"watercolor brushes\",\n        \"mixing palette\",\n        \"canvas\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--68034", "text": "{\n    \"product_id\": \"WCSET-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and the brush is decent quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set. Easy to use and the colors mix well.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Round Brush\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12\n    }\n}"}
