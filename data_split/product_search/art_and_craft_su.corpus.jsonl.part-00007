{"_id": "product_search--art_and_craft_su--p--71410", "text": "{\n    \"product_id\": \"WC-24-PROF-ART\",\n    \"product_name\": \"Professional Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 69.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints for the price. Perfect for beginners wanting to learn!\",\n            \"reviewer_name\": \"ArtEnthusiast\"\n        },\n        {\n            \"review_text\": \"These colors blend beautifully and are very pigmented. A great set to start with.\",\n            \"reviewer_name\": \"WatercolorNewbie\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"paint_form\": \"Pan\",\n        \"lightfastness\": \"Excellent\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (24 pans)\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"Beginner\"\n}"}
