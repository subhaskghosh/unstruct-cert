{"_id": "product_search--art_and_craft_su--p--68133", "text": "{\n    \"product_id\": \"WCSET-BG-24\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Ocean Breeze\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are beautiful and blend easily. Very happy with the quality for the price.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for learning watercolor techniques and the colors are very calming.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Blue\",\n        \"Green\",\n        \"Teal\",\n        \"Aqua\",\n        \"Lavender\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
