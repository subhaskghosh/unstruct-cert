{"_id": "product_search--art_and_craft_su--p--67927", "text": "{\n    \"product_id\": \"WC-24-BGN-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. I especially love the included color mixing guide.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. The colors are really inspiring and I've been having a lot of fun experimenting with different techniques.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"pan\",\n        \"includes_brush\": true\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"24 watercolor pans\",\n        \"Watercolor brush\",\n        \"Mixing palette\",\n        \"Color mixing guide\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
