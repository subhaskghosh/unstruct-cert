{"_id": "product_search--art_and_craft_su--p--71590", "text": "{\n    \"product_id\": \"A12345\",\n    \"product_name\": \"Arteza Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and the brushes are decent quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for starting out with watercolor. I love the variety of colors.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"brush_types\": [\n            \"round\",\n            \"flat\",\n            \"liner\"\n        ],\n        \"palette_type\": \"plastic\",\n        \"paint_type\": \"pan\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Pans\",\n        \"Brushes\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
