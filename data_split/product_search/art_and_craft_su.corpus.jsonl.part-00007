{"_id": "product_search--art_and_craft_su--p--70467", "text": "{\n    \"product_id\": \"WCSET-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Nature's Palette\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend easily. The included brush is decent quality too.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for learning watercolor techniques. The colors are beautiful and the packaging is nice.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Sky Blue\",\n        \"Forest Green\",\n        \"Burnt Sienna\",\n        \"Ultramarine Blue\",\n        \"Violet\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Magenta\",\n        \"Olive Green\",\n        \"Yellow Ochre\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Phthalo Blue\",\n        \"Permanent Rose\",\n        \"Cadmium Red\",\n        \"Cadmium Yellow\",\n        \"Cerulean Blue\",\n        \"Sap Green\",\n        \"Viridian\",\n        \"Indigo\",\n        \"Peach\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"1 Round Brush\",\n        \"1 Watercolor Paper Pad (140lb)\",\n        \"1 Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"paper_size\": \"9x12 inches\",\n        \"number_of_colors\": 24\n    }\n}"}
