{"_id": "product_search--art_and_craft_su--n--68126", "text": "{\n    \"product_id\": \"WC-24-P-002\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 55.0,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints. A must-have for serious artists.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"The pigment is incredibly rich and the colors blend beautifully.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Professional Set\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\",\n        \"Cerulean Blue\",\n        \"Viridian\",\n        \"Raw Umber\",\n        \"Indigo\",\n        \"Payne's Gray\",\n        \"Rose Madder\",\n        \"Alizarin Crimson\",\n        \"Cadmium Yellow\",\n        \"Lemon Yellow\",\n        \"Sap Green\",\n        \"Hooker's Green\",\n        \"Prussian Blue\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paintbrushes\",\n        \"Palette\",\n        \"Mixing Cups\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--68127", "text": "{\n    \"product_id\": \"PS12345\",\n    \"product_name\": \"Beginner's Acrylic Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Painting Sets\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are bright and the paint flows well. It really helped me get started with acrylic painting.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"Great value for the price. My daughter loves this set and has been painting non-stop!\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_types\": [\n            \"Acrylic\"\n        ],\n        \"number_of_colors\": 12,\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"White\",\n            \"Black\",\n            \"Brown\",\n            \"Pink\",\n            \"Turquoise\",\n            \"Crimson\"\n        ],\n        \"brush_types\": [\n            \"Round\",\n            \"Flat\",\n            \"Filbert\"\n        ],\n        \"includes_canvas\": true\n    },\n    \"set_includes\": [\n        \"Paints\",\n        \"Brushes\",\n        \"Canvas\",\n        \"Palette\",\n        \"Palette Knife\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
