{"_id": "product_search--art_and_craft_su--p--71038", "text": "{\n    \"product_id\": \"WC-SET-001\",\n    \"product_name\": \"Artist's Watercolor Palette - Beginner's Choice\",\n    \"brand\": \"Royal Brush\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors blend beautifully and the quality is surprisingly good for the price.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love the range of colors! Perfect for landscapes and seascapes. Very easy to blend and create smooth washes.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Removable Palette\",\n        \"color_options\": [\n            \"Cerulean Blue\",\n            \"Phthalo Blue\",\n            \"Sap Green\",\n            \"Viridian\",\n            \"Ultramarine\",\n            \"Lemon Yellow\",\n            \"Crimson Red\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Ivory Black\",\n            \"Titanium White\",\n            \"Payne's Gray\",\n            \"Lavender\",\n            \"Peach\",\n            \"Magenta\",\n            \"Olive Green\",\n            \"Teal\",\n            \"Violet\",\n            \"Coral\",\n            \"Orange\",\n            \"Gold\",\n            \"Silver\",\n            \"Bronze\",\n            \"Copper\"\n        ]\n    },\n    \"skill_level\": \"beginner\",\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paintbrush\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--n--71038", "text": "{\n    \"product_id\": \"WC-SET-002\",\n    \"product_name\": \"Kids' Watercolor Fun Set\",\n    \"brand\": \"Color Splash\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"My daughter loves this set! The colors are bright and fun.\",\n            \"reviewer_name\": \"Emily P.\"\n        },\n        {\n            \"review_text\": \"Great for kids, but the quality isn't great for serious artists.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Built-in Palette\",\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Brown\",\n            \"Black\",\n            \"Pink\",\n            \"Lime\",\n            \"Turquoise\",\n            \"White\"\n        ]\n    },\n    \"skill_level\": \"beginner\",\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paintbrush\",\n        \"Coloring Book\"\n    ]\n}"}
