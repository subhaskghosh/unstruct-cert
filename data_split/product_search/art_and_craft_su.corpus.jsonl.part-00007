{"_id": "product_search--art_and_craft_su--p--71698", "text": "{\n    \"product_id\": \"WCS-24B-FLR\",\n    \"product_name\": \"Beginner's Bliss Watercolor Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for someone just starting out with watercolors! The colors are vibrant, and it's really great for painting flowers.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I've been using it for floral studies and am very happy.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Violet\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Grey\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Magenta\",\n        \"Cadmium Red\",\n        \"Cadmium Yellow\",\n        \"Ultramarine Blue\",\n        \"Viridian\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"pigment_concentration\": \"student grade\"\n    }\n}"}
