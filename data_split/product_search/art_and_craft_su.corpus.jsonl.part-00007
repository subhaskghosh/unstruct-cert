{"_id": "product_search--art_and_craft_su--p--67078", "text": "{\n    \"product_id\": \"WC-SET-24-LAND\",\n    \"product_name\": \"Inspire Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints for the price! The colors are vibrant and blend beautifully. Perfect for landscape painting.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set! She's a beginner and is really enjoying learning to watercolor with these.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Complete Set\",\n        \"theme\": \"Landscape\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Lemon Yellow\",\n        \"Sap Green\",\n        \"Burnt Orange\",\n        \"Violet\",\n        \"Raw Sienna\",\n        \"Payne's Gray\",\n        \"Titanium White\",\n        \"Cerulean Blue\",\n        \"Cadmium Red\",\n        \"Indian Yellow\",\n        \"Viridian\",\n        \"Burnt Umber\",\n        \"Dioxazine Violet\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paintbrushes\",\n        \"Palette\",\n        \"Mixing Tray\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
