{"_id": "product_search--art_and_craft_su--p--71707", "text": "{\n    \"product_id\": \"WC-12B-001\",\n    \"product_name\": \"Beginner's Watercolor Palette\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are lovely and blend well. Great value for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I was hesitant to start watercolor, but this set made it easy and fun. Highly recommend!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Pan\",\n        \"palette_material\": \"Plastic\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\",\n        \"Violet\",\n        \"Olive\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paintbrush\",\n        \"Mixing palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71707", "text": "{\n    \"product_id\": \"WC-24P-002\",\n    \"product_name\": \"Professional Watercolor Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 59.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Exceptional quality paints, perfect for experienced artists.\",\n            \"reviewer_name\": \"Sarah Williams\"\n        },\n        {\n            \"review_text\": \"The pigments are rich and vibrant. A fantastic investment.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Tube\",\n        \"palette_material\": \"Metal\"\n    },\n    \"color_options\": [\n        \"Cadmium Yellow Pale\",\n        \"Cadmium Red Pale\",\n        \"Ultramarine Blue\",\n        \"Viridian\",\n        \"Burnt Umber\",\n        \"Ivory Black\",\n        \"Cobalt Blue\",\n        \"Alizarin Crimson\",\n        \"Permanent Rose\",\n        \"Lemon Yellow\",\n        \"Sap Green\",\n        \"Raw Sienna\",\n        \"Cerulean Blue\",\n        \"Payne's Grey\",\n        \"Dioxazine Violet\",\n        \"Cadmium Orange\",\n        \"Yellow Ochre\",\n        \"Burnt Sienna\",\n        \"Prussian Blue\",\n        \"Viridian\",\n        \"Indigo\",\n        \"Permanent Green\",\n        \"Quinacridone Gold\",\n        \"Opera Rose\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Palette knife\",\n        \"Mixing palette\",\n        \"Brush set\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
