{"_id": "product_search--art_and_craft_su--n--68402", "text": "{\n    \"product_id\": \"CALLIG-202\",\n    \"product_name\": \"Calligraphy and Watercolor Set\",\n    \"brand\": \"Speedball\",\n    \"category\": \"Calligraphy Sets\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for calligraphy practice, the watercolors are a nice bonus.\",\n            \"reviewer_name\": \"Sarah K.\"\n        },\n        {\n            \"review_text\": \"Good quality pens and a useful watercolor set for experimentation.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-09-01\",\n    \"color_options\": [\n        \"Black\",\n        \"Gold\",\n        \"Silver\",\n        \"Red\",\n        \"Blue\"\n    ],\n    \"set_includes\": [\n        \"3 Calligraphy Pens\",\n        \"6 Watercolor Paints\",\n        \"Ink Cartridges\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"pen_tip_sizes\": [\n            \"2mm\",\n            \"3mm\",\n            \"5mm\"\n        ],\n        \"ink_type\": \"water-based\"\n    }\n}"}
