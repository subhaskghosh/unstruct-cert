{"_id": "product_search--art_and_craft_su--p--70340", "text": "{\n    \"product_id\": \"WCS-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"This set really helped me get started with watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Black\",\n            \"White\",\n            \"Brown\",\n            \"Crimson\",\n            \"Violet\",\n            \"Indigo\",\n            \"Turquoise\",\n            \"Lime\",\n            \"Peach\",\n            \"Lavender\",\n            \"Magenta\",\n            \"Gold\",\n            \"Silver\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Payne's Gray\",\n            \"Cerulean Blue\",\n            \"Sap Green\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Paint Brush\",\n            \"Mixing Palette\"\n        ],\n        \"skill_level\": \"beginner\"\n    }\n}"}
