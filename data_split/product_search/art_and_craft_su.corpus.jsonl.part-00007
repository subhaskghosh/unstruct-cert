{"_id": "product_search--art_and_craft_su--p--71873", "text": "{\n    \"product_id\": \"WCSET-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Castle Art Supplies\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for starting out. Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set! It's helped her explore her creativity.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Olive Green\",\n        \"Violet\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Cadmium Red\",\n        \"Cadmium Yellow\",\n        \"Ultramarine Blue\",\n        \"Sap Green\",\n        \"Magenta\",\n        \"Vermilion\",\n        \"Gold Ochre\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\",\n        \"Instruction Booklet\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"plastic\"\n    }\n}"}
