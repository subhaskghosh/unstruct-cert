{"_id": "product_search--art_and_craft_su--p--68694", "text": "{\n    \"product_id\": \"WC-SET-007\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! The colors are vibrant and blend beautifully. Perfect for intermediate artists.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I love this set! It's helped me explore new techniques and create stunning artwork.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"Viridian Green\",\n        \"Purple Lake\",\n        \"Orange Hue\",\n        \"Raw Umber\",\n        \"Payne's Gray\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Tubes\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"artist grade\",\n        \"pigment_concentration\": \"high\"\n    }\n}"}
