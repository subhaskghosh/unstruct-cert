{"_id": "product_search--art_and_craft_su--p--67940", "text": "{\n    \"product_id\": \"WCS-24-BGN\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and the included guide is very helpful for learning landscape techniques.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I'm loving learning watercolor with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Complete Set\",\n        \"includes_brush\": true\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (24 colors)\",\n        \"Paint Brushes (5 pieces)\",\n        \"Watercolor Paper Pad (30 sheets)\",\n        \"Mixing Palette\",\n        \"Instructional Guide\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
