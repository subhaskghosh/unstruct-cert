{"_id": "product_search--art_and_craft_su--p--68992", "text": "{\n    \"product_id\": \"WC-SET-24-PROF\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints for the price. Perfect for beginners like me!\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"The colors are vibrant and blend beautifully. A really inspiring set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"watercolor\",\n        \"set_type\": \"complete set\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paintbrush\",\n        \"Mixing palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--68992", "text": "{\n    \"product_id\": \"WC-SET-12-KID\",\n    \"product_name\": \"Kids Watercolor Paint Set\",\n    \"brand\": \"Crayola\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 9.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for kids! Easy to use and clean up.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"My little one loves these paints.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"watercolor\",\n        \"set_type\": \"basic set\",\n        \"paper_included\": true\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paintbrush\",\n        \"Paper pad\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--p--68993", "text": "{\n    \"product_id\": \"WC-SET-123\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, very vibrant colors. Perfect for beginners and experienced artists alike!\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I love this set! The colors blend beautifully and are highly pigmented.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Removable Palette\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (36)\",\n        \"Watercolor Brush (Size 8)\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"Beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--68993", "text": "{\n    \"product_id\": \"WC-MET-456\",\n    \"product_name\": \"Metallic Watercolor Paint Set\",\n    \"brand\": \"Royal Brush\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Beautiful metallic sheen! Great for adding accents to paintings.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"These paints are so pretty, but they are limited to metallic shades.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Fixed Palette\"\n    },\n    \"color_options\": [\n        \"Gold\",\n        \"Silver\",\n        \"Bronze\",\n        \"Copper\",\n        \"Pearl White\",\n        \"Iridescent Black\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (12 - Metallic)\",\n        \"Watercolor Brush (Size 6)\"\n    ],\n    \"skill_level\": \"Intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--68994", "text": "{\n    \"product_id\": \"WCSET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Highly recommend this set for anyone starting with watercolor. The paints are vibrant and easy to blend.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"number_of_colors\": 12\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--68994", "text": "{\n    \"product_id\": \"WCSET-202\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 75.0,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality watercolors, perfect for professional artists.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"The pigment is incredibly vibrant and lightfast. A must-have for any serious watercolor painter.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"color_options\": [\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Ultramarine Blue\",\n        \"Viridian Green\",\n        \"Alizarin Crimson\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Tubes\",\n        \"3 Sable Brushes\",\n        \"Porcelain Palette\",\n        \"Mixing Mediums\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"tube\",\n        \"number_of_colors\": 24\n    }\n}"}
