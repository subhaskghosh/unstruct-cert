{"_id": "product_search--art_and_craft_su--p--71860", "text": "{\n    \"product_id\": \"WC-24B-ART\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and easy to blend. I found it very easy to use for my illustrations.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great value for the price. The paints are smooth and the set is very beginner-friendly.\",\n            \"reviewer_name\": \"John D.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Paint Brush\",\n            \"Mixing Palette\",\n            \"Water Brush Pen\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"number_of_colors\": 24\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ]\n}"}
