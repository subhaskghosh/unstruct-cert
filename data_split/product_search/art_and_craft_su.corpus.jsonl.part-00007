{"_id": "product_search--art_and_craft_su--p--68429", "text": "{\n    \"product_id\": \"PAINT-SET-007\",\n    \"product_name\": \"Watercolor Painting Set for Beginners\",\n    \"brand\": \"Artify\",\n    \"category\": \"Painting Sets\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set to start with! The colors are bright and mix well. Instructions were very helpful.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set! It's perfect for learning watercolors and experimenting with different techniques.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (12 colors)\",\n        \"Paintbrushes (5 sizes)\",\n        \"Watercolor Paper Pad (20 sheets)\",\n        \"Mixing Palette\",\n        \"Instructions\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"paper_weight\": \"140lb\",\n        \"dimensions\": \"10 x 8 x 2 inches\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--68429", "text": "{\n    \"product_id\": \"PAINT-SET-012\",\n    \"product_name\": \"Acrylic Painting Set - Professional Grade\",\n    \"brand\": \"Masterpiece Paints\",\n    \"category\": \"Painting Sets\",\n    \"price\": 55.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality acrylics! Great for experienced artists.\",\n            \"reviewer_name\": \"David L.\"\n        },\n        {\n            \"review_text\": \"Very pigmented and easy to use. A bit expensive, but worth it for the quality.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-11-01\",\n    \"color_options\": [\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Ultramarine Blue\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Acrylic Paints (10 colors)\",\n        \"Canvas Boards (5 pack)\",\n        \"Palette Knife\",\n        \"Mixing Medium\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"Acrylic\",\n        \"canvas_size\": \"12x16 inches\",\n        \"dimensions\": \"14 x 12 x 3 inches\"\n    }\n}"}
