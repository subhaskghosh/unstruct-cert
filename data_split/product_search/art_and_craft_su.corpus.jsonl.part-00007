{"_id": "product_search--art_and_craft_su--n--71111", "text": "{\n    \"product_id\": \"AR-00987\",\n    \"product_name\": \"Arteza Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good value for the price. The colors are decent, but not as vibrant as more expensive brands.\",\n            \"reviewer_name\": \"Jessica Miller\"\n        },\n        {\n            \"review_text\": \"A decent starter set, but the paints can be a bit chalky.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2022-11-20\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Tube\",\n        \"pigment_concentration\": \"Medium\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
