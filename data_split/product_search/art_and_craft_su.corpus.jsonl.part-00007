{"_id": "product_search--art_and_craft_su--p--67281", "text": "{\n    \"product_id\": \"ARTEZA-WC-24-LAND\",\n    \"product_name\": \"Arteza Watercolor Paint Set, Landscape Edition\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully, especially for landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. I'm enjoying learning watercolor with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"suitable_for\": \"Landscapes, Portraits, Still Life\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
