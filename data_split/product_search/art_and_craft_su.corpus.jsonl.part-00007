{"_id": "product_search--art_and_craft_su--p--71275", "text": "{\n    \"product_id\": \"WP-1234\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"Royal & Langnickel\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. Excellent value for the price.\",\n            \"reviewer_name\": \"ArtLover22\"\n        },\n        {\n            \"review_text\": \"I've been using this set for a few weeks now and I'm really happy with it. The paints are good quality and the colors are beautiful.\",\n            \"reviewer_name\": \"WatercolorFan\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 12,\n        \"palette_type\": \"Plastic\",\n        \"suitable_for\": \"Landscapes, Still Life, Portraits\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Violet\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
