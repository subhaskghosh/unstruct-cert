{"_id": "product_search--art_and_craft_su--n--71532", "text": "{\n    \"product_id\": \"WC-SET-24-MT\",\n    \"product_name\": \"Metallic Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 34.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Beautiful shimmering colors! Perfect for special projects.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"The metallic paints add a unique touch to my artwork.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2023-07-20\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Gold\",\n            \"Silver\",\n            \"Bronze\",\n            \"Copper\",\n            \"Pearl White\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Paintbrush\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"skill_level\": \"Intermediate\",\n        \"is_metallic\": true\n    },\n    \"color_options\": [\n        \"Gold\",\n        \"Silver\",\n        \"Bronze\",\n        \"Copper\",\n        \"Pearl White\",\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\"\n    ]\n}"}
