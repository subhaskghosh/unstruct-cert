{"_id": "product_search--art_and_craft_su--p--71691", "text": "{\n    \"product_id\": \"WC-24-B\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning watercolor! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for beginners.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"pan\",\n        \"includes_brush\": true\n    },\n    \"color_options\": [\n        \"red\",\n        \"blue\",\n        \"yellow\",\n        \"green\",\n        \"purple\",\n        \"orange\"\n    ],\n    \"set_includes\": [\n        \"watercolor pans\",\n        \"watercolor brush\",\n        \"mixing palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
