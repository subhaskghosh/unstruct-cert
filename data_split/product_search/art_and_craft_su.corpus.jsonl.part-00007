{"_id": "product_search--art_and_craft_su--p--71849", "text": "{\n    \"product_id\": \"WCS-102\",\n    \"product_name\": \"Artist's Choice Watercolor Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great quality for the price! Perfect for beginners.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"The colors are vibrant and blend well. Very happy with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Ultramarine\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Payne's Grey\"\n        ],\n        \"set_includes\": [\n            \"12 Watercolor Paints\",\n            \"Brush\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"paint_type\": \"Watercolor\",\n        \"skill_level\": \"beginner\",\n        \"number_of_colors\": 14\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Grey\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--n--71849", "text": "{\n    \"product_id\": \"KWS-201\",\n    \"product_name\": \"Kids' First Watercolor Kit\",\n    \"brand\": \"Crayola\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 12.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"My daughter loves this kit! Easy to use and clean up.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Good for young children starting out with watercolors.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\"\n        ],\n        \"set_includes\": [\n            \"8 Watercolor Paints\",\n            \"Brush\",\n            \"Coloring Book\"\n        ],\n        \"paint_type\": \"Watercolor\",\n        \"skill_level\": \"beginner\",\n        \"number_of_colors\": 6\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\"\n    ],\n    \"set_includes\": [\n        \"8 Watercolor Paints\",\n        \"Brush\",\n        \"Coloring Book\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--p--71850", "text": "{\n    \"product_id\": \"WP-0012\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, perfect for beginners and professionals alike. The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"ArtEnthusiast\"\n        },\n        {\n            \"review_text\": \"Great set for the price! I'm learning watercolor and these paints have been a game changer.\",\n            \"reviewer_name\": \"NewArtist\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean Blue\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Viridian\",\n        \"Indigo\",\n        \"Violet\",\n        \"Peach\",\n        \"Olive Green\",\n        \"Lavender\",\n        \"Coral\",\n        \"Turquoise\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush (Round, Size 8)\",\n        \"Paint Brush (Flat, Size 6)\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad (140lb, 9x12in)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paper_type\": \"cold press\"\n    }\n}"}
