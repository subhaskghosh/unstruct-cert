{"_id": "product_search--art_and_craft_su--p--71169", "text": "{\n    \"product_id\": \"ARTEZA-WC-24-BOTANICAL\",\n    \"product_name\": \"Arteza Watercolor Paint Set - Botanical Collection\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend beautifully. Perfect for painting flowers and leaves.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. I'm really enjoying learning watercolor with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Phthalo Blue\",\n        \"Burnt Sienna\",\n        \"Viridian\",\n        \"Indigo\",\n        \"White\",\n        \"Black\",\n        \"and 20 more...\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"number_of_colors\": 24\n    }\n}"}
