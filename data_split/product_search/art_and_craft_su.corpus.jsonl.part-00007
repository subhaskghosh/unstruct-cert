{"_id": "product_search--art_and_craft_su--p--68289", "text": "{\n    \"product_id\": \"WC-SET-48-PROF\",\n    \"product_name\": \"Professional Watercolor Paint Set - 48 Colors\",\n    \"brand\": \"Artistry Pro\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! Vibrant colors and easy to blend. Perfect for beginners and experienced artists alike.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"A great set for the price. The colors are beautiful and the paints are highly pigmented.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Phthalo Blue\",\n        \"Burnt Sienna\",\n        \"Viridian\",\n        \"Raw Umber\",\n        \"Alizarin Crimson\",\n        \"Cadmium Red\",\n        \"Ultramarine Blue\",\n        \"Yellow Ochre\",\n        \"Payne's Gray\"\n    ],\n    \"set_includes\": [\n        \"48 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\",\n        \"Paint Case\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 48,\n        \"pigment_quality\": \"professional\"\n    }\n}"}
