{"_id": "product_search--art_and_craft_su--p--68884", "text": "{\n    \"product_id\": \"WC-SET-48-AQUA\",\n    \"product_name\": \"AquaFlow 48 Color Watercolor Paint Set\",\n    \"brand\": \"Artisan Dreams\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 42.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Absolutely beautiful colors and a joy to use! Perfect for beginners and experienced artists alike.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. The paints are highly pigmented and blend well.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Forest Green\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"and 42 more...\"\n    ],\n    \"set_includes\": [\n        \"48 watercolor paints\",\n        \"Watercolor brush\",\n        \"Mixing palette\",\n        \"Water brush pen\",\n        \"Carrying case\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"size\": \"standard\",\n        \"lightfastness\": \"good\"\n    }\n}"}
