{"_id": "product_search--art_and_craft_su--p--68874", "text": "{\n    \"product_id\": \"WC-24-ART-101\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"Creative Canvas\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and the quality is surprisingly good for the price.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Indigo\",\n            \"Violet\",\n            \"Olive Green\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Payne's Gray\",\n            \"Lemon Yellow\",\n            \"Cadmium Red\",\n            \"Alizarin Crimson\",\n            \"Ultramarine Blue\",\n            \"Cerulean Blue\",\n            \"Viridian\",\n            \"Sap Green\",\n            \"Burnt Umber\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Brush\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"paint_type\": \"water-based\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Paints\",\n        \"Brush\",\n        \"Palette\"\n    ]\n}"}
