{"_id": "product_search--art_and_craft_su--p--68032", "text": "{\n    \"product_id\": \"WCSET-1001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Deluxe\",\n    \"brand\": \"Castle Art Supplies\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and the quality is great for the price.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's helped her learn a lot about watercolor painting.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"Pan\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paintbrush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
