{"_id": "product_search--art_and_craft_su--p--71330", "text": "{\n    \"product_id\": \"WN-WCS-24\",\n    \"product_name\": \"Winsor & Newton Cotman Water Colour Paint Sketchers' Pocket Box\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. It's very inspiring to start painting with such a lovely palette.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great quality for the price. A really nice set to get started with watercolors and explore different techniques.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Pocket Box\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolors\",\n        \"Brush\",\n        \"Palette\",\n        \"Waterbrush\"\n    ],\n    \"skill_level\": \"Beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71330", "text": "{\n    \"product_id\": \"AZ-PLN-12\",\n    \"product_name\": \"Arteza Pouring Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Acrylic Paints\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"These pouring paints are really fun and create unique effects.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"Good value for the amount of paint you get. Easy to use for abstract art.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2023-01-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Acrylic\",\n        \"finish\": \"Glossy\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"White\",\n        \"Black\",\n        \"Purple\",\n        \"Orange\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Acrylic Paints\",\n        \"Pouring Medium\"\n    ],\n    \"skill_level\": \"Intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71331", "text": "{\n    \"product_id\": \"WP-SET-123\",\n    \"product_name\": \"Inspire Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"A wonderful set for beginners! The colors are vibrant and blend easily.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. Highly recommend!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Indigo\",\n            \"Olive Green\",\n            \"Violet\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Cerulean Blue\",\n            \"Lemon Yellow\",\n            \"Cadmium Red\",\n            \"Alizarin Crimson\",\n            \"Ultramarine Blue\",\n            \"Phthalo Green\",\n            \"Permanent Rose\",\n            \"Viridian\",\n            \"Payne's Gray\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"paint_type\": \"water-based\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Brush\",\n        \"Palette\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--n--71331", "text": "{\n    \"product_id\": \"WP-SET-456\",\n    \"product_name\": \"Professional Watercolor Set\",\n    \"brand\": \"ArtPro\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, perfect for experienced artists.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"Highly pigmented and long-lasting.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\"\n        ],\n        \"set_includes\": [\n            \"12 Watercolor Paints\",\n            \"2 Watercolor Brushes\",\n            \"Palette\"\n        ],\n        \"skill_level\": \"intermediate\",\n        \"paint_type\": \"professional-grade\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Brushes\",\n        \"Palette\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--p--71332", "text": "{\n    \"product_id\": \"WC-24-NATURAL-001\",\n    \"product_name\": \"Watercolor Paint Set - Natural Harmony\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors blend beautifully and the brush is a nice addition.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Love the earthy tones in this set. Perfect for landscapes and nature paintings.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"includes_brush\": true,\n        \"palette_type\": \"Removable\"\n    },\n    \"color_options\": [\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Olive Green\",\n        \"Payne's Gray\",\n        \"Indigo\"\n    ],\n    \"set_includes\": [\n        \"Paint Palette\",\n        \"Watercolor Brush (Round #6)\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"Beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71332", "text": "{\n    \"product_id\": \"WC-12-BRIGHT-002\",\n    \"product_name\": \"Watercolor Paint Set - Rainbow Splash\",\n    \"brand\": \"ColorBurst\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Fun colors for kids!\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"A vibrant set, great for craft projects.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-07-20\",\n    \"attributes\": {\n        \"colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"includes_brush\": false,\n        \"palette_type\": \"Fixed\"\n    },\n    \"color_options\": [\n        \"Bright Red\",\n        \"Neon Pink\",\n        \"Electric Blue\",\n        \"Lime Green\",\n        \"Sunshine Yellow\"\n    ],\n    \"set_includes\": [\n        \"Paint Palette\"\n    ],\n    \"skill_level\": \"Beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71333", "text": "{\n    \"product_id\": \"WC-24-ART-PRO\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints for the price. The colors are vibrant and blend well. Highly recommend for intermediate artists.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great set, lots of colors and good pigmentation. Perfect for practicing different techniques.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Pan\",\n        \"lightfastness\": \"Good\"\n    },\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Burnt Sienna\",\n        \"Ivory Black\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Pans\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"Intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71333", "text": "{\n    \"product_id\": \"WC-12-KID-BASIC\",\n    \"product_name\": \"Kids First Watercolor Set\",\n    \"brand\": \"Crayola\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 9.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for kids, but not very professional quality.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Colors are a bit pale and don't blend well.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Cake\",\n        \"lightfastness\": \"Poor\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Black\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Cakes\",\n        \"Paint Brush\"\n    ],\n    \"skill_level\": \"Beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71334", "text": "{\n    \"product_id\": \"WC-SET-123\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend well. Great value for the price.\",\n            \"reviewer_name\": \"Emily S.\"\n        },\n        {\n            \"review_text\": \"I bought this for my daughter and she loves it. It's a really nice quality set for the price.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Ultramarine\",\n            \"Burnt Sienna\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Mixing Palette\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--n--71334", "text": "{\n    \"product_id\": \"WC-SET-456\",\n    \"product_name\": \"Kids' First Watercolor Set - 8 Colors\",\n    \"brand\": \"Crayola\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 9.99,\n    \"availability\": true,\n    \"rating\": 4.0,\n    \"reviews\": [\n        {\n            \"review_text\": \"My kids love this set! Easy to use and clean up.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Black\",\n            \"Brown\"\n        ],\n        \"set_includes\": [\n            \"8 Watercolor Paints\",\n            \"Paint Brush\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 8\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"Brown\"\n    ]\n}"}
