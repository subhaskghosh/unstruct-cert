{"_id": "product_search--art_and_craft_su--p--67446", "text": "{\n    \"product_id\": \"WC-SET-123\",\n    \"product_name\": \"Beginner's Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! The colors are vibrant and mix well. The included brush is decent too.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I was hesitant to buy a watercolor set online, but this exceeded my expectations. Highly recommend for beginners.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Pan\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Pink\",\n        \"Violet\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Turquoise\",\n        \"Olive\",\n        \"Sienna\",\n        \"Umber\",\n        \"Burnt Orange\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Magenta\",\n        \"Peach\",\n        \"Lavender\",\n        \"Teal\"\n    ],\n    \"set_includes\": [\n        \"Paint Pans\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
