{"_id": "product_search--art_and_craft_su--p--71353", "text": "{\n    \"product_id\": \"WC-SET-123\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. It's inspired me to take up watercolor painting as a relaxing hobby.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Great quality paints for the price. Lots of color options to experiment with.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Crimson\",\n            \"Lemon Yellow\",\n            \"Ultramarine\",\n            \"Burnt Sienna\",\n            \"Phthalo Green\",\n            \"Payne's Gray\",\n            \"Ivory Black\",\n            \"Violet\",\n            \"Orange\",\n            \"Sap Green\",\n            \"Raw Umber\",\n            \"Cerulean Blue\"\n        ],\n        \"set_includes\": [\n            \"12 Watercolor Paints\",\n            \"Brush\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ]\n    },\n    \"skill_level\": \"beginner\"\n}"}
