{"_id": "product_search--art_and_craft_su--p--71316", "text": "{\n    \"product_id\": \"WC-24-BRIGHT\",\n    \"product_name\": \"BrightSplash Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend easily.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. The paints are highly pigmented.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-10-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Magenta\",\n        \"Violet\",\n        \"Teal\",\n        \"Olive\",\n        \"Gold\",\n        \"Silver\",\n        \"Lemon Yellow\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Cerulean Blue\",\n        \"Ultramarine\",\n        \"Phthalo Green\",\n        \"Dioxazine Violet\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Mixing Tray\",\n        \"Instruction Guide\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"pigment_quality\": \"high\"\n    }\n}"}
