{"_id": "product_search--art_and_craft_su--p--68200", "text": "{\n    \"product_id\": \"WC-24-ART-001\",\n    \"product_name\": \"Artist's Essentials Watercolor Set\",\n    \"brand\": \"Creative Canvas\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and mix well.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. My daughter loves it!\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Magenta\",\n        \"Cerulean\",\n        \"Indigo\",\n        \"Viridian\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Yellow Ochre\",\n        \"Cadmium Red\",\n        \"Alizarin Crimson\",\n        \"Ultramarine Blue\",\n        \"Phthalo Blue\",\n        \"Lemon Yellow\",\n        \"Cadmium Yellow\",\n        \"Sap Green\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad (12 sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"plastic\"\n    }\n}"}
