{"_id": "product_search--art_and_craft_su--p--71493", "text": "{\n    \"product_id\": \"WCSET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is fantastic for beginners! The colors are vibrant, and it comes with everything you need to get started.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Great quality for the price. I've been painting for weeks and the colors are still going strong.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"set_includes\": [\n            \"Paint Palette\",\n            \"Paintbrushes (3)\",\n            \"Watercolor Paper Pad\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ]\n}"}
