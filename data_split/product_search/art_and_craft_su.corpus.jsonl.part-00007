{"_id": "product_search--art_and_craft_su--p--68647", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! The colors are vibrant and easy to blend.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for a beginner like me. The price is excellent for the amount of paint you get.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Pink\",\n        \"Violet\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Turquoise\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Gold\",\n        \"Silver\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Magenta\",\n        \"Peach\",\n        \"Lavender\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush (Round)\",\n        \"Paint Brush (Flat)\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad (12 sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"paper_weight\": \"140lb\"\n    }\n}"}
