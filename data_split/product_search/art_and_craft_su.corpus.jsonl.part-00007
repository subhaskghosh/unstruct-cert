{"_id": "product_search--art_and_craft_su--p--71187", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. She's using it to paint beautiful landscapes.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Burnt Sienna\",\n        \"Violet\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Cadmium Red Light\",\n        \"Cadmium Yellow Medium\",\n        \"Ultramarine Blue\",\n        \"Sap Green\",\n        \"Cadmium Orange\",\n        \"Dioxazine Violet\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
