{"_id": "product_search--art_and_craft_su--p--71697", "text": "{\n    \"product_id\": \"WCS-24-BLU\",\n    \"product_name\": \"Bluebird Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors blend beautifully and the quality is surprisingly good for the price.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My daughter loves this watercolor set. The colors are vibrant and it has everything she needs to get started.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-11-15\",\n    \"color_options\": [\n        \"Blue\",\n        \"Green\",\n        \"Yellow\",\n        \"Red\",\n        \"Purple\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"paper_compatibility\": \"watercolor paper, mixed media paper\"\n    }\n}"}
