{"_id": "product_search--art_and_craft_su--p--71983", "text": "{\n    \"product_id\": \"WCSET-BG-12\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 12 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning watercolor! Colors are vibrant and the brush is decent.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. Easy to use and clean up.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Lemon Yellow\",\n            \"Cerulean Blue\"\n        ],\n        \"set_includes\": [\n            \"12 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Mixing Palette\",\n            \"Watercolor Paper Pad (12 sheets)\"\n        ]\n    },\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71983", "text": "{\n    \"product_id\": \"WCSET-PROF-24\",\n    \"product_name\": \"Professional Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 59.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints. Highly pigmented and blend beautifully.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"A must-have for any serious watercolor artist.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Cadmium Red\",\n            \"Cadmium Yellow\",\n            \"Ultramarine Blue\",\n            \"Viridian Green\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Ivory Black\",\n            \"Titanium White\",\n            \"Alizarin Crimson\",\n            \"Lemon Yellow\",\n            \"Phthalo Blue\",\n            \"Sap Green\",\n            \"Permanent Rose\",\n            \"Yellow Ochre\",\n            \"Cerulean Blue\",\n            \"Payne's Gray\",\n            \"Burnt Umber\",\n            \"Raw Sienna\",\n            \"Indigo\",\n            \"Cobalt Blue\",\n            \"Viridian\",\n            \"Crimson Lake\",\n            \"Gold Ochre\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"2 Professional Watercolor Brushes\",\n            \"Mixing Palette\",\n            \"Watercolor Paper Block (140lb)\"\n        ]\n    },\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71984", "text": "{\n    \"product_id\": \"WC-24-INSPIRE-BG\",\n    \"product_name\": \"Inspire Watercolor Paint Set - Beginner Landscape\",\n    \"brand\": \"BloomArt\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend beautifully. Perfect for landscapes.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's affordable and has a great range of colors.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Burnt Sienna\",\n        \"Violet\",\n        \"Indigo\",\n        \"Raw Umber\",\n        \"Ivory\",\n        \"Peach\",\n        \"Olive Green\",\n        \"Sky Blue\",\n        \"Rose Pink\",\n        \"Lavender\",\n        \"Coral\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"set_type\": \"complete set\"\n    }\n}"}
