{"_id": "product_search--art_and_craft_su--p--71502", "text": "{\n    \"product_id\": \"WC-24-PRO-LNDSC\",\n    \"product_name\": \"Professional Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artisan's Choice\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 27.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for landscape painting! The colors are vibrant and blend beautifully. Perfect for beginners who want quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I'm new to watercolor, and this set has been amazing. The colors are rich and the paints are easy to use.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"level\": \"Beginner\",\n        \"suitable_for\": \"Landscape Painting\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
