{"_id": "product_search--art_and_craft_su--p--70641", "text": "{\n    \"product_id\": \"WC-SET-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Serenity\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for relaxing and painting landscapes. The colors are very calming.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Olive Green\",\n        \"Violet\",\n        \"Burnt Orange\",\n        \"Sepia\",\n        \"Ivory\",\n        \"Magenta\",\n        \"Gold\",\n        \"Silver\",\n        \"Peach\",\n        \"Lavender\",\n        \"Turquoise\",\n        \"Coral\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_material\": \"plastic\"\n    }\n}"}
