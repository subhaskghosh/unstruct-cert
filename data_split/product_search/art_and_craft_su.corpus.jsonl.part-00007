{"_id": "product_search--art_and_craft_su--p--71889", "text": "{\n    \"product_id\": \"WC-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Vibrant Hues\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. The colors are vibrant and easy to use.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Lemon Yellow\",\n        \"Forest Green\",\n        \"Violet\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Ivory\",\n        \"Peach\",\n        \"Lavender\",\n        \"Turquoise\",\n        \"Magenta\",\n        \"Olive Green\",\n        \"Indigo\",\n        \"Coral\",\n        \"Gold\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\",\n        \"Instruction Guide\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"number_of_colors\": 24\n    }\n}"}
