{"_id": "product_search--art_and_craft_su--p--71874", "text": "{\n    \"product_id\": \"WP-24-WNS-001\",\n    \"product_name\": \"Winsor & Newton Cotman Water Colours Sketchers' Pocket Box\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. Perfect for landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I've been using this set for my botanical illustrations and it's fantastic.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Viridian\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Phthalo Blue\",\n        \"Sap Green\",\n        \"Payne's Gray\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Alizarin Crimson\",\n        \"Cerulean Blue\",\n        \"Burnt Umber\",\n        \"Olive Green\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Tubes\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush\",\n        \"Sketchbook\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"size\": \"pocket size\"\n    }\n}"}
