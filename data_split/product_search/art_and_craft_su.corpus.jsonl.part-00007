{"_id": "product_search--art_and_craft_su--p--71207", "text": "{\n    \"product_id\": \"WP-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. The included brush is a nice bonus.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. My daughter loves painting landscapes with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Olive Green\",\n        \"Sky Blue\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Violet\",\n        \"Indigo\",\n        \"Magenta\",\n        \"Peach\",\n        \"Gold\",\n        \"Silver\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Phthalo Green\",\n        \"Alizarin Crimson\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"set_size\": \"24\",\n        \"palette_type\": \"plastic\"\n    }\n}"}
