{"_id": "product_search--art_and_craft_su--p--68807", "text": "{\n    \"product_id\": \"WP-24-BGN-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning watercolor! The colors are vibrant and blend well. Very relaxing to use.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. Perfect for beginners like me!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Black\",\n            \"White\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Mixing Palette\",\n            \"Watercolor Paper Pad\"\n        ],\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24\n    },\n    \"skill_level\": \"beginner\"\n}"}
