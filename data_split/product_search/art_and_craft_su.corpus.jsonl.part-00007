{"_id": "product_search--art_and_craft_su--p--71931", "text": "{\n    \"product_id\": \"WC-12-BOTA-001\",\n    \"product_name\": \"Botanical Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully for botanical studies.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. Really helped me get into watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Phthalo Blue\",\n        \"Sap Green\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"Violet\",\n        \"Orange\",\n        \"Magenta\",\n        \"Ultramarine\",\n        \"Raw Umber\",\n        \"Payne's Gray\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 12\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71931", "text": "{\n    \"product_id\": \"WC-24-META-002\",\n    \"product_name\": \"Metallic Watercolor Paint Set\",\n    \"brand\": \"Crafter's Choice\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 28.5,\n    \"availability\": true,\n    \"rating\": 3.9,\n    \"reviews\": [\n        {\n            \"review_text\": \"Fun set with some interesting metallic shades.\",\n            \"reviewer_name\": \"Sarah Jones\"\n        },\n        {\n            \"review_text\": \"The metallic colors are a bit too glittery for my taste.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-08-20\",\n    \"color_options\": [\n        \"Gold\",\n        \"Silver\",\n        \"Bronze\",\n        \"Copper\",\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Phthalo Blue\",\n        \"Sap Green\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"special_effects\": \"Metallic Sheen\"\n    }\n}"}
