{"_id": "product_search--art_and_craft_su--p--68391", "text": "{\n    \"product_id\": \"WP-007\",\n    \"product_name\": \"Winsor & Newton Cotman Water Colour Paint Sketchers' Pocket Box\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality watercolors for the price. Perfect for beginners and traveling.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"The pigments are vibrant and blend beautifully. I especially like the portability of this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Pocket Box\",\n        \"palette_type\": \"Removable\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Pan\",\n        \"Water Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
