{"_id": "product_search--art_and_craft_su--p--71494", "text": "{\n    \"product_id\": \"WC-12-B-NAT\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Nature Inspired\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. The nature-themed palette is lovely and very inspiring.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for her art class.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"palette_theme\": \"Nature\",\n        \"included_brush\": true\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paint brush\",\n        \"Mixing palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71494", "text": "{\n    \"product_id\": \"ACR-48-PRO\",\n    \"product_name\": \"Professional Acrylic Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Acrylic Paints\",\n    \"price\": 59.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality acrylic paints. Highly recommended for professional artists.\",\n            \"reviewer_name\": \"Jessica Williams\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"number_of_colors\": 48,\n        \"paint_type\": \"Acrylic\",\n        \"palette_theme\": \"Neutral\",\n        \"included_brush\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\",\n        \"and 36 more...\"\n    ],\n    \"set_includes\": [\n        \"Acrylic paints\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71495", "text": "{\n    \"product_id\": \"watercolor_set_123\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"ArtLover78\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I've been using it for landscape paintings with great results.\",\n            \"reviewer_name\": \"PaintPro\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"watercolor\",\n        \"palette_type\": \"pan\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paintbrush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71495", "text": "{\n    \"product_id\": \"watercolor_set_456\",\n    \"product_name\": \"Crayola Watercolor Paint Set\",\n    \"brand\": \"Crayola\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for kids, but the colors are not very vibrant.\",\n            \"reviewer_name\": \"MomOfTwo\"\n        }\n    ],\n    \"release_date\": \"2021-10-20\",\n    \"attributes\": {\n        \"number_of_colors\": 8,\n        \"paint_type\": \"watercolor\",\n        \"palette_type\": \"pan\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paintbrush\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71496", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner's Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality for the price! Perfect for beginners.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"The colors are vibrant and blend beautifully. Very happy with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Ultramarine Blue\",\n        \"Viridian Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Cadmium Red\",\n        \"Alizarin Crimson\",\n        \"Yellow Ochre\",\n        \"Cerulean Blue\",\n        \"Sap Green\",\n        \"Ivory Black\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Tubes\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"Beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 12,\n        \"pigment_quality\": \"Artist Grade\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71496", "text": "{\n    \"product_id\": \"WC-SET-102\",\n    \"product_name\": \"Metallic Watercolor Palette\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Fun set with unique metallic colors!\",\n            \"reviewer_name\": \"Jessica Brown\"\n        },\n        {\n            \"review_text\": \"Great for adding shimmer to your artwork.\",\n            \"reviewer_name\": \"Michael Davis\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"color_options\": [\n        \"Gold\",\n        \"Silver\",\n        \"Bronze\",\n        \"Copper\",\n        \"Pearl White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Ultramarine Blue\",\n        \"Burnt Sienna\",\n        \"Raw Umber\"\n    ],\n    \"set_includes\": [\n        \"10 Watercolor Pans\",\n        \"Watercolor Brush\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"Intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 10,\n        \"pigment_quality\": \"Student Grade\",\n        \"effect\": \"Metallic\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--71497", "text": "{\n    \"product_id\": \"WC-24B-Botanical\",\n    \"product_name\": \"Botanical Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for starting out! The colors are vibrant and blend well, perfect for painting flowers.\",\n            \"reviewer_name\": \"Emily Carter\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"suitable_for\": \"Botanical Illustration, Landscapes\",\n        \"palette_type\": \"Removable Palette\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Mixing tray\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71497", "text": "{\n    \"product_id\": \"WC-12P-Pro\",\n    \"product_name\": \"Professional Watercolor Paint Palette\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 65.0,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great professional-grade paints.  Excellent pigment quality.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2024-01-10\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"suitable_for\": \"Professional Art\",\n        \"palette_type\": \"Fixed Palette\"\n    },\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Ultramarine\",\n        \"Viridian\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71498", "text": "{\n    \"product_id\": \"WC-24-BEGINNER-01\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend easily.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for learning watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2021-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Lemon Yellow\",\n        \"Emerald Green\",\n        \"Burnt Orange\",\n        \"Violet\",\n        \"Ivory\",\n        \"Magenta\",\n        \"Turquoise\",\n        \"Sepia\",\n        \"Umber\",\n        \"Sienna\",\n        \"Gold\",\n        \"Silver\",\n        \"Bronze\",\n        \"Pearl\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71498", "text": "{\n    \"product_id\": \"WC-12-PRO-02\",\n    \"product_name\": \"Professional Watercolor Paint Set - 12 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, perfect for serious artists.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"The colors are highly pigmented and blend beautifully.\",\n            \"reviewer_name\": \"Sarah Jones\"\n        }\n    ],\n    \"release_date\": \"2019-11-20\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Lemon Yellow\",\n        \"Emerald Green\",\n        \"Violet\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"2 Paint Brushes\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--71499", "text": "{\n    \"product_id\": \"WC-SET-001\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"Creative Visions\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. Good value for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. The paints stay moist for a good amount of time, and the colors are beautiful.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Pan Set\",\n        \"includes\": [\n            \"Palette\",\n            \"Brush\",\n            \"Water Brush\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Paint Pans\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71499", "text": "{\n    \"product_id\": \"WC-SET-002\",\n    \"product_name\": \"Basic Watercolor Paint Set\",\n    \"brand\": \"Everyday Art\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 3.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"The colors are okay, but they dry out really fast, even when sealed properly. Not great for long-term use.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"A decent starter set, but the paint quality isn't amazing.  Colors are a bit dull.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Tube Set\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Paint Tubes\",\n        \"Watercolor Brush\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
