{"_id": "product_search--art_and_craft_su--p--67729", "text": "{\n    \"product_id\": \"WCSET-123\",\n    \"product_name\": \"Serenity Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and easy to blend. The packaging is also really soothing.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"Pan\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Violet\",\n        \"Indigo\",\n        \"Turquoise\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Lavender\",\n        \"Peach\",\n        \"Sky Blue\",\n        \"Forest Green\",\n        \"Coral\",\n        \"Magenta\",\n        \"Gold\"\n    ],\n    \"set_includes\": [\n        \"Watercolor pans\",\n        \"Paint brush\",\n        \"Mixing palette\",\n        \"Water brush\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
