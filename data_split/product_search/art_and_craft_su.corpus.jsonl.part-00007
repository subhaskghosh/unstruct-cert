{"_id": "product_search--art_and_craft_su--p--70937", "text": "{\n    \"product_id\": \"WCS-24-BL\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. The landscape color palette is inspiring.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great quality for the price. My daughter loves painting landscapes with this set.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Orange\",\n            \"Purple\",\n            \"Crimson\",\n            \"Indigo\",\n            \"Olive Green\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Brush\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"skill_level\": \"Beginner\",\n        \"number_of_colors\": 24\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\"\n    ]\n}"}
