{"_id": "product_search--art_and_craft_su--p--70614", "text": "{\n    \"product_id\": \"WC-SET-007\",\n    \"product_name\": \"Castle Art Supplies Watercolor Paint Set\",\n    \"brand\": \"Castle Art Supplies\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Mixing Palette\",\n            \"Water Cup\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"paint_type\": \"watercolor\"\n    },\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Ultramarine Blue\",\n        \"Emerald Green\",\n        \"Violet\",\n        \"Burnt Sienna\",\n        \"Payne's Grey\",\n        \"Ivory\"\n    ],\n    \"set_includes\": [\n        \"24 x 12ml Watercolor Tubes\",\n        \"1 x Round Brush (Size 8)\",\n        \"1 x Flat Brush (Size 6)\",\n        \"1 x Ceramic Palette\",\n        \"1 x Mixing Tray\"\n    ]\n}"}
