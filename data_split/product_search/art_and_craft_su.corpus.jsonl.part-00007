{"_id": "product_search--art_and_craft_su--p--70570", "text": "{\n    \"product_id\": \"WC-SET-24-INT-001\",\n    \"product_name\": \"Artist's Watercolor Paint Set - Intermediate\",\n    \"brand\": \"CreativeFlow\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! The colors are vibrant and blend beautifully. Perfect for someone moving beyond beginner level.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great set for the price. The range of colors is fantastic, and the paints are highly pigmented.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"Violet\",\n        \"Orange\",\n        \"Phthalo Green\",\n        \"Raw Umber\",\n        \"Cadmium Red\",\n        \"Cadmium Yellow\",\n        \"Ultramarine Blue\",\n        \"Viridian\",\n        \"Burnt Umber\",\n        \"Payne's Gray\",\n        \"Magenta\",\n        \"Gold Ochre\",\n        \"Cobalt Blue\",\n        \"Sap Green\",\n        \"Van Dyke Brown\",\n        \"Indigo\",\n        \"Peach\",\n        \"Lavender\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush (Round, Size 8)\",\n        \"Watercolor Brush (Flat, Size 1/2 inch)\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\",\n        \"Paint Guide\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"pigment_concentration\": \"High\",\n        \"lightfastness\": \"Excellent\"\n    }\n}"}
