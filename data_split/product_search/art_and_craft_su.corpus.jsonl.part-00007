{"_id": "product_search--art_and_craft_su--p--68474", "text": "{\n    \"product_id\": \"WCS-24-PRO-A\",\n    \"product_name\": \"Professional Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 49.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, vibrant colors, perfect for beginners and professionals alike!\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"A great set to learn watercolor painting. The colors blend beautifully and the pigments are highly concentrated.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"Removable Palette\",\n        \"pigment_concentration\": \"High\",\n        \"paper_type_recommendation\": \"Cold Press\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush (Round, Size 8)\",\n        \"Palette\",\n        \"Mixing Tray\",\n        \"Instruction Booklet\"\n    ],\n    \"skill_level\": \"Beginner\"\n}"}
