{"_id": "product_search--art_and_craft_su--p--68965", "text": "{\n    \"product_id\": \"WC-SET-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are beautiful and blend easily. Perfect for outdoor painting.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. I love the variety of colors.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Blue\",\n            \"Green\",\n            \"Yellow\",\n            \"Red\",\n            \"Purple\",\n            \"Brown\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Brush\",\n            \"Palette\",\n            \"Water Mixing Cup\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"portability\": \"portable\",\n        \"value_for_money\": \"high\"\n    }\n}"}
