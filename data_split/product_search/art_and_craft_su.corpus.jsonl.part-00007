{"_id": "product_search--art_and_craft_su--p--71276", "text": "{\n    \"product_id\": \"WC-24-FLORA-BEGINNER\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Floral Collection\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. The floral theme is inspiring.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. Perfect for her first attempt at watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Pink\",\n        \"Lavender\",\n        \"Turquoise\",\n        \"Crimson\",\n        \"Olive Green\",\n        \"Magenta\",\n        \"Peach\",\n        \"Sky Blue\",\n        \"Burnt Sienna\",\n        \"Umber\",\n        \"Gold\",\n        \"Silver\",\n        \"Violet\",\n        \"Coral\",\n        \"Indigo\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush (Round - Size 6)\",\n        \"Paint Brush (Flat - Size 8)\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad (30 sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"paper_weight\": \"140lb\"\n    }\n}"}
