{"_id": "product_search--art_and_craft_su--p--71442", "text": "{\n    \"product_id\": \"WC-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for learning watercolor techniques. The colors blend well and are vibrant.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Cerulean\",\n            \"Lemon Yellow\",\n            \"Forest Green\",\n            \"Violet\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Ivory Black\",\n            \"Titanium White\",\n            \"Cadmium Red Light\",\n            \"Ultramarine Blue\",\n            \"Cadmium Yellow Medium\",\n            \"Sap Green\",\n            \"Dioxazine Violet\",\n            \"Burnt Umber\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Brush\",\n            \"Palette\",\n            \"Water cup\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"paint_type\": \"watercolor\"\n    }\n}"}
