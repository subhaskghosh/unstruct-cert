{"_id": "product_search--art_and_craft_su--p--70424", "text": "{\n    \"product_id\": \"AWCS-24L\",\n    \"product_name\": \"Arteza Watercolor Paint Set, 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. Great for landscape paintings.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I've been using it for a month and am really impressed.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"set_includes\": [\n            \"watercolor paints\",\n            \"watercolor brush\",\n            \"mixing palette\"\n        ]\n    },\n    \"skill_level\": \"beginner\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Olive Green\"\n    ]\n}"}
