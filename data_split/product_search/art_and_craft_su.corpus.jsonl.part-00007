{"_id": "product_search--art_and_craft_su--p--71643", "text": "{\n    \"product_id\": \"WNS-24-PRO\",\n    \"product_name\": \"Winsor & Newton Cotman Water Colour Paint Sketchers' Pocket Box\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 69.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality for the price. The colors are vibrant and blend beautifully. Perfect for beginners and experienced artists alike.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great set for travel! The compact size is convenient, and the paints are very pigmented.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"color_options\": [\n        \"Ultramarine\",\n        \"Cerulean Blue\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"and 18 more...\"\n    ],\n    \"set_includes\": [\n        \"24 Half Pans\",\n        \"Waterbrush\",\n        \"Mixing Palette\",\n        \"Sketching Pencil\",\n        \"Eraser\"\n    ],\n    \"skill_level\": \"Beginner to Intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"set_size\": \"24\",\n        \"portable\": true\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71643", "text": "{\n    \"product_id\": \"REE-12-STUD\",\n    \"product_name\": \"Reeves Watercolor Paint Set\",\n    \"brand\": \"Reeves\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.0,\n    \"reviews\": [\n        {\n            \"review_text\": \"A good starting point for watercolor painting, but the colors aren't as vibrant as more expensive brands.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-01-20\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Violet\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Payne's Gray\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Tubes\",\n        \"Brush\"\n    ],\n    \"skill_level\": \"Beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"set_size\": \"12\",\n        \"portable\": true\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--71644", "text": "{\n    \"product_id\": \"WC-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. Perfect for landscapes.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Pan\",\n        \"suitable_for\": \"Landscapes, Still Life\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\",\n        \"Cerulean Blue\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paintbrush\",\n        \"Mixing palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71644", "text": "{\n    \"product_id\": \"WC-202\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Daniel Smith\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.0,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Amazing quality paints! A professional's dream.\",\n            \"reviewer_name\": \"Carol Davis\"\n        },\n        {\n            \"review_text\": \"The colors are incredibly rich and pigmented.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Tube\",\n        \"suitable_for\": \"Portraits, Illustration\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\",\n        \"Cerulean Blue\",\n        \"Burnt Sienna\",\n        \"Ultramarine Blue\",\n        \"Raw Sienna\",\n        \"Viridian\",\n        \"Payne's Gray\",\n        \"Alizarin Crimson\",\n        \"Cadmium Red\",\n        \"Lemon Yellow\",\n        \"Permanent Green\",\n        \"Indigo\",\n        \"Sepia\",\n        \"Ivory Black\",\n        \"Titanium White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Palette knife\",\n        \"Mixing palette\",\n        \"Watercolor paper\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71645", "text": "{\n    \"product_id\": \"WC-SET-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Colors are vibrant and the brushes are decent quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the money. My daughter loves painting with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\"\n        ],\n        \"set_includes\": [\n            \"Watercolor Paints (12 colors)\",\n            \"Paint Brushes (5)\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"skill_level\": \"beginner\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71645", "text": "{\n    \"product_id\": \"WC-SET-002\",\n    \"product_name\": \"Prismacolor Premier Watercolor Paint Set\",\n    \"brand\": \"Prismacolor\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good quality paints, but a bit pricey.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"The colors are beautiful, but I wish the set included a palette.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Brown\",\n            \"Black\"\n        ],\n        \"set_includes\": [\n            \"Watercolor Paints (24 colors)\",\n            \"Paint Brushes (3)\"\n        ],\n        \"skill_level\": \"intermediate\"\n    }\n}"}
