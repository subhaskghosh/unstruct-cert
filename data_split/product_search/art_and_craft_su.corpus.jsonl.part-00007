{"_id": "product_search--art_and_craft_su--p--68257", "text": "{\n    \"product_id\": \"WC-SET-24-PROF\",\n    \"product_name\": \"Professional Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well.  Definitely a step up from student grade paints.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I was surprised by how pigmented these paints are.  Inspires me to paint more!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cobalt Blue\",\n        \"Emerald Green\",\n        \"Burnt Sienna\",\n        \"Violet\",\n        \"Indigo\",\n        \"Olive Green\",\n        \"Peach\",\n        \"Magenta\",\n        \"Sepia\",\n        \"Umber\",\n        \"Cerulean Blue\",\n        \"Gold\",\n        \"Silver\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush (Round, Size 8)\",\n        \"Watercolor Brush (Flat, Size 1/2 inch)\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paint_form\": \"pan\"\n    }\n}"}
