{"_id": "product_search--art_and_craft_su--p--71942", "text": "{\n    \"product_id\": \"WP-24-NAT-2023\",\n    \"product_name\": \"Nature's Hue Watercolor Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! Colors are vibrant and blend beautifully.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. Lots of colors to experiment with.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Sky Blue\",\n        \"Forest Green\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"Violet\",\n        \"Orange\",\n        \"Magenta\",\n        \"Brown\",\n        \"Olive Green\",\n        \"Purple\",\n        \"Peach\",\n        \"Coral\",\n        \"Indigo\",\n        \"Turquoise\",\n        \"Pink\",\n        \"Gold\",\n        \"Silver\",\n        \"White\",\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"set_weight_grams\": 300\n    }\n}"}
