{"_id": "product_search--art_and_craft_su--p--71692", "text": "{\n    \"product_id\": \"WP-24-BT-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Vibrant Landscapes\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend well. Great for landscape painting.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. Easy to use and the quality is surprisingly good for the price.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Burnt Sienna\",\n        \"Violet\",\n        \"Umber\",\n        \"Ivory\",\n        \"Magenta\",\n        \"Olive Green\",\n        \"Peach\",\n        \"Sky Blue\",\n        \"Lavender\",\n        \"Indigo\",\n        \"Coral\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"toxicity\": \"non-toxic\"\n    }\n}"}
