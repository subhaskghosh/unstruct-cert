{"_id": "product_search--art_and_craft_su--n--68456", "text": "{\n    \"product_id\": \"kid-watercolor-002\",\n    \"product_name\": \"Crayola Washable Kids' Watercolor Paint\",\n    \"brand\": \"Crayola\",\n    \"category\": \"Kids' Art Supplies\",\n    \"price\": 9.99,\n    \"availability\": true,\n    \"rating\": 4.0,\n    \"reviews\": [\n        {\n            \"review_text\": \"My kids love these! Easy to clean up.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\"\n    ],\n    \"set_includes\": [\n        \"8 Watercolor Paints\",\n        \"Brush\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"washable\": true,\n        \"number_of_colors\": 8\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--68457", "text": "{\n    \"product_id\": \"WC-123\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors blend well and the price is perfect.\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"Excellent quality watercolors for the price. I've been able to create beautiful landscapes with this set.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Pan\",\n        \"suitable_for\": \"Landscapes, Portraits, Still Life\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Brush\",\n        \"Mixing palette\",\n        \"Water brush\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--68457", "text": "{\n    \"product_id\": \"WC-456\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 49.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Amazing quality watercolors, perfect for professional artists.\",\n            \"reviewer_name\": \"Carol Davis\"\n        },\n        {\n            \"review_text\": \"The pigments are highly concentrated and vibrant. A bit pricey, but worth it.\",\n            \"reviewer_name\": \"David Wilson\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Tube\",\n        \"suitable_for\": \"Professional Artwork\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\",\n        \"Indigo\",\n        \"Violet\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Cerulean Blue\",\n        \"Sap Green\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Alizarin Crimson\",\n        \"Permanent Rose\",\n        \"Phthalo Green\",\n        \"Cobalt Blue\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"3 brushes\",\n        \"Mixing palette\",\n        \"Brush cleaner\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--68458", "text": "{\n    \"product_id\": \"WC-123\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and mix well. Great for painting landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. I'm learning to paint landscapes and this set has everything I need.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"3 Paintbrushes\",\n        \"Palette\",\n        \"Watercolor Paper Pad\",\n        \"Mixing Cups\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"paper_weight\": \"140lb\",\n        \"number_of_colors\": 12\n    }\n}"}
