{"_id": "product_search--art_and_craft_su--p--68722", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Artist's Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality for the price! The colors are vibrant and blend beautifully. Perfect for beginners like me.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"I was surprised by how pigmented these paints are. They're a great step up from student-grade watercolors.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"pan\",\n        \"palette_type\": \"metal\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Crimson\",\n        \"Ultramarine\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paintbrush\",\n        \"Mixing palette\",\n        \"Water brush pen\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
