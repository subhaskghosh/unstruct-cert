{"_id": "product_search--art_and_craft_su--p--71365", "text": "{\n    \"product_id\": \"WA-24-ARTEZA-BASIC\",\n    \"product_name\": \"Arteza Watercolor Paint Set, 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"These watercolors are incredibly vibrant and easy to blend, perfect for a beginner like me! The portability is a huge plus.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great set for the price! The colors are bright and work well for various techniques.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2022-08-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"portability\": true\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brush\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
