{"_id": "product_search--art_and_craft_su--p--68144", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. The landscape focused color palette is really helpful.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I'm learning watercolor and this set has everything I need to start.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_quantity\": 24,\n        \"paper_type\": \"Watercolor Paper Pad (30 sheets)\",\n        \"brush_included\": true,\n        \"palette_type\": \"Plastic Palette\",\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Orange\",\n            \"Violet\",\n            \"Pink\",\n            \"Sky Blue\",\n            \"Olive Green\"\n        ]\n    },\n    \"skill_level\": \"beginner\",\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brushes\",\n        \"Watercolor Paper\",\n        \"Mixing Palette\"\n    ]\n}"}
