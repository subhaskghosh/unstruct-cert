{"_id": "product_search--art_and_craft_su--n--68863", "text": "{\n    \"product_id\": \"WC-KID-12\",\n    \"product_name\": \"Kids Watercolor Paint Set\",\n    \"brand\": \"FunBrush\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 15.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"My kids love these! Great for little artists.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Easy to use and clean up. A fun introduction to watercolor painting.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-01\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Pink\",\n        \"Light Blue\",\n        \"Lime Green\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"Beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 12,\n        \"paint_form\": \"Cake\"\n    }\n}"}
