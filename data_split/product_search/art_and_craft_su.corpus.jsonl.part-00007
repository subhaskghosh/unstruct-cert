{"_id": "product_search--art_and_craft_su--p--71737", "text": "{\n    \"product_id\": \"WC-24-B-001\",\n    \"product_name\": \"Arteza Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I've been using it for landscape painting and am very happy.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Ultramarine Blue\",\n        \"Burnt Sienna\",\n        \"Viridian\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Yellow Ochre\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Sap Green\",\n        \"Magenta\",\n        \"Cobalt Blue\",\n        \"Cadmium Red\",\n        \"Phthalo Green\",\n        \"Indigo\",\n        \"Permanent Rose\",\n        \"Olive Green\",\n        \"Violet\",\n        \"Cerulean Blue\",\n        \"Burnt Umber\",\n        \"Ivory Black\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
