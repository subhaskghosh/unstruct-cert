{"_id": "product_search--art_and_craft_su--p--71117", "text": "{\n    \"product_id\": \"WCS-24B-LAND\",\n    \"product_name\": \"Beginner Watercolor Landscape Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. Perfect for landscapes.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price.  My daughter loves it!\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Violet\",\n        \"Umber\",\n        \"Payne's Gray\",\n        \"Ivory\",\n        \"Magenta\",\n        \"Gold\",\n        \"Silver\",\n        \"Peach\",\n        \"Lavender\",\n        \"Teal\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Watercolor Paper Pad\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"paper_weight\": \"140lb\",\n        \"number_of_colors\": 24\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71117", "text": "{\n    \"product_id\": \"WCS-12P-PORT\",\n    \"product_name\": \"Professional Watercolor Portrait Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Amazing quality paints, perfect for portrait work.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"These paints are so pigmented and blend beautifully!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2019-11-20\",\n    \"color_options\": [\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Cadmium Yellow Pale\",\n        \"Cadmium Red Pale\",\n        \"Alizarin Crimson\",\n        \"Ultramarine\",\n        \"Cerulean Blue\",\n        \"Viridian\",\n        \"Burnt Umber\",\n        \"Burnt Sienna\",\n        \"Raw Sienna\",\n        \"Yellow Ochre\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Round Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12\n    }\n}"}
