{"_id": "product_search--art_and_craft_su--p--71349", "text": "{\n    \"product_id\": \"WP-ART-007\",\n    \"product_name\": \"Artist's Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. Great for landscape painting.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Excellent quality watercolors. I've been using Winsor & Newton for years and this set doesn't disappoint.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Cadmium Yellow Pale\",\n        \"Cadmium Red Pale\",\n        \"Alizarin Crimson\",\n        \"Ultramarine\",\n        \"Cerulean Blue\",\n        \"Viridian\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Lemon Yellow\",\n        \"Cadmium Orange\",\n        \"Permanent Rose\",\n        \"Cobalt Blue\",\n        \"Phthalo Green\",\n        \"Burnt Umber\",\n        \"Yellow Ochre\",\n        \"Sap Green\",\n        \"Payne's Grey\",\n        \"Indigo\",\n        \"Purple Lake\",\n        \"Crimson Lake\",\n        \"Hooker's Green\",\n        \"Dioxazine Violet\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"plastic\"\n    }\n}"}
