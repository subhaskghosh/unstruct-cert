{"_id": "product_search--art_and_craft_su--p--71261", "text": "{\n    \"product_id\": \"WCSET-0012\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 36 Colors\",\n    \"brand\": \"Castle Art Supplies\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for starting out! The colors are bright and blend well.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set. Great value for the price.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cobalt Blue\",\n        \"Forest Green\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (36)\",\n        \"Watercolor Paper Pad (30 sheets)\",\n        \"Paintbrushes (3)\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"paper_weight\": \"140lb\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71261", "text": "{\n    \"product_id\": \"ARTEZA-WC001\",\n    \"product_name\": \"Arteza Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good set for the price, but some colors are a bit pale.\",\n            \"reviewer_name\": \"Jessica Brown\"\n        },\n        {\n            \"review_text\": \"A decent beginner set, but I wish there were more vibrant colors.\",\n            \"reviewer_name\": \"Michael Davis\"\n        }\n    ],\n    \"release_date\": \"2022-01-20\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (24)\",\n        \"Watercolor Paper Pad (20 sheets)\",\n        \"Paintbrushes (2)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"tube\",\n        \"paper_weight\": \"100lb\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--71262", "text": "{\n    \"product_id\": \"WN-PROF-24-WC\",\n    \"product_name\": \"Winsor & Newton Professional Watercolor Paint Set - 24 Half Pans\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 89.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, highly pigmented and blend beautifully.\",\n            \"reviewer_name\": \"ArtEnthusiast\"\n        },\n        {\n            \"review_text\": \"A fantastic set for serious watercolor artists. The colors are vibrant and lightfast.\",\n            \"reviewer_name\": \"ProfessionalArtist\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"pan_size\": \"Half Pan\",\n        \"lightfastness\": \"Excellent\"\n    },\n    \"color_options\": [\n        \"Primary Colors\",\n        \"Secondary Colors\",\n        \"Earth Tones\"\n    ],\n    \"set_includes\": [\n        \"24 Half Pans of Watercolor Paint\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"Intermediate to Professional\"\n}"}
