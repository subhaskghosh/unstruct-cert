{"_id": "product_search--art_and_craft_su--p--68855", "text": "{\n    \"product_id\": \"WCS-001\",\n    \"product_name\": \"Artist's Choice Watercolor Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality watercolors, perfect for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great set for the price. I'm learning watercolor and this set has everything I need.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Plastic Palette\",\n        \"included_brush\": true\n    },\n    \"color_options\": [\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Lemon Yellow\",\n        \"Viridian\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brush\",\n        \"Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
