{"_id": "product_search--art_and_craft_su--p--68875", "text": "{\n    \"product_id\": \"WC-24-Nature\",\n    \"product_name\": \"Nature's Palette Watercolor Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and the included brush is surprisingly good quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set! She's just starting to learn watercolor and this has everything she needs.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Olive Green\",\n        \"Sky Blue\",\n        \"Lemon Yellow\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Violet\",\n        \"Peach\",\n        \"Magenta\",\n        \"Turquoise\",\n        \"Lavender\",\n        \"Coral\",\n        \"Rose\",\n        \"Teal\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Water Cup\",\n        \"Mixing Tray\",\n        \"Instruction Booklet\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"theme\": \"nature\",\n        \"portability\": \"portable\"\n    }\n}"}
