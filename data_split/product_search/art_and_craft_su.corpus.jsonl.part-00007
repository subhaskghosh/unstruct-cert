{"_id": "product_search--art_and_craft_su--p--70802", "text": "{\n    \"product_id\": \"WC-24-BGN-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning watercolors! The colors blend beautifully and the price is excellent.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"As a beginner, this set has everything I need to start painting. The colors are vibrant.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Forest Green\",\n        \"Burnt Orange\",\n        \"Violet\",\n        \"Sepia\",\n        \"Ivory\",\n        \"Magenta\",\n        \"Gold\",\n        \"Silver\",\n        \"Peach\",\n        \"Lavender\",\n        \"Teal\",\n        \"Olive\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"number_of_colors\": 24\n    }\n}"}
