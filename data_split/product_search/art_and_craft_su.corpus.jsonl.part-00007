{"_id": "product_search--art_and_craft_su--p--71710", "text": "{\n    \"product_id\": \"WC-24-BOT-ARTIST\",\n    \"product_name\": \"Artist's Watercolor Paint Set - Botanical Edition\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 42.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend beautifully. Perfect for my botanical paintings.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the money. The paints have a good consistency and don't dry out too fast.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Viridian\",\n        \"Burnt Sienna\",\n        \"Ultramarine\",\n        \"Raw Umber\",\n        \"Ivory Black\",\n        \"and 16 more\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"drying_time\": \"moderate\"\n    }\n}"}
