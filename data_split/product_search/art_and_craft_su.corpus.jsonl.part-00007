{"_id": "product_search--art_and_craft_su--n--70092", "text": "{\n    \"product_id\": \"WC-12-PRO-B\",\n    \"product_name\": \"Professional Watercolor Paint Set - 12 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good quality paints, but the colors are a little muted.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"Excellent for detailed work. Colors are quite subtle.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Metal\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (12)\",\n        \"Paint Brush (3)\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
