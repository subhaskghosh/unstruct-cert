{"_id": "product_search--art_and_craft_su--p--71804", "text": "{\n    \"product_id\": \"WN-WC-BS-12\",\n    \"product_name\": \"Winsor & Newton Cotman Water Colour Paint Sketchers' Pocket Box\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. Perfect for landscape painting.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I'm new to watercolor and this set has everything I need.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2021-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 12,\n        \"set_type\": \"Pocket Box\"\n    },\n    \"color_options\": [\n        \"Cadmium Yellow Pale\",\n        \"Lemon Yellow\",\n        \"Cadmium Red Pale\",\n        \"Crimson Alizarin\",\n        \"Ultramarine\",\n        \"Cobalt Blue\",\n        \"Viridian\",\n        \"Sap Green\",\n        \"Yellow Ochre\",\n        \"Burnt Sienna\",\n        \"Burnt Umber\",\n        \"Chinese White\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Water Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71804", "text": "{\n    \"product_id\": \"AR-WC-PS-24\",\n    \"product_name\": \"Arteza Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 49.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"The colors are nice, but the paint tends to be chalky when dry.\",\n            \"reviewer_name\": \"Jessica Brown\"\n        },\n        {\n            \"review_text\": \"Good variety of colors, but not the highest quality.\",\n            \"reviewer_name\": \"Michael Davis\"\n        }\n    ],\n    \"release_date\": \"2022-07-20\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"set_type\": \"Professional Set\"\n    },\n    \"color_options\": [\n        \"Lemon Yellow\",\n        \"Cadmium Yellow Medium\",\n        \"Orange\",\n        \"Crimson\",\n        \"Purple\",\n        \"Blue\",\n        \"Green\",\n        \"Black\",\n        \"White\",\n        \"and 16 more colors\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush Pens\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
