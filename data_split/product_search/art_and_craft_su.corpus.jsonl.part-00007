{"_id": "product_search--art_and_craft_su--p--67822", "text": "{\n    \"product_id\": \"WCS-24-BRNDX\",\n    \"product_name\": \"BrndX Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"BrndX\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. It really sparked my creativity.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. The paints are good quality and the variety of colors is fantastic.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Complete Set\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Paints\",\n        \"Brushes\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
