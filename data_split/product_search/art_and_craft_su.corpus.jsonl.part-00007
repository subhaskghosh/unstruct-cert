{"_id": "product_search--art_and_craft_su--p--71540", "text": "{\n    \"product_id\": \"WCS-24VT-BGN\",\n    \"product_name\": \"Vibrant Watercolor Paint Set for Beginners\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are very vibrant and blend easily. Great value for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. The paints are non-toxic and easy to use.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Violet\",\n            \"Indigo\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Brush\",\n            \"Palette\",\n            \"Water Cup\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"non_toxic\": true,\n        \"blendability\": \"high\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Violet\",\n        \"Indigo\",\n        \"Turquoise\",\n        \"Magenta\",\n        \"Peach\",\n        \"Olive\",\n        \"Sky Blue\",\n        \"Lavender\",\n        \"Lemon Yellow\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Cerulean Blue\",\n        \"Rose Madder\"\n    ]\n}"}
