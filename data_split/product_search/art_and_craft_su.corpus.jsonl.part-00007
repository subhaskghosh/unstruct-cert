{"_id": "product_search--art_and_craft_su--p--70344", "text": "{\n    \"product_id\": \"VG-WATER-12\",\n    \"product_name\": \"Van Gogh Watercolor Paint Set - 12 Colors\",\n    \"brand\": \"Van Gogh\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is wonderful for beginners. The colors are vibrant and easy to blend. It really sparks creativity!\",\n            \"reviewer_name\": \"ArtLover22\"\n        },\n        {\n            \"review_text\": \"Great quality for the price. Perfect for learning watercolor techniques.\",\n            \"reviewer_name\": \"WatercolorNewbie\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Palette Set\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Violet\",\n        \"Brown\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
