{"_id": "product_search--art_and_craft_su--p--70399", "text": "{\n    \"product_id\": \"WP-48-ART\",\n    \"product_name\": \"Artist's Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. The packaging is also lovely.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I bought this set to start painting landscapes, and I'm very happy with it. The pigment quality is excellent.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Yellow Ochre\",\n        \"Burnt Sienna\",\n        \"Viridian\",\n        \"Payne's Gray\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Raw Umber\",\n        \"Alizarin Crimson\",\n        \"Cobalt Blue\",\n        \"Cadmium Yellow\",\n        \"Burnt Umber\",\n        \"Sap Green\",\n        \"Ivory Black\",\n        \"Prussian Blue\",\n        \"Cadmium Red\",\n        \"Permanent Rose\",\n        \"Hooker's Green\",\n        \"Neutral Tint\",\n        \"Orange\",\n        \"Violet\",\n        \"Purple\",\n        \"Brown\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Tubes\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad (30 sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paper_weight\": \"140lb\"\n    }\n}"}
