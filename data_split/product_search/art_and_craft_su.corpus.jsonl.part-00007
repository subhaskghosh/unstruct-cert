{"_id": "product_search--art_and_craft_su--p--67831", "text": "{\n    \"product_id\": \"WC-SET-24-BGNR-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set to start with! The colors blend well and are very vibrant. Perfect for relaxing painting sessions.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"As a beginner, I found this set very easy to use.  The included brush is decent too.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"set_includes\": [\n            \"Paint Pans\",\n            \"Brush\",\n            \"Mixing Palette\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Violet\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Cerulean Blue\",\n        \"Ultramarine Blue\",\n        \"Lemon Yellow\",\n        \"Cadmium Yellow\",\n        \"Alizarin Crimson\",\n        \"Viridian\",\n        \"Phthalo Blue\",\n        \"Sepia\",\n        \"Payne's Gray\"\n    ],\n    \"set_includes\": [\n        \"Paint Pans\",\n        \"Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
