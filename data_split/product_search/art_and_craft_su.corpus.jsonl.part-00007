{"_id": "product_search--art_and_craft_su--p--67445", "text": "{\n    \"product_id\": \"WCSET-001\",\n    \"product_name\": \"Artist's Essentials Watercolor Paint Set\",\n    \"brand\": \"CreativeFlow\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is fantastic for beginners! The colors are vibrant and blend beautifully.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great quality for the price. My daughter loves it!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"pan\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Emerald\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paint brush\",\n        \"Mixing palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
