{"_id": "product_search--art_and_craft_su--p--70158", "text": "{\n    \"product_id\": \"WC-24-NAT-BG\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Nature Inspired\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning watercolor! The colors are vibrant and blend well. The nature theme is a nice touch.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Perfect for beginners. I love painting landscapes with these!\",\n            \"reviewer_name\": \"John S.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Olive Green\",\n        \"Sky Blue\",\n        \"Burnt Sienna\",\n        \"Violet\",\n        \"Peach\",\n        \"Indigo\",\n        \"Magenta\",\n        \"Gold\",\n        \"Silver\",\n        \"Lemon Yellow\",\n        \"Forest Green\",\n        \"Turquoise\",\n        \"Umber\",\n        \"Coral\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"Plastic\"\n    }\n}"}
