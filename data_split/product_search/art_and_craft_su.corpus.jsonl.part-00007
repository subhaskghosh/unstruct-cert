{"_id": "product_search--art_and_craft_su--p--68415", "text": "{\n    \"product_id\": \"WPS-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Vibrant Landscapes\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set. It's perfect for learning watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Burnt Sienna\",\n        \"Violet\",\n        \"Raw Umber\",\n        \"Ivory\",\n        \"Magenta\",\n        \"Cadmium Red\",\n        \"Gold\",\n        \"Silver\",\n        \"Turquoise\",\n        \"Peach\",\n        \"Lavender\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paintbrush (Round - Size 6)\",\n        \"Paintbrush (Flat - Size 8)\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad (12 Sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"paper_weight\": \"140lb\",\n        \"number_of_colors\": 24\n    }\n}"}
