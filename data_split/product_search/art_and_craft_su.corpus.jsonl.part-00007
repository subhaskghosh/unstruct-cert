{"_id": "product_search--art_and_craft_su--p--71677", "text": "{\n    \"product_id\": \"AW-12-LND-001\",\n    \"product_name\": \"Arteza Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. I've created some stunning landscapes with it.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. The paints are highly pigmented and the set includes everything you need to get started.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Landscape\",\n        \"palette_type\": \"Pan\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Violet\",\n        \"Magenta\",\n        \"Cyan\",\n        \"Olive Green\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
