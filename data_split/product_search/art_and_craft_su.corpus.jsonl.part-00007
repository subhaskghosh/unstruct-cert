{"_id": "product_search--art_and_craft_su--n--71335", "text": "{\n    \"product_id\": \"WCSET-202\",\n    \"product_name\": \"Professional Watercolor Studio Set\",\n    \"brand\": \"Prismacolor\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 55.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"High-quality pigments, but quite expensive.\",\n            \"reviewer_name\": \"David Lee\"\n        },\n        {\n            \"review_text\": \"Great for serious artists, but not ideal for beginners.\",\n            \"reviewer_name\": \"Sarah Jones\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"Fixed Palette\",\n        \"brush_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71336", "text": "{\n    \"product_id\": \"WP-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! The colors are vibrant and easy to blend, perfect for landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. My daughter loves painting with these!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Magenta\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Violet\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Cerulean Blue\",\n        \"Ultramarine Blue\",\n        \"Viridian\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Alizarin Crimson\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush (Round)\",\n        \"Paint Brush (Flat)\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad (12 sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71336", "text": "{\n    \"product_id\": \"WP-12-BG-002\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Basic Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"A good basic set for kids.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"Colors are a bit pale.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Pink\",\n        \"Gray\",\n        \"Violet\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Paint Brush (Round)\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--71337", "text": "{\n    \"product_id\": \"WP-24-BAS-ART\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Artist Quality\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is fantastic for beginners! The colors are vibrant and blend beautifully. I've been able to create some really expressive paintings with this set.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great quality for the price.  A good starting point for anyone wanting to learn watercolor.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Black\",\n            \"White\",\n            \"Brown\",\n            \"Crimson\",\n            \"Violet\",\n            \"Indigo\",\n            \"Turquoise\",\n            \"Lime\",\n            \"Peach\",\n            \"Gold\",\n            \"Silver\",\n            \"Pink\",\n            \"Lavender\",\n            \"Teal\",\n            \"Coral\",\n            \"Magenta\",\n            \"Olive\",\n            \"Burnt Sienna\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Brush\",\n            \"Mixing Palette\",\n            \"Water Brush Pen\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"paint_type\": \"watercolor\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Paint\",\n        \"Brush\",\n        \"Palette\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--n--71337", "text": "{\n    \"product_id\": \"WP-12-CRAY-KID\",\n    \"product_name\": \"Crayola Kids' Watercolor Paint Set\",\n    \"brand\": \"Crayola\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for kids, but the colors are a little dull.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"A basic set, suitable for simple projects.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\"\n        ],\n        \"set_includes\": [\n            \"12 Watercolor Paints\",\n            \"Brush\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"paint_type\": \"watercolor\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\"\n    ],\n    \"set_includes\": [\n        \"Paint\",\n        \"Brush\"\n    ]\n}"}
