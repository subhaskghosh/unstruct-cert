{"_id": "product_search--art_and_craft_su--p--70604", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"The paints are vibrant and easy to blend. Perfect for landscapes.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Crimson\",\n        \"Violet\",\n        \"Indigo\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Ultramarine Blue\",\n        \"Cerulean Blue\",\n        \"Viridian\",\n        \"Permanent Rose\",\n        \"Cobalt Blue\",\n        \"Sepia\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
