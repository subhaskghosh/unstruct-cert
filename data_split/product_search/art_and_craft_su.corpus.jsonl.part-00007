{"_id": "product_search--art_and_craft_su--p--70654", "text": "{\n    \"product_id\": \"AWCS24-ARTZ-INSPIRE\",\n    \"product_name\": \"Arteza Watercolor Paint Set - Inspiration Collection\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 27.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Fantastic set for beginners! The colors are vibrant and blend beautifully. It feels much more premium than other starter sets.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set. It's perfect for someone exploring watercolor for the first time.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Crimson\",\n            \"Lemon Yellow\",\n            \"Phthalo Blue\",\n            \"Burnt Sienna\",\n            \"Ivory Black\",\n            \"and 20 more...\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Mixing Palette\",\n            \"Water Brush Pen\"\n        ],\n        \"skill_level\": \"Beginner\",\n        \"paint_type\": \"Pan\"\n    },\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Phthalo Blue\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"Violet\",\n        \"Orange\",\n        \"Green\",\n        \"Brown\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ]\n}"}
