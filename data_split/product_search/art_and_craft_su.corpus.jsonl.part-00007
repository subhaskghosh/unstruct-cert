{"_id": "product_search--art_and_craft_su--n--67737", "text": "{\n    \"product_id\": \"WC-12-A-002\",\n    \"product_name\": \"Student Watercolor Paint Set - 12 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Decent set for the price, but the colors are a bit muted.\",\n            \"reviewer_name\": \"Jessica Lee\"\n        },\n        {\n            \"review_text\": \"Good for practice, but not professional quality.\",\n            \"reviewer_name\": \"David Brown\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Set\",\n        \"palette_type\": \"Plastic\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brushes (2)\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--p--67738", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners like me! The colors are vibrant and blend easily. It's a very relaxing hobby.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Great value for the price. I found watercolor painting to be incredibly calming with this set.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Pan\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Magenta\",\n        \"Violet\",\n        \"Teal\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Indigo\",\n        \"Peach\",\n        \"Lavender\",\n        \"Sky Blue\",\n        \"Forest Green\",\n        \"Coral\",\n        \"Gold\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Pans\",\n        \"Paintbrush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--67738", "text": "{\n    \"product_id\": \"WC-SET-202\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.0,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, perfect for advanced techniques.\",\n            \"reviewer_name\": \"Emily Chen\"\n        },\n        {\n            \"review_text\": \"These paints are a joy to work with. The pigmentation is fantastic.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"Tube\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Magenta\",\n        \"Violet\",\n        \"Teal\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Indigo\",\n        \"Peach\",\n        \"Lavender\",\n        \"Sky Blue\",\n        \"Forest Green\",\n        \"Coral\",\n        \"Gold\",\n        \"Sepia\",\n        \"Cobalt Blue\",\n        \"Cerulean Blue\",\n        \"Viridian\",\n        \"Alizarin Crimson\",\n        \"Quinacridone Rose\",\n        \"Permanent Yellow\",\n        \"Ultramarine Violet\",\n        \"Dioxazine Violet\",\n        \"Burnt Umber\",\n        \"Yellow Ochre\",\n        \"Raw Sienna\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Tubes\",\n        \"Professional Brushes\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--67739", "text": "{\n    \"product_id\": \"WPS-12345\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"CreativeFlow\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great quality paints for the price. I've been using it to paint landscapes and am very happy.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Burnt Sienna\",\n        \"Viridian Green\",\n        \"Violet\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Pink\",\n        \"Brown\",\n        \"Indigo\",\n        \"Olive Green\",\n        \"Turquoise\",\n        \"Magenta\",\n        \"Coral\",\n        \"Lavender\",\n        \"Peach\",\n        \"Gold\",\n        \"Silver\",\n        \"Grey\",\n        \"Teal\",\n        \"Lime Green\",\n        \"Sky Blue\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paintbrush\",\n        \"Mixing Palette\",\n        \"Water Brush\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"paper_weight\": \"140lb\"\n    }\n}"}
