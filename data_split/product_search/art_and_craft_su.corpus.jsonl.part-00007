{"_id": "product_search--art_and_craft_su--p--68085", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Vibrant Hues\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are bright and blend well. I love the included brush.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Perfect for getting started with watercolor. The price is excellent for the quality.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Magenta\",\n        \"Violet\",\n        \"Teal\",\n        \"Olive\",\n        \"Peach\",\n        \"Lavender\",\n        \"Turquoise\",\n        \"Gold\",\n        \"Silver\",\n        \"Coral\",\n        \"Sky Blue\",\n        \"Lemon Yellow\",\n        \"Forest Green\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"1 Watercolor Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"suitable_for\": \"children & adults\"\n    }\n}"}
