{"_id": "product_search--art_and_craft_su--p--68305", "text": "{\n    \"product_id\": \"WCSET-101\",\n    \"product_name\": \"Premium Watercolor Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! Perfect for beginners and experienced artists alike. Colors are vibrant and blend beautifully.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"This set has everything a beginner needs to get started with watercolor painting. Highly recommend!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"Pan\",\n        \"included_brush\": true,\n        \"palette_type\": \"Plastic\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor pans\",\n        \"Brush\",\n        \"Mixing palette\",\n        \"Water brush\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
