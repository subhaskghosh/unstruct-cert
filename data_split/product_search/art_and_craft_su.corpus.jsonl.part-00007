{"_id": "product_search--art_and_craft_su--p--68064", "text": "{\n    \"product_id\": \"WC-24-BEGIN-LAND-01\",\n    \"product_name\": \"Beginner Watercolor Landscape Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great starter set! The colors are very vibrant and blend well. Perfect for landscapes.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. My daughter loves painting landscapes with this set.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"paper_included\": false,\n        \"brush_included\": true\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Viridian\",\n        \"Burnt Sienna\",\n        \"Raw Sienna\",\n        \"Ultramarine\",\n        \"Indigo\",\n        \"Magenta\",\n        \"Peach\",\n        \"Lavender\",\n        \"Olive Green\",\n        \"Terracotta\",\n        \"Cobalt Blue\",\n        \"Payne's Gray\",\n        \"Sepia\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paint brush\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
