{"_id": "product_search--art_and_craft_su--p--71994", "text": "{\n    \"product_id\": \"PAINT-SET-001\",\n    \"product_name\": \"Acrylic Painting Set for Beginners\",\n    \"brand\": \"Artify\",\n    \"category\": \"Painting Sets\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning acrylics! The colors are bright and the brushes are decent quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. My daughter loves it!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_types\": [\n            \"Acrylic\"\n        ],\n        \"number_of_colors\": 12,\n        \"brush_count\": 8,\n        \"canvas_size\": \"8x10 inches\",\n        \"style\": \"Modern\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Pink\",\n        \"Turquoise\",\n        \"Gold\"\n    ],\n    \"set_includes\": [\n        \"Acrylic Paints\",\n        \"Paint Brushes\",\n        \"Palette\",\n        \"Canvas\",\n        \"Palette Knife\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
