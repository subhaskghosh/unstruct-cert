{"_id": "product_search--art_and_craft_su--p--70809", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Landscape Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set to start with! The colors are vibrant and the brushes are decent quality.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Perfect for learning landscapes. The included guide is very helpful.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Olive Green\",\n        \"Sky Blue\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Violet\",\n        \"Indigo\",\n        \"Magenta\",\n        \"Peach\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Phthalo Blue\",\n        \"Sap Green\",\n        \"Gold Ochre\",\n        \"Payne's Gray\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"3 Paint Brushes\",\n        \"Palette\",\n        \"Watercolor Paper Pad (12 sheets)\",\n        \"Instruction Guide\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paper_weight\": \"140lb\"\n    }\n}"}
