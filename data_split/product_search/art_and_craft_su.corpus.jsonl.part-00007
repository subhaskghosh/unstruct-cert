{"_id": "product_search--art_and_craft_su--p--71303", "text": "{\n    \"product_id\": \"PAINTS123\",\n    \"product_name\": \"Artist's Choice Beginner Acrylic Paint Set\",\n    \"brand\": \"Creative Canvas\",\n    \"category\": \"Painting Sets\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and brushes to get started.\",\n            \"reviewer_name\": \"ArtLover78\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set. The colors are really vibrant and the acrylics are easy to work with.\",\n            \"reviewer_name\": \"HappyMom22\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_types\": [\n            \"Acrylic\"\n        ],\n        \"brush_count\": 15,\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"White\",\n            \"Black\",\n            \"Orange\",\n            \"Purple\"\n        ]\n    },\n    \"skill_level\": \"beginner\",\n    \"set_includes\": [\n        \"Acrylic Paints\",\n        \"Paint Brushes\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ]\n}"}
