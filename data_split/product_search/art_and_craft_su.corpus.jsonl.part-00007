{"_id": "product_search--art_and_craft_su--p--70749", "text": "{\n    \"product_id\": \"WS-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Painting Sets\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for someone starting out with watercolors. The colors are vibrant, and the brushes are decent quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set! It's helped her explore her creative side.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"brush_types\": [\n            \"Round\",\n            \"Flat\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Brushes\",\n        \"Palette\",\n        \"Watercolor paper pad\"\n    ]\n}"}
