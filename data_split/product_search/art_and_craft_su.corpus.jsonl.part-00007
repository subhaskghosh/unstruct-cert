{"_id": "product_search--art_and_craft_su--p--70820", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for learning watercolor! Colors are bright and easy to blend.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. A perfect starting point for beginners.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Black\",\n            \"White\",\n            \"Brown\",\n            \"Crimson\",\n            \"Violet\",\n            \"Turquoise\",\n            \"Magenta\",\n            \"Olive Green\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Payne's Gray\",\n            \"Lemon Yellow\",\n            \"Cadmium Red\",\n            \"Ultramarine Blue\",\n            \"Phthalo Green\",\n            \"Cadmium Yellow\",\n            \"Alizarin Crimson\",\n            \"Cerulean Blue\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"number_of_colors\": 24\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Paints\",\n        \"Brush\",\n        \"Palette\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--n--70820", "text": "{\n    \"product_id\": \"WC-SET-102\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"High quality paints, perfect for experienced artists.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"The colors are incredibly vibrant and the pigment is very strong.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2023-08-20\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Black\",\n            \"White\",\n            \"Brown\"\n        ],\n        \"set_includes\": [\n            \"12 Watercolor Paints\",\n            \"2 Watercolor Brushes\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"skill_level\": \"intermediate\",\n        \"number_of_colors\": 12\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\"\n    ],\n    \"set_includes\": [\n        \"Paints\",\n        \"Brush\",\n        \"Palette\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--p--70821", "text": "{\n    \"product_id\": \"WCS-123\",\n    \"product_name\": \"Artist's Choice Watercolor Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is fantastic for beginners! The colors are vibrant and blend beautifully. It really inspired me to start painting.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Great quality watercolors for the price. Lots of useful colors included.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"set_includes\": [\n            \"Palette\",\n            \"Brushes (3)\",\n            \"Watercolor Paper Pad (10 sheets)\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Palette\",\n        \"Brushes\",\n        \"Watercolor Paper\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
