{"_id": "product_search--art_and_craft_su--p--71422", "text": "{\n    \"product_id\": \"APSET-2023-01\",\n    \"product_name\": \"Acrylic Paint Set - Vibrant Landscapes\",\n    \"brand\": \"Artify\",\n    \"category\": \"Acrylic Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set of colors for landscapes! The paint is creamy and has excellent pigment.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Perfect for beginners. Everything you need to get started.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_volume\": \"22ml per tube\",\n        \"palette_knife_included\": true\n    },\n    \"color_options\": [\n        \"Titanium White\",\n        \"Lemon Yellow\",\n        \"Cadmium Yellow\",\n        \"Orange\",\n        \"Crimson Red\",\n        \"Purple\",\n        \"Ultramarine Blue\",\n        \"Phthalo Blue\",\n        \"Emerald Green\",\n        \"Sap Green\",\n        \"Burnt Sienna\",\n        \"Burnt Umber\",\n        \"Black\"\n    ],\n    \"set_includes\": [\n        \"24 Acrylic Paints\",\n        \"Palette Knife\",\n        \"Paint Brush Set (5 brushes)\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
