{"_id": "product_search--art_and_craft_su--p--70861", "text": "{\n    \"product_id\": \"WC-24-BEGINNER-LAND\",\n    \"product_name\": \"Beginner Watercolor Landscape Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for starting out with watercolors! The colors are vibrant and blend well. The landscape tutorials included are a great bonus.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for her beginner landscape painting hobby.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Phthalo Blue\",\n        \"Viridian\",\n        \"Olive Green\",\n        \"Burnt Umber\",\n        \"Indigo\",\n        \"Cerulean Blue\",\n        \"Alizarin Crimson\",\n        \"Yellow Ochre\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paintbrushes (Round, Flat, Liner)\",\n        \"Watercolor Paper Pad\",\n        \"Mixing Palette\",\n        \"Landscape Painting Tutorial\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"paper_weight\": \"140lb\",\n        \"number_of_colors\": 24\n    }\n}"}
