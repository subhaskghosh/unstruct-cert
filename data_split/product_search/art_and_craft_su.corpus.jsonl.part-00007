{"_id": "product_search--art_and_craft_su--p--68467", "text": "{\n    \"product_id\": \"WP-24-BL\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! The colors are vibrant and blend well. Perfect for landscape painting.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. My daughter (an adult beginner) loves it!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Olive Green\",\n        \"Sky Blue\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Violet\",\n        \"Magenta\",\n        \"Cerulean Blue\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Phthalo Green\",\n        \"Alizarin Crimson\",\n        \"Ultramarine Blue\",\n        \"Viridian\",\n        \"Payne's Gray\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"plastic\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--68467", "text": "{\n    \"product_id\": \"WC-12-KD\",\n    \"product_name\": \"Kids' First Watercolor Set\",\n    \"brand\": \"FunCraft\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"My kids had a blast with this set! Easy to use and clean up.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"Good for little ones learning to paint.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2023-01-20\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Pink\",\n        \"Gray\",\n        \"Light Blue\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"child\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12,\n        \"palette_type\": \"plastic\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--68468", "text": "{\n    \"product_id\": \"WPS-007\",\n    \"product_name\": \"Arteza Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for relaxing and painting landscapes. Highly recommend!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Complete Set\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paintbrushes\",\n        \"Watercolor Paper\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
