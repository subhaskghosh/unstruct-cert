{"_id": "product_search--art_and_craft_su--p--70810", "text": "{\n    \"product_id\": \"AP-2024-12C\",\n    \"product_name\": \"Arteza Acrylic Paint Set, 12 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Acrylic Paint\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and mix well.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. Highly recommend for anyone starting out with acrylics.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Acrylic\",\n        \"number_of_colors\": 12,\n        \"paint_volume_per_color\": \"0.74 fl oz\",\n        \"surface_compatibility\": [\n            \"Canvas\",\n            \"Wood\",\n            \"Paper\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Pink\",\n        \"Turquoise\",\n        \"Gold\"\n    ],\n    \"set_includes\": [\n        \"12 Acrylic Paints\",\n        \"Paint Brush\",\n        \"Palette Knife\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
