{"_id": "product_search--art_and_craft_su--p--71159", "text": "{\n    \"product_id\": \"WC-12-BGT-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend easily. The included brush is decent quality too.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. I'm new to watercolor and this set has everything I need to get started.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad (10 sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12,\n        \"paper_weight\": \"140lb\"\n    }\n}"}
