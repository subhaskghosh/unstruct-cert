{"_id": "product_search--art_and_craft_su--p--70246", "text": "{\n    \"product_name\": \"Arteza Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skill_level\": \"beginner\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Violet\",\n        \"Burnt Orange\",\n        \"Raw Umber\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Cadmium Red\",\n        \"Cadmium Yellow\",\n        \"Ultramarine Blue\",\n        \"Viridian Green\",\n        \"Dioxazine Violet\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"product_id\": \"AWP-24-ARTEZA\",\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    },\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and easy to blend.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I love the included brush and palette.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ]\n}"}
