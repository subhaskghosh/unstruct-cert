{"_id": "product_search--art_and_craft_su--n--71937", "text": "{\n    \"product_id\": \"WC-GLIT-202\",\n    \"product_name\": \"Sparkling Watercolor Paint Set - 12 Colors\",\n    \"brand\": \"Rainbow Dreams\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Fun and sparkly! Perfect for kids' crafts.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"My niece loved this set. The glitter adds a nice touch.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Plastic\",\n        \"includes_brush\": true,\n        \"glitter\": true\n    },\n    \"color_options\": [\n        \"Pink\",\n        \"Silver\",\n        \"Gold\",\n        \"Purple\",\n        \"Blue\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Paint Pans\",\n        \"Watercolor Brush\",\n        \"Glitter Powder\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71938", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Artify Watercolor Paint Set - Beginner's Dream\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Colors are vibrant and blend well.  The included brush is decent quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Highly recommend for anyone starting with watercolor.  Good value for the price.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"pan\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Olive\",\n        \"Sky Blue\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Pans\",\n        \"1 Synthetic Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--71938", "text": "{\n    \"product_id\": \"WC-SET-202\",\n    \"product_name\": \"Kids First Watercolor Set\",\n    \"brand\": \"ColorFun\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 9.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for kids, but the colors are a bit pale.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"My daughter loves it, but not artist quality.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-08-01\",\n    \"attributes\": {\n        \"number_of_colors\": 8,\n        \"paint_type\": \"cake\",\n        \"paper_included\": true\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\"\n    ],\n    \"set_includes\": [\n        \"8 Watercolor Cakes\",\n        \"1 Brush\",\n        \"10 Sheets of Paper\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
