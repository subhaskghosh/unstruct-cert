{"_id": "product_search--art_and_craft_su--p--70569", "text": "{\n    \"product_id\": \"WC-24-BGN-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. The price is excellent for the quality.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I'm new to watercolor and this set has been perfect. Lots of colors to experiment with and easy to use.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Pan\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor pans\",\n        \"Watercolor brush\",\n        \"Mixing palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
