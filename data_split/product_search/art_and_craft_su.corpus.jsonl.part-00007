{"_id": "product_search--art_and_craft_su--p--71841", "text": "{\n    \"product_id\": \"WC-24-PR-BG\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 42.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints for the price! The colors are vibrant and blend well. Perfect for beginners wanting to try watercolor.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I'm a hobbyist artist and these paints are great. The pigment load is impressive.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Magenta\",\n        \"Violet\",\n        \"Indigo\",\n        \"Turquoise\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Ultramarine Blue\",\n        \"Phthalo Green\",\n        \"Alizarin Crimson\",\n        \"Prussian Blue\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\",\n        \"Instruction Booklet\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"pigment_concentration\": \"high\"\n    }\n}"}
