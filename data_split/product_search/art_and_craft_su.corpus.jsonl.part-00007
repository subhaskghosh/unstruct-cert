{"_id": "product_search--art_and_craft_su--p--70607", "text": "{\n    \"product_id\": \"AWP-24-CALM-ARTEZA\",\n    \"product_name\": \"Arteza Watercolor Paint Set - Calming Tones\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Lovely colors and great for beginners! Really helps with relaxing painting sessions.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price.  The colors blend beautifully.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Pan Set\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Pans\",\n        \"Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--70607", "text": "{\n    \"product_id\": \"AWP-12-VIBRANT-ARTEZA\",\n    \"product_name\": \"Arteza Watercolor Paint Set - Vibrant Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 22.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for vibrant paintings! A bit too intense for subtle work.\",\n            \"reviewer_name\": \"Alice Brown\"\n        }\n    ],\n    \"release_date\": \"2019-11-01\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Tube Set\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Tubes\",\n        \"Brush\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--p--70608", "text": "{\n    \"product_id\": \"WCS-24-INSPIRE\",\n    \"product_name\": \"Inspire Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I love the variety of colors, perfect for landscapes and portraits.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean Blue\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Viridian\",\n        \"Indigo\",\n        \"Magenta\",\n        \"Gold Ochre\",\n        \"Payne's Gray\",\n        \"Violet\",\n        \"Peach\",\n        \"Lavender\",\n        \"Turquoise\",\n        \"Olive Green\",\n        \"Rust\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paint_form\": \"pan\"\n    }\n}"}
