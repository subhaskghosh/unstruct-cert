{"_id": "product_search--art_and_craft_su--p--71704", "text": "{\n    \"product_id\": \"WC-LS-24-BG\",\n    \"product_name\": \"Beginner Watercolor Landscape Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for starting out! The colors are beautiful and blend well. I've been painting landscapes for a few weeks now and I'm very happy with the quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. The paints are vibrant and a good range of colors. Highly recommend for beginners.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Mixing Palette\",\n            \"Watercolor Paper Pad (12 sheets)\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"paint_type\": \"watercolor\",\n        \"palette_type\": \"plastic\"\n    },\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Ultramarine\",\n        \"Sap Green\",\n        \"Violet\",\n        \"Burnt Orange\",\n        \"Raw Sienna\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Cerulean Blue\",\n        \"Viridian\",\n        \"Alizarin Crimson\",\n        \"Cadmium Yellow\",\n        \"Phthalo Blue\",\n        \"Payne's Gray\",\n        \"Burnt Umber\",\n        \"Yellow Ochre\",\n        \"Prussian Blue\",\n        \"Emerald Green\",\n        \"Dioxazine Violet\",\n        \"Cadmium Red\",\n        \"Indian Yellow\",\n        \"Indigo\",\n        \"Olive Green\"\n    ]\n}"}
