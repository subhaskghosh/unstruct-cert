{"_id": "product_search--art_and_craft_su--p--68873", "text": "{\n    \"product_id\": \"WC-SET-PRO-24\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! The colors are vibrant and blend beautifully. Perfect for a budding artist.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Really impressed with this set. It's a step up from student grade and worth the price.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"pan\",\n        \"lightfastness\": \"high\",\n        \"quality_level\": \"artist\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints (24)\",\n        \"Watercolor brush\",\n        \"Mixing palette\",\n        \"Water brush pen\"\n    ],\n    \"skill_level\": \"beginner to intermediate\"\n}"}
