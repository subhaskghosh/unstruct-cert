{"_id": "product_search--art_and_craft_su--p--71857", "text": "{\n    \"product_id\": \"WCS-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Castle Arts\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set! It's a great way to start learning watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Olive Green\",\n        \"Violet\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Cerulean Blue\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Phthalo Blue\",\n        \"Sap Green\",\n        \"Magenta\",\n        \"Peach\",\n        \"Sky Blue\",\n        \"Lavender\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"3 Paint Brushes\",\n        \"Palette\",\n        \"Mixing Tray\",\n        \"Instruction Booklet\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"brush_type\": \"synthetic\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71857", "text": "{\n    \"product_id\": \"ART-202\",\n    \"product_name\": \"Arteza Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 25.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good value for the price, but the paints are a bit watery.\",\n            \"reviewer_name\": \"Jessica Brown\"\n        },\n        {\n            \"review_text\": \"A decent starter set, but not the highest quality.\",\n            \"reviewer_name\": \"Michael Davis\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"18 Watercolor Paints\",\n        \"2 Paint Brushes\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 18,\n        \"brush_type\": \"synthetic\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--71858", "text": "{\n    \"product_id\": \"WC-24-STR-001\",\n    \"product_name\": \"Student Watercolor Paint Set\",\n    \"brand\": \"Prismacolor\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. Excellent value for the price.\",\n            \"reviewer_name\": \"ArtEnthusiast\"\n        },\n        {\n            \"review_text\": \"I bought this set to start learning watercolor and it's perfect! The colors are lovely and the quality is good for the price.\",\n            \"reviewer_name\": \"NewArtist\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"and 19 more...\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Round Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
