{"_id": "product_search--art_and_craft_su--p--71355", "text": "{\n    \"product_name\": \"Arteza Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Colors blend easily and the quality is surprisingly good for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I love the variety of colors and how smoothly they apply. Very happy with this purchase.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-08-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Phthalo Blue\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"Viridian\",\n        \"Ultramarine\",\n        \"Purple\",\n        \"Orange\",\n        \"Pink\",\n        \"Green\",\n        \"Brown\",\n        \"White\",\n        \"Gray\",\n        \"Yellow Ochre\",\n        \"Raw Umber\",\n        \"Cobalt Blue\",\n        \"Cerulean Blue\",\n        \"Indigo\",\n        \"Magenta\",\n        \"Scarlet\",\n        \"Lavender\",\n        \"Peach\",\n        \"Olive Green\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"product_id\": \"AWP-24-001\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"portability\": \"Portable\"\n    }\n}"}
