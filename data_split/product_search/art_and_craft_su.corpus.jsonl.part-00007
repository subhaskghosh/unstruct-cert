{"_id": "product_search--art_and_craft_su--p--68077", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Emily S.\"\n        },\n        {\n            \"review_text\": \"Excellent value for the money. Perfect for relaxing and painting.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"skill_level\": \"beginner\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Violet\",\n        \"Turquoise\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Paintbrush\",\n        \"Mixing Palette\"\n    ],\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"set_size\": \"12 colors\"\n    }\n}"}
