{"_id": "product_search--art_and_craft_su--n--70296", "text": "{\n    \"product_id\": \"A67890\",\n    \"product_name\": \"Arteza Gouache Paint Set - Professional\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Gouache Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality gouache paints. Highly pigmented and blend beautifully.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"A must-have for serious gouache artists.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"paint_type\": \"Gouache\",\n        \"number_of_colors\": 15,\n        \"set_includes\": [\n            \"Gouache paints\",\n            \"Blending brushes\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Violet\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\"\n    ],\n    \"set_includes\": [\n        \"Gouache Paints\",\n        \"Brushes\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--70297", "text": "{\n    \"product_id\": \"WC-24-LWN-LS\",\n    \"product_name\": \"Winsor & Newton Cotman Water Colour Paint Sketchers' Pocket Box - Landscape\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 42.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great little set for beginners. The colors are vibrant and mix well. Perfect for plein air painting!\",\n            \"reviewer_name\": \"ArtLover78\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I especially like the landscape color palette.\",\n            \"reviewer_name\": \"WatercolorFan\"\n        }\n    ],\n    \"release_date\": \"2021-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Pocket Box\",\n        \"theme\": \"Landscape\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (24)\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Container\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
