{"_id": "product_search--art_and_craft_su--p--71259", "text": "{\n    \"product_id\": \"PS12345\",\n    \"product_name\": \"Watercolor Painting Set - Serenity\",\n    \"brand\": \"Artify\",\n    \"category\": \"Painting\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are beautiful and blend easily. Very calming.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set.  It's perfect for learning watercolors.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"includes\": [\n            \"brushes\",\n            \"palette\",\n            \"watercolor paper\"\n        ]\n    },\n    \"color_options\": [\n        \"blue\",\n        \"green\",\n        \"purple\",\n        \"pink\",\n        \"yellow\"\n    ],\n    \"set_includes\": [\n        \"brushes\",\n        \"palette\",\n        \"watercolor paper\",\n        \"mixing tray\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
