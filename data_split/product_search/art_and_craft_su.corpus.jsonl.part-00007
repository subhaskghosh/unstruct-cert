{"_id": "product_search--art_and_craft_su--p--70184", "text": "{\n    \"product_id\": \"WCS-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning watercolor! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for beginners and the price is great.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Forest Green\",\n        \"Burnt Sienna\",\n        \"Violet\",\n        \"Raw Umber\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Cadmium Red\",\n        \"Cadmium Yellow\",\n        \"Ultramarine Blue\",\n        \"Sap Green\",\n        \"Cadmium Orange\",\n        \"Dioxazine Violet\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paintbrush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paper_weight\": \"140lb\"\n    }\n}"}
