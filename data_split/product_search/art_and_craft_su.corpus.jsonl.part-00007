{"_id": "product_search--art_and_craft_su--p--68132", "text": "{\n    \"product_id\": \"WC-SET-PROF-24\",\n    \"product_name\": \"Professional Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality for the price. Perfect for beginners and even experienced artists.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great color selection and the brushes included are surprisingly good!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"includes_brushes\": true,\n        \"palette_type\": \"Removable Palette\",\n        \"level\": \"beginner to intermediate\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Brown\"\n    ],\n    \"set_includes\": [\n        \"Paint Pans\",\n        \"Watercolor Brushes (5)\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
