{"_id": "product_search--art_and_craft_su--p--68695", "text": "{\n    \"product_id\": \"WC-24-BRSH-A\",\n    \"product_name\": \"Beginner Watercolor Paint Set with Brushes\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! Lots of vibrant colors and the brushes are decent quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for her art classes.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Emerald\",\n        \"Magenta\",\n        \"Violet\",\n        \"Indigo\",\n        \"Olive\",\n        \"Peach\",\n        \"Lavender\",\n        \"Turquoise\",\n        \"Coral\",\n        \"Sky Blue\",\n        \"Forest Green\",\n        \"Burnt Sienna\",\n        \"Umber\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"3 Paint Brushes\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"brush_included\": true\n    }\n}"}
