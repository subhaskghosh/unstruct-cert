{"_id": "product_search--art_and_craft_su--p--71735", "text": "{\n    \"product_id\": \"ARTEZA-WC-24-PORTABLE\",\n    \"product_name\": \"Arteza Professional Watercolor Paint Set, Portable\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and the portability is fantastic for painting outdoors.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I'm really enjoying learning watercolor with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"portability\": \"portable\",\n        \"paint_type\": \"watercolor\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Water Brush Pen\",\n        \"Mixing Palette\",\n        \"Paint Storage Case\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
