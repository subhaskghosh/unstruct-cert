{"_id": "product_search--art_and_craft_su--p--70423", "text": "{\n    \"product_id\": \"WC24B-ANML-2023\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Animal Illustration\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Colors are vibrant and blend well. The tutorials for painting animals are a nice touch.\",\n            \"reviewer_name\": \"Emily Carter\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Forest Green\",\n        \"Burnt Orange\",\n        \"Lavender\",\n        \"Sepia\",\n        \"Ivory\",\n        \"Peach\",\n        \"Magenta\",\n        \"Sky Blue\",\n        \"Olive Green\",\n        \"Coral\",\n        \"Violet\",\n        \"Umber\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"2 Paintbrushes\",\n        \"Palette\",\n        \"Watercolor Paper Pad (10 sheets)\",\n        \"Instruction Booklet\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paper_type\": \"cold press\"\n    }\n}"}
