{"_id": "product_search--art_and_craft_su--p--71305", "text": "{\n    \"product_id\": \"WC-24-BG-2023\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and easy to blend. The landscape palette is a great idea.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I love the variety of shades included.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\",\n        \"Yellow Ochre\",\n        \"Sap Green\",\n        \"Payne's Gray\",\n        \"Violet\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Cerulean Blue\",\n        \"Viridian\",\n        \"Raw Umber\",\n        \"Prussian Blue\",\n        \"Alizarin Crimson\",\n        \"Cadmium Yellow\",\n        \"Cadmium Red\",\n        \"Lemon Yellow\",\n        \"Indigo\",\n        \"Olive Green\",\n        \"Terra Verte\",\n        \"Burnt Umber\",\n        \"Lavender\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"foldable\"\n    }\n}"}
