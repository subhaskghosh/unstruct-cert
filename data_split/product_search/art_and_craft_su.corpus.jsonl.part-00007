{"_id": "product_search--art_and_craft_su--p--71000", "text": "{\n    \"product_id\": \"PST-00123\",\n    \"product_name\": \"Deluxe Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Painting\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality paper.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. The colors are vibrant and it's a good value for the money.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (36 colors)\",\n        \"Watercolor Paper Pad\",\n        \"Paintbrushes (5 pieces)\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"paper_weight\": \"140lb\",\n        \"brush_type\": \"synthetic\"\n    }\n}"}
