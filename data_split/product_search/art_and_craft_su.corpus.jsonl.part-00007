{"_id": "product_search--art_and_craft_su--n--68409", "text": "{\n    \"product_id\": \"WCSET-002\",\n    \"product_name\": \"Deluxe Watercolor Glitter Paint Set\",\n    \"brand\": \"SparkleArt\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Fun set, but the glitter gets everywhere!\",\n            \"reviewer_name\": \"Jessica Brown\"\n        },\n        {\n            \"review_text\": \"Good for kids crafts, but not for serious painting.\",\n            \"reviewer_name\": \"Michael Davis\"\n        }\n    ],\n    \"release_date\": \"2023-08-01\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"watercolor\",\n        \"palette_type\": \"tube\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Gold Glitter\",\n        \"Silver Glitter\"\n    ],\n    \"set_includes\": [\n        \"Watercolor tubes\",\n        \"Paint brushes\",\n        \"Glitter powder\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--68410", "text": "{\n    \"product_id\": \"WC-24-PROF-VIBRANT\",\n    \"product_name\": \"Professional Watercolor Paint Set - Vibrant Collection\",\n    \"brand\": \"ArtHaven\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! The colors are vibrant and blend beautifully. Perfect for a beginner like me.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I'm amazed by the pigment in these watercolors. Highly recommend!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"paper_type_compatibility\": [\n            \"Watercolor paper\",\n            \"Mixed media paper\"\n        ],\n        \"suitable_for\": \"Adults, Teens\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paint brush\",\n        \"Mixing palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--68410", "text": "{\n    \"product_id\": \"WC-12-KIDS\",\n    \"product_name\": \"Kids Watercolor Paint Set - Easy Wash\",\n    \"brand\": \"ColorFun\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 12.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"My kids love this paint set! Easy to clean up and the colors are bright.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"paper_type_compatibility\": [\n            \"Construction paper\",\n            \"Watercolor paper\"\n        ],\n        \"suitable_for\": \"Children\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paint brush\",\n        \"Coloring book\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
