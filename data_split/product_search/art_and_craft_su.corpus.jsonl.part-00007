{"_id": "product_search--art_and_craft_su--p--71423", "text": "{\n    \"product_id\": \"WC-24-BG-2021\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Vibrant Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend easily. It's a very relaxing hobby.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. I've been enjoying learning watercolor with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Lemon Yellow\",\n        \"Viridian\",\n        \"Violet\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Cadmium Red Light\",\n        \"Ultramarine Blue\",\n        \"Naples Yellow\",\n        \"Phthalo Green\",\n        \"Dioxazine Violet\",\n        \"Cadmium Orange\",\n        \"Burnt Umber\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paintbrush\",\n        \"Palette\",\n        \"Mixing Brush\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"number_of_colors\": 24\n    }\n}"}
