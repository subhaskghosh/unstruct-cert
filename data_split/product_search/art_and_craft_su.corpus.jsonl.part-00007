{"_id": "product_search--art_and_craft_su--p--67793", "text": "{\n    \"product_id\": \"WC-SET-001\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is fantastic for beginners! The colors are vibrant and blend beautifully.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the money. I'm loving painting landscapes with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Ultramarine\",\n            \"Lemon Yellow\",\n            \"Viridian\",\n            \"Violet\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Payne's Gray\",\n            \"Cerulean Blue\",\n            \"Cadmium Red\",\n            \"Cadmium Yellow\",\n            \"Alizarin Crimson\",\n            \"Phthalo Blue\",\n            \"Sap Green\",\n            \"Magenta\"\n        ],\n        \"set_includes\": [\n            \"24 watercolor paints\",\n            \"Paint brush\",\n            \"Mixing palette\",\n            \"Watercolor paper pad\"\n        ]\n    },\n    \"skill_level\": \"beginner\"\n}"}
