{"_id": "product_search--art_and_craft_su--p--71662", "text": "{\n    \"product_id\": \"APSET-001\",\n    \"product_name\": \"Beginner Acrylic Paint Set - Landscape Edition\",\n    \"brand\": \"Creative Canvas\",\n    \"category\": \"Acrylic Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and the paints are easy to blend. The landscape focus is a nice touch.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great value for the price. My daughter loves painting nature scenes with this set.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_quantity\": 12,\n        \"color_options\": [\n            \"Crimson Red\",\n            \"Burnt Orange\",\n            \"Yellow Ochre\",\n            \"Forest Green\",\n            \"Sky Blue\",\n            \"Titanium White\",\n            \"Black\",\n            \"Brown\",\n            \"Violet\",\n            \"Magenta\",\n            \"Lemon Yellow\",\n            \"Ultramarine Blue\"\n        ],\n        \"paint_type\": \"Acrylic\",\n        \"set_includes\": [\n            \"Paints\",\n            \"Brushes (3)\",\n            \"Palette\",\n            \"Mixing Cup\"\n        ]\n    },\n    \"skill_level\": \"beginner\"\n}"}
