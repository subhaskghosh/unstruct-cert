{"_id": "product_search--art_and_craft_su--n--71733", "text": "{\n    \"product_id\": \"WC-SET-002\",\n    \"product_name\": \"Professional Watercolor Paint Set - 36 Colors\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, perfect for experienced artists.\",\n            \"reviewer_name\": \"Jessica Williams\"\n        },\n        {\n            \"review_text\": \"Highly pigmented and blendable. A bit pricey, but worth it.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Brown\",\n            \"Black\",\n            \"White\"\n        ],\n        \"set_includes\": [\n            \"36 Watercolor Paints\",\n            \"2 Watercolor Brushes\",\n            \"Mixing Palette\",\n            \"Sketchbook\"\n        ],\n        \"skill_level\": \"intermediate\"\n    },\n    \"color_options\": [\n        \"Permanent Rose\",\n        \"Cadmium Yellow Pale\",\n        \"Phthalo Blue\",\n        \"Sap Green\",\n        \"Cadmium Red Pale\",\n        \"Dioxazine Violet\",\n        \"Vandyke Brown\",\n        \"Lamp Black\",\n        \"Chinese White\"\n    ],\n    \"set_includes\": [\n        \"36 x 10ml Watercolor Half Pans\",\n        \"Synthetic Watercolor Brush (Round Size 8)\",\n        \"Porcelain Palette\",\n        \"Waterbrush\",\n        \"Sketchbook (140lb)\"\n    ]\n}"}
