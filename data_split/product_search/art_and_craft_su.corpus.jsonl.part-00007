{"_id": "product_search--art_and_craft_su--n--71327", "text": "{\n    \"product_id\": \"AP456\",\n    \"product_name\": \"Winsor & Newton Professional Acrylic Paint Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Acrylic Paint\",\n    \"price\": 59.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints for professional artists.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_volume_per_color\": \"20ml\",\n        \"surface_compatibility\": [\n            \"Canvas\",\n            \"Paper\",\n            \"Wood\",\n            \"Metal\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"White\",\n        \"Black\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Pink\",\n        \"Turquoise\",\n        \"Gold\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Violet\",\n        \"Lime\",\n        \"Cyan\",\n        \"Magenta\",\n        \"Sepia\",\n        \"Umber\",\n        \"Sienna\",\n        \"Peach\",\n        \"Lavender\",\n        \"Olive\"\n    ],\n    \"set_includes\": [\n        \"Acrylic Paints\",\n        \"Palette\",\n        \"Brushes (3)\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71328", "text": "{\n    \"product_id\": \"WC-SET-123\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for beginners! Lots of colors and good quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Magenta\",\n        \"Cyan\",\n        \"Crimson\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Water Brush\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12\n    }\n}"}
