{"_id": "product_search--art_and_craft_su--p--71690", "text": "{\n    \"product_id\": \"WC-SET-123\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 42.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend beautifully.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great quality paints and brushes. Highly recommend!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Burnt Sienna\",\n        \"Ivory Black\",\n        \"Ultramarine Violet\",\n        \"Raw Umber\",\n        \"Cadmium Orange\",\n        \"Phthalo Green\",\n        \"Sap Green\",\n        \"Violet\",\n        \"Magenta\",\n        \"Yellow Ochre\",\n        \"Payne's Gray\",\n        \"Titanium White\",\n        \"Cobalt Blue\",\n        \"Viridian\",\n        \"Burnt Umber\",\n        \"Alizarin Crimson\",\n        \"Prussian Blue\",\n        \"Hooker's Green\",\n        \"Indian Yellow\",\n        \"Dioxazine Violet\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"6 Round Brushes\",\n        \"6 Flat Brushes\",\n        \"Palette\",\n        \"Water Brush\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"Beginner to Intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"brush_hair_type\": \"Synthetic\",\n        \"palette_material\": \"Plastic\"\n    }\n}"}
