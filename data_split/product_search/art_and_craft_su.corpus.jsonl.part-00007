{"_id": "product_search--art_and_craft_su--p--68461", "text": "{\n    \"product_id\": \"WC-24-BG-001\",\n    \"product_name\": \"Beginner's Watercolor Paint Set - Vibrant Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are incredibly vibrant and blend beautifully. Great value for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Easy to use and the colors are very pigmented. I love how smoothly they blend together.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2021-05-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Brown\",\n            \"Black\",\n            \"White\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Mixing Palette\",\n            \"Water Brush Pen\"\n        ]\n    },\n    \"skill_level\": \"beginner\"\n}"}
