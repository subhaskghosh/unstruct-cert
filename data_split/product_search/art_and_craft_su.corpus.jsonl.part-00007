{"_id": "product_search--art_and_craft_su--p--70698", "text": "{\n    \"product_id\": \"WCSET-101\",\n    \"product_name\": \"Artist's Choice Watercolor Paint Set\",\n    \"brand\": \"Royal Brush\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality pigment.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. The paints blend well.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Violet\",\n            \"Indigo\",\n            \"Teal\",\n            \"Olive Green\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Payne's Gray\",\n            \"Lemon Yellow\",\n            \"Cadmium Red\",\n            \"Cerulean Blue\",\n            \"Viridian\",\n            \"Magenta\",\n            \"Peach\",\n            \"Lavender\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Paint Brush\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24\n    },\n    \"skill_level\": \"beginner\"\n}"}
