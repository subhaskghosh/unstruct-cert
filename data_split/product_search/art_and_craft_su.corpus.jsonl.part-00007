{"_id": "product_search--art_and_craft_su--p--68734", "text": "{\n    \"product_id\": \"WC-12-BG\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out with watercolors. The colors are vibrant and blend well.  The included brush is decent quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price.  Perfect for painting landscapes and skies.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"pan\",\n        \"palette_type\": \"plastic\",\n        \"includes_brush\": true\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Pan Set\",\n        \"Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--68734", "text": "{\n    \"product_id\": \"GC-24-GL\",\n    \"product_name\": \"Glitter Galaxy Color Change Paint Set\",\n    \"brand\": \"Artful Creations\",\n    \"category\": \"Acrylic Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"My daughter loves the glitter and color changing effects!\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Fun paints for kids' crafts, but not very professional quality.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-11-01\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"acrylic\",\n        \"palette_type\": \"plastic\",\n        \"includes_brush\": true\n    },\n    \"color_options\": [\n        \"Purple\",\n        \"Pink\",\n        \"Blue\",\n        \"Silver\",\n        \"Gold\",\n        \"Green\",\n        \"Red\"\n    ],\n    \"set_includes\": [\n        \"Acrylic Paint Tubes\",\n        \"Brushes\",\n        \"Glitter\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
