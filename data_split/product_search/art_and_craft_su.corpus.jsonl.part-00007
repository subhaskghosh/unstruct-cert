{"_id": "product_search--art_and_craft_su--p--71963", "text": "{\n    \"product_id\": \"WC-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set with Landscape Palette\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and mix well. The landscape palette is a nice touch.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for learning watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Violet\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Cerulean Blue\",\n        \"Sap Green\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Alizarin Crimson\",\n        \"Phthalo Blue\",\n        \"Viridian\",\n        \"Payne's Gray\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Burnt Umber\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Mixing Tray\",\n        \"Watercolor Paper Pad (30 sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paper_weight\": \"140lb\"\n    }\n}"}
