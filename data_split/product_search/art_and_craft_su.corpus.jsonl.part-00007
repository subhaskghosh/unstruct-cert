{"_id": "product_search--art_and_craft_su--p--68544", "text": "{\n    \"product_id\": \"WC-123\",\n    \"product_name\": \"Portable Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and easy to blend. Perfect for travel.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I've used these for landscapes and they work beautifully.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"palette_type\": \"portable\",\n        \"paint_type\": \"pan\",\n        \"ideal_for\": \"landscapes, sketching\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Brush\",\n        \"Mixing palette\",\n        \"Water brush\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
