{"_id": "product_search--art_and_craft_su--p--70699", "text": "{\n    \"product_id\": \"WC-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's a good starting point for learning watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Brown\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Violet\",\n            \"Indigo\",\n            \"Teal\",\n            \"Olive\",\n            \"Maroon\",\n            \"Coral\",\n            \"Magenta\",\n            \"Peach\",\n            \"Lavender\",\n            \"Turquoise\",\n            \"Gold\",\n            \"Silver\",\n            \"Bronze\",\n            \"Rose\"\n        ],\n        \"set_includes\": [\n            \"Watercolor Paints (24 colors)\",\n            \"Paintbrush\",\n            \"Mixing Palette\",\n            \"Water Cup\"\n        ],\n        \"skill_level\": \"beginner\"\n    }\n}"}
