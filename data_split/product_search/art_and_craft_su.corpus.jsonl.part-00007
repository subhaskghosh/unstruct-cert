{"_id": "product_search--art_and_craft_su--p--68656", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Serenity\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! The colors blend beautifully and it's a really calming palette.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for beginners. Good quality for the price.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"color_options\": [\n        \"Lavender\",\n        \"Sky Blue\",\n        \"Sea Green\",\n        \"Peach\",\n        \"Cream\",\n        \"Gray\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paintbrush (Round #6)\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad (30 sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
