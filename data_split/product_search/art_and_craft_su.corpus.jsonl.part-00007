{"_id": "product_search--art_and_craft_su--p--68134", "text": "{\n    \"product_id\": \"WC-12-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well.  Perfect for landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set.  Easy to use and the colors are beautiful.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_count\": 12,\n        \"brush_included\": true,\n        \"paper_type\": \"Watercolor Paper\",\n        \"palette_type\": \"Plastic Palette\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Magenta\",\n        \"Sky Blue\",\n        \"Lime Green\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brushes (3)\",\n        \"Watercolor Paper Pad (12 sheets)\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
