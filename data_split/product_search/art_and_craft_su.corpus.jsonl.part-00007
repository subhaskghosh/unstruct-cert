{"_id": "product_search--art_and_craft_su--p--71550", "text": "{\n    \"product_id\": \"WP-12345\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Castle Art Supplies\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend well. Great for landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"A fantastic value for the price. I'm enjoying learning watercolor with this set.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-11-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Forest Green\",\n        \"Burnt Orange\",\n        \"Violet\",\n        \"Raw Umber\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Cadmium Red\",\n        \"Naples Yellow\",\n        \"Ultramarine Blue\",\n        \"Sap Green\",\n        \"Coral\",\n        \"Lavender\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24\n    }\n}"}
