{"_id": "product_search--art_and_craft_su--p--68944", "text": "{\n    \"product_id\": \"WC-SET-48-PROF\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners and pros alike! The colors are vibrant and blend beautifully.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the money. A wide range of colors and good quality paint.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Ultramarine Blue\",\n        \"Burnt Sienna\",\n        \"Viridian\",\n        \"White\",\n        \"Black\",\n        \"Purple\",\n        \"Orange\",\n        \"Pink\",\n        \"Green\",\n        \"Brown\",\n        \"Yellow\",\n        \"Blue\",\n        \"Red\",\n        \"Violet\",\n        \"Magenta\",\n        \"Indigo\",\n        \"Cerulean\",\n        \"Sap Green\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Ivory Black\",\n        \"Titanium White\"\n    ],\n    \"set_includes\": [\n        \"48 Watercolor Paints\",\n        \"Watercolor Brush (Round, Size 8)\",\n        \"Watercolor Brush (Flat, Size 1/2 inch)\",\n        \"Mixing Palette\",\n        \"Water Cup\",\n        \"Instruction Booklet\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 48,\n        \"paint_form\": \"Pan\"\n    }\n}"}
