{"_id": "product_search--art_and_craft_su--p--67217", "text": "{\n    \"product_id\": \"WC-12B-FLORA\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Floral Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and easy to blend. Perfect for flower paintings.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set. She's been painting flowers non-stop!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"brush_included\": false,\n        \"palette_type\": \"Plastic\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Pink\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Violet\",\n        \"Crimson\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paint brush (size 8)\",\n        \"Mixing palette\",\n        \"Instruction booklet\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
