{"_id": "product_search--art_and_craft_su--p--70422", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 22.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning! Colors are vibrant and easy to blend.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for beginners, good quality for the price.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_quantity\": 18,\n        \"brush_included\": true,\n        \"palette_type\": \"Plastic\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Cerulean Blue\",\n        \"Lemon Yellow\",\n        \"Magenta\",\n        \"Phthalo Green\",\n        \"Indigo\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
