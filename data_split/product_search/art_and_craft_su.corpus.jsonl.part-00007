{"_id": "product_search--art_and_craft_su--p--68985", "text": "{\n    \"product_id\": \"WC-SET-001\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 49.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! The colors are vibrant and blend beautifully. Perfect for beginners and experienced artists alike.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"This set has everything a beginner needs to get started. The included brush is decent quality and the paint is highly pigmented.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Viridian\",\n        \"Burnt Sienna\",\n        \"Indigo\",\n        \"Raw Umber\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Green\",\n        \"Brown\",\n        \"Pink\",\n        \"Turquoise\",\n        \"Violet\",\n        \"Peach\",\n        \"Lavender\",\n        \"Magenta\",\n        \"Olive Green\",\n        \"Sky Blue\",\n        \"Coral\",\n        \"Gold\",\n        \"Silver\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\",\n        \"Watercolor Paper Pad (30 sheets)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"paper_weight\": \"140lb\",\n        \"lightfastness\": \"good\"\n    }\n}"}
