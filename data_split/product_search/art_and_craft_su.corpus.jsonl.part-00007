{"_id": "product_search--art_and_craft_su--p--68657", "text": "{\n    \"product_id\": \"WC-SET-24-AQUA\",\n    \"product_name\": \"AquaDream Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well.  I'm loving painting landscapes with this set.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. Highly recommend!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Removable\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paintbrush\",\n        \"Mixing palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--68657", "text": "{\n    \"product_id\": \"WC-SET-12-BAS\",\n    \"product_name\": \"Basic Watercolor Paint Set\",\n    \"brand\": \"ColorSplash\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 15.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"A decent starter set, but the colors aren't very vibrant.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        }\n    ],\n    \"release_date\": \"2023-03-01\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"palette_type\": \"Fixed\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paintbrush\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--p--68658", "text": "{\n    \"product_id\": \"WC-24-BEGINNER-AQUA\",\n    \"product_name\": \"AquaSplash Beginner Watercolor Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for her art classes.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Black\",\n            \"White\",\n            \"Brown\",\n            \"Pink\",\n            \"Violet\",\n            \"Crimson\",\n            \"Indigo\",\n            \"Turquoise\",\n            \"Olive Green\",\n            \"Peach\",\n            \"Lavender\",\n            \"Gold\",\n            \"Silver\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Payne's Gray\",\n            \"Cerulean Blue\",\n            \"Phthalo Green\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Mixing Palette\",\n            \"Watercolor Paper Pad (12 sheets)\"\n        ],\n        \"skill_level\": \"beginner\",\n        \"number_of_colors\": 24\n    }\n}"}
