{"_id": "product_search--art_and_craft_su--p--71170", "text": "{\n    \"product_id\": \"PS00123\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Painting Sets\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out with watercolors! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set! Perfect for a beginner artist.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2024-01-15\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"includes\": [\n            \"brushes\",\n            \"watercolor paper\",\n            \"palette\"\n        ]\n    },\n    \"color_options\": [\n        \"red\",\n        \"blue\",\n        \"yellow\",\n        \"green\",\n        \"purple\",\n        \"orange\",\n        \"brown\",\n        \"black\",\n        \"white\"\n    ],\n    \"set_includes\": [\n        \"brushes\",\n        \"watercolor paper\",\n        \"palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
