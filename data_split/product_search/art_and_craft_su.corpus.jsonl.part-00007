{"_id": "product_search--art_and_craft_su--p--70606", "text": "{\n    \"product_id\": \"WC-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. I'm really enjoying learning watercolor with this set.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Purple\",\n            \"Orange\",\n            \"Black\",\n            \"White\",\n            \"Crimson\",\n            \"Magenta\",\n            \"Violet\",\n            \"Teal\",\n            \"Brown\",\n            \"Burnt Sienna\",\n            \"Raw Umber\",\n            \"Payne's Gray\",\n            \"Lemon Yellow\",\n            \"Cadmium Red\",\n            \"Ultramarine Blue\",\n            \"Viridian\",\n            \"Cerulean Blue\",\n            \"Cobalt Blue\",\n            \"Peach\",\n            \"Lavender\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Brush\",\n            \"Palette\",\n            \"Watercolor Paper Pad (12 sheets)\"\n        ]\n    },\n    \"skill_level\": \"beginner\"\n}"}
