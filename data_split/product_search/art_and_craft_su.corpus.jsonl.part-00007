{"_id": "product_search--art_and_craft_su--p--70132", "text": "{\n    \"product_id\": \"WC-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is incredibly inspiring! The colors are vibrant and easy to blend, perfect for a beginner like me.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the price. A wonderful starting point for watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"Red\",\n            \"Yellow\",\n            \"Blue\",\n            \"Green\",\n            \"Orange\",\n            \"Purple\",\n            \"Black\",\n            \"White\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Paintbrush\",\n            \"Palette\",\n            \"Mixing Tray\"\n        ],\n        \"skill_level\": \"beginner\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Violet\",\n        \"Turquoise\",\n        \"Magenta\",\n        \"Olive Green\",\n        \"Peach\",\n        \"Sky Blue\",\n        \"Lemon Yellow\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Gold Ochre\",\n        \"Cadmium Red\",\n        \"Cerulean Blue\"\n    ]\n}"}
