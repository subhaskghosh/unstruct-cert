{"_id": "product_search--art_and_craft_su--n--71607", "text": "{\n    \"product_id\": \"CLG-INK-202\",\n    \"product_name\": \"Calligraphy Ink Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Calligraphy Supplies\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Beautiful inks, perfect for lettering and calligraphy.\",\n            \"reviewer_name\": \"Jessica Brown\"\n        },\n        {\n            \"review_text\": \"Rich colors and smooth flow. Great for pointed pen calligraphy.\",\n            \"reviewer_name\": \"Michael Davis\"\n        }\n    ],\n    \"release_date\": \"2023-08-01\",\n    \"attributes\": {\n        \"ink_type\": \"liquid\",\n        \"nib_sizes\": [\n            \"1.5mm\",\n            \"2.5mm\",\n            \"3.5mm\"\n        ]\n    },\n    \"color_options\": [\n        \"Black\",\n        \"Gold\",\n        \"Silver\",\n        \"Blue\",\n        \"Red\"\n    ],\n    \"set_includes\": [\n        \"Ink Bottles\",\n        \"Nib Holders\",\n        \"Nibs\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--71608", "text": "{\n    \"product_id\": \"WC-24-STAR-BEGIN\",\n    \"product_name\": \"Starry Nights Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's a great value for the money.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Emerald\",\n        \"Magenta\",\n        \"Violet\",\n        \"Indigo\",\n        \"Turquoise\",\n        \"Peach\",\n        \"Lavender\",\n        \"Olive\",\n        \"Terracotta\",\n        \"Gold\",\n        \"Silver\",\n        \"Bronze\",\n        \"Sepia\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paint_form\": \"pan\"\n    }\n}"}
