{"_id": "product_search--art_and_craft_su--p--70936", "text": "{\n    \"product_id\": \"WC-101\",\n    \"product_name\": \"Serenity Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 22.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are beautiful and blend easily.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great quality for the price. I love the calming color palette.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Lavender\",\n        \"Sky Blue\",\n        \"Sea Green\",\n        \"Pale Yellow\",\n        \"Rose Pink\",\n        \"Cream White\",\n        \"Light Gray\",\n        \"Peach\",\n        \"Mint\",\n        \"Coral\",\n        \"Turquoise\",\n        \"Lilac\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12\n    }\n}"}
