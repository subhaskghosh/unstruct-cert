{"_id": "product_search--art_and_craft_su--p--71956", "text": "{\n    \"product_id\": \"PAINTSET-123\",\n    \"product_name\": \"Beginner Acrylic Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Painting\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and the brushes are decent quality.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this paint set. It was perfect for her first painting experience.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_types\": [\n            \"Acrylic\"\n        ],\n        \"number_of_pieces\": 15,\n        \"color_options\": [\n            \"Red\",\n            \"Blue\",\n            \"Yellow\",\n            \"Green\",\n            \"White\",\n            \"Black\",\n            \"Orange\",\n            \"Purple\",\n            \"Brown\",\n            \"Pink\",\n            \"Light Blue\",\n            \"Dark Green\",\n            \"Gray\",\n            \"Crimson\",\n            \"Teal\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\"\n    ],\n    \"set_includes\": [\n        \"Paints\",\n        \"Brushes\",\n        \"Palette\",\n        \"Canvas\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
