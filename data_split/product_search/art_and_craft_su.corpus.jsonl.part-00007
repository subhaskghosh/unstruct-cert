{"_id": "product_search--art_and_craft_su--p--68453", "text": "{\n    \"product_id\": \"WC-12-CALM-BG\",\n    \"product_name\": \"Watercolor Paint Set - Calming Blues & Greens\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality for the price! Perfect for beginners.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"The colors are beautiful and blend easily. Very happy with this set.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Olive Green\",\n        \"Sky Blue\",\n        \"Lavender\",\n        \"Peach\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Titanium White\",\n        \"Lemon Yellow\",\n        \"Crimson Red\",\n        \"Indigo\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12\n    }\n}"}
