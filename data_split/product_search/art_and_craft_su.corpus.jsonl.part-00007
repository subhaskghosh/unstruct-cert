{"_id": "product_search--art_and_craft_su--p--70708", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Landscape Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 22.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set to start with! The colors are vibrant and the brushes are decent quality for the price.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"This set inspired me to start painting landscapes. Easy to use and excellent value.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Violet\",\n        \"Crimson\",\n        \"Indigo\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"3 Paintbrushes\",\n        \"Palette\",\n        \"Mixing Tray\",\n        \"Instruction Booklet\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12,\n        \"paint_volume\": \"0.5 fl oz\",\n        \"theme\": \"landscape\"\n    }\n}"}
