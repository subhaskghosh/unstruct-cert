{"_id": "product_search--art_and_craft_su--p--68983", "text": "{\n    \"product_id\": \"WP-007\",\n    \"product_name\": \"Artist's Watercolor Paint Set - 36 Colors\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 65.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, very vibrant and blend well. Perfect for beginners and experienced artists alike.\",\n            \"reviewer_name\": \"Emily Carter\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 36,\n        \"pigment_quality\": \"Professional Grade\",\n        \"set_includes\": [\n            \"Paints\",\n            \"Brush\",\n            \"Palette\",\n            \"Water cup\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Cerulean\"\n    ],\n    \"set_includes\": [\n        \"Paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Mixing tray\"\n    ],\n    \"skill_level\": \"Beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--68983", "text": "{\n    \"product_id\": \"WP-012\",\n    \"product_name\": \"Student Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"GenericArt\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 20.5,\n    \"availability\": true,\n    \"rating\": 3.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Decent for the price, but the colors aren't very vibrant and the paint is a bit thin.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-07-20\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"pigment_quality\": \"Student Grade\",\n        \"set_includes\": [\n            \"Paints\",\n            \"Brush\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\"\n    ],\n    \"set_includes\": [\n        \"Paints\",\n        \"Brush\"\n    ],\n    \"skill_level\": \"Beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--p--68984", "text": "{\n    \"product_id\": \"WC-24-PRO\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality for the price! The colors are vibrant and blend beautifully. Perfect for beginners.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I'm a beginner and this set has everything I need to get started. The paints are very pigmented.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Emerald Green\",\n        \"Burnt Sienna\",\n        \"Violet\",\n        \"Raw Umber\",\n        \"Ivory\",\n        \"Magenta\",\n        \"Gold\",\n        \"Silver\",\n        \"Peach\",\n        \"Lavender\",\n        \"Teal\",\n        \"Coral\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Palette\",\n        \"Water Cup\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"size\": \"standard\"\n    }\n}"}
