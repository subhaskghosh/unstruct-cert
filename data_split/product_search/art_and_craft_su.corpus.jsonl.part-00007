{"_id": "product_search--art_and_craft_su--p--68440", "text": "{\n    \"product_id\": \"WC-PST-2048\",\n    \"product_name\": \"Professional Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artisan's Dream\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, vibrant colors, and a beautiful palette. A great step up from student grade watercolors.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"The colors blend beautifully and the pigment is highly concentrated. Highly recommend for intermediate artists.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"Removable\",\n        \"lightfastness\": \"Excellent\"\n    },\n    \"color_options\": [\n        \"Crimson\",\n        \"Ultramarine Blue\",\n        \"Burnt Sienna\",\n        \"Lemon Yellow\",\n        \"Viridian Green\",\n        \"Payne's Gray\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (24 x 12ml tubes)\",\n        \"Watercolor Brush (Round, Size 8)\",\n        \"Mixing Palette\",\n        \"Water Brush Pen\"\n    ],\n    \"skill_level\": \"Intermediate\"\n}"}
