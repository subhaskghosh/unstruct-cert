{"_id": "product_search--art_and_craft_su--p--71531", "text": "{\n    \"product_id\": \"WC-24-BASIC-A\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set to start with! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's perfect for learning watercolor techniques.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Crimson\",\n        \"Magenta\",\n        \"Violet\",\n        \"Turquoise\",\n        \"Indigo\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Cerulean Blue\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Alizarin Crimson\",\n        \"Ultramarine Blue\",\n        \"Payne's Gray\",\n        \"Sap Green\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"plastic\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--71531", "text": "{\n    \"product_id\": \"WC-12-PROF-B\",\n    \"product_name\": \"Professional Watercolor Paint Set - 12 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints. Highly pigmented and blend beautifully.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"These are fantastic watercolors for professional artists.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Crimson\",\n        \"Magenta\",\n        \"Violet\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"2 High-Quality Paint Brushes\",\n        \"Porcelain Palette\",\n        \"Water Brush\"\n    ],\n    \"skill_level\": \"intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12,\n        \"palette_type\": \"porcelain\"\n    }\n}"}
