{"_id": "product_search--art_and_craft_su--p--67017", "text": "{\n    \"product_id\": \"AWCS-24-BLU\",\n    \"product_name\": \"Arteza Watercolor Paint Set, 24 Colors\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend beautifully. It's very calming to use.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great quality for the price. I love the range of colors and how easy they are to work with.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"Pan\",\n        \"finish\": \"Matte\",\n        \"aesthetic\": \"Calming Blue Tones\"\n    },\n    \"skill_level\": \"beginner\",\n    \"color_options\": [\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Pink\",\n        \"Yellow\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\"\n    ]\n}"}
