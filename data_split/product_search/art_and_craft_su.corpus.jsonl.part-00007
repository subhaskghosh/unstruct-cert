{"_id": "product_search--art_and_craft_su--p--65997", "text": "{\n    \"product_id\": \"WPS-123\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for learning watercolor! The colors blend well and the quality is surprisingly good for the price.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Perfect for beginners like me. The included brush is decent and the paints are vibrant.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"color_options\": [\n            \"Lavender\",\n            \"Sky Blue\",\n            \"Olive Green\",\n            \"Burnt Sienna\",\n            \"Cream\"\n        ],\n        \"set_includes\": [\n            \"Paint Palette\",\n            \"Paint Brush\",\n            \"Mixing Tray\"\n        ]\n    },\n    \"skill_level\": \"beginner\"\n}"}
