{"_id": "product_search--art_and_craft_su--p--70345", "text": "{\n    \"product_id\": \"APSET-101\",\n    \"product_name\": \"Arteza Acrylic Paint Set - Landscape Edition\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Acrylic Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. Perfect for landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality paints for the price. I've been using them for my landscape paintings and I'm very happy.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Acrylic\",\n        \"surface_compatibility\": [\n            \"Canvas\",\n            \"Wood\",\n            \"Paper\",\n            \"Fabric\"\n        ]\n    },\n    \"color_options\": [\n        \"Crimson Red\",\n        \"Lemon Yellow\",\n        \"Forest Green\",\n        \"Sky Blue\",\n        \"Burnt Sienna\",\n        \"Titanium White\",\n        \"Black\",\n        \"Purple\",\n        \"Orange\",\n        \"Pink\",\n        \"Brown\",\n        \"Grey\"\n    ],\n    \"set_includes\": [\n        \"12 Acrylic Paints\",\n        \"Paint Brush\",\n        \"Palette Knife\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
