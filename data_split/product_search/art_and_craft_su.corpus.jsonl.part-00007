{"_id": "product_search--art_and_craft_su--p--70902", "text": "{\n    \"product_id\": \"ARTEZA-PAINT-LANDSCAPE-001\",\n    \"product_name\": \"Arteza Landscape Painting Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Painting\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set to get started with landscape painting! The colors are vibrant and easy to blend.\",\n            \"reviewer_name\": \"Emily Carter\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Acrylic\",\n        \"number_of_colors\": 12,\n        \"canvas_size\": \"9x12 inches\",\n        \"brush_types\": [\n            \"Round\",\n            \"Flat\",\n            \"Filbert\"\n        ]\n    },\n    \"color_options\": [\n        \"Titanium White\",\n        \"Lemon Yellow\",\n        \"Cadmium Yellow Medium\",\n        \"Cadmium Red Medium\",\n        \"Alizarin Crimson\",\n        \"Ultramarine Blue\",\n        \"Phthalo Blue\",\n        \"Viridian Green\",\n        \"Sap Green\",\n        \"Burnt Sienna\",\n        \"Burnt Umber\",\n        \"Black\"\n    ],\n    \"set_includes\": [\n        \"Acrylic Paints (12)\",\n        \"Canvas (5)\",\n        \"Paint Brushes (3)\",\n        \"Palette\",\n        \"Palette Knife\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
