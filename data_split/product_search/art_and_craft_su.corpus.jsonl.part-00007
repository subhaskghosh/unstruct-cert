{"_id": "product_search--art_and_craft_su--p--71943", "text": "{\n    \"product_id\": \"WC-24-B-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Floral Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and blend well. Perfect for floral painting.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. Easy to use and clean up.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Violet\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Cadmium Yellow\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Ultramarine Blue\",\n        \"Magenta\",\n        \"Peach\",\n        \"Lavender\",\n        \"Turquoise\",\n        \"Coral\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paint Brush (Round, Size 6)\",\n        \"Paint Brush (Flat, Size 8)\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"plastic\"\n    }\n}"}
