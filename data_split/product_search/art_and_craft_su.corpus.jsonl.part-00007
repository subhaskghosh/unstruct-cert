{"_id": "product_search--art_and_craft_su--p--68172", "text": "{\n    \"product_id\": \"WC-24-Inspire-001\",\n    \"product_name\": \"Inspire Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is amazing for beginners! The colors are vibrant and easy to blend. I've been painting landscapes and the results are fantastic.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great quality paints for the price. Perfect for learning watercolor techniques.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Olive Green\",\n        \"Sky Blue\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Lavender\",\n        \"Peach\",\n        \"Coral\",\n        \"Turquoise\",\n        \"Magenta\",\n        \"Violet\",\n        \"Indigo\",\n        \"Gold\",\n        \"Silver\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"pan\",\n        \"paper_weight\": \"140lb\",\n        \"palette_material\": \"plastic\"\n    }\n}"}
