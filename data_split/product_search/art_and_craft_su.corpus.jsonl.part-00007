{"_id": "product_search--art_and_craft_su--p--70078", "text": "{\n    \"product_id\": \"AP12-ARTEZA-LAND\",\n    \"product_name\": \"Arteza Acrylic Paint Set for Landscapes\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Acrylic Paint\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and perfect for landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent quality for the price. I've been painting landscapes for a month now and these paints are holding up well.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Acrylic\",\n        \"surface_compatibility\": [\n            \"Canvas\",\n            \"Paper\",\n            \"Wood\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"White\",\n        \"Black\",\n        \"Orange\",\n        \"Purple\",\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Burnt Sienna\"\n    ],\n    \"set_includes\": [\n        \"12 Acrylic Paints\",\n        \"Palette Knife\",\n        \"Brush Set\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--70078", "text": "{\n    \"product_id\": \"AP24-ARTEZA-PORT\",\n    \"product_name\": \"Arteza Acrylic Paint Set for Portraits\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Acrylic Paint\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Fantastic for portraits! The skin tone colors are perfect.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"Good range of colors for portrait painting.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Acrylic\",\n        \"surface_compatibility\": [\n            \"Canvas\",\n            \"Paper\"\n        ]\n    },\n    \"color_options\": [\n        \"Titanium White\",\n        \"Ivory Black\",\n        \"Burnt Umber\",\n        \"Raw Sienna\",\n        \"Yellow Ochre\",\n        \"Cadmium Yellow Light\",\n        \"Cadmium Red Light\",\n        \"Alizarin Crimson\",\n        \"Ultramarine Blue\",\n        \"Phthalo Blue\",\n        \"Viridian\",\n        \"Sap Green\",\n        \"Payne's Gray\",\n        \"Purple\",\n        \"Pink\",\n        \"Light Flesh\",\n        \"Medium Flesh\",\n        \"Dark Flesh\",\n        \"Lemon Yellow\",\n        \"Orange\",\n        \"Violet\",\n        \"Turquoise\",\n        \"Peach\",\n        \"Brown\"\n    ],\n    \"set_includes\": [\n        \"24 Acrylic Paints\",\n        \"Blending Brush\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--70079", "text": "{\n    \"product_id\": \"WC-SET-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! The colors are vibrant and the instructions are clear.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for landscape painting. Love the variety of blues and greens.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"Pan\",\n        \"paper_included\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brush\",\n        \"Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
