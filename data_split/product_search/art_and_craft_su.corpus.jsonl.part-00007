{"_id": "product_search--art_and_craft_su--n--68125", "text": "{\n    \"product_id\": \"ART456\",\n    \"product_name\": \"Professional Charcoal Sketching Kit\",\n    \"brand\": \"MasterArt\",\n    \"category\": \"Sketching\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality charcoal and paper. Perfect for detailed sketches.\",\n            \"reviewer_name\": \"SketchPro\"\n        }\n    ],\n    \"release_date\": \"2023-01-20\",\n    \"attributes\": {\n        \"charcoal_type\": \"Willow\",\n        \"paper_weight\": \"100lb\",\n        \"sketchbook_size\": \"9x12 inches\"\n    },\n    \"color_options\": [\n        \"Black\",\n        \"Gray\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Charcoal pencils\",\n        \"Sketchbook\",\n        \"Eraser\",\n        \"Sharpener\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
