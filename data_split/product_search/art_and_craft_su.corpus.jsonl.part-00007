{"_id": "product_search--art_and_craft_su--p--68475", "text": "{\n    \"product_id\": \"PS1001\",\n    \"product_name\": \"Beginner's Acrylic Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Painting\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Lots of colors and good quality for the price.\",\n            \"reviewer_name\": \"Emily S.\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set. It has everything she needs to get started with acrylic painting.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Lemon Yellow\",\n        \"Forest Green\",\n        \"Burnt Orange\",\n        \"Violet\",\n        \"Brown\",\n        \"Pink\",\n        \"Turquoise\",\n        \"Magenta\",\n        \"Gold\",\n        \"Silver\",\n        \"Peach\",\n        \"Lavender\",\n        \"Olive\",\n        \"Coral\"\n    ],\n    \"set_includes\": [\n        \"Acrylic Paints (24 colors)\",\n        \"Paint Brushes (5 pieces)\",\n        \"Palette\",\n        \"Palette Knife\",\n        \"Canvas (5x7 inches, 3 pieces)\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Acrylic\",\n        \"paint_volume\": \"20ml per color\"\n    }\n}"}
