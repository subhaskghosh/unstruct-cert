{"_id": "product_search--art_and_craft_su--p--71431", "text": "{\n    \"product_id\": \"WN-WC-SET-24\",\n    \"product_name\": \"Winsor & Newton Cotman Water Colour Paint Sketchers' Pocket Box\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paint Sets\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints for the price. Great for beginners and intermediate artists.\",\n            \"reviewer_name\": \"ArtLover78\"\n        },\n        {\n            \"review_text\": \"Compact and convenient for plein air painting. The colors are vibrant and blend well.\",\n            \"reviewer_name\": \"OutdoorPainter\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Tubes\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Sketching Pencil\",\n        \"Eraser\"\n    ],\n    \"skill_level\": \"Beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 12,\n        \"palette_material\": \"Plastic\"\n    }\n}"}
