{"_id": "product_search--art_and_craft_su--p--70605", "text": "{\n    \"product_id\": \"ARTEZA-WCS-24\",\n    \"product_name\": \"Arteza Watercolor Paint Set\",\n    \"brand\": \"Arteza\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend easily. It's really inspiring to use and has helped me get into watercolor painting.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great value for the money. A good selection of colors and decent quality.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"color_options\": [\n            \"24 Assorted Colors\"\n        ],\n        \"set_includes\": [\n            \"24 Watercolor Paints\",\n            \"Watercolor Brush\",\n            \"Mixing Palette\"\n        ],\n        \"skill_level\": \"beginner\"\n    },\n    \"color_options\": [\n        \"24 Assorted Colors\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
