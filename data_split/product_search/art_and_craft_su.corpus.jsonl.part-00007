{"_id": "product_search--art_and_craft_su--p--68139", "text": "{\n    \"product_id\": \"WC-7890\",\n    \"product_name\": \"Artist's Watercolor Studio Set\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 75.0,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! The colors are vibrant and blend beautifully. The included brushes are a nice bonus.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Great set for intermediate watercolor artists. Everything you need to get started!\",\n            \"reviewer_name\": \"David Chen\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"attributes\": {\n        \"paint_count\": 36,\n        \"brush_types\": [\n            \"round\",\n            \"flat\",\n            \"liner\"\n        ],\n        \"palette_type\": \"plastic\",\n        \"color_options\": [\n            \"Crimson\",\n            \"Ultramarine\",\n            \"Yellow Ochre\",\n            \"Burnt Sienna\",\n            \"Payne's Gray\",\n            \"Viridian\"\n        ]\n    },\n    \"color_options\": [\n        \"Crimson\",\n        \"Ultramarine\",\n        \"Yellow Ochre\",\n        \"Burnt Sienna\",\n        \"Payne's Gray\",\n        \"Viridian\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Brushes\",\n        \"Palette\",\n        \"Mixing Tray\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
