{"_id": "product_search--art_and_craft_su--p--71671", "text": "{\n    \"product_id\": \"WC-24-BEGINNER-LANDSCAPE\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for starting out! The colors are vibrant and blend easily. Perfect for landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. My daughter loves it!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"suitable_for\": \"Beginner, Landscape Painting\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Purple\",\n        \"Pink\",\n        \"Turquoise\",\n        \"Magenta\",\n        \"Violet\",\n        \"Crimson\",\n        \"Indigo\",\n        \"Olive Green\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Cerulean Blue\",\n        \"Ultramarine Blue\",\n        \"Lemon Yellow\",\n        \"Cadmium Red\",\n        \"Phthalo Green\",\n        \"Payne's Gray\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints (24)\",\n        \"Brush (size 8)\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
