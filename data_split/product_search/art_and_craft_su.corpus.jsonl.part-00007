{"_id": "product_search--art_and_craft_su--p--71978", "text": "{\n    \"product_id\": \"WCS-12345\",\n    \"product_name\": \"Royal Talens Van Gogh Watercolor Travel Box\",\n    \"brand\": \"Royal Talens\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints! Perfect for beginners and professionals alike. The colors are vibrant and blend beautifully.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"Great travel set, very compact and the paints are highly pigmented.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Yellow Ochre\",\n        \"Cadmium Yellow Light\",\n        \"Cadmium Red Pale\",\n        \"Permanent Rose\",\n        \"Ultramarine\",\n        \"Cobalt Blue\",\n        \"Viridian\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Chinese White\",\n        \"Ivory Black\",\n        \"Lemon Yellow\",\n        \"Cadmium Yellow Dark\",\n        \"Cadmium Red Medium\",\n        \"Alizarin Crimson\",\n        \"Cerulean Blue\",\n        \"Phthalo Blue\",\n        \"Sap Green\",\n        \"Burnt Umber\",\n        \"Payne's Gray\",\n        \"Raw Sienna\",\n        \"Sepia\",\n        \"Neutral Tint\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush\",\n        \"Mixing Palette\",\n        \"Travel Box\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"box_type\": \"travel box\"\n    }\n}"}
