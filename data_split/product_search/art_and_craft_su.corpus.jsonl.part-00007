{"_id": "product_search--art_and_craft_su--p--71953", "text": "{\n    \"product_id\": \"WCS-24-BG\",\n    \"product_name\": \"Beginner Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for starting out! The colors are vibrant and blend well. Perfect for landscapes.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set! She's been painting beautiful flowers with it. Great value for the money.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Lemon Yellow\",\n        \"Cerulean Blue\",\n        \"Forest Green\",\n        \"Burnt Orange\",\n        \"Violet\",\n        \"Umber\",\n        \"Ivory\",\n        \"Magenta\",\n        \"Gold\",\n        \"Silver\",\n        \"Sky Blue\",\n        \"Olive Green\",\n        \"Coral\",\n        \"Lavender\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paintbrush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"paper_weight\": \"140lb\"\n    }\n}"}
