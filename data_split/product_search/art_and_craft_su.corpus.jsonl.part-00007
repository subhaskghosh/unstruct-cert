{"_id": "product_search--art_and_craft_su--p--70726", "text": "{\n    \"product_id\": \"WCS-101\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for beginners! The colors are vibrant, and the set has everything you need to get started. I'm learning and really enjoying it.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Perfect for a first watercolor set. Good quality for the price.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Watercolor\",\n        \"set_includes\": [\n            \"Paints\",\n            \"Brushes\",\n            \"Palette\",\n            \"Watercolor Paper\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Violet\",\n        \"Ultramarine\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--70726", "text": "{\n    \"product_id\": \"WCS-202\",\n    \"product_name\": \"Professional Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, highly pigmented. A must-have for professional artists.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"The best watercolor set I've ever used. Colors blend beautifully.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Watercolor\",\n        \"set_includes\": [\n            \"Paints\",\n            \"High-Quality Brushes\",\n            \"Porcelain Palette\",\n            \"Heavyweight Watercolor Paper\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Violet\",\n        \"Ultramarine\",\n        \"Indigo\",\n        \"Cerulean\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Grey\",\n        \"Viridian\",\n        \"Cadmium Yellow\",\n        \"Alizarin Crimson\",\n        \"Phthalo Blue\",\n        \"Permanent Rose\",\n        \"Sepia\",\n        \"Gold Ochre\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
{"_id": "product_search--art_and_craft_su--p--70727", "text": "{\n    \"product_id\": \"WC-SET-24-BG-001\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 39.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent set for beginners! The colors are vibrant and blend beautifully. The landscape color palette is perfect.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's a great quality for the price.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Violet\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Raw Sienna\",\n        \"Burnt Umber\",\n        \"Payne's Gray\",\n        \"Indigo\",\n        \"Olive Green\",\n        \"Peach\",\n        \"Lavender\",\n        \"Rose Madder\",\n        \"Ultramarine\",\n        \"Sap Green\",\n        \"Yellow Ochre\",\n        \"Burnt Sienna\",\n        \"Viridian\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Watercolor Brush (Round - Size 6)\",\n        \"Watercolor Brush (Flat - Size 8)\",\n        \"Palette\",\n        \"Mixing Tray\",\n        \"Instruction Booklet\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 24,\n        \"palette_type\": \"plastic\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--n--70727", "text": "{\n    \"product_id\": \"WC-SET-12-BG-002\",\n    \"product_name\": \"Watercolor Paint Set - Basic\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 25.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good basic set, but the colors are a little pale.\",\n            \"reviewer_name\": \"Emily Carter\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Black\",\n        \"White\",\n        \"Orange\",\n        \"Violet\",\n        \"Brown\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Indigo\"\n    ],\n    \"set_includes\": [\n        \"12 Watercolor Paints\",\n        \"Watercolor Brush (Round - Size 4)\",\n        \"Palette\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"watercolor\",\n        \"number_of_colors\": 12,\n        \"palette_type\": \"plastic\"\n    }\n}"}
{"_id": "product_search--art_and_craft_su--p--70728", "text": "{\n    \"product_id\": \"WC-24-BEGIN-A\",\n    \"product_name\": \"Beginner Watercolor Paint Set - Vibrant Hues\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and blend easily. I felt instantly inspired to start painting.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Great quality for the price. The paints are well-pigmented and the set includes everything you need to get started.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 24,\n        \"paint_type\": \"Pan\",\n        \"includes_brush\": true\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Black\",\n        \"White\",\n        \"Brown\",\n        \"Pink\",\n        \"Violet\",\n        \"Indigo\"\n    ],\n    \"set_includes\": [\n        \"Paint pans\",\n        \"Watercolor brush\",\n        \"Mixing palette\",\n        \"Water cup\"\n    ]\n}"}
{"_id": "product_search--art_and_craft_su--n--70728", "text": "{\n    \"product_id\": \"WC-12-PROF-B\",\n    \"product_name\": \"Professional Watercolor Paint Set - Limited Palette\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints, perfect for experienced artists.\",\n            \"reviewer_name\": \"Sarah Johnson\"\n        },\n        {\n            \"review_text\": \"The pigments are very concentrated, allowing for beautiful washes.\",\n            \"reviewer_name\": \"Michael Brown\"\n        }\n    ],\n    \"release_date\": \"2022-11-20\",\n    \"attributes\": {\n        \"number_of_colors\": 12,\n        \"paint_type\": \"Tube\",\n        \"includes_brush\": false\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Paint tubes\"\n    ]\n}"}
