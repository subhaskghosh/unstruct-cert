{"_id": "product_search--art_and_craft_su--p--70794", "text": "{\n    \"product_id\": \"WS-101\",\n    \"product_name\": \"Beginner Watercolor Painting Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Painting Sets\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! Easy to use and the colors are vibrant. Perfect for practicing landscapes.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loved this set. She's been painting landscapes for hours!\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 12,\n        \"brush_types\": [\n            \"Round\",\n            \"Flat\"\n        ]\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brushes\",\n        \"Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
