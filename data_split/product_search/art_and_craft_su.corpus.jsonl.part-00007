{"_id": "product_search--art_and_craft_su--p--67311", "text": "{\n    \"product_id\": \"WCS-24-VIBRANT\",\n    \"product_name\": \"Vibrant Watercolor Paint Set - 24 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality for the price! The colors are bright and blend beautifully. Perfect for beginners.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My daughter loves this set. It's a great introduction to watercolor painting.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 24,\n        \"pigment_quality\": \"High Pigment\",\n        \"palette_type\": \"Plastic Palette\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brush\",\n        \"Mixing Palette\",\n        \"Water Cup\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
{"_id": "product_search--art_and_craft_su--n--67311", "text": "{\n    \"product_id\": \"WCS-12-PASTEL\",\n    \"product_name\": \"Pastel Watercolor Paint Set - 12 Colors\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Okay for light washes, but the colors are very pale. Not ideal for bold paintings.\",\n            \"reviewer_name\": \"Jessica Brown\"\n        },\n        {\n            \"review_text\": \"Good for sketching, but the pigment isn't very strong.\",\n            \"reviewer_name\": \"Michael Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-10\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"number_of_colors\": 12,\n        \"pigment_quality\": \"Low Pigment\",\n        \"palette_type\": \"Plastic Palette\"\n    },\n    \"color_options\": [\n        \"Light Pink\",\n        \"Light Blue\",\n        \"Pale Yellow\",\n        \"Mint Green\",\n        \"Lavender\",\n        \"Peach\"\n    ],\n    \"set_includes\": [\n        \"Watercolor Paints\",\n        \"Paint Brush\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
