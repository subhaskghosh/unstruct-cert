{"_id": "product_search--art_and_craft_su--p--68906", "text": "{\n    \"product_id\": \"WP-ART-24N\",\n    \"product_name\": \"Artist's Watercolor Palette - Natural Tones\",\n    \"brand\": \"Winsor & Newton\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 69.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints with a lovely, subtle range of colours. Perfect for landscape painting.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"These watercolors are a joy to work with. The pigments are rich and blend beautifully. I'm an experienced artist and highly recommend them.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"color_options\": [\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Yellow Ochre\",\n        \"Payne's Gray\",\n        \"Ultramarine Blue\",\n        \"Viridian\",\n        \"Crimson Lake\",\n        \"Alizarin Crimson\",\n        \"Cadmium Yellow Pale\",\n        \"Cadmium Red Light\",\n        \"Sap Green\",\n        \"Ivory Black\",\n        \"Chinese White\"\n    ],\n    \"set_includes\": [\n        \"24 watercolor paints\",\n        \"Brush\",\n        \"Palette\",\n        \"Mixing tray\"\n    ],\n    \"skill_level\": \"Intermediate\",\n    \"attributes\": {\n        \"paint_type\": \"Professional Grade\",\n        \"pigment_concentration\": \"High\"\n    }\n}"}
