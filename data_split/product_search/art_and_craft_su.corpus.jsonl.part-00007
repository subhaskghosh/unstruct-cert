{"_id": "product_search--art_and_craft_su--p--70398", "text": "{\n    \"product_id\": \"WC-SET-001\",\n    \"product_name\": \"Artist's Watercolor Paint Set - Landscape Edition\",\n    \"brand\": \"CreativeFlow\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This set is perfect for beginners! The colors are vibrant and the included landscape guide is a nice touch.\",\n            \"reviewer_name\": \"Emily Carter\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"number_of_colors\": 36,\n        \"paint_type\": \"Watercolor\",\n        \"set_type\": \"Complete Set\",\n        \"palette_type\": \"Removable\"\n    },\n    \"color_options\": [\n        \"Red\",\n        \"Yellow\",\n        \"Blue\",\n        \"Green\",\n        \"Orange\",\n        \"Purple\",\n        \"Brown\",\n        \"Black\",\n        \"White\"\n    ],\n    \"set_includes\": [\n        \"Watercolor paints\",\n        \"Paint brushes\",\n        \"Watercolor paper pad\",\n        \"Mixing palette\",\n        \"Landscape painting guide\"\n    ],\n    \"skill_level\": \"beginner\"\n}"}
