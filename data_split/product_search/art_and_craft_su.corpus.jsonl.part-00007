{"_id": "product_search--art_and_craft_su--p--68966", "text": "{\n    \"product_id\": \"WC-SET-123\",\n    \"product_name\": \"Beginner Watercolor Paint Set\",\n    \"brand\": \"Artify\",\n    \"category\": \"Watercolor Paints\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great set for beginners! The colors are vibrant and easy to blend.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"This set is exactly what I needed to start my watercolor journey. Very calming and inspiring!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"color_options\": [\n        \"Red\",\n        \"Blue\",\n        \"Yellow\",\n        \"Green\",\n        \"Purple\",\n        \"Orange\",\n        \"Brown\",\n        \"Black\",\n        \"White\",\n        \"Crimson\",\n        \"Cerulean\",\n        \"Lemon Yellow\",\n        \"Viridian\",\n        \"Violet\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Payne's Gray\",\n        \"Ivory Black\",\n        \"Titanium White\",\n        \"Cadmium Red Light\",\n        \"Ultramarine Blue\",\n        \"Cadmium Yellow Medium\",\n        \"Phthalo Green\",\n        \"Dioxazine Violet\"\n    ],\n    \"set_includes\": [\n        \"24 Watercolor Paints\",\n        \"Paintbrush\",\n        \"Mixing Palette\",\n        \"Watercolor Paper Pad\"\n    ],\n    \"skill_level\": \"beginner\",\n    \"attributes\": {\n        \"paint_type\": \"Watercolor\",\n        \"paper_weight\": \"140lb\",\n        \"number_of_colors\": 24\n    }\n}"}
