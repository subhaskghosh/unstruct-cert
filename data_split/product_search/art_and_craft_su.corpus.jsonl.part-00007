{"_id": "product_search--art_and_craft_su--n--71122", "text": "{\n    \"product_id\": \"AP8PR\",\n    \"product_name\": \"Professional Acrylic Paint Set\",\n    \"brand\": \"ArtMaster\",\n    \"category\": \"Acrylic Paints\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality paints for serious artists. Highly pigmented and durable.\",\n            \"reviewer_name\": \"ProArtist\"\n        },\n        {\n            \"review_text\": \"These paints are fantastic for detailed work. A bit pricey, but worth it.\",\n            \"reviewer_name\": \"StudioArtist\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"number_of_colors\": 8,\n        \"paint_type\": \"Acrylic\",\n        \"toxicity\": \"Contains Solvents\"\n    },\n    \"color_options\": [\n        \"Titanium White\",\n        \"Ivory Black\",\n        \"Cadmium Red\",\n        \"Ultramarine Blue\",\n        \"Burnt Sienna\",\n        \"Raw Umber\",\n        \"Yellow Ochre\",\n        \"Phthalo Green\"\n    ],\n    \"set_includes\": [\n        \"Acrylic Paints (8 colors)\",\n        \"Palette Knife\",\n        \"Mixing Medium\"\n    ],\n    \"skill_level\": \"intermediate\"\n}"}
