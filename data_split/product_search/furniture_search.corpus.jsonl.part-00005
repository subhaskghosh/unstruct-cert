{"_id": "product_search--furniture_search--p--71320", "text": "{\n    \"product_name\": \"Leather Modern Sofa\",\n    \"category\": \"Sofa\",\n    \"brand\": \"Urban Comfort\",\n    \"material\": \"Leather\",\n    \"style\": \"Modern\",\n    \"price\": 1299.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"product_id\": \"UC-LS-001\",\n    \"release_date\": \"2022-05-15\",\n    \"dimensions\": {\n        \"height\": 32,\n        \"width\": 85,\n        \"depth\": 35\n    },\n    \"attributes\": {\n        \"color\": \"Brown\",\n        \"seat_capacity\": 3,\n        \"description\": \"This modern leather sofa is designed for ultimate comfort and relaxation. Its plush cushions and durable construction make it perfect for any living room.\"\n    },\n    \"reviews\": [\n        {\n            \"reviewer_name\": \"Alice Smith\",\n            \"review_text\": \"Absolutely love this sofa! It's so comfortable and looks great in my living room.\"\n        }\n    ]\n}"}
