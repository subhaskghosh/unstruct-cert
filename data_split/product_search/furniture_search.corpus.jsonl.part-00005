{"_id": "product_search--furniture_search--p--68068", "text": "{\n    \"product_id\": \"SF-LTR-MDN-001\",\n    \"product_name\": \"Leather Modern Sofa - Cloud Comfort\",\n    \"brand\": \"CozyHome\",\n    \"category\": \"Sofas\",\n    \"material\": \"Leather\",\n    \"style\": \"Modern\",\n    \"dimensions\": {\n        \"height\": 32,\n        \"width\": 88,\n        \"depth\": 35\n    },\n    \"price\": 1299.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This sofa is incredibly comfortable! The leather is soft, and the cushions are perfect. It's exactly what I wanted for my living room.\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"Great quality sofa. Easy to assemble and looks fantastic. Highly recommend!\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-09-15\",\n    \"attributes\": {\n        \"color\": \"Brown\",\n        \"seat_capacity\": 3\n    }\n}"}
