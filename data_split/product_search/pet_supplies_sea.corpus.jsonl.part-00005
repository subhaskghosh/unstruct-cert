{"_id": "product_search--pet_supplies_sea--p--64246", "text": "{\n    \"pet_type\": \"dog\",\n    \"ingredients\": [\n        \"chicken\",\n        \"sweet potato\",\n        \"peas\",\n        \"salmon oil\"\n    ],\n    \"weight\": 4.0,\n    \"product_id\": \"DF-G-40-001\",\n    \"product_name\": \"Grain-Free Chicken & Sweet Potato Recipe\",\n    \"brand\": \"Happy Paws\",\n    \"category\": \"dog food\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"My dog loves this food! He's a very picky eater and usually turns his nose up at everything, but he gobbles this down. I also love that it's grain-free and seems to be really good for his digestion.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Great quality ingredients and my dog's coat looks so much healthier since switching to this food.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"life_stage\": \"adult\",\n        \"breed_size\": \"small/medium\"\n    }\n}"}
