{"_id": "product_search--beauty_products_--p--70649", "text": "{\n    \"product_id\": \"HM-001\",\n    \"product_name\": \"Calming Rose Hydration Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels soothed and hydrated.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that doesn't irritate my skin. It feels really rich and luxurious.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"rose water\",\n        \"hyaluronic acid\",\n        \"shea butter\",\n        \"chamomile extract\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"cream\",\n        \"fragrance\": \"rose\"\n    }\n}"}
