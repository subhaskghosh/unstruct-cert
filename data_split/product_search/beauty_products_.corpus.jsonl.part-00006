{"_id": "product_search--beauty_products_--p--70046", "text": "{\n    \"product_id\": \"MOIST-SENS-001\",\n    \"product_name\": \"Soothing Aloe & Chamomile Facial Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Hyaluronic Acid\",\n        \"Shea Butter\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-05-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It really calms my sensitive skin and leaves it feeling so soft.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"attributes\": {\n        \"texture\": \"lightweight cream\",\n        \"fragrance\": \"subtle floral\"\n    }\n}"}
