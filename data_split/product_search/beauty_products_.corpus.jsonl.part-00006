{"_id": "product_search--beauty_products_--p--71540", "text": "{\n    \"product_id\": \"moist-sens-001\",\n    \"product_name\": \"Calm & Glow Hydrating Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels soothed and hydrated, and I've noticed a real glow.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that doesn't irritate my skin. Love the light, natural scent.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Green Tea Extract\",\n        \"Jojoba Oil\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"scent\": \"Natural Lavender\",\n        \"fragrance_free\": false\n    }\n}"}
