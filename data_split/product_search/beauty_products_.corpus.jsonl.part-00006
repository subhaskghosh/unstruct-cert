{"_id": "product_search--beauty_products_--p--70699", "text": "{\n    \"product_id\": \"LR-HYD-FAC-001\",\n    \"product_name\": \"La Roche-Posay Toleriane Double Repair Face Moisturizer UV SPF 30\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's very hydrating and leaves a healthy glow.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've tried many moisturizers, and this is the best one for dry, sensitive skin. It absorbs quickly and doesn't cause breakouts.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramide\",\n        \"Niacinamide\",\n        \"Glycerin\",\n        \"SPF 30\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"finish\": \"glowy\",\n        \"SPF\": \"30\"\n    }\n}"}
