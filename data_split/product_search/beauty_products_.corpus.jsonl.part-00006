{"_id": "product_search--beauty_products_--p--71410", "text": "{\n    \"product_id\": \"hydr-sens-001\",\n    \"product_name\": \"Soothing Aloe Vera Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"face moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that doesn't irritate my skin. I love the natural ingredients.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"glycerin\",\n        \"chamomile extract\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight\",\n        \"fragrance_level\": \"low\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71410", "text": "{\n    \"product_id\": \"rich-anti-age-005\",\n    \"product_name\": \"Luxury Anti-Aging Cream\",\n    \"brand\": \"Elysian Beauty\",\n    \"category\": \"face moisturizer\",\n    \"price\": 49.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"A very luxurious cream, felt my skin was much softer after just one use.\",\n            \"reviewer_name\": \"Sarah J.\"\n        },\n        {\n            \"review_text\": \"Effective, but a little pricey.\",\n            \"reviewer_name\": \"Mark T.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"mature\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"hyaluronic acid\",\n        \"vitamin C\",\n        \"fragrance\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"rich\",\n        \"fragrance_level\": \"high\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71411", "text": "{\n    \"product_id\": \"M001\",\n    \"product_name\": \"Gentle Hydration Daily Moisturizer\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"Moisturizer\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and has really helped calm my sensitive skin.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Love this! No irritation and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"hyaluronic acid\",\n        \"ceramides\",\n        \"dimethicone\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"cruelty_free\": true,\n        \"fragrance_free\": true,\n        \"texture\": \"lightweight lotion\"\n    }\n}"}
