{"_id": "product_search--beauty_products_--p--70895", "text": "{\n    \"product_id\": \"FM001\",\n    \"product_name\": \"Calming Hydration Face Cream\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 32.5,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels soothed and hydrated. The lavender scent is very relaxing.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've ever used for my redness-prone skin. Definitely worth the price.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Chamomile Extract\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"lavender\",\n        \"texture\": \"lightweight cream\"\n    }\n}"}
