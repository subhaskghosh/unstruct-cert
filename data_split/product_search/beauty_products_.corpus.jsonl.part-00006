{"_id": "product_search--beauty_products_--p--70339", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Soothing Aloe Vera Moisturizer\",\n    \"brand\": \"Nature's Bloom\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"hyaluronic acid\",\n        \"chamomile\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-03-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I've tried so many moisturizers, and this is the only one that doesn't irritate my skin. Highly recommend!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"2oz\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
