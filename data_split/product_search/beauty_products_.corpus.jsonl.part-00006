{"_id": "product_search--beauty_products_--p--71222", "text": "{\n    \"product_id\": \"FML001\",\n    \"product_name\": \"Calming Hydration Face Cream\",\n    \"brand\": \"GentleBloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating without feeling greasy. I've struggled with redness for years, and this has really helped calm it down.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that doesn't irritate my skin. Love the light texture!\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Glycerin\",\n        \"Ceramides\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"weight\": \"1.7 oz\",\n        \"texture\": \"lightweight lotion\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71222", "text": "{\n    \"product_id\": \"FML002\",\n    \"product_name\": \"Radiance Boosting Night Cream\",\n    \"brand\": \"GlowSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"My skin looks amazing after using this! It's a bit pricey, but worth it for the glow.\",\n            \"reviewer_name\": \"Jessica L.\"\n        },\n        {\n            \"review_text\": \"Great product, but might be too rich for oily skin.\",\n            \"reviewer_name\": \"Amanda P.\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Vitamin C\",\n        \"Peptides\",\n        \"Niacinamide\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"weight\": \"2.0 oz\",\n        \"texture\": \"rich cream\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71223", "text": "{\n    \"product_id\": \"FMC001\",\n    \"product_name\": \"Soothing Aloe Vera Moisturizer\",\n    \"brand\": \"Natural Radiance\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I love that this is made with natural ingredients. My skin feels so much better since I started using it.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"2 oz\",\n        \"fragrance\": \"unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"green tea extract\"\n    ]\n}"}
