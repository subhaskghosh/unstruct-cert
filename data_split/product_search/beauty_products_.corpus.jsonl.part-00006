{"_id": "product_search--beauty_products_--p--71225", "text": "{\n    \"product_id\": \"hydra-sens-001\",\n    \"product_name\": \"Soothing Hyaluronic Face Cream\",\n    \"brand\": \"AquaBloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Glycerin\",\n        \"Ceramides\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-10-26\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly lightweight and absorbs quickly. It's perfect for my sensitive skin!\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I have dry, sensitive skin and this is the only moisturizer that doesn't irritate it. Feels very hydrating without being greasy.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance_free\": true\n    }\n}"}
