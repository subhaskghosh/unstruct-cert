{"_id": "product_search--beauty_products_--p--71292", "text": "{\n    \"product_id\": \"CERV_HYD_FACE_001\",\n    \"product_name\": \"CeraVe Hydrating Facial Moisturizer\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It really calmed my redness.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"Great for everyday use. Doesn't irritate my skin at all.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"fragrance_free\": true\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71292", "text": "{\n    \"product_id\": \"CERV_HYD_BODY_002\",\n    \"product_name\": \"CeraVe Hydrating Body Lotion\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"body lotion\",\n    \"price\": 18.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Works well for dry skin, leaves it feeling smooth.\",\n            \"reviewer_name\": \"Alice Brown\"\n        },\n        {\n            \"review_text\": \"Good value for the amount of lotion you get.\",\n            \"reviewer_name\": \"Bob Williams\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"body\",\n    \"attributes\": {\n        \"size\": \"32 oz\",\n        \"fragrance_free\": true\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71293", "text": "{\n    \"product_id\": \"M00123\",\n    \"product_name\": \"HydraBalance Moisturizer\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle on my sensitive skin and really hydrates without feeling greasy.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin. Lightweight and effective.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"ceramides\",\n        \"glycerin\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_level\": \"low\",\n        \"texture\": \"lightweight lotion\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71293", "text": "{\n    \"product_id\": \"M00456\",\n    \"product_name\": \"Rich Renewal Cream\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This is a very rich cream, perfect for dry skin in the winter.\",\n            \"reviewer_name\": \"Sarah K.\"\n        },\n        {\n            \"review_text\": \"A bit heavy for everyday use, but great as a night cream.\",\n            \"reviewer_name\": \"Michael B.\"\n        }\n    ],\n    \"release_date\": \"2024-02-01\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"shea butter\",\n        \"retinol\",\n        \"peptides\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_level\": \"medium\",\n        \"texture\": \"thick cream\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71294", "text": "{\n    \"product_id\": \"FM001\",\n    \"product_name\": \"Calm Hydration Facial Cream\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Glycerin\",\n        \"Chamomile Extract\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-10-26\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It really calmed my sensitive skin and keeps it hydrated all day.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"The texture is so smooth and luxurious. My skin feels incredible!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"attributes\": {\n        \"fragrance\": \"light, natural\"\n    }\n}"}
