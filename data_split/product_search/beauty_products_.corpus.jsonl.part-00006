{"_id": "product_search--beauty_products_--p--71583", "text": "{\n    \"product_id\": \"FM001\",\n    \"product_name\": \"Calming Aloe Vera Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"face moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"glycerin\",\n        \"chamomile extract\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-03-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle and really calms my sensitive skin. I've noticed a huge difference in redness and dryness.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Perfect for sensitive skin. Doesn't cause any irritation and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"2 oz\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
