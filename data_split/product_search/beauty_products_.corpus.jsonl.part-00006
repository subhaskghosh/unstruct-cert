{"_id": "product_search--beauty_products_--p--71669", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Green Tea Extract\",\n        \"Jojoba Oil\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"HydraRenew Daily Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle on my sensitive skin and leaves my face feeling incredibly hydrated. The scent is subtle and refreshing.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've ever used. My skin has never felt so soft and supple.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"scent\": \"Green Tea & Cucumber\",\n        \"texture\": \"Lightweight Cream\"\n    }\n}"}
