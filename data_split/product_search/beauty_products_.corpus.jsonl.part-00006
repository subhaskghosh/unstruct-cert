{"_id": "product_search--beauty_products_--n--71957", "text": "{\n    \"product_id\": \"CET5678\",\n    \"product_name\": \"Cetaphil Moisturizing Cream with Fragrance\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"moisturizer\",\n    \"price\": 18.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"dimethicone\",\n        \"fragrance\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-01-20\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is very moisturizing, but the fragrance is a bit strong for my sensitive skin.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Good hydration, but I wish there was a fragrance-free version.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"attributes\": {\n        \"fragrance_free\": false\n    }\n}"}
