{"_id": "product_search--beauty_products_--p--71836", "text": "{\n    \"product_id\": \"fm-1234\",\n    \"product_name\": \"Hydrating Hyaluronic Acid Face Moisturizer\",\n    \"brand\": \"GentleBloom\",\n    \"category\": \"moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels so hydrated and calm.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Perfect for dry, sensitive skin. Doesn't cause breakouts!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"fragrance\": \"light floral\",\n        \"cruelty_free\": true,\n        \"ingredients_list\": \"Water, Hyaluronic Acid, Glycerin, Aloe Vera, Chamomile Extract\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"aloe vera\"\n    ],\n    \"application_area\": \"face\"\n}"}
