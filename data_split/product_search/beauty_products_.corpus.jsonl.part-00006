{"_id": "product_search--beauty_products_--p--71145", "text": "{\n    \"product_id\": \"F00123\",\n    \"product_name\": \"Soothing Daily Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and keeps my skin hydrated all day. Perfect for sensitive skin!\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I've tried so many moisturizers, and this one is a winner! Lightweight and doesn't irritate my skin.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"ceramides\",\n        \"hyaluronic acid\",\n        \"thermal spring water\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"fragrance\": \"fragrance-free\"\n    }\n}"}
