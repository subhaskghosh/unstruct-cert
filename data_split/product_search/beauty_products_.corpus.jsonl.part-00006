{"_id": "product_search--beauty_products_--p--71003", "text": "{\n    \"product_id\": \"MSTRZ-SENS-001\",\n    \"product_name\": \"Calming Sensitive Skin Moisturizer\",\n    \"brand\": \"GentleBloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It really calms redness and keeps my skin hydrated without irritation.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"I've been struggling with redness for years, and this is the first moisturizer that has made a noticeable difference.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_level\": \"low\",\n        \"cruelty_free\": true\n    }\n}"}
