{"_id": "product_search--beauty_products_--p--70766", "text": "{\n    \"product_id\": \"MZR-SENS-001\",\n    \"product_name\": \"HydraCalm Luxe Moisturizer\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle on my sensitive skin and feels incredibly hydrating. The texture is rich but not greasy.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I've been struggling with redness for years, and this is the first moisturizer that has truly calmed my skin. Highly recommend!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Ceramides\",\n        \"Shea Butter\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"Cream\",\n        \"fragrance\": \"Unscented\"\n    }\n}"}
