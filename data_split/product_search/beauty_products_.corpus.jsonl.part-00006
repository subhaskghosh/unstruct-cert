{"_id": "product_search--beauty_products_--p--71647", "text": "{\n    \"product_id\": \"moist-night-sens-001\",\n    \"product_name\": \"Nightly Renewal Hydrating Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating, and I wake up with a glowing complexion.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Absolutely love this! My skin feels so soft and nourished. No irritation at all.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"type\": \"night cream\",\n        \"fragrance\": \"unscented\",\n        \"texture\": \"creamy\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"ceramides\",\n        \"niacinamide\",\n        \"hyaluronic acid\"\n    ]\n}"}
