{"_id": "product_search--beauty_products_--p--71038", "text": "{\n    \"product_id\": \"hydra_sens_001\",\n    \"product_name\": \"Calm & Hydrate Facial Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's incredibly hydrating without being greasy.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Finally found a moisturizer that doesn't irritate my skin. Love the lightweight texture!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"size\": \"1.7 oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"ceramides\",\n        \"thermal spring water\",\n        \"niacinamide\"\n    ],\n    \"application_area\": \"face\"\n}"}
