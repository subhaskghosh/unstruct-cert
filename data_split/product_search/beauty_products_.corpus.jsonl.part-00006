{"_id": "product_search--beauty_products_--p--70814", "text": "{\n    \"product_id\": \"CTP-HD-FS-50\",\n    \"product_name\": \"Cetaphil Hydrating Facial Moisturizer with Hyaluronic Acid\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"Moisturizer\",\n    \"price\": 15.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and hydrating. My sensitive skin loves it!\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Great for daily use, especially in the winter. No irritation whatsoever.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance_free\": true,\n        \"key_ingredients\": [\n            \"Hyaluronic Acid\",\n            \"Glycerin\",\n            \"Vitamin E\"\n        ]\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Water\",\n        \"Glycerin\",\n        \"Hyaluronic Acid\",\n        \"Caprylic/Capric Triglyceride\",\n        \"Dimethicone\",\n        \"Phenoxyethanol\",\n        \"Tocopheryl Acetate\"\n    ]\n}"}
