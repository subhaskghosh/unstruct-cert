{"_id": "product_search--beauty_products_--p--71118", "text": "{\n    \"product_id\": \"moist-sens-001\",\n    \"product_name\": \"Calm & Renew Daily Moisturizer\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is fantastic for my sensitive skin! No irritation and feels very hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've noticed a real difference in my skin's texture since using this. It's lightweight and absorbs quickly.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"ceramides\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_free\": true\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71118", "text": "{\n    \"product_id\": \"moist-glow-002\",\n    \"product_name\": \"Radiant Glow Face Cream\",\n    \"brand\": \"L'Oreal\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.5,\n    \"availability\": true,\n    \"rating\": 4.3,\n    \"reviews\": [\n        {\n            \"review_text\": \"Gives a lovely glow to the skin, but the scent is a bit strong.\",\n            \"reviewer_name\": \"Emily C.\"\n        },\n        {\n            \"review_text\": \"I liked the texture, but it made my sensitive skin a little red.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"oily\"\n    ],\n    \"ingredients\": [\n        \"vitamin c\",\n        \"retinol\",\n        \"fragrance\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_free\": false\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71119", "text": "{\n    \"product_id\": \"hydra_sens_001\",\n    \"product_name\": \"Soothing Rose Hydration Cream\",\n    \"brand\": \"Bloom Naturals\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating, and the rose scent is lovely.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin. I use it every day and my skin feels amazing!\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"rose water\",\n        \"hyaluronic acid\",\n        \"aloe vera\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"scent\": \"floral\",\n        \"texture\": \"lightweight cream\"\n    }\n}"}
