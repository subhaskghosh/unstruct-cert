{"_id": "product_search--beauty_products_--p--71054", "text": "{\n    \"product_id\": \"FC001\",\n    \"product_name\": \"Calm Blossom Facial Cream\",\n    \"brand\": \"Everbloom Naturals\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing! My sensitive skin feels soothed and hydrated. The scent is lovely and subtle.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've ever used. Lightweight and really effective.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-27\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"Floral\",\n        \"texture\": \"Lightweight Cream\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Jojoba Oil\",\n        \"Hyaluronic Acid\"\n    ]\n}"}
