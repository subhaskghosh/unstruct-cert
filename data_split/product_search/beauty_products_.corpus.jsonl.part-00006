{"_id": "product_search--beauty_products_--p--71784", "text": "{\n    \"product_id\": \"M001\",\n    \"product_name\": \"Gentle Hydration Daily Moisturizer\",\n    \"brand\": \"Bloom & Glow\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for sensitive skin! It's so gentle and hydrating, and doesn't cause any irritation. I love how lightweight it feels.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Finally found a moisturizer that doesn't break me out! The natural ingredients are a plus.\",\n            \"reviewer_name\": \"Emily Davis\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"texture\": \"Lightweight lotion\",\n        \"fragrance\": \"Fragrance-free\",\n        \"size\": \"2oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Green Tea Extract\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
