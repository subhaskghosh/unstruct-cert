{"_id": "product_search--beauty_products_--n--71699", "text": "{\n    \"product_id\": \"CVR-FM-ACNE-02\",\n    \"product_name\": \"CeraVe Facial Moisturizing Lotion AM with SPF 30\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 18.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for oily skin, helps with breakouts. A little drying for my sensitive skin, though.\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"Provides good sun protection, but the scent is a little strong for me.\",\n            \"reviewer_name\": \"Michael B.\"\n        }\n    ],\n    \"release_date\": \"2023-01-20\",\n    \"attributes\": {\n        \"size\": \"3 oz\",\n        \"fragrance\": \"lightly scented\",\n        \"spf\": \"30\"\n    },\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"acne-prone\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Niacinamide\",\n        \"Zinc Oxide\"\n    ],\n    \"application_area\": \"face\"\n}"}
