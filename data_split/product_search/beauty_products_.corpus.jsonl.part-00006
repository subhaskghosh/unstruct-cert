{"_id": "product_search--beauty_products_--p--70862", "text": "{\n    \"product_id\": \"CET12345\",\n    \"product_name\": \"Cetaphil Moisturizing Cream\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"Moisturizer\",\n    \"price\": 15.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for sensitive skin! It's very hydrating and doesn't cause any irritation. Feels rich and luxurious.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Great moisturizer, especially for dry, sensitive skin. Lightweight but effective.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"size\": \"16 oz\",\n        \"fragrance\": \"Fragrance-Free\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"water\",\n        \"dimethicone\",\n        \"cetyl alcohol\"\n    ]\n}"}
