{"_id": "product_search--beauty_products_--p--70779", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Calming Rose Hydration Moisturizer\",\n    \"brand\": \"SereneBloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels soothed and hydrated. The rose scent is subtle and relaxing.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've ever used for my redness-prone skin. It's lightweight and absorbs quickly.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"Rose\",\n        \"cruelty_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Rose Water\",\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Jojoba Oil\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--70779", "text": "{\n    \"product_id\": \"FM67890\",\n    \"product_name\": \"Brightening Vitamin C Cream\",\n    \"brand\": \"GlowSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream really brightened my complexion! A little goes a long way.\",\n            \"reviewer_name\": \"Sarah K.\"\n        },\n        {\n            \"review_text\": \"Great product for evening out skin tone, but can be a bit strong for sensitive skin.\",\n            \"reviewer_name\": \"Michael B.\"\n        }\n    ],\n    \"release_date\": \"2023-07-20\",\n    \"attributes\": {\n        \"size\": \"2 oz\",\n        \"fragrance\": \"Citrus\",\n        \"cruelty_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Vitamin C\",\n        \"Hyaluronic Acid\",\n        \"Green Tea Extract\"\n    ],\n    \"application_area\": \"face\"\n}"}
