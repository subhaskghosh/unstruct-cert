{"_id": "product_search--beauty_products_--p--71712", "text": "{\n    \"product_id\": \"MOIST-SENS-001\",\n    \"product_name\": \"Calm & Hydrate Facial Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It really calmed down my redness and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Great product, doesn't irritate my skin at all.\",\n            \"reviewer_name\": \"John S.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"ceramides\",\n        \"thermal spring water\",\n        \"niacinamide\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_free\": true,\n        \"paraben_free\": true,\n        \"size_ml\": 50\n    }\n}"}
