{"_id": "product_search--beauty_products_--p--70980", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"dimethicone\",\n        \"sunflower seed oil\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"CET-MOIST-SENS-001\",\n    \"product_name\": \"Cetaphil Daily Hydrating Lotion\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"moisturizer\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is perfect for my sensitive skin. It's very lightweight and doesn't cause breakouts.\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"Great daily moisturizer! Doesn't feel greasy and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"16 fl oz\",\n        \"fragrance\": \"fragrance-free\",\n        \"texture\": \"lightweight lotion\"\n    }\n}"}
