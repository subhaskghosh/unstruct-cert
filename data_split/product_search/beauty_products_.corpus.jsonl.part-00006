{"_id": "product_search--beauty_products_--p--70118", "text": "{\n    \"product_id\": \"cerave_hydrating_moist_001\",\n    \"product_name\": \"CeraVe Hydrating Facial Moisturizer\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for sensitive skin! It's so gentle and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've struggled with redness for years, and this has really calmed my skin down. Highly recommend!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2020-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"SPF\": 0\n    }\n}"}
