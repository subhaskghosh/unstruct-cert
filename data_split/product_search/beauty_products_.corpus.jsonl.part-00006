{"_id": "product_search--beauty_products_--p--71420", "text": "{\n    \"product_id\": \"FC-SENS-NAT-001\",\n    \"product_name\": \"Gentle Oat & Aloe Cleanser\",\n    \"brand\": \"Nature's Remedy\",\n    \"category\": \"Cleanser\",\n    \"price\": 22.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cleanser is amazing for my sensitive skin! It's so gentle and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I love that this cleanser is made with natural ingredients and actually works to cleanse my skin without stripping it.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-07-15\",\n    \"attributes\": {\n        \"fragrance\": \"Unscented\",\n        \"skin_feel\": \"Refreshed\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"oat extract\",\n        \"aloe vera\",\n        \"glycerin\",\n        \"chamomile\"\n    ]\n}"}
