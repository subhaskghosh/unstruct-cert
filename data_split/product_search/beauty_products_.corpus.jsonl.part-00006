{"_id": "product_search--beauty_products_--p--71621", "text": "{\n    \"product_id\": \"cerave_hydrating_moist_123\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 18.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"I love that it doesn't have a strong scent and feels light on my face.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"weight\": \"19 oz\",\n        \"fragrance_level\": \"Unscented\"\n    }\n}"}
