{"_id": "product_search--beauty_products_--p--71327", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"chamomile extract\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"MSTR-0012\",\n    \"product_name\": \"Calming Hydration Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's very hydrating and doesn't cause any irritation. The scent is so calming.\",\n            \"reviewer_name\": \"Sarah J.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that works for my dry, sensitive skin! I love the natural ingredients.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"scent\": \"lavender\",\n        \"size\": \"1.7oz\"\n    }\n}"}
