{"_id": "product_search--beauty_products_--p--71019", "text": "{\n    \"product_id\": \"moist_sens_001\",\n    \"product_name\": \"Calming Botanical Moisturizer\",\n    \"brand\": \"Willow Bloom\",\n    \"category\": \"moisturizer\",\n    \"price\": 22.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is fantastic! My sensitive skin feels soothed and hydrated, and it doesn't cause any breakouts.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Lightweight and effective. Perfect for daily use, even under makeup.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"chamomile extract\",\n        \"jojoba oil\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71019", "text": "{\n    \"product_id\": \"moist_rich_005\",\n    \"product_name\": \"Intense Renewal Night Cream\",\n    \"brand\": \"AuraGlow\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Rich and luxurious! A little goes a long way.\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"My skin feels so hydrated after using this. A bit too heavy for daytime, though.\",\n            \"reviewer_name\": \"Maria S.\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"hyaluronic acid\",\n        \"shea butter\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"rich cream\",\n        \"fragrance\": \"floral\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71020", "text": "{\n    \"product_id\": \"moist_sens_001\",\n    \"product_name\": \"Soothing Hydra-Boost Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for sensitive skin! It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that calms my redness! Highly recommend.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"attributes\": {\n        \"fragrance_free\": true,\n        \"size\": \"1.7 oz\",\n        \"key_ingredients\": [\n            \"Ceramides\",\n            \"Glycerin\",\n            \"Thermal Spring Water\"\n        ]\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Water\",\n        \"Glycerin\",\n        \"Ceramides\",\n        \"Butyrospermum Parkii Butter\",\n        \"Sodium Hyaluronate\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--n--71020", "text": "{\n    \"product_id\": \"moist_sens_002\",\n    \"product_name\": \"Radiant Glow Facial Cream\",\n    \"brand\": \"Olay\",\n    \"category\": \"moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good moisturizer, feels light on the skin.\",\n            \"reviewer_name\": \"Sarah K.\"\n        },\n        {\n            \"review_text\": \"A decent everyday cream. Not amazing, but does the job.\",\n            \"reviewer_name\": \"David B.\"\n        }\n    ],\n    \"release_date\": \"2023-11-01\",\n    \"attributes\": {\n        \"fragrance_free\": false,\n        \"size\": \"2.0 oz\",\n        \"key_ingredients\": [\n            \"Vitamin C\",\n            \"Niacinamide\",\n            \"Fragrance\"\n        ]\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Water\",\n        \"Glycerin\",\n        \"Vitamin C\",\n        \"Niacinamide\",\n        \"Fragrance\",\n        \"Dimethicone\"\n    ]\n}"}
