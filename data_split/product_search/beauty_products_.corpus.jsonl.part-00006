{"_id": "product_search--beauty_products_--p--70954", "text": "{\n    \"product_id\": \"cerave_hydrating_moisturizer_sensitive_001\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 18.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've been using this for years and it's the only thing that keeps my skin from drying out.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2018-01-15\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"skin_type\": \"sensitive, dry, normal\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"ceramides\",\n        \"hyaluronic acid\",\n        \"glycerin\"\n    ]\n}"}
