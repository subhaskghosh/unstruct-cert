{"_id": "product_search--beauty_products_--p--71919", "text": "{\n    \"product_id\": \"moist-sens-001\",\n    \"product_name\": \"Gentle Hydration Facial Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels soothed and hydrated. No irritation at all.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't cause breakouts. I love the natural ingredients.\",\n            \"reviewer_name\": \"Emily Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"fragrance\": \"fragrance-free\",\n        \"size\": \"2oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"hyaluronic acid\",\n        \"chamomile extract\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\"\n}"}
