{"_id": "product_search--beauty_products_--p--71175", "text": "{\n    \"product_id\": \"moist-sens-001\",\n    \"product_name\": \"Soothing Aloe & Shea Facial Cream\",\n    \"brand\": \"Natural Radiance\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I love the natural ingredients and the subtle, calming scent. Perfect for daily use.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"fragrance_level\": \"Low\",\n        \"texture\": \"Creamy\",\n        \"size\": \"2oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"shea butter\",\n        \"hyaluronic acid\",\n        \"vitamin E\"\n    ]\n}"}
