{"_id": "product_search--beauty_products_--p--71363", "text": "{\n    \"product_id\": \"cerave_hydrating_moisturizer_sensitive\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This is a lifesaver for my dry, sensitive skin! It's lightweight and doesn't irritate at all.\",\n            \"reviewer_name\": \"Sarah M.\"\n        }\n    ],\n    \"release_date\": \"2018-03-15\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"skin_feel\": \"lightweight\",\n        \"fragrance_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"sensitive\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--n--71363", "text": "{\n    \"product_id\": \"cerave_pm_facial_moisturizer\",\n    \"product_name\": \"CeraVe PM Facial Moisturizing Lotion\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 18.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for nighttime use, feels very hydrating.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2020-07-01\",\n    \"attributes\": {\n        \"size\": \"3 oz\",\n        \"skin_feel\": \"rich\",\n        \"fragrance_free\": false\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"normal\",\n        \"oily\"\n    ],\n    \"ingredients\": [\n        \"Niacinamide\",\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Fragrance\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--p--71364", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Glycerin\",\n        \"Ceramides\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"FCM-00123\",\n    \"product_name\": \"Calming Hydration Moisturizer\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and really calms down any redness I have.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I've struggled with dry, sensitive skin for years, and this is the first moisturizer that's actually worked. It's incredibly hydrating!\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"attributes\": {\n        \"fragrance_free\": true,\n        \"paraben_free\": true\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71364", "text": "{\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Salicylic Acid\",\n        \"Tea Tree Oil\",\n        \"Glycolic Acid\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"FCM-00456\",\n    \"product_name\": \"Clarifying Acne Treatment\",\n    \"brand\": \"ClearSolutions\",\n    \"category\": \"treatment\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This really helped clear up my breakouts, but it can be a little drying.\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"Effective at controlling oil, but definitely not for sensitive skin.\",\n            \"reviewer_name\": \"Michael B.\"\n        }\n    ],\n    \"release_date\": \"2023-01-15\",\n    \"attributes\": {\n        \"oil_control\": true,\n        \"non_comedogenic\": true\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71365", "text": "{\n    \"product_id\": \"FMO123\",\n    \"product_name\": \"Calming Daily Face Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels soothed and hydrated. It's lightweight and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Helped calm my redness and dryness. Highly recommend for sensitive skin!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"size\": \"2 oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Hyaluronic Acid\",\n        \"Jojoba Oil\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--71365", "text": "{\n    \"product_id\": \"FMO456\",\n    \"product_name\": \"Rejuvenating Anti-Aging Cream\",\n    \"brand\": \"Luxury Skincare\",\n    \"category\": \"Cream\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is very rich and hydrating, but it might be too heavy for some skin types.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I noticed a slight improvement in my wrinkles after a few weeks of use.\",\n            \"reviewer_name\": \"David K.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"texture\": \"rich cream\",\n        \"size\": \"1.7 oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Vitamin C\",\n        \"Peptides\",\n        \"Shea Butter\"\n    ],\n    \"application_area\": \"face\"\n}"}
