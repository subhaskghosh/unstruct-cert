{"_id": "product_search--beauty_products_--n--71958", "text": "{\n    \"product_id\": \"Cetaphil-Moist-Dry-200ml\",\n    \"product_name\": \"Cetaphil Moisturizing Cream\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"moisturizer\",\n    \"price\": 15.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good basic moisturizer, but a bit greasy for my skin.\",\n            \"reviewer_name\": \"David S.\"\n        },\n        {\n            \"review_text\": \"Effective for dry skin, but doesn't have a luxurious feel.\",\n            \"reviewer_name\": \"Sarah K.\"\n        }\n    ],\n    \"release_date\": \"2019-11-01\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"sensitive\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Petrolatum\",\n        \"Dimethicone\"\n    ],\n    \"application_area\": \"body\",\n    \"attributes\": {\n        \"size\": \"200ml\",\n        \"fragrance\": \"lightly scented\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71959", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"ceramides\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"FC00123\",\n    \"product_name\": \"Soothing Moisture Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"face cream\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing! My sensitive skin feels so hydrated and calm. No irritation at all.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've ever used. It's gentle, effective, and the ingredients are fantastic.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
