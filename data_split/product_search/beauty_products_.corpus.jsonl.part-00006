{"_id": "product_search--beauty_products_--p--71136", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Gentle Hydration Face Moisturizer\",\n    \"brand\": \"AquaBloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and really hydrates without causing breakouts.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love this! My skin feels so soft and calm after using it. Definitely recommend for anyone with redness.\",\n            \"reviewer_name\": \"Emily L.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"size\": \"2 oz\",\n        \"texture\": \"lightweight lotion\",\n        \"fragrance\": \"unscented\",\n        \"non_comedogenic\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"water\",\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"ceramides\",\n        \"aloe vera\"\n    ],\n    \"application_area\": \"face\"\n}"}
