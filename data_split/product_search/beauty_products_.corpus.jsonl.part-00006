{"_id": "product_search--beauty_products_--p--71713", "text": "{\n    \"product_id\": \"F00123\",\n    \"product_name\": \"Calming Hydration Moisturizer\",\n    \"brand\": \"Simple Organics\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is so gentle on my sensitive skin! It really helps calm redness and keeps my face hydrated all day.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Perfect for sensitive skin. I've tried so many moisturizers and this is the only one that doesn't irritate my face.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"glycerin\",\n        \"hyaluronic acid\",\n        \"chamomile extract\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"scent\": \"unscented\"\n    }\n}"}
