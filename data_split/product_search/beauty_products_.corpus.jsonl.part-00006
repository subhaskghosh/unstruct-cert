{"_id": "product_search--beauty_products_--p--70399", "text": "{\n    \"product_id\": \"moist-sens-nat-001\",\n    \"product_name\": \"Gentle Hydration Facial Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing! My sensitive skin feels soothed and hydrated. It's lightweight and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that works for my redness-prone skin. Love the natural ingredients!\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"light floral\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"jojoba oil\",\n        \"shea butter\",\n        \"chamomile extract\"\n    ]\n}"}
