{"_id": "product_search--beauty_products_--p--71112", "text": "{\n    \"product_id\": \"LRD-Hydrate-Face-001\",\n    \"product_name\": \"La Roche-Posay Toleriane Double Repair Face Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've been using this for a month and my skin feels so much healthier. Highly recommend!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"attributes\": {\n        \"size\": \"2oz\",\n        \"fragrance_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramide-3\",\n        \"Niacinamide\",\n        \"Glycerin\",\n        \"Shea Butter\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--71112", "text": "{\n    \"product_id\": \"CV-Hydrate-Face-002\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good basic moisturizer, a bit thick for my liking.\",\n            \"reviewer_name\": \"David P.\"\n        },\n        {\n            \"review_text\": \"Works well, but doesn't feel very luxurious.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"attributes\": {\n        \"size\": \"19oz\",\n        \"fragrance_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"sensitive\",\n        \"eczema prone\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"body\"\n}"}
{"_id": "product_search--beauty_products_--p--71113", "text": "{\n    \"product_id\": \"FM001\",\n    \"product_name\": \"Soothing Aloe Vera Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's incredibly hydrating and has significantly reduced my redness. Doesn't irritate at all.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I have very sensitive skin and this is the only moisturizer that doesn't cause breakouts. It feels so gentle and luxurious.\",\n            \"reviewer_name\": \"Sarah K.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"attributes\": {\n        \"alcohol_free\": true,\n        \"fragrance\": \"Unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
