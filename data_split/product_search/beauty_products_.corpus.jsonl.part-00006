{"_id": "product_search--beauty_products_--p--71953", "text": "{\n    \"product_id\": \"cerave_hydrating_moist_001\",\n    \"product_name\": \"CeraVe Hydrating Facial Moisturizer\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 18.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-10-26\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This is a very gentle and hydrating moisturizer. Perfect for my sensitive skin!\",\n            \"reviewer_name\": \"Alice Smith\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"fragrance_free\": true,\n        \"description\": \"A lightweight, oil-free moisturizer that provides 24-hour hydration.\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71953", "text": "{\n    \"product_id\": \"cerave_pm_facial_moist_002\",\n    \"product_name\": \"CeraVe PM Facial Moisturizing Lotion\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 16.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Niacinamide\",\n        \"Hyaluronic Acid\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2022-05-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"Good moisturizer, but a bit too heavy for my oily skin.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"3 oz\",\n        \"fragrance_free\": false,\n        \"description\": \"A lightweight moisturizer with niacinamide to calm and soothe skin.\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71954", "text": "{\n    \"product_id\": \"FML001\",\n    \"product_name\": \"HydraBloom Daily Moisturizer\",\n    \"brand\": \"AquaGlow\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so hydrating and doesn't cause any irritation. I love the light floral scent.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that actually works! My skin feels so soft and plump after using this. Highly recommend!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2024-01-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"aloe vera\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"light floral\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71954", "text": "{\n    \"product_id\": \"FML002\",\n    \"product_name\": \"Oil Control Matte Moisturizer\",\n    \"brand\": \"AquaGlow\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is great for oily skin. Keeps my face matte all day.\",\n            \"reviewer_name\": \"David K.\"\n        },\n        {\n            \"review_text\": \"Good moisturizer, but maybe a little drying for some skin types.\",\n            \"reviewer_name\": \"Emily B.\"\n        }\n    ],\n    \"release_date\": \"2023-08-20\",\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"combination\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"salicylic acid\",\n        \"tea tree oil\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"finish\": \"matte\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71955", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Green Tea Extract\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"hydra_sens_001\",\n    \"product_name\": \"Calming Hydration Moisturizer\",\n    \"brand\": \"Nature's Bloom\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! No irritation and keeps my face hydrated all day.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Lightweight and effective. I love that it's made with natural ingredients.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"attributes\": {\n        \"scent\": \"lightly herbal\",\n        \"size\": \"1.7 oz\"\n    }\n}"}
