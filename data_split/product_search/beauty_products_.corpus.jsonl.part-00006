{"_id": "product_search--beauty_products_--p--71389", "text": "{\n    \"product_id\": \"hydra_facial_001\",\n    \"product_name\": \"Hydra Bloom Facial Moisturizer\",\n    \"brand\": \"Botanica Naturals\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"sensitive\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"aloe vera\",\n        \"jojoba oil\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2022-05-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My dry skin feels so hydrated and soft. It's also very gentle and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I have sensitive skin and this is the only moisturizer that doesn't make me break out. Highly recommend!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71389", "text": "{\n    \"product_id\": \"hydra_facial_002\",\n    \"product_name\": \"Aqua Surge Daily Moisturizer\",\n    \"brand\": \"Glow Skin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"normal\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"water\",\n        \"dimethicone\",\n        \"fragrance\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2018-11-01\",\n    \"reviews\": [\n        {\n            \"review_text\": \"Good moisturizer for everyday use, not very effective on extremely dry skin.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Feels light on the skin, but the fragrance is a bit strong.\",\n            \"reviewer_name\": \"David K.\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"100ml\",\n        \"fragrance\": \"floral\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71390", "text": "{\n    \"product_id\": \"F12345\",\n    \"product_name\": \"Gentle Hydration Face Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I love that it's made with natural ingredients and has a light texture.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"Unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"aloe vera\",\n        \"jojoba oil\",\n        \"vitamin E\"\n    ]\n}"}
