{"_id": "product_search--beauty_products_--n--70780", "text": "{\n    \"product_id\": \"CRV-FM-202\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 22.5,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent for very dry skin, a bit heavy for oily skin.\",\n            \"reviewer_name\": \"Emily L.\"\n        },\n        {\n            \"review_text\": \"Effective but can feel greasy if you use too much.\",\n            \"reviewer_name\": \"David K.\"\n        }\n    ],\n    \"release_date\": \"2019-01-20\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"very dry\",\n        \"eczema-prone\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Petrolatum\"\n    ],\n    \"application_area\": \"body\",\n    \"attributes\": {\n        \"texture\": \"thick\",\n        \"non_comedogenic\": false\n    }\n}"}
