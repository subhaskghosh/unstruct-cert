{"_id": "product_search--beauty_products_--p--70293", "text": "{\n    \"product_id\": \"MSTRZ001\",\n    \"product_name\": \"Calming Aloe & Chamomile Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"chamomile extract\",\n        \"jojoba oil\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-05-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels soothed and hydrated. The scent is very light and calming.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've used for my rosacea. It doesn't irritate my skin at all.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"attributes\": {\n        \"fragrance\": \"natural chamomile\",\n        \"size\": \"50ml\"\n    }\n}"}
