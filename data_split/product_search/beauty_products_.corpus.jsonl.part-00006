{"_id": "product_search--beauty_products_--p--70469", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Soothing Daily Face Lotion\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This lotion is amazing for sensitive skin! It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Lightweight and absorbs quickly. Perfect for daily use.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Ceramide\",\n        \"Shea Butter\",\n        \"Thermal Spring Water\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight\",\n        \"fragrance\": \"fragrance-free\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--70469", "text": "{\n    \"product_id\": \"FM67890\",\n    \"product_name\": \"Rich Renewal Night Cream\",\n    \"brand\": \"Olay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Provides intense hydration overnight. My skin feels so soft in the morning.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"A bit thick for daytime use, but excellent for dry skin.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Collagen\",\n        \"Retinol\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"rich\",\n        \"fragrance\": \"floral\"\n    }\n}"}
