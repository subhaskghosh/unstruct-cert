{"_id": "product_search--beauty_products_--p--70864", "text": "{\n    \"product_id\": \"FM-SENS-001\",\n    \"product_name\": \"Gentle Soothe Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! No irritation and feels so soft.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't make me break out. Love the light scent.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"texture\": \"Creamy\",\n        \"fragrance\": \"Light floral\",\n        \"alcohol_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Hyaluronic Acid\",\n        \"Jojoba Oil\"\n    ]\n}"}
