{"_id": "product_search--beauty_products_--p--70563", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Ceramide\",\n        \"Niacinamide\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"LR-Hydrate-Face-001\",\n    \"product_name\": \"La Roche-Posay Toleriane Double Repair Face Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle and hydrating, and doesn't clog my pores. Perfect for sensitive skin.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I've been using this for a few weeks and my skin feels so much healthier. It's lightweight and absorbs quickly.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"2 oz\",\n        \"texture\": \"lightweight lotion\"\n    }\n}"}
