{"_id": "product_search--beauty_products_--p--70180", "text": "{\n    \"product_id\": \"MOIST-SENS-001\",\n    \"product_name\": \"Calming Aloe Facial Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is so gentle on my sensitive skin. It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't make my face red!  It's perfect for sensitive skin.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"2oz\",\n        \"fragrance\": \"Unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Chamomile Extract\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--70180", "text": "{\n    \"product_id\": \"MOIST-RICH-002\",\n    \"product_name\": \"Intense Renewal Night Cream\",\n    \"brand\": \"LuxSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This night cream is really rich and luxurious, but it might be a bit too heavy for some.\",\n            \"reviewer_name\": \"Jessica Brown\"\n        },\n        {\n            \"review_text\": \"It made my skin look brighter, but caused some breakouts.\",\n            \"reviewer_name\": \"Michael Davis\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"attributes\": {\n        \"size\": \"1.7oz\",\n        \"fragrance\": \"Floral\"\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Peptides\",\n        \"Shea Butter\",\n        \"Vitamin C\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--p--70181", "text": "{\n    \"product_id\": \"fm-sens-hyd-001\",\n    \"product_name\": \"Soothing Hydra-Gel Moisturizer\",\n    \"brand\": \"La Rose Botanicals\",\n    \"category\": \"moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and hydrating, and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I love how light this moisturizer is. It absorbs quickly and leaves my skin feeling soft and smooth.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"aloe vera\",\n        \"rose extract\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"light floral\"\n    }\n}"}
