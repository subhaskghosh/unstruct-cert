{"_id": "product_search--beauty_products_--p--71247", "text": "{\n    \"product_id\": \"MSTR-1024\",\n    \"product_name\": \"Calming Botanical Moisturizer\",\n    \"brand\": \"Herbivore Botanicals\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.0,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love the natural ingredients and the lightweight feel. It really helped calm my redness.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Jojoba Oil\",\n        \"Green Tea Extract\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"fragrance\": \"light botanical scent\"\n    }\n}"}
