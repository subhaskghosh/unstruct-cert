{"_id": "product_search--beauty_products_--p--71025", "text": "{\n    \"product_id\": \"M00123\",\n    \"product_name\": \"Soothing Aloe Vera Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"moisturizer\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle and hydrating, perfect for my sensitive skin. No irritation at all.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I love the lightweight feel of this moisturizer. It absorbs quickly and leaves my skin feeling soft and supple.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"unscented\",\n        \"texture\": \"lightweight lotion\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71025", "text": "{\n    \"product_id\": \"M00456\",\n    \"product_name\": \"Revitalizing Rose Facial Cream\",\n    \"brand\": \"Bloom Beauty\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.0,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream feels very rich and hydrating. The rose scent is lovely.\",\n            \"reviewer_name\": \"Emily K.\"\n        },\n        {\n            \"review_text\": \"My skin feels so smooth after using this cream. It's a bit pricey, but worth it.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-11-01\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"rose oil\",\n        \"shea butter\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"rose\",\n        \"texture\": \"rich cream\"\n    }\n}"}
