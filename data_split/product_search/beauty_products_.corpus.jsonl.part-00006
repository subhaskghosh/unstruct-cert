{"_id": "product_search--beauty_products_--n--70095", "text": "{\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"acne-prone\"\n    ],\n    \"ingredients\": [\n        \"salicylic acid\",\n        \"tea tree oil\",\n        \"zinc\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"CLAR-ACNE-002\",\n    \"product_name\": \"Clear Anti-Acne Moisturizer\",\n    \"brand\": \"Clean & Clear\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This product really helped clear up my acne! It's a bit drying, but worth it.\",\n            \"reviewer_name\": \"Sarah P.\"\n        },\n        {\n            \"review_text\": \"Great for oily skin, but not moisturizing enough for dry skin.\",\n            \"reviewer_name\": \"Michael B.\"\n        }\n    ],\n    \"release_date\": \"2023-07-01\",\n    \"attributes\": {\n        \"texture\": \"gel-cream\",\n        \"size\": \"2.0 oz\"\n    }\n}"}
