{"_id": "product_search--beauty_products_--p--71446", "text": "{\n    \"product_id\": \"M12345\",\n    \"product_name\": \"Calming Hydration Face Cream\",\n    \"brand\": \"GentleBloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and really helps calm redness. I've been using it for a month and my skin feels amazing.\",\n            \"reviewer_name\": \"Sarah J.\"\n        },\n        {\n            \"review_text\": \"Great product for sensitive skin. No irritation and very hydrating.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"Unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Chamomile Extract\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
