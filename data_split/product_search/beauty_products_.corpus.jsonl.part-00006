{"_id": "product_search--beauty_products_--p--71989", "text": "{\n    \"product_id\": \"FC001\",\n    \"product_name\": \"Gentle Hydration Face Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for my sensitive skin! It's so gentle and hydrating, and leaves my skin feeling soft and glowing.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've ever used. No irritation and keeps my skin beautifully hydrated.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"texture\": \"lightweight lotion\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Green Tea Extract\",\n        \"Shea Butter\"\n    ]\n}"}
