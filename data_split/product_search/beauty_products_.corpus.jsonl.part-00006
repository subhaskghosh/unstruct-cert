{"_id": "product_search--beauty_products_--p--71024", "text": "{\n    \"product_id\": \"cerave_hydrating_cream_1\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for my sensitive skin! It really calms redness and keeps my face hydrated all day.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Lightweight and non-greasy. Perfect for daily use.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2020-03-15\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"fragrance\": \"mild\",\n        \"texture\": \"lightweight\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ]\n}"}
