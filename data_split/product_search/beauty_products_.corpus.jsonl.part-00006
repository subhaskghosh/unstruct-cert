{"_id": "product_search--beauty_products_--p--70492", "text": "{\n    \"product_id\": \"M12345\",\n    \"product_name\": \"Soothing Hydration Face Cream\",\n    \"brand\": \"GentleBloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-10-26\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and hydrating! Perfect for my sensitive skin.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've struggled with redness for years, and this cream has really calmed my skin down. It's so gentle!\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"Unscented\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--70492", "text": "{\n    \"product_id\": \"M67890\",\n    \"product_name\": \"Brightening Vitamin C Moisturizer\",\n    \"brand\": \"RadiantSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Vitamin C\",\n        \"Hyaluronic Acid\",\n        \"Retinol\",\n        \"Green Tea Extract\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-05-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer really brightened my skin and reduced dark spots!\",\n            \"reviewer_name\": \"Jessica L.\"\n        },\n        {\n            \"review_text\": \"It's a bit strong at first, but my skin is glowing now.\",\n            \"reviewer_name\": \"Amanda P.\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"60ml\",\n        \"fragrance\": \"Citrus\"\n    }\n}"}
