{"_id": "product_search--beauty_products_--n--71151", "text": "{\n    \"product_id\": \"FLR-GLOW-002\",\n    \"product_name\": \"Floral Glow Moisturizer\",\n    \"brand\": \"L'Oreal\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"I love the floral scent of this moisturizer! It leaves my skin feeling soft and hydrated.\",\n            \"reviewer_name\": \"Emily K.\"\n        },\n        {\n            \"review_text\": \"Great moisturizer for everyday use. The fragrance is a little strong for some, but I enjoy it.\",\n            \"reviewer_name\": \"Ashley B.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"size\": \"1.7 fl oz\",\n        \"fragrance_free\": false,\n        \"texture\": \"Lotion\"\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Rose Extract\",\n        \"Glycerin\",\n        \"Vitamin E\",\n        \"Fragrance\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--p--71152", "text": "{\n    \"product_id\": \"H2045\",\n    \"product_name\": \"HydraCalm Soothing Cream\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for my sensitive skin! No irritation and it's very hydrating.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I have rosacea and this is the only moisturizer that doesn't cause flare-ups.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"fragrance\": \"Fragrance-Free\",\n        \"alcohol_content\": \"0%\",\n        \"texture\": \"Rich Cream\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Ceramide\",\n        \"Niacinamide\",\n        \"Shea Butter\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--n--71152", "text": "{\n    \"product_id\": \"A1098\",\n    \"product_name\": \"Alcohol-Infused Radiance Moisturizer\",\n    \"brand\": \"GlowUp\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.5,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"It leaves my skin feeling tight, but does brighten it up.\",\n            \"reviewer_name\": \"Sarah P.\"\n        },\n        {\n            \"review_text\": \"A bit too harsh for my sensitive skin.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2022-11-20\",\n    \"attributes\": {\n        \"fragrance\": \"Floral\",\n        \"alcohol_content\": \"15%\",\n        \"texture\": \"Light Lotion\"\n    },\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"normal\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Alcohol Denat.\",\n        \"Vitamin C\",\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\"\n    ]\n}"}
