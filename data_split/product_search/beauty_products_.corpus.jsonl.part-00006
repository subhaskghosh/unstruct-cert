{"_id": "product_search--beauty_products_--p--71409", "text": "{\n    \"product_id\": \"moist-sens-001\",\n    \"product_name\": \"Calming Aloe Facial Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is perfect for my sensitive skin! It's light and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Really hydrating and gentle. I've noticed a big difference in my skin's dryness.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
