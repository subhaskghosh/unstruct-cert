{"_id": "product_search--beauty_products_--p--70660", "text": "{\n    \"product_id\": \"HM-001\",\n    \"product_name\": \"HydraBloom Rich Moisturizer\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 32.5,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a game-changer for my sensitive skin! It's so creamy and hydrating without feeling greasy.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I love the subtle floral scent and how it makes my skin feel so soft and supple.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Shea Butter\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"Floral\"\n    }\n}"}
