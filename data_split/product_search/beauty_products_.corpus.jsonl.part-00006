{"_id": "product_search--beauty_products_--n--71837", "text": "{\n    \"product_id\": \"M00456\",\n    \"product_name\": \"Radiant Glow Anti-Aging Cream\",\n    \"brand\": \"LuxSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is good but a little heavy for everyday use.\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"I noticed some improvement in fine lines, but it didn't completely eliminate them.\",\n            \"reviewer_name\": \"Amanda B.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"texture\": \"Rich cream\",\n        \"fragrance\": \"Floral\"\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Vitamin C\",\n        \"Peptides\",\n        \"Glycerin\"\n    ]\n}"}
