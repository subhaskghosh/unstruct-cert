{"_id": "product_search--beauty_products_--p--70496", "text": "{\n    \"product_id\": \"M12345\",\n    \"product_name\": \"Calming Aloe Vera Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so light and doesn't clog my pores.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I have rosacea and this is the only moisturizer that doesn't irritate my skin.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight gel-cream\",\n        \"fragrance\": \"unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"chamomile extract\"\n    ]\n}"}
