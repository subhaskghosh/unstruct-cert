{"_id": "product_search--beauty_products_--p--71896", "text": "{\n    \"product_id\": \"hydra_sens_123\",\n    \"product_name\": \"Soothing Aloe Face Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that doesn't cause breakouts! I love the natural ingredients.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"chamomile extract\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_free\": true,\n        \"organic\": true\n    }\n}"}
