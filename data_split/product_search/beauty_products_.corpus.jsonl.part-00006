{"_id": "product_search--beauty_products_--p--71328", "text": "{\n    \"product_id\": \"FML001\",\n    \"product_name\": \"CalmSkin Daily Hydration Moisturizer\",\n    \"brand\": \"Aveeno\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's very gentle and keeps my face hydrated all day.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I love how light this moisturizer is. It doesn't clog my pores and it's perfect for everyday use.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"size\": \"2 fl oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Ceramides\",\n        \"Colloidal Oatmeal\"\n    ],\n    \"application_area\": \"face\"\n}"}
