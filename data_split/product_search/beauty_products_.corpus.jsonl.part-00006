{"_id": "product_search--beauty_products_--p--70175", "text": "{\n    \"product_id\": \"M00123\",\n    \"product_name\": \"Soothing Daily Moisturizer\",\n    \"brand\": \"Everbloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so light and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"I love how quickly this absorbs into my skin. It leaves my face feeling hydrated and refreshed.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"normal\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Green Tea Extract\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"weight_oz\": 1.7\n    }\n}"}
