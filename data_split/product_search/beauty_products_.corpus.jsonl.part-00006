{"_id": "product_search--beauty_products_--p--70695", "text": "{\n    \"product_id\": \"cerave_hydrating_moisturizer_1\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's not greasy and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've ever used. Highly recommend for dry, sensitive skin.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"fragrance\": \"fragrance-free\"\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"sensitive\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--n--70695", "text": "{\n    \"product_id\": \"cerave_hydrating_moisturizer_2\",\n    \"product_name\": \"CeraVe Moisturizing Lotion\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"lotion\",\n    \"price\": 12.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good lotion, but not as moisturizing as the cream.\",\n            \"reviewer_name\": \"Alice Brown\"\n        },\n        {\n            \"review_text\": \"It's okay, but a little too thick for my liking.\",\n            \"reviewer_name\": \"Bob Williams\"\n        }\n    ],\n    \"release_date\": \"2023-01-20\",\n    \"attributes\": {\n        \"size\": \"8 oz\",\n        \"fragrance\": \"fragrance-free\"\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"normal\",\n        \"oily\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"body\"\n}"}
{"_id": "product_search--beauty_products_--p--70696", "text": "{\n    \"product_id\": \"moist-sens-ha-001\",\n    \"product_name\": \"Soothing Hyaluronic Moisture Cream\",\n    \"brand\": \"AuraGlow\",\n    \"category\": \"moisturizer\",\n    \"price\": 32.5,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is a lifesaver for my sensitive skin! It's so gentle and hydrating, and leaves my skin feeling amazing.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I love how this moisturizer feels. It’s light but really effective at keeping my skin hydrated all day.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"fragrance\": \"light floral\",\n        \"size\": \"1.7 oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"chamomile extract\",\n        \"vitamin E\"\n    ]\n}"}
