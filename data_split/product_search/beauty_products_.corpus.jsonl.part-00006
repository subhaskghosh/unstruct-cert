{"_id": "product_search--beauty_products_--p--71419", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Gentle Hydration Face Cream\",\n    \"brand\": \"SoothingSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and really helps keep my skin hydrated without any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've noticed a visible improvement in my skin's radiance since using this cream.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance_free\": true,\n        \"alcohol_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Aloe Vera\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
