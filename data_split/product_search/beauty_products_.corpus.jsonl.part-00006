{"_id": "product_search--beauty_products_--p--70091", "text": "{\n    \"product_id\": \"FMC102\",\n    \"product_name\": \"Soothing Calm Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that doesn't irritate my skin. Love the lightweight feel!\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramide\",\n        \"Glycerin\",\n        \"Niacinamide\",\n        \"Thermal Spring Water\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"weight\": \"1.7 oz\",\n        \"texture\": \"lightweight lotion\"\n    }\n}"}
