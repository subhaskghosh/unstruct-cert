{"_id": "product_search--beauty_products_--p--70863", "text": "{\n    \"product_id\": \"CERV-MOIST-FS-01\",\n    \"product_name\": \"CeraVe Moisturizing Cream - Fragrance Free\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Face Cream\",\n    \"price\": 18.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is a lifesaver for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"I've been using this for years and it's the only moisturizer that doesn't irritate my skin.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2018-05-15\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"skin_type\": \"sensitive\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ]\n}"}
