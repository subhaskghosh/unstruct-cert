{"_id": "product_search--beauty_products_--p--71576", "text": "{\n    \"product_id\": \"moist-sens-001\",\n    \"product_name\": \"Calming Rose Hydration Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"rose water\",\n        \"aloe vera\",\n        \"shea butter\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-03-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels soothed and hydrated. The rose scent is lovely and not overpowering.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Perfect for redness-prone skin. I've noticed a significant improvement since using this product.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"attributes\": {\n        \"cruelty_free\": true,\n        \"fragrance_type\": \"floral\",\n        \"texture\": \"lightweight cream\"\n    }\n}"}
