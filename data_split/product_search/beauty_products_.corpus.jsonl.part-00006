{"_id": "product_search--beauty_products_--p--70045", "text": "{\n    \"product_id\": \"CET12345\",\n    \"product_name\": \"Cetaphil Daily Hydrating Lotion\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"moisturizer\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"hyaluronic acid\",\n        \"dimethicone\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2022-03-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This is a great moisturizer for my sensitive skin. It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"I've been using this for years and it's the only moisturizer that doesn't break me out.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"16 fl oz\"\n    }\n}"}
