{"_id": "product_search--beauty_products_--n--71163", "text": "{\n    \"product_id\": \"FM-00456\",\n    \"product_name\": \"Radiance Boosting Anti-Aging Cream\",\n    \"brand\": \"LuxSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 55.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream feels luxurious and I can see a slight improvement in my skin's texture.\",\n            \"reviewer_name\": \"Sarah P.\"\n        },\n        {\n            \"review_text\": \"It's a bit pricey, but worth it for the anti-aging benefits.\",\n            \"reviewer_name\": \"Michael B.\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"vitamin C\",\n        \"hyaluronic acid\",\n        \"peptide complex\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"light floral\"\n    }\n}"}
