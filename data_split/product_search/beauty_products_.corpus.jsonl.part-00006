{"_id": "product_search--beauty_products_--p--71850", "text": "{\n    \"product_id\": \"FC001\",\n    \"product_name\": \"Hyaluronic Acid Moisture Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"face cream\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing! My sensitive skin feels so hydrated and calm. I've been using it for a month and I'm already seeing a huge difference.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've ever used for my dry, sensitive skin. It's lightweight and doesn't cause any irritation.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"fragrance\": \"fragrance-free\",\n        \"ingredients\": [\n            \"Hyaluronic Acid\",\n            \"Ceramides\",\n            \"Glycerin\"\n        ],\n        \"skin_type_compatibility\": [\n            \"sensitive\",\n            \"dry\",\n            \"normal\"\n        ],\n        \"application_area\": \"face\"\n    },\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Ceramides\",\n        \"Glycerin\"\n    ],\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"application_area\": \"face\"\n}"}
