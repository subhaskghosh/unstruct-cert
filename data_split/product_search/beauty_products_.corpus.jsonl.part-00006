{"_id": "product_search--beauty_products_--n--71049", "text": "{\n    \"product_id\": \"M002\",\n    \"product_name\": \"Radiance Boosting Night Cream\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Night Cream\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream feels lovely on my skin and has improved its overall brightness.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"attributes\": {\n        \"texture\": \"rich\",\n        \"scent\": \"strong citrus\"\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Vitamin C\",\n        \"Peptides\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--p--71050", "text": "{\n    \"product_id\": \"MSTR-SNSTV-001\",\n    \"product_name\": \"Gentle Soothing Facial Moisturizer\",\n    \"brand\": \"Willow Bloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels soothed and hydrated. It's lightweight and doesn't cause any breakouts.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin. Love the natural ingredients.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight\",\n        \"fragrance\": \"unscented\",\n        \"cruelty_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Hyaluronic Acid\",\n        \"Jojoba Oil\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--71050", "text": "{\n    \"product_id\": \"MSTR-OIL-002\",\n    \"product_name\": \"Radiant Glow Facial Oil\",\n    \"brand\": \"Golden Earth Botanicals\",\n    \"category\": \"Oil\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"My skin has never looked so radiant! The oil absorbs quickly and leaves a beautiful glow.\",\n            \"reviewer_name\": \"Emily Carter\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"texture\": \"rich\",\n        \"fragrance\": \"floral\",\n        \"cruelty_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Rosehip Oil\",\n        \"Argan Oil\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--p--71051", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"aloe vera\",\n        \"green tea extract\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"MZT-1234\",\n    \"product_name\": \"Hydrating Sensitive Skin Facial Cream\",\n    \"brand\": \"EverBloom\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for my sensitive skin! It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I love how lightweight this moisturizer is. It absorbs quickly and leaves my skin feeling soft and smooth.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"fragrance_level\": \"light\",\n        \"texture\": \"creamy\",\n        \"anti_aging_benefits\": true\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71051", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"oily\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"salicylic acid\",\n        \"tea tree oil\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"MZT-5678\",\n    \"product_name\": \"Clear Skin Balancing Moisturizer\",\n    \"brand\": \"EverBloom\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for oily skin! It keeps breakouts at bay.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"fragrance_level\": \"strong\",\n        \"texture\": \"gel\",\n        \"anti_aging_benefits\": false\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71052", "text": "{\n    \"product_id\": \"MSTRZ042\",\n    \"product_name\": \"Soothing Aloe & Chamomile Moisturizer\",\n    \"brand\": \"Nature's Bloom\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle on my sensitive skin and feels incredibly lightweight. It's really hydrating without being greasy.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I have rosacea and this is the only moisturizer that doesn't irritate my skin. It's very soothing and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"chamomile extract\",\n        \"hyaluronic acid\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_free\": true,\n        \"paraben_free\": true\n    }\n}"}
