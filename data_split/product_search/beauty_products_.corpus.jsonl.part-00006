{"_id": "product_search--beauty_products_--p--71055", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Soothing Aloe Facial Moisturizer\",\n    \"brand\": \"Nature's Bloom\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's very gentle and hydrating.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I love how lightweight this feels. Doesn't clog pores and keeps my skin moisturized all day.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"fragrance_level\": \"low\",\n        \"texture\": \"lightweight\",\n        \"key_feature\": \"hypoallergenic\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"glycerin\",\n        \"hyaluronic acid\",\n        \"vitamin E\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--n--71055", "text": "{\n    \"product_id\": \"FM67890\",\n    \"product_name\": \"Radiant Glow Anti-Aging Cream\",\n    \"brand\": \"LuxSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream really brightened my complexion and reduced fine lines!\",\n            \"reviewer_name\": \"Sarah P.\"\n        },\n        {\n            \"review_text\": \"A bit pricey, but worth it for the results. Smells amazing!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-08-01\",\n    \"attributes\": {\n        \"fragrance_level\": \"strong\",\n        \"texture\": \"rich\",\n        \"key_feature\": \"anti-aging\"\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"vitamin C\",\n        \"fragrance\",\n        \"peptides\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--p--71056", "text": "{\n    \"product_id\": \"MOIST-SENS-001\",\n    \"product_name\": \"Gentle Hydration Face Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"jojoba oil\",\n        \"chamomile extract\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-05-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle on my sensitive skin and really improves the texture. My skin feels so soft and hydrated.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've been struggling with redness, and this cream has helped calm my skin down. It's a game changer!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"attributes\": {\n        \"organic\": true,\n        \"fragrance_free\": true\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71056", "text": "{\n    \"product_id\": \"MOIST-RICH-005\",\n    \"product_name\": \"Rich Renewal Anti-Aging Cream\",\n    \"brand\": \"Luxury Skin Solutions\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"hyaluronic acid\",\n        \"vitamin C\",\n        \"peptides\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-08-01\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream has noticeably reduced my fine lines, but it can be a bit irritating.\",\n            \"reviewer_name\": \"Emily K.\"\n        },\n        {\n            \"review_text\": \"I love how this feels on my skin, very luxurious!\",\n            \"reviewer_name\": \"Ashley P.\"\n        }\n    ],\n    \"attributes\": {\n        \"organic\": false,\n        \"fragrance_free\": false\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71057", "text": "{\n    \"product_id\": \"CET123\",\n    \"product_name\": \"Cetaphil Daily Hydrating Lotion\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"Moisturizer\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This lotion is amazing for my sensitive skin! It really calms down any redness I have.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Perfect for daily use, leaves my skin feeling hydrated and not greasy.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Dimethicone\",\n        \"Sunflower Seed Oil\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_level\": \"unscented\",\n        \"size\": \"16 fl oz\"\n    }\n}"}
