{"_id": "product_search--beauty_products_--p--70694", "text": "{\n    \"product_id\": \"CET-MOIST-SENS-001\",\n    \"product_name\": \"Cetaphil Daily Facial Moisturizer for Sensitive Skin\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"Moisturizer\",\n    \"price\": 15.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and hydrating for my sensitive skin. No irritation at all!\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't cause breakouts! It's very soothing and keeps my skin feeling comfortable.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"4 fl oz\",\n        \"spf\": 0\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Dimethicone\",\n        \"Sunflower Seed Oil\"\n    ],\n    \"application_area\": \"face\"\n}"}
