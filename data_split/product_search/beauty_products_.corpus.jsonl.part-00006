{"_id": "product_search--beauty_products_--p--71306", "text": "{\n    \"product_id\": \"MSTR-0012\",\n    \"product_name\": \"HydraSilk Daily Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"moisturizer\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my dry, sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I love how this feels on my skin. It's lightweight but deeply moisturizing.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"sensitive\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"ceramides\",\n        \"hyaluronic acid\",\n        \"niacinamide\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"texture\": \"cream\"\n    }\n}"}
