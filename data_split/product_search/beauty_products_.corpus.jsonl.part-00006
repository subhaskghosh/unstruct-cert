{"_id": "product_search--beauty_products_--p--70764", "text": "{\n    \"product_id\": \"CRV-HYD-F-001\",\n    \"product_name\": \"CeraVe Facial Moisturizing Lotion\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is so gentle and hydrating, perfect for my sensitive skin!\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"Great for everyday use. Doesn't irritate my skin.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"size\": \"12 fl oz\",\n        \"fragrance\": \"fragrance-free\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--70764", "text": "{\n    \"product_id\": \"CRV-HYD-B-002\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 22.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Very moisturizing, but a bit too heavy for my face.\",\n            \"reviewer_name\": \"Charlie Brown\"\n        },\n        {\n            \"review_text\": \"Good for dry skin, but can cause breakouts if you're oily.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2021-11-01\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"fragrance\": \"fragrance-free\"\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"very dry\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Glycerin\",\n        \"Petrolatum\"\n    ],\n    \"application_area\": \"body\"\n}"}
