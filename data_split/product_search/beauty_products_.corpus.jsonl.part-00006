{"_id": "product_search--beauty_products_--p--71619", "text": "{\n    \"product_id\": \"FC001\",\n    \"product_name\": \"Soothing Chamomile Face Cream\",\n    \"brand\": \"Nature's Bloom\",\n    \"category\": \"Face Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing! My sensitive skin feels soothed and hydrated. No irritation at all.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't break me out! The chamomile scent is lovely and subtle.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Chamomile Extract\",\n        \"Aloe Vera\",\n        \"Jojoba Oil\",\n        \"Shea Butter\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"scent\": \"floral\",\n        \"texture\": \"lightweight\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71619", "text": "{\n    \"product_id\": \"FC002\",\n    \"product_name\": \"Rejuvenating Anti-Aging Night Cream\",\n    \"brand\": \"LuxSkin\",\n    \"category\": \"Night Cream\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream made my skin feel smoother and reduced the appearance of fine lines.\",\n            \"reviewer_name\": \"Sarah P.\"\n        },\n        {\n            \"review_text\": \"A bit pricey, but worth it for the visible results.\",\n            \"reviewer_name\": \"David K.\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Hyaluronic Acid\",\n        \"Vitamin C\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"scent\": \"citrus\",\n        \"texture\": \"rich\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71620", "text": "{\n    \"product_id\": \"FM001\",\n    \"product_name\": \"HydraBloom Daily Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for sensitive skin! It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I love the light floral scent. It makes my skin feel so refreshed.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"scent\": \"Rose & Chamomile\",\n        \"size\": \"1.7 oz\",\n        \"alcohol_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Rose Extract\",\n        \"Chamomile Extract\"\n    ],\n    \"application_area\": \"face\"\n}"}
