{"_id": "product_search--beauty_products_--p--70547", "text": "{\n    \"product_id\": \"MOIST-SENS-001\",\n    \"product_name\": \"Gentle Hydration Daily Moisturizer\",\n    \"brand\": \"CalmSkin Naturals\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and doesn't irritate my sensitive skin at all. Highly recommend!\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Perfect for everyday use. Keeps my skin hydrated without feeling greasy.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Chamomile Extract\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"2 oz\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
