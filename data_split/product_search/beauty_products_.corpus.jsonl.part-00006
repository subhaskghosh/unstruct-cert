{"_id": "product_search--beauty_products_--p--71245", "text": "{\n    \"product_id\": \"MOIST-SENS-001\",\n    \"product_name\": \"Calming Oat & Aloe Moisturizer\",\n    \"brand\": \"Earthly Bloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating, and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love the lightweight feel and subtle natural scent. Great for everyday use.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Oat extract\",\n        \"Aloe vera\",\n        \"Hyaluronic acid\",\n        \"Jojoba oil\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"scent\": \"natural oat scent\"\n    }\n}"}
