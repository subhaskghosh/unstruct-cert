{"_id": "product_search--beauty_products_--p--71296", "text": "{\n    \"product_id\": \"MZR-SENS-101\",\n    \"product_name\": \"Soothing Aloe Hydration Cream\",\n    \"brand\": \"Nature's Bloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and hydrating, and I love that it's cruelty-free.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Really calmed down my redness and dryness. Great product!\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-07-15\",\n    \"attributes\": {\n        \"fragrance_level\": \"Low\",\n        \"cruelty_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
