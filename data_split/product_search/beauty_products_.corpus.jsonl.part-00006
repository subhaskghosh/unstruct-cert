{"_id": "product_search--beauty_products_--n--71360", "text": "{\n    \"product_id\": \"FM67890\",\n    \"product_name\": \"Alcohol-Based Clarifying Toner\",\n    \"brand\": \"Clinique\",\n    \"category\": \"Toner\",\n    \"price\": 28.0,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"acne-prone\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"alcohol denat\",\n        \"salicylic acid\",\n        \"witch hazel\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"size\": \"6 oz\",\n        \"form\": \"liquid\"\n    },\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for clearing up blemishes, but can be drying.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ]\n}"}
{"_id": "product_search--beauty_products_--p--71361", "text": "{\n    \"product_id\": \"CR-00123\",\n    \"product_name\": \"Cetaphil Daily Hydrating Cream with Hyaluronic Acid\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"Moisturizer\",\n    \"price\": 15.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for sensitive skin! It's lightweight and really hydrates without causing breakouts. Redness is noticeably reduced after a week of use.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Perfect for daily use, especially in the winter. My skin feels so much softer.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"size\": \"4 oz\",\n        \"fragrance\": \"Fragrance-Free\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Ceramides\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--71361", "text": "{\n    \"product_id\": \"CR-00456\",\n    \"product_name\": \"La Roche-Posay Toleriane Double Repair Face Moisturizer UV SPF 30\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good moisturizer, but the SPF can leave a slight white cast on darker skin tones.\",\n            \"reviewer_name\": \"Emily Brown\"\n        },\n        {\n            \"review_text\": \"Works well for my skin, but I prefer a separate sunscreen.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-01-20\",\n    \"attributes\": {\n        \"size\": \"2.5 oz\",\n        \"SPF\": \"30\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"normal\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Ceramides\",\n        \"Zinc Oxide\"\n    ],\n    \"application_area\": \"face\"\n}"}
