{"_id": "product_search--beauty_products_--p--71875", "text": "{\n    \"product_id\": \"FMFM001\",\n    \"product_name\": \"Calming Hydration Face Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is a lifesaver for my sensitive skin! It's incredibly hydrating and has noticeably reduced redness. The scent is very light and refreshing.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love this moisturizer! It's gentle, effective, and doesn't irritate my skin at all.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"chamomile extract\",\n        \"glycerin\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"scent\": \"fresh floral\",\n        \"size\": \"50ml\"\n    }\n}"}
