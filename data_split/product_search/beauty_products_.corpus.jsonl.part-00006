{"_id": "product_search--beauty_products_--p--71046", "text": "{\n    \"product_id\": \"FM-1234\",\n    \"product_name\": \"HydraBoost Sensitive Skin Moisturizer\",\n    \"brand\": \"AquaBloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"vitamin E\",\n        \"glycerin\",\n        \"chamomile extract\"\n    ],\n    \"application_area\": \"face\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle on my sensitive skin and leaves it feeling hydrated all day. Highly recommend!\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Perfect for dry skin in the winter. Absorbs quickly and doesn't cause any irritation.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight cream\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71046", "text": "{\n    \"product_id\": \"FM-5678\",\n    \"product_name\": \"Revitalizing Anti-Aging Cream\",\n    \"brand\": \"EternaGlow\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"vitamin C\",\n        \"peptides\",\n        \"hyaluronic acid\"\n    ],\n    \"application_area\": \"face\",\n    \"reviews\": [\n        {\n            \"review_text\": \"Saw a noticeable difference in my skin after a week of use. A little pricey but worth it.\",\n            \"reviewer_name\": \"Emily K.\"\n        },\n        {\n            \"review_text\": \"Helped reduce the appearance of fine lines and wrinkles. Great product!\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-11-01\",\n    \"attributes\": {\n        \"texture\": \"rich cream\",\n        \"fragrance\": \"floral\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71047", "text": "{\n    \"product_id\": \"moist-sens-001\",\n    \"product_name\": \"Gentle Hydration Face Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for my sensitive skin! No irritation and keeps my face so hydrated.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Love the natural ingredients and the creamy texture. It's perfect for dry skin.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"texture\": \"creamy\",\n        \"size\": \"50ml\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"shea butter\",\n        \"hyaluronic acid\",\n        \"chamomile extract\"\n    ],\n    \"application_area\": \"face\"\n}"}
