{"_id": "product_search--beauty_products_--p--70778", "text": "{\n    \"product_id\": \"FC001\",\n    \"product_name\": \"Calming Rose Face Cream\",\n    \"brand\": \"Bloom & Blossom\",\n    \"category\": \"face cream\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is a lifesaver for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"My skin feels so soft and nourished after using this cream. The rose scent is lovely.\",\n            \"reviewer_name\": \"Jessica Lee\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"Rose\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Rose Water\",\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Shea Butter\"\n    ],\n    \"application_area\": \"face\"\n}"}
