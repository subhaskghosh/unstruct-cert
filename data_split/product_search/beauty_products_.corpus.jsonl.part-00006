{"_id": "product_search--beauty_products_--p--71646", "text": "{\n    \"product_id\": \"MSTR-SENS-001\",\n    \"product_name\": \"Soothing Aloe & Chamomile Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's gentle, hydrating, and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I love the light, natural scent and how quickly it absorbs. Definitely recommend!\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"fragrance\": \"Chamomile & Aloe\",\n        \"paraben_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Shea Butter\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
