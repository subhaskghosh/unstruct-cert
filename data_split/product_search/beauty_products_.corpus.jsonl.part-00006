{"_id": "product_search--beauty_products_--n--71350", "text": "{\n    \"product_id\": \"HYD-OILY-002\",\n    \"product_name\": \"Oil Control Hydrating Gel\",\n    \"brand\": \"Neutrogena\",\n    \"category\": \"Moisturizer\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.0,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for oily skin, keeps me matte all day!\",\n            \"reviewer_name\": \"David B.\"\n        },\n        {\n            \"review_text\": \"Works well, but can be a little drying if you have dry skin.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Salicylic Acid\",\n        \"Water\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"2 oz\",\n        \"fragrance\": \"lightly scented\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71351", "text": "{\n    \"product_id\": \"FC-0012\",\n    \"product_name\": \"Calming Oat Face Cream\",\n    \"brand\": \"Gentle Bloom\",\n    \"category\": \"Face Moisturizer\",\n    \"price\": 22.5,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for my sensitive skin! It's so soothing and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Really love the light scent and how it hydrates my face without feeling greasy.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2024-01-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Oat extract\",\n        \"Aloe vera\",\n        \"Hyaluronic acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"light floral\",\n        \"size\": \"50ml\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71351", "text": "{\n    \"product_id\": \"FC-0005\",\n    \"product_name\": \"Brightening Vitamin C Serum\",\n    \"brand\": \"Radiant Skin\",\n    \"category\": \"Face Serum\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This serum made my skin feel brighter and more even-toned.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"A little pricey, but worth it for the results!\",\n            \"reviewer_name\": \"David K.\"\n        }\n    ],\n    \"release_date\": \"2023-08-20\",\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"normal\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Vitamin C\",\n        \"Hyaluronic acid\",\n        \"Ferulic acid\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"citrus\",\n        \"size\": \"30ml\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71352", "text": "{\n    \"product_id\": \"CRV-FM-SENS-01\",\n    \"product_name\": \"CeraVe Moisturizing Cream for Sensitive Skin\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2018-03-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's lightweight and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Recommended by my dermatologist. It's the only moisturizer that doesn't break me out.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"attributes\": {\n        \"fragrance_free\": true,\n        \"weight_oz\": 19\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71352", "text": "{\n    \"product_id\": \"CRV-FM-OILY-02\",\n    \"product_name\": \"CeraVe Facial Moisturizing Lotion AM with SPF\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 18.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"normal\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"SPF 30\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2020-07-20\",\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for daytime use and provides good sun protection.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"attributes\": {\n        \"fragrance_free\": false,\n        \"weight_oz\": 3\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71353", "text": "{\n    \"product_id\": \"MZR-456\",\n    \"product_name\": \"Calming Hydration Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's very gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah J.\"\n        },\n        {\n            \"review_text\": \"I love the light, natural scent. It's not overpowering at all.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Chamomile Extract\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"natural\",\n        \"size\": \"1.7 oz\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71353", "text": "{\n    \"product_id\": \"MZR-123\",\n    \"product_name\": \"Radiance Boosting Cream\",\n    \"brand\": \"EverGlow\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for a quick glow, but a bit pricey.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2021-11-01\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Vitamin C\",\n        \"Retinol\",\n        \"Glycolic Acid\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"citrus\",\n        \"size\": \"2 oz\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71354", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"aloe vera\",\n        \"chamomile\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"FM-SENS-001\",\n    \"product_name\": \"Calming Hydration Face Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing! It's so gentle and really soothes my sensitive skin. No irritation at all.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that doesn't cause breakouts. My skin feels hydrated and calm.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"fragrance\": \"light, natural botanical scent\",\n        \"size\": \"2 oz\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71354", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"oily\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"retinol\",\n        \"vitamin C\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"FM-REVL-002\",\n    \"product_name\": \"Revitalizing Anti-Aging Face Cream\",\n    \"brand\": \"EverGlow\",\n    \"category\": \"moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream feels great and has improved my skin texture.\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"A little strong for my very sensitive skin, but effective.\",\n            \"reviewer_name\": \"Amanda K.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"fragrance\": \"strong floral scent\",\n        \"size\": \"1.7 oz\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71355", "text": "{\n    \"product_id\": \"MSTR-00123\",\n    \"product_name\": \"Calming Lavender Moisturizer\",\n    \"brand\": \"GentleBloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so soothing and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't make my skin feel oily. It's lightweight and hydrating.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Glycerin\",\n        \"Hyaluronic Acid\",\n        \"Shea Butter\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"fragrance-free\",\n        \"texture\": \"lightweight\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71355", "text": "{\n    \"product_id\": \"MSTR-00456\",\n    \"product_name\": \"Radiance Boosting Cream\",\n    \"brand\": \"Glowtopia\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream gives my skin a beautiful glow!\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"A little goes a long way. It's very rich and moisturizing.\",\n            \"reviewer_name\": \"Michael B.\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Vitamin C\",\n        \"Retinol\",\n        \"Jojoba Oil\",\n        \"Fragrance\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"floral\",\n        \"texture\": \"rich\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71356", "text": "{\n    \"product_id\": \"CRV-HYD-FS-001\",\n    \"product_name\": \"CeraVe Facial Moisturizing Lotion\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is very gentle and doesn't irritate my sensitive skin. It's very hydrating without being greasy.\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"Perfect for dry, sensitive skin! My face feels so much calmer since I started using this.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"12 fl oz\",\n        \"fragrance_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"ceramides\",\n        \"hyaluronic acid\",\n        \"glycerin\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--n--71356", "text": "{\n    \"product_id\": \"LR-REV-A-002\",\n    \"product_name\": \"La Roche-Posay Retinol B3 Serum\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"serum\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for reducing wrinkles, but can be a little harsh at first.\",\n            \"reviewer_name\": \"Charlie Brown\"\n        },\n        {\n            \"review_text\": \"I noticed a difference in my skin's texture after a few weeks, but it did cause some initial redness.\",\n            \"reviewer_name\": \"Diana Davis\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"size\": \"1 fl oz\",\n        \"vitamin_a_content\": \"0.1% retinol\"\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"niacinamide\",\n        \"glycerin\"\n    ]\n}"}
