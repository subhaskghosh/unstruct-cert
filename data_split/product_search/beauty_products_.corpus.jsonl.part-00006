{"_id": "product_search--beauty_products_--p--71630", "text": "{\n    \"product_id\": \"M00123\",\n    \"product_name\": \"Soothing Aloe Facial Moisturizer\",\n    \"brand\": \"Nature's Bloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle on my sensitive skin and really hydrates without feeling greasy.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin! I love the natural ingredients.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"weight\": \"2 oz\",\n        \"texture\": \"Lightweight lotion\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Green Tea Extract\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
