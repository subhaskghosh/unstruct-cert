{"_id": "product_search--beauty_products_--p--70086", "text": "{\n    \"product_id\": \"FC-SENS-001\",\n    \"product_name\": \"Soothing Aloe Vera Face Cream\",\n    \"brand\": \"GentleBloom\",\n    \"category\": \"face cream\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is a lifesaver for my sensitive skin! It's so gentle and moisturizing without being greasy.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I've tried so many creams, and this is the first one that doesn't irritate my skin. Highly recommend!\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"fragrance_level\": \"light\",\n        \"size\": \"2oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"glycerin\",\n        \"chamomile extract\",\n        \"jojoba oil\"\n    ]\n}"}
