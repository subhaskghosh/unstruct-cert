{"_id": "product_search--beauty_products_--p--70141", "text": "{\n    \"product_id\": \"MV12345\",\n    \"product_name\": \"Calming Rose Hydration Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle and hydrating, and my sensitive skin loves it. The rose scent is so calming.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that doesn't irritate my skin! Highly recommend.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"Rose\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Rose Water\",\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Jojoba Oil\"\n    ],\n    \"application_area\": \"face\"\n}"}
