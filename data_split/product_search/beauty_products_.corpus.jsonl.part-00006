{"_id": "product_search--beauty_products_--p--70333", "text": "{\n    \"product_id\": \"FM-0012\",\n    \"product_name\": \"HydraSilk Moisturizing Cream\",\n    \"brand\": \"AuraGlow\",\n    \"category\": \"moisturizer\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle on my sensitive skin and leaves my face feeling incredibly soft and hydrated.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally found a moisturizer that doesn't irritate my skin. The texture is light and luxurious.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"shea butter\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"light floral\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--70333", "text": "{\n    \"product_id\": \"FM-0015\",\n    \"product_name\": \"Daily Defense Facial Lotion\",\n    \"brand\": \"ClearSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good basic moisturizer for everyday use.\",\n            \"reviewer_name\": \"Sarah K.\"\n        },\n        {\n            \"review_text\": \"It's a bit too greasy for my skin type.\",\n            \"reviewer_name\": \"John P.\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"normal\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"water\",\n        \"glycerin\",\n        \"aloe vera\",\n        \"salicylic acid\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"2 oz\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--70334", "text": "{\n    \"product_id\": \"MSTR-SENS-001\",\n    \"product_name\": \"Calming Aloe Vera Moisturizer\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and soothes my irritated skin! Best I've used.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Perfect for sensitive skin. Doesn't cause any breakouts and keeps my skin hydrated.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"chamomile extract\",\n        \"hyaluronic acid\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
