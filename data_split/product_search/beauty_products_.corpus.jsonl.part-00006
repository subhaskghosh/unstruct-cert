{"_id": "product_search--beauty_products_--n--71830", "text": "{\n    \"product_id\": \"FM67890\",\n    \"product_name\": \"Rejuvenating Night Cream\",\n    \"brand\": \"LuxSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream feels luxurious and left my skin glowing.\",\n            \"reviewer_name\": \"Emily K.\"\n        },\n        {\n            \"review_text\": \"A little pricey, but worth it for the results.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"peptide complex\",\n        \"vitamin C\",\n        \"fragrance\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"rich\",\n        \"fragrance\": \"floral\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71831", "text": "{\n    \"product_id\": \"FM202301\",\n    \"product_name\": \"Calming Aloe Vera Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's very gentle and hydrating.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I've been using this for a week and my skin feels so much better. No more redness!\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Vitamin E\",\n        \"Chamomile Extract\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"Unscented\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71831", "text": "{\n    \"product_id\": \"FM202112\",\n    \"product_name\": \"Radiant Glow Facial Cream\",\n    \"brand\": \"GlowUp Beauty\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream gives a nice glow, but it's a little heavy for my skin.\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"It's a good moisturizer, but I wish it had more natural ingredients.\",\n            \"reviewer_name\": \"Michael B.\"\n        }\n    ],\n    \"release_date\": \"2021-11-01\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"oily\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Vitamin C\",\n        \"Glycolic Acid\",\n        \"Fragrance\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"60ml\",\n        \"color\": \"Pearl\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71832", "text": "{\n    \"product_id\": \"cerave_hydrating_moist_101\",\n    \"product_name\": \"CeraVe Hydrating Facial Moisturizer\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2018-03-15\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"fragrance_free\": true\n    },\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and hydrating. Perfect for sensitive skin!\",\n            \"reviewer_name\": \"Sarah Miller\"\n        }\n    ]\n}"}
