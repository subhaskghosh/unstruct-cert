{"_id": "product_search--beauty_products_--p--71425", "text": "{\n    \"product_id\": \"HYDRATE-SENS-001\",\n    \"product_name\": \"Gentle Hydration Daily Moisturizer\",\n    \"brand\": \"Aurelia Botanicals\",\n    \"category\": \"Moisturizer\",\n    \"price\": 32.5,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating, and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"I love how light and non-greasy this moisturizer is. It absorbs quickly and leaves my skin feeling soft and smooth.\",\n            \"reviewer_name\": \"David Lee\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"ingredients_highlights\": [\n            \"Hyaluronic Acid\",\n            \"Aloe Vera\",\n            \"Chamomile\"\n        ],\n        \"fragrance_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Water\",\n        \"Glycerin\",\n        \"Aloe Barbadensis Leaf Juice\",\n        \"Hyaluronic Acid\",\n        \"Chamomile Extract\"\n    ]\n}"}
