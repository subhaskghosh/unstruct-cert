{"_id": "product_search--beauty_products_--p--70763", "text": "{\n    \"product_id\": \"HM-00123\",\n    \"product_name\": \"Soothing Hydration Face Cream\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I have oily sensitive skin, and this is the only moisturizer that doesn't break me out.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"non_comedogenic\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Thermal Spring Water\"\n    ],\n    \"application_area\": \"face\"\n}"}
