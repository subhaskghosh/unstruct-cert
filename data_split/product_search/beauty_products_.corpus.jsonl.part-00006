{"_id": "product_search--beauty_products_--p--71108", "text": "{\n    \"product_id\": \"M001\",\n    \"product_name\": \"Gentle Hydration Face Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin loves it, and it feels so soft and hydrated. The scent is subtle and refreshing.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin. It's light, hydrating, and perfect for daily use.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"light floral\",\n        \"texture\": \"creamy\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"aloe vera\",\n        \"hyaluronic acid\",\n        \"chamomile extract\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\"\n}"}
