{"_id": "product_search--beauty_products_--p--71537", "text": "{\n    \"product_id\": \"LR-Toleriane-Dermo\",\n    \"product_name\": \"La Roche-Posay Toleriane Double Repair Face Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Helped calm my redness and irritation. Great product!\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramide-13\",\n        \"Niacinamide\",\n        \"Glycerin\",\n        \"Thermal Spring Water\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance_free\": true,\n        \"size\": \"2oz\"\n    }\n}"}
