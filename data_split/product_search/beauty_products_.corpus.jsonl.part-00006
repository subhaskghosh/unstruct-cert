{"_id": "product_search--beauty_products_--p--70342", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Soothing Hydration Face Cream\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is fantastic for sensitive skin! It's very gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"I've been using this for a week and my skin feels so much better. No irritation at all.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Ceramide\",\n        \"Hyaluronic Acid\",\n        \"Thermal Spring Water\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight\",\n        \"alcohol_free\": true\n    }\n}"}
