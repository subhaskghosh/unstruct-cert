{"_id": "product_search--beauty_products_--n--71695", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"oily\"\n    ],\n    \"ingredients\": [\n        \"ceramides\",\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"fragrance\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"cerave-daily-moisturizer-fragranced\",\n    \"product_name\": \"CeraVe Daily Moisturizing Lotion with Fragrance\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good moisturizer, but the fragrance is a bit strong for my sensitive skin.\",\n            \"reviewer_name\": \"Emily K.\"\n        },\n        {\n            \"review_text\": \"Keeps my skin hydrated, but I wish it didn't have fragrance.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-09-01\",\n    \"attributes\": {\n        \"fragrance_free\": false,\n        \"weight\": \"8 oz\",\n        \"texture\": \"lightweight lotion\"\n    }\n}"}
