{"_id": "product_search--beauty_products_--p--71833", "text": "{\n    \"product_id\": \"FM-007\",\n    \"product_name\": \"Gentle Hydration Face Cream\",\n    \"brand\": \"Nature's Bloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and soothing on my sensitive skin. It's really hydrating without feeling greasy.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally a moisturizer that doesn't irritate my skin! I've been using it for a week and my skin feels so much calmer.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2024-01-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Chamomile Extract\",\n        \"Jojoba Oil\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"1.7oz\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71833", "text": "{\n    \"product_id\": \"FM-012\",\n    \"product_name\": \"Radiance Boosting Night Cream\",\n    \"brand\": \"Glow & Shine\",\n    \"category\": \"Night Cream\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream makes my skin feel so soft and radiant in the morning!\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"Love the texture and how quickly it absorbs. Definitely a must-have for my nighttime routine.\",\n            \"reviewer_name\": \"Amanda K.\"\n        }\n    ],\n    \"release_date\": \"2023-07-20\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Vitamin C\",\n        \"Glycolic Acid\",\n        \"Peptides\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"2oz\",\n        \"fragrance\": \"floral\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71834", "text": "{\n    \"product_id\": \"FC001\",\n    \"product_name\": \"Gentle Hydration Face Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Face Cream\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My skin feels so soft and nourished after using this. Highly recommend!\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Jojoba Oil\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight\",\n        \"fragrance\": \"subtle floral\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71834", "text": "{\n    \"product_id\": \"FC002\",\n    \"product_name\": \"Revitalizing Face Cream\",\n    \"brand\": \"GlowUp\",\n    \"category\": \"Face Cream\",\n    \"price\": 28.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for everyday use, but didn't see dramatic results.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2021-11-01\",\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"normal\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Retinol\",\n        \"Green Tea Extract\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"rich\",\n        \"fragrance\": \"citrus\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71835", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"HydraBoost Daily Moisturizer\",\n    \"brand\": \"AquaDerm\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so lightweight and really hydrates my sensitive skin.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've been using this for a week and my skin feels so much softer and less irritated.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight\",\n        \"fragrance\": \"unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"ceramides\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
