{"_id": "product_search--beauty_products_--n--70944", "text": "{\n    \"product_id\": \"CET67890\",\n    \"product_name\": \"Cetaphil Moisturizing Cream\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"Moisturizer\",\n    \"price\": 18.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Dimethicone\",\n        \"Mineral Oil\"\n    ],\n    \"application_area\": \"body\",\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for dry skin, but a bit thick for my face.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"attributes\": {\n        \"weight\": \"16 oz\",\n        \"texture\": \"thick cream\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--70945", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Soothing Aloe Moisturizer\",\n    \"brand\": \"Nature's Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and has calmed my redness. Perfect for sensitive skin!\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love how hydrating this is without feeling greasy. My skin feels so much better.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"attributes\": {\n        \"size\": \"2oz\",\n        \"fragrance\": \"Unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--70945", "text": "{\n    \"product_id\": \"FM67890\",\n    \"product_name\": \"Revitalizing Night Cream\",\n    \"brand\": \"Luxury Skin Co.\",\n    \"category\": \"Moisturizer\",\n    \"price\": 45.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"A rich and luxurious cream, but a little too heavy for everyday use.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Definitely made my skin feel smoother, but the scent is strong.\",\n            \"reviewer_name\": \"David K.\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"attributes\": {\n        \"size\": \"1.7oz\",\n        \"fragrance\": \"Floral\"\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Peptides\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--p--70946", "text": "{\n    \"product_id\": \"FML001\",\n    \"product_name\": \"Gentle Hydration Face Cream\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Lightweight and non-greasy, exactly what I needed.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"fragrance\": \"unscented\",\n        \"size\": \"2 oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"aloe vera\",\n        \"vitamin E\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--n--70946", "text": "{\n    \"product_id\": \"FML002\",\n    \"product_name\": \"Rich Repair Night Cream\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This night cream is incredibly rich and hydrating. It's perfect for dry skin.\",\n            \"reviewer_name\": \"Sarah P.\"\n        }\n    ],\n    \"release_date\": \"2023-01-20\",\n    \"attributes\": {\n        \"texture\": \"thick cream\",\n        \"fragrance\": \"floral\",\n        \"size\": \"1.7 oz\"\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"shea butter\",\n        \"retinol\",\n        \"peptide complex\",\n        \"coconut oil\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--p--70947", "text": "{\n    \"product_id\": \"CET123\",\n    \"product_name\": \"Cetaphil Daily Hydrating Lotion\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"moisturizer\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"hyaluronic acid\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2022-03-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is very gentle and hydrating, perfect for my sensitive skin!\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"I love how light and non-greasy this lotion is. It doesn't irritate my skin at all.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"16 fl oz\"\n    }\n}"}
{"_id": "product_search--beauty_products_--n--70947", "text": "{\n    \"product_id\": \"CET456\",\n    \"product_name\": \"Cetaphil Oil Absorbing Moisturizer\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"moisturizer\",\n    \"price\": 18.5,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"combination\",\n        \"acne-prone\"\n    ],\n    \"ingredients\": [\n        \"zinc oxide\",\n        \"glycerin\",\n        \"salicylic acid\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-05-20\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is really good at controlling oil, but it can be a bit drying.\",\n            \"reviewer_name\": \"Charlie Brown\"\n        },\n        {\n            \"review_text\": \"It's a decent product for oily skin, but it doesn't feel very hydrating.\",\n            \"reviewer_name\": \"Diana Davis\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"14 fl oz\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--70948", "text": "{\n    \"product_id\": \"cerave_moist_sens_1\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 18.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent for sensitive skin! Doesn't irritate and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2019-03-15\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"fragrance\": \"unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"ceramides\",\n        \"hyaluronic acid\",\n        \"glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
