{"_id": "product_search--beauty_products_--n--71827", "text": "{\n    \"product_id\": \"M00456\",\n    \"product_name\": \"Radiant Glow Face Cream\",\n    \"brand\": \"GlowSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream gives my skin a lovely glow, but the scent is quite strong.\",\n            \"reviewer_name\": \"Emily K.\"\n        },\n        {\n            \"review_text\": \"A nice moisturizer, but I wish it didn't have so much fragrance.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"oily\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Vitamin C\",\n        \"Rose Extract\",\n        \"Fragrance\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"lightweight\",\n        \"fragrance_free\": false\n    }\n}"}
