{"_id": "product_search--beauty_products_--p--70981", "text": "{\n    \"product_id\": \"FM-2023-001\",\n    \"product_name\": \"HydraBloom Soothing Cream\",\n    \"brand\": \"EverGlow\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a dream for sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My skin feels incredibly soft and nourished after using this. A little goes a long way!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"chamomile extract\",\n        \"ceramides\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"creamy\",\n        \"fragrance\": \"light floral\"\n    }\n}"}
