{"_id": "product_search--beauty_products_--p--71148", "text": "{\n    \"product_id\": \"M00123\",\n    \"product_name\": \"Soothing Hydration Cream\",\n    \"brand\": \"Aveeno\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and hydrating! My sensitive skin loves it. It feels so rich and smooth.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've been using this for weeks and my skin feels amazing. It's perfect for mature, dry skin.\",\n            \"reviewer_name\": \"Emily B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"2oz\",\n        \"fragrance\": \"unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"colloidal oatmeal\",\n        \"ceramides\"\n    ],\n    \"application_area\": \"face\"\n}"}
