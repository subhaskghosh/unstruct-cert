{"_id": "product_search--beauty_products_--p--70292", "text": "{\n    \"product_id\": \"moist-sens-hyd-001\",\n    \"product_name\": \"Calming Hydration Face Cream\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin. Feels really nice and luxurious.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Glycerin\",\n        \"Chamomile Extract\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"light floral\",\n        \"texture\": \"creamy\"\n    }\n}"}
