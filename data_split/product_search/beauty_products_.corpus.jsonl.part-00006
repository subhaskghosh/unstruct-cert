{"_id": "product_search--beauty_products_--p--71863", "text": "{\n    \"product_id\": \"FC001\",\n    \"product_name\": \"Ceramide Boost Moisturizing Cream\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Face Cream\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing for my sensitive skin! It's so hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've noticed a significant improvement in my skin's texture since using this. It's a bit pricey, but worth it.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"Unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Niacinamide\"\n    ],\n    \"application_area\": \"face\"\n}"}
