{"_id": "product_search--beauty_products_--n--71395", "text": "{\n    \"product_id\": \"M002\",\n    \"product_name\": \"Revitalizing Night Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.0,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This night cream is very effective, but can be a little strong for sensitive skin.\",\n            \"reviewer_name\": \"Emily Davis\"\n        },\n        {\n            \"review_text\": \"Noticeably improved my skin's texture after a week of use.\",\n            \"reviewer_name\": \"Michael Wilson\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"size\": \"1.7oz\",\n        \"texture\": \"lotion\"\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"oily\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"glycerin\",\n        \"alcohol denat.\",\n        \"vitamin C\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--p--71396", "text": "{\n    \"product_id\": \"FMO-12345\",\n    \"product_name\": \"Calming Aloe Vera Face Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating, and I've noticed a huge difference in my skin's texture.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I have extremely sensitive skin and this is the only moisturizer that doesn't irritate it. Highly recommend!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-10-26\",\n    \"attributes\": {\n        \"size\": \"2oz\",\n        \"fragrance\": \"Unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Chamomile Extract\",\n        \"Vitamin E\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--n--71396", "text": "{\n    \"product_id\": \"FMO-67890\",\n    \"product_name\": \"Radiant Glow Anti-Aging Cream\",\n    \"brand\": \"LuxBeauty\",\n    \"category\": \"Moisturizer\",\n    \"price\": 55.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good cream, but a bit pricey.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I saw a slight improvement in my wrinkles after a few weeks of use.\",\n            \"reviewer_name\": \"David K.\"\n        }\n    ],\n    \"release_date\": \"2024-01-15\",\n    \"attributes\": {\n        \"size\": \"1.7oz\",\n        \"fragrance\": \"Floral\"\n    },\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"combination\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Retinol\",\n        \"Vitamin C\",\n        \"Peptides\",\n        \"Fragrance\"\n    ]\n}"}
{"_id": "product_search--beauty_products_--p--71397", "text": "{\n    \"product_id\": \"FM-SENS-NAT-001\",\n    \"product_name\": \"Soothing Natural Facial Moisturizer\",\n    \"brand\": \"Everbloom Naturals\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"I love that it's made with natural ingredients. My skin feels so much better since I started using it.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Shea Butter\",\n        \"Jojoba Oil\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"cruelty_free\": true,\n        \"organic_certified\": true\n    }\n}"}
{"_id": "product_search--beauty_products_--n--71397", "text": "{\n    \"product_id\": \"FM-OILY-HYDR-002\",\n    \"product_name\": \"Hydrating Gel Moisturizer\",\n    \"brand\": \"GlowTech\",\n    \"category\": \"Moisturizer\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great for oily skin, keeps me matte all day!\",\n            \"reviewer_name\": \"Alice Brown\"\n        }\n    ],\n    \"release_date\": \"2023-11-01\",\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Vitamin C\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"oil_free\": true,\n        \"dermatologist_tested\": true\n    }\n}"}
