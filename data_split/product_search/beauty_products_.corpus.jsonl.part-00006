{"_id": "product_search--beauty_products_--p--70605", "text": "{\n    \"product_id\": \"HYD-SENS-001\",\n    \"product_name\": \"Soothing Hydration Face Cream\",\n    \"brand\": \"Lumina Naturals\",\n    \"category\": \"Moisturizer\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing! My sensitive skin feels soothed and hydrated. It's a little pricey but worth it.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love this moisturizer. It doesn't irritate my skin at all and keeps it moisturized all day.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"chamomile extract\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"Unscented\"\n    }\n}"}
