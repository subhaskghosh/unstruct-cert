{"_id": "product_search--beauty_products_--n--71220", "text": "{\n    \"product_id\": \"hydr_sens_002\",\n    \"product_name\": \"Revitalizing Face Cream\",\n    \"brand\": \"EverSpring\",\n    \"category\": \"moisturizer\",\n    \"price\": 28.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream feels nice, but it's a bit heavy for daily use.\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"I noticed some redness after using this, so it's not ideal for very sensitive skin.\",\n            \"reviewer_name\": \"Michael B.\"\n        }\n    ],\n    \"release_date\": \"2024-01-15\",\n    \"skin_type_compatibility\": [\n        \"normal\",\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"retinol\",\n        \"vitamin C\",\n        \"glycerin\",\n        \"alcohol denat.\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"fragrance\": \"floral\",\n        \"alcohol_content\": \"5%\"\n    }\n}"}
