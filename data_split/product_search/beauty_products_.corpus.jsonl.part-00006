{"_id": "product_search--beauty_products_--p--71250", "text": "{\n    \"product_id\": \"hydra-sensitive-moist-001\",\n    \"product_name\": \"Gentle Hydration Daily Moisturizer\",\n    \"brand\": \"Bloom & Glow\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"vitamin E\",\n        \"glycerin\",\n        \"chamomile extract\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-03-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle and keeps my sensitive skin hydrated all day without feeling greasy.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin! I love the lightweight texture.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"attributes\": {\n        \"texture\": \"lightweight lotion\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
