{"_id": "product_search--beauty_products_--p--70730", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"cerave_hydrating_moisturizer_001\",\n    \"product_name\": \"CeraVe Hydrating Facial Moisturizer\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"I love how lightweight this moisturizer is. It absorbs quickly and leaves my skin feeling soft and smooth.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight\",\n        \"fragrance\": \"fragrance-free\"\n    }\n}"}
