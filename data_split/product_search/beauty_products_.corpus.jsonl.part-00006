{"_id": "product_search--beauty_products_--p--71613", "text": "{\n    \"product_id\": \"FM-789\",\n    \"product_name\": \"HydraBloom Daily Moisturizer\",\n    \"brand\": \"Aveeno\",\n    \"category\": \"moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"hyaluronic acid\",\n        \"oat extract\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-05-15\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is fantastic! It's so gentle on my sensitive skin and really hydrates without feeling heavy.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love this! My skin feels so much softer and less irritated since I started using it.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"attributes\": {\n        \"texture\": \"lightweight\",\n        \"fragrance\": \"unscented\"\n    }\n}"}
