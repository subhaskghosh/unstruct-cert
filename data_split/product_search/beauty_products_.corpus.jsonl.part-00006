{"_id": "product_search--beauty_products_--p--70956", "text": "{\n    \"product_id\": \"fm-0012\",\n    \"product_name\": \"Soothing Hydration Face Cream\",\n    \"brand\": \"Gentle Bloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is a lifesaver for my sensitive skin! It's so gentle and hydrating, and it really helps calm down my redness.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"I've tried so many moisturizers, and this one is the best. My skin feels soft and nourished, and I haven't had any breakouts.\",\n            \"reviewer_name\": \"Jessica Brown\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"Unscented\"\n    }\n}"}
