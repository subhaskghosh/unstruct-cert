{"_id": "product_search--beauty_products_--p--71899", "text": "{\n    \"product_id\": \"MZT-123\",\n    \"product_name\": \"Calming Rose Hydration Cream\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing! My sensitive skin has never felt so calm and hydrated. The rose scent is lovely and not overpowering.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I have rosacea and this is the only moisturizer that doesn't irritate my skin. It really reduces redness.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Rose Extract\",\n        \"Hyaluronic Acid\",\n        \"Aloe Vera\",\n        \"Chamomile\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"packaging\": \"Pump Bottle\"\n    }\n}"}
