{"_id": "product_search--beauty_products_--p--70130", "text": "{\n    \"product_id\": \"LR-Tol-Face-Moist-50ml\",\n    \"product_name\": \"La Roche-Posay Toleriane Double Repair Face Moisturizer UV SPF 30\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is perfect for my sensitive skin! It's lightweight and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Great for everyday use, especially during winter. Doesn't feel greasy.\",\n            \"reviewer_name\": \"John S.\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramide\",\n        \"Niacinamide\",\n        \"Glycerin\",\n        \"SPF 30\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"SPF\": \"30\",\n        \"texture\": \"lightweight\"\n    }\n}"}
