{"_id": "product_search--beauty_products_--p--70651", "text": "{\n    \"product_id\": \"CET12345\",\n    \"product_name\": \"Cetaphil Daily Hydrating Lotion\",\n    \"brand\": \"Cetaphil\",\n    \"category\": \"Moisturizer\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This is a great moisturizer for my sensitive skin. It's very lightweight and doesn't leave my skin feeling greasy.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Helped calm my redness and irritation. Perfect for everyday use.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"normal\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"Glycerin\",\n        \"Hyaluronic Acid\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"weight\": \"4 fl oz\",\n        \"texture\": \"lotion\"\n    }\n}"}
