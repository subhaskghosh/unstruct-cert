{"_id": "product_search--beauty_products_--p--71841", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"ceramides\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"hydra_glow_001\",\n    \"product_name\": \"HydraGlow Daily Moisturizer\",\n    \"brand\": \"LumiSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My sensitive skin feels so hydrated and looks glowing. It's lightweight and absorbs quickly. Definitely feels luxurious.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I have really dry, sensitive skin and this is the only moisturizer that doesn't irritate it. It provides a beautiful dewy finish.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"fragrance_free\": true,\n        \"size\": \"50ml\"\n    }\n}"}
