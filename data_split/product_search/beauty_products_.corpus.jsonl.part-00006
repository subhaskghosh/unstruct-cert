{"_id": "product_search--beauty_products_--p--70962", "text": "{\n    \"product_id\": \"FM-SENS-001\",\n    \"product_name\": \"CalmSkin Hydrating Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Chamomile Extract\"\n    ],\n    \"application_area\": \"face\",\n    \"release_date\": \"2023-10-26\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle and hydrating. It's perfect for my sensitive skin!\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I have rosacea, and this is the only moisturizer that doesn't irritate my skin. Very gentle formula.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"Unscented\"\n    }\n}"}
