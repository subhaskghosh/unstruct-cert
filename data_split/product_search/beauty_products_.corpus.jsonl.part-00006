{"_id": "product_search--beauty_products_--p--70837", "text": "{\n    \"product_id\": \"CERV_HYD_FS_001\",\n    \"product_name\": \"CeraVe Facial Moisturizing Lotion\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 16.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's lightweight and leaves my skin feeling hydrated and looking radiant.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"Great for everyday use, doesn't clog pores. My skin looks so much healthier and brighter.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"size\": \"12 fl oz\",\n        \"fragrance\": \"Fragrance-Free\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
