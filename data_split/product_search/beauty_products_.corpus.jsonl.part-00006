{"_id": "product_search--beauty_products_--p--70409", "text": "{\n    \"product_id\": \"cerave-hydrating-cream-19oz\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 18.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is a lifesaver for my dry, sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Best moisturizer I've ever used. My skin feels so soft and smooth.\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2018-03-15\",\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"sensitive\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"size\": \"19oz\",\n        \"fragrance_free\": true\n    }\n}"}
