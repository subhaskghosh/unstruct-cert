{"_id": "product_search--beauty_products_--p--70590", "text": "{\n    \"product_id\": \"moist-sens-001\",\n    \"product_name\": \"Soothing Aloe Vera Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's very hydrating and doesn't cause any irritation. The aloe scent is subtle and relaxing.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I love this moisturizer! It's lightweight, absorbs quickly, and leaves my skin feeling soft and supple.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"cruelty_free\": true,\n        \"fragrance\": \"Aloe Vera\",\n        \"texture\": \"Lightweight Lotion\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--70590", "text": "{\n    \"product_id\": \"moist-oil-002\",\n    \"product_name\": \"Radiant Glow Facial Oil\",\n    \"brand\": \"Golden Bloom\",\n    \"category\": \"oil\",\n    \"price\": 35.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"This oil gives my skin a beautiful glow! It's a bit heavy, but a little goes a long way.\",\n            \"reviewer_name\": \"Sarah P.\"\n        },\n        {\n            \"review_text\": \"I love the natural ingredients in this oil. It's perfect for dry skin.\",\n            \"reviewer_name\": \"Amanda K.\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"attributes\": {\n        \"cruelty_free\": true,\n        \"fragrance\": \"Rose\",\n        \"texture\": \"Oil\"\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"mature\"\n    ],\n    \"ingredients\": [\n        \"Rosehip Oil\",\n        \"Jojoba Oil\",\n        \"Argan Oil\",\n        \"Vitamin C\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--p--70591", "text": "{\n    \"product_id\": \"CERV-HYDRATE-001\",\n    \"product_name\": \"CeraVe Daily Moisturizing Lotion\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This lotion is perfect for my sensitive skin! It's lightweight and doesn't cause breakouts.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"Really hydrating and gentle, great for everyday use.\",\n            \"reviewer_name\": \"John Smith\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"fragrance\": \"fragrance-free\",\n        \"texture\": \"lightweight lotion\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--70591", "text": "{\n    \"product_id\": \"CERV-HYDRATE-002\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"moisturizer\",\n    \"price\": 18.5,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for very dry skin, but can be a bit thick.\",\n            \"reviewer_name\": \"Alice Brown\"\n        },\n        {\n            \"review_text\": \"Works well in the winter to combat dryness.\",\n            \"reviewer_name\": \"Bob Green\"\n        }\n    ],\n    \"release_date\": \"2021-11-01\",\n    \"attributes\": {\n        \"size\": \"8 oz\",\n        \"fragrance\": \"fragrance-free\",\n        \"texture\": \"thick cream\"\n    },\n    \"skin_type_compatibility\": [\n        \"dry\",\n        \"very dry\",\n        \"eczema-prone\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"body\"\n}"}
