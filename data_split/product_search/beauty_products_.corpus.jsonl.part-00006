{"_id": "product_search--beauty_products_--p--70346", "text": "{\n    \"product_id\": \"FM-SENS-001\",\n    \"product_name\": \"CalmSkin Hydrating Moisturizer\",\n    \"brand\": \"Botanica Bliss\",\n    \"category\": \"Moisturizer\",\n    \"price\": 28.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's so gentle and hydrating, and it really calms down any redness. The texture is lovely and feels luxurious.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"I've been using this for a week and my skin feels so much better. No more irritation!\",\n            \"reviewer_name\": \"John Doe\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"Unscented\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Chamomile Extract\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ]\n}"}
