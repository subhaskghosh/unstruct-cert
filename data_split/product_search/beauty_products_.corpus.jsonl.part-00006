{"_id": "product_search--beauty_products_--p--71311", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Soothing Hyaluronic Acid Moisturizer\",\n    \"brand\": \"Gentle Bloom\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is incredibly gentle on my sensitive skin! It's very hydrating and has helped reduce redness. Definitely effective!\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I love this moisturizer. It doesn't irritate my skin and keeps it hydrated all day. Great for sensitive skin!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"fragrance_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"aloe vera\",\n        \"chamomile extract\"\n    ]\n}"}
