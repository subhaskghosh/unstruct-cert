{"_id": "product_search--beauty_products_--p--71624", "text": "{\n    \"product_id\": \"cerave-hydrating-moisturizer-sensitive\",\n    \"product_name\": \"CeraVe Moisturizing Cream\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 18.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It's gentle, hydrating, and doesn't cause breakouts.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"I've tried so many moisturizers, and this is the only one that doesn't irritate my skin. Highly recommend!\",\n            \"reviewer_name\": \"John S.\"\n        }\n    ],\n    \"release_date\": \"2018-01-15\",\n    \"attributes\": {\n        \"skin_type\": \"sensitive, dry\",\n        \"fragrance\": \"fragrance-free\",\n        \"non_comedogenic\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
{"_id": "product_search--beauty_products_--n--71624", "text": "{\n    \"product_id\": \"cerave-facial-moisturizer-oily\",\n    \"product_name\": \"CeraVe Facial Moisturizing Lotion AM\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for oily skin, but not hydrating enough for dry skin.\",\n            \"reviewer_name\": \"Sarah L.\"\n        },\n        {\n            \"review_text\": \"A bit greasy for my liking.\",\n            \"reviewer_name\": \"David K.\"\n        }\n    ],\n    \"release_date\": \"2020-05-20\",\n    \"attributes\": {\n        \"skin_type\": \"oily, normal\",\n        \"fragrance\": \"lightly scented\",\n        \"non_comedogenic\": true\n    },\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Niacinamide\"\n    ],\n    \"application_area\": \"face\"\n}"}
