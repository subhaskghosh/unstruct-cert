{"_id": "product_search--beauty_products_--p--70343", "text": "{\n    \"product_id\": \"FM-SENS-001\",\n    \"product_name\": \"Calm & Hydrate Facial Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for sensitive skin! It's very hydrating and doesn't cause any irritation.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally found a moisturizer that works for my redness-prone skin. It's gentle and effective.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramide\",\n        \"Glycerin\",\n        \"Hyaluronic Acid\",\n        \"Shea Butter\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"cream\",\n        \"size\": \"50ml\"\n    }\n}"}
