{"_id": "product_search--beauty_products_--p--71689", "text": "{\n    \"product_id\": \"hydra-sens-001\",\n    \"product_name\": \"Calming Oat & Aloe Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Moisturizer\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"oat extract\",\n        \"aloe vera\",\n        \"glycerin\",\n        \"hyaluronic acid\",\n        \"jojoba oil\"\n    ],\n    \"application_area\": \"face\",\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is a lifesaver for my sensitive skin! It really calmed my redness and keeps my skin hydrated all day.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Gentle and effective. I've noticed a huge improvement in my skin's overall condition.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2024-03-15\",\n    \"attributes\": {\n        \"scent\": \"unscented\",\n        \"size\": \"2oz\"\n    }\n}"}
