{"_id": "product_search--beauty_products_--p--70079", "text": "{\n    \"product_id\": \"CERV001\",\n    \"product_name\": \"CeraVe Daily Moisturizing Lotion\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 14.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for sensitive skin! It's very hydrating and doesn't cause breakouts.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Lightweight and effective. My skin feels so much better since I started using this.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"size\": \"19 oz\",\n        \"fragrance\": \"Unscented\",\n        \"texture\": \"Light Lotion\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
