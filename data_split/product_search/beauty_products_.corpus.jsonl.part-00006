{"_id": "product_search--beauty_products_--p--71018", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"chamomile extract\",\n        \"aloe vera\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"hydra-sens-001\",\n    \"product_name\": \"Gentle Hydration Moisturizer\",\n    \"brand\": \"Botanical Bliss\",\n    \"category\": \"moisturizer\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for sensitive skin! No irritation and really hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"My skin feels so soft and supple after using this. I love the light, fresh scent.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"fragrance\": \"light floral\",\n        \"size\": \"50ml\"\n    }\n}"}
