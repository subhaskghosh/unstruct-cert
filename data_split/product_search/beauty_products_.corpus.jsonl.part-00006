{"_id": "product_search--beauty_products_--p--71305", "text": "{\n    \"product_id\": \"cerave_hydrating_moist_001\",\n    \"product_name\": \"CeraVe Hydrating Facial Moisturizer\",\n    \"brand\": \"CeraVe\",\n    \"category\": \"Moisturizer\",\n    \"price\": 17.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for my sensitive skin! It's so gentle and hydrating.\",\n            \"reviewer_name\": \"Alice Smith\"\n        },\n        {\n            \"review_text\": \"I have dry skin, and this is the only moisturizer that doesn't irritate it.\",\n            \"reviewer_name\": \"Bob Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Ceramides\",\n        \"Hyaluronic Acid\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"weight\": \"1.7 oz\",\n        \"texture\": \"lightweight\",\n        \"fragrance_free\": true\n    }\n}"}
