{"_id": "product_search--beauty_products_--p--71942", "text": "{\n    \"product_id\": \"M12345\",\n    \"product_name\": \"Soothing Aloe Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! It's so gentle on my sensitive skin and really hydrates without feeling greasy. Highly recommend!\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin. Love the light, natural scent and how well it absorbs.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"texture\": \"lightweight gel-cream\",\n        \"fragrance\": \"fragrance-free\",\n        \"key_ingredients\": [\n            \"Aloe Vera\",\n            \"Hyaluronic Acid\",\n            \"Vitamin E\"\n        ]\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Barbadensis Leaf Juice\",\n        \"Glycerin\",\n        \"Sodium Hyaluronate\",\n        \"Tocopherol\"\n    ]\n}"}
