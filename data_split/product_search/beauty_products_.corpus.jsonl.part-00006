{"_id": "product_search--beauty_products_--n--71384", "text": "{\n    \"product_id\": \"FM67890\",\n    \"product_name\": \"Oil Control Face Gel\",\n    \"brand\": \"ClearSkin Solutions\",\n    \"category\": \"moisturizer\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for oily skin, but can be drying.\",\n            \"reviewer_name\": \"David K.\"\n        },\n        {\n            \"review_text\": \"Helps control shine, but doesn't provide much hydration.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-11-01\",\n    \"skin_type_compatibility\": [\n        \"oily\",\n        \"combination\"\n    ],\n    \"ingredients\": [\n        \"salicylic acid\",\n        \"tea tree oil\",\n        \"witch hazel\"\n    ],\n    \"application_area\": \"face\",\n    \"attributes\": {\n        \"texture\": \"gel\",\n        \"fragrance\": \"none\"\n    }\n}"}
{"_id": "product_search--beauty_products_--p--71385", "text": "{\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\"\n    ],\n    \"ingredients\": [\n        \"glycerin\",\n        \"ceramides\",\n        \"prebiotic thermal water\"\n    ],\n    \"application_area\": \"face\",\n    \"product_id\": \"LR-TOL-FACE-001\",\n    \"product_name\": \"La Roche-Posay Toleriane Double Repair Face Moisturizer\",\n    \"brand\": \"La Roche-Posay\",\n    \"category\": \"moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer saved my sensitive skin! It's gentle and hydrating, and it really helps calm redness.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"I've tried so many moisturizers, and this is the only one that doesn't irritate my skin. Highly recommend!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"size\": \"2 oz\",\n        \"fragrance_free\": true\n    }\n}"}
