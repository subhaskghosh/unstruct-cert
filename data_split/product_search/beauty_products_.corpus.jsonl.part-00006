{"_id": "product_search--beauty_products_--p--70650", "text": "{\n    \"product_id\": \"FC001\",\n    \"product_name\": \"Hyaluronic Acid Moisture Cream\",\n    \"brand\": \"SereneSkin\",\n    \"category\": \"face cream\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This cream is amazing! My sensitive skin feels so hydrated and calm. It's lightweight and absorbs quickly. A little goes a long way.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin! I've been using it for a week and already see a difference. Smells lovely too.\",\n            \"reviewer_name\": \"David L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"size\": \"1.7 oz\",\n        \"fragrance\": \"light floral\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"hyaluronic acid\",\n        \"glycerin\",\n        \"aloe vera\",\n        \"vitamin E\"\n    ],\n    \"application_area\": \"face\"\n}"}
