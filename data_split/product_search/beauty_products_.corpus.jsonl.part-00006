{"_id": "product_search--beauty_products_--p--71502", "text": "{\n    \"product_id\": \"HM123\",\n    \"product_name\": \"Soothing Aloe Moisturizer\",\n    \"brand\": \"Nature's Embrace\",\n    \"category\": \"Moisturizer\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing for sensitive skin! It's very gentle and hydrating.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Finally, a moisturizer that doesn't irritate my skin. Love the light, natural scent.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"fragrance\": \"Light Aloe\",\n        \"paraben_free\": true\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Aloe Vera\",\n        \"Hyaluronic Acid\",\n        \"Vitamin E\",\n        \"Glycerin\"\n    ],\n    \"application_area\": \"face\"\n}"}
