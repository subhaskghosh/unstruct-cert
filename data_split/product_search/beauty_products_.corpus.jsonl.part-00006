{"_id": "product_search--beauty_products_--p--70813", "text": "{\n    \"product_id\": \"FM12345\",\n    \"product_name\": \"Radiance Boost Hydrating Moisturizer\",\n    \"brand\": \"LumiSkin\",\n    \"category\": \"moisturizer\",\n    \"price\": 32.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This moisturizer is amazing! My skin feels so soft and hydrated, and I've noticed a real glow.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Perfect for sensitive skin. Doesn't cause any irritation and keeps my skin moisturized all day.\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"size\": \"50ml\",\n        \"fragrance\": \"light floral\"\n    },\n    \"skin_type_compatibility\": [\n        \"sensitive\",\n        \"dry\",\n        \"normal\"\n    ],\n    \"ingredients\": [\n        \"Hyaluronic Acid\",\n        \"Glycerin\",\n        \"Vitamin C\",\n        \"Aloe Vera\"\n    ],\n    \"application_area\": \"face\"\n}"}
