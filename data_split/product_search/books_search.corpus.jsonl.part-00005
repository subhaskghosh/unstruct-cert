{"_id": "product_search--books_search--p--70176", "text": "{\n    \"author\": \"Andy Weir\",\n    \"publisher\": \"Ballantine Books\",\n    \"publication_date\": \"2021-05-04\",\n    \"genre\": [\n        \"Science Fiction\",\n        \"Adventure\"\n    ],\n    \"product_id\": \"978-0593135204\",\n    \"product_name\": \"Project Hail Mary\",\n    \"brand\": null,\n    \"category\": \"Books\",\n    \"price\": 19.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"An absolutely captivating story! Full of optimism and ingenuity.  It left me feeling hopeful about the future of humanity.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"A truly wonderful read. The sense of discovery and optimism is infectious.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2021-05-04\",\n    \"attributes\": {\n        \"pages\": 476,\n        \"format\": \"Paperback\"\n    }\n}"}
{"_id": "product_search--books_search--n--70176", "text": "{\n    \"author\": \"Frank Herbert\",\n    \"publisher\": \"Chilton Books\",\n    \"publication_date\": \"1965-08-01\",\n    \"genre\": [\n        \"Science Fiction\",\n        \"Dystopian\"\n    ],\n    \"product_id\": \"978-0441172719\",\n    \"product_name\": \"Dune\",\n    \"brand\": null,\n    \"category\": \"Books\",\n    \"price\": 24.5,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"A complex and intricate story, but ultimately a dark and cautionary tale. The atmosphere is heavy with political intrigue and existential dread.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"A classic, but it's not a feel-good book. Expect a grim and unforgiving universe.\",\n            \"reviewer_name\": \"David Wilson\"\n        }\n    ],\n    \"release_date\": \"1965-08-01\",\n    \"attributes\": {\n        \"pages\": 658,\n        \"format\": \"Paperback\"\n    }\n}"}
