{"_id": "product_search--books_search--p--68703", "text": "{\n    \"author\": \"N.K. Jemisin\",\n    \"publisher\": \"Orbit\",\n    \"publication_date\": \"2022-09-20\",\n    \"genre\": [\n        \"Science Fiction\",\n        \"Fantasy\"\n    ],\n    \"product_id\": \"978-0316455458\",\n    \"product_name\": \"The City We Became\",\n    \"brand\": \"Orbit Books\",\n    \"category\": \"Books\",\n    \"price\": 24.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"A truly thought-provoking and unique take on urban fantasy and sci-fi. Jemisin is a master storyteller.\",\n            \"reviewer_name\": \"Sarah J.\"\n        },\n        {\n            \"review_text\": \"Loved the characters and the intricate world-building. It really makes you think about the city you live in.\",\n            \"reviewer_name\": \"Mark L.\"\n        }\n    ],\n    \"release_date\": \"2022-09-20\",\n    \"attributes\": {\n        \"format\": \"Hardcover\",\n        \"page_count\": 320\n    }\n}"}
