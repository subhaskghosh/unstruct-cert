{"_id": "product_search--books_search--p--70120", "text": "{\n    \"author\": \"Brandon Sanderson\",\n    \"publisher\": \"Tor Books\",\n    \"publication_date\": \"2020-02-11\",\n    \"genre\": [\n        \"Fantasy\",\n        \"Epic Fantasy\"\n    ],\n    \"product_id\": \"978-0765326355\",\n    \"product_name\": \"Rhythm of War\",\n    \"brand\": \"Brandon Sanderson\",\n    \"category\": \"Books\",\n    \"price\": 25.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"An epic conclusion to the Stormlight Archive's second arc!  The characters are compelling, the world-building is incredible, and the magic system is fascinating.  It's a long read, but completely worth it.\",\n            \"reviewer_name\": \"Sarah Miller\"\n        },\n        {\n            \"review_text\": \"Sanderson continues to deliver! The pacing is great, and the emotional depth of the characters is truly impressive.  A fantastic addition to the Cosmere.\",\n            \"reviewer_name\": \"John Davis\"\n        }\n    ],\n    \"release_date\": \"2020-02-11\",\n    \"attributes\": {\n        \"format\": \"Hardcover\",\n        \"page_count\": 1243\n    }\n}"}
{"_id": "product_search--books_search--n--70120", "text": "{\n    \"author\": \"Patrick Rothfuss\",\n    \"publisher\": \"Del Rey\",\n    \"publication_date\": \"2007-03-27\",\n    \"genre\": [\n        \"Fantasy\"\n    ],\n    \"product_id\": \"978-0765311788\",\n    \"product_name\": \"The Name of the Wind\",\n    \"brand\": \"Patrick Rothfuss\",\n    \"category\": \"Books\",\n    \"price\": 29.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Beautifully written, but the series is unfinished. It's a frustrating experience waiting for the next book.\",\n            \"reviewer_name\": \"Emily Carter\"\n        },\n        {\n            \"review_text\": \"A fantastic story with captivating prose. However, the lack of closure is a significant drawback.\",\n            \"reviewer_name\": \"David Wilson\"\n        }\n    ],\n    \"release_date\": \"2007-03-27\",\n    \"attributes\": {\n        \"format\": \"Paperback\",\n        \"page_count\": 662\n    }\n}"}
