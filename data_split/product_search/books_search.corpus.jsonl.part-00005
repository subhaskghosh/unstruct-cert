{"_id": "product_search--books_search--p--71759", "text": "{\n    \"author\": \"Ken Follett\",\n    \"publisher\": \"Pan Macmillan\",\n    \"publication_date\": \"2012-10-02\",\n    \"genre\": [\n        \"Historical Fiction\",\n        \"Epic Fantasy\"\n    ],\n    \"product_id\": \"978-0330538657\",\n    \"product_name\": \"The Winter of the World\",\n    \"brand\": \"Follett\",\n    \"category\": \"Books\",\n    \"price\": 22.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"A brilliantly crafted story!\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Epic in scope and compelling characters.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Couldn't put it down!\",\n            \"reviewer_name\": \"David L.\"\n        },\n        {\n            \"review_text\": \"Truly amazing historical details.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"A story about family and redemption.\",\n            \"reviewer_name\": \"Michael B.\"\n        },\n        {\n            \"review_text\": \"A captivating read, highly recommend.\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"Great plot twist!\",\n            \"reviewer_name\": \"Robert K.\"\n        },\n        {\n            \"review_text\": \"I'm looking forward to reading the rest of the series.\",\n            \"reviewer_name\": \"Angela W.\"\n        },\n        {\n            \"review_text\": \"One of the best historical fiction books I've read.\",\n            \"reviewer_name\": \"Brian H.\"\n        },\n        {\n            \"review_text\": \"An epic tale with plenty of suspense.\",\n            \"reviewer_name\": \"Laura C.\"\n        }\n    ],\n    \"release_date\": \"2012-10-02\",\n    \"attributes\": {\n        \"pages\": 832,\n        \"language\": \"English\",\n        \"format\": \"Hardcover\"\n    }\n}"}
