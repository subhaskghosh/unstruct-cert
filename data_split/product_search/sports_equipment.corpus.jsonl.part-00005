{"_id": "product_search--sports_equipment--p--65329", "text": "{\n    \"product_id\": \"TRK-1001\",\n    \"product_name\": \"PowerPro Tennis Racket\",\n    \"brand\": \"Velocity\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite Composite\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"10.5 oz\",\n        \"balance\": \"6 pt HL\"\n    },\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for power players!  I've added a lot of spin and pace to my shots.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Lightweight and easy to swing, but still provides plenty of power.\",\n            \"reviewer_name\": \"Sarah K.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
