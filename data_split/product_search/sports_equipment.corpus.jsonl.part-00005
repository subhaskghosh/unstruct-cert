{"_id": "product_search--sports_equipment--p--69442", "text": "{\n    \"product_id\": \"TRK-789\",\n    \"product_name\": \"Pro Power Graphite Tennis Racket\",\n    \"brand\": \"Apex\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 199.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for intermediate players. Offers a lot of power and feels solid.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"I've noticed a significant improvement in my serve since switching to this racket.\",\n            \"reviewer_name\": \"Alice K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"material_type\": \"Graphite\",\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.5 oz\",\n        \"grip_size\": \"4.25 inches\",\n        \"player_level\": \"Intermediate\"\n    },\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"length\": \"27 inches\",\n        \"width\": \"11 inches\",\n        \"height\": \"2 inches\"\n    }\n}"}
