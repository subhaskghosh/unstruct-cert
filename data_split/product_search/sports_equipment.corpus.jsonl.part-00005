{"_id": "product_search--sports_equipment--p--66732", "text": "{\n    \"product_id\": \"TN-PWR-2023\",\n    \"product_name\": \"PowerPro Tennis Racket\",\n    \"brand\": \"Ace Athletics\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite Composite\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"10.6 oz\",\n        \"balance\": \"6 pts HL\"\n    },\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for adding power to my shots.  I'm an intermediate player and it's made a noticeable difference.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Excellent racket, very powerful and comfortable to use.\",\n            \"reviewer_name\": \"Alice B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
{"_id": "product_search--sports_equipment--n--66732", "text": "{\n    \"product_id\": \"TN-CNTRL-2024\",\n    \"product_name\": \"ControlMaster Tennis Racket\",\n    \"brand\": \"Ace Athletics\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite Composite\",\n    \"dimensions\": {\n        \"head_size\": \"98 sq. in.\",\n        \"weight\": \"11.0 oz\",\n        \"balance\": \"4 pts HL\"\n    },\n    \"price\": 149.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This racket is amazing for control and accuracy. Perfect for players who like to place the ball.\",\n            \"reviewer_name\": \"David L.\"\n        },\n        {\n            \"review_text\": \"Very precise racket, not much power but great feel.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2024-01-20\",\n    \"attributes\": {\n        \"grip_size\": \"4 1/4\",\n        \"string_pattern\": \"18x20\"\n    }\n}"}
{"_id": "product_search--sports_equipment--p--66733", "text": "{\n    \"product_name\": \"Wilson Clash 100 Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"10.4 oz\",\n        \"length\": \"27 inches\"\n    },\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This racket is incredibly comfortable and provides excellent feel. Great for all-around play.\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"I have tendonitis in my elbow and this racket has made a huge difference. Very arm-friendly!\",\n            \"reviewer_name\": \"Jane Smith\"\n        }\n    ],\n    \"release_date\": \"2020-01-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"balance\": \"6 pts HL\"\n    },\n    \"product_id\": \"TEN-WIL-CLASH100\"\n}"}
