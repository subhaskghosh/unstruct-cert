{"_id": "product_search--sports_equipment--p--69656", "text": "{\n    \"product_id\": \"TR-B100-23\",\n    \"product_name\": \"Babolat Pure Drive Lite 2023\",\n    \"brand\": \"Babolat\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite Composite\",\n    \"dimensions\": {\n        \"head_size_sq_in\": 100,\n        \"weight_grams\": 255,\n        \"length_inches\": 27\n    },\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for adding power to your shots! Easy to swing and very comfortable.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"I've noticed a significant increase in my serve speed since switching to this racket.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-01-15\",\n    \"attributes\": {\n        \"grip_size_inches\": 4.25,\n        \"string_pattern\": \"16x19\"\n    }\n}"}
