{"_id": "product_search--sports_equipment--n--70181", "text": "{\n    \"product_id\": \"TN-ALM-750\",\n    \"product_name\": \"Aluminum Power 750\",\n    \"brand\": \"Apex\",\n    \"category\": \"Tennis Rackets\",\n    \"material_type\": \"aluminum\",\n    \"sport_type\": \"tennis\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"9.8 oz\",\n        \"length\": \"27 inches\"\n    },\n    \"price\": 99.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good value for the price. A bit stiff but gets the job done.\",\n            \"reviewer_name\": \"David L.\"\n        },\n        {\n            \"review_text\": \"Decent racket for beginners. Not much power though.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"attributes\": {\n        \"grip_size\": \"4.375\",\n        \"balance_point\": \"4 pts HL\",\n        \"string_pattern\": \"16x18\"\n    }\n}"}
