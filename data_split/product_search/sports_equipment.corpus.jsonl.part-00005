{"_id": "product_search--sports_equipment--p--71016", "text": "{\n    \"material_type\": \"graphite\",\n    \"sport_type\": \"tennis\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq in\",\n        \"weight\": \"10.5 oz\",\n        \"length\": \"27 inches\"\n    },\n    \"product_id\": \"TN-GR-007\",\n    \"product_name\": \"PowerGraph Tennis Racket\",\n    \"brand\": \"AcePro\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent racket! Provides a lot of power and feels very lightweight. Great for serve and volley.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"I've been playing with this racket for a month now and I'm very impressed.  My serves have improved significantly.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2022-05-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"balance\": \"head light\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
