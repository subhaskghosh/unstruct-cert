{"_id": "product_search--sports_equipment--p--70485", "text": "{\n    \"product_id\": \"TR-WH-101\",\n    \"product_name\": \"Wilson Clash 100L V2\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"dimensions\": {\n        \"weight\": \"10.4 oz\",\n        \"head_size\": \"100 sq. in.\",\n        \"length\": \"27 inches\"\n    },\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for spin and control. Very arm friendly!\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"I'm an intermediate player and this racket has really improved my game.\",\n            \"reviewer_name\": \"Emily R.\"\n        },\n        {\n            \"review_text\": \"Lightweight and powerful, exactly what I was looking for.\",\n            \"reviewer_name\": \"David L.\"\n        },\n        {\n            \"review_text\": \"Excellent feel and comfortable to swing.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Highly recommend for intermediate players seeking a flexible racket.\",\n            \"reviewer_name\": \"Michael B.\"\n        },\n        {\n            \"review_text\": \"Provides plenty of power and spin potential.\",\n            \"reviewer_name\": \"Jessica W.\"\n        },\n        {\n            \"review_text\": \"A fantastic racket that offers a great balance of power and control.\",\n            \"reviewer_name\": \"Robert K.\"\n        },\n        {\n            \"review_text\": \"Very responsive and easy to maneuver on the court.\",\n            \"reviewer_name\": \"Amanda P.\"\n        },\n        {\n            \"review_text\": \"Improved my serve significantly with this racket!\",\n            \"reviewer_name\": \"Christopher T.\"\n        },\n        {\n            \"review_text\": \"Comfortable grip and excellent overall performance.\",\n            \"reviewer_name\": \"Ashley N.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"balance_point\": \"6 pts HL\"\n    }\n}"}
