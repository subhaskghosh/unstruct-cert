{"_id": "product_search--sports_equipment--p--65189", "text": "{\n    \"product_id\": \"TR-2023-005\",\n    \"product_name\": \"Pro Control 100 Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for adding more control to my game. Feels solid and well-balanced.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Improved my slice and net play significantly. Highly recommend for intermediate players.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.5 oz\",\n        \"balance\": \"4 pts HL\",\n        \"grip_size\": \"4 3/8\",\n        \"material_type\": \"Graphite\"\n    },\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"length\": \"27 inches\",\n        \"width\": \"11.8 inches\",\n        \"height\": \"2 inches\"\n    }\n}"}
