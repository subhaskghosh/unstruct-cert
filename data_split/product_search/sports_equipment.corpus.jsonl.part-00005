{"_id": "product_search--sports_equipment--p--66535", "text": "{\n    \"product_id\": \"TN-GR-100\",\n    \"product_name\": \"Pro Graphite 100\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Racquets\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size_sq_in\": 100,\n        \"weight_oz\": 11.5,\n        \"length_in\": 27\n    },\n    \"price\": 189.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This racket is amazing! It's lightweight and has a large sweet spot, making it very forgiving.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Easy to swing and provides great power.  Highly recommend for intermediate players.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\",\n        \"balance_point\": \"6 pts HL\"\n    }\n}"}
{"_id": "product_search--sports_equipment--n--66535", "text": "{\n    \"product_id\": \"TN-AL-95\",\n    \"product_name\": \"Alloy 95\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Racquets\",\n    \"material_type\": \"Aluminum Alloy\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size_sq_in\": 95,\n        \"weight_oz\": 10.8,\n        \"length_in\": 26.5\n    },\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good racket for beginners. It's quite stiff but affordable.\",\n            \"reviewer_name\": \"David B.\"\n        },\n        {\n            \"review_text\": \"Feels a little heavy and hard to maneuver for quick volleys.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2022-11-01\",\n    \"attributes\": {\n        \"grip_size\": \"4 1/4\",\n        \"string_pattern\": \"16x18\",\n        \"balance_point\": \"4 pts HL\"\n    }\n}"}
