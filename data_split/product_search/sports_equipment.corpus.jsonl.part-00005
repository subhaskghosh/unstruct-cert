{"_id": "product_search--sports_equipment--p--67332", "text": "{\n    \"material_type\": \"leather\",\n    \"sport_type\": \"football\",\n    \"dimensions\": {\n        \"size\": \"Official\",\n        \"weight\": \"14-15 oz\"\n    },\n    \"product_id\": \"FB-L-PRO-001\",\n    \"product_name\": \"Pro Elite Leather Football\",\n    \"brand\": \"Champion Sports\",\n    \"category\": \"Footballs\",\n    \"price\": 45.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent quality leather, great grip for throwing and catching. Very durable.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"Used in several games, holds up extremely well. Highly recommend.\",\n            \"reviewer_name\": \"Coach Miller\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"lacing\": \"Pebbled Laces\",\n        \"bladder\": \"Butyl Rubber\"\n    }\n}"}
