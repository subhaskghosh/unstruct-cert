{"_id": "product_search--sports_equipment--p--70234", "text": "{\n    \"product_id\": \"TN-GPH-450\",\n    \"product_name\": \"Pro Power Graphite Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Rackets\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11 oz\",\n        \"length\": \"27 inches\"\n    },\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This racket has significantly improved my serve! The power is incredible.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Great balance and feel. Highly recommended for intermediate to advanced players.\",\n            \"reviewer_name\": \"Maria L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
