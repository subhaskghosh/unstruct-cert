{"_id": "product_search--sports_equipment--p--67913", "text": "{\n    \"product_id\": \"TNSRKT-WIL-2023-001\",\n    \"product_name\": \"Wilson Clash 100 v2\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.5 oz\",\n        \"balance\": \"6 pts HL\"\n    },\n    \"price\": 219.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent racket for all-around play. Provides great feel and power.\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"Very comfortable and easy to swing. I've noticed a significant improvement in my serve.\",\n            \"reviewer_name\": \"Jane Smith\"\n        },\n        {\n            \"review_text\": \"Highly recommended for intermediate to advanced players.\",\n            \"reviewer_name\": \"David Lee\"\n        },\n        {\n            \"review_text\": \"Great feel. Exactly what I was looking for.\",\n            \"reviewer_name\": \"Sarah Chen\"\n        },\n        {\n            \"review_text\": \"Best racket I've ever owned!\",\n            \"reviewer_name\": \"Michael Brown\"\n        },\n        {\n            \"review_text\": \"A very comfortable racket.\",\n            \"reviewer_name\": \"Ashley Williams\"\n        },\n        {\n            \"review_text\": \"I am a beginner and this racket is perfect for me.\",\n            \"reviewer_name\": \"Chris Davis\"\n        },\n        {\n            \"review_text\": \"Good feel on the ball.\",\n            \"reviewer_name\": \"Emily Green\"\n        },\n        {\n            \"review_text\": \"Excellent racket!\",\n            \"reviewer_name\": \"Brandon White\"\n        },\n        {\n            \"review_text\": \"I am loving this racket!\",\n            \"reviewer_name\": \"Jessica Taylor\"\n        }\n    ],\n    \"release_date\": \"2023-02-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
