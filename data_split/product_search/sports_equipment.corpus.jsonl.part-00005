{"_id": "product_search--sports_equipment--p--67097", "text": "{\n    \"product_id\": \"TN007\",\n    \"product_name\": \"Pro Power Graphite Tennis Racket\",\n    \"brand\": \"AceTech\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 189.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent racket for powerful serves and groundstrokes. The graphite provides great feel and control.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Lightweight and easy to maneuver. I've noticed a significant improvement in my game since switching to this racket.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"material_type\": \"Graphite\",\n        \"sport_type\": \"Tennis\",\n        \"dimensions\": {\n            \"head_size\": \"100 sq. in.\",\n            \"weight\": \"11 oz\",\n            \"balance\": \"6 pts HL\"\n        },\n        \"grip_size\": \"4 3/8\"\n    }\n}"}
