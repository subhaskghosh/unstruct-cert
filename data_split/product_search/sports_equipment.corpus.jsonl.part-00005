{"_id": "product_search--sports_equipment--p--70847", "text": "{\n    \"product_id\": \"TN-W123\",\n    \"product_name\": \"Wilson Clash 100L V2\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for intermediate players! Very comfortable and easy to swing.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Love the feel of this racket. It's helped me improve my game.\",\n            \"reviewer_name\": \"Alice B.\"\n        },\n        {\n            \"review_text\": \"A solid choice for all-around play.\",\n            \"reviewer_name\": \"David L.\"\n        },\n        {\n            \"review_text\": \"Excellent control and power.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Very comfortable and forgiving.\",\n            \"reviewer_name\": \"Michael R.\"\n        },\n        {\n            \"review_text\": \"Good racket for the price.\",\n            \"reviewer_name\": \"Emily K.\"\n        },\n        {\n            \"review_text\": \"Lightweight and easy to maneuver.\",\n            \"reviewer_name\": \"Brian H.\"\n        },\n        {\n            \"review_text\": \"Helped me improve my serve.\",\n            \"reviewer_name\": \"Jessica P.\"\n        },\n        {\n            \"review_text\": \"Great feel and responsiveness.\",\n            \"reviewer_name\": \"Kevin T.\"\n        },\n        {\n            \"review_text\": \"Highly recommended!\",\n            \"reviewer_name\": \"Amanda W.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"weight\": 10.4,\n        \"head_size\": 100,\n        \"length\": 27\n    },\n    \"attributes\": {\n        \"grip_size\": \"4 1/4\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
