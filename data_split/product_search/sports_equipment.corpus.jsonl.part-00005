{"_id": "product_search--sports_equipment--p--66713", "text": "{\n    \"product_name\": \"Wilson Clash 100 Pro Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"price\": 199.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This racket gives me a lot of power and control. Great for aggressive baseline play.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"The Clash Pro feels amazing. Very comfortable and responsive.\",\n            \"reviewer_name\": \"Sarah L.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.5 oz\",\n        \"balance\": \"6 pts HL\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
