{"_id": "product_search--sports_equipment--p--67641", "text": "{\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11 oz\"\n    },\n    \"product_id\": \"TR1234\",\n    \"product_name\": \"Pro Beginner Tennis Racket\",\n    \"brand\": \"Babolat\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for starting out! Very lightweight and easy to swing.\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. I've been playing for a month and love it.\",\n            \"reviewer_name\": \"Jane Smith\"\n        },\n        {\n            \"review_text\": \"Really helped me improve my game quickly.\",\n            \"reviewer_name\": \"Peter Jones\"\n        },\n        {\n            \"review_text\": \"A solid racket for beginners, very comfortable to use.\",\n            \"reviewer_name\": \"Alice Brown\"\n        },\n        {\n            \"review_text\": \"Good grip and feel. A fantastic starter racket.\",\n            \"reviewer_name\": \"David Lee\"\n        },\n        {\n            \"review_text\": \"I am very happy with this purchase!\",\n            \"reviewer_name\": \"Robert Green\"\n        },\n        {\n            \"review_text\": \"The best racket for beginners!\",\n            \"reviewer_name\": \"Michael Black\"\n        },\n        {\n            \"review_text\": \"Easy to learn with!\",\n            \"reviewer_name\": \"Sarah White\"\n        },\n        {\n            \"review_text\": \"Would recommend to a friend.\",\n            \"reviewer_name\": \"Kevin Gray\"\n        },\n        {\n            \"review_text\": \"A great choice!\",\n            \"reviewer_name\": \"Jessica Red\"\n        },\n        {\n            \"review_tex