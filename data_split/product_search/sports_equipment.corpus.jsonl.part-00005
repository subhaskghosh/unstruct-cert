{"_id": "product_search--sports_equipment--p--66534", "text": "{\n    \"product_id\": \"BG-LTHR-ADLT-001\",\n    \"product_name\": \"Pro Series Leather Baseball Glove\",\n    \"brand\": \"Rawlings\",\n    \"category\": \"Baseball Gloves\",\n    \"material_type\": \"Leather\",\n    \"sport_type\": \"Baseball\",\n    \"dimensions\": {\n        \"size\": \"12 inches\",\n        \"weight\": \"0.8 lbs\"\n    },\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This glove is incredibly comfortable and well-made. Perfect for adult baseball players!\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"Great glove, excellent quality leather. Fits well and is very comfortable.\",\n            \"reviewer_name\": \"Jane Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"hand_orientation\": \"Right\",\n        \"position\": \"All-Purpose\"\n    }\n}"}
