{"_id": "product_search--sports_equipment--n--67132", "text": "{\n    \"product_id\": \"TR1002\",\n    \"product_name\": \"Classic Control Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Rackets\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size\": \"98 sq. in.\",\n        \"weight\": \"10.8 oz\",\n        \"length\": \"27 inches\"\n    },\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent for all-around play and control.\",\n            \"reviewer_name\": \"David B.\"\n        },\n        {\n            \"review_text\": \"Provides a lot of feel and precision. Great for defensive players.\",\n            \"reviewer_name\": \"Susan K.\"\n        }\n    ],\n    \"release_date\": \"2023-06-20\",\n    \"attributes\": {\n        \"grip_size\": \"4.375\",\n        \"balance_point\": \"4 pts HL\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
{"_id": "product_search--sports_equipment--p--67133", "text": "{\n    \"material_type\": \"graphite\",\n    \"sport_type\": \"tennis\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq in\",\n        \"length\": \"27 inches\",\n        \"weight\": \"11.5 oz\"\n    },\n    \"product_id\": \"TR-GPH-100\",\n    \"product_name\": \"ControlPro Graphite Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"tennis rackets\",\n    \"price\": 199.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent racket for players who want precision and control. The graphite provides a great feel.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"A solid racket, very responsive and easy to maneuver. Great for all-court play.\",\n            \"reviewer_name\": \"Alice Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"balance\": \"head light\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
