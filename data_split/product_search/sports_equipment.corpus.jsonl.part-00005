{"_id": "product_search--sports_equipment--p--69733", "text": "{\n    \"product_id\": \"TN-WLS-PR100\",\n    \"product_name\": \"Wilson Pro Staff 100\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"tennis\",\n    \"material_type\": \"graphite\",\n    \"dimensions\": {\n        \"head_size\": 100,\n        \"weight\": 11.5,\n        \"length\": 27\n    },\n    \"price\": 139.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for powerful swings. I feel like I've added more pace to my shots.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Excellent control and feel. Very durable.\",\n            \"reviewer_name\": \"Mary B.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
