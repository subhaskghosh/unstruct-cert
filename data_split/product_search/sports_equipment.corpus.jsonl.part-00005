{"_id": "product_search--sports_equipment--p--69914", "text": "{\n    \"product_id\": \"TR1002\",\n    \"product_name\": \"Pro Control 99\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"tennis\",\n    \"material_type\": \"Graphite\",\n    \"dimensions\": {\n        \"head_size_sq_in\": 100,\n        \"weight_oz\": 11.5,\n        \"length_in\": 27\n    },\n    \"price\": 189.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for control and feel.  I've really improved my placement since switching to this.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Very accurate racket, excellent for players who prioritize control over power.\",\n            \"reviewer_name\": \"Maria L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
