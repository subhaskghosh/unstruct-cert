{"_id": "product_search--sports_equipment--p--67687", "text": "{\n    \"product_id\": \"TN-PRO-123\",\n    \"product_name\": \"Pro Control 98 Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size\": 98,\n        \"weight\": 11.5,\n        \"balance\": \"6 pts HL\"\n    },\n    \"price\": 225.0,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent racket for players who like a lot of feel and control. Great for spin!\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Very comfortable and provides great precision on volleys.\",\n            \"reviewer_name\": \"Alice B.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
