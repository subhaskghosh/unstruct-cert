{"_id": "product_search--sports_equipment--p--69441", "text": "{\n    \"product_id\": \"TR7890\",\n    \"product_name\": \"Pro Graphite Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 219.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent racket for intermediate to advanced players. Great control and power.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"Highly recommend this racket! It's lightweight and easy to maneuver.\",\n            \"reviewer_name\": \"Alice Johnson\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"material_type\": \"Graphite\",\n        \"grip_size\": \"4 3/8\",\n        \"weight\": \"11.5 oz\",\n        \"head_size\": \"100 sq. in.\",\n        \"performance_level\": \"Advanced\"\n    },\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"length\": \"27 inches\",\n        \"width\": \"11 inches\",\n        \"height\": \"2 inches\"\n    }\n}"}
