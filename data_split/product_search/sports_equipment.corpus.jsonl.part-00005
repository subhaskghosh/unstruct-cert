{"_id": "product_search--sports_equipment--p--69613", "text": "{\n    \"product_id\": \"TNSRKT001\",\n    \"product_name\": \"Graphite Power Beginner Tennis Racket\",\n    \"brand\": \"PowerPlay\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 199.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for learning! Very forgiving and provides good power.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Easy to use and comfortable to swing. Definitely recommend for beginners.\",\n            \"reviewer_name\": \"Emily L.\"\n        }\n    ],\n    \"release_date\": \"2023-08-15\",\n    \"attributes\": {\n        \"material_type\": \"Graphite\",\n        \"sport_type\": \"Tennis\",\n        \"dimensions\": {\n            \"head_size\": \"100 sq. in.\",\n            \"weight\": \"9.5 oz\",\n            \"balance\": \"6 pts HL\"\n        },\n        \"skill_level\": \"Beginner\"\n    }\n}"}
