{"_id": "product_search--sports_equipment--p--67686", "text": "{\n    \"material_type\": \"graphite\",\n    \"sport_type\": \"tennis\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.5 oz\",\n        \"balance\": \"6 pts HL\"\n    },\n    \"product_id\": \"TR100GT\",\n    \"product_name\": \"Pro Power Graphite Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"tennis rackets\",\n    \"price\": 199.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for adding power to my game! Really helped me with my serve.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Excellent feel and plenty of pop. A solid upgrade from my old racket.\",\n            \"reviewer_name\": \"Mary K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\",\n        \"skill_level\": \"intermediate to advanced\"\n    }\n}"}
