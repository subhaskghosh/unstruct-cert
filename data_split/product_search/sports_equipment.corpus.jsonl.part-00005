{"_id": "product_search--sports_equipment--p--65405", "text": "{\n    \"product_id\": \"TRK-1001\",\n    \"product_name\": \"Beginner's Comfort Grip Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite Composite\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"9.5 oz\",\n        \"balance\": \"6 pts HL\"\n    },\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for learning! Very comfortable to hold and easy to swing.\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"Excellent value for the price. The grip is very forgiving.\",\n            \"reviewer_name\": \"Jane Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 1/4\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
