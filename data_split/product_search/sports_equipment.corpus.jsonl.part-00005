{"_id": "product_search--sports_equipment--p--67451", "text": "{\n    \"product_id\": \"TN-GPH-200\",\n    \"product_name\": \"Pro Power Graphite Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 189.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for adding power to my serves! Very lightweight and easy to maneuver.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"As an intermediate player, this racket has really helped me improve my game.\",\n            \"reviewer_name\": \"Maria L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"material_type\": \"Graphite\",\n        \"sport_type\": \"Tennis\",\n        \"dimensions\": {\n            \"head_size\": \"100 sq. in.\",\n            \"weight\": \"10.6 oz\",\n            \"balance\": \"6 pts HL\"\n        },\n        \"grip_size\": \"4 3/8\",\n        \"skill_level\": \"Intermediate to Advanced\"\n    }\n}"}
