{"_id": "product_search--sports_equipment--p--65442", "text": "{\n    \"product_id\": \"TR-789-ADV\",\n    \"product_name\": \"Pro Power 95 Tennis Racket\",\n    \"brand\": \"Velocity\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"dimensions\": {\n        \"head_size\": 95,\n        \"weight\": 11.5,\n        \"balance\": \"6 pts HL\"\n    },\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"This racket is amazing for generating power! I've noticed a huge improvement in my serve.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Great feel and very responsive. Perfect for aggressive baseline players.\",\n            \"reviewer_name\": \"Alice K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"skill_level\": \"Advanced\",\n        \"swing_style\": \"Power\",\n        \"grip_size\": \"4.25\"\n    }\n}"}
