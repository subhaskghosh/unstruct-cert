{"_id": "product_search--sports_equipment--p--69400", "text": "{\n    \"product_id\": \"TRK-GPH-220\",\n    \"product_name\": \"Pro Power Graphite Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Rackets\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size_sq_in\": 100,\n        \"weight_oz\": 11.5,\n        \"length_in\": 27\n    },\n    \"price\": 199.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This racket is amazing! I've added so much power to my serve and groundstrokes. Highly recommend for aggressive players.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Great feel and control. The graphite provides a nice balance of power and precision.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
