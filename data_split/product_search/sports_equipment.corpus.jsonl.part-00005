{"_id": "product_search--sports_equipment--p--65300", "text": "{\n    \"product_id\": \"TN-RAC-007\",\n    \"product_name\": \"Pro Power 100 Tennis Racquet\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Racquets\",\n    \"price\": 179.99,\n    \"availability\": true,\n    \"rating\": 4.6,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racquet for power hitters! Very responsive and feels light in the hand.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Excellent control and power. Improved my game significantly.\",\n            \"reviewer_name\": \"Alice K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"material_type\": \"Graphite Composite\",\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"10.4 oz\",\n        \"balance\": \"6 pts HL\",\n        \"string_pattern\": \"16x19\",\n        \"skill_level\": \"Intermediate to Advanced\"\n    },\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"length\": \"27 inches\",\n        \"grip_size\": \"4 3/8 inches\"\n    }\n}"}
