{"_id": "product_search--sports_equipment--p--67510", "text": "{\n    \"product_id\": \"TR-2023-007\",\n    \"product_name\": \"Pro Staff Lite Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite Composite\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"10.4 oz\",\n        \"balance\": \"6 pts HL\",\n        \"length\": \"27 inches\"\n    },\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for intermediate players. Very lightweight and easy to swing.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Comfortable grip and feels very durable. I've been using it for months with no issues.\",\n            \"reviewer_name\": \"Alice K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
