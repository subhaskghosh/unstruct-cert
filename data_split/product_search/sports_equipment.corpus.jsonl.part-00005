{"_id": "product_search--sports_equipment--p--69657", "text": "{\n    \"product_id\": \"TR1001\",\n    \"product_name\": \"Pro Power Graphite Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Rackets\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.5 oz\",\n        \"length\": \"27 inches\"\n    },\n    \"price\": 159.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent racket for intermediate players. Provides great power and control.\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"Very happy with this purchase! The graphite frame feels lightweight and responsive.\",\n            \"reviewer_name\": \"Jane Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"balance_point\": \"6 pts HL\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
{"_id": "product_search--sports_equipment--n--69657", "text": "{\n    \"product_id\": \"TR1002\",\n    \"product_name\": \"Beginner Graphite Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Rackets\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size\": \"105 sq. in.\",\n        \"weight\": \"9.8 oz\",\n        \"length\": \"27 inches\"\n    },\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 3.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Good for beginners, but lacks power for more experienced players.\",\n            \"reviewer_name\": \"David Lee\"\n        },\n        {\n            \"review_text\": \"Lightweight and easy to swing, perfect for learning the game.\",\n            \"reviewer_name\": \"Sarah Chen\"\n        }\n    ],\n    \"release_date\": \"2023-05-20\",\n    \"attributes\": {\n        \"grip_size\": \"4 1/4\",\n        \"balance_point\": \"4 pts HL\",\n        \"string_pattern\": \"16x18\"\n    }\n}"}
