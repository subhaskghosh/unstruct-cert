{"_id": "product_search--sports_equipment--p--67506", "text": "{\n    \"product_id\": \"TN-RDX-2000\",\n    \"product_name\": \"Red Dragon X-2000 Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"material_type\": \"Graphite Composite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size_sq_in\": 100,\n        \"weight_oz\": 10.6,\n        \"length_in\": 27\n    },\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for intermediate players. Very lightweight and easy to swing. Excellent control!\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"A solid racket, especially for the price. I've improved my control significantly.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"balance_points\": \"6 pts HL\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
