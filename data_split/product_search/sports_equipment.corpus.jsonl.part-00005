{"_id": "product_search--sports_equipment--n--70718", "text": "{\n    \"product_name\": \"Head Graphene 360+ Instinct S Tennis Racket\",\n    \"brand\": \"Head\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"dimensions\": {\n        \"head_size\": 107,\n        \"weight\": 10.4,\n        \"length\": 27\n    },\n    \"price\": 199.99,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Easy to swing and generate power, perfect for beginners.\",\n            \"reviewer_name\": \"Bob B.\"\n        },\n        {\n            \"review_text\": \"Very comfortable and forgiving racket. Good for recreational players.\",\n            \"reviewer_name\": \"Carol D.\"\n        }\n    ],\n    \"release_date\": \"2022-11-20\",\n    \"attributes\": {\n        \"grip_size\": \"4 1/4\",\n        \"balance\": \"4 pts HL\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
