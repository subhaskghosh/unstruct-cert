{"_id": "product_search--sports_equipment--n--70650", "text": "{\n    \"product_id\": \"TRK-BAB-202\",\n    \"product_name\": \"Babolat Pure Drive\",\n    \"brand\": \"Babolat\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.8 oz\",\n        \"balance\": \"4 pts HL\"\n    },\n    \"price\": 169.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Powerful racket, perfect for aggressive baseline players.\",\n            \"reviewer_name\": \"David L.\"\n        },\n        {\n            \"review_text\": \"Provides a lot of spin and pace. Great for serving.\",\n            \"reviewer_name\": \"Sarah M.\"\n        }\n    ],\n    \"release_date\": \"2023-01-20\",\n    \"attributes\": {\n        \"skill_level\": \"Advanced\",\n        \"frame_thickness\": \"21.5mm\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
{"_id": "product_search--sports_equipment--p--70651", "text": "{\n    \"product_id\": \"TN-GRPH-2023-001\",\n    \"product_name\": \"Pro Power Graphite Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.5 oz\",\n        \"balance\": \"6 pts HL\"\n    },\n    \"price\": 189.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Excellent racket for power players. The graphite provides great feel and control.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Very responsive and accurate. Definitely a step up from my previous racket.\",\n            \"reviewer_name\": \"Alice K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
