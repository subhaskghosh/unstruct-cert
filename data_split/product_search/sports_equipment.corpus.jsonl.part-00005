{"_id": "product_search--sports_equipment--p--70118", "text": "{\n    \"product_id\": \"TNSRKT001\",\n    \"product_name\": \"Pro Power Graphite Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 219.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"This racket has a great feel and provides excellent power on serves and groundstrokes.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Highly recommend for aggressive players looking to add more pace to their game.\",\n            \"reviewer_name\": \"Emily K.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"material_type\": \"Graphite\",\n        \"grip_size\": \"4 3/8\",\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.5 oz\",\n        \"balance\": \"6 pts HL\"\n    },\n    \"sport_type\": \"tennis\",\n    \"dimensions\": {\n        \"length\": \"27 inches\",\n        \"width\": \"11 inches\",\n        \"height\": \"2 inches\"\n    }\n}"}
