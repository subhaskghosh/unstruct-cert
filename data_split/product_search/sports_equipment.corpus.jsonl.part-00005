{"_id": "product_search--sports_equipment--p--69612", "text": "{\n    \"product_id\": \"TRK-G45-001\",\n    \"product_name\": \"Graphite Pro Power Tennis Racket\",\n    \"brand\": \"Apex Sports\",\n    \"category\": \"Tennis Rackets\",\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.7,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for powerful serves and groundstrokes! Very responsive.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"Excellent control and power. Highly recommend for intermediate to advanced players.\",\n            \"reviewer_name\": \"Maria L.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"material_type\": \"Graphite\",\n        \"grip_size\": \"4.25 inches\",\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"11.5 oz\"\n    },\n    \"sport_type\": \"Tennis\",\n    \"dimensions\": {\n        \"length\": \"27 inches\",\n        \"width\": \"11 inches\",\n        \"height\": \"2 inches\"\n    }\n}"}
