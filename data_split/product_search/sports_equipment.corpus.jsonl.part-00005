{"_id": "product_search--sports_equipment--p--66655", "text": "{\n    \"product_id\": \"TR-WILS-2023-001\",\n    \"product_name\": \"Wilson Clash 100\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Racquets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"dimensions\": {\n        \"head_size\": \"100 sq. in.\",\n        \"weight\": \"10.4 oz\",\n        \"balance\": \"6 pts HL\",\n        \"length\": \"27 inches\"\n    },\n    \"price\": 199.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"This racquet is incredibly flexible and easy to swing. Great for intermediate players like myself.\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"I love the feel of this racquet. Very comfortable and forgiving.\",\n            \"reviewer_name\": \"Jane Smith\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"skill_level\": \"Intermediate\",\n        \"string_pattern\": \"16x19\"\n    }\n}"}
