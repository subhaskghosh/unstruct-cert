{"_id": "product_search--sports_equipment--p--68023", "text": "{\n    \"product_id\": \"TNSR-W102\",\n    \"product_name\": \"Wilson Blade 102\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"dimensions\": {\n        \"weight_oz\": 10.6,\n        \"head_size_sq_in\": 102,\n        \"length_in\": 27\n    },\n    \"price\": 189.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for intermediate players! Provides a good balance of power and control.\",\n            \"reviewer_name\": \"John S.\"\n        },\n        {\n            \"review_text\": \"I've been using this racket for a few months now and I'm really happy with it.\",\n            \"reviewer_name\": \"Emily R.\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size_in\": \"4 3/8\",\n        \"balance_points\": 6,\n        \"string_pattern\": \"16x19\"\n    }\n}"}
