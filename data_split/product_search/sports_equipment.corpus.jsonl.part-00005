{"_id": "product_search--sports_equipment--p--67513", "text": "{\n    \"product_name\": \"Wilson Clash 100L Tennis Racket\",\n    \"brand\": \"Wilson\",\n    \"category\": \"Tennis Rackets\",\n    \"sport_type\": \"Tennis\",\n    \"material_type\": \"Graphite\",\n    \"dimensions\": {\n        \"weight\": 9.8,\n        \"head_size\": 100,\n        \"length\": 27\n    },\n    \"price\": 129.99,\n    \"availability\": true,\n    \"rating\": 4.5,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great racket for beginners! Very forgiving and easy to swing.\",\n            \"reviewer_name\": \"John Smith\"\n        },\n        {\n            \"review_text\": \"I'm a new tennis player and this racket has helped me improve quickly.\",\n            \"reviewer_name\": \"Jane Doe\"\n        },\n        {\n            \"review_text\": \"Comfortable and easy to use, good value for the price.\",\n            \"reviewer_name\": \"Peter Jones\"\n        },\n        {\n            \"review_text\": \"Excellent racket for beginners and intermediate players.\",\n            \"reviewer_name\": \"Sarah Williams\"\n        },\n        {\n            \"review_text\": \"Lightweight and powerful, perfect for my game.\",\n            \"reviewer_name\": \"David Brown\"\n        },\n        {\n            \"review_text\": \"Great control and feel, I highly recommend it.\",\n            \"reviewer_name\": \"Emily Davis\"\n        },\n        {\n            \"review_text\": \"Very happy with this purchase, it's a fantastic racket.\",\n            \"reviewer_name\": \"Michael Green\"\n        },\n        {\n            \"review_text\": \"Easy to swing and generate power, good for all skill levels.\",\n            \"reviewer_name\": \"Ashley Taylor\"\n        },\n        {\n            \"review_text\": \"Comfortable grip and good overall performance.\",\n            \"reviewer_name\": \"Brian White\"\n        },\n        {\n            \"review_text\": \"Highly recommend for beginners looking for a forgiving racket.\",\n            \"reviewer_name\": \"Jessica King\"\n        },\n        {\n            \"review_text\": \"A great racket at a reasonable price.\",\n            \"reviewer_name\": \"Robert Hall\"\n        }\n    ],\n    \"release_date\": \"2023-03-15\",\n    \"attributes\": {\n        \"grip_size\": \"4 3/8\",\n        \"string_pattern\": \"16x19\"\n    },\n    \"product_id\": \"TEN-WIL-CLASH100L-001\"\n}"}
