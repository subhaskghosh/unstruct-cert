{"_id": "product_search--mobile_devices_s--p--70696", "text": "{\n    \"product_id\": \"SM-S23Ultra-256\",\n    \"product_name\": \"Samsung Galaxy S23 Ultra\",\n    \"brand\": \"Samsung\",\n    \"category\": \"smartphone\",\n    \"price\": 799.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"Amazing camera and long battery life! Best phone I've ever owned.\",\n            \"reviewer_name\": \"John Doe\"\n        },\n        {\n            \"review_text\": \"The S23 Ultra is a powerhouse. The photos are stunning, and it lasts all day.\",\n            \"reviewer_name\": \"Jane Smith\"\n        }\n    ],\n    \"release_date\": \"2023-02-17\",\n    \"attributes\": {\n        \"operating_system\": \"Android 13\",\n        \"screen_size\": \"6.8 inches\",\n        \"screen_resolution\": \"3088 x 1440\",\n        \"camera_quality\": {\n            \"main_camera\": \"200MP\",\n            \"front_camera\": \"12MP\"\n        },\n        \"storage\": \"256GB\",\n        \"ram\": \"8GB\",\n        \"battery_capacity\": 5000\n    }\n}"}
