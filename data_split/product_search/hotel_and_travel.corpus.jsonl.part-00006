{"_id": "product_search--hotel_and_travel--p--71347", "text": "{\n    \"location\": \"Orlando, FL\",\n    \"room_types\": [\n        \"Family Suite\",\n        \"Double Room\"\n    ],\n    \"amenities\": [\n        \"Pool\",\n        \"Free Breakfast\",\n        \"Free WiFi\",\n        \"Kids Club\"\n    ],\n    \"check_in_date\": \"2024-10-26\",\n    \"product_id\": \"ORL-FAM-123\",\n    \"product_name\": \"Sunshine Family Resort\",\n    \"brand\": \"Sunshine Resorts\",\n    \"category\": \"Hotel\",\n    \"price\": 225.0,\n    \"availability\": true,\n    \"rating\": 4.2,\n    \"reviews\": [\n        {\n            \"review_text\": \"Great hotel for families! The pool was amazing and the breakfast was a lifesaver. Rooms were clean and spacious.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"We had a wonderful time. The kids loved the kids club and the staff were very friendly.\",\n            \"reviewer_name\": \"John B.\"\n        }\n    ],\n    \"release_date\": \"2022-03-15\",\n    \"attributes\": {\n        \"room_size\": \"500 sq ft\",\n        \"bed_type\": \"Queen Bed\",\n        \"max_occupancy\": 4\n    }\n}"}
