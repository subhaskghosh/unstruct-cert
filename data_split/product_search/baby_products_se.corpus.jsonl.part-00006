{"_id": "product_search--baby_products_se--p--71964", "text": "{\n    \"age_recommendation\": \"Newborn\",\n    \"safety_certifications\": [\n        \"CPSIA\",\n        \"ASTM F2236\"\n    ],\n    \"material\": \"Organic Cotton\",\n    \"product_id\": \"BC001\",\n    \"product_name\": \"Organic Cotton Baby Carrier Wrap\",\n    \"brand\": \"Happy Baby\",\n    \"category\": \"Baby Carriers\",\n    \"price\": 79.99,\n    \"availability\": true,\n    \"rating\": 4.8,\n    \"reviews\": [\n        {\n            \"review_text\": \"This carrier is amazing! So soft and comfortable for both me and my baby. Easy to use and I feel very secure.\",\n            \"reviewer_name\": \"Sarah M.\"\n        },\n        {\n            \"review_text\": \"Love the organic cotton! My baby seems very content and cozy in this carrier. Highly recommend!\",\n            \"reviewer_name\": \"Jessica L.\"\n        }\n    ],\n    \"release_date\": \"2023-05-15\",\n    \"attributes\": {\n        \"color\": \"Gray\",\n        \"weight_capacity\": \"25 lbs\",\n        \"head_support\": \"Adjustable padded head support\"\n    }\n}"}
