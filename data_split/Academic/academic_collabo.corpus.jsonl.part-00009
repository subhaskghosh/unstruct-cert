{"_id": "Academic--academic_collabo--n--69852", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"Oxford University\",\n            \"lead_contact\": \"Dr. David Wilson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-06-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"National Geographic Society\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models\",\n        \"Understand the impact of climate change on ecosystems\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a research paper on the impact of rising sea levels.\",\n            \"date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69853", "text": "{\n    \"collaboration_title\": \"Joint Research on Advanced NLP Models\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Prof. Chris Manning\",\n            \"contact_email\": \"manning@stanford.edu\"\n        },\n        {\n            \"institution\": \"Google AI\",\n            \"contact_name\": \"Dr. Jeff Dean\",\n            \"contact_email\": \"jeffdean@google.com\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Natural Language Processing\",\n        \"Deep Learning\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Google\"\n    ],\n    \"goals\": [\n        \"Develop novel NLP architectures\",\n        \"Improve machine translation quality\",\n        \"Advance sentiment analysis techniques\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"A Novel Transformer Architecture for NLP\",\n            \"publication_date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
