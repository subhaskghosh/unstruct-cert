{"_id": "Academic--academic_collabo--p--71506", "text": "{\n    \"collaboration_title\": \"Global Initiative for Sustainable Agriculture\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Davis\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Wageningen University & Research\",\n            \"lead_contact\": \"Prof. Jan van den Berg\"\n        },\n        {\n            \"institution\": \"International Rice Research Institute\",\n            \"lead_contact\": \"Dr. Li Wei\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Agriculture\",\n        \"Food Security\",\n        \"Environmental Science\"\n    ],\n    \"funding_sources\": [\n        \"USAID\",\n        \"European Commission\",\n        \"Bill & Melinda Gates Foundation\"\n    ],\n    \"goals\": [\n        \"Develop climate-resilient crop varieties\",\n        \"Improve water management practices\",\n        \"Reduce food waste\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new drought-resistant rice variety.\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@ucdavis.edu\",\n        \"affiliation\": \"University of California, Davis\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71506", "text": "{\n    \"collaboration_title\": \"Quantum Entanglement and Cosmology\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Alan Turing\"\n        },\n        {\n            \"institution\": \"University of Cambridge\",\n            \"lead_contact\": \"Prof. Stephen Hawking\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-08-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Cosmology\",\n        \"Quantum Mechanics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"UK Research and Innovation\"\n    ],\n    \"goals\": [\n        \"Explore the relationship between quantum entanglement and the early universe\",\n        \"Develop new models of black hole information paradox\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on novel quantum entanglement protocols.\",\n            \"publication_date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alan Turing\",\n        \"email\": \"alan.turing@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71507", "text": "{\n    \"collaboration_title\": \"Climate Resilience in Coastal Communities\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Dr. James Wilson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Science\",\n        \"Climate Change\",\n        \"Coastal Management\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Schmidt Futures\"\n    ],\n    \"goals\": [\n        \"Develop predictive models for coastal erosion\",\n        \"Implement sustainable coastal protection strategies\",\n        \"Enhance community resilience to climate impacts\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a study in Nature Climate Change demonstrating increased erosion rates.\",\n            \"date_achieved\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\",\n        \"publications\": \"Over 50 peer-reviewed publications in high-impact journals.\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71507", "text": "{\n    \"collaboration_title\": \"Theoretical Astrophysics and Cosmology\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. David Lee\"\n        },\n        {\n            \"institution\": \"California Institute of Technology\",\n            \"lead_contact\": \"Dr. Sarah Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Astrophysics\",\n        \"Cosmology\",\n        \"Theoretical Physics\"\n    ],\n    \"funding_sources\": [\n        \"National Aeronautics and Space Administration\",\n        \"Gordon and Betty Moore Foundation\"\n    ],\n    \"goals\": [\n        \"Advance understanding of dark matter and dark energy\",\n        \"Develop new theoretical models of the universe\",\n        \"Explore the origins of cosmic structure\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new mathematical framework for dark matter simulations.\",\n            \"date_achieved\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\",\n        \"publications\": \"30 peer-reviewed publications.\"\n    }\n}"}
