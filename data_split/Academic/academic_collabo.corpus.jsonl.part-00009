{"_id": "Academic--academic_collabo--p--71495", "text": "{\n    \"collaboration_title\": \"EU-Asia Sustainable Energy Transition Partnership\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford, UK\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Tsinghua University, China\",\n            \"contact_name\": \"Prof. Li Wei\",\n            \"contact_email\": \"li.wei@tsinghua.edu.cn\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Energy\",\n        \"Energy Storage\",\n        \"Smart Grids\"\n    ],\n    \"funding_sources\": [\n        \"European Commission Horizon Europe\",\n        \"National Natural Science Foundation of China\"\n    ],\n    \"goals\": [\n        \"Develop advanced energy storage technologies\",\n        \"Improve grid stability with renewable energy integration\",\n        \"Reduce carbon emissions in urban areas\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"High-Performance Solid-State Batteries for Grid-Scale Energy Storage\",\n            \"publication_date\": \"2023-11-20\",\n            \"journal\": \"Nature Energy\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71495", "text": "{\n    \"collaboration_title\": \"Theoretical Frameworks for Advanced Energy Systems\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology, USA\",\n            \"contact_name\": \"Dr. Alan Smith\",\n            \"contact_email\": \"alan.smith@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Tokyo, Japan\",\n            \"contact_name\": \"Prof. Kenji Tanaka\",\n            \"contact_email\": \"kenji.tanaka@utokyo.ac.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Computational Materials Science\",\n        \"Theoretical Chemistry\",\n        \"Energy Systems Modelling\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Japan Society for the Promotion of Science\"\n    ],\n    \"goals\": [\n        \"Develop novel theoretical models for energy materials\",\n        \"Simulate energy conversion processes\",\n        \"Advance understanding of energy storage mechanisms\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"title\": \"Ab Initio Calculations of Lithium-Ion Battery Materials\",\n            \"conference_name\": \"International Conference on Materials Research\",\n            \"presentation_date\": \"2022-09-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alan Smith\",\n        \"email\": \"alan.smith@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71496", "text": "{\n    \"collaboration_title\": \"Global Eco-Health Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Alistair Davies\",\n            \"contact_email\": \"alistair.davies@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"National Institute of Health, Japan\",\n            \"contact_name\": \"Dr. Kenji Tanaka\",\n            \"contact_email\": \"kenji.tanaka@nih.go.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Sustainability\",\n        \"Biomedical Engineering\",\n        \"Public Health\",\n        \"Climate Change\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Gates Foundation\",\n        \"Novo Nordisk A/S\"\n    ],\n    \"goals\": [\n        \"Develop sustainable solutions for environmental health challenges.\",\n        \"Improve global health outcomes through innovative biomedical technologies.\",\n        \"Reduce the impact of climate change on vulnerable populations.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published 3 peer-reviewed articles in high-impact journals.\",\n            \"date\": \"2023-11-01\"\n        },\n        {\n            \"result_description\": \"Developed a new biosensor for detecting environmental pollutants.\",\n            \"date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71496", "text": "{\n    \"collaboration_title\": \"Advanced Materials for Energy Storage\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Robert Green\",\n            \"contact_email\": \"robert.green@mit.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Sarah Lee\",\n            \"contact_email\": \"sarah.lee@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Energy Storage\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"Department of Energy\",\n        \"Tesla Inc.\"\n    ],\n    \"goals\": [\n        \"Develop next-generation materials for energy storage applications.\",\n        \"Improve the efficiency and reliability of battery technology.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Successfully synthesized a novel electrode material.\",\n            \"date\": \"2023-06-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Green\",\n        \"email\": \"robert.green@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71497", "text": "{\n    \"collaboration_title\": \"EcoConnect: Transnational Research on Plastic Pollution\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Technical University of Munich\",\n            \"contact_name\": \"Professor Klaus Richter\",\n            \"contact_email\": \"klaus.richter@tum.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Science\",\n        \"Chemical Engineering\",\n        \"Marine Biology\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Develop biodegradable alternatives to plastic\",\n        \"Assess the impact of microplastics on marine ecosystems\",\n        \"Implement pilot projects for plastic waste reduction in coastal communities\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Successful synthesis of a novel biodegradable polymer from algae.\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71497", "text": "{\n    \"collaboration_title\": \"Theoretical Frameworks for Climate Modeling\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Professor David Chen\",\n            \"contact_email\": \"david.chen@mit.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Maria Rodriguez\",\n            \"contact_email\": \"maria.rodriguez@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Computational Modeling\",\n        \"Mathematics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop advanced climate models\",\n        \"Improve understanding of climate change dynamics\",\n        \"Publish research papers on climate modeling techniques\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a peer-reviewed article on a novel climate modeling algorithm.\",\n            \"date\": \"2024-03-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Professor David Chen\",\n        \"email\": \"david.chen@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71498", "text": "{\n    \"collaboration_title\": \"EU-Africa Green Transition Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford, UK\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Makerere University, Uganda\",\n            \"contact_name\": \"Prof. David Okello\",\n            \"contact_email\": \"david.okello@makerere.ac.ug\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Agriculture\",\n        \"Renewable Energy\",\n        \"Climate Change Adaptation\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"UK Research and Innovation\"\n    ],\n    \"goals\": [\n        \"Develop climate-resilient agricultural practices\",\n        \"Implement renewable energy solutions in rural communities\",\n        \"Assess the impact of climate change on local ecosystems\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Pilot project demonstrating a 20% increase in crop yields using drought-resistant seeds.\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71498", "text": "{\n    \"collaboration_title\": \"Theoretical Modeling of Complex Systems\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology, USA\",\n            \"contact_name\": \"Dr. Ben Carter\",\n            \"contact_email\": \"ben.carter@mit.edu\"\n        },\n        {\n            \"institution\": \"ETH Zurich, Switzerland\",\n            \"contact_name\": \"Prof. Lena Weber\",\n            \"contact_email\": \"lena.weber@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Computational Mathematics\",\n        \"Network Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Swiss National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel mathematical models for complex systems\",\n        \"Investigate the emergence of collective behavior in networks\",\n        \"Advance the understanding of non-equilibrium phenomena\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a groundbreaking paper on the dynamics of complex networks.\",\n            \"publication_date\": \"2023-07-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Ben Carter\",\n        \"email\": \"ben.carter@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71499", "text": "{\n    \"collaboration_title\": \"GreenTech Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@mit.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Professor Ben Carter\",\n            \"contact_email\": \"bcarter@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Power\",\n        \"Energy Storage\",\n        \"Carbon Capture\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\",\n        \"Private Donations\"\n    ],\n    \"goals\": [\n        \"Develop highly efficient solar cells\",\n        \"Improve energy storage capacity\",\n        \"Reduce carbon emissions in industrial processes\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new perovskite solar cell with 25% efficiency\",\n            \"date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@mit.edu\",\n        \"degree\": \"PhD\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71499", "text": "{\n    \"collaboration_title\": \"Biofuel Development Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Chloe Davis\",\n            \"contact_email\": \"cdavis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Illinois at Urbana-Champaign\",\n            \"contact_name\": \"Professor David Evans\",\n            \"contact_email\": \"devans@illinois.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-08-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Biofuels\",\n        \"Biomass Conversion\"\n    ],\n    \"funding_sources\": [\n        \"Private Agricultural Companies\"\n    ],\n    \"goals\": [\n        \"Increase biofuel production efficiency\",\n        \"Develop sustainable biomass sources\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a new enzyme for biomass breakdown\",\n            \"date\": \"2022-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Chloe Davis\",\n        \"email\": \"cdavis@berkeley.edu\",\n        \"degree\": \"Master's\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71500", "text": "{\n    \"collaboration_title\": \"EU-Asia Water Resilience Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford, UK\",\n            \"lead_contact\": \"Dr. Eleanor Vance\"\n        },\n        {\n            \"institution\": \"Tsinghua University, China\",\n            \"lead_contact\": \"Professor Jian Li\"\n        },\n        {\n            \"institution\": \"National University of Singapore\",\n            \"lead_contact\": \"Dr. Mei Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Water Resource Management\",\n        \"Sustainable Development\",\n        \"Climate Change Adaptation\"\n    ],\n    \"funding_sources\": [\n        \"European Commission\",\n        \"National Natural Science Foundation of China\"\n    ],\n    \"goals\": [\n        \"Develop sustainable water management strategies\",\n        \"Improve water quality in transboundary rivers\",\n        \"Enhance climate resilience of water infrastructure\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Impacts of Climate Change on Water Availability in Asia\",\n            \"publication_year\": 2023\n        },\n        {\n            \"result_type\": \"Workshop\",\n            \"title\": \"Water Resilience Workshop – Singapore\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"eleanor.vance@oxford.ac.uk\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71500", "text": "{\n    \"collaboration_title\": \"Historical Analysis of Trade Routes\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Berlin, Germany\",\n            \"lead_contact\": \"Professor Klaus Schmidt\"\n        },\n        {\n            \"institution\": \"Peking University, China\",\n            \"lead_contact\": \"Professor Zhang Wei\"\n        }\n    ],\n    \"collaboration_start_date\": \"2018-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"History\",\n        \"Economics\",\n        \"International Relations\"\n    ],\n    \"funding_sources\": [\n        \"German Research Foundation\"\n    ],\n    \"goals\": [\n        \"Reconstruct historical trade networks\",\n        \"Analyze the economic impact of ancient trade routes\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Book\",\n            \"title\": \"Silk Road Revisited\",\n            \"publication_year\": 2021\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Professor Klaus Schmidt\",\n        \"email\": \"klaus.schmidt@uni-berlin.de\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71501", "text": "{\n    \"collaboration_title\": \"EU-US Sustainable Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@mit.edu\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Professor Klaus Richter\",\n            \"contact_email\": \"klaus.richter@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Energy\",\n        \"Energy Storage\",\n        \"Grid Modernization\"\n    ],\n    \"funding_sources\": [\n        \"US Department of Energy\",\n        \"European Commission Horizon Europe\",\n        \"Swiss Federal Office of Energy\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Improve wind turbine performance\",\n        \"Create advanced energy storage solutions\",\n        \"Optimize smart grid technologies\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published 15 peer-reviewed articles in high-impact journals.\",\n            \"date\": \"2023-12-31\"\n        },\n        {\n            \"description\": \"Developed a prototype for a novel energy storage system.\",\n            \"date\": \"2024-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71501", "text": "{\n    \"collaboration_title\": \"Advanced Materials Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Tokyo\",\n            \"contact_name\": \"Professor Kenji Tanaka\",\n            \"contact_email\": \"kenji.tanaka@utokyo.ac.jp\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Maria Rodriguez\",\n            \"contact_email\": \"maria.rodriguez@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-10-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Nanomaterials\",\n        \"Polymers\",\n        \"Composite Materials\"\n    ],\n    \"funding_sources\": [\n        \"Private Industry Grant\",\n        \"University Funds\"\n    ],\n    \"goals\": [\n        \"Develop novel nanomaterials for various applications\",\n        \"Improve the properties of polymers\",\n        \"Create advanced composite materials\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new type of polymer with enhanced strength.\",\n            \"date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Hiroshi Sato\",\n        \"email\": \"hiroshi.sato@utokyo.ac.jp\",\n        \"affiliation\": \"University of Tokyo\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71502", "text": "{\n    \"collaboration_title\": \"EU-US Green Energy Transition Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\",\n            \"role\": \"Lead Researcher\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Professor David Chen\",\n            \"contact_email\": \"dchen@mit.edu\",\n            \"role\": \"Co-Investigator\"\n        },\n        {\n            \"institution\": \"Siemens Energy\",\n            \"contact_name\": \"Ingrid Schmidt\",\n            \"contact_email\": \"ingrid.schmidt@siemens-energy.com\",\n            \"role\": \"Industry Partner\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Power\",\n        \"Energy Storage\",\n        \"Smart Grids\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"US Department of Energy\",\n        \"Siemens Energy\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Improve energy storage capacity\",\n        \"Optimize smart grid technologies\",\n        \"Reduce carbon emissions\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new perovskite solar cell with 25% efficiency.\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"eleanor.vance@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\",\n        \"degree\": \"PhD in Physics\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71502", "text": "{\n    \"collaboration_title\": \"Historical Energy Consumption Patterns\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Cambridge\",\n            \"contact_name\": \"Dr. Alistair Davies\",\n            \"contact_email\": \"ad89@cam.ac.uk\",\n            \"role\": \"Principal Investigator\"\n        },\n        {\n            \"institution\": \"National Archives, UK\",\n            \"contact_name\": \"Sarah Miller\",\n            \"contact_email\": \"sarah.miller@nationalarchives.gov.uk\",\n            \"role\": \"Data Provider\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-20\",\n    \"collaboration_type\": \"Data Analysis Project\",\n    \"research_areas\": [\n        \"Energy History\",\n        \"Economic History\",\n        \"Social History\"\n    ],\n    \"funding_sources\": [\n        \"British Academy\",\n        \"National Heritage Fund\"\n    ],\n    \"goals\": [\n        \"Analyze historical energy consumption trends in the UK.\",\n        \"Understand the social and economic impact of energy policies.\",\n        \"Create a digital archive of historical energy data.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on coal consumption during the Industrial Revolution.\",\n            \"publication_date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alistair Davies\",\n        \"email\": \"ad89@cam.ac.uk\",\n        \"affiliation\": \"University of Cambridge\",\n        \"degree\": \"PhD in History\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71503", "text": "{\n    \"collaboration_title\": \"Global Alliance for Sustainable Agriculture\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"country\": \"UK\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Kyoto University\",\n            \"country\": \"Japan\",\n            \"contact_name\": \"Professor Kenji Tanaka\",\n            \"contact_email\": \"ktanaka@kyoto.ac.jp\"\n        },\n        {\n            \"institution\": \"Nestle Research\",\n            \"country\": \"Switzerland\",\n            \"contact_name\": \"Ms. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@nestle.com\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Agriculture\",\n        \"Food Security\",\n        \"Climate Change Adaptation\"\n    ],\n    \"funding_sources\": [\n        \"Bill & Melinda Gates Foundation\",\n        \"Rockefeller Foundation\"\n    ],\n    \"goals\": [\n        \"Develop climate-resilient crop varieties\",\n        \"Improve agricultural practices for reduced environmental impact\",\n        \"Enhance food security in developing countries\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Patent\",\n            \"description\": \"Patent filed for a new drought-resistant rice variety.\",\n            \"date\": \"2024-01-20\"\n        },\n        {\n            \"result_type\": \"Field Trial\",\n            \"description\": \"Successful field trials demonstrating increased crop yields with reduced fertilizer usage.\",\n            \"date\": \"2023-11-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"eleanor.vance@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71503", "text": "{\n    \"collaboration_title\": \"European-Asian Research Network on Water Management\",\n    \"partners\": [\n        {\n            \"institution\": \"Delft University of Technology\",\n            \"country\": \"Netherlands\",\n            \"contact_name\": \"Dr. Pieter van der Meer\",\n            \"contact_email\": \"p.vanderMeer@tudelft.nl\"\n        },\n        {\n            \"institution\": \"Tsinghua University\",\n            \"country\": \"China\",\n            \"contact_name\": \"Professor Li Wei\",\n            \"contact_email\": \"li.wei@tsinghua.edu.cn\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Water Management\",\n        \"Hydrology\",\n        \"Environmental Engineering\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"National Natural Science Foundation of China\"\n    ],\n    \"goals\": [\n        \"Develop advanced models for water resource management\",\n        \"Improve water quality monitoring techniques\",\n        \"Foster collaboration between European and Asian researchers\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"description\": \"Published a research paper in a peer-reviewed journal on water quality assessment.\",\n            \"date\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Pieter van der Meer\",\n        \"email\": \"p.vanderMeer@tudelft.nl\",\n        \"affiliation\": \"Delft University of Technology\"\n    }\n}"}
