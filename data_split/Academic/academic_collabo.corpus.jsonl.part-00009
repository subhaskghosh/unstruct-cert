{"_id": "Academic--academic_collabo--n--69561", "text": "{\n    \"collaboration_title\": \"Bioinformatics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. Robert Smith\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Sarah Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-07-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Bioinformatics\",\n        \"Genomics\",\n        \"Computational Biology\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Identify genetic markers for disease\",\n        \"Develop computational tools for genomic analysis\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a new gene associated with Alzheimer's disease\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Michael Davis\",\n        \"email\": \"michael.davis@harvard.edu\"\n    }\n}"}
