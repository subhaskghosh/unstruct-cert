{"_id": "Academic--academic_collabo--p--69854", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Diagnostics\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Healthcare\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for early disease detection.\",\n        \"Improve diagnostic accuracy using machine learning.\",\n        \"Create personalized treatment plans.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"AI-Powered Diagnostic Tool for Cancer\",\n            \"publication_date\": \"2024-03-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69854", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@uw.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-08-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\"\n    ],\n    \"funding_sources\": [\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models.\",\n        \"Analyze the impact of climate change on ecosystems.\",\n        \"Develop mitigation strategies.\"\n    ],\n    \"results\": [\n        {\n            \"report_title\": \"Climate Change Impact Assessment\",\n            \"report_date\": \"2024-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69855", "text": "{\n    \"collaboration_title\": \"AI-Driven Predictive Modeling for Climate Change\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Climate Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop predictive models for climate change impact.\",\n        \"Improve accuracy of climate forecasting.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel Machine Learning Techniques for Climate Prediction\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69855", "text": "{\n    \"collaboration_title\": \"Biomedical Image Analysis Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Sarah Chen\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Mark Wilson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-04-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Biomedical Imaging\",\n        \"Computer Vision\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Private Donations\"\n    ],\n    \"goals\": [\n        \"Improve image analysis techniques for medical diagnosis.\",\n        \"Develop new algorithms for disease detection.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Advanced Image Segmentation Techniques for Cancer Detection\",\n            \"publication_date\": \"2024-06-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@harvardmed.edu\",\n        \"phone\": \"555-987-6543\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69856", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Diagnostics\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Healthcare\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for early disease detection.\",\n        \"Improve diagnostic accuracy.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model for detecting cancer with 95% accuracy.\",\n            \"publication_date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\"\n    }\n}"}
