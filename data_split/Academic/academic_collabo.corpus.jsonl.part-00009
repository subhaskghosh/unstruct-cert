{"_id": "Academic--academic_collabo--p--70444", "text": "{\n    \"collaboration_title\": \"Joint US-EU Solar Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@mit.edu\"\n        },\n        {\n            \"institution\": \"Fraunhofer ISE\",\n            \"contact_name\": \"Dr. Klaus Richter\",\n            \"contact_email\": \"klaus.richter@ise.fraunhofer.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Photovoltaics\",\n        \"Energy Storage\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\",\n        \"European Commission\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Improve energy storage solutions\",\n        \"Reduce the cost of renewable energy\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Perovskite Solar Cells with Enhanced Stability\",\n            \"journal\": \"Nature Energy\",\n            \"date\": \"2023-05-10\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Novel Energy Storage System\",\n            \"patent_number\": \"US12345678B2\",\n            \"date\": \"2022-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70444", "text": "{\n    \"collaboration_title\": \"International Battery Research Network\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Prof. David Lee\",\n            \"contact_email\": \"david.lee@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of Tokyo\",\n            \"contact_name\": \"Prof. Hiroshi Tanaka\",\n            \"contact_email\": \"hiroshi.tanaka@utokyo.ac.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2020-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Battery Technology\",\n        \"Materials Science\",\n        \"Electrochemistry\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"JST\"\n    ],\n    \"goals\": [\n        \"Develop new battery materials\",\n        \"Improve battery performance\",\n        \"Foster collaboration between researchers\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"title\": \"Recent Advances in Lithium-Ion Battery Technology\",\n            \"conference\": \"International Battery Association Meeting\",\n            \"date\": \"2022-09-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Prof. David Lee\",\n        \"email\": \"david.lee@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70445", "text": "{\n    \"collaboration_title\": \"Joint Biofuel Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Robert Smith\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Biofuels\",\n        \"Sustainable Energy\",\n        \"Chemical Engineering\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop novel biofuel production methods\",\n        \"Reduce carbon emissions\",\n        \"Improve energy efficiency\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new catalyst for biofuel production with 20% higher efficiency.\",\n            \"publication_date\": \"2023-06-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70445", "text": "{\n    \"collaboration_title\": \"Theoretical Physics Exchange Program\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Alan Turing\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Dr. Ada Lovelace\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Quantum Mechanics\",\n        \"Astrophysics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Advance understanding of quantum gravity\",\n        \"Develop new mathematical models\",\n        \"Foster international collaboration\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a new paper on string theory.\",\n            \"publication_date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alan Turing\",\n        \"email\": \"alan.turing@mit.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70446", "text": "{\n    \"collaboration_title\": \"Advancing Cancer Immunotherapy: A US-UK Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Professor David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Immunotherapy\",\n        \"Oncology\",\n        \"Molecular Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Cancer Research UK\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapies for aggressive cancers\",\n        \"Improve patient survival rates\",\n        \"Identify biomarkers for treatment response\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Preclinical studies show promising results for a new checkpoint inhibitor combination therapy.\",\n            \"date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvard.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70446", "text": "{\n    \"collaboration_title\": \"Understanding Genetic Predisposition to Cancer\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Robert Chen\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Professor Alice Wong\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-12-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Genetics\",\n        \"Cancer Biology\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"California Institute for Regenerative Medicine\"\n    ],\n    \"goals\": [\n        \"Identify genetic mutations associated with increased cancer risk\",\n        \"Develop predictive models for cancer development\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Genome-wide association study identified several novel genetic variants linked to breast cancer.\",\n            \"date\": \"2022-06-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"email\": \"robert.chen@stanford.edu\"\n    }\n}"}
