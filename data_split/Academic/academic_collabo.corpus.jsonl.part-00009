{"_id": "Academic--academic_collabo--n--69400", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@uw.edu\"\n        },\n        {\n            \"institution\": \"University of British Columbia\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@ubc.ca\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Oceanography\",\n        \"Atmospheric Science\"\n    ],\n    \"funding_sources\": [\n        \"Environment Canada\",\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models.\",\n        \"Understand the impact of climate change on coastal ecosystems.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new climate model.\",\n            \"date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@uw.edu\",\n        \"affiliation\": \"University of Washington\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69401", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Chen\",\n            \"contact_email\": \"alice.chen@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Prof. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for predicting drug efficacy\",\n        \"Identify potential drug candidates faster\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model with 90% accuracy in predicting drug-target interactions.\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Chen\",\n        \"email\": \"alice.chen@stanford.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69401", "text": "{\n    \"collaboration_title\": \"Climate Change Impact Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Prof. David Miller\",\n            \"contact_email\": \"david.miller@washington.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Engineering\"\n    ],\n    \"funding_sources\": [\n        \"Environmental Protection Agency\",\n        \"Private Donations\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal ecosystems\",\n        \"Develop mitigation strategies\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a report detailing the rising sea levels in the Pacific Northwest.\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"phone\": \"555-987-6543\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69402", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for drug target identification\",\n        \"Accelerate drug development process\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"AI-driven identification of novel drug targets\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69402", "text": "{\n    \"collaboration_title\": \"Climate Change and Biodiversity Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-22\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Biodiversity\",\n        \"Ecology\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"National Geographic Society\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on biodiversity\",\n        \"Develop conservation strategies\"\n    ],\n    \"results\": [\n        {\n            \"report_title\": \"Biodiversity loss in the Amazon rainforest\",\n            \"report_date\": \"2024-02-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69403", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug discovery.\",\n        \"Identify potential drug candidates using AI.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new AI model with 90% accuracy in predicting drug efficacy.\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69403", "text": "{\n    \"collaboration_title\": \"Climate Change Impact Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"Oxford University\",\n            \"lead_contact\": \"Dr. David Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Engineering\"\n    ],\n    \"funding_sources\": [\n        \"DOE\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal ecosystems.\",\n        \"Develop mitigation strategies for coastal erosion.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a report on the vulnerability of coastal communities to sea-level rise.\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69404", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Prof. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug discovery.\",\n        \"Identify potential drug candidates using machine learning.\",\n        \"Improve the efficiency of drug development process.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"AI-based prediction of drug efficacy\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69404", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Prof. David Green\",\n            \"contact_email\": \"david.green@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models.\",\n        \"Analyze the impact of climate change on ecosystems.\",\n        \"Develop strategies for climate change mitigation.\"\n    ],\n    \"results\": [\n        {\n            \"report_title\": \"Regional Climate Change Impacts\",\n            \"report_date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69405", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Solutions\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Healthcare Informatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for disease diagnosis.\",\n        \"Improve patient care through machine learning.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model for early cancer detection.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
