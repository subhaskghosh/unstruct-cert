{"_id": "Academic--academic_collabo--p--69116", "text": "{\n    \"collaboration_title\": \"AI-Driven Climate Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"National Renewable Energy Laboratory\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@nrel.gov\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Climate Modeling\",\n        \"Renewable Energy\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for improved climate predictions.\",\n        \"Optimize renewable energy grid integration using AI.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new AI model for predicting extreme weather events.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
