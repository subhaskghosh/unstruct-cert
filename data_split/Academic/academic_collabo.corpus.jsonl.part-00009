{"_id": "Academic--academic_collabo--n--69474", "text": "{\n    \"collaboration_title\": \"Biomedical Image Analysis Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@harvard.edu\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"contact_name\": \"Prof. David Lee\",\n            \"contact_email\": \"david.lee@ucsf.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Medical Imaging\",\n        \"Computer Vision\",\n        \"Biomedical Engineering\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Private Donations\"\n    ],\n    \"goals\": [\n        \"Develop new methods for analyzing medical images\",\n        \"Improve the diagnosis of diseases\",\n        \"Enhance patient care\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new tool for detecting cancer cells in medical images.\",\n            \"date_achieved\": \"2024-04-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69475", "text": "{\n    \"collaboration_title\": \"Joint Research in NLP and ML for Healthcare\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Smith\",\n            \"contact_email\": \"alice.smith@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Bob Johnson\",\n            \"contact_email\": \"bob.johnson@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Natural Language Processing\",\n        \"Healthcare Informatics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Google AI Research\"\n    ],\n    \"goals\": [\n        \"Develop novel NLP models for medical diagnosis.\",\n        \"Improve machine learning algorithms for patient outcome prediction.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on a new deep learning model for disease detection.\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Smith\",\n        \"email\": \"alice.smith@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
