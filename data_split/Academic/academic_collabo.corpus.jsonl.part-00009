{"_id": "Academic--academic_collabo--n--71808", "text": "{\n    \"collaboration_title\": \"Global Oncology Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@harvard.edu\"\n        },\n        {\n            \"institution\": \"National Cancer Institute (USA)\",\n            \"contact_name\": \"Dr. Maria Rodriguez\",\n            \"contact_email\": \"maria.rodriguez@cancer.gov\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-01-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cancer Treatment\",\n        \"Radiation Oncology\",\n        \"Patient Care\"\n    ],\n    \"funding_sources\": [\n        \"Pfizer Foundation\",\n        \"Bristol Myers Squibb\"\n    ],\n    \"goals\": [\n        \"Improve cancer survival rates\",\n        \"Enhance cancer patient quality of life\",\n        \"Develop personalized cancer therapies\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Improved radiation therapy protocols for lung cancer patients\",\n            \"publication_date\": \"2023-03-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
