{"_id": "Academic--academic_collabo--p--69980", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new AI algorithms for drug discovery.\",\n        \"Identify potential drug candidates more efficiently.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in Nature demonstrating a novel AI-based drug prediction method.\",\n            \"publication_date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69980", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Oxford University\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-08-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction accuracy.\",\n        \"Develop sustainable energy solutions.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new regional climate model.\",\n            \"publication_date\": \"2024-05-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69981", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification.\",\n        \"Improve drug efficacy prediction using machine learning models.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"AI-Driven Identification of Novel Drug Targets\",\n            \"publication_date\": \"2024-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\"\n    }\n}"}
