{"_id": "Academic--academic_collabo--p--70280", "text": "{\n    \"collaboration_title\": \"AI-Neuro Collaboration for Cognitive Modeling\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Neuroscience\",\n        \"Artificial Intelligence\",\n        \"Cognitive Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms inspired by brain function\",\n        \"Improve understanding of cognitive processes through computational modeling\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a groundbreaking paper on spiking neural networks.\",\n            \"publication_date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\",\n        \"citation_count\": 780\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70280", "text": "{\n    \"collaboration_title\": \"Materials Science Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@mit.edu\"\n        },\n        {\n            \"institution\": \"California Institute of Technology\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@caltech.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Chemistry\",\n        \"Engineering\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop new materials with improved properties\",\n        \"Explore the relationship between material structure and function\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Successfully synthesized a novel alloy with enhanced strength.\",\n            \"publication_date\": \"2024-01-12\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\",\n        \"citation_count\": 250\n    }\n}"}
