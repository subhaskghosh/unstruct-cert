{"_id": "Academic--academic_collabo--p--69208", "text": "{\n    \"collaboration_title\": \"Joint Research on AI-Driven Medical Imaging\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\",\n        \"Google AI\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for medical image analysis.\",\n        \"Improve the accuracy of disease diagnosis using computer vision.\",\n        \"Publish research findings in top-tier conferences.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new deep learning model for detecting cancer in X-ray images with 95% accuracy.\",\n            \"publication\": \"Published in IEEE Transactions on Medical Imaging, 2024\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69208", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Dr. David Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate change predictions.\",\n        \"Understand the impact of climate change on ecosystems.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new climate model that incorporates ocean currents.\",\n            \"publication\": \"Published in Nature Climate Change, 2023\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
