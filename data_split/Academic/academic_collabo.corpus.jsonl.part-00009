{"_id": "Academic--academic_collabo--p--70631", "text": "{\n    \"collaboration_title\": \"US-Canada Transboundary Water Quality Research\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Michigan\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@umich.edu\"\n        },\n        {\n            \"institution\": \"University of Alberta\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@ualberta.ca\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Science\",\n        \"Water Quality\",\n        \"Ecology\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Natural Sciences and Engineering Research Council of Canada\"\n    ],\n    \"goals\": [\n        \"Assess water quality in transboundary watersheds\",\n        \"Develop predictive models for water quality changes\",\n        \"Inform policy decisions related to water resource management\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Impact of Climate Change on Freshwater Ecosystems\",\n            \"publication_venue\": \"Environmental Science & Technology\",\n            \"publication_date\": \"2023-02-28\"\n        },\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Modeling Nutrient Transport in Large River Systems\",\n            \"publication_venue\": \"Journal of Hydrology\",\n            \"publication_date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@umich.edu\",\n        \"affiliation\": \"University of Michigan\"\n    }\n}"}
