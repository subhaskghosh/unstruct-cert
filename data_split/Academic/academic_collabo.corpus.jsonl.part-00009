{"_id": "Academic--academic_collabo--n--69863", "text": "{\n    \"collaboration_title\": \"Biomedical Image Analysis Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. David Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Biomedical Imaging\",\n        \"Machine Learning\",\n        \"Medical Diagnostics\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Develop novel image analysis techniques.\",\n        \"Improve the diagnosis of diseases.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Deep Learning for Cancer Detection\",\n            \"publication_date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69864", "text": "{\n    \"collaboration_title\": \"AI-Driven Medical Diagnosis Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Prof. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH Grant\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for accurate medical diagnosis\",\n        \"Improve patient outcomes through early detection\",\n        \"Publish research findings in peer-reviewed journals\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel AI model for detecting pneumonia from chest X-rays with 95% accuracy.\",\n            \"date\": \"2023-12-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
