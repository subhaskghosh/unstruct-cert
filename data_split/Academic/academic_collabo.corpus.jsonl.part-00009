{"_id": "Academic--academic_collabo--p--70052", "text": "{\n    \"collaboration_title\": \"EU-Asia Green Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Technical University of Denmark\",\n            \"contact_name\": \"Dr. Astrid Olsen\",\n            \"contact_email\": \"astrid.olsen@dtu.dk\",\n            \"region\": \"Europe\"\n        },\n        {\n            \"institution\": \"Tsinghua University\",\n            \"contact_name\": \"Professor Wei Li\",\n            \"contact_email\": \"wei.li@tsinghua.edu.cn\",\n            \"region\": \"Asia\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Energy\",\n        \"Energy Storage\",\n        \"Smart Grids\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"National Natural Science Foundation of China\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Improve wind turbine technology for offshore applications\",\n        \"Create advanced energy storage solutions\",\n        \"Establish a sustainable energy testbed\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Perovskite Solar Cells with Enhanced Stability\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Astrid Olsen\",\n        \"email\": \"astrid.olsen@dtu.dk\",\n        \"affiliation\": \"Technical University of Denmark\"\n    }\n}"}
