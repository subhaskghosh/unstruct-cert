{"_id": "Academic--academic_collabo--n--70577", "text": "{\n    \"collaboration_title\": \"Cardiovascular Disease Study Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. Sarah Johnson\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-08-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiology\",\n        \"Vascular Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"American Heart Association\"\n    ],\n    \"goals\": [\n        \"Investigate the causes of heart disease\",\n        \"Develop new treatments for cardiovascular conditions\",\n        \"Improve patient outcomes\",\n        \"Disseminate research findings\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"New Biomarker for Heart Failure Risk\",\n            \"publication_date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@ucsf.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70578", "text": "{\n    \"collaboration_title\": \"Joint Cancer Immunotherapy Development Program\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@harvard.edu\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@dfci.harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Immunology\",\n        \"Immunotherapy\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Stand Up To Cancer\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapy treatments for melanoma\",\n        \"Identify biomarkers for predicting immunotherapy response\",\n        \"Improve patient outcomes in advanced cancers\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel T cell receptor targeting melanoma-associated antigen.\",\n            \"publication_date\": \"2023-07-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70578", "text": "{\n    \"collaboration_title\": \"Neurodegenerative Disease Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. Sarah Chen\",\n            \"contact_email\": \"sarah.chen@ucsf.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2020-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Neuroscience\",\n        \"Neurodegenerative Diseases\",\n        \"Genetics\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Alzheimer's Association\"\n    ],\n    \"goals\": [\n        \"Investigate the genetic basis of Alzheimer's disease\",\n        \"Develop biomarkers for early diagnosis of Parkinson's disease\",\n        \"Understand the role of inflammation in neurodegeneration\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a genetic variant associated with increased risk of Alzheimer's disease.\",\n            \"publication_date\": \"2022-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@ucsf.edu\",\n        \"affiliation\": \"University of California, San Francisco\"\n    }\n}"}
