{"_id": "Academic--academic_collabo--n--71227", "text": "{\n    \"collaboration_title\": \"Theoretical Frameworks for Fusion Energy\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. James Bennett\",\n            \"contact_email\": \"james.bennett@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Princeton Plasma Physics Laboratory\",\n            \"contact_name\": \"Professor Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@pppl.gov\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Plasma Physics\",\n        \"Fusion Energy\",\n        \"Theoretical Modeling\"\n    ],\n    \"funding_sources\": [\n        \"Government Grants\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop advanced plasma confinement models\",\n        \"Investigate the stability of fusion plasmas\",\n        \"Explore new fusion reactor designs\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Paper\",\n            \"title\": \"Kinetic Simulations of Plasma Turbulence\",\n            \"conference_name\": \"APS-DPP\",\n            \"date\": \"2023-10-27\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71228", "text": "{\n    \"collaboration_title\": \"GreenMat Innovation Network\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Prof. Robert Langer\"\n        },\n        {\n            \"institution\": \"BASF SE\",\n            \"lead_contact\": \"Dr. Klaus Schmidt\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Sustainability\",\n        \"Materials Science\",\n        \"Nanotechnology\",\n        \"Renewable Energy\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"BASF SE\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop sustainable materials for energy storage\",\n        \"Reduce carbon footprint of material production\",\n        \"Create biodegradable plastics\",\n        \"Improve efficiency of solar cells\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published 3 papers in Nature Materials\",\n            \"date\": \"2023-11-01\"\n        },\n        {\n            \"description\": \"Developed a new biodegradable polymer with enhanced strength\",\n            \"date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71228", "text": "{\n    \"collaboration_title\": \"Quantum Entanglement Study Group\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"California Institute of Technology\",\n            \"lead_contact\": \"Prof. Benjamin Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Quantum Physics\",\n        \"Theoretical Physics\",\n        \"Computational Physics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Explore the fundamental principles of quantum entanglement\",\n        \"Develop new theoretical models for quantum systems\",\n        \"Investigate the potential for quantum computing\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel theoretical framework for understanding quantum decoherence\",\n            \"date\": \"2023-09-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Charles Wilson\",\n        \"email\": \"charles.wilson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71229", "text": "{\n    \"collaboration_title\": \"International Cancer Therapeutics Alliance\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Professor Alistair Davies\"\n        },\n        {\n            \"institution\": \"National Cancer Institute, China\",\n            \"lead_contact\": \"Dr. Wei Li\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Drug Discovery\",\n        \"Immunotherapy\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Wellcome Trust\",\n        \"American Cancer Society\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapies for aggressive cancers\",\n        \"Identify new drug targets\",\n        \"Improve cancer treatment efficacy\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified a novel biomarker for predicting immunotherapy response.\",\n            \"date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71229", "text": "{\n    \"collaboration_title\": \"Cancer Diagnostic Biomarker Study\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. David Miller\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Professor Sarah Johnson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cancer Diagnostics\",\n        \"Genomics\",\n        \"Biomarker Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"California Cancer Research Fund\"\n    ],\n    \"goals\": [\n        \"Identify novel biomarkers for early cancer detection\",\n        \"Develop more accurate diagnostic tests\",\n        \"Improve cancer screening rates\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new ELISA assay for detecting a specific cancer antigen.\",\n            \"date\": \"2023-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Miller\",\n        \"email\": \"david.miller@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71230", "text": "{\n    \"collaboration_title\": \"GreenTech Innovation Network\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"country\": \"United Kingdom\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"country\": \"United States\",\n            \"lead_contact\": \"Professor David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Science\",\n        \"Sustainable Technology\",\n        \"Materials Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"European Research Council\",\n        \"Industry Partners\"\n    ],\n    \"goals\": [\n        \"Develop novel biodegradable plastics\",\n        \"Improve solar energy conversion efficiency\",\n        \"Reduce carbon emissions\"\n    ],\n    \"results\": [\n        {\n            \"type\": \"Publication\",\n            \"title\": \"Novel Biodegradable Polymer Synthesis\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, D.\"\n            ]\n        },\n        {\n            \"type\": \"Patent\",\n            \"title\": \"High-Efficiency Solar Cell Design\",\n            \"inventors\": [\n                \"Lee, D.\",\n                \"Carter, E.\"\n            ]\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@oxford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71230", "text": "{\n    \"collaboration_title\": \"Climate Change Predictive Modeling Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"ETH Zurich\",\n            \"country\": \"Switzerland\",\n            \"lead_contact\": \"Professor Klaus Schmidt\"\n        },\n        {\n            \"institution\": \"University of Toronto\",\n            \"country\": \"Canada\",\n            \"lead_contact\": \"Dr. Anya Sharma\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"Swiss National Science Foundation\",\n        \"Natural Sciences and Engineering Research Council of Canada\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction accuracy\",\n        \"Analyze long-term climate trends\",\n        \"Develop advanced climate models\"\n    ],\n    \"results\": [\n        {\n            \"type\": \"Report\",\n            \"title\": \"Long-Term Climate Trend Analysis\",\n            \"authors\": [\n                \"Schmidt, K.\",\n                \"Sharma, A.\"\n            ]\n        },\n        {\n            \"type\": \"Software\",\n            \"title\": \"Advanced Climate Modeling Tool\",\n            \"developers\": [\n                \"Schmidt, K.\",\n                \"Sharma, A.\"\n            ]\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Professor Klaus Schmidt\",\n        \"email\": \"klaus.schmidt@ethz.ch\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71231", "text": "{\n    \"collaboration_title\": \"Transatlantic Alliance for Sustainable Futures\",\n    \"partners\": [\n        {\n            \"institution_name\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@berkeley.edu\",\n            \"region\": \"North America\"\n        },\n        {\n            \"institution_name\": \"ETH Zurich\",\n            \"contact_name\": \"Prof. Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@ethz.ch\",\n            \"region\": \"Europe\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Renewable Energy\",\n        \"Climate Change Mitigation\",\n        \"Sustainable Agriculture\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Develop novel solar cell technologies\",\n        \"Model climate change impacts on agricultural yields\",\n        \"Promote sustainable land management practices\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"High-Efficiency Perovskite Solar Cells\",\n            \"publication_date\": \"2023-10-26\",\n            \"journal\": \"Nature Energy\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Sustainable Crop Rotation System\",\n            \"patent_number\": \"US12345678B2\",\n            \"issue_date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71231", "text": "{\n    \"collaboration_title\": \"Industrial Innovation in Materials Science\",\n    \"partners\": [\n        {\n            \"institution_name\": \"MIT\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\",\n            \"region\": \"North America\"\n        },\n        {\n            \"institution_name\": \"Siemens AG\",\n            \"contact_name\": \"Ingo Bauer\",\n            \"contact_email\": \"ingo.bauer@siemens.com\",\n            \"region\": \"Europe\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-01\",\n    \"collaboration_type\": \"Technology Transfer\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"Siemens AG\",\n        \"MIT Industrial Consortium\"\n    ],\n    \"goals\": [\n        \"Develop advanced composite materials\",\n        \"Improve manufacturing processes\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Prototype\",\n            \"description\": \"New lightweight composite material for automotive applications\",\n            \"status\": \"Under Testing\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Ingo Bauer\",\n        \"email\": \"ingo.bauer@siemens.com\",\n        \"affiliation\": \"Siemens AG\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71232", "text": "{\n    \"collaboration_title\": \"Transatlantic Oncology Research Alliance\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@harvard.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Professor Alistair Finch\",\n            \"contact_email\": \"alistair.finch@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Immunotherapy\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Cancer Research UK\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer therapies\",\n        \"Improve cancer diagnosis methods\",\n        \"Understand cancer metastasis\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Immunotherapy Approach for Triple-Negative Breast Cancer\",\n            \"publication_date\": \"2023-11-01\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Targeted Drug Delivery System for Pancreatic Cancer\",\n            \"patent_number\": \"US12345678B2\"\n        },\n        {\n            \"result_type\": \"Clinical Trial\",\n            \"title\": \"Phase II Trial of Novel Cancer Vaccine\",\n            \"trial_status\": \"Completed\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Vivian Holloway\",\n        \"email\": \"vivian.holloway@example.com\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71232", "text": "{\n    \"collaboration_title\": \"Computational Cancer Modeling Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology (MIT)\",\n            \"contact_name\": \"Dr. Charles Sterling\",\n            \"contact_email\": \"charles.sterling@mit.edu\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Professor Ingrid Bauer\",\n            \"contact_email\": \"ingrid.bauer@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-07-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Computational Biology\",\n        \"Mathematical Modeling\",\n        \"Cancer Systems Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation (NSF)\"\n    ],\n    \"goals\": [\n        \"Develop computational models of cancer progression\",\n        \"Predict the effects of different treatments\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"A Novel Mathematical Model of Tumor Growth\",\n            \"publication_date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Charles Sterling\",\n        \"email\": \"charles.sterling@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71233", "text": "{\n    \"collaboration_title\": \"EU-EcoConnect: Collaborative Research on Ecosystem Restoration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford, UK\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Technical University of Munich, Germany\",\n            \"contact_name\": \"Prof. Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@tum.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Ecology\",\n        \"Environmental Science\",\n        \"Sustainability\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Develop innovative ecosystem restoration techniques.\",\n        \"Assess the impact of climate change on biodiversity.\",\n        \"Contribute to climate change mitigation strategies.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a peer-reviewed paper on novel restoration methods.\",\n            \"date_achieved\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"eleanor.vance@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
