{"_id": "Academic--academic_collabo--n--69918", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study on Climate Change Impacts\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"lead_contact\": \"Prof. David Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-07-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Engineering\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"EPA\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal ecosystems\",\n        \"Develop mitigation strategies for reducing greenhouse gas emissions\",\n        \"Share research data and expertise\"\n    ],\n    \"results\": [\n        {\n            \"report\": \"Impacts of Rising Sea Levels\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
