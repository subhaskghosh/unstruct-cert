{"_id": "Academic--academic_collabo--p--69812", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification.\",\n        \"Accelerate the drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper on a new AI model for predicting drug efficacy.\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69812", "text": "{\n    \"collaboration_title\": \"Climate Change Impact Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Garcia\",\n            \"contact_email\": \"david.garcia@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Emily Rodriguez\",\n            \"contact_email\": \"emily.rodriguez@oxford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Policy\"\n    ],\n    \"funding_sources\": [\n        \"European Union\",\n        \"Government Grant\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal communities.\",\n        \"Develop mitigation strategies.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Completed a comprehensive report on sea-level rise.\",\n            \"publication_date\": \"2024-03-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Frank Wilson\",\n        \"email\": \"frank.wilson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69813", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new AI algorithms for drug target identification.\",\n        \"Accelerate the drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel AI model for predicting drug-target interactions with 90% accuracy.\",\n            \"date\": \"2023-12-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69813", "text": "{\n    \"collaboration_title\": \"AI and Robotics Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. David Lee\"\n        },\n        {\n            \"institution\": \"Carnegie Mellon University\",\n            \"lead_contact\": \"Dr. Emily Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Robotics\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Advance the state-of-the-art in AI and robotics.\",\n        \"Foster collaboration between leading researchers.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a joint research paper on reinforcement learning.\",\n            \"date\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Frank Green\",\n        \"email\": \"frank.green@cmu.edu\",\n        \"affiliation\": \"Carnegie Mellon University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69814", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Chen\",\n            \"contact_email\": \"alice.chen@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Bioinformatics\",\n        \"Artificial Intelligence\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel machine learning models for drug discovery.\",\n        \"Identify potential drug candidates using AI.\",\n        \"Publish research findings in peer-reviewed journals.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new AI model with 90% accuracy in predicting drug efficacy.\",\n            \"date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Chen\",\n        \"email\": \"alice.chen@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
