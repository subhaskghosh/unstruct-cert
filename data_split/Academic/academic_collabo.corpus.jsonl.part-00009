{"_id": "Academic--academic_collabo--p--69464", "text": "{\n    \"collaboration_title\": \"Joint Research on AI-Driven Image Analysis\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Prof. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Artificial Intelligence\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop novel algorithms for image recognition\",\n        \"Improve the accuracy of object detection systems\",\n        \"Publish research findings in top-tier conferences\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"A Novel Approach to Image Classification\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69464", "text": "{\n    \"collaboration_title\": \"Bioinformatics Data Analysis Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Sarah Chen\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Prof. Michael Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-10-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Bioinformatics\",\n        \"Genomics\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Identify genetic markers for disease susceptibility\",\n        \"Develop new methods for analyzing genomic data\",\n        \"Share expertise in bioinformatics techniques\"\n    ],\n    \"results\": [\n        {\n            \"report_title\": \"Genomic Analysis of Cancer Patients\",\n            \"report_date\": \"2024-07-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
