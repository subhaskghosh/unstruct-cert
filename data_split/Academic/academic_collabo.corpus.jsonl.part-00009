{"_id": "Academic--academic_collabo--p--69227", "text": "{\n    \"collaboration_title\": \"Joint Research in AI-Driven Medical Imaging\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for image analysis\",\n        \"Improve diagnostic accuracy in medical imaging\",\n        \"Publish research findings in peer-reviewed journals\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new deep learning model for detecting tumors in MRI scans with 95% accuracy.\",\n            \"date_achieved\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69227", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Collaboration on Data Science\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Carnegie Mellon University\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@cmu.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Data Mining\",\n        \"Statistics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Amazon Research Awards\"\n    ],\n    \"goals\": [\n        \"Facilitate knowledge sharing between researchers\",\n        \"Explore new applications of data science\",\n        \"Train students in cutting-edge techniques\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Organized a joint workshop on data science best practices.\",\n            \"date_achieved\": \"2023-08-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"phone\": \"555-987-6543\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69228", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Prof. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug discovery.\",\n        \"Identify potential drug candidates for cancer treatment.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new AI model with 90% accuracy in predicting drug efficacy.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69228", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Prof. David Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"DOE\",\n        \"European Union\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate change models.\",\n        \"Assess the impact of climate change on ecosystems.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a study on the impact of rising sea levels on coastal communities.\",\n            \"publication_date\": \"2023-12-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"phone\": \"555-987-6543\"\n    }\n}"}
