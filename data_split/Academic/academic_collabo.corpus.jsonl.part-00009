{"_id": "Academic--academic_collabo--p--69232", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"joint research project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new AI algorithms for drug target identification\",\n        \"Accelerate the drug discovery process\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified 5 potential drug targets using a novel AI model.\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69232", "text": "{\n    \"collaboration_title\": \"Global Student Mobility Program\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Professor Emily Carter\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Professor David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-10\",\n    \"collaboration_type\": \"student exchange\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Computer Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Facilitate student exchange between Oxford and Berkeley\",\n        \"Promote cross-cultural understanding\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Successfully exchanged 20 students between the two universities.\",\n            \"date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Frank Miller\",\n        \"email\": \"frank.miller@oxford.ac.uk\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69233", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Chen\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Prof. Robert Davis\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug discovery\",\n        \"Identify potential drug candidates\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new machine learning model for predicting drug efficacy.\",\n            \"publication\": \"Journal of Chemical Informatics, 2024\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Wilson\",\n        \"email\": \"emily.wilson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
