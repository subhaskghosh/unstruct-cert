{"_id": "Academic--academic_collabo--n--69925", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study on Bio-Inspired Robotics\",\n    \"partners\": [\n        {\n            \"institution\": \"Carnegie Mellon University\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. David Evans\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Robotics\",\n        \"Bio-Inspired Design\",\n        \"Mechanical Engineering\"\n    ],\n    \"funding_sources\": [\n        \"Defense Advanced Research Projects Agency (DARPA)\",\n        \"National Institutes of Health (NIH)\"\n    ],\n    \"goals\": [\n        \"Develop bio-inspired robotic systems.\",\n        \"Improve the efficiency of robotic locomotion.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new robotic leg design.\",\n            \"publication_date\": \"2024-07-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Carol Davis\",\n        \"email\": \"carol.davis@cmu.edu\",\n        \"phone\": \"555-987-6543\"\n    }\n}"}
