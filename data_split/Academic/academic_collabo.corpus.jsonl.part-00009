{"_id": "Academic--academic_collabo--p--70776", "text": "{\n    \"collaboration_title\": \"Global Climate Change Mitigation Network\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Professor David Archer\",\n            \"contact_email\": \"david.archer@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Renewable Energy\",\n        \"Carbon Capture\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Develop advanced climate models\",\n        \"Identify scalable renewable energy solutions\",\n        \"Improve carbon capture technologies\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Carbon Capture Materials\",\n            \"date\": \"2023-10-26\",\n            \"impact_score\": 8.5\n        },\n        {\n            \"result_type\": \"Report\",\n            \"title\": \"Climate Change Projections for Coastal Regions\",\n            \"date\": \"2024-01-12\",\n            \"impact_score\": 9.2\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"email\": \"robert.chen@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
