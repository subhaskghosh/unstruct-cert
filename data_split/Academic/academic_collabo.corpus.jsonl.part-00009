{"_id": "Academic--academic_collabo--p--70580", "text": "{\n    \"collaboration_title\": \"Global Coral Reef Restoration Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Queensland\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@uq.edu.au\"\n        },\n        {\n            \"institution\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n            \"contact_name\": \"Dr. James Wilson\",\n            \"contact_email\": \"james.wilson@noaa.gov\"\n        },\n        {\n            \"institution\": \"The Nature Conservancy\",\n            \"contact_name\": \"Sarah Lee\",\n            \"contact_email\": \"sarah.lee@tnc.org\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Marine Biology\",\n        \"Environmental Science\",\n        \"Climate Change\"\n    ],\n    \"funding_sources\": [\n        \"Australian Research Council\",\n        \"NOAA Coral Reef Conservation Program\",\n        \"Bloomberg Philanthropies\"\n    ],\n    \"goals\": [\n        \"Restore degraded coral reef ecosystems\",\n        \"Develop new coral propagation techniques\",\n        \"Assess the impact of climate change on coral reefs\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Successful transplantation of over 10,000 coral fragments\",\n            \"publication_date\": \"2023-10-26\"\n        },\n        {\n            \"result_description\": \"Identification of heat-resistant coral strains\",\n            \"publication_date\": \"2024-02-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@uq.edu.au\",\n        \"affiliation\": \"University of Queensland\"\n    }\n}"}
