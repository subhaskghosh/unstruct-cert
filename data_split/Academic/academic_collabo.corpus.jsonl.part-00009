{"_id": "Academic--academic_collabo--n--69279", "text": "{\n    \"collaboration_title\": \"Joint AI and Robotics Project\",\n    \"partners\": [\n        {\n            \"institution\": \"Carnegie Mellon University\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@cmu.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"joint research project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Robotics\",\n        \"Computer Vision\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop intelligent robotic systems.\",\n        \"Advance AI algorithms for autonomous navigation.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Autonomous robot navigation using deep reinforcement learning\",\n            \"publication_date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Miller\",\n        \"email\": \"david.miller@cmu.edu\",\n        \"phone\": \"412-555-3434\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69280", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Professor David Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new AI algorithms for drug target identification\",\n        \"Accelerate drug discovery process\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified 5 potential drug candidates\",\n            \"date\": \"2023-12-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69280", "text": "{\n    \"collaboration_title\": \"Climate Change Impact Assessment\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Sarah Lee\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Professor James Wilson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Studies\",\n        \"Ecology\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"Schmidt Futures\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal ecosystems\",\n        \"Develop strategies for mitigating climate change effects\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a report on rising sea levels\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Lee\",\n        \"email\": \"sarah.lee@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69281", "text": "{\n    \"collaboration_title\": \"Joint Research on AI-Driven Image Analysis\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Artificial Intelligence\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop novel algorithms for image recognition\",\n        \"Improve the accuracy of object detection systems\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"A Novel Approach to Image Segmentation\",\n            \"publication_date\": \"2024-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69281", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study on Cognitive Psychology\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. David Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-07-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cognitive Psychology\",\n        \"Behavioral Science\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\"\n    ],\n    \"goals\": [\n        \"Investigate the cognitive processes underlying decision-making\",\n        \"Explore the impact of emotions on attention\"\n    ],\n    \"results\": [\n        {\n            \"report_title\": \"Findings on Emotional Impact\",\n            \"report_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69282", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Bioinformatics\",\n        \"Artificial Intelligence\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification\",\n        \"Accelerate the drug discovery process\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new machine learning model with improved accuracy in predicting drug-target interactions.\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69282", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\",\n        \"Environmental Engineering\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"National Geographic Society\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate change predictions\",\n        \"Understand the impact of climate change on ecosystems\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper on the impact of deforestation on global temperatures.\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69283", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for identifying potential drug candidates.\",\n        \"Accelerate the drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel AI algorithm for predicting drug efficacy.\",\n            \"date\": \"2023-12-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
