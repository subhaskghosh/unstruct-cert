{"_id": "Academic--academic_collabo--p--70634", "text": "{\n    \"collaboration_title\": \"Joint Study on Targeted Cancer Therapies\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Drug Discovery\",\n        \"Genomics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Cancer Research UK\"\n    ],\n    \"goals\": [\n        \"Identify novel drug targets for cancer treatment\",\n        \"Develop personalized cancer therapies\",\n        \"Improve patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published findings on a new biomarker for predicting treatment response.\",\n            \"publication_date\": \"2024-03-10\"\n        },\n        {\n            \"result_description\": \"Developed a novel drug candidate currently in preclinical trials.\",\n            \"publication_date\": \"2024-06-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@ucsf.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70634", "text": "{\n    \"collaboration_title\": \"Advancing Immunotherapy for Melanoma\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Sarah Johnson\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-01-05\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Immunology\",\n        \"Cancer Research\",\n        \"Immunotherapy\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"American Cancer Society\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapy approaches for melanoma\",\n        \"Improve the efficacy of existing immunotherapies\",\n        \"Understand the mechanisms of immune resistance\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a review article on the latest advances in melanoma immunotherapy.\",\n            \"publication_date\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@harvard.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70635", "text": "{\n    \"collaboration_title\": \"Joint Cancer Genomics Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Genomics\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Susan G. Komen Foundation\",\n        \"Stand Up To Cancer\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer biomarkers\",\n        \"Develop targeted cancer therapies\",\n        \"Improve cancer patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Genomic Biomarkers for Pancreatic Cancer\",\n            \"publication_date\": \"2023-05-20\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Targeted Therapy for Breast Cancer\",\n            \"patent_number\": \"US12345678B2\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvard.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70635", "text": "{\n    \"collaboration_title\": \"Neurodegenerative Disease Study\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. Sarah Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-01-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Neuroscience\",\n        \"Neurodegenerative Diseases\",\n        \"Genetics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Alzheimer's Association\"\n    ],\n    \"goals\": [\n        \"Understand the genetic basis of Alzheimer's disease\",\n        \"Develop early diagnostic tools for Parkinson's disease\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"title\": \"Genetic Risk Factors for Parkinson's Disease\",\n            \"conference_name\": \"International Neuroscience Conference\",\n            \"presentation_date\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Michael Brown\",\n        \"email\": \"michael.brown@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70636", "text": "{\n    \"collaboration_title\": \"Joint Cancer Therapy Development Project\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Immunotherapy\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"American Cancer Society\",\n        \"Susan G. Komen Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer therapies\",\n        \"Improve patient survival rates\",\n        \"Understand cancer metastasis\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a new drug target for pancreatic cancer.\",\n            \"date_achieved\": \"2024-03-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvardmed.edu\",\n        \"phone\": \"617-555-1234\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70636", "text": "{\n    \"collaboration_title\": \"Aging and Cancer Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Anya Sharma\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Ben Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-11-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cancer Genetics\",\n        \"Gerontology\",\n        \"Aging Process\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"California Institute for Regenerative Medicine\"\n    ],\n    \"goals\": [\n        \"Investigate the link between aging and cancer development\",\n        \"Identify biomarkers for early cancer detection\",\n        \"Develop strategies to prevent age-related cancers\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Discovered a correlation between telomere length and cancer risk.\",\n            \"date_achieved\": \"2023-09-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@berkeley.edu\",\n        \"phone\": \"510-555-5678\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70637", "text": "{\n    \"collaboration_title\": \"Novel Immunotherapy Approaches for Pancreatic Cancer\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Research\",\n        \"Immunotherapy\",\n        \"Biomedical Engineering\",\n        \"Genomics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Stand Up To Cancer Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapy strategies for pancreatic cancer\",\n        \"Identify biomarkers for predicting response to immunotherapy\",\n        \"Improve patient outcomes in pancreatic cancer\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel T cell receptor targeting a tumor-associated antigen\",\n            \"publication_date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@mit.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70637", "text": "{\n    \"collaboration_title\": \"Cardiovascular Disease Risk Factors in Rural Populations\",\n    \"partners\": [\n        {\n            \"institution\": \"University of North Carolina at Chapel Hill\",\n            \"lead_contact\": \"Dr. Sarah Johnson\"\n        },\n        {\n            \"institution\": \"Duke University\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-08-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiovascular Disease\",\n        \"Public Health\",\n        \"Epidemiology\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"American Heart Association\"\n    ],\n    \"goals\": [\n        \"Investigate the prevalence of cardiovascular disease risk factors in rural communities\",\n        \"Develop interventions to promote cardiovascular health\",\n        \"Reduce disparities in cardiovascular disease outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Demonstrated a correlation between dietary sodium intake and blood pressure in rural populations\",\n            \"publication_date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@unc.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70638", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Prof. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new AI algorithms for drug target identification\",\n        \"Accelerate the drug discovery process\",\n        \"Identify potential drug candidates for cancer treatment\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model with improved accuracy in predicting drug-target interactions.\",\n            \"date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70638", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@uw.edu\"\n        },\n        {\n            \"institution\": \"University of British Columbia\",\n            \"contact_name\": \"Prof. Michael Brown\",\n            \"contact_email\": \"michael.brown@ubc.ca\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Environment Canada\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate change models\",\n        \"Understand the impact of climate change on ecosystems\",\n        \"Develop strategies for mitigating climate change\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a peer-reviewed paper on the impact of deforestation on regional climate patterns.\",\n            \"date\": \"2024-08-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@uw.edu\",\n        \"affiliation\": \"University of Washington\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70639", "text": "{\n    \"collaboration_title\": \"Targeted Cancer Therapy Development Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@mit.edu\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@ucsf.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Drug Discovery\",\n        \"Personalized Medicine\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\",\n        \"Stand Up to Cancer Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel targeted therapies for aggressive cancers.\",\n        \"Identify biomarkers for predicting treatment response.\",\n        \"Improve patient outcomes through personalized treatment strategies.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel drug target for pancreatic cancer.\",\n            \"publication_date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70639", "text": "{\n    \"collaboration_title\": \"Basic Immunology Research Network\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Michigan\",\n            \"contact_name\": \"Dr. Robert Chen\",\n            \"contact_email\": \"robert.chen@umich.edu\"\n        },\n        {\n            \"institution\": \"Johns Hopkins University\",\n            \"contact_name\": \"Dr. Sarah Brown\",\n            \"contact_email\": \"sarah.brown@jhu.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2020-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Immunology\",\n        \"Virology\",\n        \"Vaccine Development\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Gates Foundation\"\n    ],\n    \"goals\": [\n        \"Advance fundamental understanding of the immune system.\",\n        \"Develop new vaccines against emerging viral threats.\",\n        \"Improve immune responses to existing vaccines.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Characterized a novel immune cell population.\",\n            \"publication_date\": \"2022-08-25\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"email\": \"robert.chen@umich.edu\",\n        \"affiliation\": \"University of Michigan\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70640", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\",\n        \"Private Donations\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification\",\n        \"Accelerate the drug discovery process\",\n        \"Improve drug efficacy and safety\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new AI model that predicts drug-target interactions with 90% accuracy.\",\n            \"publication_date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70640", "text": "{\n    \"collaboration_title\": \"Climate Change Impact Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"lead_contact\": \"Dr. David Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Engineering\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"EPA\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal ecosystems\",\n        \"Develop mitigation strategies\",\n        \"Raise public awareness\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a report on the rising sea levels in the Pacific Northwest.\",\n            \"publication_date\": \"2024-01-18\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"phone\": \"555-987-6543\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70641", "text": "{\n    \"collaboration_title\": \"AI-Driven Diagnostics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Medical Imaging\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for early disease detection\",\n        \"Improve diagnostic accuracy in healthcare\",\n        \"Reduce healthcare costs through automation\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new AI model that improves breast cancer detection rates by 15%.\",\n            \"publication_date\": \"2024-05-20\"\n        },\n        {\n            \"result_description\": \"Published findings in Nature Medicine demonstrating improved patient outcomes.\",\n            \"publication_date\": \"2024-11-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70641", "text": "{\n    \"collaboration_title\": \"Computational Biology Network\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. James Wilson\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. Maria Rodriguez\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-08-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Computational Biology\",\n        \"Genomics\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Advance understanding of gene regulation\",\n        \"Develop new computational tools for genomic analysis\",\n        \"Identify genetic markers for disease susceptibility\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new algorithm for analyzing genomic data.\",\n            \"publication_date\": \"2023-06-15\"\n        },\n        {\n            \"result_description\": \"Published findings on gene regulation in a peer-reviewed journal.\",\n            \"publication_date\": \"2023-12-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. John Smith\",\n        \"email\": \"john.smith@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70642", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification\",\n        \"Accelerate drug development process\",\n        \"Improve drug efficacy\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified 3 potential drug candidates using AI models\",\n            \"date\": \"2023-12-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70642", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Dr. Emily Chen\",\n            \"contact_email\": \"emily.chen@washington.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Improve climate change models\",\n        \"Predict future climate trends\",\n        \"Assess the impact of climate change\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new climate model with improved accuracy\",\n            \"date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Frank Green\",\n        \"email\": \"frank.green@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70643", "text": "{\n    \"collaboration_title\": \"Joint Cancer Immunotherapy Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@mit.edu\"\n        },\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@hms.harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Immunotherapy\",\n        \"Biomedical Engineering\",\n        \"Genomics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Department of Defense\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer immunotherapies\",\n        \"Improve cancer treatment efficacy\",\n        \"Identify biomarkers for predicting treatment response\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in Nature demonstrating enhanced T-cell activity in preclinical models.\",\n            \"date_achieved\": \"2023-11-20\"\n        },\n        {\n            \"result_description\": \"Filed a patent for a new cancer vaccine candidate.\",\n            \"date_achieved\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70643", "text": "{\n    \"collaboration_title\": \"Neurological Disease Study Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"contact_name\": \"Dr. Jennifer Wilson\",\n            \"contact_email\": \"jennifer.wilson@ucsf.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Neuroscience\",\n        \"Neurology\",\n        \"Genetics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Private Foundation Grant\"\n    ],\n    \"goals\": [\n        \"Investigate the genetic basis of neurological disorders\",\n        \"Develop new diagnostic tools for early detection\",\n        \"Improve patient outcomes through personalized medicine\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel gene associated with Alzheimer's disease.\",\n            \"date_achieved\": \"2023-09-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Green\",\n        \"email\": \"robert.green@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70644", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Professor David Chen\",\n            \"contact_email\": \"david.chen@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification.\",\n        \"Accelerate the drug discovery process.\",\n        \"Improve drug efficacy and reduce side effects.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new machine learning model that predicts drug-target interactions with 90% accuracy.\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70644", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Partnership\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Michael Green\",\n            \"contact_email\": \"michael.green@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Professor Emily Carter\",\n            \"contact_email\": \"emily.carter@uw.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Improve climate change models.\",\n        \"Predict future climate patterns.\",\n        \"Assess the impact of climate change on ecosystems.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new climate model that incorporates improved data assimilation techniques.\",\n            \"date\": \"2023-12-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70645", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Prof. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification.\",\n        \"Accelerate drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper in Nature demonstrating a new AI-based drug target.\",\n            \"date\": \"2023-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70645", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. David Lee\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Prof. Emily Carter\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Atmospheric Physics\"\n    ],\n    \"funding_sources\": [\n        \"DOE\",\n        \"EU Horizon 2020\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models.\",\n        \"Assess the impact of climate change on ecosystems.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a high-resolution climate model.\",\n            \"date\": \"2023-09-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Frank Wilson\",\n        \"email\": \"frank.wilson@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70646", "text": "{\n    \"collaboration_title\": \"Early Cancer Detection Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts General Hospital\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@mgh.harvard.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Research\",\n        \"Biomarkers\",\n        \"Molecular Diagnostics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Department of Defense\"\n    ],\n    \"goals\": [\n        \"Develop novel blood-based biomarkers for early cancer detection.\",\n        \"Improve the sensitivity and specificity of existing diagnostic tests.\",\n        \"Establish a multi-center clinical trial for biomarker validation.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified three promising biomarker candidates for pancreatic cancer.\",\n            \"date_achieved\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@mgh.harvard.edu\",\n        \"phone\": \"617-555-1212\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70646", "text": "{\n    \"collaboration_title\": \"Immuno-Oncology Network\",\n    \"partners\": [\n        {\n            \"institution\": \"Memorial Sloan Kettering Cancer Center\",\n            \"contact_name\": \"Dr. Robert Chen\",\n            \"contact_email\": \"robert.chen@mskcc.org\"\n        },\n        {\n            \"institution\": \"University of Pennsylvania\",\n            \"contact_name\": \"Dr. Sarah Williams\",\n            \"contact_email\": \"sarah.williams@upenn.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cancer Research\",\n        \"Immunology\",\n        \"Immunotherapy\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"American Cancer Society\"\n    ],\n    \"goals\": [\n        \"Advance the development of novel immunotherapies for various cancers.\",\n        \"Investigate the mechanisms of immune resistance.\",\n        \"Identify predictive biomarkers for immunotherapy response.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a groundbreaking study on PD-1/PD-L1 blockade in melanoma.\",\n            \"date_achieved\": \"2023-07-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"email\": \"robert.chen@mskcc.org\",\n        \"phone\": \"212-639-2000\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70647", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Smith\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. Bob Johnson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification.\",\n        \"Accelerate the drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in Nature on a new AI-based drug discovery method.\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Smith\",\n        \"email\": \"alice.smith@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70647", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"lead_contact\": \"Dr. David Wilson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate change predictions.\",\n        \"Understand the impact of climate change on ecosystems.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new climate model with improved resolution.\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70648", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"country\": \"US\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"Technical University of Munich\",\n            \"country\": \"Germany\",\n            \"lead_contact\": \"Dr. Klaus Schmidt\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"German Research Foundation (DFG)\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for predicting drug efficacy.\",\n        \"Identify novel drug candidates.\",\n        \"Publish research findings in high-impact journals.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"AI-powered Prediction of Drug-Target Interactions\",\n            \"publication_date\": \"2024-03-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70648", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Partnership\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"country\": \"US\",\n            \"lead_contact\": \"Dr. Robert Brown\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"country\": \"UK\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-10-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation (NSF)\",\n        \"European Research Council (ERC)\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate change models.\",\n        \"Understand the impact of climate change on ecosystems.\",\n        \"Develop strategies for mitigating climate change.\"\n    ],\n    \"results\": [\n        {\n            \"report_title\": \"Regional Climate Change Projections\",\n            \"report_date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Robert Brown\",\n        \"email\": \"robert.brown@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70649", "text": "{\n    \"collaboration_title\": \"Joint Research on Grid-Scale Energy Storage\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Professor Michael McGehee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Energy Storage\",\n        \"Renewable Energy Integration\",\n        \"Grid Modernization\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Develop advanced energy storage technologies\",\n        \"Improve grid stability with renewable energy sources\",\n        \"Reduce carbon emissions\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel Materials for Flow Batteries\",\n            \"publication_date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70649", "text": "{\n    \"collaboration_title\": \"Advanced Materials for Solar Cells\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Peidong Yang\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"lead_contact\": \"Professor Daniel Schwartz\"\n        }\n    ],\n    \"collaboration_start_date\": \"2018-07-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Materials Science\"\n    ],\n    \"funding_sources\": [\n        \"Private Foundation\",\n        \"State Grant\"\n    ],\n    \"goals\": [\n        \"Develop more efficient solar cell materials\",\n        \"Reduce the cost of solar energy production\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Perovskite Solar Cells with Enhanced Stability\",\n            \"publication_date\": \"2020-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@berkeley.edu\",\n        \"affiliation\": \"UC Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70650", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification\",\n        \"Accelerate drug discovery process\",\n        \"Identify potential drug candidates for cancer treatment\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new AI model with improved accuracy in predicting drug-target interactions.\",\n            \"date\": \"2023-12-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70650", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Sarah Johnson\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"DOE\",\n        \"EPA\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate models\",\n        \"Assess the impact of climate change on ecosystems\",\n        \"Develop strategies for mitigating climate change\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a research paper on the impact of rising sea levels on coastal communities.\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70651", "text": "{\n    \"collaboration_title\": \"Climate Change Resilience through Data-Driven Modeling\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Eleanor Vance\"\n        },\n        {\n            \"institution\": \"National Renewable Energy Laboratory (NREL)\",\n            \"lead_contact\": \"Dr. David Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Data Science\",\n        \"Renewable Energy\",\n        \"Environmental Sustainability\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Develop high-resolution climate models\",\n        \"Predict regional climate change impacts\",\n        \"Inform policy decisions for climate adaptation\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a peer-reviewed paper in Nature Climate Change demonstrating improved predictive accuracy of regional climate models.\",\n            \"date\": \"2023-11-01\"\n        },\n        {\n            \"description\": \"Developed a publicly accessible database of climate change impact assessments.\",\n            \"date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"evance@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70651", "text": "{\n    \"collaboration_title\": \"Advanced Materials for Energy Storage\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology (MIT)\",\n            \"lead_contact\": \"Dr. Samuel Adams\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Olivia Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Chemical Engineering\",\n        \"Energy Storage\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"ARPA-E\"\n    ],\n    \"goals\": [\n        \"Develop novel electrode materials\",\n        \"Improve battery performance\",\n        \"Reduce battery cost\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Synthesized a new lithium-ion battery cathode material with improved energy density.\",\n            \"date\": \"2023-09-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Samuel Adams\",\n        \"email\": \"sadams@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70652", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for predicting drug efficacy\",\n        \"Identify novel drug targets\",\n        \"Accelerate drug development process\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"AI-Powered Identification of Novel Drug Candidates\",\n            \"date\": \"2023-05-20\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Method for predicting drug-target interactions\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70652", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Williams\",\n            \"contact_email\": \"sarah.williams@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. James Brown\",\n            \"contact_email\": \"james.brown@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-08-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\",\n        \"Oceanography\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Improve climate change predictions\",\n        \"Understand the impact of climate change on ecosystems\",\n        \"Develop mitigation strategies\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Report\",\n            \"title\": \"Assessment of Climate Change Impacts on Coastal Regions\",\n            \"date\": \"2023-11-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Williams\",\n        \"email\": \"sarah.williams@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70653", "text": "{\n    \"collaboration_title\": \"Global Sustainability Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Oxford University\",\n            \"contact_name\": \"Professor David King\",\n            \"contact_email\": \"david.king@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Climate Change\",\n        \"Renewable Energy\",\n        \"Sustainable Agriculture\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Bill & Melinda Gates Foundation\",\n        \"UK Research and Innovation\"\n    ],\n    \"goals\": [\n        \"Develop novel carbon capture technologies\",\n        \"Improve energy efficiency in developing nations\",\n        \"Promote sustainable land use practices\",\n        \"Reduce greenhouse gas emissions by 20%\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel Carbon Capture Material\",\n            \"publication_date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70653", "text": "{\n    \"collaboration_title\": \"Historical Linguistics Network\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Professor John Smith\",\n            \"contact_email\": \"john.smith@harvard.edu\"\n        },\n        {\n            \"institution\": \"Sorbonne University\",\n            \"contact_name\": \"Dr. Marie Dubois\",\n            \"contact_email\": \"marie.dubois@sorbonne.fr\"\n        }\n    ],\n    \"collaboration_start_date\": \"2018-03-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Historical Linguistics\",\n        \"Comparative Philology\",\n        \"Language Evolution\"\n    ],\n    \"funding_sources\": [\n        \"National Endowment for the Humanities\"\n    ],\n    \"goals\": [\n        \"Trace the origins of Indo-European languages\",\n        \"Analyze the evolution of grammatical structures\",\n        \"Document endangered languages\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"The Roots of Proto-Indo-European\",\n            \"publication_date\": \"2020-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Professor John Smith\",\n        \"email\": \"john.smith@harvard.edu\",\n        \"affiliation\": \"Harvard University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70654", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for predicting drug efficacy\",\n        \"Identify novel drug candidates\",\n        \"Accelerate drug development process\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"AI-powered prediction of drug-target interactions\",\n            \"publication_venue\": \"Nature Biotechnology\",\n            \"publication_date\": \"2023-11-01\"\n        },\n        {\n            \"publication_title\": \"A novel deep learning framework for drug design\",\n            \"publication_venue\": \"Journal of Chemical Information and Modeling\",\n            \"publication_date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70654", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. John Smith\",\n            \"contact_email\": \"john.smith@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"Government Grant\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models\",\n        \"Assess the impact of climate change on ecosystems\",\n        \"Develop mitigation strategies\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Regional Climate Change Impacts in Europe\",\n            \"publication_venue\": \"Environmental Research Letters\",\n            \"publication_date\": \"2023-09-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. John Smith\",\n        \"email\": \"john.smith@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70655", "text": "{\n    \"collaboration_title\": \"EU-US Oncology Translational Research Alliance\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Massachusetts General Hospital\",\n            \"contact_name\": \"Dr. David Chen\",\n            \"contact_email\": \"david.chen@mgh.harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Genomics\",\n        \"Immunotherapy\",\n        \"Drug Discovery\",\n        \"Translational Research\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Cancer Research UK\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer biomarkers\",\n        \"Develop personalized immunotherapy strategies\",\n        \"Accelerate the translation of research findings into clinical trials\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel biomarker for early-stage lung cancer\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Amelia Hayes\",\n        \"email\": \"amelia.hayes@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70655", "text": "{\n    \"collaboration_title\": \"Global Neuroscience Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Tokyo\",\n            \"contact_name\": \"Dr. Kenji Tanaka\",\n            \"contact_email\": \"kenji.tanaka@utokyo.ac.jp\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Maria Rodriguez\",\n            \"contact_email\": \"maria.rodriguez@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Neuroimaging\",\n        \"Cognitive Neuroscience\",\n        \"Neuropathology\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Japan Society for the Promotion of Science\"\n    ],\n    \"goals\": [\n        \"Advance understanding of brain function\",\n        \"Develop new diagnostic tools for neurological disorders\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel neuroimaging technique\",\n            \"publication_date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Hiroshi Sato\",\n        \"email\": \"hiroshi.sato@utokyo.ac.jp\",\n        \"affiliation\": \"University of Tokyo\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70656", "text": "{\n    \"collaboration_title\": \"Joint Cancer Immunotherapy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts General Hospital\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"University of Pennsylvania\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Immunotherapy\",\n        \"Oncology\",\n        \"Molecular Biology\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Stand Up To Cancer\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer immunotherapies\",\n        \"Improve patient outcomes\",\n        \"Identify new biomarkers for treatment response\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified a novel T-cell receptor for targeting melanoma.\",\n            \"publication\": \"Nature Medicine, 2023\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@mgh.harvard.edu\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70656", "text": "{\n    \"collaboration_title\": \"Neurological Disease Study Group\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Neurology\",\n        \"Neuroscience\",\n        \"Genetics\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"The Michael J. Fox Foundation\"\n    ],\n    \"goals\": [\n        \"Investigate the genetic basis of Parkinson's disease\",\n        \"Develop new therapeutic strategies\",\n        \"Improve diagnostic tools\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified a novel gene associated with increased risk of Parkinson's disease.\",\n            \"publication\": \"The Lancet Neurology, 2024\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Garcia\",\n        \"email\": \"robert.garcia@ucsf.edu\",\n        \"affiliation\": \"University of California, San Francisco\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70657", "text": "{\n    \"collaboration_title\": \"Sustainable Futures Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Dr. Eleanor Vance\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Professor David Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Renewable Energy\",\n        \"Environmental Science\",\n        \"Sustainable Agriculture\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Develop new sustainable energy technologies\",\n        \"Reduce carbon emissions\",\n        \"Improve food security\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Solar Cell Designs\",\n            \"date\": \"2023-11-20\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Sustainable Water Filtration System\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Amelia Stone\",\n        \"email\": \"amelia.stone@oxford.ac.uk\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70657", "text": "{\n    \"collaboration_title\": \"Advanced Materials Study\",\n    \"partners\": [\n        {\n            \"institution\": \"California Institute of Technology\",\n            \"lead_contact\": \"Professor Robert Miller\"\n        },\n        {\n            \"institution\": \"University of Cambridge\",\n            \"lead_contact\": \"Dr. Sarah Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Investigate the properties of new materials\",\n        \"Develop advanced manufacturing techniques\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"title\": \"Nanomaterial Synthesis\",\n            \"date\": \"2021-05-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. James Taylor\",\n        \"email\": \"james.taylor@caltech.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70658", "text": "{\n    \"collaboration_title\": \"EU-Solar Future\",\n    \"partners\": [\n        {\n            \"institution_name\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@oxford.ac.uk\"\n        },\n        {\n            \"institution_name\": \"Siemens Energy\",\n            \"contact_name\": \"Mark Johnson\",\n            \"contact_email\": \"mark.johnson@siemens-energy.com\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Materials Science\",\n        \"Energy Storage\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"UK Research and Innovation\"\n    ],\n    \"goals\": [\n        \"Develop more efficient solar cells\",\n        \"Improve energy storage solutions\",\n        \"Reduce the cost of solar energy\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published 3 papers in high-impact journals on perovskite solar cells.\",\n            \"date_achieved\": \"2023-11-01\"\n        },\n        {\n            \"result_description\": \"Developed a new prototype energy storage system with 20% increased efficiency.\",\n            \"date_achieved\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70658", "text": "{\n    \"collaboration_title\": \"Renewable Energy Studies\",\n    \"partners\": [\n        {\n            \"institution_name\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@berkeley.edu\"\n        },\n        {\n            \"institution_name\": \"National Renewable Energy Laboratory\",\n            \"contact_name\": \"Sarah Chen\",\n            \"contact_email\": \"sarah.chen@nrel.gov\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Wind Energy\",\n        \"Hydropower\",\n        \"Biofuels\"\n    ],\n    \"funding_sources\": [\n        \"US Department of Energy\",\n        \"California Energy Commission\"\n    ],\n    \"goals\": [\n        \"Investigate new wind turbine designs\",\n        \"Optimize hydropower plant efficiency\",\n        \"Develop sustainable biofuel sources\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Conducted simulations of advanced wind turbine blade designs.\",\n            \"date_achieved\": \"2022-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70659", "text": "{\n    \"collaboration_title\": \"Sustainable Coastal Ecosystems Project\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Santa Barbara\",\n            \"lead_contact\": \"Dr. Anya Sharma\"\n        },\n        {\n            \"institution\": \"Woods Hole Oceanographic Institution\",\n            \"lead_contact\": \"Dr. Ben Carter\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Science\",\n        \"Marine Biology\",\n        \"Climate Change\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\",\n        \"EPA\"\n    ],\n    \"goals\": [\n        \"Develop sustainable strategies for coastal ecosystem management.\",\n        \"Assess the impact of climate change on marine biodiversity.\",\n        \"Inform policy decisions related to coastal protection.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a peer-reviewed article in 'Nature Climate Change' demonstrating the effectiveness of mangrove restoration.\",\n            \"publication_date\": \"2023-11-20\"\n        },\n        {\n            \"result_description\": \"Presented findings to the National Ocean Council, influencing revisions to coastal management guidelines.\",\n            \"presentation_date\": \"2024-03-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"a.sharma@ucsb.edu\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70659", "text": "{\n    \"collaboration_title\": \"Advanced Materials for Energy Storage\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Charles Lee\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Wilson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-09-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Chemical Engineering\",\n        \"Energy Storage\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"ARPA-E\"\n    ],\n    \"goals\": [\n        \"Develop novel materials for high-capacity batteries.\",\n        \"Improve the efficiency of energy storage devices.\",\n        \"Explore new battery technologies.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new electrode material with 15% higher energy density.\",\n            \"publication_date\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Charles Lee\",\n        \"email\": \"c.lee@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
