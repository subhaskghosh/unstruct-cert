{"_id": "Academic--academic_collabo--n--69459", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study on Biomedical Data\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@harvard.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Prof. David Lee\",\n            \"contact_email\": \"david.lee@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-02-28\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Bioinformatics\",\n        \"Genomics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Private Donation\"\n    ],\n    \"goals\": [\n        \"Identify genetic markers for disease risk\",\n        \"Develop machine learning models for predicting patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a predictive model for heart disease.\",\n            \"publication_date\": \"2024-07-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69460", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Diagnostics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Prof. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Healthcare\",\n        \"Diagnostics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for early disease detection\",\n        \"Improve diagnostic accuracy\",\n        \"Reduce healthcare costs\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel AI Model for Cancer Detection\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
