{"_id": "Academic--academic_collabo--p--70895", "text": "{\n    \"collaboration_title\": \"AI-Driven Predictive Maintenance Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Siemens Energy\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Predictive Maintenance\",\n        \"Industrial Automation\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Siemens Internal Funding\"\n    ],\n    \"goals\": [\n        \"Develop AI models for predictive maintenance\",\n        \"Reduce downtime in energy infrastructure\",\n        \"Improve efficiency of energy systems\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a prototype model with 90% accuracy in predicting equipment failure.\",\n            \"date\": \"2023-12-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\"\n    }\n}"}
