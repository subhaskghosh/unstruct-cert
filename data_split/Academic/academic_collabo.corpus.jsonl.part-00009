{"_id": "Academic--academic_collabo--p--69768", "text": "{\n    \"collaboration_title\": \"AI-Driven Biomedical Discovery Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Robert Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Biomedical Engineering\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\",\n        \"DoD\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for disease diagnosis\",\n        \"Improve drug discovery processes using machine learning\",\n        \"Create personalized treatment plans\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model for early cancer detection with 95% accuracy.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
