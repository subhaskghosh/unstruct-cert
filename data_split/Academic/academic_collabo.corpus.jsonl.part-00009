{"_id": "Academic--academic_collabo--p--69514", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Diagnostics\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"research exchange\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Healthcare\",\n        \"Data Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for disease detection.\",\n        \"Improve diagnostic accuracy using machine learning techniques.\",\n        \"Create a publicly available dataset for research.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in Nature Medicine demonstrating improved diagnostic accuracy.\",\n            \"date\": \"2024-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
