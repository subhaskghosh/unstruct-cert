{"_id": "Academic--academic_collabo--p--69948", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification\",\n        \"Accelerate drug discovery process\",\n        \"Reduce drug development costs\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper in Nature on a new AI-driven drug discovery method.\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69948", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Oxford University\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@oxford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"EU Horizon 2020\",\n        \"UKRI\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction accuracy\",\n        \"Develop mitigation strategies\",\n        \"Enhance understanding of climate system dynamics\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new regional climate model.\",\n            \"date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69949", "text": "{\n    \"collaboration_title\": \"Joint Research in AI-Driven Medical Imaging\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop new algorithms for image analysis\",\n        \"Improve diagnostic accuracy in medical imaging\",\n        \"Publish research findings in top-tier journals\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel deep learning model for detecting tumors in MRI scans.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69949", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study on Climate Change Impacts\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Dr. David Garcia\",\n            \"contact_email\": \"david.garcia@uw.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Modeling\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"EPA\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal ecosystems\",\n        \"Develop strategies for mitigating climate change risks\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a report on the vulnerability of coastal communities to sea level rise.\",\n            \"publication_date\": \"2024-03-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
