{"_id": "Academic--academic_collabo--p--69163", "text": "{\n    \"collaboration_title\": \"Joint Research on AI-Driven Healthcare\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Prof. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Data Science\",\n        \"Healthcare\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new AI algorithms for disease diagnosis\",\n        \"Improve patient outcomes through data-driven insights\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel machine learning model for early cancer detection.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
