{"_id": "Academic--academic_collabo--n--69790", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study on Human-Computer Interaction\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"Carnegie Mellon University\",\n            \"lead_contact\": \"Prof. David Evans\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Human-Computer Interaction\",\n        \"User Interface Design\",\n        \"Cognitive Science\"\n    ],\n    \"funding_sources\": [\n        \"National Endowment for the Humanities\",\n        \"Microsoft Research\"\n    ],\n    \"goals\": [\n        \"Investigate user behavior with new interfaces\",\n        \"Develop guidelines for designing accessible technology\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Presented findings at a conference on HCI.\",\n            \"date\": \"2023-09-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69791", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Diagnostics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Medical Imaging\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for early disease detection.\",\n        \"Improve the accuracy of medical diagnoses.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on a novel AI-based diagnostic tool.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69791", "text": "{\n    \"collaboration_title\": \"Climate Change Impact Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Engineering\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal regions.\",\n        \"Develop strategies for mitigating climate risks.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Completed a comprehensive report on sea-level rise projections.\",\n            \"publication_date\": \"2024-08-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69792", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Computational Biology\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for predicting drug efficacy\",\n        \"Identify novel drug targets\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model with 90% accuracy in predicting drug efficacy.\",\n            \"publication_date\": \"2024-02-28\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69792", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Ben Williams\",\n            \"contact_email\": \"ben.williams@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\",\n        \"Oceanography\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction accuracy\",\n        \"Develop sustainable energy solutions\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a high-resolution climate model.\",\n            \"publication_date\": \"2024-03-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69793", "text": "{\n    \"collaboration_title\": \"Joint Research in AI-Driven Image Analysis\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Image Processing\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop novel algorithms for image recognition.\",\n        \"Improve the accuracy of object detection systems.\",\n        \"Publish research findings in top-tier conferences.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on deep learning for image classification in CVPR 2024.\",\n            \"date\": \"2024-06-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69793", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study on Data Science Applications\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Carnegie Mellon University\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@cmu.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-04-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Data Mining\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Google Research\"\n    ],\n    \"goals\": [\n        \"Facilitate knowledge transfer between institutions.\",\n        \"Explore new applications of data science.\",\n        \"Develop joint research proposals.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Organized a workshop on data science best practices.\",\n            \"date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69794", "text": "{\n    \"collaboration_title\": \"AI-Driven Medical Diagnosis Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Prof. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for early disease detection\",\n        \"Improve accuracy of medical diagnoses\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model with 95% accuracy in detecting pneumonia from chest X-rays.\",\n            \"publication_date\": \"2024-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"phone_number\": \"650-723-4567\"\n    }\n}"}
