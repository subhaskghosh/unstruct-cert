{"_id": "Academic--academic_collabo--p--71802", "text": "{\n    \"collaboration_title\": \"EU-US Sustainable Energy Transition Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"evance@mit.edu\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Professor Klaus Meier\",\n            \"contact_email\": \"klaus.meier@ethz.ch\"\n        },\n        {\n            \"institution\": \"National Renewable Energy Laboratory\",\n            \"contact_name\": \"Dr. Jian Li\",\n            \"contact_email\": \"jian.li@nrel.gov\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Energy\",\n        \"Energy Storage\",\n        \"Grid Integration\"\n    ],\n    \"funding_sources\": [\n        \"US Department of Energy\",\n        \"European Commission Horizon Europe\",\n        \"Siemens Energy\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Improve wind turbine performance\",\n        \"Design advanced energy storage systems\",\n        \"Demonstrate smart grid technologies\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Achieved 25% efficiency in perovskite solar cells.\",\n            \"publication_date\": \"2023-11-01\"\n        },\n        {\n            \"result_description\": \"Developed a novel algorithm for optimizing wind farm layout.\",\n            \"publication_date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"evance@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
