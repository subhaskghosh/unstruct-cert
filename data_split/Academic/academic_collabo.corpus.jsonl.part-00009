{"_id": "Academic--academic_collabo--p--69366", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanfordmed.org\"\n        },\n        {\n            \"institution\": \"Microsoft Research\",\n            \"contact_name\": \"Dr. Jian Li\",\n            \"contact_email\": \"jian.li@microsoft.com\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Microsoft Research\"\n    ],\n    \"goals\": [\n        \"Develop AI models for predicting drug efficacy.\",\n        \"Identify novel drug candidates.\",\n        \"Accelerate the drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model with 90% accuracy in predicting drug efficacy.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanfordmed.org\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69366", "text": "{\n    \"collaboration_title\": \"Machine Learning for Climate Modeling\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@university.edu\"\n        },\n        {\n            \"institution\": \"Google AI\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@google.com\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Climate Science\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Improve climate models using machine learning.\",\n        \"Predict extreme weather events.\",\n        \"Develop climate change mitigation strategies.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Improved the accuracy of climate models by 15%.\",\n            \"publication_date\": \"2024-08-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Miller\",\n        \"email\": \"david.miller@university.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
