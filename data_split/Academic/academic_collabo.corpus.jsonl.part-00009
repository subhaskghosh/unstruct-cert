{"_id": "Academic--academic_collabo--n--71753", "text": "{\n    \"collaboration_title\": \"Theoretical Frameworks for Energy Systems Optimization\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@harvard.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Professor Sarah Chen\",\n            \"contact_email\": \"sarah.chen@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Energy Systems\",\n        \"Mathematical Modeling\"\n    ],\n    \"funding_sources\": [\n        \"Private Foundation Grant\"\n    ],\n    \"goals\": [\n        \"Develop new mathematical models for energy systems\",\n        \"Advance understanding of energy flow and optimization\",\n        \"Publish research findings in peer-reviewed journals\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a new theoretical model for energy grid optimization.\",\n            \"publication_date\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@harvard.edu\",\n        \"affiliation\": \"Harvard University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71754", "text": "{\n    \"collaboration_title\": \"Eco-Cities Initiative: Collaborative Research on Urban Sustainability\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Amsterdam, Netherlands\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"a.sharma@uva.nl\"\n        },\n        {\n            \"institution\": \"Technical University of Munich, Germany\",\n            \"contact_name\": \"Professor Klaus Richter\",\n            \"contact_email\": \"k.richter@tum.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Urban Development\",\n        \"Renewable Energy\",\n        \"Circular Economy\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Develop innovative technologies for waste management\",\n        \"Implement sustainable energy solutions in urban areas\",\n        \"Create a framework for circular economy adoption\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a prototype smart waste management system.\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"a.sharma@uva.nl\",\n        \"affiliation\": \"University of Amsterdam\"\n    }\n}"}
