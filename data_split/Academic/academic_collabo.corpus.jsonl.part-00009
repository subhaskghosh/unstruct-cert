{"_id": "Academic--academic_collabo--p--71234", "text": "{\n    \"collaboration_title\": \"Climate Change & Public Health Nexus\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"National Institute of Environmental Health Sciences (NIEHS)\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@niehs.nih.gov\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Health\",\n        \"Climate Change\",\n        \"Public Health\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"UK Research and Innovation (UKRI)\"\n    ],\n    \"goals\": [\n        \"Identify climate-related health risks\",\n        \"Develop predictive models for heatwave impacts\",\n        \"Inform policy recommendations for climate adaptation\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a preliminary model predicting increased respiratory illness during heatwaves.\",\n            \"result_type\": \"Data Analysis Report\",\n            \"date_achieved\": \"2023-09-30\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71234", "text": "{\n    \"collaboration_title\": \"Arctic Ecosystems and Indigenous Health\",\n    \"partners\": [\n        {\n            \"institution\": \"McGill University\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@mcgill.ca\"\n        },\n        {\n            \"institution\": \"University of Alaska Fairbanks\",\n            \"contact_name\": \"Dr. Ben Miller\",\n            \"contact_email\": \"ben.miller@alaska.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Ecology\",\n        \"Indigenous Health\",\n        \"Environmental Science\"\n    ],\n    \"funding_sources\": [\n        \"Canadian Institutes of Health Research (CIHR)\",\n        \"National Science Foundation (NSF)\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on Arctic ecosystems.\",\n        \"Investigate the health of Indigenous communities.\",\n        \"Promote knowledge exchange between researchers and communities.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a study on changing caribou migration patterns.\",\n            \"result_type\": \"Peer-Reviewed Publication\",\n            \"date_achieved\": \"2023-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@mcgill.ca\",\n        \"affiliation\": \"McGill University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71235", "text": "{\n    \"collaboration_title\": \"EcoConnect: Joint Research on Sustainable Agriculture\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Wageningen University & Research, Netherlands\",\n            \"contact_name\": \"Prof. Jan van Dijk\",\n            \"contact_email\": \"jan.vandijk@wur.nl\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Agriculture\",\n        \"Environmental Science\",\n        \"Soil Chemistry\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"European Research Council\",\n        \"USDA\"\n    ],\n    \"goals\": [\n        \"Develop sustainable farming practices\",\n        \"Reduce pesticide use\",\n        \"Improve soil health\",\n        \"Increase crop yields\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Bio-fertilizers for Sustainable Agriculture\",\n            \"publication_date\": \"2023-05-20\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Method for enhancing soil carbon sequestration\",\n            \"patent_number\": \"US12345678B2\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71235", "text": "{\n    \"collaboration_title\": \"Theoretical Climate Modeling Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Prof. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@ox.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-01-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\",\n        \"Computational Physics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate models\",\n        \"Understand climate change mechanisms\",\n        \"Predict future climate scenarios\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Software\",\n            \"title\": \"ClimateSim v2.0\",\n            \"release_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Miller\",\n        \"email\": \"david.miller@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71236", "text": "{\n    \"collaboration_title\": \"EU-SolarNet: Advancing Solar Energy Technologies\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Fraunhofer ISE\",\n            \"contact_name\": \"Dr. Klaus Weber\",\n            \"contact_email\": \"klaus.weber@ise.fraunhofer.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Photovoltaics\",\n        \"Energy Storage\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Improve energy storage solutions\",\n        \"Reduce the cost of solar energy\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Perovskite Solar Cells with Enhanced Stability\",\n            \"publication_date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71236", "text": "{\n    \"collaboration_title\": \"Theoretical Foundations of Quantum Energy Transfer\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Prof. David Miller\",\n            \"contact_email\": \"david.miller@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Tokyo\",\n            \"contact_name\": \"Dr. Akari Tanaka\",\n            \"contact_email\": \"akari.tanaka@utokyo.ac.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-01-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Quantum Physics\",\n        \"Energy Transfer\",\n        \"Theoretical Chemistry\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Japan Society for the Promotion of Science\"\n    ],\n    \"goals\": [\n        \"Develop a deeper understanding of quantum energy transfer mechanisms\",\n        \"Create new theoretical models for energy transport\",\n        \"Explore the potential of quantum effects in energy applications\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"title\": \"Quantum Coherence in Molecular Energy Transfer\",\n            \"conference_date\": \"2023-07-12\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Prof. David Miller\",\n        \"email\": \"david.miller@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71237", "text": "{\n    \"collaboration_title\": \"EcoConnect: Joint Initiative for Sustainable Agriculture\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Professor Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Agriculture\",\n        \"Renewable Energy\",\n        \"Environmental Policy\"\n    ],\n    \"funding_sources\": [\n        \"European Commission Horizon Europe\",\n        \"UK Research and Innovation\"\n    ],\n    \"goals\": [\n        \"Develop sustainable farming practices\",\n        \"Reduce carbon emissions in agriculture\",\n        \"Improve food security\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new bio-fertilizer that increased crop yields by 15%\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
