{"_id": "Academic--academic_collabo--p--70524", "text": "{\n    \"collaboration_title\": \"Neuro-Engineering Interface Project\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Prof. Ben Carter\",\n            \"contact_email\": \"b.carter@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Neuroscience\",\n        \"Biomedical Engineering\",\n        \"Neural Interfaces\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"National Science Foundation (NSF)\"\n    ],\n    \"goals\": [\n        \"Develop novel brain-computer interfaces\",\n        \"Improve treatment for neurological disorders\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new algorithm for decoding neural signals.\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70524", "text": "{\n    \"collaboration_title\": \"Climate Change and Crop Yields\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Chloe Davis\",\n            \"contact_email\": \"chloe.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Prof. Ethan Foster\",\n            \"contact_email\": \"e.foster@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Agronomy\",\n        \"Climate Science\",\n        \"Plant Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"European Research Council (ERC)\"\n    ],\n    \"goals\": [\n        \"Predict the impact of climate change on crop yields\",\n        \"Develop climate-resilient crops\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified genetic markers for drought tolerance in wheat.\",\n            \"publication_date\": \"2023-06-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Chloe Davis\",\n        \"email\": \"chloe.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
