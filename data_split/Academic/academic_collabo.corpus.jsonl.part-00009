{"_id": "Academic--academic_collabo--n--69996", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study on Robotics and AI\",\n    \"partners\": [\n        {\n            \"institution\": \"Carnegie Mellon University\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@cmu.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-06-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Robotics\",\n        \"Artificial Intelligence\"\n    ],\n    \"funding_sources\": [\n        \"DARPA\",\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Advance the state-of-the-art in robotics\",\n        \"Facilitate knowledge sharing between institutions\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new robot control algorithm.\",\n            \"publication_date\": \"2024-03-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@cmu.edu\",\n        \"affiliation\": \"Carnegie Mellon University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69997", "text": "{\n    \"collaboration_title\": \"Joint Research on AI-Driven Image Analysis\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Smith\",\n            \"contact_email\": \"alice.smith@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Bob Johnson\",\n            \"contact_email\": \"bob.johnson@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Artificial Intelligence\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop novel algorithms for image recognition\",\n        \"Improve the accuracy of object detection systems\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"A New Approach to Image Segmentation\",\n            \"publication_date\": \"2023-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Smith\",\n        \"email\": \"alice.smith@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69997", "text": "{\n    \"collaboration_title\": \"Bioinformatics Data Sharing Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@harvard.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Wilson\",\n            \"contact_email\": \"david.wilson@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Data Sharing Agreement\",\n    \"research_areas\": [\n        \"Bioinformatics\",\n        \"Genomics\",\n        \"Data Science\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Create a publicly available database of genomic data\",\n        \"Develop tools for analyzing genomic data\"\n    ],\n    \"results\": [\n        {\n            \"database_name\": \"Genomic Data Repository\",\n            \"access_url\": \"https://example.com/genomic-data\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@harvard.edu\",\n        \"affiliation\": \"Harvard University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69998", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Chen\",\n            \"contact_email\": \"alice.chen@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Prof. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification\",\n        \"Improve drug efficacy prediction using machine learning\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on a new AI-based drug target identification method\",\n            \"publication_date\": \"2023-06-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
