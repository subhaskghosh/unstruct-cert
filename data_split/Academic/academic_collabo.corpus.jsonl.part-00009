{"_id": "Academic--academic_collabo--p--71509", "text": "{\n    \"collaboration_title\": \"EU-Solar Innovations\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"country\": \"UK\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Technical University of Munich\",\n            \"country\": \"Germany\",\n            \"contact_name\": \"Professor Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@tum.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Energy\",\n        \"Materials Science\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Develop novel perovskite solar cells\",\n        \"Improve energy conversion efficiency\",\n        \"Reduce material costs\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Achieved 25.7% energy conversion efficiency in lab-scale perovskite solar cells.\",\n            \"date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
