{"_id": "Academic--academic_collabo--n--70362", "text": "{\n    \"collaboration_title\": \"Theoretical Modeling of Energy Systems\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Robert Socolow\",\n            \"contact_email\": \"socolow@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Princeton University\",\n            \"contact_name\": \"Professor Robert Pruitt\",\n            \"contact_email\": \"rpruitt@princeton.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Sustainable Energy\",\n        \"Computational Physics\",\n        \"Energy Policy\"\n    ],\n    \"funding_sources\": [\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Develop advanced models for energy system optimization\",\n        \"Analyze the impact of policy interventions on energy consumption\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a novel model for predicting energy demand.\",\n            \"publication_date\": \"2023-05-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Chen\",\n        \"email\": \"alice.chen@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70363", "text": "{\n    \"collaboration_title\": \"AI for Climate Change Resilience\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. David Smith\",\n            \"contact_email\": \"david.smith@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Climate Modeling\",\n        \"Data Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Develop AI models for predicting extreme weather events\",\n        \"Improve climate change adaptation strategies\",\n        \"Create publicly available datasets\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in Nature demonstrating improved accuracy in predicting hurricane intensity.\",\n            \"publication_date\": \"2024-07-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70363", "text": "{\n    \"collaboration_title\": \"Theoretical Physics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Robert Brown\",\n            \"contact_email\": \"robert.brown@mit.edu\"\n        },\n        {\n            \"institution\": \"California Institute of Technology\",\n            \"contact_name\": \"Dr. Sarah Lee\",\n            \"contact_email\": \"sarah.lee@caltech.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Quantum Mechanics\",\n        \"String Theory\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Private Foundation\"\n    ],\n    \"goals\": [\n        \"Advance understanding of quantum gravity\",\n        \"Develop new mathematical tools for physics\",\n        \"Foster collaboration between leading physicists\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Presented findings at the International Physics Conference.\",\n            \"publication_date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Michael Davis\",\n        \"email\": \"michael.davis@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70364", "text": "{\n    \"collaboration_title\": \"Targeted Cancer Therapy Development Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. David Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Drug Discovery\",\n        \"Immunotherapy\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\",\n        \"Stand Up To Cancer Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel targeted therapies for aggressive cancers\",\n        \"Identify biomarkers for treatment response\",\n        \"Improve patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified a novel drug target for triple-negative breast cancer\",\n            \"publication_date\": \"2023-06-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70364", "text": "{\n    \"collaboration_title\": \"Basic Cancer Mechanisms Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Alan Zhang\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Maria Lopez\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-11-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cancer Genetics\",\n        \"Cell Signaling\",\n        \"Tumor Microenvironment\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"American Cancer Society\"\n    ],\n    \"goals\": [\n        \"Understand the genetic basis of cancer development\",\n        \"Elucidate the role of cell signaling pathways in tumor growth\",\n        \"Investigate the interactions between cancer cells and their surrounding environment\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Discovered a new gene mutation associated with increased cancer risk\",\n            \"publication_date\": \"2022-04-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. John Smith\",\n        \"email\": \"john.smith@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70365", "text": "{\n    \"collaboration_title\": \"Global Climate Adaptation Network\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@berkeley.edu\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Prof. David Miller\",\n            \"contact_email\": \"david.miller@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Renewable Energy\",\n        \"Sustainable Agriculture\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"European Union Horizon Program\",\n        \"Swiss Federal Office of Energy\"\n    ],\n    \"goals\": [\n        \"Develop advanced climate models\",\n        \"Identify and implement sustainable energy solutions\",\n        \"Improve climate change adaptation strategies\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a high-impact paper in Nature on regional climate change impacts.\",\n            \"date_achieved\": \"2024-05-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70365", "text": "{\n    \"collaboration_title\": \"Comparative Linguistics Project\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Jonathan Smith\",\n            \"contact_email\": \"jonathan.smith@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Prof. Elizabeth Brown\",\n            \"contact_email\": \"elizabeth.brown@harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Historical Linguistics\",\n        \"Phonology\",\n        \"Syntax\"\n    ],\n    \"funding_sources\": [\n        \"Private Foundation Grant\",\n        \"University Funds\"\n    ],\n    \"goals\": [\n        \"Compare and contrast language evolution\",\n        \"Develop new linguistic theories\",\n        \"Publish research findings in academic journals\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Presented findings at an international linguistics conference.\",\n            \"date_achieved\": \"2023-08-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Jonathan Smith\",\n        \"email\": \"jonathan.smith@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70366", "text": "{\n    \"collaboration_title\": \"Novel Cancer Therapeutics Collaborative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@ucsf.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Drug Discovery\",\n        \"Immunotherapy\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Cancer Research UK\"\n    ],\n    \"goals\": [\n        \"Identify novel drug targets for cancer treatment\",\n        \"Develop and test new immunotherapy approaches\",\n        \"Improve cancer patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel protein target for lung cancer therapy.\",\n            \"publication_date\": \"2023-10-26\"\n        },\n        {\n            \"result_description\": \"Demonstrated the efficacy of a new immunotherapy combination in preclinical models.\",\n            \"publication_date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@ucsf.edu\",\n        \"phone_number\": \"555-123-4567\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70366", "text": "{\n    \"collaboration_title\": \"Cardiovascular Health Study\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. Robert Williams\",\n            \"contact_email\": \"robert.williams@harvard.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Maria Rodriguez\",\n            \"contact_email\": \"maria.rodriguez@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiology\",\n        \"Epidemiology\",\n        \"Public Health\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"American Heart Association\"\n    ],\n    \"goals\": [\n        \"Investigate the risk factors for heart disease\",\n        \"Develop strategies to prevent cardiovascular events\",\n        \"Improve the quality of life for patients with heart disease\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a genetic marker associated with increased risk of heart failure.\",\n            \"publication_date\": \"2023-07-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Williams\",\n        \"email\": \"robert.williams@harvard.edu\",\n        \"phone_number\": \"555-987-6543\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70367", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Project\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Computational Biology\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for identifying potential drug candidates\",\n        \"Accelerate the drug discovery process\",\n        \"Reduce drug development costs\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified 3 promising drug candidates for cancer treatment.\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70367", "text": "{\n    \"collaboration_title\": \"Theoretical Foundations of Machine Learning\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. John Smith\",\n            \"contact_email\": \"john.smith@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Carnegie Mellon University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@cmu.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Theoretical Computer Science\",\n        \"Statistics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Develop new theoretical frameworks for machine learning\",\n        \"Improve the understanding of generalization in machine learning models\",\n        \"Publish research papers in top-tier conferences\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper on PAC-Bayes bounds in NeurIPS 2023.\",\n            \"date\": \"2023-12-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. John Smith\",\n        \"email\": \"john.smith@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70368", "text": "{\n    \"collaboration_title\": \"Solar Energy Implementation Network\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Eleanor Vance\"\n        },\n        {\n            \"institution\": \"SunPower Corporation\",\n            \"lead_contact\": \"James Harding\"\n        },\n        {\n            \"institution\": \"National Renewable Energy Laboratory\",\n            \"lead_contact\": \"Dr. Anya Sharma\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Energy Storage\",\n        \"Grid Integration\"\n    ],\n    \"funding_sources\": [\n        \"Department of Energy\",\n        \"SunPower Corporation\",\n        \"California Energy Commission\"\n    ],\n    \"goals\": [\n        \"Develop efficient solar energy technologies\",\n        \"Improve energy storage solutions\",\n        \"Accelerate the adoption of renewable energy\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new perovskite solar cell with 25% efficiency.\",\n            \"date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"evance@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70368", "text": "{\n    \"collaboration_title\": \"Quantum Computing for Energy Simulations\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. David Chen\"\n        },\n        {\n            \"institution\": \"IBM Research\",\n            \"lead_contact\": \"Sarah Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Quantum Computing\",\n        \"Computational Physics\",\n        \"Energy Systems Modeling\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"IBM Research\"\n    ],\n    \"goals\": [\n        \"Develop quantum algorithms for energy simulations\",\n        \"Improve the accuracy of energy system models\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper on quantum algorithms for simulating molecular energy levels.\",\n            \"date\": \"2023-09-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Chen\",\n        \"email\": \"dchen@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70369", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\",\n            \"role\": \"Principal Investigator\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Professor David Lee\",\n            \"contact_email\": \"david.lee@oxford.ac.uk\",\n            \"role\": \"Co-Investigator\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for identifying potential drug candidates.\",\n        \"Accelerate the drug discovery process.\",\n        \"Improve drug efficacy and reduce side effects.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model with 90% accuracy in predicting drug-target interactions.\",\n            \"date_achieved\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70369", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. James Wilson\",\n            \"contact_email\": \"james.wilson@berkeley.edu\",\n            \"role\": \"Principal Investigator\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Professor Sarah Brown\",\n            \"contact_email\": \"sarah.brown@mit.edu\",\n            \"role\": \"Co-Investigator\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"DOE\",\n        \"EPA\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models.\",\n        \"Assess the impact of climate change on ecosystems.\",\n        \"Develop mitigation strategies.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on the effects of rising sea levels on coastal communities.\",\n            \"date_achieved\": \"2023-12-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. James Wilson\",\n        \"email\": \"james.wilson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70370", "text": "{\n    \"collaboration_title\": \"Joint Cancer Therapeutics Development Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@mit.edu\"\n        },\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@hms.harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Drug Discovery\",\n        \"Clinical Oncology\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Department of Defense (DoD)\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer therapies\",\n        \"Improve patient outcomes\",\n        \"Identify biomarkers for cancer diagnosis\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Phase 1 clinical trial showed promising results in treating advanced melanoma.\",\n            \"publication_date\": \"2023-08-10\",\n            \"metric\": \"Improved Progression-Free Survival\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70370", "text": "{\n    \"collaboration_title\": \"Cardiovascular Disease Research Alliance\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"contact_name\": \"Dr. Jennifer Wilson\",\n            \"contact_email\": \"jennifer.wilson@ucsf.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiology\",\n        \"Vascular Biology\",\n        \"Hypertension\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"American Heart Association\"\n    ],\n    \"goals\": [\n        \"Understand the mechanisms of cardiovascular disease\",\n        \"Develop new diagnostic tools\",\n        \"Improve treatment strategies\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel gene associated with increased risk of heart failure.\",\n            \"publication_date\": \"2023-11-15\",\n            \"metric\": \"Gene Association Study\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"email\": \"robert.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70371", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Diagnostics\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Prof. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Healthcare\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\",\n        \"Google AI\"\n    ],\n    \"goals\": [\n        \"Develop AI-based diagnostic tools\",\n        \"Improve accuracy of disease detection\",\n        \"Publish findings in top medical journals\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI algorithm for early cancer detection.\",\n            \"publication_date\": \"2023-07-01\",\n            \"journal\": \"Nature Medicine\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70371", "text": "{\n    \"collaboration_title\": \"Theoretical Physics Exploration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Caltech\",\n            \"contact_name\": \"Prof. David Miller\",\n            \"contact_email\": \"david.miller@caltech.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Quantum Mechanics\",\n        \"Astrophysics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Explore new theories in quantum gravity\",\n        \"Develop advanced computational models\",\n        \"Present findings at international conferences\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a theoretical paper on string theory.\",\n            \"publication_date\": \"2024-01-10\",\n            \"journal\": \"Physical Review Letters\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70372", "text": "{\n    \"collaboration_title\": \"Joint Oncology Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@harvard.edu\"\n        },\n        {\n            \"institution\": \"University of Toronto\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@utoronto.ca\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Immunotherapy\",\n        \"Genomics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Canadian Institutes of Health Research\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer therapies\",\n        \"Improve cancer diagnosis and prognosis\",\n        \"Establish a comprehensive cancer genome database\",\n        \"Significantly reduce cancer mortality rates\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a new biomarker for early cancer detection.\",\n            \"publication_date\": \"2023-06-30\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvard.edu\",\n        \"affiliation\": \"Harvard University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70372", "text": "{\n    \"collaboration_title\": \"Cardiovascular Health Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Los Angeles\",\n            \"contact_name\": \"Dr. Alan Smith\",\n            \"contact_email\": \"alan.smith@ucla.edu\"\n        },\n        {\n            \"institution\": \"King's College London\",\n            \"contact_name\": \"Dr. Ben Williams\",\n            \"contact_email\": \"ben.williams@kcl.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2020-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiology\",\n        \"Hypertension\",\n        \"Vascular Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"British Heart Foundation\"\n    ],\n    \"goals\": [\n        \"Investigate the causes of heart disease.\",\n        \"Improve treatment strategies for cardiovascular conditions.\",\n        \"Promote healthy lifestyle choices.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new blood pressure monitoring device.\",\n            \"publication_date\": \"2022-04-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alan Smith\",\n        \"email\": \"alan.smith@ucla.edu\",\n        \"affiliation\": \"University of California, Los Angeles\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70373", "text": "{\n    \"collaboration_title\": \"Joint Cancer Therapeutics Discovery\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@harvard.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Drug Discovery\",\n        \"Genomics\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer drug targets\",\n        \"Develop new therapeutic strategies\",\n        \"Improve patient survival rates\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a new biomarker for early cancer detection.\",\n            \"date_achieved\": \"2023-11-01\"\n        },\n        {\n            \"result_description\": \"Successfully completed Phase I clinical trials for a novel cancer drug.\",\n            \"date_achieved\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvard.edu\",\n        \"affiliation\": \"Harvard University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70373", "text": "{\n    \"collaboration_title\": \"Cancer Imaging Analysis Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Robert Chen\",\n            \"contact_email\": \"robert.chen@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Maria Rodriguez\",\n            \"contact_email\": \"maria.rodriguez@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-09-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Medical Imaging\",\n        \"Artificial Intelligence\",\n        \"Cancer Diagnostics\"\n    ],\n    \"funding_sources\": [\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop advanced image analysis algorithms for cancer detection\",\n        \"Improve the accuracy of cancer diagnosis\",\n        \"Facilitate data sharing among researchers\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new AI algorithm for tumor segmentation.\",\n            \"date_achieved\": \"2023-07-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"email\": \"robert.chen@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70374", "text": "{\n    \"collaboration_title\": \"GreenTech Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Anya Sharma\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Ben Carter\"\n        },\n        {\n            \"institution\": \"Siemens Energy\",\n            \"lead_contact\": \"Elena Petrova\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Energy\",\n        \"Energy Storage\",\n        \"Grid Modernization\"\n    ],\n    \"funding_sources\": [\n        \"US Department of Energy\",\n        \"Siemens Energy\",\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop advanced energy storage solutions\",\n        \"Improve the efficiency of solar and wind power\",\n        \"Create a more resilient and sustainable energy grid\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Materials for High-Density Energy Storage\",\n            \"date\": \"2023-05-20\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Smart Grid Control System\",\n            \"date\": \"2023-11-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70374", "text": "{\n    \"collaboration_title\": \"Biofuel Development Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carlos Rodriguez\"\n        },\n        {\n            \"institution\": \"University of Illinois at Urbana-Champaign\",\n            \"lead_contact\": \"Dr. Emily Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-12-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Biofuels\",\n        \"Biomass Conversion\",\n        \"Renewable Energy\"\n    ],\n    \"funding_sources\": [\n        \"US Department of Agriculture\"\n    ],\n    \"goals\": [\n        \"Develop sustainable biofuel production methods\",\n        \"Reduce reliance on fossil fuels\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"title\": \"Advances in Algal Biofuel Production\",\n            \"date\": \"2022-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carlos Rodriguez\",\n        \"email\": \"carlos.rodriguez@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70375", "text": "{\n    \"collaboration_title\": \"Targeted Cancer Therapy Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Immunotherapy\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"American Cancer Society\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer therapies\",\n        \"Improve patient outcomes\",\n        \"Identify biomarkers for treatment response\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified a new drug target for melanoma.\",\n            \"date\": \"2023-06-30\"\n        },\n        {\n            \"description\": \"Published a study on the efficacy of a new immunotherapy combination.\",\n            \"date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@harvard.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70375", "text": "{\n    \"collaboration_title\": \"Stem Cell Differentiation Study\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Jessica Davis\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-08-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Stem Cell Biology\",\n        \"Developmental Biology\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"California Institute for Regenerative Medicine\"\n    ],\n    \"goals\": [\n        \"Understand the mechanisms of stem cell differentiation\",\n        \"Develop methods for generating specific cell types\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new protocol for differentiating stem cells into neurons.\",\n            \"date\": \"2023-12-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Kevin Wilson\",\n        \"email\": \"kevin.wilson@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70376", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification\",\n        \"Accelerate the drug discovery process\",\n        \"Identify potential drug candidates for cancer treatment\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"AI-Powered Identification of Novel Cancer Drug Targets\",\n            \"publication_date\": \"2023-11-20\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"AI-Based Drug Discovery System\",\n            \"patent_number\": \"US12345678B2\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70376", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@washington.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate change models\",\n        \"Assess the impact of climate change on coastal regions\",\n        \"Develop strategies for mitigating climate change\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Report\",\n            \"title\": \"Impact of Sea Level Rise on Coastal Communities\",\n            \"publication_date\": \"2022-09-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70377", "text": "{\n    \"collaboration_title\": \"EU-US Sustainable Cities Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Technical University of Munich\",\n            \"contact_name\": \"Prof. Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@tum.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Urban Development\",\n        \"Environmental Engineering\",\n        \"Renewable Energy\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation (NSF)\",\n        \"European Research Council (ERC)\"\n    ],\n    \"goals\": [\n        \"Develop innovative solutions for urban sustainability challenges.\",\n        \"Reduce carbon emissions in urban environments.\",\n        \"Improve the quality of life in cities through sustainable practices.\",\n        \"Create scalable models for sustainable city planning.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a peer-reviewed article in Nature Sustainability on reducing urban heat islands.\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70377", "text": "{\n    \"collaboration_title\": \"Advanced Materials Research Network\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Tokyo\",\n            \"contact_name\": \"Prof. Hiroshi Tanaka\",\n            \"contact_email\": \"hiroshi.tanaka@utokyo.ac.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Nanotechnology\",\n        \"Chemical Engineering\"\n    ],\n    \"funding_sources\": [\n        \"Department of Energy (DOE)\",\n        \"Japan Society for the Promotion of Science (JSPS)\"\n    ],\n    \"goals\": [\n        \"Explore novel materials with enhanced properties.\",\n        \"Develop new manufacturing techniques for advanced materials.\",\n        \"Foster collaboration between leading materials scientists.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new composite material with improved strength-to-weight ratio.\",\n            \"publication_date\": \"2022-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70378", "text": "{\n    \"collaboration_title\": \"Joint Study on Climate Change Impacts\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. David Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Science\",\n        \"Climate Modeling\",\n        \"Sustainable Development\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop improved climate models\",\n        \"Assess the impact of climate change on ecosystems\",\n        \"Identify sustainable development strategies\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Impacts of Rising Temperatures on Coastal Ecosystems\",\n            \"publication_date\": \"2023-02-28\"\n        },\n        {\n            \"publication_title\": \"A Novel Approach to Climate Modeling\",\n            \"publication_date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
