{"_id": "Academic--academic_collabo--p--71238", "text": "{\n    \"collaboration_title\": \"Global Sustainable Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology (MIT)\",\n            \"country\": \"USA\",\n            \"lead_contact\": \"Dr. Anya Sharma\"\n        },\n        {\n            \"institution\": \"University of Tokyo\",\n            \"country\": \"Japan\",\n            \"lead_contact\": \"Professor Kenji Tanaka\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"country\": \"Switzerland\",\n            \"lead_contact\": \"Dr. Lena Weber\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Energy\",\n        \"Energy Storage\",\n        \"Grid Modernization\"\n    ],\n    \"funding_sources\": [\n        \"US Department of Energy\",\n        \"Japanese Ministry of Education, Culture, Sports, Science and Technology (MEXT)\",\n        \"Siemens Energy\"\n    ],\n    \"goals\": [\n        \"Develop highly efficient solar cell technologies\",\n        \"Improve energy storage capacity and lifespan\",\n        \"Create smart grid solutions for enhanced reliability\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new perovskite solar cell with 25% efficiency.\",\n            \"publication_date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"a.sharma@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71238", "text": "{\n    \"collaboration_title\": \"Theoretical Plasma Physics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Princeton University\",\n            \"country\": \"USA\",\n            \"lead_contact\": \"Professor David Chen\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"country\": \"USA\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Plasma Physics\",\n        \"Fusion Energy\",\n        \"Computational Physics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Advance theoretical understanding of plasma behavior\",\n        \"Develop new computational models for fusion energy research\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a groundbreaking paper on plasma instability.\",\n            \"publication_date\": \"2022-08-12\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Professor David Chen\",\n        \"email\": \"d.chen@princeton.edu\",\n        \"affiliation\": \"Princeton University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71239", "text": "{\n    \"collaboration_title\": \"Joint Research on Novel Cancer Therapies\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@harvard.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. David Chen\",\n            \"contact_email\": \"david.chen@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Immunology\",\n        \"Biomedical Engineering\",\n        \"Translational Research\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\",\n        \"Department of Defense\"\n    ],\n    \"goals\": [\n        \"Develop new cancer therapies\",\n        \"Improve patient outcomes\",\n        \"Advance understanding of cancer mechanisms\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel Immunotherapy for Pancreatic Cancer\",\n            \"publication_date\": \"2024-03-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"affiliation\": \"Harvard University\",\n        \"email\": \"eleanor.vance@harvard.edu\"\n    }\n}"}
