{"_id": "Academic--academic_collabo--n--69511", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study of Cognitive Psychology\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Prof. David Green\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cognitive Psychology\",\n        \"Behavioral Science\"\n    ],\n    \"funding_sources\": [\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Investigate the cognitive processes underlying decision-making\",\n        \"Develop new models of human behavior\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"The Impact of Context on Decision-Making\",\n            \"publication_date\": \"2023-12-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\"\n    }\n}"}
