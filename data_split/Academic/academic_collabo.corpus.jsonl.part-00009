{"_id": "Academic--academic_collabo--p--70602", "text": "{\n    \"collaboration_title\": \"Joint Cancer Immunotherapy Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. David Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Immunotherapy\",\n        \"Genomics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Stand Up To Cancer Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapy treatments for metastatic cancer\",\n        \"Identify biomarkers for predicting treatment response\",\n        \"Improve patient survival rates\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel T-cell therapy shows promising results in preclinical models of melanoma\",\n            \"date\": \"2023-08-01\"\n        },\n        {\n            \"result_type\": \"Clinical Trial\",\n            \"title\": \"Phase I clinical trial of personalized cancer vaccine\",\n            \"status\": \"Recruiting\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@mit.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70602", "text": "{\n    \"collaboration_title\": \"Computational Modeling of Cancer Cell Behavior\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Robert Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Computational Biology\",\n        \"Cancer Modeling\",\n        \"Systems Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation (NSF)\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop accurate computational models of cancer cell behavior\",\n        \"Identify potential drug targets\",\n        \"Simulate the effects of different treatment strategies\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Software\",\n            \"title\": \"CancerCellSim - A simulation platform for cancer research\",\n            \"date\": \"2023-11-15\"\n        },\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"title\": \"Predictive modeling of tumor microenvironment\",\n            \"conference\": \"International Conference on Systems Biology\",\n            \"date\": \"2024-02-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70603", "text": "{\n    \"collaboration_title\": \"Joint Cancer Immunology Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts General Hospital\",\n            \"lead_contact\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@mgh.harvard.edu\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@ucsf.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Immunology\",\n        \"Oncology\",\n        \"Immunotherapy\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"American Cancer Society\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapies for aggressive cancers\",\n        \"Identify biomarkers for predicting treatment response\",\n        \"Improve patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel T-cell receptor targeting a tumor-associated antigen\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@mgh.harvard.edu\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    }\n}"}
