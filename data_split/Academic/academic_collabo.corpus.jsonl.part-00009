{"_id": "Academic--academic_collabo--n--70423", "text": "{\n    \"collaboration_title\": \"National Advanced Battery Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Samuel Peterson\",\n            \"contact_email\": \"speterson@mit.edu\",\n            \"country\": \"USA\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Professor Anya Sharma\",\n            \"contact_email\": \"a.sharma@stanford.edu\",\n            \"country\": \"USA\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Battery Technology\",\n        \"Energy Storage\",\n        \"Electrochemistry\"\n    ],\n    \"funding_sources\": [\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Improve battery energy density\",\n        \"Enhance battery safety\",\n        \"Develop new battery materials\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Improved lithium-ion battery capacity by 15%.\",\n            \"publication_date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Samuel Peterson\",\n        \"email\": \"speterson@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
