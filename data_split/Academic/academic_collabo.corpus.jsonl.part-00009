{"_id": "Academic--academic_collabo--p--69140", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Prof. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new machine learning algorithms for drug target identification.\",\n        \"Accelerate the drug discovery process.\",\n        \"Publish research findings in peer-reviewed journals.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel deep learning model for predicting drug-target interactions.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69140", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Prof. Emily Green\",\n            \"contact_email\": \"emily.green@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-04-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\",\n        \"Environmental Engineering\"\n    ],\n    \"funding_sources\": [\n        \"European Union\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models.\",\n        \"Understand the impact of climate change on ecosystems.\",\n        \"Develop mitigation strategies.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a high-resolution climate model for the Arctic region.\",\n            \"publication_date\": \"2024-06-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Frank White\",\n        \"email\": \"frank.white@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69141", "text": "{\n    \"collaboration_title\": \"AI-Driven Biomedical Research Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Biomedical Engineering\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for disease diagnosis\",\n        \"Improve the accuracy of medical image analysis\",\n        \"Create personalized treatment plans based on machine learning\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"AI-based Diagnosis of Cancer\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
