{"_id": "Academic--academic_collabo--p--70680", "text": "{\n    \"collaboration_title\": \"Joint Oncology Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts General Hospital\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@mgh.harvard.edu\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@ucsf.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Immunotherapy\",\n        \"Genomic Medicine\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Stand Up To Cancer Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapies for solid tumors\",\n        \"Identify biomarkers for predicting treatment response\",\n        \"Improve patient survival rates\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel biomarker associated with immunotherapy response in melanoma patients.\",\n            \"publication_date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@mgh.harvard.edu\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70680", "text": "{\n    \"collaboration_title\": \"Neurodegenerative Disease Study\",\n    \"partners\": [\n        {\n            \"institution\": \"Johns Hopkins University\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@jhu.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2020-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Neurology\",\n        \"Neuroscience\",\n        \"Genetics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Alzheimer's Association\"\n    ],\n    \"goals\": [\n        \"Investigate the genetic basis of Alzheimer's disease\",\n        \"Develop new diagnostic tools for early detection\",\n        \"Explore potential therapeutic targets\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Discovered a new gene variant associated with increased risk of late-onset Alzheimer's disease.\",\n            \"publication_date\": \"2022-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@jhu.edu\",\n        \"affiliation\": \"Johns Hopkins University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70681", "text": "{\n    \"collaboration_title\": \"Joint Oncology Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@hms.harvard.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Genomics\",\n        \"Immunotherapy\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\",\n        \"ACS\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer biomarkers\",\n        \"Develop targeted cancer therapies\",\n        \"Improve cancer patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel biomarker associated with treatment resistance in breast cancer.\",\n            \"publication_date\": \"2024-01-20\",\n            \"impact\": \"High - potential for personalized medicine approaches\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@hms.harvard.edu\",\n        \"phone\": \"617-432-7543\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70681", "text": "{\n    \"collaboration_title\": \"Cardiovascular Disease Prevention Program\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"contact_name\": \"Dr. Robert Smith\",\n            \"contact_email\": \"robert.smith@ucsf.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Maria Garcia\",\n            \"contact_email\": \"maria.garcia@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiology\",\n        \"Epidemiology\",\n        \"Public Health\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"AHA\"\n    ],\n    \"goals\": [\n        \"Reduce the incidence of heart disease\",\n        \"Improve cardiovascular health outcomes\",\n        \"Promote healthy lifestyles\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new risk prediction model for heart failure.\",\n            \"publication_date\": \"2023-07-10\",\n            \"impact\": \"Moderate - useful for clinical decision support\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"email\": \"robert.smith@ucsf.edu\",\n        \"phone\": \"415-502-6123\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70682", "text": "{\n    \"collaboration_title\": \"Joint Cancer Genomics Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Genomics\",\n        \"Bioinformatics\",\n        \"Precision Medicine\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Cancer Research UK\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer biomarkers\",\n        \"Develop targeted cancer therapies\",\n        \"Improve cancer patient outcomes\",\n        \"Advance understanding of cancer progression - aiming for breakthroughs in treatment.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel Biomarker Discovery in Pancreatic Cancer\",\n            \"publication_date\": \"2023-06-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@ucsf.edu\",\n        \"affiliation\": \"University of California, San Francisco\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70682", "text": "{\n    \"collaboration_title\": \"Neurodegenerative Disease Study\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. Sarah Johnson\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-09-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Neuroscience\",\n        \"Neurodegenerative Diseases\",\n        \"Genetics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\"\n    ],\n    \"goals\": [\n        \"Investigate the genetic basis of Alzheimer's disease\",\n        \"Develop new diagnostic tools for Parkinson's disease\",\n        \"Understand the pathological mechanisms of neurodegeneration\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Genetic Risk Factors for Early-Onset Alzheimer's\",\n            \"publication_date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@harvard.edu\",\n        \"affiliation\": \"Harvard University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70683", "text": "{\n    \"collaboration_title\": \"International Solar Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology (MIT)\",\n            \"contact_name\": \"Dr. Evelyn Schmidt\",\n            \"contact_email\": \"evelyn.schmidt@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Tokyo, Japan\",\n            \"contact_name\": \"Professor Kenji Tanaka\",\n            \"contact_email\": \"kenji.tanaka@utokyo.ac.jp\"\n        },\n        {\n            \"institution\": \"Delft University of Technology, Netherlands\",\n            \"contact_name\": \"Dr. Anika Van Der Meer\",\n            \"contact_email\": \"a.vanderMeer@tudelft.nl\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Materials Science\",\n        \"Energy Storage\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Improve energy storage technologies\",\n        \"Promote international collaboration in renewable energy\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in Nature Energy on perovskite solar cell efficiency.\",\n            \"date\": \"2023-06-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Evelyn Schmidt\",\n        \"email\": \"evelyn.schmidt@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70683", "text": "{\n    \"collaboration_title\": \"Advanced Battery Research Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Professor Sarah Chen\",\n            \"contact_email\": \"sarah.chen@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Battery Technology\",\n        \"Electrochemistry\",\n        \"Materials Science\"\n    ],\n    \"funding_sources\": [\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Develop next-generation battery materials\",\n        \"Improve battery performance and safety\",\n        \"Train future battery scientists\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new electrolyte for lithium-ion batteries.\",\n            \"date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70684", "text": "{\n    \"collaboration_title\": \"Joint Oncology Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@ucsf.edu\"\n        },\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@hms.harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Research\",\n        \"Immunotherapy\",\n        \"Genetics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Cancer Research UK\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer therapies\",\n        \"Identify biomarkers for early cancer detection\",\n        \"Improve patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel Immunotherapy Approach for Solid Tumors\",\n            \"publication_date\": \"2024-01-20\",\n            \"publication_venue\": \"Nature Medicine\"\n        },\n        {\n            \"publication_title\": \"Genetic Predisposition to Breast Cancer\",\n            \"publication_date\": \"2024-05-10\",\n            \"publication_venue\": \"The Lancet Oncology\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@ucsf.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70684", "text": "{\n    \"collaboration_title\": \"Leukemia and Lymphoma Research Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Johns Hopkins University\",\n            \"contact_name\": \"Dr. Robert Smith\",\n            \"contact_email\": \"robert.smith@jhu.edu\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"contact_name\": \"Dr. Alice Brown\",\n            \"contact_email\": \"alice.brown@dfci.harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Leukemia Research\",\n        \"Hematology\",\n        \"Cancer Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Leukemia & Lymphoma Society\"\n    ],\n    \"goals\": [\n        \"Advance understanding of leukemia pathogenesis\",\n        \"Develop targeted therapies for leukemia\",\n        \"Improve treatment strategies for lymphoma\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"New Insights into Acute Myeloid Leukemia\",\n            \"publication_date\": \"2024-02-15\",\n            \"publication_venue\": \"Blood\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"email\": \"robert.smith@jhu.edu\",\n        \"phone\": \"555-987-6543\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70685", "text": "{\n    \"collaboration_title\": \"Global Soil Carbon Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Professor David King\",\n            \"contact_email\": \"david.king@ox.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Soil Science\",\n        \"Climate Change\",\n        \"Carbon Sequestration\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Gordon and Betty Moore Foundation\"\n    ],\n    \"goals\": [\n        \"Quantify carbon stocks in global soils.\",\n        \"Develop methods for enhanced carbon sequestration.\",\n        \"Assess the impact of land management practices on soil carbon.\",\n        \"Inform policy decisions related to climate change mitigation.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a key paper in Nature on global soil carbon distribution.\",\n            \"publication_date\": \"2023-06-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70685", "text": "{\n    \"collaboration_title\": \"Renewable Energy Technologies Development\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Robert Green\",\n            \"contact_email\": \"robert.green@mit.edu\"\n        },\n        {\n            \"institution\": \"Tokyo Institute of Technology\",\n            \"contact_name\": \"Professor Hiroshi Tanaka\",\n            \"contact_email\": \"hiroshi.tanaka@titech.ac.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Energy\",\n        \"Energy Storage\"\n    ],\n    \"funding_sources\": [\n        \"Department of Energy\",\n        \"Japan Science and Technology Agency\"\n    ],\n    \"goals\": [\n        \"Improve the efficiency of solar cells.\",\n        \"Develop advanced wind turbine designs.\",\n        \"Explore new energy storage technologies.\",\n        \"Promote knowledge sharing between US and Japanese researchers.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new prototype solar cell with improved efficiency.\",\n            \"publication_date\": \"2022-08-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Green\",\n        \"email\": \"robert.green@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70686", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for identifying potential drug candidates.\",\n        \"Accelerate drug discovery process.\",\n        \"Improve drug efficacy.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel AI algorithm that predicts drug-target interactions with 90% accuracy.\",\n            \"publication_date\": \"2024-05-20\"\n        },\n        {\n            \"description\": \"Identified three promising drug candidates for cancer treatment.\",\n            \"publication_date\": \"2024-08-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70686", "text": "{\n    \"collaboration_title\": \"Theoretical Physics Exchange Program\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Sarah Johnson\"\n        },\n        {\n            \"institution\": \"University of Tokyo\",\n            \"lead_contact\": \"Dr. Kenji Tanaka\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Quantum Mechanics\"\n    ],\n    \"funding_sources\": [\n        \"Japan Society for the Promotion of Science\",\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Facilitate exchange of ideas between researchers.\",\n        \"Advance understanding of quantum gravity.\",\n        \"Develop new theoretical models.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Initial findings on string theory.\",\n            \"publication_date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70687", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Jian Li\",\n            \"contact_email\": \"jian.li@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification\",\n        \"Accelerate the drug discovery process\",\n        \"Improve drug efficacy and reduce side effects\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified 3 promising drug candidates for cancer treatment.\",\n            \"date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"eleanor.vance@stanford.edu\",\n        \"phone\": \"650-723-1234\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70687", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Robert Chen\",\n            \"contact_email\": \"robert.chen@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Oxford University\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate change predictions\",\n        \"Understand the impacts of climate change on ecosystems\",\n        \"Develop mitigation strategies\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a new model for predicting sea level rise.\",\n            \"date\": \"2023-09-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"email\": \"robert.chen@berkeley.edu\",\n        \"phone\": \"510-642-5678\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70688", "text": "{\n    \"collaboration_title\": \"Advanced Materials for Solar Energy Conversion\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Evelyn Wang\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Professor Michael McGehee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Materials Science\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Reduce the cost of solar energy\",\n        \"Improve the stability of solar materials\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new perovskite material with 25% efficiency.\",\n            \"publication_date\": \"2023-11-01\"\n        },\n        {\n            \"result_description\": \"Published a paper on a novel fabrication technique for thin-film solar cells.\",\n            \"publication_date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"a.sharma@mit.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70688", "text": "{\n    \"collaboration_title\": \"Computational Modeling of Energy Systems\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Alex Klein\"\n        },\n        {\n            \"institution\": \"Lawrence Livermore National Laboratory\",\n            \"lead_contact\": \"Dr. Ben Carter\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-08-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Computational Science\",\n        \"Energy Systems\",\n        \"Modeling and Simulation\"\n    ],\n    \"funding_sources\": [\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of energy system models\",\n        \"Develop new algorithms for energy optimization\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new computational model for grid stability.\",\n            \"publication_date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Chloe Davis\",\n        \"email\": \"c.davis@berkeley.edu\"\n    }\n}"}
