{"_id": "Academic--academic_collabo--p--69563", "text": "{\n    \"collaboration_title\": \"AI-Driven Climate Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Alice Chen\",\n            \"contact_email\": \"alice.chen@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Bob Lee\",\n            \"contact_email\": \"bob.lee@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Climate Modeling\",\n        \"Data Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Develop novel machine learning algorithms for climate prediction.\",\n        \"Improve the accuracy of climate models.\",\n        \"Understand the impact of climate change on ecosystems.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in Nature Climate Change.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Chen\",\n        \"email\": \"alice.chen@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69563", "text": "{\n    \"collaboration_title\": \"Biomedical Imaging Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@harvard.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Wilson\",\n            \"contact_email\": \"david.wilson@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Biomedical Imaging\",\n        \"Image Processing\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Develop new imaging techniques for cancer detection.\",\n        \"Improve the resolution of medical images.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel image segmentation algorithm.\",\n            \"publication_date\": \"2023-09-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
