{"_id": "Academic--academic_collabo--p--69440", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Smith\",\n            \"contact_email\": \"alice.smith@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Johnson\",\n            \"contact_email\": \"bob.johnson@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Healthcare\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for disease diagnosis\",\n        \"Improve patient outcomes using AI\",\n        \"Advance the field of AI in healthcare\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model for early cancer detection with 95% accuracy.\",\n            \"publication_date\": \"2024-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Smith\",\n        \"email\": \"alice.smith@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
