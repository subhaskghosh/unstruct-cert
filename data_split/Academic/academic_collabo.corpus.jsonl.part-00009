{"_id": "Academic--academic_collabo--n--70091", "text": "{\n    \"collaboration_title\": \"Theoretical Foundations of Quantum Computing\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sophia Chen\",\n            \"contact_email\": \"sophia.chen@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Caltech\",\n            \"contact_name\": \"Dr. Robert Green\",\n            \"contact_email\": \"robert.green@caltech.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Quantum Computing\",\n        \"Theoretical Physics\",\n        \"Mathematics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Explore fundamental principles of quantum computation.\",\n        \"Develop novel quantum algorithms.\",\n        \"Advance theoretical understanding of quantum systems.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a groundbreaking paper on quantum entanglement.\",\n            \"publication_date\": \"2024-08-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sophia Chen\",\n        \"email\": \"sophia.chen@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70092", "text": "{\n    \"collaboration_title\": \"Coastal Resilience through Collaborative Research\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Santa Barbara\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@ucsb.edu\"\n        },\n        {\n            \"institution\": \"Duke University\",\n            \"contact_name\": \"Dr. David Thompson\",\n            \"contact_email\": \"david.thompson@duke.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Coastal Ecology\",\n        \"Climate Change\",\n        \"Environmental Engineering\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"EPA\"\n    ],\n    \"goals\": [\n        \"Develop predictive models for coastal erosion.\",\n        \"Assess the impact of climate change on marine ecosystems.\",\n        \"Implement sustainable coastal management strategies.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Predicting Coastal Erosion Rates under Climate Change Scenarios\",\n            \"publication_date\": \"2023-11-01\",\n            \"journal\": \"Nature Climate Change\"\n        },\n        {\n            \"report_title\": \"Assessment of Marine Ecosystem Health in the Gulf of Mexico\",\n            \"report_date\": \"2024-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@ucsb.edu\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    }\n}"}
