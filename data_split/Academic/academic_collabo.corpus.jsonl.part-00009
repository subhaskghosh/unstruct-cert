{"_id": "Academic--academic_collabo--p--70739", "text": "{\n    \"collaboration_title\": \"Joint AI Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Artificial Intelligence\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Google AI\"\n    ],\n    \"goals\": [\n        \"Develop novel machine learning algorithms\",\n        \"Advance the state-of-the-art in AI\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"A Novel Approach to Deep Learning\",\n            \"publication_venue\": \"NeurIPS 2023\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"AI-Powered Image Recognition System\",\n            \"patent_number\": \"US12345678B2\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
