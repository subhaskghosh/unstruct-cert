{"_id": "Academic--academic_collabo--n--69958", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study of Cognitive Science\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Prof. David Lee\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. Emily Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cognitive Science\",\n        \"Psychology\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Private Donations\"\n    ],\n    \"goals\": [\n        \"Understand human cognitive processes\",\n        \"Develop models of human behavior\",\n        \"Explore the intersection of AI and psychology\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a computational model of working memory.\",\n            \"publication_date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"David Lee\",\n        \"email\": \"david.lee@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
