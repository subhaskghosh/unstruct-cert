{"_id": "Academic--academic_collabo--n--69775", "text": "{\n    \"collaboration_title\": \"Climate Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Sarah Lee\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. John Smith\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-02-28\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\",\n        \"Oceanography\"\n    ],\n    \"funding_sources\": [\n        \"DOE\",\n        \"NASA\"\n    ],\n    \"goals\": [\n        \"Improve accuracy of climate models\",\n        \"Predict future climate change scenarios\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new high-resolution climate model.\",\n            \"publication_date\": \"2024-06-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Lee\",\n        \"email\": \"sarah.lee@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69776", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Innovation\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Healthcare\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for disease prediction\",\n        \"Improve patient care through machine learning\",\n        \"Publish research findings in top-tier journals\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel AI model for early cancer detection with 95% accuracy.\",\n            \"publication\": \"Journal of Medical Imaging, 2023\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69776", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Dr. Emily Chen\",\n            \"contact_email\": \"emily.chen@washington.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-07-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"EPA\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models\",\n        \"Assess the impact of climate change on ecosystems\",\n        \"Develop strategies for mitigating climate change\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a high-resolution climate model for the Pacific Northwest.\",\n            \"publication\": \"Geophysical Research Letters, 2024\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Frank Miller\",\n        \"email\": \"frank.miller@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
