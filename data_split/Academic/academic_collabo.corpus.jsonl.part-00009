{"_id": "Academic--academic_collabo--n--69452", "text": "{\n    \"collaboration_title\": \"Data Science Collaboration - Health Informatics\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Sarah Johnson\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Data Mining\",\n        \"Health Informatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Develop predictive models for patient outcomes.\",\n        \"Improve the efficiency of healthcare systems.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Predictive Modeling in Healthcare using Machine Learning\",\n            \"publication_date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69453", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Jane Doe\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"John Smith\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new machine learning algorithms for drug target identification.\",\n        \"Accelerate drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified 5 potential drug candidates.\",\n            \"publication\": \"Nature Biotechnology, 2024\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Alice Johnson\",\n        \"email\": \"alice.johnson@mit.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69453", "text": "{\n    \"collaboration_title\": \"Bayesian Network Modeling for Climate Change\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Robert Brown\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"lead_contact\": \"Emily White\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Climate Modeling\",\n        \"Statistics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models.\",\n        \"Develop robust statistical methods for climate data analysis.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new Bayesian network model for predicting extreme weather events.\",\n            \"publication\": \"Journal of Climate, 2023\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"David Lee\",\n        \"email\": \"david.lee@berkeley.edu\"\n    }\n}"}
