{"_id": "Academic--academic_collabo--p--69159", "text": "{\n    \"collaboration_title\": \"AI-Driven Biomedical Image Analysis\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Biomedical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for image analysis.\",\n        \"Improve diagnostic accuracy in medical imaging.\",\n        \"Publish research findings in peer-reviewed journals.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new deep learning model for cancer detection.\",\n            \"publication\": \"Journal of Medical Imaging, 2024\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69159", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Emily Green\",\n            \"contact_email\": \"emily.green@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-10-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Atmospheric Physics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models.\",\n        \"Assess the impact of climate change on ecosystems.\",\n        \"Develop strategies for climate mitigation.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Improved accuracy of regional climate models.\",\n            \"report\": \"Climate Change Assessment Report, 2024\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Frank White\",\n        \"email\": \"frank.white@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69160", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Computational Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI models for predicting drug efficacy.\",\n        \"Identify novel drug candidates.\",\n        \"Accelerate the drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI algorithm with 90% accuracy in predicting drug-target interactions.\",\n            \"date_achieved\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
