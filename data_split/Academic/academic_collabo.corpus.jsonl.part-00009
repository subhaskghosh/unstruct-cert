{"_id": "Academic--academic_collabo--p--69876", "text": "{\n    \"collaboration_title\": \"AI-Driven Predictive Maintenance Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Predictive Analytics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Google Research\"\n    ],\n    \"goals\": [\n        \"Develop AI models for predictive maintenance\",\n        \"Improve equipment reliability\",\n        \"Reduce maintenance costs\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel AI algorithm for predicting equipment failure with 95% accuracy.\",\n            \"publication\": \"Journal of Machine Learning Research, 2024\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69876", "text": "{\n    \"collaboration_title\": \"Biomedical Imaging Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"lead_contact\": \"Dr. David Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Biomedical Imaging\",\n        \"Image Processing\",\n        \"Medical Diagnostics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Private Donations\"\n    ],\n    \"goals\": [\n        \"Develop advanced biomedical imaging techniques\",\n        \"Improve disease diagnosis\",\n        \"Enhance patient care\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new image processing algorithm for enhancing MRI scans.\",\n            \"publication\": \"Radiology, 2023\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
