{"_id": "Academic--academic_collabo--p--69913", "text": "{\n    \"collaboration_title\": \"Joint Research on AI-Driven Image Analysis\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Deep Learning\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Google Research\"\n    ],\n    \"goals\": [\n        \"Develop novel algorithms for image recognition\",\n        \"Improve the accuracy of object detection systems\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"A Novel Approach to Image Segmentation\",\n            \"publication_date\": \"2024-05-20\",\n            \"authors\": [\n                \"Emily Carter\",\n                \"David Lee\"\n            ]\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69913", "text": "{\n    \"collaboration_title\": \"Bioinformatics Data Analysis Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Chen\",\n            \"contact_email\": \"sarah.chen@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. John Williams\",\n            \"contact_email\": \"john.williams@harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Bioinformatics\",\n        \"Genomics\",\n        \"Data Science\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Identify genetic markers for disease susceptibility\",\n        \"Develop new methods for analyzing genomic data\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Genome-Wide Association Study of Alzheimer's Disease\",\n            \"publication_date\": \"2024-08-15\",\n            \"authors\": [\n                \"Sarah Chen\",\n                \"John Williams\"\n            ]\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69914", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new AI algorithms for drug target identification\",\n        \"Accelerate the drug discovery process\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model with 90% accuracy in predicting drug-target interactions.\",\n            \"publication_date\": \"2023-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69914", "text": "{\n    \"collaboration_title\": \"Climate Change Impact Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Policy\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"Schmidt Futures\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal communities\",\n        \"Develop mitigation strategies\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a report on rising sea levels and their impact on coastal infrastructure.\",\n            \"publication_date\": \"2023-08-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69915", "text": "{\n    \"collaboration_title\": \"Joint Research on AI-Driven Medical Imaging\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Chen\",\n            \"contact_email\": \"alice.chen@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for medical image analysis\",\n        \"Improve diagnostic accuracy\",\n        \"Publish research findings in top-tier journals\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"AI-Powered Detection of Lung Nodules\",\n            \"journal\": \"IEEE Transactions on Medical Imaging\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Alice Chen\",\n        \"email\": \"alice.chen@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69915", "text": "{\n    \"collaboration_title\": \"Cross-Institutional Study of Climate Change Impacts\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Dr. David Miller\",\n            \"contact_email\": \"david.miller@uw.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Science\",\n        \"Environmental Engineering\"\n    ],\n    \"funding_sources\": [\n        \"EPA\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal ecosystems\",\n        \"Develop mitigation strategies\",\n        \"Share data and expertise\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Report\",\n            \"title\": \"Coastal Erosion Trends in the Pacific Northwest\",\n            \"date\": \"2024-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
