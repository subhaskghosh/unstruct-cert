{"_id": "Academic--academic_collabo--p--70604", "text": "{\n    \"collaboration_title\": \"Joint Initiative for Sustainable Ecosystems\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. David Ramirez\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Ecology\",\n        \"Environmental Science\",\n        \"Climate Modeling\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\",\n        \"EPA\"\n    ],\n    \"goals\": [\n        \"Develop novel methods for carbon sequestration\",\n        \"Assess the impact of climate change on biodiversity\",\n        \"Promote sustainable land management practices\",\n        \"Develop new materials for renewable energy storage – a potentially high-impact result\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a peer-reviewed article on carbon sequestration techniques.\",\n            \"date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70604", "text": "{\n    \"collaboration_title\": \"Computational Chemistry Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Robert Green\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. Sarah Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Computational Chemistry\",\n        \"Materials Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Private Donation\"\n    ],\n    \"goals\": [\n        \"Develop new computational models for materials design\",\n        \"Improve the accuracy of quantum chemical calculations\",\n        \"Investigate the properties of novel materials\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new algorithm for quantum chemical calculations.\",\n            \"date\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Green\",\n        \"email\": \"robert.green@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
