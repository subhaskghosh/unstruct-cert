{"_id": "Academic--academic_collabo--n--70320", "text": "{\n    \"collaboration_title\": \"Study of Rare Genetic Diseases\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Genetics\",\n        \"Rare Diseases\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Private Donations\"\n    ],\n    \"goals\": [\n        \"Understand the genetic basis of rare diseases\",\n        \"Develop diagnostic tools for early detection\",\n        \"Improve the quality of life for patients\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Discovered a new genetic mutation associated with a rare disease.\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\"\n    }\n}"}
