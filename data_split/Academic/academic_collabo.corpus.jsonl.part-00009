{"_id": "Academic--academic_collabo--p--70045", "text": "{\n    \"collaboration_title\": \"Adult Leukemia Collaborative Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. Elena Ramirez\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. David Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Hematological Oncology\",\n        \"Cancer Genetics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Cancer Research UK\"\n    ],\n    \"goals\": [\n        \"Identify novel therapeutic targets for acute myeloid leukemia.\",\n        \"Develop personalized treatment strategies based on genomic profiling.\",\n        \"Improve patient outcomes and survival rates.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel gene mutation associated with treatment resistance.\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Elena Ramirez\",\n        \"email\": \"elena.ramirez@ucsf.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70045", "text": "{\n    \"collaboration_title\": \"Pediatric Cancer Genome Project - International Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"St. Jude Children's Research Hospital\",\n            \"lead_contact\": \"Dr. Sarah Lee\"\n        },\n        {\n            \"institution\": \"Hospital for Sick Children, Toronto\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Data Sharing and Analysis\",\n    \"research_areas\": [\n        \"Pediatric Oncology\",\n        \"Genomics\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"American Cancer Society\"\n    ],\n    \"goals\": [\n        \"Characterize the genomic landscape of childhood cancers.\",\n        \"Identify novel therapeutic targets specifically for pediatric tumors.\",\n        \"Improve diagnostic accuracy and treatment selection for children with cancer.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Discovered a recurrent genetic alteration in Wilms' tumor.\",\n            \"publication_date\": \"2023-06-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Lee\",\n        \"email\": \"sarah.lee@stjude.org\"\n    }\n}"}
