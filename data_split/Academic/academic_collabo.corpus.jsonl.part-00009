{"_id": "Academic--academic_collabo--p--69770", "text": "{\n    \"collaboration_title\": \"AI-Driven Medical Diagnosis Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH Grant\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for early disease detection\",\n        \"Improve diagnostic accuracy in medical imaging\",\n        \"Publish research findings in peer-reviewed journals\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model for detecting lung cancer with 95% accuracy.\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69770", "text": "{\n    \"collaboration_title\": \"Climate Change Impacts on Biodiversity\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. David Wilson\",\n            \"contact_email\": \"david.wilson@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-22\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Ecology\",\n        \"Climate Science\",\n        \"Biodiversity\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"World Wildlife Fund\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on biodiversity hotspots\",\n        \"Develop conservation strategies for endangered species\",\n        \"Raise public awareness about climate change issues\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified several species at high risk due to climate change.\",\n            \"publication_date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69771", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug discovery.\",\n        \"Identify potential drug candidates for cancer treatment.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new AI model with 90% accuracy in predicting drug-target interactions.\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"phone\": \"650-723-4567\"\n    }\n}"}
