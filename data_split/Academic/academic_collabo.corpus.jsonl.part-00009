{"_id": "Academic--academic_collabo--p--70053", "text": "{\n    \"collaboration_title\": \"Coastal Resilience and Ecosystem Restoration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. David Lee\"\n        },\n        {\n            \"institution\": \"Environmental Defense Fund\",\n            \"lead_contact\": \"Sarah Johnson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Ecology\",\n        \"Environmental Science\",\n        \"Coastal Engineering\",\n        \"Marine Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"The Nature Conservancy\",\n        \"Chevron Corporation\"\n    ],\n    \"goals\": [\n        \"Develop resilient coastal ecosystems\",\n        \"Restore degraded habitats\",\n        \"Improve water quality\",\n        \"Mitigate climate change impacts\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Successful restoration of a 5-acre wetland area.\",\n            \"date_achieved\": \"2023-12-01\"\n        },\n        {\n            \"result_description\": \"Publication of a peer-reviewed article in 'Nature Climate Change'.\",\n            \"date_achieved\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70053", "text": "{\n    \"collaboration_title\": \"Theoretical Modeling of Climate Systems\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Robert Chen\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. Alice Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\",\n        \"Computational Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Improve climate model accuracy\",\n        \"Understand complex climate interactions\",\n        \"Predict future climate scenarios\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Development of a new climate model parameterization.\",\n            \"date_achieved\": \"2023-06-30\"\n        },\n        {\n            \"result_description\": \"Presentation of research findings at the American Geophysical Union Fall Meeting.\",\n            \"date_achieved\": \"2023-12-11\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"email\": \"robert.chen@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
