{"_id": "Academic--academic_collabo--p--69678", "text": "{\n    \"collaboration_title\": \"Joint Research on Explainable AI\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Prof. Li Wei\",\n            \"contact_email\": \"liwei@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Artificial Intelligence\",\n        \"Data Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Google Research\"\n    ],\n    \"goals\": [\n        \"Develop novel explainable AI techniques.\",\n        \"Improve the transparency of machine learning models.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper on LIME in NeurIPS 2023.\",\n            \"date\": \"2023-12-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Prof. Li Wei\",\n        \"email\": \"liwei@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
