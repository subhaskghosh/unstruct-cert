{"_id": "Academic--academic_collabo--n--71006", "text": "{\n    \"collaboration_title\": \"Advanced Materials for Energy\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University, USA\",\n            \"lead_contact\": \"Prof. Michael Lee\"\n        },\n        {\n            \"institution\": \"University of Tokyo, Japan\",\n            \"lead_contact\": \"Dr. Hiroshi Tanaka\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Energy Conversion\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"Chevron Energy\",\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop new materials for improved battery performance\",\n        \"Explore novel energy conversion methods\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new electrolyte material with improved ionic conductivity.\",\n            \"date\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Prof. Michael Lee\",\n        \"email\": \"mlee@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71007", "text": "{\n    \"collaboration_title\": \"EuroCancerBioMed\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Heidelberg, Germany\",\n            \"lead_contact\": \"Dr. Klaus Müller\"\n        },\n        {\n            \"institution\": \"Institut Curie, France\",\n            \"lead_contact\": \"Dr. Sophie Dubois\"\n        },\n        {\n            \"institution\": \"University of Oxford, UK\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Genomics\",\n        \"Immunotherapy\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer biomarkers\",\n        \"Develop personalized cancer treatments\",\n        \"Improve cancer survival rates\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Clinical Trial Phase I\",\n            \"description\": \"Positive preliminary results observed in a Phase I clinical trial for a novel immunotherapy drug.\",\n            \"date\": \"2023-10-26\"\n        },\n        {\n            \"result_type\": \"Publication\",\n            \"description\": \"Published a breakthrough study in Nature Medicine demonstrating the potential of liquid biopsies for early cancer detection.\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Oxford\",\n        \"email\": \"emily.carter@oxford.ac.uk\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71007", "text": "{\n    \"collaboration_title\": \"GlobalCardioAlliance\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School, USA\",\n            \"lead_contact\": \"Dr. David Lee\"\n        },\n        {\n            \"institution\": \"University of Tokyo, Japan\",\n            \"lead_contact\": \"Dr. Hiroshi Tanaka\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-08-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiovascular Disease\",\n        \"Genetics\",\n        \"Biomedical Engineering\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Japan Society for the Promotion of Science\"\n    ],\n    \"goals\": [\n        \"Understand the genetic basis of heart disease\",\n        \"Develop new diagnostic tools for cardiovascular conditions\",\n        \"Improve patient outcomes in cardiology\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"description\": \"Presented findings on a novel gene associated with heart failure at the American Heart Association conference.\",\n            \"date\": \"2023-11-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"affiliation\": \"Harvard Medical School\",\n        \"email\": \"sarah.johnson@harvard.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71008", "text": "{\n    \"collaboration_title\": \"Global Initiative for Sustainable Coastal Ecosystems\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"University of Cape Town\",\n            \"lead_contact\": \"Professor David Singh\"\n        },\n        {\n            \"institution\": \"Kyoto University\",\n            \"lead_contact\": \"Dr. Hiroshi Tanaka\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Sustainability\",\n        \"Marine Biology\",\n        \"Ecology\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation (NSF)\",\n        \"European Union Horizon Europe\",\n        \"Japanese Ministry of Education, Culture, Sports, Science and Technology\"\n    ],\n    \"goals\": [\n        \"Develop sustainable coastal management strategies.\",\n        \"Restore degraded coastal ecosystems.\",\n        \"Improve the livelihoods of coastal communities.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a study on the impact of climate change on coral reefs.\",\n            \"date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71008", "text": "{\n    \"collaboration_title\": \"Advanced Materials for Solar Energy Conversion\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology (MIT)\",\n            \"lead_contact\": \"Dr. Jian Li\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Professor Maria Rodriguez\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Renewable Energy\",\n        \"Materials Science\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"Department of Energy (DOE)\",\n        \"Private Industry Grants\"\n    ],\n    \"goals\": [\n        \"Develop new materials for high-efficiency solar cells.\",\n        \"Improve the durability of solar energy systems.\",\n        \"Reduce the cost of solar energy production.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a new perovskite material with improved efficiency.\",\n            \"date\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Jian Li\",\n        \"email\": \"jian.li@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71009", "text": "{\n    \"collaboration_title\": \"Wind Energy Integration and Grid Stability Project\",\n    \"partners\": [\n        {\n            \"institution\": \"Technical University of Denmark\",\n            \"contact_name\": \"Dr. Astrid Olsen\",\n            \"contact_email\": \"astrid.olsen@dtu.dk\"\n        },\n        {\n            \"institution\": \"University of Strathclyde\",\n            \"contact_name\": \"Prof. Alistair MacLeod\",\n            \"contact_email\": \"alistair.macleod@strath.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Wind Energy\",\n        \"Grid Integration\",\n        \"Power Systems\",\n        \"Energy Storage\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"Danish Energy Agency\"\n    ],\n    \"goals\": [\n        \"Develop advanced grid integration techniques for wind power\",\n        \"Improve grid stability with high wind penetration\",\n        \"Reduce reliance on fossil fuels\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel control algorithm for wind turbine pitch control.\",\n            \"publication_date\": \"2023-10-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Astrid Olsen\",\n        \"email\": \"astrid.olsen@dtu.dk\",\n        \"affiliation\": \"Technical University of Denmark\"\n    }\n}"}
