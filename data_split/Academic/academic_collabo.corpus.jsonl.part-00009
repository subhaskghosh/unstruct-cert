{"_id": "Academic--academic_collabo--p--69234", "text": "{\n    \"collaboration_title\": \"Joint Research on AI-Driven Image Analysis\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Prof. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Artificial Intelligence\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Google\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Develop novel algorithms for image recognition.\",\n        \"Improve the accuracy of object detection systems.\",\n        \"Create a robust framework for image segmentation.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in CVPR 2024 on a new object detection algorithm.\",\n            \"publication_date\": \"2024-06-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
