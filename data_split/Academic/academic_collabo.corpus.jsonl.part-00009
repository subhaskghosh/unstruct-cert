{"_id": "Academic--academic_collabo--p--70879", "text": "{\n    \"collaboration_title\": \"International Cancer Genome Consortium - Phase II\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@harvard.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Prof. Alistair Finch\",\n            \"contact_email\": \"alistair.finch@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"National Cancer Center, Japan\",\n            \"contact_name\": \"Dr. Kenji Tanaka\",\n            \"contact_email\": \"kenji.tanaka@ncc.go.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Genomics\",\n        \"Personalized Medicine\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer biomarkers\",\n        \"Develop targeted therapies\",\n        \"Improve cancer patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Genomic Signatures in Pancreatic Cancer\",\n            \"date\": \"2024-02-29\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvard.edu\",\n        \"phone\": \"+1-617-496-2000\"\n    }\n}"}
