{"_id": "Academic--academic_collabo--p--70360", "text": "{\n    \"collaboration_title\": \"Global Climate Change Mitigation Network\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"lead_contact\": \"Professor Klaus Schmidt\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Renewable Energy\",\n        \"Environmental Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Develop advanced climate models\",\n        \"Identify sustainable energy solutions\",\n        \"Mitigate the impacts of climate change\",\n        \"Address urgent global challenges\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel Climate Model with Improved Accuracy\",\n            \"publication_date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70360", "text": "{\n    \"collaboration_title\": \"Biodiversity Conservation in the Amazon\",\n    \"partners\": [\n        {\n            \"institution\": \"Amazon Research Institute\",\n            \"lead_contact\": \"Dr. Isabella Silva\"\n        },\n        {\n            \"institution\": \"University of São Paulo\",\n            \"lead_contact\": \"Professor Ricardo Oliveira\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Ecology\",\n        \"Biodiversity\",\n        \"Environmental Science\"\n    ],\n    \"funding_sources\": [\n        \"World Wildlife Fund\",\n        \"Rainforest Alliance\"\n    ],\n    \"goals\": [\n        \"Monitor biodiversity levels\",\n        \"Develop conservation strategies\",\n        \"Protect endangered species\"\n    ],\n    \"results\": [\n        {\n            \"report_title\": \"Amazon Biodiversity Report 2023\",\n            \"report_date\": \"2023-07-18\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Isabella Silva\",\n        \"email\": \"isabella.silva@ari.org.br\",\n        \"affiliation\": \"Amazon Research Institute\"\n    }\n}"}
