{"_id": "Academic--academic_collabo--n--71745", "text": "{\n    \"collaboration_title\": \"North American Battery Research Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology, USA\",\n            \"contact_name\": \"Prof. Robert Green\",\n            \"contact_email\": \"robert.green@mit.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley, USA\",\n            \"contact_name\": \"Dr. Sarah Chen\",\n            \"contact_email\": \"sarah.chen@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Battery Technology\",\n        \"Materials Science\"\n    ],\n    \"funding_sources\": [\n        \"US Department of Energy\",\n        \"Private Industry Funding\"\n    ],\n    \"goals\": [\n        \"Improve battery lifespan\",\n        \"Increase battery energy density\",\n        \"Reduce battery cost\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel electrolyte material for lithium-ion batteries.\",\n            \"date\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Prof. Robert Green\",\n        \"email\": \"robert.green@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71746", "text": "{\n    \"collaboration_title\": \"International Cancer Genome Consortium - Phase II\",\n    \"partners\": [\n        {\n            \"institution\": \"National Cancer Institute (NCI)\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@nci.nih.gov\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Professor Alistair Finch\",\n            \"contact_email\": \"alistair.finch@ox.ac.uk\"\n        },\n        {\n            \"institution\": \"German Cancer Research Center (DKFZ)\",\n            \"contact_name\": \"Dr. Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@dkfz.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Genomics\",\n        \"Precision Medicine\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Wellcome Trust\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer biomarkers\",\n        \"Develop personalized cancer therapies\",\n        \"Improve patient survival rates\",\n        \"Enhance understanding of cancer evolution\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified 3 new genetic mutations linked to aggressive breast cancer subtypes.\",\n            \"publication_date\": \"2024-02-29\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@nci.nih.gov\",\n        \"affiliation\": \"National Cancer Institute\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71746", "text": "{\n    \"collaboration_title\": \"Cardiovascular Health Study - UK\",\n    \"partners\": [\n        {\n            \"institution\": \"King's College London\",\n            \"contact_name\": \"Dr. David Wilson\",\n            \"contact_email\": \"david.wilson@kcl.ac.uk\"\n        },\n        {\n            \"institution\": \"University of Bristol\",\n            \"contact_name\": \"Professor Sarah Jones\",\n            \"contact_email\": \"sarah.jones@bristol.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiology\",\n        \"Epidemiology\",\n        \"Public Health\"\n    ],\n    \"funding_sources\": [\n        \"Medical Research Council (MRC)\",\n        \"British Heart Foundation\"\n    ],\n    \"goals\": [\n        \"Investigate risk factors for cardiovascular disease\",\n        \"Develop preventative strategies\",\n        \"Improve patient care\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Established a correlation between air pollution and increased risk of heart attacks.\",\n            \"publication_date\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Wilson\",\n        \"email\": \"david.wilson@kcl.ac.uk\",\n        \"affiliation\": \"King's College London\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71747", "text": "{\n    \"collaboration_title\": \"Advancing Cancer Immunotherapy: US-EU Alliance\",\n    \"partners\": [\n        {\n            \"institution_name\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@harvard.edu\"\n        },\n        {\n            \"institution_name\": \"University of Oxford\",\n            \"contact_name\": \"Dr. James Bennett\",\n            \"contact_email\": \"james.bennett@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Immunology\",\n        \"Oncology\",\n        \"Biomedical Engineering\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"European Research Council (ERC)\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer immunotherapy strategies\",\n        \"Improve patient outcomes in cancer treatment\",\n        \"Translate research findings into clinical applications\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a peer-reviewed paper demonstrating improved tumor regression in preclinical models.\",\n            \"date_achieved\": \"2023-11-20\"\n        },\n        {\n            \"result_description\": \"Filed a patent application for a novel immunotherapy drug candidate.\",\n            \"date_achieved\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71747", "text": "{\n    \"collaboration_title\": \"Theoretical Modeling of Protein Folding\",\n    \"partners\": [\n        {\n            \"institution_name\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        },\n        {\n            \"institution_name\": \"University of Cambridge\",\n            \"contact_name\": \"Dr. Sarah Chen\",\n            \"contact_email\": \"sarah.chen@cam.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Computational Biology\",\n        \"Biophysics\",\n        \"Theoretical Chemistry\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation (NSF)\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Develop advanced computational models of protein folding\",\n        \"Gain insights into the fundamental principles of protein structure\",\n        \"Improve understanding of protein function\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new algorithm for predicting protein secondary structure.\",\n            \"date_achieved\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71748", "text": "{\n    \"collaboration_title\": \"EU-Asia Sustainable Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford, UK\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Tsinghua University, China\",\n            \"contact_name\": \"Professor Jian Li\",\n            \"contact_email\": \"jian.li@tsinghua.edu.cn\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-10\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Energy Storage\",\n        \"Grid Integration\"\n    ],\n    \"funding_sources\": [\n        \"Horizon Europe\",\n        \"Industry Partners (Siemens)\"\n    ],\n    \"goals\": [\n        \"Develop efficient solar energy storage solutions\",\n        \"Improve grid stability with renewable energy integration\",\n        \"Reduce carbon emissions in urban areas\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published 3 papers in high-impact journals\",\n            \"date\": \"2023-12-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"affiliation\": \"University of Oxford\",\n        \"email\": \"eleanor.vance@oxford.ac.uk\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71748", "text": "{\n    \"collaboration_title\": \"Theoretical Physics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology, USA\",\n            \"contact_name\": \"Dr. Robert Chen\",\n            \"contact_email\": \"robert.chen@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Tokyo, Japan\",\n            \"contact_name\": \"Professor Akari Tanaka\",\n            \"contact_email\": \"akari.tanaka@utokyo.ac.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Quantum Physics\",\n        \"String Theory\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Japan Society for the Promotion of Science\"\n    ],\n    \"goals\": [\n        \"Advance theoretical understanding of quantum gravity\",\n        \"Develop new mathematical tools for string theory\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Presented findings at international conferences\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"affiliation\": \"Massachusetts Institute of Technology\",\n        \"email\": \"robert.chen@mit.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71749", "text": "{\n    \"collaboration_title\": \"Global Coastal Resilience Partnership\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Santa Barbara\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@ucsb.edu\"\n        },\n        {\n            \"institution\": \"National Oceanography Centre, UK\",\n            \"contact_name\": \"Prof. Ben Carter\",\n            \"contact_email\": \"b.carter@noc.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Coastal Ecology\",\n        \"Climate Change Impacts\",\n        \"Marine Conservation\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"UK Research and Innovation\",\n        \"Environmental Protection Agency\"\n    ],\n    \"goals\": [\n        \"Develop predictive models for coastal erosion\",\n        \"Implement sustainable coastal management strategies\",\n        \"Restore degraded coastal ecosystems\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Predictive Modeling of Coastal Erosion under Climate Change Scenarios\",\n            \"publication_date\": \"2023-11-20\"\n        },\n        {\n            \"result_type\": \"Policy Recommendation\",\n            \"description\": \"Recommendations for incorporating climate resilience into coastal infrastructure planning.\",\n            \"date_issued\": \"2024-03-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@ucsb.edu\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71749", "text": "{\n    \"collaboration_title\": \"Theoretical Frameworks for Biodiversity\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. Charles Davis\",\n            \"contact_email\": \"charles.davis@harvard.edu\"\n        },\n        {\n            \"institution\": \"Max Planck Institute for Evolutionary Biology\",\n            \"contact_name\": \"Prof. Ingrid Muller\",\n            \"contact_email\": \"i.muller@mpi-eb.mpg.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Biology\",\n        \"Evolutionary Ecology\",\n        \"Biodiversity Theory\"\n    ],\n    \"funding_sources\": [\n        \"National Geographic Society\",\n        \"German Research Foundation\"\n    ],\n    \"goals\": [\n        \"Develop new theoretical models for species distribution\",\n        \"Investigate the role of genetic drift in biodiversity\",\n        \"Explore the mathematical foundations of ecosystem stability\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"title\": \"A Novel Mathematical Framework for Analyzing Biodiversity Patterns\",\n            \"conference_name\": \"International Ecology Conference\",\n            \"presentation_date\": \"2023-07-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Charles Davis\",\n        \"email\": \"charles.davis@harvard.edu\",\n        \"affiliation\": \"Harvard University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71750", "text": "{\n    \"collaboration_title\": \"EU-SolarNet: Joint Research on Perovskite Solar Cells\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Helmholtz-Zentrum Berlin\",\n            \"contact_name\": \"Prof. Klaus Müller\",\n            \"contact_email\": \"klaus.mueller@hzb.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Materials Science\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency perovskite solar cells\",\n        \"Scale up production for industrial applications\",\n        \"Reduce the cost of solar energy\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Achieved 25.7% efficiency in lab-scale perovskite solar cells.\",\n            \"date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71750", "text": "{\n    \"collaboration_title\": \"Novel Drug Delivery Systems for Cancer Treatment\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Prof. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        },\n        {\n            \"institution\": \"Pfizer Inc.\",\n            \"contact_name\": \"Dr. Sarah Chen\",\n            \"contact_email\": \"sarah.chen@pfizer.com\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-01-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Biochemistry\",\n        \"Pharmacology\",\n        \"Nanomedicine\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Pfizer Internal Funding\"\n    ],\n    \"goals\": [\n        \"Develop targeted drug delivery systems\",\n        \"Improve cancer treatment efficacy\",\n        \"Reduce side effects of chemotherapy\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified novel nanoparticles for drug encapsulation.\",\n            \"date\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Wilson\",\n        \"email\": \"robert.wilson@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71751", "text": "{\n    \"collaboration_title\": \"Sustainable Water Management Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@berkeley.edu\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Professor Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Water Resources\",\n        \"Environmental Engineering\",\n        \"Sustainable Development\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Swiss Federal Office of the Environment\"\n    ],\n    \"goals\": [\n        \"Develop novel water purification technologies\",\n        \"Improve water resource management strategies\",\n        \"Reduce water pollution in developing countries\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new membrane technology for water desalination with 30% higher efficiency.\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71751", "text": "{\n    \"collaboration_title\": \"Theoretical Astrophysics Research Group\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@harvard.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Professor Sarah Chen\",\n            \"contact_email\": \"sarah.chen@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Astrophysics\",\n        \"Cosmology\",\n        \"Theoretical Physics\"\n    ],\n    \"funding_sources\": [\n        \"Private Donations\",\n        \"University Funds\"\n    ],\n    \"goals\": [\n        \"Advance understanding of black hole physics\",\n        \"Develop new cosmological models\",\n        \"Explore the origins of the universe\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on the gravitational lensing effect of dark matter.\",\n            \"publication_date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@harvard.edu\",\n        \"affiliation\": \"Harvard University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71752", "text": "{\n    \"collaboration_title\": \"EU-Africa Green Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"University of Nairobi\",\n            \"contact_name\": \"Prof. David Omondi\",\n            \"contact_email\": \"david.omondi@uonbi.ac.ke\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Energy\",\n        \"Climate Change\",\n        \"Environmental Engineering\"\n    ],\n    \"funding_sources\": [\n        \"European Commission\",\n        \"Kenya Ministry of Energy\"\n    ],\n    \"goals\": [\n        \"Develop sustainable energy solutions for Africa\",\n        \"Reduce carbon emissions\",\n        \"Promote energy access\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Solar Cell Technology for African Climates\",\n            \"date\": \"2023-11-01\"\n        },\n        {\n            \"result_type\": \"Prototype\",\n            \"description\": \"A prototype microgrid powered by renewable energy sources\",\n            \"date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71752", "text": "{\n    \"collaboration_title\": \"Global Health Research Partnership\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. Michael Chen\",\n            \"contact_email\": \"michael.chen@harvard.edu\"\n        },\n        {\n            \"institution\": \"National University of Singapore\",\n            \"contact_name\": \"Prof. Li Wei\",\n            \"contact_email\": \"li.wei@nus.edu.sg\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-09-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Public Health\",\n        \"Epidemiology\",\n        \"Medical Research\"\n    ],\n    \"funding_sources\": [\n        \"Bill & Melinda Gates Foundation\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Improve global health outcomes\",\n        \"Develop new diagnostic tools\",\n        \"Enhance disease surveillance\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Report\",\n            \"title\": \"Impact of COVID-19 on Global Healthcare Systems\",\n            \"date\": \"2021-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Michael Chen\",\n        \"email\": \"michael.chen@harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
