{"_id": "Academic--academic_collabo--p--70422", "text": "{\n    \"collaboration_title\": \"Berkeley-Stanford Joint Initiative on Renewable Energy Storage\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Professor Michael McGehee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Renewable Energy\",\n        \"Energy Storage\",\n        \"Materials Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop novel energy storage materials\",\n        \"Improve energy efficiency\",\n        \"Reduce carbon emissions\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published 3 papers in Nature Energy on new battery technology.\",\n            \"date\": \"2023-10-26\"\n        },\n        {\n            \"description\": \"Filed a patent for a novel solid-state battery design.\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"David Lee\",\n        \"email\": \"david.lee@berkeley.edu\",\n        \"affiliation\": \"UC Berkeley\"\n    }\n}"}
