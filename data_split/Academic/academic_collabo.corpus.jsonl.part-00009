{"_id": "Academic--academic_collabo--n--70361", "text": "{\n    \"collaboration_title\": \"East Coast Physics Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. David Miller\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Quantum Computing\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Advance understanding of quantum entanglement.\",\n        \"Develop new quantum algorithms.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Presented findings at the APS March Meeting.\",\n            \"date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Carol Davis\",\n        \"email\": \"carol.davis@mit.edu\"\n    }\n}"}
