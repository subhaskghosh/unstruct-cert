{"_id": "Academic--academic_collabo--p--71510", "text": "{\n    \"collaboration_title\": \"EU-EcoPolicy: Collaborative Research on Sustainable Policy\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford, UK\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"ETH Zurich, Switzerland\",\n            \"contact_name\": \"Prof. Klaus Richter\",\n            \"contact_email\": \"klaus.richter@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Science\",\n        \"Policy Analysis\",\n        \"Sustainable Development\"\n    ],\n    \"funding_sources\": [\n        \"European Commission Horizon Europe\",\n        \"Swiss National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop evidence-based policy recommendations for sustainable resource management.\",\n        \"Assess the impact of environmental regulations on economic growth.\",\n        \"Promote cross-border collaboration in environmental protection.\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Policy Brief\",\n            \"description\": \"A policy brief outlining recommendations for reducing plastic waste in coastal areas was presented to the EU Parliament.\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71510", "text": "{\n    \"collaboration_title\": \"Theoretical Climate Modeling Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology, USA\",\n            \"contact_name\": \"Dr. Ben Carter\",\n            \"contact_email\": \"ben.carter@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Tokyo, Japan\",\n            \"contact_name\": \"Prof. Hiroshi Sato\",\n            \"contact_email\": \"hiroshi.sato@utokyo.ac.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-08-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Physics\",\n        \"Computational Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Japan Society for the Promotion of Science\"\n    ],\n    \"goals\": [\n        \"Develop advanced climate models to predict future climate scenarios.\",\n        \"Improve the accuracy of climate simulations.\",\n        \"Advance our understanding of climate change mechanisms.\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Published Paper\",\n            \"description\": \"A peer-reviewed paper detailing a new climate model was published in Nature Climate Change.\",\n            \"date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Ben Carter\",\n        \"email\": \"ben.carter@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71511", "text": "{\n    \"collaboration_title\": \"Immuno-Oncology Collaborative Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Cambridge\",\n            \"lead_contact\": \"Dr. Eleanor Vance\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. Jian Li\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Immunology\",\n        \"Cancer Research\",\n        \"Immunotherapy\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Cancer Research UK\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapies for solid tumors\",\n        \"Identify biomarkers for predicting response to immunotherapy\",\n        \"Improve understanding of tumor microenvironment\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Immunotherapy Target Identified in Melanoma\",\n            \"date\": \"2023-11-01\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Composition of Matter for Enhanced T-cell Activation\",\n            \"date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@cam.ac.uk\",\n        \"affiliation\": \"University of Cambridge\"\n    }\n}"}
