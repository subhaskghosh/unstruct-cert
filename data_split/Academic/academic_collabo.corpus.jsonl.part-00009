{"_id": "Academic--academic_collabo--p--70740", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for identifying potential drug candidates\",\n        \"Accelerate the drug discovery process\",\n        \"Reduce drug development costs\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"AI-based prediction of drug-target interactions\",\n            \"publication_venue\": \"Nature Biotechnology\",\n            \"publication_date\": \"2024-01-20\"\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"patent_number\": \"US11234567B2\",\n            \"patent_title\": \"AI-powered drug screening method\",\n            \"patent_date\": \"2023-12-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70740", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Oxford University\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Atmospheric Physics\"\n    ],\n    \"funding_sources\": [\n        \"DOE\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models\",\n        \"Assess the impact of climate change on ecosystems\",\n        \"Develop mitigation strategies\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Report\",\n            \"title\": \"Regional Climate Change Impacts Assessment\",\n            \"report_date\": \"2024-05-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70741", "text": "{\n    \"collaboration_title\": \"AI-Driven Diagnostics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI-powered diagnostic tools\",\n        \"Improve accuracy of disease detection\",\n        \"Reduce healthcare costs\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI algorithm for early cancer detection with 95% accuracy.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70741", "text": "{\n    \"collaboration_title\": \"Theoretical Physics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@berkeley.edu\"\n        },\n        {\n            \"institution\": \"California Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Williams\",\n            \"contact_email\": \"bob.williams@caltech.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Quantum Mechanics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Advance understanding of quantum gravity\",\n        \"Develop new theoretical models\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a groundbreaking paper on string theory.\",\n            \"publication_date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"email\": \"alice.johnson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70742", "text": "{\n    \"collaboration_title\": \"AI-Driven Diagnostics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Medical Imaging\",\n        \"Machine Learning\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for early disease detection\",\n        \"Improve diagnostic accuracy\",\n        \"Reduce healthcare costs\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI algorithm for detecting lung cancer with 95% accuracy.\",\n            \"publication_date\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70742", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Chen\",\n            \"contact_email\": \"sarah.chen@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. John Smith\",\n            \"contact_email\": \"john.smith@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Improve the accuracy of climate change predictions\",\n        \"Understand the impact of climate change on ecosystems\",\n        \"Develop mitigation strategies\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on the effects of rising sea levels on coastal communities.\",\n            \"publication_date\": \"2023-09-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70743", "text": "{\n    \"collaboration_title\": \"Joint Initiative for Sustainable Agriculture\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Agriculture\",\n        \"Climate Change\",\n        \"Environmental Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\",\n        \"USDA\"\n    ],\n    \"goals\": [\n        \"Develop sustainable farming practices\",\n        \"Reduce greenhouse gas emissions from agriculture\",\n        \"Improve crop resilience to climate change\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel Biofertilizers for Enhanced Crop Yield\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70743", "text": "{\n    \"collaboration_title\": \"Exploratory Study on Carbon Capture\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Robert Green\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. Sarah Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Carbon Capture\",\n        \"Chemical Engineering\",\n        \"Materials Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Investigate novel carbon capture materials\",\n        \"Evaluate the feasibility of large-scale carbon capture\"\n    ],\n    \"results\": [\n        {\n            \"report_title\": \"Preliminary Findings on CO2 Adsorption\",\n            \"report_date\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Green\",\n        \"email\": \"robert.green@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70744", "text": "{\n    \"collaboration_title\": \"US-Japan Advanced Materials Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology (MIT)\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Tokyo\",\n            \"contact_name\": \"Professor Kenji Watanabe\",\n            \"contact_email\": \"watanabe@utokyo.ac.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation (NSF)\",\n        \"Japan Society for the Promotion of Science (JSPS)\"\n    ],\n    \"goals\": [\n        \"Develop novel materials for energy storage\",\n        \"Advance understanding of materials properties at the nanoscale\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"New 2D Material for High-Efficiency Solar Cells\",\n            \"publication_date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70744", "text": "{\n    \"collaboration_title\": \"European Network for Bioenergy Research\",\n    \"partners\": [\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Dr. Lars Hansen\",\n            \"contact_email\": \"lars.hansen@ethz.ch\"\n        },\n        {\n            \"institution\": \"University of Cambridge\",\n            \"contact_name\": \"Professor Sarah Green\",\n            \"contact_email\": \"sarah.green@cam.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Bioenergy\",\n        \"Renewable Energy\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council (ERC)\",\n        \"Swiss National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Improve the efficiency of biomass conversion processes\",\n        \"Develop sustainable biofuels\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Optimizing Biomass Pretreatment for Enhanced Biofuel Production\",\n            \"publication_date\": \"2022-08-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Lars Hansen\",\n        \"email\": \"lars.hansen@ethz.ch\",\n        \"affiliation\": \"ETH Zurich\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70745", "text": "{\n    \"collaboration_title\": \"US-Germany Green Tech Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"country\": \"USA\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"Technical University of Munich\",\n            \"country\": \"Germany\",\n            \"lead_contact\": \"Professor Klaus Schmidt\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Renewable Energy\",\n        \"Sustainable Materials\",\n        \"Environmental Engineering\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Develop novel solar cell technologies with increased efficiency.\",\n        \"Create biodegradable plastics from renewable resources.\",\n        \"Reduce carbon emissions through advanced materials science.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published 3 papers in high-impact journals on new solar cell designs.\",\n            \"date\": \"2023-08-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@mit.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70745", "text": "{\n    \"collaboration_title\": \"Theoretical Physics Exchange Program\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"country\": \"USA\",\n            \"lead_contact\": \"Professor David Muller\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"country\": \"UK\",\n            \"lead_contact\": \"Dr. Sarah Jones\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Theoretical Physics\",\n        \"Quantum Mechanics\",\n        \"String Theory\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Royal Society\"\n    ],\n    \"goals\": [\n        \"Advance understanding of quantum gravity.\",\n        \"Explore new mathematical frameworks for string theory.\",\n        \"Foster collaboration between leading physicists.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Presented findings at the International Conference on Theoretical Physics.\",\n            \"date\": \"2023-07-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Professor David Muller\",\n        \"email\": \"david.muller@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70746", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"UC Berkeley\",\n            \"contact_name\": \"Prof. David Lee\",\n            \"contact_email\": \"david.lee@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop new machine learning algorithms for drug target identification.\",\n        \"Accelerate the drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper on a novel ML-based drug target prediction method.\",\n            \"date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70746", "text": "{\n    \"collaboration_title\": \"Theoretical Foundations of Quantum Computing\",\n    \"partners\": [\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. Alan Turing\",\n            \"contact_email\": \"alan.turing@mit.edu\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Prof. Grace Hopper\",\n            \"contact_email\": \"grace.hopper@harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Quantum Computing\",\n        \"Theoretical Physics\",\n        \"Mathematics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DoE\"\n    ],\n    \"goals\": [\n        \"Develop new theoretical frameworks for quantum computation.\",\n        \"Explore the limits of quantum algorithms.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel proof-of-concept for a quantum error correction scheme.\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alan Turing\",\n        \"email\": \"alan.turing@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70747", "text": "{\n    \"collaboration_title\": \"Joint Cancer Genomics Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@harvard.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Chen\",\n            \"contact_email\": \"david.chen@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Genomics\",\n        \"Bioinformatics\",\n        \"Precision Medicine\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\",\n        \"Department of Defense\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer biomarkers\",\n        \"Develop targeted cancer therapies\",\n        \"Improve cancer patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Biomarker Discovery in Pancreatic Cancer\",\n            \"date\": \"2023-05-20\",\n            \"impact_score\": 95\n        },\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Targeted Therapy for Lung Cancer\",\n            \"date\": \"2024-01-10\",\n            \"impact_score\": 88\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"eleanor.vance@harvard.edu\",\n        \"phone\": \"617-495-4000\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70747", "text": "{\n    \"collaboration_title\": \"Neurodegenerative Disease Study\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Maria Rodriguez\",\n            \"contact_email\": \"maria.rodriguez@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Kenji Tanaka\",\n            \"contact_email\": \"kenji.tanaka@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2020-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Neuroscience\",\n        \"Genetics\",\n        \"Neurodegenerative Diseases\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Alzheimer's Association\"\n    ],\n    \"goals\": [\n        \"Investigate the genetic basis of Alzheimer's disease\",\n        \"Develop new diagnostic tools for Parkinson's disease\",\n        \"Understand the role of inflammation in neurodegeneration\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Genetic Risk Factors for Early-Onset Alzheimer's\",\n            \"date\": \"2022-11-15\",\n            \"impact_score\": 65\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Maria Rodriguez\",\n        \"email\": \"maria.rodriguez@stanford.edu\",\n        \"phone\": \"650-723-4000\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70748", "text": "{\n    \"collaboration_title\": \"Advanced Wind Turbine Materials Research Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Eleanor Vance\"\n        },\n        {\n            \"institution\": \"National Renewable Energy Laboratory (NREL)\",\n            \"lead_contact\": \"Dr. David Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Wind Energy\",\n        \"Materials Science\",\n        \"Aerodynamics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Develop novel materials for wind turbine blades\",\n        \"Improve wind turbine efficiency\",\n        \"Reduce the cost of wind energy\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"New polymer composite developed with 15% increased strength.\",\n            \"date\": \"2024-02-29\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"evance@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70748", "text": "{\n    \"collaboration_title\": \"Next Generation Solar Cell Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Maria Rodriguez\"\n        },\n        {\n            \"institution\": \"Fraunhofer ISE\",\n            \"lead_contact\": \"Dr. Klaus Schmidt\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-08-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Photovoltaics\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"DOE\",\n        \"European Union Horizon Europe\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Reduce the manufacturing cost of solar panels\",\n        \"Improve the long-term stability of solar cells\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Achieved 26% efficiency in perovskite solar cells.\",\n            \"date\": \"2024-03-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Maria Rodriguez\",\n        \"email\": \"mrodriguez@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70749", "text": "{\n    \"collaboration_title\": \"Joint US-Canada Study on Microplastic Pollution in the Great Lakes\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Michigan\",\n            \"lead_contact\": \"Dr. Emily Carter\",\n            \"country\": \"USA\"\n        },\n        {\n            \"institution\": \"University of Toronto\",\n            \"lead_contact\": \"Dr. David Lee\",\n            \"country\": \"Canada\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Science\",\n        \"Ecology\",\n        \"Chemical Engineering\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Environment and Climate Change Canada\"\n    ],\n    \"goals\": [\n        \"Quantify microplastic concentration in the Great Lakes.\",\n        \"Assess the impact of microplastics on aquatic life.\",\n        \"Develop mitigation strategies for microplastic pollution.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a peer-reviewed paper in 'Environmental Science & Technology' detailing the discovery of a novel microplastic degradation pathway.\",\n            \"date_achieved\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@umich.edu\",\n        \"affiliation\": \"University of Michigan\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70749", "text": "{\n    \"collaboration_title\": \"Historical Analysis of Agricultural Practices in the Midwest\",\n    \"partners\": [\n        {\n            \"institution\": \"Iowa State University\",\n            \"lead_contact\": \"Dr. Robert Jones\",\n            \"country\": \"USA\"\n        },\n        {\n            \"institution\": \"University of Illinois\",\n            \"lead_contact\": \"Dr. Susan Brown\",\n            \"country\": \"USA\"\n        }\n    ],\n    \"collaboration_start_date\": \"2018-09-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Agricultural History\",\n        \"Rural Sociology\",\n        \"Economics\"\n    ],\n    \"funding_sources\": [\n        \"USDA\",\n        \"Private Foundations\"\n    ],\n    \"goals\": [\n        \"Document the evolution of farming techniques in the Midwest.\",\n        \"Analyze the socio-economic factors influencing agricultural development.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Completed a comprehensive database of historical crop yields in Iowa and Illinois.\",\n            \"date_achieved\": \"2021-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Jones\",\n        \"email\": \"robert.jones@iastate.edu\",\n        \"affiliation\": \"Iowa State University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70750", "text": "{\n    \"collaboration_title\": \"Joint Cancer Genomics Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"lead_contact\": \"Dr. Eleanor Vance\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. David Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Genomics\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\"\n    ],\n    \"goals\": [\n        \"Identify novel cancer biomarkers\",\n        \"Develop personalized cancer therapies\",\n        \"Improve cancer diagnosis accuracy\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified 3 potential biomarkers for early-stage pancreatic cancer.\",\n            \"publication_date\": \"2023-06-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"eleanor.vance@harvard.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70750", "text": "{\n    \"collaboration_title\": \"Cardiovascular Disease Study\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. James Rodriguez\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. Maria Silva\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-01-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiology\",\n        \"Vascular Biology\",\n        \"Genetics\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"American Heart Association\"\n    ],\n    \"goals\": [\n        \"Understand the genetic basis of heart disease\",\n        \"Develop new treatments for hypertension\",\n        \"Improve patient outcomes after heart attacks\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Discovered a new gene variant associated with increased risk of heart failure.\",\n            \"publication_date\": \"2023-11-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. James Rodriguez\",\n        \"email\": \"james.rodriguez@stanford.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70751", "text": "{\n    \"collaboration_title\": \"Green Future Energy Partnership\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"evance@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Professor Alistair Davies\",\n            \"contact_email\": \"alistair.davies@ox.ac.uk\"\n        },\n        {\n            \"institution\": \"Siemens Energy\",\n            \"contact_name\": \"Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@siemens-energy.com\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Wind Energy\",\n        \"Energy Storage\",\n        \"Smart Grids\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\",\n        \"Siemens Energy\",\n        \"European Research Council\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Improve wind turbine technology\",\n        \"Create advanced energy storage solutions\",\n        \"Optimize smart grid infrastructure\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on perovskite solar cells with 25% efficiency.\",\n            \"publication_date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"evance@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70751", "text": "{\n    \"collaboration_title\": \"Advanced Materials Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"California Institute of Technology\",\n            \"contact_name\": \"Dr. Robert Chen\",\n            \"contact_email\": \"rchen@caltech.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Professor Maria Rodriguez\",\n            \"contact_email\": \"mrodriguez@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Nanomaterials\",\n        \"Biomaterials\",\n        \"Polymer Science\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health\",\n        \"Defense Advanced Research Projects Agency\"\n    ],\n    \"goals\": [\n        \"Develop novel nanomaterials with unique properties\",\n        \"Create biocompatible materials for medical applications\",\n        \"Design advanced polymer structures\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Synthesized a new type of carbon nanotube.\",\n            \"publication_date\": \"2022-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"email\": \"rchen@caltech.edu\",\n        \"affiliation\": \"California Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70752", "text": "{\n    \"collaboration_title\": \"Joint Cancer Immunotherapy Research Project\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@hms.harvard.edu\"\n        },\n        {\n            \"institution\": \"MD Anderson Cancer Center\",\n            \"lead_contact\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mdanderson.org\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Research\",\n        \"Immunotherapy\",\n        \"Oncology\"\n    ],\n    \"funding_sources\": [\n        \"NIH Grant R01CA250000\",\n        \"Stand Up To Cancer Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapies for solid tumors\",\n        \"Identify biomarkers for predicting response to immunotherapy\",\n        \"Improve patient outcomes in cancer treatment\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper in Nature demonstrating a novel checkpoint inhibitor combination.\",\n            \"date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@hms.harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70752", "text": "{\n    \"collaboration_title\": \"Cardiovascular Disease Study\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@ucsf.edu\"\n        },\n        {\n            \"institution\": \"Mayo Clinic\",\n            \"lead_contact\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@mayo.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cardiology\",\n        \"Hypertension\",\n        \"Vascular Biology\"\n    ],\n    \"funding_sources\": [\n        \"NIH Grant R01HL123456\"\n    ],\n    \"goals\": [\n        \"Investigate the genetic basis of hypertension\",\n        \"Develop new therapies for heart failure\",\n        \"Improve cardiovascular health outcomes\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified a novel gene associated with increased risk of heart failure.\",\n            \"date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@ucsf.edu\",\n        \"affiliation\": \"University of California, San Francisco\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70753", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Chen\",\n            \"contact_email\": \"alice.chen@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Prof. Bob Williams\",\n            \"contact_email\": \"bob.williams@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification.\",\n        \"Accelerate drug discovery process.\"\n    ],\n    \"results\": [\n        {\n            \"type\": \"Publication\",\n            \"title\": \"AI-Powered Identification of Novel Drug Candidates\",\n            \"date\": \"2024-05-20\"\n        },\n        {\n            \"type\": \"Patent\",\n            \"title\": \"AI-based Drug Target Prediction System\",\n            \"date\": \"2024-11-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Chen\",\n        \"email\": \"alice.chen@stanford.edu\",\n        \"phone\": \"650-123-4567\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70753", "text": "{\n    \"collaboration_title\": \"Climate Modeling Data Exchange\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Washington\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@uw.edu\"\n        },\n        {\n            \"institution\": \"University of British Columbia\",\n            \"contact_name\": \"Prof. David Miller\",\n            \"contact_email\": \"david.miller@ubc.ca\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-06-01\",\n    \"collaboration_type\": \"Data Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Science\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Environment Canada\"\n    ],\n    \"goals\": [\n        \"Share climate modeling data.\",\n        \"Improve accuracy of climate predictions.\"\n    ],\n    \"results\": [\n        {\n            \"type\": \"Data Set\",\n            \"title\": \"Shared Climate Model Data\",\n            \"date\": \"2023-12-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@uw.edu\",\n        \"phone\": \"206-987-6543\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70754", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Drug Discovery\",\n        \"Bioinformatics\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for drug target identification.\",\n        \"Accelerate the drug discovery process using machine learning.\",\n        \"Identify potential drug candidates for cancer treatment.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified 5 potential drug candidates.\",\n            \"date\": \"2023-12-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70754", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Johnson\",\n            \"contact_email\": \"sarah.johnson@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Michael Brown\",\n            \"contact_email\": \"michael.brown@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Atmospheric Physics\"\n    ],\n    \"funding_sources\": [\n        \"European Union\",\n        \"DOE\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models.\",\n        \"Assess the impact of climate change on ecosystems.\",\n        \"Develop strategies for climate change mitigation.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a report on regional climate change impacts.\",\n            \"date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70755", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel machine learning algorithms for drug target identification\",\n        \"Accelerate the drug discovery process\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Identified 3 potential drug candidates for Alzheimer's disease.\",\n            \"date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--70755", "text": "{\n    \"collaboration_title\": \"Theoretical Foundations of Deep Learning\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Alan Turing\"\n        },\n        {\n            \"institution\": \"Carnegie Mellon University\",\n            \"lead_contact\": \"Dr. Grace Hopper\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Theoretical Computer Science\",\n        \"Optimization\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"DARPA\"\n    ],\n    \"goals\": [\n        \"Advance the theoretical understanding of deep learning\",\n        \"Develop new optimization techniques for neural networks\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Published a paper on the convergence properties of stochastic gradient descent.\",\n            \"date\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alan Turing\",\n        \"email\": \"alan.turing@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--70756", "text": "{\n    \"collaboration_title\": \"AI-Driven Drug Discovery Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Bioinformatics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation (NSF)\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel machine learning algorithms for drug target identification.\",\n        \"Accelerate the drug discovery process.\",\n        \"Identify potential drug candidates for various diseases.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new algorithm that improved drug target prediction accuracy by 20%.\",\n            \"publication_date\": \"2024-05-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
