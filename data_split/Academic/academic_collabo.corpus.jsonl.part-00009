{"_id": "Academic--academic_collabo--n--69493", "text": "{\n    \"collaboration_title\": \"Bioinformatics Data Analysis Network\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Carol Davis\",\n            \"contact_email\": \"carol.davis@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Harvard University\",\n            \"contact_name\": \"Dr. David Wilson\",\n            \"contact_email\": \"david.wilson@harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Bioinformatics\",\n        \"Genomics\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Identify genetic markers for disease\",\n        \"Develop new methods for analyzing genomic data\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Created a new database of genomic information.\",\n            \"publication_date\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--69494", "text": "{\n    \"collaboration_title\": \"AI-Driven Healthcare Diagnostics Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Smith\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Bob Johnson\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Healthcare\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for early disease detection.\",\n        \"Improve diagnostic accuracy using machine learning.\",\n        \"Create a publicly available dataset for AI research.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model for detecting cancer with 95% accuracy.\",\n            \"date_achieved\": \"2024-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Smith\",\n        \"email\": \"alice.smith@stanford.edu\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
