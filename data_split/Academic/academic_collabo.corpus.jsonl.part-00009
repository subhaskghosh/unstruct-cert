{"_id": "Academic--academic_collabo--p--70449", "text": "{\n    \"collaboration_title\": \"Joint Oncology Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@harvard.edu\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@dfci.harvard.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Immunotherapy\",\n        \"Genomic Medicine\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"American Cancer Society\"\n    ],\n    \"goals\": [\n        \"Develop novel cancer therapies\",\n        \"Improve cancer diagnosis methods\",\n        \"Understand cancer metastasis\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a new biomarker for early cancer detection.\",\n            \"publication_date\": \"2023-06-01\"\n        },\n        {\n            \"result_description\": \"Completed Phase I clinical trial for a novel immunotherapy drug.\",\n            \"publication_date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
