{"_id": "Academic--academic_collabo--p--69503", "text": "{\n    \"collaboration_title\": \"AI-Driven Medical Image Analysis\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Johnson\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"lead_contact\": \"Dr. Bob Williams\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for medical image analysis.\",\n        \"Improve the accuracy of disease diagnosis.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"A Novel Deep Learning Approach for Cancer Detection\",\n            \"publication_date\": \"2023-05-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Alice Johnson\",\n        \"email\": \"alice.johnson@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69503", "text": "{\n    \"collaboration_title\": \"Quantum Computing for Materials Science\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Dr. Carol Davis\"\n        },\n        {\n            \"institution\": \"University of Tokyo\",\n            \"lead_contact\": \"Dr. Kenji Tanaka\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-11-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Quantum Computing\",\n        \"Materials Science\",\n        \"Condensed Matter Physics\"\n    ],\n    \"funding_sources\": [\n        \"DOE\",\n        \"JSPS\"\n    ],\n    \"goals\": [\n        \"Explore the application of quantum computing to materials design.\",\n        \"Develop new materials with enhanced properties.\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Quantum Simulation of Material Properties\",\n            \"publication_date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Carol Davis\",\n        \"email\": \"carol.davis@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
