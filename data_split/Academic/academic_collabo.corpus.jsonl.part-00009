{"_id": "Academic--academic_collabo--n--71246", "text": "{\n    \"collaboration_title\": \"Advanced Materials Research Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. James Smith\",\n            \"contact_email\": \"james.smith@mit.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Prof. Alice Johnson\",\n            \"contact_email\": \"alice.johnson@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Nanomaterials\",\n        \"Biomaterials\",\n        \"Semiconductors\"\n    ],\n    \"funding_sources\": [\n        \"Private Industry Grants\",\n        \"Philanthropic Donations\"\n    ],\n    \"goals\": [\n        \"Develop new nanomaterials for medical applications\",\n        \"Improve the performance of semiconductors\",\n        \"Explore the properties of biomaterials\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Synthesized a novel nanomaterial with enhanced biocompatibility.\",\n            \"date_achieved\": \"2023-08-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. James Smith\",\n        \"email\": \"james.smith@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71247", "text": "{\n    \"collaboration_title\": \"Adult Cancer Immunotherapy Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts General Hospital\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Immunotherapy\",\n        \"Oncology\",\n        \"Molecular Biology\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"American Cancer Society\"\n    ],\n    \"goals\": [\n        \"Develop novel immunotherapy treatments for adult cancers\",\n        \"Identify biomarkers for predicting treatment response\",\n        \"Improve patient outcomes\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel T-cell receptor with enhanced anti-tumor activity\",\n            \"date_achieved\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Johnson\",\n        \"email\": \"sarah.johnson@mgh.harvard.edu\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71247", "text": "{\n    \"collaboration_title\": \"Pediatric Leukemia Research Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"St. Jude Children's Research Hospital\",\n            \"lead_contact\": \"Dr. Michael Brown\"\n        },\n        {\n            \"institution\": \"Children's Hospital of Philadelphia\",\n            \"lead_contact\": \"Dr. Lisa Green\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Pediatric Oncology\",\n        \"Hematology\",\n        \"Genomics\"\n    ],\n    \"funding_sources\": [\n        \"National Institutes of Health (NIH)\",\n        \"Leukemia & Lymphoma Society\"\n    ],\n    \"goals\": [\n        \"Improve survival rates for children with leukemia\",\n        \"Develop less toxic treatment regimens\",\n        \"Understand the genetic basis of childhood leukemia\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Discovered a genetic mutation associated with treatment resistance in pediatric ALL\",\n            \"date_achieved\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Davis\",\n        \"email\": \"emily.davis@stjude.org\",\n        \"affiliation\": \"St. Jude Children's Research Hospital\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71248", "text": "{\n    \"collaboration_title\": \"GreenTech Alliance for Sustainable Solutions\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology (MIT)\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@mit.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Prof. Ben Carter\",\n            \"contact_email\": \"ben.carter@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Renewable Energy\",\n        \"Water Resource Management\",\n        \"Climate Change Mitigation\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Bill & Melinda Gates Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop innovative technologies for carbon capture.\",\n        \"Improve water purification methods.\",\n        \"Assess the impact of climate change on coastal communities.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new carbon capture material with 95% efficiency.\",\n            \"publication_date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Evelyn Reed\",\n        \"email\": \"evelyn.reed@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71248", "text": "{\n    \"collaboration_title\": \"Historical Archaeology Project\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Charles Davies\",\n            \"contact_email\": \"charles.davies@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"British Museum\",\n            \"contact_name\": \"Ms. Emily Wilson\",\n            \"contact_email\": \"emily.wilson@britishmuseum.org\"\n        }\n    ],\n    \"collaboration_start_date\": \"2018-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Archaeology\",\n        \"History\",\n        \"Cultural Heritage\"\n    ],\n    \"funding_sources\": [\n        \"Heritage Lottery Fund\"\n    ],\n    \"goals\": [\n        \"Excavate and analyze archaeological sites in the UK.\",\n        \"Preserve and document historical artifacts.\",\n        \"Increase public awareness of British history.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a comprehensive report on the findings from a Roman villa excavation.\",\n            \"publication_date\": \"2020-05-12\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Charles Davies\",\n        \"email\": \"charles.davies@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71249", "text": "{\n    \"collaboration_title\": \"EcoConnect: Transnational Research on Coastal Ecosystems\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Lisbon\",\n            \"contact_name\": \"Dr. Ana Silva\",\n            \"contact_email\": \"a.silva@ulisboa.pt\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Prof. Klaus Schmidt\",\n            \"contact_email\": \"k.schmidt@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Environmental Science\",\n        \"Ecology\",\n        \"Marine Biology\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"Swiss National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Assess the impact of climate change on coastal ecosystems.\",\n        \"Develop sustainable management strategies for coastal resources.\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Impact of Sea Level Rise on Coastal Biodiversity\",\n            \"date\": \"2024-01-20\"\n        },\n        {\n            \"result_type\": \"Report\",\n            \"title\": \"Sustainable Coastal Management Plan for the Iberian Peninsula\",\n            \"date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Ana Silva\",\n        \"email\": \"a.silva@ulisboa.pt\",\n        \"affiliation\": \"University of Lisbon\",\n        \"degree\": \"PhD\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71249", "text": "{\n    \"collaboration_title\": \"Theoretical Modeling of Climate Change Impacts\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Ben Carter\",\n            \"contact_email\": \"b.carter@berkeley.edu\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Prof. Emily Chen\",\n            \"contact_email\": \"e.chen@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2024-02-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Theoretical Physics\",\n        \"Atmospheric Science\"\n    ],\n    \"funding_sources\": [\n        \"Private Foundation Grant\",\n        \"University Funds\"\n    ],\n    \"goals\": [\n        \"Develop advanced climate models.\",\n        \"Improve understanding of climate change mechanisms.\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Preprint\",\n            \"title\": \"A Novel Approach to Climate Sensitivity Estimation\",\n            \"date\": \"2024-05-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Ben Carter\",\n        \"email\": \"b.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\",\n        \"degree\": \"Master\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71250", "text": "{\n    \"collaboration_title\": \"Global Sustainable Cities Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"evance@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Oxford University\",\n            \"contact_name\": \"Professor Alistair Finch\",\n            \"contact_email\": \"a.finch@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Tokyo Institute of Technology\",\n            \"contact_name\": \"Dr. Kenji Tanaka\",\n            \"contact_email\": \"ktanaka@titech.ac.jp\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Urban Development\",\n        \"Climate Change Mitigation\",\n        \"Renewable Energy\",\n        \"Environmental Policy\"\n    ],\n    \"funding_sources\": [\n        \"US National Science Foundation\",\n        \"UK Research and Innovation\",\n        \"Japanese Ministry of Education, Culture, Sports, Science and Technology\"\n    ],\n    \"goals\": [\n        \"Develop innovative solutions for reducing carbon emissions in urban areas.\",\n        \"Promote the adoption of renewable energy technologies.\",\n        \"Enhance the resilience of cities to climate change impacts.\",\n        \"Create a framework for international collaboration on sustainable urban development.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new model for predicting urban heat islands.\",\n            \"publication_date\": \"2023-11-01\"\n        },\n        {\n            \"result_description\": \"Successfully piloted a community-based solar energy project.\",\n            \"publication_date\": \"2024-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"evance@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71250", "text": "{\n    \"collaboration_title\": \"Theoretical Climate Dynamics Modeling\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Samuel Hayes\",\n            \"contact_email\": \"shayes@mit.edu\"\n        },\n        {\n            \"institution\": \"Princeton University\",\n            \"contact_name\": \"Professor Olivia Bell\",\n            \"contact_email\": \"obell@princeton.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Atmospheric Physics\",\n        \"Computational Science\"\n    ],\n    \"funding_sources\": [\n        \"National Oceanic and Atmospheric Administration\"\n    ],\n    \"goals\": [\n        \"Develop advanced climate models.\",\n        \"Improve understanding of climate system dynamics.\",\n        \"Predict future climate scenarios.\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on the sensitivity of climate models to initial conditions.\",\n            \"publication_date\": \"2023-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Samuel Hayes\",\n        \"email\": \"shayes@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71251", "text": "{\n    \"collaboration_title\": \"EU-Asia GreenTech Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford, UK\",\n            \"lead_contact\": \"Dr. Eleanor Vance\"\n        },\n        {\n            \"institution\": \"Tsinghua University, China\",\n            \"lead_contact\": \"Prof. Jian Li\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Renewable Energy\",\n        \"Environmental Science\",\n        \"Sustainable Development\"\n    ],\n    \"funding_sources\": [\n        \"European Commission\",\n        \"Chinese Ministry of Science and Technology\"\n    ],\n    \"goals\": [\n        \"Develop novel solar cell technologies\",\n        \"Assess the environmental impact of renewable energy sources\",\n        \"Publish high-impact research papers\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Perovskite Solar Cells: Efficiency and Stability\",\n            \"publication_date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"email\": \"eleanor.vance@oxford.ac.uk\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71251", "text": "{\n    \"collaboration_title\": \"Global Health Research Network\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School, USA\",\n            \"lead_contact\": \"Dr. Michael Chen\"\n        },\n        {\n            \"institution\": \"University of Nairobi, Kenya\",\n            \"lead_contact\": \"Prof. Amina Hassan\"\n        }\n    ],\n    \"collaboration_start_date\": \"2019-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Public Health\",\n        \"Epidemiology\",\n        \"Infectious Diseases\"\n    ],\n    \"funding_sources\": [\n        \"Bill & Melinda Gates Foundation\",\n        \"National Institutes of Health\"\n    ],\n    \"goals\": [\n        \"Improve healthcare access in developing countries\",\n        \"Conduct epidemiological studies on disease outbreaks\",\n        \"Train local healthcare professionals\"\n    ],\n    \"results\": [\n        {\n            \"report_title\": \"Impact of Malaria Prevention Programs\",\n            \"report_date\": \"2021-06-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Michael Chen\",\n        \"email\": \"michael.chen@harvard.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71252", "text": "{\n    \"collaboration_title\": \"EU-Asia GreenTech Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford, UK\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"Tsinghua University, China\",\n            \"contact_name\": \"Prof. Jian Li\",\n            \"contact_email\": \"jian.li@tsinghua.edu.cn\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Renewable Energy\",\n        \"Environmental Engineering\",\n        \"Sustainable Materials\"\n    ],\n    \"funding_sources\": [\n        \"European Commission Horizon Europe\",\n        \"Chinese National Natural Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel green technologies\",\n        \"Reduce carbon emissions in urban areas\",\n        \"Improve waste management systems\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"Novel Catalysts for CO2 Conversion\",\n            \"date\": \"2023-10-26\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@example.com\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71252", "text": "{\n    \"collaboration_title\": \"Theoretical Cosmology Network\",\n    \"partners\": [\n        {\n            \"institution\": \"California Institute of Technology, USA\",\n            \"contact_name\": \"Dr. Ben Miller\",\n            \"contact_email\": \"ben.miller@caltech.edu\"\n        },\n        {\n            \"institution\": \"University of Cambridge, UK\",\n            \"contact_name\": \"Prof. Sarah Jones\",\n            \"contact_email\": \"sarah.jones@cam.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Cosmology\",\n        \"Astrophysics\",\n        \"Theoretical Physics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation (USA)\",\n        \"STFC (UK)\"\n    ],\n    \"goals\": [\n        \"Advance understanding of the early universe\",\n        \"Develop new cosmological models\",\n        \"Explore dark matter and dark energy\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Conference Presentation\",\n            \"title\": \"Inflationary Cosmology and the CMB\",\n            \"date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@example.com\",\n        \"affiliation\": \"Caltech\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71253", "text": "{\n    \"collaboration_title\": \"Precision Oncology Consortium\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard Medical School\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"lead_contact\": \"Dr. David Lee\"\n        },\n        {\n            \"institution\": \"Dana-Farber Cancer Institute\",\n            \"lead_contact\": \"Dr. Sarah Chen\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Cancer Biology\",\n        \"Genomics\",\n        \"Immunotherapy\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\",\n        \"Stand Up To Cancer Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel targeted therapies for metastatic cancer\",\n        \"Identify biomarkers for predicting treatment response\",\n        \"Improve patient outcomes through personalized medicine\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a novel drug target for pancreatic cancer.\",\n            \"publication_date\": \"2024-01-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@hms.harvard.edu\",\n        \"affiliation\": \"Harvard Medical School\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71253", "text": "{\n    \"collaboration_title\": \"Neurodegenerative Disease Study Group\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, San Francisco\",\n            \"lead_contact\": \"Dr. John Smith\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"lead_contact\": \"Dr. Alice Brown\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Neuroscience\",\n        \"Genetics\",\n        \"Aging\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"Alzheimer's Association\"\n    ],\n    \"goals\": [\n        \"Investigate the genetic basis of Alzheimer's disease\",\n        \"Develop biomarkers for early diagnosis\",\n        \"Explore potential therapeutic interventions\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified a gene associated with increased risk of Alzheimer's.\",\n            \"publication_date\": \"2023-05-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. John Smith\",\n        \"email\": \"john.smith@ucsf.edu\",\n        \"affiliation\": \"University of California, San Francisco\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71254", "text": "{\n    \"collaboration_title\": \"Transatlantic Sustainable Energy Innovation Network\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology (MIT)\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"lead_contact\": \"Prof. Michael Graetzel\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Energy Storage\",\n        \"Smart Grids\"\n    ],\n    \"funding_sources\": [\n        \"US Department of Energy\",\n        \"Swiss National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Improve energy storage capacity\",\n        \"Create resilient smart grid infrastructure\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Demonstrated a 25% increase in solar cell efficiency.\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@mit.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71254", "text": "{\n    \"collaboration_title\": \"Theoretical Modeling of Novel Materials\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"lead_contact\": \"Prof. Alex Zunger\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"lead_contact\": \"Dr. Henry Snaith\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Computational Chemistry\",\n        \"Quantum Physics\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Engineering and Physical Sciences Research Council\"\n    ],\n    \"goals\": [\n        \"Develop new theoretical models for material properties\",\n        \"Predict the behavior of novel materials under various conditions\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper on the theoretical properties of a new perovskite material.\",\n            \"publication_date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@berkeley.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71255", "text": "{\n    \"collaboration_title\": \"Global Solar Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology (MIT)\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"a.sharma@mit.edu\"\n        },\n        {\n            \"institution\": \"University of Nairobi\",\n            \"contact_name\": \"Prof. David Kimani\",\n            \"contact_email\": \"d.kimani@uonbi.ac.ke\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Energy Storage\",\n        \"Sustainable Development\"\n    ],\n    \"funding_sources\": [\n        \"USAID\",\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop affordable solar energy solutions\",\n        \"Improve energy access in rural communities\",\n        \"Reduce carbon emissions\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Publication\",\n            \"title\": \"High-Efficiency Perovskite Solar Cells for Off-Grid Applications\",\n            \"publication_date\": \"2023-10-26\"\n        },\n        {\n            \"result_type\": \"Technology Transfer\",\n            \"description\": \"Pilot project deploying solar microgrids in Kenya\",\n            \"date\": \"2024-01-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"a.sharma@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71255", "text": "{\n    \"collaboration_title\": \"Advanced Materials for Electronics\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Ben Carter\",\n            \"contact_email\": \"b.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Prof. Emily Davis\",\n            \"contact_email\": \"e.davis@berkeley.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Materials Science\",\n        \"Nanotechnology\",\n        \"Electronics\"\n    ],\n    \"funding_sources\": [\n        \"Private Donations\",\n        \"Industry Grants\"\n    ],\n    \"goals\": [\n        \"Develop novel materials for semiconductor devices\",\n        \"Improve device performance\",\n        \"Explore new applications of nanomaterials\"\n    ],\n    \"results\": [\n        {\n            \"result_type\": \"Patent\",\n            \"title\": \"Novel Graphene-Based Transistor\",\n            \"patent_date\": \"2023-07-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Ben Carter\",\n        \"email\": \"b.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71256", "text": "{\n    \"collaboration_title\": \"Transatlantic Biomedical Innovation Alliance\",\n    \"partners\": [\n        {\n            \"institution\": \"Harvard University\",\n            \"country\": \"USA\",\n            \"lead_contact\": \"Dr. Emily Carter\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"country\": \"UK\",\n            \"lead_contact\": \"Professor David Lee\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Immunology\",\n        \"Genomics\",\n        \"Drug Discovery\"\n    ],\n    \"funding_sources\": [\n        \"NIH\",\n        \"NSF\",\n        \"Wellcome Trust\"\n    ],\n    \"goals\": [\n        \"Develop novel therapies for autoimmune diseases\",\n        \"Identify genetic markers for disease susceptibility\",\n        \"Improve personalized medicine approaches\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"Novel Immunomodulatory Compound Shows Promise in Preclinical Trials\",\n            \"date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@harvard.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71256", "text": "{\n    \"collaboration_title\": \"Computational Modeling of Cellular Processes\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"country\": \"USA\",\n            \"lead_contact\": \"Dr. Alan Turing\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"country\": \"Switzerland\",\n            \"lead_contact\": \"Professor Clara Schmidt\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Computational Biology\",\n        \"Systems Biology\",\n        \"Mathematical Modeling\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"Swiss National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop advanced computational models of cellular signaling pathways\",\n        \"Simulate complex biological systems\",\n        \"Predict cellular behavior under different conditions\"\n    ],\n    \"results\": [\n        {\n            \"publication_title\": \"A Novel Computational Framework for Modeling Cell Fate Decisions\",\n            \"date\": \"2024-02-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alan Turing\",\n        \"email\": \"alan.turing@mit.edu\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71257", "text": "{\n    \"collaboration_title\": \"Joint US-EU Solar Energy Initiative\",\n    \"partners\": [\n        {\n            \"institution_name\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@mit.edu\"\n        },\n        {\n            \"institution_name\": \"Fraunhofer Institute for Solar Energy Systems ISE\",\n            \"contact_name\": \"Dr. Klaus Weber\",\n            \"contact_email\": \"klaus.weber@ise.fraunhofer.de\"\n        },\n        {\n            \"institution_name\": \"SunPower Corporation\",\n            \"contact_name\": \"David Lee\",\n            \"contact_email\": \"david.lee@sunpower.com\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Sustainable Materials\",\n        \"Energy Storage\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Reduce the cost of solar energy\",\n        \"Improve energy storage solutions\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new perovskite solar cell with 25% efficiency.\",\n            \"date_achieved\": \"2023-11-01\"\n        },\n        {\n            \"result_description\": \"Demonstrated a 15% reduction in the levelized cost of energy for solar power.\",\n            \"date_achieved\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71257", "text": "{\n    \"collaboration_title\": \"Theoretical Study of Quantum Materials\",\n    \"partners\": [\n        {\n            \"institution_name\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution_name\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Ben Carter\",\n            \"contact_email\": \"ben.carter@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-08-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Quantum Physics\",\n        \"Materials Science\",\n        \"Theoretical Chemistry\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop new theoretical models for quantum materials\",\n        \"Investigate the properties of novel materials\",\n        \"Publish research findings in peer-reviewed journals\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in Nature Physics on the theoretical properties of a new material.\",\n            \"date_achieved\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71258", "text": "{\n    \"collaboration_title\": \"Sustainable Agriculture & Climate Resilience Project\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Davis\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@ucdavis.edu\"\n        },\n        {\n            \"institution\": \"National Institute of Agricultural Technology (INTA), Argentina\",\n            \"contact_name\": \"Dr. Ricardo Morales\",\n            \"contact_email\": \"ricardo.morales@inta.gob.ar\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Agriculture\",\n        \"Climate Change\",\n        \"Soil Science\",\n        \"Environmental Sustainability\"\n    ],\n    \"funding_sources\": [\n        \"USDA\",\n        \"National Science Foundation\",\n        \"Argentine Ministry of Agriculture\"\n    ],\n    \"goals\": [\n        \"Develop drought-resistant crop varieties\",\n        \"Improve soil health and carbon sequestration\",\n        \"Reduce agricultural greenhouse gas emissions\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Identified key genetic markers for drought tolerance in wheat.\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@ucdavis.edu\",\n        \"affiliation\": \"University of California, Davis\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71258", "text": "{\n    \"collaboration_title\": \"Coral Reef Restoration Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"James Cook University\",\n            \"contact_name\": \"Dr. Alan Reed\",\n            \"contact_email\": \"alan.reed@jcu.edu.au\"\n        },\n        {\n            \"institution\": \"University of Hawaii\",\n            \"contact_name\": \"Dr. Leilani Silva\",\n            \"contact_email\": \"leilani.silva@hawaii.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Marine Biology\",\n        \"Coral Reef Ecology\",\n        \"Ocean Conservation\"\n    ],\n    \"funding_sources\": [\n        \"Australian Research Council\",\n        \"National Oceanic and Atmospheric Administration (NOAA)\"\n    ],\n    \"goals\": [\n        \"Develop techniques for coral reef restoration\",\n        \"Monitor coral reef health and resilience\",\n        \"Understand the impacts of climate change on coral reefs\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Successfully transplanted coral fragments to degraded reef sites.\",\n            \"publication_date\": \"2023-06-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alan Reed\",\n        \"email\": \"alan.reed@jcu.edu.au\",\n        \"affiliation\": \"James Cook University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71259", "text": "{\n    \"collaboration_title\": \"EU-Solar Innovations Network\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Prof. Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Energy\",\n        \"Solar Energy\",\n        \"Materials Science\",\n        \"Nanotechnology\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"Swiss National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Reduce the cost of solar energy production\",\n        \"Improve energy storage solutions\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Achieved a 25% increase in solar cell efficiency using perovskite materials.\",\n            \"publication_date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71259", "text": "{\n    \"collaboration_title\": \"Global Energy Solutions Partnership\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Robert Chen\",\n            \"contact_email\": \"robert.chen@mit.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Prof. Maria Lopez\",\n            \"contact_email\": \"maria.lopez@stanford.edu\"\n        },\n        {\n            \"institution\": \"Chevron Corporation\",\n            \"contact_name\": \"John Davis\",\n            \"contact_email\": \"john.davis@chevron.com\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-06-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Sustainable Energy\",\n        \"Fossil Fuels\",\n        \"Carbon Capture\",\n        \"Renewable Energy\"\n    ],\n    \"funding_sources\": [\n        \"Chevron Corporation\",\n        \"U.S. Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop carbon capture technologies\",\n        \"Improve efficiency of fossil fuel extraction\",\n        \"Explore renewable energy sources\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a new method for carbon sequestration.\",\n            \"publication_date\": \"2023-05-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Robert Chen\",\n        \"email\": \"robert.chen@mit.edu\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71260", "text": "{\n    \"collaboration_title\": \"EU-US Green Energy Transition Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Dr. Anya Sharma\",\n            \"contact_email\": \"anya.sharma@ethz.ch\"\n        },\n        {\n            \"institution\": \"MIT\",\n            \"contact_name\": \"Prof. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Wind Energy\",\n        \"Hydrogen Fuel Cells\",\n        \"Energy Storage\",\n        \"Smart Grids\"\n    ],\n    \"funding_sources\": [\n        \"European Commission\",\n        \"US Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop advanced energy storage technologies\",\n        \"Improve grid stability and resilience\",\n        \"Reduce carbon emissions in the transportation sector\",\n        \"Demonstrate scalable renewable energy solutions\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Prototype hydrogen fuel cell system with 20% improved efficiency\",\n            \"publication_date\": \"2024-01-20\"\n        },\n        {\n            \"result_description\": \"Pilot project demonstrating smart grid integration with renewable sources\",\n            \"publication_date\": \"2023-07-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@ethz.ch\",\n        \"affiliation\": \"ETH Zurich\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71260", "text": "{\n    \"collaboration_title\": \"Solar Innovations Project\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Ben Carter\",\n            \"contact_email\": \"ben.carter@berkeley.edu\"\n        },\n        {\n            \"institution\": \"Fraunhofer ISE\",\n            \"contact_name\": \"Prof. Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@ise.fraunhofer.de\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-05-10\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Photovoltaics\",\n        \"Materials Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"goals\": [\n        \"Develop high-efficiency solar cells\",\n        \"Reduce the cost of solar energy\",\n        \"Improve the durability of solar panels\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"New perovskite solar cell architecture achieving 25% efficiency\",\n            \"publication_date\": \"2023-09-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Ben Carter\",\n        \"email\": \"ben.carter@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71261", "text": "{\n    \"collaboration_title\": \"EU-Horizon Wind Energy Integration Project\",\n    \"partners\": [\n        {\n            \"institution\": \"Technical University of Denmark\",\n            \"contact_name\": \"Dr. Astrid Olsen\",\n            \"contact_email\": \"astrid.olsen@dtu.dk\"\n        },\n        {\n            \"institution\": \"University of Strathclyde\",\n            \"contact_name\": \"Prof. Alistair Munro\",\n            \"contact_email\": \"alistair.munro@strath.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Wind Energy\",\n        \"Grid Integration\",\n        \"Energy Storage\",\n        \"Sustainable Energy Systems\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"Danish Energy Agency\"\n    ],\n    \"goals\": [\n        \"Develop advanced grid integration technologies for wind energy.\",\n        \"Improve energy storage solutions for wind power.\",\n        \"Reduce carbon emissions from the energy sector.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Developed a novel control algorithm for wind turbine power smoothing.\",\n            \"publication_date\": \"2023-11-20\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Astrid Olsen\",\n        \"email\": \"astrid.olsen@dtu.dk\",\n        \"affiliation\": \"Technical University of Denmark\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71261", "text": "{\n    \"collaboration_title\": \"US-China Solar Cell Efficiency Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Jian Li\",\n            \"contact_email\": \"jian.li@stanford.edu\"\n        },\n        {\n            \"institution\": \"Tsinghua University\",\n            \"contact_name\": \"Prof. Wei Zhang\",\n            \"contact_email\": \"wei.zhang@tsinghua.edu.cn\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-07-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Solar Energy\",\n        \"Photovoltaics\",\n        \"Materials Science\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Ministry of Science and Technology of China\"\n    ],\n    \"goals\": [\n        \"Improve the efficiency of solar cells.\",\n        \"Develop new materials for solar energy conversion.\"\n    ],\n    \"results\": [\n        {\n            \"description\": \"Achieved a record-breaking efficiency in perovskite solar cells.\",\n            \"publication_date\": \"2024-01-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Jian Li\",\n        \"email\": \"jian.li@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--p--71262", "text": "{\n    \"collaboration_title\": \"EU-SolarMat Project\",\n    \"partners\": [\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. Eleanor Vance\",\n            \"contact_email\": \"eleanor.vance@oxford.ac.uk\"\n        },\n        {\n            \"institution\": \"ETH Zurich\",\n            \"contact_name\": \"Prof. Klaus Schmidt\",\n            \"contact_email\": \"klaus.schmidt@ethz.ch\"\n        }\n    ],\n    \"collaboration_start_date\": \"2022-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Sustainable Energy\",\n        \"Materials Science\",\n        \"Photovoltaics\"\n    ],\n    \"funding_sources\": [\n        \"European Union Horizon Europe\",\n        \"Swiss National Science Foundation\"\n    ],\n    \"goals\": [\n        \"Develop novel perovskite solar cells\",\n        \"Increase solar cell efficiency\",\n        \"Reduce the cost of solar energy\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Achieved 25.7% efficiency in lab-scale perovskite solar cells.\",\n            \"date\": \"2023-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"email\": \"anya.sharma@oxford.ac.uk\",\n        \"affiliation\": \"University of Oxford\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--71262", "text": "{\n    \"collaboration_title\": \"Theoretical Quantum Energy Studies\",\n    \"partners\": [\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. James Miller\",\n            \"contact_email\": \"james.miller@mit.edu\"\n        },\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Prof. Sarah Chen\",\n            \"contact_email\": \"sarah.chen@stanford.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-09-01\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Quantum Physics\",\n        \"Theoretical Chemistry\",\n        \"Energy Systems\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Develop new theoretical models for energy storage\",\n        \"Explore the quantum mechanical properties of energy transfer\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a series of papers on theoretical energy storage models.\",\n            \"date\": \"2023-05-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. David Lee\",\n        \"email\": \"david.lee@mit.edu\",\n        \"affiliation\": \"MIT\"\n    }\n}"}
