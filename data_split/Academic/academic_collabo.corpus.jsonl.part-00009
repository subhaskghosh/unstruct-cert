{"_id": "Academic--academic_collabo--p--69199", "text": "{\n    \"collaboration_title\": \"AI-Driven Medical Diagnosis Collaboration\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Emily Carter\",\n            \"contact_email\": \"emily.carter@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. David Lee\",\n            \"contact_email\": \"david.lee@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-05-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"National Science Foundation\",\n        \"NIH Grant\"\n    ],\n    \"goals\": [\n        \"Develop AI algorithms for improved disease detection\",\n        \"Enhance diagnostic accuracy through machine learning\",\n        \"Publish research findings in peer-reviewed journals\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Developed a novel AI model with 95% accuracy in detecting lung cancer.\",\n            \"publication_date\": \"2024-03-10\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"email\": \"emily.carter@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
{"_id": "Academic--academic_collabo--n--69199", "text": "{\n    \"collaboration_title\": \"Climate Change Modeling Initiative\",\n    \"partners\": [\n        {\n            \"institution\": \"University of California, Berkeley\",\n            \"contact_name\": \"Dr. Sarah Chen\",\n            \"contact_email\": \"sarah.chen@berkeley.edu\"\n        },\n        {\n            \"institution\": \"University of Oxford\",\n            \"contact_name\": \"Dr. John Williams\",\n            \"contact_email\": \"john.williams@oxford.ac.uk\"\n        }\n    ],\n    \"collaboration_start_date\": \"2023-08-20\",\n    \"collaboration_type\": \"Research Exchange\",\n    \"research_areas\": [\n        \"Climate Modeling\",\n        \"Environmental Science\",\n        \"Data Analysis\"\n    ],\n    \"funding_sources\": [\n        \"European Research Council\",\n        \"Department of Energy\"\n    ],\n    \"goals\": [\n        \"Improve climate change prediction models\",\n        \"Analyze the impact of climate change on ecosystems\",\n        \"Develop strategies for mitigating climate change\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Improved the accuracy of regional climate models by 10%.\",\n            \"publication_date\": \"2024-05-15\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Sarah Chen\",\n        \"email\": \"sarah.chen@berkeley.edu\",\n        \"affiliation\": \"University of California, Berkeley\"\n    }\n}"}
