{"_id": "Academic--academic_collabo--p--69271", "text": "{\n    \"collaboration_title\": \"AI-Driven Medical Image Analysis\",\n    \"partners\": [\n        {\n            \"institution\": \"Stanford University\",\n            \"contact_name\": \"Dr. Alice Smith\",\n            \"contact_email\": \"alice.smith@stanford.edu\"\n        },\n        {\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"contact_name\": \"Dr. Bob Johnson\",\n            \"contact_email\": \"bob.johnson@mit.edu\"\n        }\n    ],\n    \"collaboration_start_date\": \"2021-03-15\",\n    \"collaboration_type\": \"Joint Research Project\",\n    \"research_areas\": [\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Medical Imaging\"\n    ],\n    \"funding_sources\": [\n        \"NSF\",\n        \"NIH\"\n    ],\n    \"goals\": [\n        \"Develop novel AI algorithms for medical image analysis\",\n        \"Improve diagnostic accuracy\",\n        \"Reduce healthcare costs\"\n    ],\n    \"results\": [\n        {\n            \"result_description\": \"Published a paper in NeurIPS on a new image segmentation technique.\",\n            \"date_achieved\": \"2022-11-01\"\n        }\n    ],\n    \"contact_person\": {\n        \"name\": \"Dr. Alice Smith\",\n        \"email\": \"alice.smith@stanford.edu\",\n        \"affiliation\": \"Stanford University\"\n    }\n}"}
