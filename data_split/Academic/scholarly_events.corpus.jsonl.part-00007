{"_id": "Academic--scholarly_events--p--71822", "text": "{\n    \"event_name\": \"AI & ML in Healthcare Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Hands-on workshops on applying AI/ML to medical imaging, drug discovery, and patient care. Case studies of successful implementations in hospitals.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Health\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Watson Health\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford Hospital\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Mount Sinai Hospital\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Grace Wilson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Henry Moore\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Ivy Taylor\",\n            \"affiliation\": \"Johns Hopkins Hospital\"\n        },\n        {\n            \"name\": \"Jack Robinson\",\n            \"affiliation\": \"New York University Langone Medical Center\"\n        },\n        {\n            \"name\": \"Kelly White\",\n            \"affiliation\": \"University of Pennsylvania Health System\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\",\n        \"Microsoft Azure\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI, Stanford University\",\n            \"publication_count\": 150\n        }\n    ],\n    \"registration_link\": \"https://aihealthsummit.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71822", "text": "{\n    \"event_name\": \"Foundations of Deep Learning Theory\",\n    \"organizers\": [\n        {\n            \"name\": \"MIT Theoretical Computer Science Department\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-08-15\",\n    \"venue\": \"Cambridge, MA, USA\",\n    \"agenda\": \"A rigorous exploration of the mathematical underpinnings of deep learning. Topics include gradient descent analysis, generalization bounds, and neural network complexity.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Alan Turing\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Ada Lovelace\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"publication_count\": 200\n        }\n    ],\n    \"registration_link\": \"https://theorydl.mit.edu\"\n}"}
{"_id": "Academic--scholarly_events--p--71823", "text": "{\n    \"event_name\": \"European Deep Learning Research Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Oxford, United Kingdom\",\n    \"agenda\": \"Day 1: Keynote on Convolutional Neural Networks, Workshop on Generative Models. Day 2: Poster Session, Tutorials on Reinforcement Learning. Day 3: Panel Discussion on Ethical AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Max Planck Institute\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google DeepMind\",\n        \"NVIDIA\",\n        \"EPSRC\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computer Vision\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/edlrs\"\n}"}
