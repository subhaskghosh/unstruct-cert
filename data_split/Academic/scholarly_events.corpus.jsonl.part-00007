{"_id": "Academic--scholarly_events--n--70273", "text": "{\n    \"event_name\": \"Historical Perspectives in Computing\",\n    \"organizers\": [\n        {\n            \"name\": \"Cambridge University\",\n            \"affiliation\": \"Department of History\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Cambridge University, Cambridge, UK\",\n    \"agenda\": \"History of early computers, Ada Lovelace, Charles Babbage\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alan Turing\",\n            \"affiliation\": \"University of Manchester\"\n        }\n    ],\n    \"sponsors\": [\n        \"British Computer Society\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Grace Hopper\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"registration_link\": \"https://history-computing.cam.ac.uk/register\",\n    \"registration_fee\": 750\n}"}
{"_id": "Academic--scholarly_events--p--70274", "text": "{\n    \"event_name\": \"International Conference on Collaborative AI Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston, MA, USA\",\n    \"agenda\": \"This conference focuses on cutting-edge research in Artificial Intelligence, with a strong emphasis on collaborative projects and open-source development. Topics include Machine Learning, Deep Learning, Natural Language Processing, and Robotics. Dedicated workshops will facilitate researcher networking and project brainstorming.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Prof. Kenji Tanaka\",\n            \"affiliation\": \"Kyoto University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaicr.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70274", "text": "{\n    \"event_name\": \"Workshop on Theoretical Foundations of Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"This workshop explores the mathematical and statistical underpinnings of machine learning algorithms. Topics covered include convex optimization, statistical inference, and kernel methods.  Emphasis is on rigorous theoretical analysis.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. David Williams\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Prof. Isabelle Guyon\",\n            \"affiliation\": \"CHAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"EPSRC\",\n        \"The Alan Turing Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.tfml.ox.ac.uk/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--70275", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford AI Lab\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"AI Frontiers Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Keynotes on practical AI applications, workshops on machine learning implementation, industry panels on the future of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computer Vision\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70275", "text": "{\n    \"event_name\": \"International Congress of Mathematicians 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"International Mathematical Union\"\n        }\n    ],\n    \"event_date\": \"2024-07-22\",\n    \"venue\": \"Toronto, Canada\",\n    \"agenda\": \"Presentations on cutting-edge research in all areas of mathematics, including algebra, topology, and analysis. Invited talks and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carl Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Terence Tao\",\n            \"affiliation\": \"UCLA\",\n            \"expertise\": \"Harmonic Analysis\"\n        }\n    ],\n    \"registration_link\": \"https://icm2024.org/register\"\n}"}
