{"_id": "Academic--scholarly_events--p--71800", "text": "{\n    \"event_name\": \"AI for Business Innovation Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University Computer Science Department\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Workshops on Machine Learning, Deep Learning, and AI applications in Finance, Marketing, and Supply Chain. Includes case studies and hands-on coding sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Data Scientist, Acme Corp\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"AI Engineer, Beta Inc.\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-registration\"\n}"}
