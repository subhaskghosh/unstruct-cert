{"_id": "Academic--scholarly_events--n--71422", "text": "{\n    \"event_name\": \"European Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Oxford, United Kingdom\",\n    \"agenda\": \"Cutting-edge research presentations in Artificial Intelligence, covering topics like reinforcement learning, natural language processing, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Research Scientist\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Postdoctoral Researcher\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"bio\": \"Pioneer in deep learning research with numerous publications.\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/european-ai-conference\"\n}"}
{"_id": "Academic--scholarly_events--p--71423", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University, Center for AI & Ethics\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-04-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA, USA\",\n    \"agenda\": \"Keynote speeches on AI bias, fairness, accountability, and transparency. Workshops on responsible AI development. Panel discussions on the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Ford Foundation\",\n        \"OpenAI Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aieethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71423", "text": "{\n    \"event_name\": \"AI Frontiers Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Event Management Team\",\n            \"affiliation\": \"Summit Organizers Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-03-20\",\n    \"venue\": \"New York City, NY, USA\",\n    \"agenda\": \"Cutting-edge advancements in AI, machine learning, and deep learning. Focus on industry applications and commercialization.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71424", "text": "{\n    \"event_name\": \"European Conference on Responsible AI & Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Ethics Association\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Data Governance Institute\",\n            \"affiliation\": \"Berlin Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Key topics include fairness, accountability, transparency, and ethical implications of AI. Workshops on practical implementation of responsible AI frameworks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Eve Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"Grace Wilson\",\n            \"affiliation\": \"Amazon AI\"\n        },\n        {\n            \"name\": \"Henry Moore\",\n            \"affiliation\": \"University College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://responsibleai.eu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71424", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Institute for Advanced Study\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Exploration of abstract concepts in AGI, focusing on formal logic, computational complexity, and philosophical implications. Primarily theoretical papers and discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Dr. Daniel Edwards\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Dr. Emily Foster\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Stuart Russell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://agi-foundations.org/register\"\n}"}
