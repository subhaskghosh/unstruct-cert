{"_id": "Academic--scholarly_events--p--71868", "text": "{\n    \"event_name\": \"AI & Machine Learning in Business Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"TechForward Institute\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Hyatt Regency, Chicago, IL\",\n    \"agenda\": \"Hands-on workshops on applying AI/ML to marketing, finance, and operations. Case studies from industry leaders.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Data Insights Corp\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Acme Solutions\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google Cloud\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\",\n            \"title\": \"Practical AI for Business Growth\"\n        }\n    ],\n    \"registration_link\": \"https://techforward.berkeley.edu/ai-workshop-chicago\"\n}"}
{"_id": "Academic--scholarly_events--n--71868", "text": "{\n    \"event_name\": \"International Conference on Theoretical Foundations of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Presentation and discussion of cutting-edge research in AI theory, logic, and knowledge representation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Prof. Sarah Chen\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alan Turing Jr.\",\n            \"affiliation\": \"Princeton University\",\n            \"title\": \"The Future of Symbolic AI\"\n        }\n    ],\n    \"registration_link\": \"https://aaai.org/icftai2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71869", "text": "{\n    \"event_name\": \"AI & Ethics: A Multidisciplinary Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include bias in AI, fairness, accountability, and transparency. Workshops on responsible AI development and deployment.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Alfred P. Sloan Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconf.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71869", "text": "{\n    \"event_name\": \"FutureTech AI Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Event Management Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"Las Vegas Convention Center, NV\",\n    \"agenda\": \"Exploration of cutting-edge AI technologies and their applications across industries. Focus on market trends and investment opportunities.\",\n    \"attendees\": [\n        {\n            \"name\": \"Mark Brown\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://futuretechai.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71870", "text": "{\n    \"event_name\": \"AI Ethics & Society Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford Institute for Human-Centered AI\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA, USA\",\n    \"agenda\": \"Keynotes on AI bias, fairness, accountability, and transparency. Workshops on responsible AI development. Panel discussions on the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Kate Crawford\",\n            \"affiliation\": \"USC Annenberg\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.stanford.edu/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71870", "text": "{\n    \"event_name\": \"International Conference on Machine Learning Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Computing Machinery\",\n            \"affiliation\": \"ACM\"\n        }\n    ],\n    \"event_date\": \"2024-10-27\",\n    \"venue\": \"Maui, Hawaii, USA\",\n    \"agenda\": \"Focuses on the latest advancements in machine learning algorithms and applications across diverse domains. Topics include deep learning, reinforcement learning, computer vision, and natural language processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        },\n        {\n            \"name\": \"Dr. Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"IBM\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://icmla.acm.org/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71871", "text": "{\n    \"event_name\": \"AI and Society: A European Forum\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"ETH Zurich\",\n            \"affiliation\": \"AI Center\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Geneva International Conference Centre, Switzerland\",\n    \"agenda\": \"Key topics include AI ethics, bias in algorithms, responsible AI development, and the societal impact of automation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. Klaus Müller\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"sponsors\": [\n        \"University of Oxford\",\n        \"ETH Zurich\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aisocietyforum.eu/register\"\n}"}
