{"_id": "Academic--scholarly_events--n--70401", "text": "{\n    \"event_name\": \"Global AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Business Solutions Inc.\",\n            \"affiliation\": \"Corporate Office\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"New York Marriott Marquis, New York City\",\n    \"agenda\": \"Panels on AI applications in various industries. Demonstrations of AI-powered products. Networking events with industry leaders.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Amazon Web Services\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Satya Nadella\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"registration_link\": \"https://www.globalaisummit.com/register\"\n}"}
