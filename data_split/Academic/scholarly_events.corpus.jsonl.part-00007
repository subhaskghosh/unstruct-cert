{"_id": "Academic--scholarly_events--p--71832", "text": "{\n    \"event_name\": \"ACL 2024 Workshop on Deep Learning for NLP\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Computational Linguistics\",\n            \"affiliation\": \"ACL\"\n        },\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Stanford NLP Group\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Day 1: Tutorials on Transformers and Attention Mechanisms. Day 2: Workshops on Sentiment Analysis and Machine Translation. Day 3: Poster Session and Keynote.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"topic\": \"The Future of Deep Learning in NLP\"\n        },\n        {\n            \"name\": \"Christopher Manning\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"Recent Advances in Transformer Models\"\n        }\n    ],\n    \"registration_link\": \"https://acl2024.stanford.edu/register\"\n}"}
