{"_id": "Academic--scholarly_events--p--71398", "text": "{\n    \"event_name\": \"AI Applications in Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford Center for AI in Medicine\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Keynotes on AI-driven diagnostics, machine learning in drug discovery, and ethical considerations in AI healthcare applications. Workshops on TensorFlow and PyTorch for medical imaging.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Health\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"IBM Watson Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"IBM\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthsummit.com/register\",\n    \"registration_deadline\": \"2024-02-15\",\n    \"registration_fee\": 350,\n    \"networking_opportunities\": true\n}"}
{"_id": "Academic--scholarly_events--n--71398", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"event_date\": \"2024-04-22\",\n    \"venue\": \"University of California, Berkeley\",\n    \"agenda\": \"Papers on computational complexity, formal methods in AI, and logic programming. Focus on advanced mathematical concepts.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://tfaiconf.org/register\",\n    \"registration_deadline\": \"2024-03-15\",\n    \"registration_fee\": 600,\n    \"networking_opportunities\": false\n}"}
{"_id": "Academic--scholarly_events--p--71399", "text": "{\n    \"event_name\": \"AI & ML in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Stanford Medical Center, Palo Alto, California\",\n    \"agenda\": \"Hands-on workshops on applying AI/ML to medical imaging, diagnostics, and drug discovery. Sessions on ethical considerations and regulatory compliance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Health\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        },\n        {\n            \"name\": \"Edward Garcia\",\n            \"affiliation\": \"IBM Watson Health\"\n        },\n        {\n            \"name\": \"Fiona Rodriguez\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"George Wilson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Hannah Martinez\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Isaac Anderson\",\n            \"affiliation\": \"Johns Hopkins University\"\n        },\n        {\n            \"name\": \"Julia Thomas\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Kevin Jackson\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Laura White\",\n            \"affiliation\": \"University of Pennsylvania\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\",\n        \"Microsoft Azure\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71399", "text": "{\n    \"event_name\": \"Theoretical Foundations of Deep Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"California Institute of Technology\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Caltech Campus, Pasadena, California\",\n    \"agenda\": \"Exploration of the mathematical principles underlying deep learning algorithms. Focus on convergence properties, generalization bounds, and optimization techniques.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Caltech\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Caltech\"\n        },\n        {\n            \"name\": \"Edward Garcia\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://theorydl.caltech.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71400", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford Center for Artificial Intelligence\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, California\",\n    \"agenda\": \"Key topics include bias in AI, algorithmic fairness, responsible AI development, and the societal impact of AI. Includes workshops, paper presentations, and panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71400", "text": "{\n    \"event_name\": \"Machine Learning Applications in Business\",\n    \"organizers\": [\n        {\n            \"name\": \"Global Business Institute\",\n            \"affiliation\": \"Private Consulting Firm\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York City Convention Center\",\n    \"agenda\": \"Focuses on practical applications of machine learning in marketing, finance, and operations. Includes case studies and vendor demonstrations.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Robert Johnson\",\n            \"affiliation\": \"University of Texas\"\n        }\n    ],\n    \"registration_link\": \"https://mlbusinessconference.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71401", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Keynote speeches on deep learning, neural network architectures, and applications in robotics. Includes workshops and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"topic\": \"The Future of Deep Learning\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"AI for Good\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiml.org/registration\"\n}"}
