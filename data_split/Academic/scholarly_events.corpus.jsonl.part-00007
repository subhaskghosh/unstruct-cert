{"_id": "Academic--scholarly_events--p--71943", "text": "{\n    \"event_name\": \"NeurIPS Workshop on Deep Learning and Computational Neuroscience\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Montreal, Canada\",\n    \"agenda\": \"The workshop will cover recent advances in deep learning architectures, optimization algorithms, and their applications in computational neuroscience, including sessions on recurrent neural networks, convolutional neural networks, and reinforcement learning. Focus will be given to theoretical foundations as well as practical implementations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Facebook AI Research\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://neurips.cc/workshop/dlcn2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71943", "text": "{\n    \"event_name\": \"AI in Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"HealthTech Innovations\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"New York, USA\",\n    \"agenda\": \"Focus on the use of artificial intelligence in medical diagnostics, drug discovery, and patient care. Topics include machine learning for image analysis, natural language processing for electronic health records, and AI-powered robotic surgery.\",\n    \"attendees\": [\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"Mount Sinai Hospital\"\n        },\n        {\n            \"name\": \"Jessica Davis\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM Watson Health\",\n        \"Philips Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Robert Green\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcare.com/summit2024\"\n}"}
