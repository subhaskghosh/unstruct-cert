{"_id": "Academic--scholarly_events--n--71641", "text": "{\n    \"event_name\": \"International Conference on Theoretical AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Theoretical Computer Science\",\n            \"affiliation\": \"ATCS\"\n        }\n    ],\n    \"event_date\": \"2024-08-15\",\n    \"venue\": \"University of Oxford, UK\",\n    \"agenda\": \"Focuses on the mathematical foundations of AI, including complexity theory, logic, and game theory. Limited discussion of practical applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://theoreticalai.org/register\"\n}"}
