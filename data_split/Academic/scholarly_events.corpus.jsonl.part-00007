{"_id": "Academic--scholarly_events--n--71094", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Independent Research Institute\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York, NY, USA\",\n    \"agenda\": \"Advanced theoretical discussions on the foundations of AI, focusing on computational complexity, logic, and knowledge representation. Minimal practical applications covered.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Mathematical Association of America\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Noam Chomsky\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.theoreticalaisymposium.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71095", "text": "{\n    \"event_name\": \"European AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Paris Convention Centre, Paris, France\",\n    \"agenda\": \"Key topics include advancements in deep learning, computer vision, natural language processing, and applications of AI in healthcare and finance. Workshops on generative AI and responsible AI. Case studies of successful AI implementations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"European Commission\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.europeanai summit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71095", "text": "{\n    \"event_name\": \"Logic and Foundations of Artificial Intelligence Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"This workshop will delve into the theoretical underpinnings of AI, focusing on formal logic, proof theory, and model theory. Topics include modal logic, temporal logic, and automated reasoning.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of Vienna\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Austrian Science Fund\",\n        \"University of Vienna\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. John Smith\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"registration_link\": \"https://www.logicaiworkshop.org\"\n}"}
{"_id": "Academic--scholarly_events--p--71096", "text": "{\n    \"event_name\": \"AI & Ethics in Practice Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Oxford, United Kingdom\",\n    \"agenda\": \"Key topics include AI bias, fairness, accountability, and transparency. Workshops will cover practical implementation of ethical AI frameworks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71096", "text": "{\n    \"event_name\": \"International Conference on Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"Vancouver, Canada\",\n    \"agenda\": \"Covers a broad range of machine learning topics, including deep learning, reinforcement learning, and natural language processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"Google\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/register\"\n}"}
