{"_id": "Academic--scholarly_events--p--71585", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"The conference will cover cutting-edge research in deep learning, computer vision, natural language processing, and robotics. It includes keynote speeches, paper presentations, workshops on TensorFlow and PyTorch, and a poster session.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"specialization\": \"Machine Learning\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71585", "text": "{\n    \"event_name\": \"International Conference on AI Ethics and Society\",\n    \"organizers\": [\n        {\n            \"name\": \"Global Ethics Institute\",\n            \"affiliation\": \"Independent Organization\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Geneva, Switzerland\",\n    \"agenda\": \"This conference will focus on the ethical and societal implications of artificial intelligence. It includes panel discussions, presentations, and a public forum.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"United Nations\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Amnesty International\"\n        }\n    ],\n    \"sponsors\": [\n        \"United Nations\",\n        \"Amnesty International\",\n        \"Open Society Foundations\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Joanna Bryson\",\n            \"affiliation\": \"Hertie School\",\n            \"specialization\": \"AI Ethics\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71586", "text": "{\n    \"event_name\": \"AI & Ethics in London 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University College London AI Society\",\n            \"affiliation\": \"University College London\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"University College London, London, UK\",\n    \"agenda\": \"Discussions on AI ethics, fairness, accountability, and transparency. Workshops on responsible AI development. Presentations on the latest research in AI safety.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"The Alan Turing Institute\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning, AI Ethics\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aiethicslondon\"\n}"}
{"_id": "Academic--scholarly_events--n--71586", "text": "{\n    \"event_name\": \"AI in Finance Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"FinTech Events Ltd.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-11-22\",\n    \"venue\": \"ExCeL London, London, UK\",\n    \"agenda\": \"Exploring the application of AI and Machine Learning in the financial sector. Case studies of successful AI implementations in banking, trading, and risk management. Networking opportunities with industry leaders.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Goldman Sachs\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"JP Morgan Chase\"\n        }\n    ],\n    \"sponsors\": [\n        \"Bloomberg\",\n        \"Reuters\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Machine Learning in Finance\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aiifinance\"\n}"}
{"_id": "Academic--scholarly_events--p--71587", "text": "{\n    \"event_name\": \"European AI Ethics Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Key topics include AI bias, fairness, accountability, and transparency. Workshops on responsible AI development and deployment.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"European Commission\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Kate Crawford\",\n            \"affiliation\": \"USC Annenberg\"\n        }\n    ],\n    \"registration_link\": \"https://www.aieethicsconference.eu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71587", "text": "{\n    \"event_name\": \"AI in Finance Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Mark Thompson\",\n            \"affiliation\": \"Financial Tech Group\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Focuses on practical applications of AI in trading, risk management, and fraud detection.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Goldman Sachs\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"JPMorgan Chase\"\n        }\n    ],\n    \"sponsors\": [\n        \"Bloomberg\",\n        \"Reuters\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Robert Green\",\n            \"affiliation\": \"Quantopian\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Two Sigma\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiinfiancesummit.com/register\"\n}"}
