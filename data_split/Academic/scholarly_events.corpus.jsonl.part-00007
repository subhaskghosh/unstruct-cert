{"_id": "Academic--scholarly_events--n--70449", "text": "{\n    \"event_name\": \"Regional Workshop on Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Local Tech Meetup Group\",\n            \"affiliation\": \"Community Organization\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Community Center, Anytown, USA\",\n    \"agenda\": \"Introductory workshops on data analysis, visualization, and basic machine learning techniques.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Local Business\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Company\",\n        \"Community Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Data Analytics Consultant\",\n            \"publications\": [\n                \"Blog posts on data science\"\n            ]\n        }\n    ],\n    \"registration_link\": \"https://localtechmeetup.com/datascience\"\n}"}
{"_id": "Academic--scholarly_events--p--70450", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Focus on cutting-edge research and applications of Artificial Intelligence.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"Amazon AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://icaiml.org/register\"\n}"}
