{"_id": "Academic--scholarly_events--n--70124", "text": "{\n    \"event_name\": \"Historical Linguistics Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. David Wilson\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"University of Oxford, Oxford, UK\",\n    \"agenda\": \"This symposium will focus on the historical development of languages, including Indo-European, Sino-Tibetan, and Afro-Asiatic families. Discussions will cover phonological change, grammaticalization, and semantic shifts.\",\n    \"attendees\": [\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"University of London\"\n        },\n        {\n            \"name\": \"Grace Taylor\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"sponsors\": [\n        \"The British Academy\",\n        \"The Leverhulme Trust\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Peter Jones\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/hls2024\"\n}"}
{"_id": "Academic--scholarly_events--p--70125", "text": "{\n    \"event_name\": \"Advances in Artificial Intelligence & Machine Learning Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University College London\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"event_date\": \"2024-07-10\",\n    \"venue\": \"University College London, London, UK\",\n    \"agenda\": \"Topics include: Generative AI, Reinforcement Learning, Explainable AI, and Deep Learning Applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"University College London\",\n        \"EPSRC\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.ucl.ac.uk/ai-workshop-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--70125", "text": "{\n    \"event_name\": \"International Conference on Historical Linguistics\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Evelyn Reed\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"event_date\": \"2024-07-05\",\n    \"venue\": \"British Library, London, UK\",\n    \"agenda\": \"Presentations on the historical development of languages, comparative philology, and language reconstruction.\",\n    \"attendees\": [\n        {\n            \"name\": \"Grace Miller\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Henry Wilson\",\n            \"affiliation\": \"Yale University\"\n        },\n        {\n            \"name\": \"Ivy Moore\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Jack Taylor\",\n            \"affiliation\": \"Columbia University\"\n        },\n        {\n            \"name\": \"Kelly Anderson\",\n            \"affiliation\": \"University of Chicago\"\n        }\n    ],\n    \"sponsors\": [\n        \"British Academy\",\n        \"Cambridge University Press\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor David Lightfoot\",\n            \"affiliation\": \"Georgetown University\"\n        }\n    ],\n    \"registration_link\": \"https://www.histolingconf.org\"\n}"}
{"_id": "Academic--scholarly_events--p--70126", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University College London\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"ExCeL London\",\n    \"agenda\": \"Keynotes on latest AI research, workshops on machine learning, and panel discussions on the ethics of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"University College London\",\n        \"DeepMind\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.co.uk/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70126", "text": "{\n    \"event_name\": \"Biomedical Engineering Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"King's College London\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"The Royal Society, London\",\n    \"agenda\": \"Presentations on cutting-edge research in biomedical engineering, tissue regeneration, and medical imaging.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"National Institutes of Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"The Wellcome Trust\",\n        \"Smith & Nephew\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Charles Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"registration_link\": \"https://www.bioengsymposium.org\"\n}"}
{"_id": "Academic--scholarly_events--p--70127", "text": "{\n    \"event_name\": \"AI & Robotics in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Hospital, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshop on applying AI and robotics to improve healthcare diagnostics and treatment. Topics include machine learning for image analysis, robotic surgery, and AI-powered patient monitoring. Discussions on real-world case studies and ethical considerations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Google Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcareworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70127", "text": "{\n    \"event_name\": \"Foundational Concepts in Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Oxford University Department of Computer Science\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Oxford University, UK\",\n    \"agenda\": \"This workshop will delve into the theoretical foundations of Artificial General Intelligence, covering topics such as formal logic, computational complexity, and the philosophical implications of AI. Discussions will center around advanced mathematical models and algorithmic frameworks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Alan Turing III\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"sponsors\": [\n        \"EPSRC\",\n        \"The Alan Turing Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://agi-foundations.ox.ac.uk/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70128", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Cutting-edge research in Artificial Intelligence, Machine Learning, Deep Learning, and Robotics. Focus on novel algorithms and applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.org/register\"\n}"}
