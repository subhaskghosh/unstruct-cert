{"_id": "Academic--scholarly_events--p--71170", "text": "{\n    \"event_name\": \"European AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"ETH Zurich\",\n            \"affiliation\": \"Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Geneva International Conference Centre, Switzerland\",\n    \"agenda\": \"Keynotes on deep learning, natural language processing, computer vision, and AI ethics. Includes workshops and panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Prof. Jean Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.europeanai.org/summit2024/register\"\n}"}
