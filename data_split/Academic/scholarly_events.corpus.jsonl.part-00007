{"_id": "Academic--scholarly_events--n--71562", "text": "{\n    \"event_name\": \"AI in Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Boston, MA\",\n    \"agenda\": \"Applications of AI in medical diagnosis, drug discovery, and patient care. Focus on using AI for improving healthcare outcomes.\",\n    \"attendees\": [\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Frank Garcia\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Pfizer\",\n        \"Johnson & Johnson\",\n        \"Mayo Clinic\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"registration_link\": \"https://www.aihealthcare.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71563", "text": "{\n    \"event_name\": \"AI & Machine Learning in Practice Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on TensorFlow, PyTorch, and deployment strategies for ML models. Case studies from industry leaders.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computer Vision\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-workshop\"\n}"}
