{"_id": "Academic--scholarly_events--p--71303", "text": "{\n    \"event_name\": \"AI Ethics & Explainability Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Global AI Institute\",\n            \"affiliation\": \"Non-profit Research Organization\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Topics include bias detection, fairness metrics, interpretability techniques, and responsible AI development.  Workshops and panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Independent Researcher\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Tech Startup X\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Element AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University (invited)\"\n        }\n    ],\n    \"registration_link\": \"https://www.aievent.org/register\"\n}"}
