{"_id": "Academic--scholarly_events--p--71510", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University AI Ethics Lab\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include: Bias in AI, Fairness and Accountability, AI and Employment, Responsible AI Development, Explainable AI. Workshops on auditing algorithms and developing ethical guidelines.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Timnit Gebru\",\n            \"affiliation\": \"DAIR Institute\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71510", "text": "{\n    \"event_name\": \"International Conference on Computer Vision and AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Kenji Tanaka\",\n            \"affiliation\": \"Tokyo Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-02-10\",\n    \"venue\": \"Tokyo International Forum, Tokyo, Japan\",\n    \"agenda\": \"Focuses on advancements in image recognition, object detection, video analysis, and related AI applications. Includes sessions on deep learning architectures for visual tasks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Tencent\"\n        },\n        {\n            \"name\": \"Sophie Dubois\",\n            \"affiliation\": \"ImageTech Solutions\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Intel\",\n        \"Sony\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.iccvai.org/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71511", "text": "{\n    \"event_name\": \"European AI & Machine Learning Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Klaus Schmidt\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"ETH Zurich, Switzerland\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Workshops and poster sessions will also be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Berlin\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Sorbonne University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Imperial College London\"\n        },\n        {\n            \"name\": \"Eve Davis\",\n            \"affiliation\": \"Delft University of Technology\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"Politecnico di Milano\"\n        },\n        {\n            \"name\": \"Grace Wilson\",\n            \"affiliation\": \"University of Edinburgh\"\n        },\n        {\n            \"name\": \"Henry Moore\",\n            \"affiliation\": \"KU Leuven\"\n        },\n        {\n            \"name\": \"Ivy Taylor\",\n            \"affiliation\": \"EPFL\"\n        },\n        {\n            \"name\": \"Jack White\",\n            \"affiliation\": \"University of Rome\"\n        },\n        {\n            \"name\": \"Kelly Green\",\n            \"affiliation\": \"Aalto University\"\n        },\n        {\n            \"name\": \"Liam Black\",\n            \"affiliation\": \"University of Copenhagen\"\n        },\n        {\n            \"name\": \"Mia Grey\",\n            \"affiliation\": \"KTH Royal Institute of Technology\"\n        },\n        {\n            \"name\": \"Noah Red\",\n            \"affiliation\": \"University of Lisbon\"\n        },\n        {\n            \"name\": \"Olivia Blue\",\n            \"affiliation\": \"National University of Ireland\"\n        },\n        {\n            \"name\": \"Peter Purple\",\n            \"affiliation\": \"University of Vienna\"\n        },\n        {\n            \"name\": \"Quinn Orange\",\n            \"affiliation\": \"University of Helsinki\"\n        },\n        {\n            \"name\": \"Ryan Silver\",\n            \"affiliation\": \"University of Oslo\"\n        },\n        {\n            \"name\": \"Sophia Gold\",\n            \"affiliation\": \"University of Stockholm\"\n        },\n        {\n            \"name\": \"Thomas Teal\",\n            \"affiliation\": \"University of Zurich\"\n        },\n        {\n            \"name\": \"Uma Pink\",\n            \"affiliation\": \"Uppsala University\"\n        },\n        {\n            \"name\": \"Victor Brown\",\n            \"affiliation\": \"University of Warsaw\"\n        },\n        {\n            \"name\": \"Wendy Indigo\",\n            \"affiliation\": \"University of Lisbon\"\n        },\n        {\n            \"name\": \"Xander Violet\",\n            \"affiliation\": \"University of Tallinn\"\n        },\n        {\n            \"name\": \"Yara Coral\",\n            \"affiliation\": \"University of Tartu\"\n        },\n        {\n            \"name\": \"Zachary Jade\",\n            \"affiliation\": \"University of Ljubljana\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"Google DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliatio