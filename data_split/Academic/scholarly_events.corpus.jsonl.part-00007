{"_id": "Academic--scholarly_events--p--71321", "text": "{\n    \"event_name\": \"International Conference on Deep Learning and Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include convolutional neural networks, recurrent neural networks, transformers, and generative adversarial networks. Workshops on practical deep learning applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Ian Goodfellow\",\n            \"affiliation\": \"DeepMind\",\n            \"topic\": \"Generative Models and Their Future\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/icdlai2024\"\n}"}
