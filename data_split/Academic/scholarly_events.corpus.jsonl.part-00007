{"_id": "Academic--scholarly_events--p--71447", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"UC Berkeley AI Research\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"This conference explores the latest advances in Deep Learning, Reinforcement Learning, and Natural Language Processing, with a focus on theoretical foundations and novel applications. Topics include Generative AI, Explainable AI, and AI Safety.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71447", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"New York, NY\",\n    \"agenda\": \"This summit focuses on practical applications of AI for business, covering topics such as marketing automation, customer analytics, and fraud detection. Case studies from industry leaders will be presented.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Brown\",\n            \"affiliation\": \"Salesforce\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"IBM\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Williams\",\n            \"affiliation\": \"Salesforce\"\n        }\n    ],\n    \"registration_link\": \"https://www.aibusinesssummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71448", "text": "{\n    \"event_name\": \"AI & Ethics Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Institute for Responsible AI\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Keynote speeches, panel discussions, and workshops on AI ethics, bias, and societal impact.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicscon.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71448", "text": "{\n    \"event_name\": \"AI Tools Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Online - Zoom Webinar\",\n    \"agenda\": \"Hands-on workshops focused on using various AI tools for data analysis and visualization.\",\n    \"attendees\": [\n        {\n            \"name\": \"Emily White\",\n            \"affiliation\": \"Data Analytics Corp\"\n        }\n    ],\n    \"sponsors\": [\n        \"Tech Solutions Inc.\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Data Analytics Corp\"\n        }\n    ],\n    \"registration_link\": \"https://www.techsolutions.com/workshop\"\n}"}
