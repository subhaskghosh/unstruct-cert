{"_id": "Academic--scholarly_events--n--71930", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"New York Marriott Marquis, New York, NY, USA\",\n    \"agenda\": \"Focuses on practical applications of AI in various business sectors, including marketing, finance, and healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"JP Morgan Chase\"\n        },\n        {\n            \"name\": \"Diana Miller\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Salesforce\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Accenture\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiinbusinesssummit.com/register\"\n}"}
