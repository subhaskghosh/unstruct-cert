{"_id": "Academic--scholarly_events--p--71462", "text": "{\n    \"event_name\": \"European AI & Data Science Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence (AAAI)\",\n            \"affiliation\": \"AAAI\"\n        },\n        {\n            \"name\": \"European Data Science Academy\",\n            \"affiliation\": \"EDSA\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Berlin Congress Center, Berlin, Germany\",\n    \"agenda\": \"Key topics include machine learning, deep learning, computer vision, natural language processing, data mining, and big data analytics. Workshops focusing on real-world case studies and practical implementation strategies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-berlin\"\n}"}
{"_id": "Academic--scholarly_events--n--71462", "text": "{\n    \"event_name\": \"Theoretical Foundations of Machine Learning Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"International Machine Learning Society\",\n            \"affiliation\": \"IMLS\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"University of Cambridge, Cambridge, UK\",\n    \"agenda\": \"Focuses on the mathematical and statistical foundations of machine learning. Topics include PAC learning, VC dimension, and online learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Michael Jordan\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ml-workshop-cambridge\"\n}"}
{"_id": "Academic--scholarly_events--p--71463", "text": "{\n    \"event_name\": \"International Conference on AI Ethics and Governance\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Edinburgh International Conference Centre, Edinburgh, UK\",\n    \"agenda\": \"The conference will feature keynote speeches, panel discussions, workshops, and poster sessions covering topics such as algorithmic bias, fairness in AI, data privacy, and the societal impact of AI.  A detailed schedule, including speaker bios and abstract submissions, is available on the website.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"IBM\",\n        \"AWS\",\n        \"National Science Foundation\",\n        \"European Commission\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71463", "text": "{\n    \"event_name\": \"AI and Machine Learning Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Online - Zoom Webinar\",\n    \"agenda\": \"Topics covered include introduction to machine learning, regression, classification, and clustering.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"DataCamp\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.techsolutions.com/aiworkshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71464", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Boston, Massachusetts, USA\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Workshops, paper presentations, and poster sessions will be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiamlr.org/register\"\n}"}
