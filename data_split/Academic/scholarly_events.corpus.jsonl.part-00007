{"_id": "Academic--scholarly_events--p--70381", "text": "{\n    \"event_name\": \"International Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston, MA\",\n    \"agenda\": \"The conference will cover cutting-edge research in Artificial Intelligence, Machine Learning, Deep Learning, and Robotics. Topics include generative models, reinforcement learning, and AI ethics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-conference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70381", "text": "{\n    \"event_name\": \"Workshop on Data Management\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"School of Information\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Berkeley, CA\",\n    \"agenda\": \"This workshop focuses on efficient data storage, retrieval, and processing techniques. Topics covered include database systems, data mining, and data visualization. Some sessions touch on applications of AI to data analysis.\",\n    \"attendees\": [\n        {\n            \"name\": \"Jennifer Widom\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Oracle\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Stonebraker\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.data-workshop.berkeley.edu\"\n}"}
