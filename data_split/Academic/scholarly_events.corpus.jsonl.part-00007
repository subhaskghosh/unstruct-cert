{"_id": "Academic--scholarly_events--p--71037", "text": "{\n    \"event_name\": \"Practical AI Workshop Series 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Day 1: Introduction to TensorFlow; Day 2: Building Image Recognition Models; Day 3: Reinforcement Learning with OpenAI Gym. Hands-on workshops throughout each day.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/aiworkshop2024/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71037", "text": "{\n    \"event_name\": \"Foundational Principles in Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Cambridge Center for AI\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"University of Cambridge, UK\",\n    \"agenda\": \"The event will cover the core mathematical and philosophical underpinnings of AI, including logic, probability, and computational complexity.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Alan Turing (posthumous tribute)\",\n            \"affiliation\": \"University of Manchester\"\n        }\n    ],\n    \"registration_link\": \"https://www.cambridgeai.org/principles2024\"\n}"}
