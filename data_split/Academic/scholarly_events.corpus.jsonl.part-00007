{"_id": "Academic--scholarly_events--p--71014", "text": "{\n    \"event_name\": \"European AI & Machine Learning Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Paris Convention Centre, Paris, France\",\n    \"agenda\": \"Day 1: Keynote on Deep Learning, Workshops on NLP & Computer Vision. Day 2: Panel Discussion on Ethical AI, Poster Session. Day 3: Industry Talks, Closing Remarks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Meta AI\"\n        },\n        {\n            \"name\": \"Eve Garcia\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"Amazon Web Services\"\n        },\n        {\n            \"name\": \"Grace Davis\",\n            \"affiliation\": \"Apple AI\"\n        },\n        {\n            \"name\": \"Henry Wilson\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Ivy Moore\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"Jack Taylor\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Karen Anderson\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Liam Thomas\",\n            \"affiliation\": \"National University of Singapore\"\n        },\n        {\n            \"name\": \"Mia Jackson\",\n            \"affiliation\": \"Tsinghua University\"\n        },\n        {\n            \"name\": \"Noah White\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Olivia Harris\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Peter Martin\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Quinn Thompson\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Rachel Garcia\",\n            \"affiliation\": \"Cornell University\"\n        },\n        {\n            \"name\": \"Samuel Martinez\",\n            \"affiliation\": \"Georgia Institute of Technology\"\n        },\n        {\n            \"name\": \"Tina Robinson\",\n            \"affiliation\": \"University of Texas at Austin\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-symposium-paris\"\n}"}
