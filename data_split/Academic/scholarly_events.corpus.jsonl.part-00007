{"_id": "Academic--scholarly_events--p--71066", "text": "{\n    \"event_name\": \"Applied AI Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Workshops on deep learning applications, reinforcement learning, computer vision, and natural language processing. Focus on case studies and practical implementations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://appliedai.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71066", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Institute for Logic and Computation\",\n            \"affiliation\": \"University of Amsterdam\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"University of Amsterdam, Amsterdam, Netherlands\",\n    \"agenda\": \"Presentations on formal methods, computational complexity, and philosophical implications of artificial intelligence. Emphasis on mathematical proofs and abstract models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"Netherlands Organisation for Scientific Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Harel\",\n            \"affiliation\": \"Weizmann Institute of Science\"\n        }\n    ],\n    \"registration_link\": \"https://tfai.uva.nl/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71067", "text": "{\n    \"event_name\": \"AI & Ethics in Practice Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Key topics include responsible AI, fairness, accountability, and transparency in AI systems. Workshops on algorithmic bias and data privacy.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\",\n        \"IEEE\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
