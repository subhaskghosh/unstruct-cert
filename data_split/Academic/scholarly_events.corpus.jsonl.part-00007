{"_id": "Academic--scholarly_events--p--71634", "text": "{\n    \"event_name\": \"International Conference on Natural Language Processing (ICNLP)\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Computational Linguistics (ACL)\",\n            \"affiliation\": \"ACL\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Montreal Convention Centre, Montreal, Canada\",\n    \"agenda\": \"The conference agenda includes workshops on transformer models, neural machine translation, and dialogue systems. Key topics include low-resource language processing, ethical considerations in NLP, and the application of NLP to healthcare.  A detailed schedule with accepted papers is available on the website.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"Facebook AI Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Emily Bender\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"registration_link\": \"https://www.icnlp2024.org/register\"\n}"}
