{"_id": "Academic--scholarly_events--p--70397", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University College London\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"AI Research Institute\"\n        }\n    ],\n    \"event_date\": \"2024-11-03\",\n    \"venue\": \"ExCeL London, London, UK\",\n    \"agenda\": \"Keynote talks on generative AI, reinforcement learning, and computer vision. Panel discussions on the ethical implications of AI. Workshops on advanced deep learning techniques.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google DeepMind\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
