{"_id": "Academic--scholarly_events--p--71156", "text": "{\n    \"event_name\": \"AI & ML Frontiers Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, California, USA\",\n    \"agenda\": \"The conference will cover cutting-edge research in deep learning, natural language processing, computer vision, and reinforcement learning. Key topics include generative AI, ethical considerations, and the future of AI in healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT CSAIL\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aimlfrontiers.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71156", "text": "{\n    \"event_name\": \"AI Solutions Expo\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Events Inc.\",\n            \"affiliation\": \"Private Event Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Las Vegas Convention Center, Nevada, USA\",\n    \"agenda\": \"This expo showcases the latest AI-powered products and services. Expect product demos, vendor booths, and industry presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Beta Solutions\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Microsoft\",\n        \"Salesforce\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Tech Events Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://aisolutions.tech/register\",\n    \"registration_fee\": 750\n}"}
{"_id": "Academic--scholarly_events--p--71157", "text": "{\n    \"event_name\": \"AI & ML Applications in Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Boston, MA - Hynes Convention Center\",\n    \"agenda\": \"Key topics include AI-driven diagnostics, machine learning for drug discovery, and practical challenges in implementing AI in clinical settings. Workshops on TensorFlow and PyTorch will be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Boston University\",\n        \"The Alan Turing Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthsummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71157", "text": "{\n    \"event_name\": \"Foundational Principles of Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"Berkeley, CA - Doe Library\",\n    \"agenda\": \"This workshop will cover the theoretical foundations of machine learning, including statistical learning theory, optimization algorithms, and Bayesian methods.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Alan Turing\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Grace Hopper\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Intel\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://mlfoundations.berkeley.edu\"\n}"}
{"_id": "Academic--scholarly_events--p--71158", "text": "{\n    \"event_name\": \"European Conference on Machine Learning and AI Ethics\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for European ML Researchers\",\n            \"affiliation\": \"Independent Research Organization\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Key topics include fairness, accountability, transparency, and societal impact of AI systems. Workshops on algorithmic bias and data privacy.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Watson\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"Eve White\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Fabian Green\",\n            \"affiliation\": \"Element AI\"\n        },\n        {\n            \"name\": \"Grace Black\",\n            \"affiliation\": \"AI Safety Support\"\n        },\n        {\n            \"name\": \"Henry Gray\",\n            \"affiliation\": \"Centre for Data Ethics and Innovation\"\n        },\n        {\n            \"name\": \"Ivy Purple\",\n            \"affiliation\": \"Partnership on AI\"\n        },\n        {\n            \"name\": \"Jack Indigo\",\n            \"affiliation\": \"The Alan Turing Institute\"\n        },\n        {\n            \"name\": \"Kelly Teal\",\n            \"affiliation\": \"AI Now Institute\"\n        },\n        {\n            \"name\": \"Liam Silver\",\n            \"affiliation\": \"Future of Humanity Institute\"\n        },\n        {\n            \"name\": \"Mia