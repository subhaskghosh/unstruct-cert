{"_id": "Academic--scholarly_events--n--71355", "text": "{\n    \"event_name\": \"International Conference on Robotics and Automation\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"Tokyo Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Focuses on the latest advancements in robotics, automation, and control systems.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"ABB\",\n        \"Fanuc\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Rodney Brooks\",\n            \"affiliation\": \"Rethink Robotics\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/robotics-conference-2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71356", "text": "{\n    \"event_name\": \"AI Ethics and Applications Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include fairness, accountability, transparency, and the societal impact of AI. Includes hands-on workshops and case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"OpenAI\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiethics2024.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71356", "text": "{\n    \"event_name\": \"Advanced Machine Learning Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"MIT Campus, Cambridge, MA\",\n    \"agenda\": \"Focuses on cutting-edge machine learning algorithms, deep learning architectures, and computational modeling. Heavy mathematical focus.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://mlsymposium2024.mit.edu/register\",\n    \"registration_fee\": 650\n}"}
{"_id": "Academic--scholarly_events--p--71357", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Keynotes on latest AI research, workshops on deep learning, and panel discussions on ethical AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71357", "text": "{\n    \"event_name\": \"European AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Institute\",\n            \"affiliation\": \"Independent Organization\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Presentations on AI applications, networking events, and demonstrations of new technologies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Amazon AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Amazon\",\n        \"SAP\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Jürgen Schmidhuber\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"registration_link\": \"https://www.europeanai.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71358", "text": "{\n    \"event_name\": \"European Conference on AI Ethics and Innovation\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Key topics include responsible AI, bias detection and mitigation, AI governance, and the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"European Union AI Fund\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aieuropeconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71358", "text": "{\n    \"event_name\": \"International Machine Learning Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-08-22\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Covers a broad range of machine learning techniques, including deep learning, reinforcement learning, and unsupervised learning. Primarily focuses on technical advancements.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon Web Services\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.iml-symposium.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71359", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"The conference will cover cutting-edge research in areas like generative AI, reinforcement learning, and the latest deep learning architectures (Transformers, diffusion models). Key topics include explainable AI, ethical considerations, and the future of AI in healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"title\": \"Pioneer in Deep Learning\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"title\": \"Leading AI Researcher\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71359", "text": "{\n    \"event_name\": \"European AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Group\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"This summit will explore the broad applications of AI across various sectors including finance, manufacturing, and energy.  Discussions will cover machine learning, data analytics and the potential societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carlos Ramirez\",\n            \"affiliation\": \"IBM Research Europe\"\n        },\n        {\n            \"name\": \"Sophia Chen\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"DeepMind\",\n        \"European Commission\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\",\n            \"title\": \"CEO of DeepMind\"\n        },\n        {\n            \"name\": \"Jürgen Schmidhuber\",\n            \"affiliation\": \"IDSIA\",\n            \"title\": \"AI Researcher\"\n        }\n    ],\n    \"registration_link\": \"https://eurai.org/summit2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71360", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Cutting-edge research in AI, machine learning, deep learning, natural language processing, and robotics. Workshops on novel AI techniques.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aai.org/ai-frontiers-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71360", "text": "{\n    \"event_name\": \"AI in Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Healthcare Innovation Network\",\n            \"affiliation\": \"HIN\"\n        }\n    ],\n    \"event_date\": \"2024-10-27\",\n    \"venue\": \"Boston, MA, USA\",\n    \"agenda\": \"Applications of Artificial Intelligence in medical diagnostics, treatment planning, and patient care. Focus on AI-driven solutions for healthcare challenges.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Mark Johnson\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"sponsors\": [\n        \"Pfizer\",\n        \"Medtronic\",\n        \"UnitedHealth Group\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Eric Topol\",\n            \"affiliation\": \"Scripps Research\"\n        }\n    ],\n    \"registration_link\": \"https://www.healthcareinnovationsummit.com\"\n}"}
