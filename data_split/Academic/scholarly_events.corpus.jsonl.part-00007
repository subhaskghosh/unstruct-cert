{"_id": "Academic--scholarly_events--p--70279", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"CSAIL\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include Deep Learning, Natural Language Processing, Computer Vision, Reinforcement Learning, and applications of AI in healthcare and finance.  Dedicated workshops and tutorials on the latest AI techniques.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70279", "text": "{\n    \"event_name\": \"Workshop on Computational Linguistics\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"Department of Linguistics\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"Focuses on syntactic analysis, semantic interpretation, and computational modeling of language. Discussions on morphology, phonology and discourse analysis.  A small working group will explore statistical methods in linguistics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Ben Williams\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Noam Chomsky\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.clworkshop.berkeley.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70280", "text": "{\n    \"event_name\": \"AI & Ethics in Practice Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"University College London\"\n        },\n        {\n            \"name\": \"Professor David Chen\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"University of Westminster, London\",\n    \"agenda\": \"Keynotes on AI bias, fairness, accountability, and transparency. Workshops on practical ethical AI development. Panel discussions on the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google DeepMind\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"sponsors\": [\n        \"University College London\",\n        \"The Alan Turing Institute\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Joy Buolamwini\",\n            \"affiliation\": \"MIT Media Lab\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicslondon.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70280", "text": "{\n    \"event_name\": \"Intro to Machine Learning Bootcamp\",\n    \"organizers\": [\n        {\n            \"name\": \"Sarah Lee\",\n            \"affiliation\": \"CodeFirstGirls\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Imperial College London\",\n    \"agenda\": \"A beginner-friendly introduction to machine learning algorithms. Hands-on coding tutorials using Python and Scikit-learn. Focus on practical applications of ML.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Imperial College London (Undergraduate)\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"University of Bristol (Undergraduate)\"\n        }\n    ],\n    \"sponsors\": [\n        \"CodeFirstGirls\",\n        \"Imperial College Computing Society\"\n    ],\n    \"keynote_speakers\": [],\n    \"registration_link\": \"https://www.codefirstgirls.org/bootcamp\"\n}"}
