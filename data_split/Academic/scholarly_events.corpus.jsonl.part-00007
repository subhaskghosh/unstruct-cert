{"_id": "Academic--scholarly_events--p--71196", "text": "{\n    \"event_name\": \"International Conference on Deep Learning (ICDL)\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence (AAAI)\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-02-22\",\n    \"venue\": \"New York City, NY\",\n    \"agenda\": \"Cutting-edge research in deep learning, including convolutional neural networks, recurrent neural networks, and generative adversarial networks. Workshops on model deployment and ethical considerations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.icdlconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71196", "text": "{\n    \"event_name\": \"Introduction to Deep Learning Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Local AI Meetup Group\",\n            \"affiliation\": \"Meetup.com\"\n        }\n    ],\n    \"event_date\": \"2024-02-10\",\n    \"venue\": \"Small Town Community Center, Anytown, USA\",\n    \"agenda\": \"A beginner-friendly workshop covering the basics of neural networks and simple deep learning models using TensorFlow. Hands-on coding exercises included.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Local University Student\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"High School Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Company\"\n    ],\n    \"keynote_speakers\": [],\n    \"registration_link\": \"https://www.meetup.com/local-ai/events/workshop\"\n}"}
