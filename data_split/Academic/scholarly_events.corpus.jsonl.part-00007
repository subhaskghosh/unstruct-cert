{"_id": "Academic--scholarly_events--p--71888", "text": "{\n    \"event_name\": \"European Conference on Advanced Machine Learning (ECAML)\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for Machine Learning\",\n            \"affiliation\": \"EAML\"\n        }\n    ],\n    \"event_date\": \"2024-08-22\",\n    \"venue\": \"University of Amsterdam, Netherlands\",\n    \"agenda\": \"Key topics include Deep Learning, Reinforcement Learning, Generative Models, and Explainable AI. Workshops and tutorials will be available.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Ethan Miller\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Fiona Wilson\",\n            \"affiliation\": \"Imperial College London\"\n        },\n        {\n            \"name\": \"George Taylor\",\n            \"affiliation\": \"CMU\"\n        },\n        {\n            \"name\": \"Hannah White\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Isaac Hall\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Julia Green\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Kevin Adams\",\n            \"affiliation\": \"Facebook AI Research\"\n        },\n        {\n            \"name\": \"Linda Baker\",\n            \"affiliation\": \"University College London\"\n        },\n        {\n            \"name\": \"Michael Clark\",\