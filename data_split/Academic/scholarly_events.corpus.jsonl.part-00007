{"_id": "Academic--scholarly_events--n--70394", "text": "{\n    \"event_name\": \"Workshop on Data Science Fundamentals\",\n    \"organizers\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Local Community College\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Community College Auditorium, Anytown, USA\",\n    \"agenda\": \"Introduction to Python, Data Visualization, Basic Statistical Analysis.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Beginner Data Analyst\"\n        }\n    ],\n    \"sponsors\": [\n        \"Acme Analytics\",\n        \"Data Solutions Inc.\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Data Solutions Inc.\",\n            \"publications\": \"Blog posts on data science basics\"\n        }\n    ],\n    \"registration_link\": \"https://www.datascienceworkshop.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70395", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"Keynote speeches, research paper presentations, workshops on deep learning, reinforcement learning, and natural language processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiml.org/registration\"\n}"}
