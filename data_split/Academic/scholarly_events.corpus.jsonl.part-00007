{"_id": "Academic--scholarly_events--p--71138", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"MIT CSAIL\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Keynote talks on AI applications in healthcare, finance, and autonomous systems. Workshops on deep learning frameworks and reinforcement learning. Poster sessions showcasing cutting-edge research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71138", "text": "{\n    \"event_name\": \"AI Research Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-08-15\",\n    \"venue\": \"University of California, Berkeley\",\n    \"agenda\": \"Focuses on theoretical foundations of AI. Includes paper presentations and discussions on topics such as probabilistic graphical models and Bayesian inference.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Michael I. Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiworkshop.berkeley.edu/register\",\n    \"cost\": \"600\"\n}"}
{"_id": "Academic--scholarly_events--p--71139", "text": "{\n    \"event_name\": \"International Conference on Advanced Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Cutting-edge research in Machine Learning, Deep Learning, Natural Language Processing, and Robotics. Includes workshops on novel algorithms and ethical considerations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        },\n        {\n            \"name\": \"Dr. Daphne Koller\",\n            \"affiliation\": \"Insitro\"\n        },\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        },\n        {\n            \"name\": \"Dr. Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Dr. Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"Mila\"\n        },\n        {\n            \"name\": \"Dr. Richard Sutton\",\n            \"affiliation\": \"University of Alberta\"\n        },\n        {\n            \"name\": \"Dr. Stuart Russell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"The Future of Visual Intelligence\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"topic\": \"Generative Models and the Future of AI\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71139", "text": "{\n    \"event_name\": \"AI in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"HealthTech Solutions Inc.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Boston Convention Center, Boston, MA\",\n    \"agenda\": \"Application of Artificial Intelligence in diagnostics, drug discovery, and patient care. Case studies and practical implementations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Johns Hopkins University\"\n        },\n        {\n            \"name\": \"Dr. Michael Brown\",\n            \"affiliation\": \"Cleveland Clinic\"\n        },\n        {\n            \"name\": \"Dr. Lisa Garcia\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM Watson Health\",\n        \"Philips Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\",\n            \"topic\": \"AI-Powered Diagnostics\"\n        }\n    ],\n    \"registration_link\": \"https://ai-healthcare.com/register\",\n    \"registration_fee\": 600\n}"}
