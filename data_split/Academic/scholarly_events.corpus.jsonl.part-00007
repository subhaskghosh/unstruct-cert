{"_id": "Academic--scholarly_events--p--71845", "text": "{\n    \"event_name\": \"AI Ethics and Governance Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University, Center for AI Safety\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT, Department of Electrical Engineering and Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-08\",\n    \"venue\": \"New York City, NY - Jacob K. Javits Convention Center\",\n    \"agenda\": \"Keynote speeches on AI bias, fairness, accountability, and transparency. Panel discussions on responsible AI development and deployment. Workshops on AI ethics frameworks and regulatory compliance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Dr. Joy Buolamwini\",\n            \"affiliation\": \"MIT Media Lab\"\n        },\n        {\n            \"name\": \"Dr. Stuart Russell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71845", "text": "{\n    \"event_name\": \"AI Practical Workshop Series\",\n    \"organizers\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"DataCamp\"\n        }\n    ],\n    \"event_date\": \"2024-10-27\",\n    \"venue\": \"Seattle, WA - DataCamp HQ\",\n    \"agenda\": \"Hands-on workshops covering Python for AI, machine learning algorithms, and data visualization techniques.\",\n    \"attendees\": [\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Amazon\"\n        },\n        {\n            \"name\": \"Frank Davis\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"sponsors\": [\n        \"DataCamp\",\n        \"Anaconda\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"DataCamp Instructor\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Anaconda Developer\"\n        }\n    ],\n    \"registration_link\": \"https://www.datacamp.com/ai-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71846", "text": "{\n    \"event_name\": \"AI Ethics in Practice Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Institute for Responsible AI\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University, California, USA\",\n    \"agenda\": \"Keynote on AI bias, workshop on fairness metrics, panel discussion on regulatory frameworks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Alice Lee\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. David Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconf.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71846", "text": "{\n    \"event_name\": \"Comprehensive AI and Machine Learning Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Robert Johnson\",\n            \"affiliation\": \"Global Tech Events\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"New York City, USA\",\n    \"agenda\": \"A detailed exploration of all aspects of AI and Machine Learning, covering historical foundations, current trends, advanced algorithms, applications in various industries, future prospects, and emerging research directions. Includes multiple tracks, workshops, and poster sessions. The event spans four full days and features over 100 individual sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Emily White\",\n            \"affiliation\": \"Data Insights Corp\"\n        },\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"Acme Analytics\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Sarah Williams\",\n            \"affiliation\": \"TechForward Consulting\"\n        }\n    ],\n    \"registration_link\": \"https://www.aimlsymposium.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71847", "text": "{\n    \"event_name\": \"European AI & ML Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"ETH Zurich\",\n            \"affiliation\": \"Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Geneva, Switzerland\",\n    \"agenda\": \"Topics include deep learning, computer vision, natural language processing, and reinforcement learning. Workshops and tutorials will be provided.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"citation_count\": 125000\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"citation_count\": 150000\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-symposium-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71847", "text": "{\n    \"event_name\": \"International Conference on Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Broad overview of data science techniques, including machine learning, data mining, and statistical analysis.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Accenture\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Accenture\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Jane Miller\",\n            \"affiliation\": \"Industry Analyst\",\n            \"citation_count\": 500\n        }\n    ],\n    \"registration_link\": \"https://example.com/data-science-conf\"\n}"}
{"_id": "Academic--scholarly_events--p--71848", "text": "{\n    \"event_name\": \"European Conference on AI and Robotics\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Technical University of Munich\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Berlin Congress Center, Germany\",\n    \"agenda\": \"Key topics include machine learning, computer vision, robotics, and ethical AI.  Sessions will include workshops, paper presentations, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"European Union Horizon Program\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-robotics-berlin.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71848", "text": "{\n    \"event_name\": \"International Medical Imaging Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"event_date\": \"2024-04-22\",\n    \"venue\": \"Paris Convention Centre, France\",\n    \"agenda\": \"Focuses on the latest advancements in medical imaging techniques, including MRI, CT scans, and ultrasound. Workshops on image analysis and diagnostics will be provided.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Carlos Silva\",\n            \"affiliation\": \"University of Lisbon\"\n        },\n        {\n            \"name\": \"Dr. Hana Kim\",\n            \"affiliation\": \"Seoul National University Hospital\"\n        }\n    ],\n    \"sponsors\": [\n        \"Siemens Healthineers\",\n        \"GE Healthcare\",\n        \"Philips Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Robert Green\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Professor Isabelle Dubois\",\n            \"affiliation\": \"Université de Paris\"\n        }\n    ],\n    \"registration_link\": \"https://www.medicalimagingconf.fr/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71849", "text": "{\n    \"event_name\": \"International Conference on Deep Learning and Artificial Intelligence (ICDLAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include convolutional neural networks, recurrent neural networks, generative models, and applications in computer vision, natural language processing, and robotics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.icdlai.org/register\"\n}"}
