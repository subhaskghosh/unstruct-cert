{"_id": "Academic--scholarly_events--p--70371", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford AI Lab\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT CSAIL\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"This conference explores the latest advancements in deep learning, generative AI, and reinforcement learning, featuring talks on novel architectures and applications. It focuses on cutting-edge research and innovative solutions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70371", "text": "{\n    \"event_name\": \"Data Science Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Toronto, Canada\",\n    \"agenda\": \"A broad overview of data science techniques, including statistical modeling, machine learning, and data visualization.  Topics will cover practical applications and industry best practices.\",\n    \"attendees\": [\n        {\n            \"name\": \"Chris Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Amazon\",\n        \"Accenture\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://datascience.symposium.ca/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70372", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston, MA\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Workshops and tutorials will also be offered.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiaml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70372", "text": "{\n    \"event_name\": \"Regional Workshop on Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Local Data Science Meetup Group\",\n            \"affiliation\": \"Community Organization\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Austin, TX\",\n    \"agenda\": \"Introduction to data science tools and techniques. Focus on practical applications and hands-on exercises.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Individual Learner\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Small Business Owner\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Company\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Local Data Science Consultant\"\n        }\n    ],\n    \"registration_link\": \"https://www.meetup.com/datascienceaustin/events/123456\"\n}"}
{"_id": "Academic--scholarly_events--p--70373", "text": "{\n    \"event_name\": \"European AI & Robotics Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"IEEE Robotics and Automation Society\",\n            \"affiliation\": \"IEEE\"\n        },\n        {\n            \"name\": \"European Association for Artificial Intelligence\",\n            \"affiliation\": \"EurAI\"\n        }\n    ],\n    \"event_date\": \"2024-11-08\",\n    \"venue\": \"Paris Convention Centre, Paris, France\",\n    \"agenda\": \"This summit will feature cutting-edge research in areas such as generative AI, embodied AI, and collaborative robotics. The focus is on novel approaches and disruptive technologies. Includes workshops on creating AI driven solutions for environmental sustainability.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Professor Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"Amazon Robotics\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.airobotics-summit.eu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70373", "text": "{\n    \"event_name\": \"International Conference on Biomedical Imaging\",\n    \"organizers\": [\n        {\n            \"name\": \"SPIE\",\n            \"affiliation\": \"SPIE - The international society for optics and photonics\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"Berlin ExpoCenter City, Berlin, Germany\",\n    \"agenda\": \"This conference focuses on the latest advancements in medical image analysis, diagnostics, and therapeutic applications. Sessions will cover topics such as MRI, CT scans, and ultrasound imaging. The goal is to explore the role of imaging in disease detection and treatment.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Hans Müller\",\n            \"affiliation\": \"Charité – Universitätsmedizin Berlin\"\n        }\n    ],\n    \"sponsors\": [\n        \"Siemens Healthineers\",\n        \"Philips Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"registration_link\": \"https://www.biomedicalimagingconf.org/register\"\n}"}
