{"_id": "Academic--scholarly_events--p--71985", "text": "{\n    \"event_name\": \"AI in Healthcare Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Mayo Clinic Research\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"The summit will cover applications of AI in medical imaging, diagnostics, drug discovery, and personalized medicine.  Workshops on deep learning, natural language processing, and ethical considerations in AI healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Intel\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Daphne Koller\",\n            \"affiliation\": \"insitro\"\n        },\n        {\n            \"name\": \"Dr. Eric Topol\",\n            \"affiliation\": \"Scripps Research\"\n        },\n        {\n            \"name\": \"Dr. Regina Barzilay\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcare.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71985", "text": "{\n    \"event_name\": \"Foundational AI Theories Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Alan Turing Institute\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Cambridge, UK\",\n    \"agenda\": \"A workshop focused on the mathematical and logical foundations of Artificial Intelligence, with sessions on Bayesian networks, Markov decision processes, and formal verification.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        },\n        {\n            \"name\": \"Dr. Michael Wooldridge\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"Palantir\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        },\n        {\n            \"name\": \"Dr. Michael Wooldridge\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Stuart Russell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://foundationalai.cam.ac.uk\"\n}"}
