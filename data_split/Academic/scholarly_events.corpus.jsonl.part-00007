{"_id": "Academic--scholarly_events--p--70241", "text": "{\n    \"event_name\": \"AI Applications in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This workshop focuses on the practical application of AI in healthcare, covering topics like medical image analysis, drug discovery, and patient monitoring. Sessions will include case studies and hands-on tutorials.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Google\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/aihealthcareworkshop\"\n}"}
{"_id": "Academic--scholarly_events--n--70241", "text": "{\n    \"event_name\": \"Foundational Aspects of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Department of Electrical Engineering and Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"MIT Media Lab, Cambridge, MA\",\n    \"agenda\": \"This conference explores the theoretical foundations of AI, including logic, probability, and computational learning theory. Emphasis is placed on formal verification and algorithmic complexity.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor John Smith\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://www.mit.edu/ai-foundations\"\n}"}
