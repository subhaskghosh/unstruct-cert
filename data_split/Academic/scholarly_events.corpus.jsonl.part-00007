{"_id": "Academic--scholarly_events--p--71993", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference explores the ethical implications of artificial intelligence, covering topics like bias, fairness, accountability, and transparency.  Sessions will include workshops on responsible AI development and panel discussions on the societal impact of AI. Focus is on novel research and forward-thinking solutions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71993", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"Global Tech Innovations Ltd.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Hyatt Regency, Chicago, IL\",\n    \"agenda\": \"This conference focuses on the practical applications of AI across various industries.  Sessions will cover machine learning, deep learning, and natural language processing. It will showcase case studies and vendor presentations. A large exhibition will also be part of the event.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Microsoft\",\n        \"AWS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alan Turing Jr.\",\n            \"affiliation\": \"Global Tech Innovations Ltd.\"\n        }\n    ],\n    \"registration_link\": \"https://aiapplicationsconference.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71994", "text": "{\n    \"event_name\": \"AI Ethics and Safety Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Topics include: Fairness in AI, Explainable AI, AI Security, Robustness, and Societal Impact of AI.  Includes research presentations, panel discussions, and workshops.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT CSAIL\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Stuart Russell\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71994", "text": "{\n    \"event_name\": \"Introductory AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"DataCamp\",\n            \"affiliation\": \"DataCamp Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Online\",\n    \"agenda\": \"A hands-on workshop covering the basics of machine learning with Python. Topics include linear regression, classification, and clustering.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Self-Employed\"\n        }\n    ],\n    \"sponsors\": [\n        \"DataCamp\"\n    ],\n    \"keynote_speakers\": [],\n    \"registration_link\": \"https://datacamp.com/aiworkshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71995", "text": "{\n    \"event_name\": \"European AI & ML Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"ETH Zurich\",\n            \"affiliation\": \"Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Geneva, Switzerland\",\n    \"agenda\": \"Key topics include Deep Learning, Reinforcement Learning, Natural Language Processing, and Computer Vision. Workshops and tutorials will also be available.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-symposium-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71995", "text": "{\n    \"event_name\": \"International Conference on Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Data Insights Inc.\",\n            \"affiliation\": \"Private Research Firm\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Covers various data science techniques, including Machine Learning, Statistical Modeling, and Data Visualization.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"SAS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/data-science-conf-2024\",\n    \"registration_fee\": 600\n}"}
{"_id": "Academic--scholarly_events--p--71996", "text": "{\n    \"event_name\": \"AI Ethics and Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University AI Lab\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"MIT Media Lab\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Day 1: Large Language Models - Theory and Practice.\\nDay 2: Computer Vision - Advancements and Challenges.\\nDay 3: Ethical Considerations in AI Deployment.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Partnership on AI\",\n        \"OpenAI Safety Fund\",\n        \"AI Now Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71996", "text": "{\n    \"event_name\": \"AI for Business Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Tech Events Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-11-22\",\n    \"venue\": \"Grand Hyatt, New York City\",\n    \"agenda\": \"Day 1: AI Solutions for Marketing and Sales.\\nDay 2: Leveraging AI for Financial Analysis.\\nDay 3: AI-Powered Customer Service.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Microsoft\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Satya Nadella\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"registration_link\": \"https://aiforbusiness.tech/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71997", "text": "{\n    \"event_name\": \"AI Frontiers Conference - Boston 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"MIT AI Lab\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-11-22\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Keynotes on Deep Learning, Reinforcement Learning, Natural Language Processing, and AI Ethics. Poster sessions and workshops.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/boston2024/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71997", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"New York Marriott Marquis, New York, NY\",\n    \"agenda\": \"Case studies of AI implementation in various industries. Vendor presentations and networking events.\",\n    \"attendees\": [\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Salesforce\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"IBM\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Williams\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiinbusinesssummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71998", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-12-01\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Keynotes on Deep Learning, NLP, Computer Vision, Robotics, and AI Ethics. Workshops and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71998", "text": "{\n    \"event_name\": \"Advanced Robotics Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Robotics Society of America\",\n            \"affiliation\": \"RSA\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"Boston, MA\",\n    \"agenda\": \"Hands-on workshops on robot programming and control. Focus on industrial applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Boston Dynamics\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"ABB Robotics\"\n        }\n    ],\n    \"sponsors\": [\n        \"ABB\",\n        \"FANUC\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Rodney Brooks\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.roboticsworkshop.org/register\"\n}"}
