{"_id": "Academic--scholarly_events--p--70845", "text": "{\n    \"event_name\": \"AI & Robotics in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Healthcare Innovation Labs\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Sessions on applying AI in diagnostics, personalized medicine, and robotic surgery. Hands-on workshops on using TensorFlow and PyTorch for medical image analysis. Keynote on ethical considerations in AI healthcare applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"NVIDIA\",\n        \"Intel\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-healthcare-workshop\"\n}"}
