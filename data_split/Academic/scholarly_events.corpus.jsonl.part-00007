{"_id": "Academic--scholarly_events--p--71758", "text": "{\n    \"event_name\": \"AI & ML for Practical Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI/ML to real-world problems. Topics include computer vision, NLP, and reinforcement learning. Focus on practical implementations and case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-workshop-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71758", "text": "{\n    \"event_name\": \"Foundations of Artificial General Intelligence Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Massachusetts Institute of Technology (MIT)\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-08-15\",\n    \"venue\": \"MIT Media Lab, Cambridge, MA\",\n    \"agenda\": \"A deep dive into the theoretical underpinnings of Artificial General Intelligence (AGI).  Covers topics like formal logic, computational complexity, and the philosophy of mind. Advanced mathematical models will be presented.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alan Turing Jr.\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Grace Hopper III\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/agi-conference-registration\",\n    \"registration_fee\": 650\n}"}
{"_id": "Academic--scholarly_events--p--71759", "text": "{\n    \"event_name\": \"AI Frontiers Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford AI Lab\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"MIT CSAIL\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Asilomar Conference Center, Pacific Grove, CA\",\n    \"agenda\": \"Focus on recent advancements in deep learning, reinforcement learning, and generative models. Includes workshops and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Google Brain\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"Element AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiersworkshop.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71759", "text": "{\n    \"event_name\": \"International Conference on Machine Learning (ICML) 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"ICML Organizing Committee\",\n            \"affiliation\": \"Various Universities\"\n        }\n    ],\n    \"event_date\": \"2024-07-21\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Comprehensive coverage of all areas of machine learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Amazon AI\"\n        },\n        {\n            \"name\": \"Bob White\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/conferences/2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71760", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University AI Lab\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"AI Frontiers Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Key topics include Generative Models, Reinforcement Learning, Computer Vision, and the ethical implications of AI. Poster sessions and workshops will also be included.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71760", "text": "{\n    \"event_name\": \"AI Workshop Series - Beginner Level\",\n    \"organizers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Local Tech Meetup Group\"\n        }\n    ],\n    \"event_date\": \"2024-12-10\",\n    \"venue\": \"New York, NY, USA\",\n    \"agenda\": \"This workshop provides a hands-on introduction to the basics of Artificial Intelligence, focusing on practical implementation of machine learning algorithms. No prior experience required.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Brown\",\n            \"affiliation\": \"None\"\n        },\n        {\n            \"name\": \"Tom Davis\",\n            \"affiliation\": \"Freelance Developer\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Company\"\n    ],\n    \"keynote_speakers\": [],\n    \"registration_link\": \"https://www.localtechgroup.com/aiworkshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71761", "text": "{\n    \"event_name\": \"European Conference on Artificial Intelligence (ECAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence (AAAI)\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"The conference will cover a wide range of AI topics, including machine learning, knowledge representation, reasoning, robotics, natural language processing, and computer vision. Emphasis will be placed on theoretical foundations and advancements.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"sponsors\": [\n        \"University of Vienna\",\n        \"DFKI (German Research Center for Artificial Intelligence)\",\n        \"European Association for Artificial Intelligence\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.ecai.org/2024/registration/\"\n}"}
{"_id": "Academic--scholarly_events--n--71761", "text": "{\n    \"event_name\": \"AI in Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"HealthTech Innovations\",\n            \"affiliation\": \"HealthTech Innovations Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-03-10\",\n    \"venue\": \"Barcelona, Spain\",\n    \"agenda\": \"Focuses on the application of AI technologies in healthcare, covering topics like medical imaging, drug discovery, and patient monitoring. Practical workshops and case studies will be presented.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"sponsors\": [\n        \"Johnson & Johnson\",\n        \"Pfizer\",\n        \"Philips Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Stanford Medicine\"\n        }\n    ],\n    \"registration_link\": \"https://www.aihealthcaresummit.com/register\"\n}"}
