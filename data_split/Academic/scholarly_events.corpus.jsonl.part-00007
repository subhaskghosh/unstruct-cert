{"_id": "Academic--scholarly_events--n--70480", "text": "{\n    \"event_name\": \"AI Applications in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Mark Thompson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-03-20\",\n    \"venue\": \"San Francisco Marriott Marquis\",\n    \"agenda\": \"Exploring practical applications of AI in marketing, sales, and customer service. Case studies and workshops on AI tools for business.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Salesforce\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"IBM\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"TechCorp Analytics\",\n            \"expertise\": \"AI in Marketing\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiinbusiness.com/register\"\n}"}
