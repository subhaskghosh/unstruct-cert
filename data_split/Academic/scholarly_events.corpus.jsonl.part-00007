{"_id": "Academic--scholarly_events--n--70664", "text": "{\n    \"event_name\": \"Historical Linguistics Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Oxford University\",\n            \"affiliation\": \"Faculty of Linguistics\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Oxford University, Oxford, UK\",\n    \"agenda\": \"This symposium focuses on the historical development of languages, covering topics such as etymology, comparative linguistics, and language change. Presentations will examine various linguistic families and their evolution over time.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Dr. Ben Williams\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"sponsors\": [\n        \"The British Academy\",\n        \"Oxford University Press\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Noam Chomsky\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/linguistics-symposium\"\n}"}
