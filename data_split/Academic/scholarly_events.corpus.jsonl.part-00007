{"_id": "Academic--scholarly_events--n--71601", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial Intelligence Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Elena Petrova\",\n            \"affiliation\": \"Moscow State University\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"Focuses on the mathematical and logical underpinnings of AI, including formal methods, knowledge representation, and automated reasoning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Catherine Brown\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Henry Davis\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"The Leverhulme Trust\",\n        \"The Royal Society\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://tfaiconf.org/register\"\n}"}
