{"_id": "Academic--scholarly_events--p--71188", "text": "{\n    \"event_name\": \"AI in Healthcare Workshop & Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Healthcare Innovation Alliance\",\n            \"affiliation\": \"Non-profit Organization\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Keynote speeches on AI applications in diagnostics, machine learning for drug discovery, hands-on workshops on TensorFlow and PyTorch for medical imaging, panel discussion on ethical considerations in AI healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\",\n        \"IBM Watson Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aihealthcareconf\"\n}"}
{"_id": "Academic--scholarly_events--n--71188", "text": "{\n    \"event_name\": \"International Conference on Theoretical Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Massachusetts Institute of Technology (MIT)\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Cambridge, MA\",\n    \"agenda\": \"Presentations on advanced mathematical foundations of machine learning, rigorous analysis of algorithms, and theoretical limits of learning. Focus is on purely theoretical contributions with minimal discussion of practical implementation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        },\n        {\n            \"name\": \"Professor Sarah Chen\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"DARPA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/tmlconf\"\n}"}
