{"_id": "Academic--scholarly_events--p--70828", "text": "{\n    \"event_name\": \"AI in Healthcare & Life Sciences Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Biomedical Informatics\"\n        },\n        {\n            \"name\": \"Harvard Medical School\",\n            \"affiliation\": \"Center for AI in Medicine\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Keynote speeches on AI-driven diagnostics, machine learning in drug discovery, ethical considerations in AI healthcare, and workshops on implementing AI solutions in clinical settings.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google Health\",\n        \"IBM Watson Health\",\n        \"National Institutes of Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthsummit.com/register\"\n}"}
