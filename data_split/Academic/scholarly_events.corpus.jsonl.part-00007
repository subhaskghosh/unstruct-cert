{"_id": "Academic--scholarly_events--p--71844", "text": "{\n    \"event_name\": \"European Conference on Artificial Intelligence (ECAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence (AAAI)\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Workshops, tutorials, and presentations covering all aspects of AI, including machine learning, knowledge representation, and reasoning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"European Commission\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.ecai.org/2024/registration\"\n}"}
