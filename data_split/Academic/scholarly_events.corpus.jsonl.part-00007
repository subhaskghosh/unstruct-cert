{"_id": "Academic--scholarly_events--p--71407", "text": "{\n    \"event_name\": \"California AI Research Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"UC Berkeley Center for Human-Compatible AI\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"The symposium will cover recent advances in deep learning, reinforcement learning, natural language processing, and computer vision.  Key topics include generative models, explainable AI, and the ethical implications of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"Meta AI\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"topic\": \"Capsule Networks and the Future of Deep Learning\"\n        }\n    ],\n    \"registration_link\": \"https://cairs.stanford.edu/register\"\n}"}
