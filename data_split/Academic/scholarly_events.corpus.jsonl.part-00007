{"_id": "Academic--scholarly_events--p--71952", "text": "{\n    \"event_name\": \"European AI Applications Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Institute\",\n            \"affiliation\": \"University of Amsterdam\"\n        },\n        {\n            \"name\": \"TechForward Events\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Berlin Congress Center, Berlin, Germany\",\n    \"agenda\": \"The conference will cover practical applications of AI in healthcare, finance, and manufacturing. Workshops will focus on deep learning, natural language processing, and computer vision. Case studies will be presented by industry leaders.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"IBM\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-berlin\"\n}"}
{"_id": "Academic--scholarly_events--n--71952", "text": "{\n    \"event_name\": \"International Symposium on Theoretical AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Global AI Foundation\",\n            \"affiliation\": \"Independent Research Organization\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"Oxford University, Oxford, United Kingdom\",\n    \"agenda\": \"This symposium will delve into the mathematical foundations of AI, focusing on topics such as computational complexity, formal verification, and Bayesian networks. There will be no hands-on workshops or industry case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor David Miller\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/theoretical-ai-oxford\"\n}"}
