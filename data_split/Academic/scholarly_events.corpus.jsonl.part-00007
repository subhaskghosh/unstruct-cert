{"_id": "Academic--scholarly_events--n--71961", "text": "{\n    \"event_name\": \"AI for Business Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"TechSolutions Inc.\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York City Financial District\",\n    \"agenda\": \"Case studies on AI implementation in marketing, finance, and supply chain. Workshops on AI-powered sales tools. Demonstrations of the latest AI platforms.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Microsoft\",\n        \"Salesforce\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Mark Thompson\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://www.aibusinesstummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71962", "text": "{\n    \"event_name\": \"AI & Society: A Multidisciplinary Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Discussions on the ethical, legal, and societal implications of AI. Includes panels on AI and healthcare, AI and education, and AI and bias.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"registration_link\": \"https://aisocietyconf.berkeley.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71962", "text": "{\n    \"event_name\": \"Advanced Deep Learning Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"TechForward Inc.\",\n            \"affiliation\": \"TechForward\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"In-depth exploration of advanced deep learning techniques, including generative models, reinforcement learning, and graph neural networks.  Requires strong programming and mathematical background.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Diana Edwards\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Amazon AWS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"registration_link\": \"https://dlworkshop.techforward.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71963", "text": "{\n    \"event_name\": \"International Conference on Advanced Artificial Intelligence (ICAAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Grand Convention Center, San Francisco, CA\",\n    \"agenda\": \"Day 1: Keynote on Generative AI, Workshops on Deep Learning Architectures. Day 2: Panel discussion on Ethical AI, Paper presentations on Computer Vision and NLP. Day 3: Tutorials on Reinforcement Learning and Robotics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"expertise\": \"Neural Networks\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaai.org/register\"\n}"}
