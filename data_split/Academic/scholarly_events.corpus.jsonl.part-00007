{"_id": "Academic--scholarly_events--n--70666", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Oxford University Future of Humanity Institute\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"Discussions surrounding the ethical considerations, societal impact, and policy challenges of artificial intelligence.  Topics include bias, fairness, accountability, and transparency.\",\n    \"attendees\": [\n        {\n            \"name\": \"Kate Crawford\",\n            \"affiliation\": \"University of Southern California\"\n        },\n        {\n            \"name\": \"Nick Bostrom\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Partnership on AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Francesca Rossi\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.org/\"\n}"}
