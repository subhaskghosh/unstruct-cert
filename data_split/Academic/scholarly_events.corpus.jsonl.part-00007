{"_id": "Academic--scholarly_events--p--71780", "text": "{\n    \"event_name\": \"AI in Robotics Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Zurich\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Zurich, Switzerland\",\n    \"agenda\": \"Focuses on the latest advancements in AI algorithms for robotic applications, including reinforcement learning, computer vision, and path planning. Includes hands-on workshops and presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google Robotics\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Boston Dynamics\"\n        }\n    ],\n    \"sponsors\": [\n        \"Robotics Institute of America\",\n        \"Swiss National Science Foundation\",\n        \"IEEE Robotics and Automation Society\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Kai Li\",\n            \"affiliation\": \"MIT CSAIL\"\n        }\n    ],\n    \"registration_link\": \"https://www.airoboticsworkshop.ch/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71780", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence (ICAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"ICAI Organizing Committee\",\n            \"affiliation\": \"Association for the Advancement of Artificial Intelligence\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"A comprehensive conference covering all aspects of artificial intelligence, from theoretical foundations to practical applications. Features keynote speeches, workshops, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Google\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiconference.org/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71781", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence (ICAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Topics include machine learning, deep learning, natural language processing, computer vision, robotics, and AI ethics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"expertise\": \"Neural Networks\"\n        }\n    ],\n    \"registration_link\": \"https://www.icai-conference.org/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71781", "text": "{\n    \"event_name\": \"AI in Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Mayo Clinic\",\n            \"affiliation\": \"Research Department\"\n        }\n    ],\n    \"event_date\": \"2024-11-22\",\n    \"venue\": \"San Diego Convention Center, San Diego, CA\",\n    \"agenda\": \"Focuses on applications of AI in medical diagnosis, drug discovery, and personalized medicine. Includes workshops on AI-powered imaging and robotic surgery.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Johns Hopkins Hospital\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford Health Care\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM Watson Health\",\n        \"Philips Healthcare\",\n        \"GE Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\",\n            \"expertise\": \"Machine Learning in Healthcare\"\n        }\n    ],\n    \"registration_link\": \"https://www.aihealthcare-summit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71782", "text": "{\n    \"event_name\": \"European AI & Machine Learning Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Oxford, United Kingdom\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Workshops and networking sessions will be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-symposium-2024\"\n}"}
