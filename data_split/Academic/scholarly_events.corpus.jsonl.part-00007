{"_id": "Academic--scholarly_events--n--71217", "text": "{\n    \"event_name\": \"Advanced Theoretical Foundations in Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Mathematical AI Society\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Princeton University, NJ\",\n    \"agenda\": \"In-depth discussions on the mathematical principles underlying AI algorithms. Presentations on cutting-edge research in theoretical computer science and AI. Focus on formal proofs and abstract concepts.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Dr. Susan Chen\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Michael Brown\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/theoretical-ai\"\n}"}
