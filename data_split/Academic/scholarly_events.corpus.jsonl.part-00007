{"_id": "Academic--scholarly_events--n--71544", "text": "{\n    \"event_name\": \"Advanced Robotics Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Robotics Institute\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Pittsburgh, PA\",\n    \"agenda\": \"Robotics, Automation, Control Systems, AI integration in Robotics\",\n    \"attendees\": [\n        {\n            \"name\": \"Carlos Hernandez\",\n            \"affiliation\": \"Boston Dynamics\"\n        },\n        {\n            \"name\": \"Diana Lee\",\n            \"affiliation\": \"NASA\"\n        }\n    ],\n    \"sponsors\": [\n        \"Boston Dynamics\",\n        \"NASA\",\n        \"ABB\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Rodney Brooks\",\n            \"affiliation\": \"Rethink Robotics\"\n        }\n    ],\n    \"registration_link\": \"https://www.roboticsworkshop.org/register\",\n    \"registration_fee\": 800\n}"}
{"_id": "Academic--scholarly_events--p--71545", "text": "{\n    \"event_name\": \"AI in Business Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"TechForward Events\",\n            \"affiliation\": \"Event Management Co.\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA - Moscone Center\",\n    \"agenda\": \"Sessions on AI implementation in marketing, finance, and healthcare. Workshops on machine learning tools and techniques. Case studies from leading companies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Amazon\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"StartUp X\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"AWS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Mark Anderson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71545", "text": "{\n    \"event_name\": \"Foundational Concepts in Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Center for AI Research\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Berkeley, CA - Doe Library\",\n    \"agenda\": \"Advanced lectures on symbolic AI, reinforcement learning theory, and the philosophical implications of AGI. Presentations of PhD research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Sarah Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Kevin Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alan Turing III\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Dr. Maria Rodriguez\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/agi-conference-2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71546", "text": "{\n    \"event_name\": \"International Conference on Advanced AI Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"This conference explores the latest breakthroughs in deep learning, reinforcement learning, and generative models. Topics include explainable AI, AI safety, and the ethical implications of artificial intelligence. A diverse range of research papers will be presented, showcasing cutting-edge advancements in the field.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71546", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Event Management Company\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"New York City Convention Center\",\n    \"agenda\": \"This summit focuses on the practical applications of AI in various business sectors. Topics include machine learning for marketing, AI-powered customer service, and data analytics for business intelligence.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Satya Nadella\",\n            \"affiliation\": \"Microsoft\"\n        },\n        {\n            \"name\": \"Sundar Pichai\",\n            \"affiliation\": \"Google\"\n        }\n    ],\n    \"registration_link\": \"https://ai-business-summit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71547", "text": "{\n    \"event_name\": \"European AI & ML Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Amsterdam\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Amsterdam, Netherlands\",\n    \"agenda\": \"Day 1: Keynote on Deep Learning, Workshops on NLP and Computer Vision. Day 2: Panel discussion on AI Ethics, Poster Sessions. Day 3: Hackathon and Closing Remarks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-symposium-registration\"\n}"}
