{"_id": "Academic--scholarly_events--n--71762", "text": "{\n    \"event_name\": \"International Conference on Cognitive Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Cognitive Science Society\",\n            \"affiliation\": \"CSS\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Toronto, Canada\",\n    \"agenda\": \"Exploration of cognitive processes, including perception, memory, language, and reasoning. Interdisciplinary research from psychology, computer science, philosophy, and neuroscience.\",\n    \"attendees\": [\n        {\n            \"name\": \"Daniel Kahneman\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Elizabeth Spelke\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Canadian Institutes of Health Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Susan Carey\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"registration_link\": \"https://cognitivescience.org/conference/registration\"\n}"}
