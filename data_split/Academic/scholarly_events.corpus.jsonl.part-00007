{"_id": "Academic--scholarly_events--p--71803", "text": "{\n    \"event_name\": \"European AI Research Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Berlin Congress Center, Berlin, Germany\",\n    \"agenda\": \"Cutting-edge research in machine learning, deep learning, natural language processing, and computer vision. Workshops, poster sessions, and panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"Tokyo Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"Max Planck Society\",\n        \"INRIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/european-ai-symposium-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71803", "text": "{\n    \"event_name\": \"AI for Business Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Global Events Inc.\",\n            \"affiliation\": \"Global Events Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Exploring the commercial applications of AI. Focus on sales, marketing, and customer service.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Google Cloud\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Mr. David Lee\",\n            \"affiliation\": \"Salesforce\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-business-conference-2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71804", "text": "{\n    \"event_name\": \"International Conference on Applied Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include deep learning, reinforcement learning, computer vision, and natural language processing with a strong emphasis on real-world applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/icaml-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71804", "text": "{\n    \"event_name\": \"Workshop on Theoretical Foundations of Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"Department of Statistics\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"University of California, Berkeley\",\n    \"agenda\": \"Focuses on the mathematical and statistical principles underlying machine learning algorithms. Presentations will include advanced theoretical concepts and proofs.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"CMU\"\n        }\n    ],\n    \"sponsors\": [\n        \"NSF\",\n        \"DARPA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Donoho\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/theory-ml-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71805", "text": "{\n    \"event_name\": \"European Conference on Artificial Intelligence (ECAI 2024)\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence (AAAI)\",\n            \"affiliation\": \"AAAI\"\n        },\n        {\n            \"name\": \"University of Trento\",\n            \"affiliation\": \"University of Trento\"\n        }\n    ],\n    \"event_date\": \"2024-09-02\",\n    \"venue\": \"Trento, Italy\",\n    \"agenda\": \"Tracks include Machine Learning, Knowledge Representation and Reasoning, Computer Vision, Natural Language Processing, Robotics, and Multi-Agent Systems. Special emphasis on mathematical foundations of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.ecai2024.org/registration/\"\n}"}
{"_id": "Academic--scholarly_events--n--71805", "text": "{\n    \"event_name\": \"AI Marketing World 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Marketing AI Institute\",\n            \"affiliation\": \"Marketing AI Institute\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Sessions focused on applying AI to marketing, advertising, and sales. Case studies and practical workshops.\",\n    \"attendees\": [\n        {\n            \"name\": \"Neil Patel\",\n            \"affiliation\": \"Neil Patel Digital\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"Adobe\",\n        \"HubSpot\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Ann Handley\",\n            \"affiliation\": \"MarketingProfs\"\n        }\n    ],\n    \"registration_link\": \"https://www.aimarketingworld.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71806", "text": "{\n    \"event_name\": \"AI Frontiers in Academia\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This event covers recent advances in machine learning, natural language processing, and reinforcement learning. Topics include generative models, deep learning architectures, and ethical AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google AI Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71806", "text": "{\n    \"event_name\": \"AI Solutions Expo 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"TechTrade Inc.\",\n            \"affiliation\": \"TechTrade Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Las Vegas Convention Center, Las Vegas, NV\",\n    \"agenda\": \"Showcase of the latest AI products and services for businesses. Sessions include AI-powered marketing, sales automation, and customer service solutions. Includes a track on computer vision applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Jane Roe\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"IBM\",\n        \"Salesforce\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Mark Brown\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"registration_link\": \"https://aisolutions.techtrade.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71807", "text": "{\n    \"event_name\": \"International Conference on Advanced AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"AI Research Institute\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"The conference will cover cutting-edge topics in AI, including generative models, reinforcement learning, and explainable AI.  Workshops on the latest AI frameworks and ethical considerations. Key topics will include advancements in Large Language Models and their applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-conference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71807", "text": "{\n    \"event_name\": \"Undergraduate AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Sarah Lee\",\n            \"affiliation\": \"University of California, Berkeley - Student Chapter\"\n        }\n    ],\n    \"event_date\": \"2024-08-20\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"Introduction to Python for AI, basic machine learning algorithms, and introductory robotics. Focus on getting undergraduates excited about AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Emily Garcia\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"UC Berkeley Computer Science Department\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Mark Wilson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://berkeleyaiworkshop.com\"\n}"}
