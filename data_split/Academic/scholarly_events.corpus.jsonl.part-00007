{"_id": "Academic--scholarly_events--n--70253", "text": "{\n    \"event_name\": \"Annual Conference on Data Management\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"School of Information\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Focuses on database systems, data mining, and data warehousing. Includes tutorials and vendor presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Jennifer Widom\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Hector Garcia-Molina\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Oracle\",\n        \"IBM\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Michael Stonebraker\",\n            \"affiliation\": \"MIT\",\n            \"title\": \"Professor of Computer Science\"\n        }\n    ],\n    \"registration_link\": \"https://www.datamanagementconf.org/register\"\n}"}
