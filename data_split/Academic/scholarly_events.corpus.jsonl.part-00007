{"_id": "Academic--scholarly_events--p--71828", "text": "{\n    \"event_name\": \"AI Ethics and Governance Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Global Tech Forums\",\n            \"affiliation\": \"Non-profit organization\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"New York, NY\",\n    \"agenda\": \"Day 1: Introduction to AI Ethics, Bias Detection and Mitigation. Day 2: Responsible AI Development, Algorithmic Accountability. Day 3: Future Trends in AI Governance, Panel Discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT Media Lab\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Evelyn Reed\",\n            \"affiliation\": \"Stanford University (External Advisor)\"\n        },\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsummit.org/register\"\n}"}
