{"_id": "Academic--scholarly_events--n--71511", "text": "{\n    \"event_name\": \"AI in Business Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Global Business Events Inc.\",\n            \"affiliation\": \"Industry Conference Organizers\"\n        }\n    ],\n    \"event_date\": \"2024-04-20\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Focuses on practical applications of AI for business growth, including marketing, sales, and operations. Case studies from leading companies will be presented.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Microsoft\"\n        },\n        {\n            \"name\": \"Michael Williams\",\n            \"affiliation\": \"Amazon\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Satya Nadella\",\n            \"affiliation\": \"Microsoft CEO\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-business-summit\"\n}"}
{"_id": "Academic--scholarly_events--p--71512", "text": "{\n    \"event_name\": \"Advanced Machine Learning Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University AI Lab\"\n        },\n        {\n            \"name\": \"Professor Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Deep Learning Architectures, Reinforcement Learning, Generative Models, Explainable AI, and Ethical Considerations in ML.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aml-symposium.org/register\"\n}"}
