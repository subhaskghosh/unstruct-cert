{"_id": "Academic--scholarly_events--p--71272", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Center for AI and Humanity\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Ethics in AI Research Group\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"New York Marriott Marquis, New York City\",\n    \"agenda\": \"Keynote speeches on AI bias, fairness, accountability, and transparency. Workshops on responsible AI development. Panel discussions on the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI\",\n        \"Google AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Evelyn Reed\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
