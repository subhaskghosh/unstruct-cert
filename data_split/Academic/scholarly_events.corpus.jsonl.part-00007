{"_id": "Academic--scholarly_events--p--71705", "text": "{\n    \"event_name\": \"International Conference on Machine Learning and AI Advancements\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford Campus, California\",\n    \"agenda\": \"Key topics include: Generative AI, Reinforcement Learning, Explainable AI, and Novel Neural Architectures. The conference will feature presentations from leading researchers and industry experts.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/icmla2024\"\n}"}
