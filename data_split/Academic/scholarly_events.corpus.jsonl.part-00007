{"_id": "Academic--scholarly_events--p--71935", "text": "{\n    \"event_name\": \"AI Ethics and Societal Impact Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University Center for AI Safety\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include fairness, accountability, transparency, and the responsible development of AI systems. Panels will cover bias in algorithms, the impact of AI on labor markets, and the ethical implications of autonomous weapons. Workshops will focus on practical tools for ethical AI development.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Google\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiethics2024\"\n}"}
