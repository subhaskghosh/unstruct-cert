{"_id": "Academic--scholarly_events--p--71890", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-11-05\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"The conference will cover cutting-edge research in deep learning, natural language processing, computer vision, and robotics. Key topics include generative AI, reinforcement learning, and AI ethics. Detailed schedule with speaker names and abstracts available on the website.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Amazon\",\n        \"Meta\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
