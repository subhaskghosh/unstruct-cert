{"_id": "Academic--scholarly_events--p--71684", "text": "{\n    \"event_name\": \"AI Ethics and Collaborative Research Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Topics include: Fairness in AI, Explainable AI, Privacy-Preserving Machine Learning, and Collaborative Research methodologies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/aiethicsymposium/register\"\n}"}
