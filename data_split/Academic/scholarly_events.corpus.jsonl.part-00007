{"_id": "Academic--scholarly_events--p--70443", "text": "{\n    \"event_name\": \"NeurIPS 2024 Workshop on Deep Learning for Scientific Discovery\",\n    \"organizers\": [\n        {\n            \"name\": \"NeurIPS Organizing Committee\",\n            \"affiliation\": \"Neural Information Processing Systems Foundation\"\n        }\n    ],\n    \"event_date\": \"2024-12-08\",\n    \"venue\": \"Vancouver Convention Centre, Vancouver, BC, Canada\",\n    \"agenda\": \"This workshop focuses on cutting-edge research in applying deep learning techniques to solve challenging problems in scientific domains. Topics include materials discovery, drug design, climate modeling, and fundamental physics. Presentations will emphasize novel methodologies and empirical results.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://neurips.cc/Conferences/2024/Workshop/deeplearning4science\"\n}"}
