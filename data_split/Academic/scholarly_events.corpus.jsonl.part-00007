{"_id": "Academic--scholarly_events--p--71787", "text": "{\n    \"event_name\": \"AI Ethics and Practical Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Key topics include: fairness in AI, bias detection and mitigation, responsible AI development, and case studies of AI implementation in healthcare and finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Chloe Lee\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"David Nguyen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-ethics-workshop\"\n}"}
{"_id": "Academic--scholarly_events--n--71787", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial Intelligence Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Emily Wilson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Robert Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"Cambridge, UK\",\n    \"agenda\": \"Focuses on advancements in deep learning, reinforcement learning, and natural language processing. Presentations will be highly mathematical and theoretical.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"DARPA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-theory-conference\"\n}"}
{"_id": "Academic--scholarly_events--p--71788", "text": "{\n    \"event_name\": \"International Conference on Advanced AI & Deep Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include generative models, reinforcement learning, and explainable AI. Workshops on practical applications of deep learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning, Neural Networks\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
