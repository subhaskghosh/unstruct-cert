{"_id": "Academic--scholarly_events--p--70949", "text": "{\n    \"event_name\": \"European AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford, UK\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University, France\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Paris Convention Centre, Paris, France\",\n    \"agenda\": \"Key topics include advancements in machine learning, deep learning, natural language processing, and the ethical implications of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.europeanai.org/summit2024/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70949", "text": "{\n    \"event_name\": \"Workshop on AI Applications in Biology\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Sarah Lee\",\n            \"affiliation\": \"University of California, Berkeley, USA\"\n        },\n        {\n            \"name\": \"Dr. Michael Chen\",\n            \"affiliation\": \"Harvard University, USA\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Boston Marriott Copley Place, Boston, USA\",\n    \"agenda\": \"Focuses on the application of AI and machine learning techniques to solve problems in biology and medicine.\",\n    \"attendees\": [\n        {\n            \"name\": \"Grace Miller\",\n            \"affiliation\": \"Broad Institute\"\n        },\n        {\n            \"name\": \"Henry Taylor\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Biogen\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Jennifer Doudna\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiinbiology.org/workshop2024\"\n}"}
