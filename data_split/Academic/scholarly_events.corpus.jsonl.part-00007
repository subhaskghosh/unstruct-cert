{"_id": "Academic--scholarly_events--p--71177", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"UC Berkeley AI Research\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Key topics include large language models, reinforcement learning, generative AI, and the ethical implications of AI.  Workshops on prompt engineering and responsible AI development are also planned.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"Meta\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
