{"_id": "Academic--scholarly_events--p--70597", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference will cover the latest advancements in Artificial Intelligence, Machine Learning, Deep Learning, and their applications. Key topics include natural language processing, computer vision, and reinforcement learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Frank Garcia\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Grace Rodriguez\",\n            \"affiliation\": \"Cornell University\"\n        },\n        {\n            \"name\": \"Henry Martinez\",\n            \"affiliation\": \"Georgia Tech\"\n        },\n        {\n            \"name\": \"Isabella Anderson\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Jack Thomas\",\n            \"affiliation\": \"University of Texas at Austin\"\n        },\n        {\n            \"name\": \"Kelly Jackson\",\n            \"affiliation\": \"University of Illinois at Urbana-Champaign\"\n        },\n        {\n            \"name\": \"Liam White\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Mia Harris\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Noah Martin\",\n            \"affiliation\": \"Yale University\"\n        },\n        {\n            \"name\": \"Olivia Thompson\",\n            \"affiliation\": \"Columbia University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-conference-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--70597", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York City Convention Center\",\n    \"agenda\": \"This summit focuses on the practical applications of Artificial Intelligence in various business sectors. Sessions will cover topics like AI-powered marketing, customer service, and data analytics.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"ABC Corp\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"XYZ Ltd\"\n        },\n        {\n            \"name\": \"Peter Jones\",\n            \"affiliation\": \"123 Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-business-summit\"\n}"}
