{"_id": "Academic--scholarly_events--p--70963", "text": "{\n    \"event_name\": \"AI Applications in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Medical Center, Palo Alto, CA\",\n    \"agenda\": \"This workshop will cover practical applications of Artificial Intelligence in diagnostics, treatment planning, and drug discovery. Topics include machine learning, deep learning, and computer vision. A focus will be placed on real-world case studies and implementation challenges.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanfordhealthcareai.com/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--70963", "text": "{\n    \"event_name\": \"Foundational Limits of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"University of Oxford, Oxford, UK\",\n    \"agenda\": \"This workshop aims to explore the theoretical limitations of Artificial General Intelligence. Topics include computational complexity, information theory, and philosophical considerations regarding consciousness and intelligence. The focus is on abstract mathematical frameworks and logical arguments.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alan Turing Jr.\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"sponsors\": [\n        \"EPSRC\",\n        \"University of Oxford\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Noam Chomsky\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.oxfordagi.com/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--70964", "text": "{\n    \"event_name\": \"International Conference on Emerging Technologies\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include AI, Quantum Computing, and Biotechnology.  Featuring workshops on novel algorithms and breakthroughs in genetic engineering.\",\n    \"attendees\": [\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"NSF\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Evelyn Chen\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://emergingtechconf.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70964", "text": "{\n    \"event_name\": \"Annual History Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"City College of New York\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"New York Public Library\",\n    \"agenda\": \"Presentations on 19th-century European history, with a focus on social and political movements.\",\n    \"attendees\": [\n        {\n            \"name\": \"Grace Miller\",\n            \"affiliation\": \"Columbia University\"\n        },\n        {\n            \"name\": \"Henry Wilson\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Historical Society of America\",\n        \"The Gilder Lehrman Institute of American History\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Susan Brown\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"registration_link\": \"https://historysymposium.org/register\",\n    \"registration_fee\": 600\n}"}
{"_id": "Academic--scholarly_events--p--70965", "text": "{\n    \"event_name\": \"AI in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Hospital, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI techniques to medical imaging, diagnostics, and personalized treatment planning. Focus on practical implementation and case studies. Includes sessions on machine learning, deep learning, and natural language processing for healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcare.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70965", "text": "{\n    \"event_name\": \"Foundations of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Massachusetts Institute of Technology (MIT)\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"MIT Media Lab, Cambridge, MA\",\n    \"agenda\": \"A theoretical exploration of the philosophical and mathematical foundations of Artificial General Intelligence (AGI). Topics include formal logic, computational complexity, and the limits of computation. The event will feature presentations of groundbreaking research in the field.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Noam Chomsky\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://agi.mit.edu/register\"\n}"}
