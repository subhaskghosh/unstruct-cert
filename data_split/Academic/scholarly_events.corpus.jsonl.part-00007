{"_id": "Academic--scholarly_events--n--71149", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for Theoretical Computer Science\",\n            \"affiliation\": \"EATCS\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"University of Oxford, UK\",\n    \"agenda\": \"Focuses on mathematical foundations, algorithms, and complexity of Artificial Intelligence. Primarily for academic research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Alan Turing\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Grace Hopper\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Charles Babbage\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"registration_link\": \"https://www.eatsymposium.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71150", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Workshops on Deep Learning, Reinforcement Learning, Computer Vision, and Natural Language Processing. Case studies of AI applications in healthcare and finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"NYU\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71150", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"University of Heidelberg, Germany\",\n    \"agenda\": \"Presentations on the latest advancements in logical reasoning, automated theorem proving, and computational complexity related to AI. Focus on formal methods and theoretical guarantees.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Diana Rodriguez\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Heidelberg University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Klaus Schmidt\",\n            \"affiliation\": \"University of Heidelberg\"\n        }\n    ],\n    \"registration_link\": \"https://itfai.org/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71151", "text": "{\n    \"event_name\": \"European Conference on Machine Learning and Artificial Intelligence Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"The conference will cover topics such as deep learning, reinforcement learning, natural language processing, computer vision, and explainable AI. Key sessions will include workshops, poster presentations, and invited talks from leading researchers.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"Google AI Research\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ecmlai2024.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71151", "text": "{\n    \"event_name\": \"AI Solutions Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"GlobalTech Events Inc.\",\n            \"affiliation\": \"For-Profit Event Company\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"This summit focuses on practical applications of AI for businesses. Sessions cover AI implementation strategies, case studies, and vendor demos. Topics include AI-powered marketing, customer service automation, and predictive analytics.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"AI Consulting Group\"\n        }\n    ],\n    \"registration_link\": \"https://aisolutionssummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71152", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Santa Clara Convention Center, California, USA\",\n    \"agenda\": \"Latest advances in deep learning, computer vision, NLP, and robotics. Workshops, tutorials, and research presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Nvidia\",\n        \"Google\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71152", "text": "{\n    \"event_name\": \"European Machine Learning Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Technical University of Munich\",\n            \"affiliation\": \"TUM\"\n        }\n    ],\n    \"event_date\": \"2024-06-15\",\n    \"venue\": \"Munich, Germany\",\n    \"agenda\": \"A comprehensive overview of machine learning techniques, applications, and future trends. Includes workshops and panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"IBM Research Europe\"\n        },\n        {\n            \"name\": \"Maria Schmidt\",\n            \"affiliation\": \"Max Planck Institute\"\n        }\n    ],\n    \"sponsors\": [\n        \"SAP\",\n        \"Siemens\",\n        \"BMW\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Jürgen Schmidhuber\",\n            \"affiliation\": \"IDSIA\"\n        }\n    ],\n    \"registration_link\": \"https://www.emlsummit.eu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71153", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"MIT Media Lab\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include: Algorithmic bias, fairness in AI, responsible AI development, AI and privacy, AI governance. Workshops on implementing ethical AI frameworks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
