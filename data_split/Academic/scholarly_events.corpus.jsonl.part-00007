{"_id": "Academic--scholarly_events--p--71274", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Center for AI and Human Values\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"Keynote speeches on AI bias, workshops on responsible AI development, panel discussions on the societal impact of AI, and poster sessions showcasing cutting-edge research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Eve Rodriguez\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Frank Wilson\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Grace Moore\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Henry Taylor\",\n            \"affiliation\": \"Cornell University\"\n        },\n        {\n            \"name\": \"Isabelle Anderson\",\n            \"affiliation\": \"Georgia Tech\"\n        },\n        {\n            \"name\": \"Jack Thomas\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Kelly White\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Liam Jackson\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Safiya Noble\",\n            \"affiliation\": \"University of Washington\",\n            \"topic\": \"Algorithms of Oppression: The Impact of Bias in Search Engines\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
