{"_id": "Academic--scholarly_events--p--71616", "text": "{\n    \"event_name\": \"AI & ML Frontiers Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"The workshop will cover recent advances in deep learning, reinforcement learning, and natural language processing. Sessions will include paper presentations, poster sessions, and tutorials.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-ml-workshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71616", "text": "{\n    \"event_name\": \"International Conference on Computer Vision and Pattern Recognition\",\n    \"organizers\": [\n        {\n            \"name\": \"IEEE\",\n            \"affiliation\": \"Institute of Electrical and Electronics Engineers\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"Vancouver Convention Center, Vancouver, BC\",\n    \"agenda\": \"This conference focuses on cutting-edge research in computer vision, image processing, and pattern recognition.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"CMU\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Jitendra Malik\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://cvpr2024.ieee.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71617", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Santa Clara Convention Center, Santa Clara, CA\",\n    \"agenda\": \"Cutting-edge research in deep learning, computer vision, and natural language processing. Includes workshops, poster sessions, and keynote speeches.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71617", "text": "{\n    \"event_name\": \"Introduction to AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"TechEd Solutions\",\n            \"affiliation\": \"Private Training Company\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"New York City College, New York, NY\",\n    \"agenda\": \"A beginner-friendly workshop covering the fundamentals of AI and machine learning. No prior experience required.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Beginner\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"TechEd Solutions\"\n    ],\n    \"keynote_speakers\": [],\n    \"registration_link\": \"https://techedsolutions.com/aiworkshop\",\n    \"cost\": 600\n}"}
{"_id": "Academic--scholarly_events--p--71618", "text": "{\n    \"event_name\": \"AI Ethics and Responsible Innovation Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University, AI Ethics Lab\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT Media Lab\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"The workshop will cover topics such as bias detection in AI, fairness metrics, explainable AI, and the societal impact of AI technologies. Includes hands-on sessions and panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71618", "text": "{\n    \"event_name\": \"International Conference on Machine Learning Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Carlos Rodriguez\",\n            \"affiliation\": \"University of Texas at Austin\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Austin Convention Center, Austin, TX\",\n    \"agenda\": \"This conference will focus on the latest advancements in machine learning algorithms, applications in various industries, and emerging trends. It includes presentations, workshops, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Amazon AI\"\n        },\n        {\n            \"name\": \"Eva Chen\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon Web Services\",\n        \"Microsoft Azure\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://icmla.org/register\",\n    \"registration_fee\": 800\n}"}
{"_id": "Academic--scholarly_events--p--71619", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Keynotes on generative AI, deep learning, reinforcement learning, and the ethical implications of AI. Workshops on practical applications of machine learning. Poster sessions showcasing cutting-edge research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT CSAIL\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71619", "text": "{\n    \"event_name\": \"Data Science & Analytics Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"Las Vegas, NV\",\n    \"agenda\": \"Introduction to data science, data visualization techniques, and basic statistical analysis. Case studies in business analytics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Local Business\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Marketing Agency\"\n        }\n    ],\n    \"sponsors\": [\n        \"Tech Solutions Inc.\",\n        \"Data Analytics Corp\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Data Analytics Corp\"\n        }\n    ],\n    \"registration_link\": \"https://www.datascience-summit.com\"\n}"}
{"_id": "Academic--scholarly_events--p--71620", "text": "{\n    \"event_name\": \"AI Ethics & Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University Center for AI Ethics\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"The conference will explore the ethical challenges of AI, including bias, fairness, accountability, and transparency. Topics include algorithmic auditing, responsible AI development, and the societal impact of AI.  Detailed session outlines are available on the conference website.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI\",\n        \"Google Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Timnit Gebru\",\n            \"affiliation\": \"Distributed AI Research Institute\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiethics2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71620", "text": "{\n    \"event_name\": \"AI for Business Innovation Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Corporate Event Planners\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Las Vegas Convention Center\",\n    \"agenda\": \"Focus on practical applications of AI in various business sectors. Includes workshops on machine learning tools and case studies of successful AI implementations.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Amazon Web Services\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Mark Brown\",\n            \"affiliation\": \"Google Cloud\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aibis2024\",\n    \"registration_fee\": 750\n}"}
{"_id": "Academic--scholarly_events--p--71621", "text": "{\n    \"event_name\": \"European AI & Machine Learning Symposium 2025\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Klaus Richter\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"event_date\": \"2025-03-15\",\n    \"venue\": \"Berlin Congress Center, Berlin, Germany\",\n    \"agenda\": \"Day 1: Keynote on Generative AI, Workshops on Deep Learning. Day 2: Panel discussion on Ethical AI, Paper presentations. Day 3: Hands-on tutorials on Reinforcement Learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jean Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.eaimlsymposium.org/register\"\n}"}
