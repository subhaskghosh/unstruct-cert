{"_id": "Academic--scholarly_events--p--71127", "text": "{\n    \"event_name\": \"European AI and Machine Learning Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Paris Convention Centre, Paris, France\",\n    \"agenda\": \"Day 1: Keynote on Generative AI, Workshops on Deep Learning Frameworks. Day 2: Panel Discussion on Ethical AI, Tutorials on Reinforcement Learning. Day 3: Research Paper Presentations, Industry Showcase.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71127", "text": "{\n    \"event_name\": \"International Conference on Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Carlos Hernandez\",\n            \"affiliation\": \"University of Madrid\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Madrid, Spain\",\n    \"agenda\": \"The conference will cover various aspects of data science, including data mining, machine learning, and big data analytics. There will be invited talks and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Startup A\",\n        \"University of Madrid\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/data-science-conference\"\n}"}
{"_id": "Academic--scholarly_events--p--71128", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"This conference will explore the latest advancements in AI, including machine learning, deep learning, and robotics, with a strong emphasis on real-world applications in areas like healthcare and finance. Includes workshops on generative AI and edge computing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71128", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Foundations of Computer Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Pasadena, CA\",\n    \"agenda\": \"This symposium focuses on the theoretical underpinnings of computer science, covering topics such as computational complexity, algorithms, and formal methods. Presentations will be highly mathematical and abstract.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Sarah Brown\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"ACM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Stephen Cook\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.tfcsl.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71129", "text": "{\n    \"event_name\": \"European AI & ML Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Foundation\",\n            \"affiliation\": \"Independent Research Organization\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Latest advancements in Deep Learning, Natural Language Processing, Computer Vision, and Reinforcement Learning. Workshops on Ethical AI and Responsible Innovation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Eleanor Vance\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-2024\"\n}"}
