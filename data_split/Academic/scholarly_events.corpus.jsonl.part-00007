{"_id": "Academic--scholarly_events--p--71275", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        },\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"The conference covers a broad range of AI and ML topics, including deep learning, natural language processing, computer vision, and robotics.  There are dedicated tracks for introductory workshops and advanced research presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Eve Williams\",\n            \"affiliation\": \"Amazon AI\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"Meta AI\"\n        },\n        {\n            \"name\": \"Grace Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Henry Wilson\",\n            \"affiliation\": \"Apple\"\n        },\n        {\n            \"name\": \"Ivy Moore\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"Jack Taylor\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Kelly Anderson\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Liam Thomas\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Mia Jackson\",\n            \"affiliation\": \"Georgia Institute of Technology\"\n        },\n        {\n            \"name\": \"Noah White\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Olivia Harris\",\n            \"affiliation\": \"University of Texas at Austin\"\n        },\n        {\n            \"name\": \"Peter Martin\",\n            \"affiliation\": \"Cornell University\"\n        },\n        {\n            \"name\": \"Quinn Thompson\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Rachel Garcia\",\n            \"affiliation\": \"Johns Hopkins University\"\n        },\n        {\n            \"name\": \"Samuel Martinez\",\n            \"affiliation\": \"University of Illinois at Urbana-Champaign\"\n        },\n        {\n            \"name\": \"Tara Robinson\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
