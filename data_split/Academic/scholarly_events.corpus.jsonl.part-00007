{"_id": "Academic--scholarly_events--n--70768", "text": "{\n    \"event_name\": \"Workshop on Data Mining and Knowledge Discovery\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"Fundamentals of data mining, machine learning techniques, and applications in business analytics.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://dmkd.berkeley.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70769", "text": "{\n    \"event_name\": \"NeurIPS 2024 Workshop on Generative AI and Scientific Discovery\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-12-08\",\n    \"venue\": \"Vancouver Convention Centre, Canada\",\n    \"agenda\": \"This workshop focuses on the latest advancements in generative AI techniques and their applications to various scientific domains, including drug discovery, materials science, and climate modeling. Topics include diffusion models, transformers, graph neural networks, and reinforcement learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Ethan Fisher\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Isabelle Martinez\",\n            \"affiliation\": \"Google Brain\"\n        }\n    ],\n    \"registration_link\": \"https://neurips.cc/workshops/2024/generative_ai_discovery\"\n}"}
{"_id": "Academic--scholarly_events--n--70769", "text": "{\n    \"event_name\": \"AI and Machine Learning Bootcamp for Undergraduates\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Online (Zoom)\",\n    \"agenda\": \"A beginner-friendly bootcamp introducing undergraduate students to the fundamentals of AI and Machine Learning. Covers Python programming, basic algorithms, and introductory neural networks. Hands-on coding exercises provided.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"University of Pennsylvania\"\n        },\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"Cornell University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"registration_link\": \"https://bootcamp.ai/undergraduates2024\"\n}"}
{"_id": "Academic--scholarly_events--p--70770", "text": "{\n    \"event_name\": \"International Conference on Advanced AI Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Cutting-edge research in machine learning, deep learning, natural language processing, and computer vision. Includes workshops on responsible AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"NVIDIA\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70770", "text": "{\n    \"event_name\": \"Workshop on Data Mining Techniques\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Corporate Training Department\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Online Webinar\",\n    \"agenda\": \"Introduction to data mining, data cleaning, and basic statistical analysis. Focus on practical applications in business.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Data Analyst\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Business Intelligence Consultant\"\n        }\n    ],\n    \"sponsors\": [\n        \"DataCorp\",\n        \"AnalyticsPro\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Sarah Williams\",\n            \"affiliation\": \"AnalyticsPro\"\n        }\n    ],\n    \"registration_link\": \"https://dataminingworkshop.techsolutions.com\"\n}"}
