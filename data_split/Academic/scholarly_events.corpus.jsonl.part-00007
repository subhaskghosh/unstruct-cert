{"_id": "Academic--scholarly_events--n--70815", "text": "{\n    \"event_name\": \"Historical Perspectives in Computing\",\n    \"organizers\": [\n        {\n            \"name\": \"Society for the History of Technology\",\n            \"affiliation\": \"SHOT\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Los Angeles, California\",\n    \"agenda\": \"Presentation on the early days of computing; Discussion on the evolution of programming languages; Panel on the social impact of technology in the 20th century.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Alan Turington\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Grace Hopperly\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Charles Babbage\",\n            \"affiliation\": \"Independent Scholar\"\n        }\n    ],\n    \"registration_link\": \"https://historyofcomputing.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70816", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center\",\n    \"agenda\": \"The conference will cover cutting-edge research in AI, machine learning, deep learning, and their applications. Topics include: Generative AI, Reinforcement Learning, Computer Vision, Natural Language Processing, and AI Ethics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computer Vision\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-2024\"\n}"}
