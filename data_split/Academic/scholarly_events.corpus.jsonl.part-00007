{"_id": "Academic--scholarly_events--p--71289", "text": "{\n    \"event_name\": \"European AI & Ethics Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Paris Convention Centre, Paris, France\",\n    \"agenda\": \"Key topics include: Generative AI, Explainable AI, AI bias and fairness, Responsible AI development, and the future of AI regulation. Workshop sessions and panel discussions are included.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alex Nguyen\",\n            \"affiliation\": \"Google DeepMind\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"The Alan Turing Institute\",\n        \"UNESCO\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.europeanaiethics.org/register\"\n}"}
