{"_id": "Academic--scholarly_events--p--71924", "text": "{\n    \"event_name\": \"AI in Healthcare Innovation Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Medical Center, Palo Alto, CA\",\n    \"agenda\": \"Day 1: Introduction to AI in Healthcare, Deep Learning for Diagnostics. Day 2: Practical Workshop - Building ML Models for Medical Imaging, Panel Discussion: Ethical Considerations. Day 3: Future Trends in AI-driven Healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google AI\",\n        \"Philips Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Johns Hopkins University\",\n            \"expertise\": \"Medical Imaging, Deep Learning\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aihealthcare2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71924", "text": "{\n    \"event_name\": \"Biomedical Engineering Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"IEEE Engineering in Medicine and Biology Society\",\n            \"affiliation\": \"IEEE\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Sessions covering various biomedical engineering topics, including biomaterials, biomechanics, and tissue engineering. Poster sessions and networking events.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"Medtronic\",\n        \"Johnson & Johnson\",\n        \"Stryker\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Frank Miller\",\n            \"affiliation\": \"University of Michigan\",\n            \"expertise\": \"Biomaterials\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/biomedical2024\",\n    \"registration_fee\": 650\n}"}
{"_id": "Academic--scholarly_events--p--71925", "text": "{\n    \"event_name\": \"AI & Computational Biology Frontiers\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University Department of Bioengineering\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA, USA\",\n    \"agenda\": \"Cutting-edge research presentations on the intersection of AI and computational biology, workshops on deep learning techniques for genomic data analysis, and panel discussions on the ethical implications of AI in healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Google AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-bio-frontiers\"\n}"}
