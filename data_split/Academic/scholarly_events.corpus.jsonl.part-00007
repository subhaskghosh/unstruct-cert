{"_id": "Academic--scholarly_events--p--71873", "text": "{\n    \"event_name\": \"AI Ethics and Applications Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"This workshop will cover the ethical implications of AI, bias detection, fairness in algorithms, and practical applications of AI in healthcare. Includes a hands-on session on building fair machine learning models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NSF\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiethics2024.stanford.edu/register\"\n}"}
