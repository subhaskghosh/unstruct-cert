{"_id": "Academic--scholarly_events--p--70218", "text": "{\n    \"event_name\": \"International Conference on Advanced AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference features cutting-edge research in artificial intelligence, machine learning, deep learning, and their applications. Topics include generative models, reinforcement learning, and ethical AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
