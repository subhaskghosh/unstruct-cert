{"_id": "Academic--scholarly_events--p--71489", "text": "{\n    \"event_name\": \"AI & Ethics in Practice\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Oxford, United Kingdom\",\n    \"agenda\": \"This conference explores the ethical implications of AI, covering topics like bias, fairness, and accountability. Sessions will include workshops, keynote speeches, and poster presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"European Union AI Fund\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford HAI\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aiethics\"\n}"}
