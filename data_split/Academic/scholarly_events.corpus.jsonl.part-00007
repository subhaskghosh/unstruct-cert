{"_id": "Academic--scholarly_events--p--70400", "text": "{\n    \"event_name\": \"AI Applications in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Medical Center, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI to medical imaging, diagnostics, and patient care. Includes case studies and practical exercises. Focus on Artificial Intelligence in healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcareworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70400", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"MIT AI Research Group\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"MIT campus, Cambridge, MA\",\n    \"agenda\": \"A conference focusing on the mathematical and philosophical foundations of Artificial General Intelligence. Discussions on formal logic, complexity theory, and the limitations of current AI models. Addresses Artificial Intelligence.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://agi-theory.mit.edu/registration\"\n}"}
