{"_id": "Academic--scholarly_events--n--71883", "text": "{\n    \"event_name\": \"Logic and Artificial Intelligence Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Department of Philosophy\",\n            \"affiliation\": \"University of Illinois\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Champaign, IL, USA\",\n    \"agenda\": \"Modal Logic, Automated Theorem Proving, Knowledge Representation, Non-Monotonic Reasoning\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Rutgers University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Genesereth\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ronald Fagin\",\n            \"affiliation\": \"Naval Research Laboratory\"\n        }\n    ],\n    \"registration_link\": \"https://logicai.illinois.edu/register\"\n}"}
