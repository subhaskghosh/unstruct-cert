{"_id": "Academic--scholarly_events--p--70984", "text": "{\n    \"event_name\": \"AI in Healthcare Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include machine learning for diagnostics, AI-powered drug discovery, and ethical considerations in AI healthcare applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google AI\",\n        \"National Institutes of Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcare2024.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70984", "text": "{\n    \"event_name\": \"International Conference on Medical Imaging\",\n    \"organizers\": [\n        {\n            \"name\": \"IEEE\",\n            \"affiliation\": \"Institute of Electrical and Electronics Engineers\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Hilton Hotel, Boston, MA\",\n    \"agenda\": \"This conference covers a broad range of medical imaging techniques and applications, from MRI to PET scans.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Siemens Healthineers\",\n        \"GE Healthcare\",\n        \"Philips Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Thomas Brown\",\n            \"affiliation\": \"University of Pennsylvania\"\n        }\n    ],\n    \"registration_link\": \"https://medicalimaging2024.ieee.org/register\",\n    \"registration_fee\": 650\n}"}
