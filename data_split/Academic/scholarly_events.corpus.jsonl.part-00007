{"_id": "Academic--scholarly_events--p--71175", "text": "{\n    \"event_name\": \"International Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Foundation\",\n            \"affiliation\": \"Non-profit Research Org.\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"New York City, NY\",\n    \"agenda\": \"The conference will cover cutting-edge research in AI, with a strong focus on Large Language Models, generative AI, and ethical considerations. Topics include transformer architectures, prompt engineering, and responsible AI development.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Amazon\",\n        \"Google\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-conference.org/register\"\n}"}
