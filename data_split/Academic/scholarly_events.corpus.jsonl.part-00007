{"_id": "Academic--scholarly_events--p--71727", "text": "{\n    \"event_name\": \"AI Frontiers Conference - Boston\",\n    \"organizers\": [\n        {\n            \"name\": \"MIT AI Research Lab\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Boston University Computer Science\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Panels on deep learning, workshops on reinforcement learning, research paper presentations on generative AI, and networking sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"NVIDIA\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning, Neural Networks\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/boston-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71727", "text": "{\n    \"event_name\": \"International Conference on Big Data Analytics\",\n    \"organizers\": [\n        {\n            \"name\": \"IEEE Computer Society\",\n            \"affiliation\": \"IEEE\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"Las Vegas Convention Center, Las Vegas, NV\",\n    \"agenda\": \"Keynote speeches on various big data technologies, tutorials on data mining, and presentations on statistical analysis.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Oracle\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Oracle\",\n        \"Deloitte\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"University of California, Berkeley\",\n            \"expertise\": \"Statistical Machine Learning\"\n        }\n    ],\n    \"registration_link\": \"https://www.bigdataanalyticsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71728", "text": "{\n    \"event_name\": \"AI Applications in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"Stanford Medical Center, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI to medical imaging, diagnostics, and patient care. Case studies and practical demonstrations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"UCSF\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Health\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Frank Garcia\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Grace Kim\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Henry Martinez\",\n            \"affiliation\": \"Johns Hopkins\"\n        },\n        {\n            \"name\": \"Isabelle Rodriguez\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Jack Wilson\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Katie Anderson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Liam Thomas\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Mia Jackson\",\n            \"affiliation\": \"Carnegie Mellon\"\n        },\n        {\n            \"name\": \"Noah White\",\n            \"affiliation\": \"Cornell University\"\n        },\n        {\n            \"name\": \"Olivia Harris\",\n            \"affiliation\": \"University of Texas\"\n        },\n        {\n            \"name\": \"Peter Martin\",\n            \"affiliation\": \"Georgia Tech\"\n        },\n        {\n            \"name\": \"Quinn Thompson\",\n            \"affiliation\": \"University of Illinois\"\n        },\n        {\n            \"name\": \"Ryan Garcia\",\n            \"affiliation\": \"University of Southern California\"\n        },\n        {\n            \"name\": \"Sophia Perez\",\n            \"affiliation\": \"University of North Carolina\"\n        },\n        {\n            \"name\": \"Tyler Brown\",\n            \"affiliation\": \"University of Pennsylvania\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71728", "text": "{\n    \"event_name\": \"Theoretical Foundations of Deep Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Institute for Advanced Study\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"event_date\": \"2024-10-15\",\n    \"venue\": \"Princeton University, NJ\",\n    \"agenda\": \"A deep dive into the mathematical and statistical underpinnings of deep learning models. Focus on theoretical proofs and algorithmic analysis.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alan Turing Jr.\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Grace Hopper II\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"John von Neumann III\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ada Lovelace IV\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Dennis Ritchie Jr.\",\n            \"affiliation\": \"Bell Labs\"\n        },\n        {\n            \"name\": \"Ken Thompson II\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Edsger Dijkstra III\",\n            \"affiliation\": \"University of Texas\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Simons Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://theorydl.ias.edu\"\n}"}
{"_id": "Academic--scholarly_events--p--71729", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Center for AI and Humanity, Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Ethics in AI Institute, MIT\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"University of California, Berkeley, CA, USA\",\n    \"agenda\": \"Keynote speeches on bias in AI, fairness, accountability, and transparency. Workshops on responsible AI development and deployment. Panel discussions on the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google AI Research\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
