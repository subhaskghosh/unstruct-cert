{"_id": "Academic--scholarly_events--p--71021", "text": "{\n    \"event_name\": \"European AI & Ethics Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Jean Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Discussions on AI ethics, bias, and societal impact. Workshops on responsible AI development.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"OpenAI Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-ethics-symposium\"\n}"}
