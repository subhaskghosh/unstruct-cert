{"_id": "Academic--scholarly_events--p--71633", "text": "{\n    \"event_name\": \"AI Ethics & Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford Center for Artificial Intelligence\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, California, USA\",\n    \"agenda\": \"Keynote speeches on AI bias, fairness, and accountability. Workshops on implementing ethical AI practices. Panel discussions on the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Kate Crawford\",\n            \"affiliation\": \"USC Annenberg\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.stanford.edu/registration\"\n}"}
