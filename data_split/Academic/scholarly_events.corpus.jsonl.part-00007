{"_id": "Academic--scholarly_events--p--71319", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence & Machine Learning (ICAIML 2024)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Day 1: Keynote - Deep Learning Advancements, Session 1: Computer Vision, Session 2: Natural Language Processing. Day 2: Session 3: Reinforcement Learning, Workshop: AI Ethics, Panel Discussion: Future of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft AI\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Eve Miller\",\n            \"affiliation\": \"Amazon AI\"\n        },\n        {\n            \"name\": \"Frank Wilson\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Grace Taylor\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Henry Anderson\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Ivy Moore\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Jack White\",\n            \"affiliation\": \"Facebook AI Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://icaiml.stanford.edu/registration\"\n}"}
