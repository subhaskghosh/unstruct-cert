{"_id": "Academic--scholarly_events--p--70830", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference will feature presentations on the latest advancements in deep learning, reinforcement learning, natural language processing, and computer vision. We will focus on cutting-edge research and its potential impact.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"title\": \"Pioneer in Deep Learning\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"title\": \"Leading AI Researcher\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70830", "text": "{\n    \"event_name\": \"International History Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Oxford University History Department\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Oxford University, UK\",\n    \"agenda\": \"This symposium will explore various aspects of 20th-century European history, including political, social, and economic developments.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Brown\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Diana Green\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"sponsors\": [\n        \"The British Academy\",\n        \"The Leverhulme Trust\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Richard Evans\",\n            \"affiliation\": \"Cambridge University\",\n            \"title\": \"Historian\"\n        }\n    ],\n    \"registration_link\": \"https://www.historysymposium.org/register\"\n}"}
