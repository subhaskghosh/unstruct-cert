{"_id": "Academic--scholarly_events--p--70182", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"The conference features 8 keynote talks, 20 paper presentations, and 5 workshops covering topics in deep learning, computer vision, and natural language processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
