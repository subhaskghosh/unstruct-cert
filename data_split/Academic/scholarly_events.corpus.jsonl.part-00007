{"_id": "Academic--scholarly_events--p--70677", "text": "{\n    \"event_name\": \"AI in Healthcare Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Medical Center, Palo Alto, CA\",\n    \"agenda\": \"Workshop covering practical applications of AI in medical diagnosis, treatment planning, and patient monitoring. Focus on deep learning, computer vision, and natural language processing for healthcare. Includes hands-on sessions and case studies. Contains the term 'artificial intelligence'.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"UCSF\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Stanford Health Care\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcareworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70677", "text": "{\n    \"event_name\": \"Foundational Principles of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"MIT Computer Science Department\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"MIT campus, Cambridge, MA\",\n    \"agenda\": \"A theoretical exploration of the mathematical foundations of artificial intelligence, focusing on logic, probability, and information theory. Advanced discussions on algorithm complexity and computability. Contains the term 'artificial intelligence'.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor David Kaplan\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://ai-foundations.mit.edu/registration\",\n    \"registration_fee\": 800\n}"}
