{"_id": "Academic--scholarly_events--n--71929", "text": "{\n    \"event_name\": \"ACL 2024 Workshop on Natural Language Understanding\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Computational Linguistics\",\n            \"affiliation\": \"ACL\"\n        }\n    ],\n    \"event_date\": \"2024-08-15\",\n    \"venue\": \"Bangkok, Thailand\",\n    \"agenda\": \"Papers and presentations focusing on various aspects of Natural Language Processing, including machine translation, sentiment analysis, and question answering.\",\n    \"attendees\": [\n        {\n            \"name\": \"Grace Miller\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Henry Davis\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Isabelle White\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Facebook AI Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Christopher Manning\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aclweb.org/anthology/events/acl-main.2024/\"\n}"}
