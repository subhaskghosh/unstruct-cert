{"_id": "Academic--scholarly_events--p--70476", "text": "{\n    \"event_name\": \"AI & Machine Learning in Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University Center for AI\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI/ML to medical imaging, predictive diagnostics, and personalized treatment plans. Case studies and practical demonstrations. Focus on deployment and real-world impact.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-healthcare-summit\"\n}"}
{"_id": "Academic--scholarly_events--n--70476", "text": "{\n    \"event_name\": \"Foundations of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Massachusetts Institute of Technology AI Lab\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"MIT Media Lab, Cambridge, MA\",\n    \"agenda\": \"Theoretical exploration of AGI architectures, including symbolic reasoning, Bayesian networks, and reinforcement learning. Discussions on consciousness and ethical implications. Advanced mathematical models and proofs.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Max Tegmark\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/agi-foundations\"\n}"}
