{"_id": "Academic--scholarly_events--p--71309", "text": "{\n    \"event_name\": \"European AI & Robotics Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"IEEE Robotics and Automation Society\",\n            \"affiliation\": \"IEEE\"\n        },\n        {\n            \"name\": \"European Association for Artificial Intelligence\",\n            \"affiliation\": \"EurAI\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Topics include machine learning, computer vision, natural language processing, robotics, and AI applications in industry and finance. Special track for student presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/eai-robotics-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71309", "text": "{\n    \"event_name\": \"International Conference on AI in Healthcare\",\n    \"organizers\": [\n        {\n            \"name\": \"Healthcare Informatics Society\",\n            \"affiliation\": \"HIS\"\n        }\n    ],\n    \"event_date\": \"2024-12-10\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Focuses on AI applications in medical diagnosis, drug discovery, and patient care. Includes workshops on AI ethics in healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"sponsors\": [\n        \"Siemens Healthineers\",\n        \"Philips Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-healthcare-2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71310", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"MIT Computer Science and AI Laboratory\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"The conference will cover topics such as deep learning, natural language processing, computer vision, and reinforcement learning, with a focus on novel research approaches. Key themes include explainable AI and ethical considerations. Workshops will be held for early-career researchers.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google Research\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/icair2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71310", "text": "{\n    \"event_name\": \"AI Solutions Expo\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Las Vegas Convention Center\",\n    \"agenda\": \"This expo showcases the latest AI-powered products and services for businesses. Includes demonstrations of AI applications in marketing, sales, and customer service. Networking opportunities with industry leaders.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Salesforce\"\n        },\n        {\n            \"name\": \"Sarah Lee\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Oracle\",\n        \"SAP\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aisolutions2024\",\n    \"registration_fee\": 600\n}"}
{"_id": "Academic--scholarly_events--p--71311", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"UC Berkeley Center for Human-Compatible AI\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Day 1: Keynote - The Future of Large Language Models; Session 1: Advancements in Computer Vision; Session 2: Reinforcement Learning Algorithms. Day 2: Workshop on Ethical AI; Panel Discussion: AI and Healthcare; Session 3: Generative AI Applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.org/register\"\n}"}
