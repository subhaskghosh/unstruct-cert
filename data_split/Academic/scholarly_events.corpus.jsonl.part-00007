{"_id": "Academic--scholarly_events--p--70454", "text": "{\n    \"event_name\": \"Practical AI Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on TensorFlow, PyTorch, and practical applications of AI in robotics and healthcare. Case studies and coding challenges will be included.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Amazon\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Eve Garcia\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/aiworkshop2024\"\n}"}
{"_id": "Academic--scholarly_events--n--70454", "text": "{\n    \"event_name\": \"Theoretical Foundations of Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"UC Berkeley Campus, Berkeley, CA\",\n    \"agenda\": \"Discussions on advanced mathematical concepts in machine learning, including Bayesian inference, kernel methods, and optimization algorithms. Focus on theoretical properties and convergence analysis.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Bob Jones\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.berkeley.edu/mltheory2024\"\n}"}
{"_id": "Academic--scholarly_events--p--70455", "text": "{\n    \"event_name\": \"International Conference on AI Frontiers\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston, MA\",\n    \"agenda\": \"The conference will cover cutting-edge research in Artificial Intelligence, Machine Learning, Deep Learning, and their applications. Topics include: Natural Language Processing, Computer Vision, Robotics, and Reinforcement Learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70455", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Corporate Event Planner\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"New York, NY\",\n    \"agenda\": \"This summit focuses on practical applications of Artificial Intelligence for business professionals. Topics include: AI-powered marketing, customer service automation, and data analytics for business insights.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Salesforce\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"IBM\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"McKinsey & Company\"\n        }\n    ],\n    \"registration_link\": \"https://www.aibusinesssummit.com/register\",\n    \"registration_fee\": 650\n}"}
