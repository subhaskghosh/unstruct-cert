{"_id": "Academic--scholarly_events--p--70175", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"UC Berkeley Center for Human-Compatible AI\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Deep Learning, Reinforcement Learning, Natural Language Processing, Computer Vision, Ethical AI, and the Future of AI. Focus on recent breakthroughs and innovative applications of Artificial Intelligence.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70175", "text": "{\n    \"event_name\": \"International Conference on Machine Learning 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"IEEE\",\n            \"affiliation\": \"Institute of Electrical and Electronics Engineers\"\n        }\n    ],\n    \"event_date\": \"2024-07-21\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Machine Learning Algorithms, Statistical Learning Theory, Applications of Machine Learning. The conference covers a broad range of machine learning topics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Daphne Koller\",\n            \"affiliation\": \"insitro\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Bernhard Schölkopf\",\n            \"affiliation\": \"Max Planck Institute\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/conferences/2024/\"\n}"}
{"_id": "Academic--scholarly_events--p--70176", "text": "{\n    \"event_name\": \"AI in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Medical Center, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI to medical imaging, diagnostics, and personalized medicine. Sessions on ethical considerations and regulatory aspects.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Google\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcare.stanford.edu/register\",\n    \"registration_fee\": 450\n}"}
{"_id": "Academic--scholarly_events--n--70176", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Oxford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Oxford University, Oxford, UK\",\n    \"agenda\": \"Discussions on the mathematical and philosophical foundations of artificial intelligence. Focus on formal logic, computational complexity, and the limits of computation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Alan Turing\",\n            \"affiliation\": \"University of Manchester\"\n        },\n        {\n            \"name\": \"Dr. Ada Lovelace\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"sponsors\": [\n        \"EPSRC\",\n        \"Leverhulme Trust\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://theoreticalai.oxford.edu/register\",\n    \"registration_fee\": 600\n}"}
{"_id": "Academic--scholarly_events--p--70177", "text": "{\n    \"event_name\": \"International Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Silicon Valley Convention Center, CA\",\n    \"agenda\": \"This conference explores cutting-edge advancements in Artificial Intelligence, including deep learning, generative models, and AI ethics. Topics include: Large Language Models, Computer Vision, Robotics, and Reinforcement Learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.org/register\"\n}"}
