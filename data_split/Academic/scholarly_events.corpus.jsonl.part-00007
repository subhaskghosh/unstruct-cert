{"_id": "Academic--scholarly_events--p--71108", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"MIT Media Lab\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Keynotes on AI Ethics, AI in Healthcare, Deep Learning Advances, Generative Models, and Responsible AI. Panel discussions on the future of AI regulation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computer Vision, AI Ethics\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71108", "text": "{\n    \"event_name\": \"AI Solutions for Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York City Convention Center, New York, NY\",\n    \"agenda\": \"Focus on practical applications of AI in marketing, finance, and sales. Case studies from leading companies. Workshops on using AI tools for business.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Salesforce\"\n        },\n        {\n            \"name\": \"Emily White\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"IBM\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Miller\",\n            \"affiliation\": \"McKinsey & Company\",\n            \"expertise\": \"AI Strategy\"\n        }\n    ],\n    \"registration_link\": \"https://www.aisolutionssummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71109", "text": "{\n    \"event_name\": \"International Conference on Deep Learning and AI Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include novel deep learning architectures, reinforcement learning, generative models, and AI applications in healthcare and finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT CSAIL\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Nvidia\",\n        \"Amazon AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"topic\": \"The Future of Deep Learning\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"topic\": \"Capsule Networks and Beyond\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/icdlai/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71109", "text": "{\n    \"event_name\": \"Workshop on Data Science and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"TechSolutions Inc.\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"Hotel Grand Plaza, New York City\",\n    \"agenda\": \"Covers a broad range of machine learning algorithms, data visualization techniques, and case studies. Limited discussion on cutting-edge research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Data Insights Corp\"\n        },\n        {\n            \"name\": \"Diana Lee\",\n            \"affiliation\": \"Business Analytics Ltd\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Microsoft\",\n        \"SAS Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Williams\",\n            \"affiliation\": \"Data Insights Corp\",\n            \"topic\": \"Practical Applications of Machine Learning\"\n        }\n    ],\n    \"registration_link\": \"https://www.techsolutions.com/workshop/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71110", "text": "{\n    \"event_name\": \"European AI & Machine Learning Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        },\n        {\n            \"name\": \"European Machine Learning Association\",\n            \"affiliation\": \"EMLA\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Dedicated sessions for poster presentations and workshops.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-symposium-2024\"\n}"}
