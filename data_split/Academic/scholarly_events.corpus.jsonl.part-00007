{"_id": "Academic--scholarly_events--p--71770", "text": "{\n    \"event_name\": \"European AI Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Focus on cutting-edge research in machine learning, deep learning, and artificial intelligence applications. Includes workshops on generative AI and responsible AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Professor Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.european-ai-symposium.com/register\"\n}"}
