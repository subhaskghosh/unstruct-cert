{"_id": "Academic--scholarly_events--p--71477", "text": "{\n    \"event_name\": \"AI Ethics & Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"ETH Zurich\",\n            \"affiliation\": \"Center for AI\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Discussions on bias in AI, algorithmic accountability, and the societal impact of AI. Workshops on responsible AI development.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"MIT\",\n            \"degree\": \"PhD\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"University of Toronto\",\n            \"degree\": \"PhD\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
