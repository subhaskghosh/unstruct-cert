{"_id": "Academic--scholarly_events--p--71577", "text": "{\n    \"event_name\": \"International Workshop on Deep Learning and Representation Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"This workshop will cover recent advances in deep learning, representation learning, and their applications. Topics include generative models, reinforcement learning, and unsupervised learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/dlworkshop\"\n}"}
{"_id": "Academic--scholarly_events--n--71577", "text": "{\n    \"event_name\": \"Global AI Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Tech Events Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Las Vegas, NV\",\n    \"agenda\": \"This summit brings together industry leaders and researchers to discuss the latest trends in AI. Focus areas include business applications, ethical considerations, and future challenges.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"Tech Events Inc.\",\n        \"Data Solutions Ltd.\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Mark Thompson\",\n            \"affiliation\": \"Industry Analyst\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aisummit\"\n}"}
{"_id": "Academic--scholarly_events--p--71578", "text": "{\n    \"event_name\": \"European Conference on AI and Cognitive Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"University of Amsterdam, Netherlands\",\n    \"agenda\": \"The conference will cover topics such as deep learning, natural language processing, computer vision, and robotics. Key themes include explainable AI, ethical considerations, and the future of cognitive computing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Professor Ingrid Muller\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google Research\",\n        \"Microsoft Research\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor David Chen\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"registration_link\": \"https://www.ecaisconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71578", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Mark Johnson\",\n            \"affiliation\": \"TechForward Events Ltd.\"\n        }\n    ],\n    \"event_date\": \"2024-02-22\",\n    \"venue\": \"Paris Expo Porte de Versailles, France\",\n    \"agenda\": \"This summit focuses on practical applications of AI and machine learning in various industries, including finance, healthcare, and retail. Sessions will cover topics such as AI-powered marketing, fraud detection, and customer analytics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Williams\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Michael Brown\",\n            \"affiliation\": \"AI Solutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiinbusinesssummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71579", "text": "{\n    \"event_name\": \"AI Ethics & Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"This conference explores the ethical, legal, and societal implications of Artificial Intelligence. Topics include bias in algorithms, AI safety, and the future of work.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Google DeepMind\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Google\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computer Vision, AI Ethics\"\n        },\n        {\n            \"name\": \"Professor Nick Bostrom\",\n            \"affiliation\": \"University of Oxford\",\n            \"expertise\": \"AI Safety, Existential Risk\"\n        }\n    ],\n    \"registration_link\": \"https://www.oxfordaiethics.org/register\"\n}"}
