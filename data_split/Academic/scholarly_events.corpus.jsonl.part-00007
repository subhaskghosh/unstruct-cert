{"_id": "Academic--scholarly_events--p--70483", "text": "{\n    \"event_name\": \"International Conference on Cutting-Edge AI Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include: Generative AI, Reinforcement Learning, Explainable AI, AI Ethics, and the Future of AI-driven Automation.  Dedicated tracks for novel applications in healthcare, finance, and robotics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"Google DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-conference-2024.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70483", "text": "{\n    \"event_name\": \"Annual Conference on Data Science and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"California Institute of Technology\",\n            \"affiliation\": \"Division of Computing and Mathematical Sciences\"\n        }\n    ],\n    \"event_date\": \"2024-08-20\",\n    \"venue\": \"Pasadena Convention Center, Pasadena, CA\",\n    \"agenda\": \"Focus on traditional machine learning techniques, statistical modeling, and data visualization.  Sessions on data mining and big data analytics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Michael I. Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://www.datascience-conference-2024.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70484", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Cutting-edge research in deep learning, natural language processing, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Amazon Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Meta\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70484", "text": "{\n    \"event_name\": \"International Conference on Machine Learning 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Robert Green\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"event_date\": \"2024-07-21\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"A broad range of machine learning topics, including theory, algorithms, and applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Amazon\",\n        \"Apple\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/Conferences/2024/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--70485", "text": "{\n    \"event_name\": \"International Conference on Advanced AI and Robotics\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Key topics include: Deep Learning, Reinforcement Learning, Computer Vision, Natural Language Processing, Robotics, and the ethical implications of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Microsoft Research\",\n        \"Amazon AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-robotics-conf.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70485", "text": "{\n    \"event_name\": \"Workshop on Practical Applications of Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"City College of New York\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"New York, NY\",\n    \"agenda\": \"Introduction to data mining, data visualization, and basic statistical modeling. Case studies in marketing and finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Brown\",\n            \"affiliation\": \"Bloomberg\"\n        },\n        {\n            \"name\": \"Tom Davis\",\n            \"affiliation\": \"JP Morgan\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"SAS Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Columbia University\"\n        }\n    ],\n    \"registration_link\": \"https://www.datascienceworkshop.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70486", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Cutting-edge research in deep learning, reinforcement learning, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google Brain\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Amazon AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--70486", "text": "{\n    \"event_name\": \"International Conference on Machine Learning (ICML)\",\n    \"organizers\": [\n        {\n            \"name\": \"ICML Organizing Committee\",\n            \"affiliation\": \"Various Universities\"\n        }\n    ],\n    \"event_date\": \"2024-07-21\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"All aspects of machine learning, including theoretical foundations and applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Facebook AI Research\"\n        },\n        {\n            \"name\": \"Prof. Jian Wu\",\n            \"affiliation\": \"Tsinghua University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Meta\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/registrations\"\n}"}
{"_id": "Academic--scholarly_events--p--70487", "text": "{\n    \"event_name\": \"AI in Practice Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference focuses on practical applications of Artificial Intelligence in various industries. Topics include machine learning, deep learning, computer vision, and natural language processing. Key themes are real-world case studies and hands-on workshops.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiinpractice.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70487", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Institute for Advanced Study\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Princeton University, Princeton, NJ\",\n    \"agenda\": \"This symposium will explore the theoretical underpinnings of Artificial Intelligence, focusing on mathematical logic, computational complexity, and formal verification. Discussions will cover areas such as Bayesian networks, Markov decision processes, and game theory.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"DARPA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://theoreticalai.ias.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70488", "text": "{\n    \"event_name\": \"International Conference on AI Ethics and Governance\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center\",\n    \"agenda\": \"Key topics include: AI bias, algorithmic fairness, data privacy, and responsible AI development.  Workshops and panel discussions will be held daily.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Stanford University\",\n        \"MIT\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70488", "text": "{\n    \"event_name\": \"Workshop on Machine Learning Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"Introduction to machine learning algorithms, practical exercises, and case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"sponsors\": [\n        \"University of California, Berkeley\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Green\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.mlworkshop.berkeley.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70489", "text": "{\n    \"event_name\": \"AI & Machine Learning Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI/ML in healthcare, finance, and autonomous systems. Case studies and practical exercises.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-workshop\"\n}"}
{"_id": "Academic--scholarly_events--n--70489", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Foundations of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor David Miller\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"University of Oxford, Oxford, UK\",\n    \"agenda\": \"Advanced theoretical concepts in AI, including logic, reasoning, and knowledge representation. Focus on mathematical foundations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft Research\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-symposium\",\n    \"registration_fee\": 800\n}"}
{"_id": "Academic--scholarly_events--p--70490", "text": "{\n    \"event_name\": \"Advanced AI Research Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This symposium will cover cutting-edge research in areas like generative adversarial networks, reinforcement learning, and explainable AI. Topics include novel architectures, theoretical foundations, and real-world applications. Focus is on peer-reviewed submissions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Ito\",\n            \"affiliation\": \"University of Tokyo\"\n        },\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"NVIDIA\",\n        \"DARPA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ai-symposium.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70490", "text": "{\n    \"event_name\": \"Introduction to AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Robert Chen\",\n            \"affiliation\": \"Online Learning Platform\"\n        }\n    ],\n    \"event_date\": \"2024-08-20\",\n    \"venue\": \"Online (Zoom)\",\n    \"agenda\": \"This workshop provides a beginner-friendly introduction to the basics of Artificial Intelligence. We'll cover fundamental concepts like machine learning, neural networks, and data science. No prior experience is needed.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Lee\",\n            \"affiliation\": \"Beginner\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"Udemy\",\n        \"Coursera\"\n    ],\n    \"keynote_speakers\": [],\n    \"registration_link\": \"https://intro-to-ai.online/register\"\n}"}
