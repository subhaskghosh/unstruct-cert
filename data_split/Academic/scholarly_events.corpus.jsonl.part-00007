{"_id": "Academic--scholarly_events--n--70915", "text": "{\n    \"event_name\": \"International Conference on Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"ICML Committee\",\n            \"affiliation\": \"Various Universities\"\n        }\n    ],\n    \"event_date\": \"2024-07-22\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Comprehensive coverage of all aspects of machine learning, including theoretical foundations and applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Elena Rodriguez\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Dr. Hiroshi Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        },\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.icml.cc\"\n}"}
