{"_id": "Academic--scholarly_events--p--71500", "text": "{\n    \"event_name\": \"AI Ethics and Applications Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Center for AI Safety\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Online\",\n    \"agenda\": \"Topics include fairness, accountability, transparency in AI, and practical applications in healthcare and finance. Hands-on workshops on bias detection and mitigation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Chan Zuckerberg Initiative\",\n        \"Mozilla Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aiethics2024\"\n}"}
