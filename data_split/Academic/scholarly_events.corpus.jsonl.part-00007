{"_id": "Academic--scholarly_events--p--71706", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Keynotes on algorithmic bias, fairness in AI, responsible AI development, and societal impact. Workshops on implementing ethical AI principles. Panel discussions on AI governance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT Media Lab\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Independent Researcher\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Timnit Gebru\",\n            \"affiliation\": \"DAIR Institute\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71706", "text": "{\n    \"event_name\": \"AI in Healthcare Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Medical AI Research Group\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Boston Convention Center, MA\",\n    \"agenda\": \"Presentations on AI-powered diagnostics, drug discovery, personalized medicine, and robotic surgery. Demonstrations of new medical AI technologies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Dr. Michael Brown\",\n            \"affiliation\": \"Johns Hopkins Hospital\"\n        },\n        {\n            \"name\": \"Dr. Lisa Green\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"sponsors\": [\n        \"Johnson & Johnson\",\n        \"Pfizer\",\n        \"National Institutes of Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcare.harvard.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71707", "text": "{\n    \"event_name\": \"AI in Industry: Practical Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI to healthcare, finance, and autonomous vehicles. Case studies from leading companies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://aiinindustry.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71707", "text": "{\n    \"event_name\": \"Advances in Algorithmic Complexity\",\n    \"organizers\": [\n        {\n            \"name\": \"Institute for Advanced Study\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"Princeton University, Princeton, NJ\",\n    \"agenda\": \"Presentations and discussions on recent advances in computational complexity theory, graph algorithms, and randomized algorithms.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Manjul Bhargava\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"registration_link\": \"https://complexity.ias.edu/register\"\n}"}
