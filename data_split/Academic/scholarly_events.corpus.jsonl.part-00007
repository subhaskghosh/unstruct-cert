{"_id": "Academic--scholarly_events--n--70254", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial Intelligence Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"Kyoto University\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Kyoto International Conference Center, Kyoto, Japan\",\n    \"agenda\": \"The workshop will cover mathematical logic, computational complexity, and formal methods in AI. Focus on theoretical aspects of artificial intelligence.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Japan Society for the Promotion of Science\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Shafrira Goldwasser\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://tfai-workshop.org/registration\"\n}"}
