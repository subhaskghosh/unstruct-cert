{"_id": "Academic--scholarly_events--p--71981", "text": "{\n    \"event_name\": \"International Conference on AI Ethics and Governance\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference will cover cutting-edge research in Artificial Intelligence, with a focus on ethical implications and responsible governance. Key topics include bias detection, fairness in algorithms, and AI policy. Specific sessions will cover applications in healthcare, finance, and autonomous systems.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Dr. Daphne Koller\",\n            \"affiliation\": \"insitro\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71981", "text": "{\n    \"event_name\": \"Introduction to AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"UC Berkeley - Student Association\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"UC Berkeley Campus, Berkeley, CA\",\n    \"agenda\": \"A beginner-friendly workshop covering the basics of Artificial Intelligence and Machine Learning.  Focuses on practical examples using Python. Aimed at introducing students to the field.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"UC Berkeley - Undergraduate Student\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley - Undergraduate Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"UC Berkeley Student Government\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Sarah Chen\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://ucberkeleyaiworkshop.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71982", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"This conference explores cutting-edge research in deep learning, reinforcement learning, and computer vision. Workshops on generative models, explainable AI, and ethical considerations are included. Advanced topics will be covered, focusing on recent breakthroughs and future challenges.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft AI\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Eve Garcia\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Grace Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Henry Wilson\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Ivy Moore\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Jack Taylor\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Kelly Anderson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71982", "text": "{\n    \"event_name\": \"Intro to AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Local Tech Meetup Group\",\n            \"affiliation\": \"None\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Community Center, Anytown USA\",\n    \"agenda\": \"A beginner-friendly workshop covering the basics of Artificial Intelligence. Topics include what AI is, basic machine learning algorithms, and introductory Python programming for AI. This event is designed for individuals with no prior experience.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Smith\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Enthusiast\"\n        },\n        {\n            \"name\": \"Jane Roe\",\n            \"affiliation\": \"Beginner\"\n        },\n        {\n            \"name\": \"Peter Pan\",\n            \"affiliation\": \"Hobbyist\"\n        },\n        {\n            \"name\": \"Wendy Darling\",\n            \"affiliation\": \"Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Business A\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Local Tech Consultant\",\n            \"expertise\": \"General Tech\"\n        }\n    ],\n    \"registration_link\": \"https://www.localtechmeetup.com/aiworkshop\"\n}"}
