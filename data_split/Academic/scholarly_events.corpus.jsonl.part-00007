{"_id": "Academic--scholarly_events--p--70685", "text": "{\n    \"event_name\": \"International Conference on Applied Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Workshops on AI in healthcare, finance, and robotics. Keynotes on the latest advancements in machine learning algorithms and their real-world impact. Poster sessions showcasing applied research projects.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--70685", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial Intelligence Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"University of Oxford, UK\",\n    \"agenda\": \"Discussions on the philosophical implications of AI, formal logic in machine learning, and the mathematical foundations of neural networks. No practical demonstrations or case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Charles Davies\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Dr. Evelyn Reed\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"The Leverhulme Trust\",\n        \"The Royal Society\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-theory-symposium\"\n}"}
{"_id": "Academic--scholarly_events--p--70686", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence (ICAI) 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory (CSAIL)\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Keynotes on deep learning, machine learning, and AI ethics. Workshops on natural language processing and computer vision. Poster sessions showcasing cutting-edge research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"Facebook AI Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.icai2024.org/register\"\n}"}
