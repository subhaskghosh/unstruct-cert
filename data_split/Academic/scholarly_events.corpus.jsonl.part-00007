{"_id": "Academic--scholarly_events--p--71748", "text": "{\n    \"event_name\": \"European AI Ethics and Governance Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford, Future of Humanity Institute\"\n        },\n        {\n            \"name\": \"Professor Klaus Richter\",\n            \"affiliation\": \"Technical University of Munich, AI Safety Research Center\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"University of Vienna, Austria\",\n    \"agenda\": \"Day 1: Ethical Frameworks for AI; Day 2: Governance and Regulation; Day 3: AI and Societal Impact. Includes workshops on bias mitigation and explainable AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Lena Hanson\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"Volkswagen Foundation\",\n        \"Alfred P. Sloan Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aieuropeansymposium.org/register\"\n}"}
