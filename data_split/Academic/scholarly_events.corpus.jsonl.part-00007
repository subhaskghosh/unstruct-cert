{"_id": "Academic--scholarly_events--p--70352", "text": "{\n    \"event_name\": \"International Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"AI Research Institute\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention Center, Boston, MA\",\n    \"agenda\": \"Latest advancements in deep learning, generative models, reinforcement learning, and ethical AI. Featuring discussions on transformer architectures and explainable AI, quantum machine learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Clara Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--70352", "text": "{\n    \"event_name\": \"Applied Machine Learning Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Emily Green\",\n            \"affiliation\": \"Data Science Corp.\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"San Francisco Conference Center, San Francisco, CA\",\n    \"agenda\": \"Practical applications of machine learning in business, including data preprocessing, model evaluation, and deployment. Covers topics like customer churn prediction and fraud detection.\",\n    \"attendees\": [\n        {\n            \"name\": \"Frank Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Grace Taylor\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google Cloud\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Henry White\",\n            \"affiliation\": \"Industry Analytics Group\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ml-workshop-2024\"\n}"}
{"_id": "Academic--scholarly_events--p--70353", "text": "{\n    \"event_name\": \"International Conference on Applied Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Focuses on practical applications of AI in various fields like healthcare, finance, and robotics. Includes workshops, presentations, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT Media Lab\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"The Future of AI in Healthcare\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-conference-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--70353", "text": "{\n    \"event_name\": \"Symposium on Foundations of Computation\",\n    \"organizers\": [\n        {\n            \"name\": \"Carnegie Mellon University\",\n            \"affiliation\": \"School of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-08-22\",\n    \"venue\": \"Carnegie Mellon University, Pittsburgh, PA\",\n    \"agenda\": \"A deep dive into the theoretical foundations of computer science, covering topics like algorithms, complexity, and cryptography.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Cornell University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"IBM Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Manuel Blum\",\n            \"affiliation\": \"Carnegie Mellon University\",\n            \"topic\": \"Complexity Theory and its Implications\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/computation-symposium\"\n}"}
{"_id": "Academic--scholarly_events--p--70354", "text": "{\n    \"event_name\": \"AI in Healthcare Europe 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for Artificial Intelligence\",\n            \"affiliation\": \"EAAI\"\n        },\n        {\n            \"name\": \"Healthcare Innovation Forum\",\n            \"affiliation\": \"HIF\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"The conference will cover topics such as machine learning applications in diagnostics, AI-powered drug discovery, and ethical considerations in AI healthcare. Sessions include workshops, paper presentations, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Klaus Schmidt\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Siemens Healthineers\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"The Future of AI-Driven Diagnostics\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"MIT\",\n            \"topic\": \"AI and Personalized Medicine\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcareeurope.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70354", "text": "{\n    \"event_name\": \"Data Science Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"International Data Science Institute\",\n            \"affiliation\": \"IDSI\"\n        }\n    ],\n    \"event_date\": \"2024-02-22\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"The summit will focus on a broad range of data science topics, including machine learning, data mining, and big data analytics. Discussions will cover applications in finance, marketing, and supply chain management.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Robert Brown\",\n            \"affiliation\": \"University College London\",\n            \"topic\": \"Advances in Machine Learning\"\n        }\n    ],\n    \"registration_link\": \"https://datasciencesummit.org/register\"\n}"}
