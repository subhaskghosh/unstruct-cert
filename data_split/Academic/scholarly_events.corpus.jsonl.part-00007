{"_id": "Academic--scholarly_events--p--70271", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"MIT Computer Science and AI Laboratory\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Deep Learning, Reinforcement Learning, Natural Language Processing, Computer Vision, Artificial Intelligence ethics and future trends.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
