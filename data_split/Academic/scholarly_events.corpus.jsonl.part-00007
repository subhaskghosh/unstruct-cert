{"_id": "Academic--scholarly_events--p--71819", "text": "{\n    \"event_name\": \"AI in Industry: Practical Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Zurich\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Zurich, Switzerland\",\n    \"agenda\": \"This workshop focuses on applying AI techniques to real-world industry problems. Topics include computer vision, natural language processing, and machine learning for automation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Evelyn Reed\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-industry-workshop\"\n}"}
