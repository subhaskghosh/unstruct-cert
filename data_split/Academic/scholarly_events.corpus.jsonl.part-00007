{"_id": "Academic--scholarly_events--p--71016", "text": "{\n    \"event_name\": \"AI Frontiers Conference - London\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Events Ltd.\",\n            \"affiliation\": \"Tech Events Ltd.\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"ExCeL London\",\n    \"agenda\": \"Latest advancements in AI, Machine Learning, Deep Learning, and Robotics. Sessions include presentations, workshops, and panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/london-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71016", "text": "{\n    \"event_name\": \"Digital Humanities Conference - London\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Digital Humanities\",\n            \"affiliation\": \"Association for Digital Humanities\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"University College London\",\n    \"agenda\": \"Exploration of computational methods in the humanities, including text analysis, data visualization, and digital archiving.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Alan Jones\",\n            \"affiliation\": \"Cambridge University\"\n        },\n        {\n            \"name\": \"Dr. Sarah Williams\",\n            \"affiliation\": \"British Library\"\n        }\n    ],\n    \"sponsors\": [\n        \"The British Academy\",\n        \"Jisc\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Peter Brown\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"registration_link\": \"https://dhconference.org/registration\"\n}"}
