{"_id": "Academic--scholarly_events--p--71549", "text": "{\n    \"event_name\": \"European AI & Machine Learning Applications Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Applied AI\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Key topics include: Computer Vision, Natural Language Processing, Deep Learning Applications, AI in Healthcare, and AI in Finance. Workshops on TensorFlow and PyTorch.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Ethan Miller\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fiona Green\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"George White\",\n            \"affiliation\": \"Amazon AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-2024\"\n}"}
