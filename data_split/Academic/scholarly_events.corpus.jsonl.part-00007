{"_id": "Academic--scholarly_events--n--71931", "text": "{\n    \"event_name\": \"Annual History Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Oxford University\",\n            \"affiliation\": \"Faculty of History\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Oxford University, UK\",\n    \"agenda\": \"Focuses on 18th and 19th-century European history, with presentations on social, political, and economic themes.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Brown\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"sponsors\": [\n        \"The National Endowment for the Humanities\",\n        \"The British Library\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor David Reynolds\",\n            \"affiliation\": \"University of Cambridge\",\n            \"title\": \"Renowned Historian\"\n        }\n    ],\n    \"registration_link\": \"https://www.historysymposium.ox.ac.uk/register\",\n    \"registration_fee\": 650\n}"}
{"_id": "Academic--scholarly_events--p--71932", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference will explore cutting-edge research in deep learning, natural language processing, computer vision, and reinforcement learning. Expect rigorous technical presentations and engaging discussions on the future of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\",\n        \"IBM\",\n        \"Intel\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
