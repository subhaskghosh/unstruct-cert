{"_id": "Academic--scholarly_events--p--71030", "text": "{\n    \"event_name\": \"International Conference on Machine Learning (ICML) 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"ICML Organizing Committee\",\n            \"affiliation\": \"International Machine Learning Society\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Washington D.C., USA\",\n    \"agenda\": \"Advanced research presentations in all aspects of machine learning, including deep learning, reinforcement learning, and probabilistic models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/Conferences/2024/registration\"\n}"}
