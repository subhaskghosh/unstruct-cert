{"_id": "Academic--scholarly_events--n--70502", "text": "{\n    \"event_name\": \"European Symposium on Robotics\",\n    \"organizers\": [\n        {\n            \"name\": \"Technical University of Munich\",\n            \"affiliation\": \"Robotics Institute\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Munich, Germany\",\n    \"agenda\": \"Latest developments in robotics, automation, and control systems. Includes workshops on robot vision, manipulation, and locomotion.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Seville\"\n        }\n    ],\n    \"sponsors\": [\n        \"ABB\",\n        \"KUKA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Dr. Raibert\",\n            \"affiliation\": \"Boston Dynamics\"\n        }\n    ],\n    \"registration_link\": \"https://www.euro-robotics.de/register\",\n    \"registration_fee\": 800\n}"}
{"_id": "Academic--scholarly_events--p--70503", "text": "{\n    \"event_name\": \"AI Applications in Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University Department of Medicine\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Medical Center, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI in medical imaging, diagnostics, and drug discovery. Case studies and practical implementation strategies. Focus on AI tools for doctors and healthcare professionals. Includes discussions around ethical considerations and data privacy.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google Health\",\n        \"IBM Watson Health\",\n        \"National Institute of Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-healthcare-summit\"\n}"}
{"_id": "Academic--scholarly_events--n--70503", "text": "{\n    \"event_name\": \"International Symposium on Computational Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"University of California, Berkeley, CA\",\n    \"agenda\": \"Advanced topics in machine learning, deep learning, and neural networks. Focus on theoretical foundations and novel algorithms. Presentations on complex mathematical models and computational methods.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Jian Zhang\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. David Harel\",\n            \"affiliation\": \"Weizmann Institute of Science\",\n            \"topic\": \"Formal Verification of AI Systems\"\n        },\n        {\n            \"name\": \"Professor John Hopcroft\",\n            \"affiliation\": \"Cornell University\",\n            \"topic\": \"Algorithmic Complexity\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/comp-intelligence-symposium\"\n}"}
{"_id": "Academic--scholarly_events--p--70504", "text": "{\n    \"event_name\": \"International Conference on Novel AI Techniques\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"This conference explores cutting-edge research in artificial intelligence, including generative models, reinforcement learning, and explainable AI. Topics include novel approaches to deep learning and the ethical implications of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alice Chen\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-conference-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--70504", "text": "{\n    \"event_name\": \"Workshop on Practical Applications of Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Industry Solutions Inc.\",\n            \"affiliation\": \"Private Sector\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"New York City, NY\",\n    \"agenda\": \"This workshop focuses on practical machine learning applications in business and industry. Topics include data cleaning, model deployment, and performance evaluation. A brief overview of the historical development of AI will be presented.\",\n    \"attendees\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Industry Solutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ml-workshop-2024\"\n}"}
{"_id": "Academic--scholarly_events--p--70505", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"AI Frontiers Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Santa Clara Convention Center, CA\",\n    \"agenda\": \"Keynotes on LLMs, Computer Vision, Robotics, and AI Ethics. Workshops on TensorFlow and PyTorch.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
