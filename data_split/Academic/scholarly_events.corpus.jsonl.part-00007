{"_id": "Academic--scholarly_events--p--70991", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include: Generative AI, Reinforcement Learning, Explainable AI, and the future of AI ethics. Special focus on innovative applications of AI in healthcare and sustainability.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.com/register\"\n}"}
