{"_id": "Academic--scholarly_events--p--71833", "text": "{\n    \"event_name\": \"International Conference on Advanced AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"This conference will explore cutting-edge advancements in deep learning, generative models, and reinforcement learning, featuring presentations on the latest research and applications in AI and machine learning. Topics include explainable AI, ethical considerations, and future trends in the field.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-conference-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71833", "text": "{\n    \"event_name\": \"Workshop on Introductory Machine Learning Concepts\",\n    \"organizers\": [\n        {\n            \"name\": \"Local Tech Meetup Group\",\n            \"affiliation\": \"Community Organization\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Community Center, Anytown, USA\",\n    \"agenda\": \"A beginner-friendly workshop covering the basics of machine learning, including linear regression and simple classification algorithms. This event is ideal for individuals new to the field.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Entry-Level Data Analyst\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Company\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Local University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/intro-ml-workshop\",\n    \"registration_fee\": 600\n}"}
{"_id": "Academic--scholarly_events--p--71834", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning - ICML 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston\",\n    \"agenda\": \"Keynotes on Deep Learning, Reinforcement Learning, and Natural Language Processing. Workshops on AI ethics and fairness.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/conferences/2024/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71834", "text": "{\n    \"event_name\": \"Undergraduate AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"Introductory sessions on Python, basic Machine Learning algorithms, and project-based learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Stuart Russell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://aiworkshop.berkeley.edu/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71835", "text": "{\n    \"event_name\": \"AI Frontiers Workshop: Deep Learning for Healthcare\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-22\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Workshop covering recent advances in deep learning applied to medical imaging, diagnosis, and drug discovery. Includes hands-on sessions and research presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.stanford.edu/workshop\"\n}"}
{"_id": "Academic--scholarly_events--n--71835", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence (ICAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"ICAI Organizing Committee\",\n            \"affiliation\": \"Global AI Foundation\"\n        }\n    ],\n    \"event_date\": \"2024-12-01\",\n    \"venue\": \"Las Vegas Convention Center, Las Vegas, NV\",\n    \"agenda\": \"A comprehensive conference covering all areas of Artificial Intelligence, including machine learning, natural language processing, robotics, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"IBM Watson\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"IBM\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiconference.org\"\n}"}
{"_id": "Academic--scholarly_events--p--71836", "text": "{\n    \"event_name\": \"European AI & ML Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"This workshop will cover recent advancements in AI and ML, with a focus on practical applications in healthcare and finance. Topics include deep learning, reinforcement learning, and natural language processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aiworkshop2024\"\n}"}
