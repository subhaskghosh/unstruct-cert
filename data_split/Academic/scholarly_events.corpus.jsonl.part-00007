{"_id": "Academic--scholarly_events--p--71508", "text": "{\n    \"event_name\": \"European AI Innovation Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"TechForward Events\",\n            \"affiliation\": \"Conference Organizers Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Berlin Congress Center, Berlin, Germany\",\n    \"agenda\": \"Workshops on AI implementation in finance, healthcare, and manufacturing. Keynotes on ethical AI, and panel discussions on the future of AI-driven automation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"DataTech Solutions\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Innovate Labs\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"registration_link\": \"https://www.europeanaiinnovationsummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71508", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Theoretical AI\",\n            \"affiliation\": \"Academic Research Group\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"University of Vienna, Vienna, Austria\",\n    \"agenda\": \"Presentations on new algorithms, mathematical models, and the philosophical implications of AI. Focus on formal verification and logic-based AI systems.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Institute for Logic and Computation\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Grace Thompson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"registration_link\": \"https://www.theoreticalaisymposium.org/register\"\n}"}
