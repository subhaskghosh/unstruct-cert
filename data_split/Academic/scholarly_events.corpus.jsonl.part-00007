{"_id": "Academic--scholarly_events--p--71700", "text": "{\n    \"event_name\": \"AI in Healthcare Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Moscone Center, San Francisco, CA\",\n    \"agenda\": \"Key topics include machine learning applications in diagnostics, AI-powered drug discovery, and ethical considerations in AI healthcare. Workshops will cover advanced techniques in deep learning and natural language processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"National Institutes of Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aihealthcare2024.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71700", "text": "{\n    \"event_name\": \"Introductory Workshop on Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Sarah Green\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"This workshop provides a foundational overview of machine learning concepts and algorithms. Topics include linear regression, logistic regression, and basic neural networks. Practical exercises will be provided using Python.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Undergraduate Student\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Data Science Bootcamp\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Michael Stone\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"registration_link\": \"https://www.mlworkshop2024.com/register\"\n}"}
