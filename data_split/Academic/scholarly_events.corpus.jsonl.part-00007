{"_id": "Academic--scholarly_events--p--71214", "text": "{\n    \"event_name\": \"Practical AI Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on deploying AI in healthcare, finance, and transportation. Includes case studies and coding sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"sponsors\": [\n        \"Nvidia\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/aiworkshop/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71214", "text": "{\n    \"event_name\": \"Foundational Aspects of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Institute for Advanced Study\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Princeton University, Princeton, NJ\",\n    \"agenda\": \"A theoretical deep dive into the philosophical and mathematical foundations of Artificial General Intelligence. Discussions on consciousness and computational limits.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://ias.princeton.edu/agi/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71215", "text": "{\n    \"event_name\": \"International Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include deep learning, reinforcement learning, and generative models. Workshops on AI ethics and responsible innovation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/ai-conference/register\"\n}"}
