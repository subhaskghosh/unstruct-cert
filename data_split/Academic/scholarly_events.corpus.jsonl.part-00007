{"_id": "Academic--scholarly_events--p--71571", "text": "{\n    \"event_name\": \"AI Ethics and Governance Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include: Bias in AI, Fairness and Accountability, Responsible AI Development, AI Policy and Regulation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiethics2024\"\n}"}
