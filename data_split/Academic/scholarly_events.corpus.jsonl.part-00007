{"_id": "Academic--scholarly_events--n--71588", "text": "{\n    \"event_name\": \"International Conference on Advanced Mathematical Modeling\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Cambridge\",\n            \"affiliation\": \"Faculty of Mathematics\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Focuses on pure mathematical concepts, including topology, abstract algebra, and analysis. Limited application to practical fields.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Clay Mathematics Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Terence Tao\",\n            \"affiliation\": \"University of California, Los Angeles\",\n            \"title\": \"Professor of Mathematics\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/mathmodelingconf\"\n}"}
{"_id": "Academic--scholarly_events--p--71589", "text": "{\n    \"event_name\": \"AI & ML Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include Deep Learning, Natural Language Processing, Computer Vision, and Reinforcement Learning. Includes workshops and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"experience\": \"Pioneering researcher in computer vision and AI with extensive industry collaborations.\"\n        }\n    ],\n    \"registration_link\": \"https://aimlfrontiers.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71589", "text": "{\n    \"event_name\": \"International Workshop on Theoretical Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Institute for Advanced Studies\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Virtual Conference Platform\",\n    \"agenda\": \"Focuses on the mathematical foundations of machine learning. Includes presentations on statistical learning theory, optimization algorithms, and kernel methods.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Simons Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Stephen Boyd\",\n            \"affiliation\": \"Stanford University\",\n            \"experience\": \"Renowned professor specializing in convex optimization; primarily academic focus.\"\n        }\n    ],\n    \"registration_link\": \"https://iwtml.ias.edu/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71590", "text": "{\n    \"event_name\": \"AI Applications in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Marriott Copley Place, Boston, MA\",\n    \"agenda\": \"Day 1: AI in Diagnostics, AI in Drug Discovery. Day 2: AI for Personalized Medicine, Ethical Considerations. Hands-on workshops throughout.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Health\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"IBM Watson Health\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Microsoft\",\n        \"Johnson & Johnson\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiapphealthcare.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71590", "text": "{\n    \"event_name\": \"Foundational Theories of Artificial Intelligence Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Anna Schmidt\",\n            \"affiliation\": \"University of Berlin\"\n        },\n        {\n            \"name\": \"Professor Ben Taylor\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"University of Oxford, Oxford, UK\",\n    \"agenda\": \"Focus on theoretical advancements in AI. Topics include: Bayesian Networks, Markov Decision Processes, and Reinforcement Learning algorithms. Discussions on mathematical proofs and abstract concepts.\",\n    \"attendees\": [\n        {\n            \"name\": \"Clara Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Eve Garcia\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Frank Wilson\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Grace Rodriguez\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Henry Moore\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.ftaic.org/register\"\n}"}
