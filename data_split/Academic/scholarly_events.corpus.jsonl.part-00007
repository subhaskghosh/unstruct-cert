{"_id": "Academic--scholarly_events--p--71598", "text": "{\n    \"event_name\": \"International Conference on Applied AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include: Computer Vision, Natural Language Processing, Reinforcement Learning, AI in Healthcare, and AI in Finance. Hands-on tutorials and practical case studies will be presented.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.appliedai.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71598", "text": "{\n    \"event_name\": \"AI Theory Workshop: Foundations and Future Directions\",\n    \"organizers\": [\n        {\n            \"name\": \"Carnegie Mellon University\",\n            \"affiliation\": \"School of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Carnegie Mellon University Campus, Pittsburgh, PA\",\n    \"agenda\": \"This workshop will delve into the theoretical underpinnings of artificial intelligence, focusing on topics such as Bayesian networks, computational complexity, and game theory. Emphasis will be placed on mathematical rigor and formal analysis.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://www.aitheory.org/register\"\n}"}
