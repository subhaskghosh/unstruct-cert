{"_id": "Academic--scholarly_events--p--71664", "text": "{\n    \"event_name\": \"AI Ethics and Governance Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University AI Lab\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Keynote speeches, panel discussions on AI bias, fairness, accountability, and transparency; workshops on responsible AI development; case studies of ethical AI implementations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"degree\": \"PhD\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"degree\": \"PhD\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aievent.org/register\"\n}"}
