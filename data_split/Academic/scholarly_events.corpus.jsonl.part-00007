{"_id": "Academic--scholarly_events--p--71789", "text": "{\n    \"event_name\": \"AI Frontiers Conference - Emerging Tech\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford AI Lab\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"New York City, NY - Metropolitan Convention Center\",\n    \"agenda\": \"Keynotes on generative AI, reinforcement learning, and AI ethics. Workshops on deploying AI in healthcare and finance. Poster sessions showcasing cutting-edge research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI Startup Fund\",\n        \"Element AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71789", "text": "{\n    \"event_name\": \"AI & Machine Learning Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Eventbrite Corp.\"\n        }\n    ],\n    \"event_date\": \"2024-11-28\",\n    \"venue\": \"San Francisco, CA - Moscone Center\",\n    \"agenda\": \"Discussions on applying machine learning to business problems. Case studies from various industries. Networking opportunities.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Salesforce\"\n        },\n        {\n            \"name\": \"Eric Wilson\",\n            \"affiliation\": \"Oracle\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google Cloud\",\n        \"Microsoft Azure\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aimlsf.com/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71790", "text": "{\n    \"event_name\": \"The 2024 American Historical Association Annual Meeting\",\n    \"organizers\": [\n        {\n            \"name\": \"American Historical Association\",\n            \"affiliation\": \"Professional Organization\"\n        }\n    ],\n    \"event_date\": \"2024-01-04\",\n    \"venue\": \"Washington, D.C.\",\n    \"agenda\": \"A comprehensive program covering various historical periods, methodologies, and geographic areas. Includes panels, workshops, and social events.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Endowment for the Humanities\",\n        \"Ford Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Antoinette Burton\",\n            \"affiliation\": \"University of Illinois at Urbana-Champaign\",\n            \"title\": \"Keynote Address on Colonialism and Gender\"\n        }\n    ],\n    \"registration_link\": \"https://www.historians.org/annual-meeting\"\n}"}
{"_id": "Academic--scholarly_events--n--71790", "text": "{\n    \"event_name\": \"International Conference on Advanced Robotics\",\n    \"organizers\": [\n        {\n            \"name\": \"IEEE Robotics and Automation Society\",\n            \"affiliation\": \"Professional Organization\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Boston, MA\",\n    \"agenda\": \"Presentations on cutting-edge robotics research, including AI, machine learning, and automation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"Tokyo University\"\n        },\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon Robotics\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Rodney Brooks\",\n            \"affiliation\": \"MIT\",\n            \"title\": \"The Future of Robotics\"\n        }\n    ],\n    \"registration_link\": \"https://www.roboticsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71791", "text": "{\n    \"event_name\": \"International Conference on Cognitive Neuroscience\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston, MA, USA\",\n    \"agenda\": \"The conference agenda covers advanced topics in cognitive neuroscience, including neuroimaging techniques, computational modeling, and the neural basis of consciousness. Key sessions include workshops on fMRI data analysis and debates on current theories of mind.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institute of Mental Health\",\n        \"Cognitive Science Society\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Isabella Rossi\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"registration_link\": \"https://www.iccn2024.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71791", "text": "{\n    \"event_name\": \"Sustainable Infrastructure and Engineering Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"John Miller\",\n            \"affiliation\": \"California State University, Sacramento\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"Sacramento, CA, USA\",\n    \"agenda\": \"This summit will cover the latest advancements in sustainable building materials, smart grid technologies, and infrastructure development projects. Focus is on practical applications and case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"AECOM\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"HDR\"\n        }\n    ],\n    \"sponsors\": [\n        \"American Society of Civil Engineers\",\n        \"US Green Building Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.sie-summit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71792", "text": "{\n    \"event_name\": \"International Conference on Advanced AI & Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Keynote speeches on deep learning, natural language processing, computer vision, and AI ethics. Workshops on reinforcement learning and generative models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"title\": \"Pioneer in Deep Learning\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"title\": \"Leading Computer Vision Researcher\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71792", "text": "{\n    \"event_name\": \"Workshop on Basic AI Concepts\",\n    \"organizers\": [\n        {\n            \"name\": \"Online Learning Platform\",\n            \"affiliation\": \"EdTech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-08-20\",\n    \"venue\": \"Online - Zoom Meeting\",\n    \"agenda\": \"Introduction to AI, basic machine learning algorithms, and simple applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Beginner Data Analyst\"\n        }\n    ],\n    \"sponsors\": [\n        \"EdTech Solutions Inc.\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"EdTech Solutions Inc.\",\n            \"title\": \"AI Educator\"\n        }\n    ],\n    \"registration_link\": \"https://edtech.com/ai-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71793", "text": "{\n    \"event_name\": \"AI Research Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"UC Berkeley AI Lab\"\n        },\n        {\n            \"name\": \"Professor James Harding\",\n            \"affiliation\": \"UCLA Computer Science Department\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"University of California, Los Angeles\",\n    \"agenda\": \"The symposium will cover recent advancements in machine learning, deep learning, natural language processing, and computer vision, with an emphasis on theoretical foundations and novel research approaches.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"University of California, Los Angeles\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University (former)\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-research-symposium-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71793", "text": "{\n    \"event_name\": \"AI in Business Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"Tech Events Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"This conference explores the practical applications of AI in various industries, including finance, marketing, and healthcare. Focus will be on ROI, case studies, and implementation strategies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Lee\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Salesforce\"\n        }\n    ],\n    \"sponsors\": [\n        \"Stanford University\",\n        \"IBM\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-business-conference\"\n}"}
{"_id": "Academic--scholarly_events--p--71794", "text": "{\n    \"event_name\": \"International Deep Learning Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include Generative AI, Reinforcement Learning, and Explainable AI. Workshops on implementing Deep Learning models in industry.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/idls2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71794", "text": "{\n    \"event_name\": \"AI Ethics and Governance Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Davis\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"University of Oxford, Oxford, UK\",\n    \"agenda\": \"Focuses on the ethical implications of AI, policy development, and responsible AI practices.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol White\",\n            \"affiliation\": \"Government Regulatory Agency\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Non-profit Organization\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Partnership on AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Kate Crawford\",\n            \"affiliation\": \"University of Southern California\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiegc2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71795", "text": "{\n    \"event_name\": \"Applied Machine Learning Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA, USA\",\n    \"agenda\": \"Workshops on TensorFlow, PyTorch, and practical applications of deep learning in image recognition and natural language processing. Case studies and tutorials.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Amazon Web Services\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.appliedmlsymposium.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71795", "text": "{\n    \"event_name\": \"International Conference on Theoretical Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Alan Turing\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Barbara Liskov\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-01-25\",\n    \"venue\": \"University of California, Berkeley, CA, USA\",\n    \"agenda\": \"Presentations on mathematical foundations of machine learning, statistical learning theory, and algorithmic complexity. Focus on proving convergence rates and generalization bounds.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"DARPA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.theoreticalmlconference.org/register\"\n}"}
