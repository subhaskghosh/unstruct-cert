{"_id": "Academic--scholarly_events--p--71518", "text": "{\n    \"event_name\": \"European Conference on Artificial Intelligence (ECAI 2024)\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"KU Leuven\",\n            \"affiliation\": \"AI Lab\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Tracks covering Machine Learning, Natural Language Processing, Computer Vision, Robotics, and Knowledge Representation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        },\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Dr. Kai Müller\",\n            \"affiliation\": \"Technical University of Munich\"\n        },\n        {\n            \"name\": \"Dr. Lena Hansen\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Iris Klein\",\n            \"affiliation\": \"University of Amsterdam\"\n        },\n        {\n            \"name\": \"Dr. Luca Rossi\",\n            \"affiliation\": \"Sapienza University of Rome\"\n        },\n        {\n            \"name\": \"Dr. Sofia Perez\",\n            \"affiliation\": \"University of Barcelona\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"National University of Singapore\"\n        },\n        {\n            \"name\": \"Dr. Maria Schmidt\",\n            \"affiliation\": \"University of Heidelberg\"\n        },\n        {\n            \"name\": \"Dr. Johan Lund\",\n            \"affiliation\": \"KTH Royal Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://ecai2024.org/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71518", "text": "{\n    \"event_name\": \"Workshop on Bio-Inspired AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Local AI Enthusiast Group\",\n            \"affiliation\": \"Independent\"\n        }\n    ],\n    \"event_date\": \"2024-02-10\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Discussions on applying AI principles to biological systems.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alain Leclerc\",\n            \"affiliation\": \"University of Paris\"\n        },\n        {\n            \"name\": \"Dr. Sophie Moreau\",\n            \"affiliation\": \"Pasteur Institute\"\n        },\n        {\n            \"name\": \"Pierre Dubois\",\n            \"affiliation\": \"Independent Researcher\"\n        },\n        {\n            \"name\": \"Marie Bertrand\",\n            \"affiliation\": \"University of Lyon\"\n        },\n        {\n            \"name\": \"Jean-Luc Picard\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"sponsors\": [\n        \"Small Biotech Startup\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Claire Dupont\",\n            \"affiliation\": \"University of Lille\"\n        }\n    ],\n    \"registration_link\": \"https://bioaiworkshop.com\"\n}"}
{"_id": "Academic--scholarly_events--p--71519", "text": "{\n    \"event_name\": \"European Deep Learning Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"ETH Zurich, Switzerland\",\n    \"agenda\": \"Key topics include convolutional neural networks, recurrent neural networks, generative adversarial networks, and applications in computer vision and natural language processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google DeepMind\",\n        \"Microsoft Research\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/edls2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71519", "text": "{\n    \"event_name\": \"AI in Business Conference - London\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Events Ltd.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"ExCeL London, UK\",\n    \"agenda\": \"Focuses on the practical application of AI in marketing, sales, and customer service. Includes workshops on using AI tools for business growth.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Salesforce\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"IBM\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Mark Smith\",\n            \"affiliation\": \"Tech Consulting Firm\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aibusinesslondon\"\n}"}
{"_id": "Academic--scholarly_events--p--71520", "text": "{\n    \"event_name\": \"AI Applications in Industry Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"TechForward Conferences\",\n            \"affiliation\": \"TechForward Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco Convention Center, San Francisco, CA\",\n    \"agenda\": \"Workshops on deploying AI in manufacturing, finance, and healthcare. Case studies of successful AI implementations. Panel discussions on the ethical implications of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Data Solutions Corp\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"InnovateTech Ltd\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Evelyn Reed\",\n            \"affiliation\": \"Google AI Lead\"\n        },\n        {\n            \"name\": \"Mark Davis\",\n            \"affiliation\": \"CEO, InnovateTech Ltd\"\n        }\n    ],\n    \"registration_link\": \"https://www.techforward.com/ai-summit-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71520", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"University AI Research Group\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Presentations on cutting-edge research in AI theory, including deep learning architectures, reinforcement learning algorithms, and computational complexity. Discussions on the mathematical foundations of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Michael Garcia\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Alan Turing\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Dr. Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/ai-theory-2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71521", "text": "{\n    \"event_name\": \"European AI Healthcare Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Geneva, Switzerland\",\n    \"agenda\": \"Key topics include machine learning for diagnostics, AI-driven drug discovery, and ethical considerations in AI healthcare. Includes presentations, workshops, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Health\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Novartis\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aihealthsummit\"\n}"}
{"_id": "Academic--scholarly_events--n--71521", "text": "{\n    \"event_name\": \"AI for Beginners Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Sarah Miller\",\n            \"affiliation\": \"Local Tech Meetup\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Introduction to basic AI concepts, hands-on coding exercises using Python, and examples of AI applications. Designed for students with no prior experience.\",\n    \"attendees\": [\n        {\n            \"name\": \"Tom Davis\",\n            \"affiliation\": \"University College London (Undergraduate)\"\n        },\n        {\n            \"name\": \"Emily White\",\n            \"affiliation\": \"King's College London (Undergraduate)\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Company\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aiworkshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71522", "text": "{\n    \"event_name\": \"European AI & Machine Learning Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"ETH Zurich\",\n            \"affiliation\": \"Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Geneva International Conference Centre, Switzerland\",\n    \"agenda\": \"Key topics include deep learning, computer vision, natural language processing, and practical AI applications in healthcare and finance. Workshops on TensorFlow and PyTorch will be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-symposium-2024\"\n}"}
