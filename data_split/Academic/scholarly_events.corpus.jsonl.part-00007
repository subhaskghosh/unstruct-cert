{"_id": "Academic--scholarly_events--p--71333", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Keynotes on Generative AI, Reinforcement Learning, and Computer Vision. Workshops on deploying AI models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71333", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"Presentations on the foundations of AI, logic programming, and knowledge representation. Emphasis on formal methods.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"IBM Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://www.isaiai.org/register\",\n    \"registration_fee\": 800\n}"}
{"_id": "Academic--scholarly_events--p--71334", "text": "{\n    \"event_name\": \"AI for Robotics and Automation Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT) Computer Science Department\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include robot learning, computer vision for robotics, AI-driven automation in manufacturing, and ethical considerations in AI robotics. Workshops on ROS and TensorFlow for robotics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"Toyota Research Institute\"\n        },\n        {\n            \"name\": \"Alice Lee\",\n            \"affiliation\": \"Boston Dynamics\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon Robotics\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Rodney Brooks\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.airoboticsconf.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71334", "text": "{\n    \"event_name\": \"Advances in Computational Linguistics Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University Linguistics Department\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Focuses on the latest advances in natural language processing, including machine translation, sentiment analysis, and text summarization. Presentations on large language models and their applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Hiroshi Ito\",\n            \"affiliation\": \"University of Tokyo\"\n        },\n        {\n            \"name\": \"Sophia Rodriguez\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Christopher Manning\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.clworkshop.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71335", "text": "{\n    \"event_name\": \"AI Frontiers for Young Researchers\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Massachusetts Institute of Technology, Cambridge, MA\",\n    \"agenda\": \"This workshop focuses on recent advances in AI, with specific tracks on Machine Learning, Computer Vision, and Natural Language Processing. A dedicated session will cover ethical considerations in AI development and deployment.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"NSF\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.org/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71335", "text": "{\n    \"event_name\": \"International Conference on Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"ICML Organizing Committee\",\n            \"affiliation\": \"Various International Universities\"\n        }\n    ],\n    \"event_date\": \"2024-07-21\",\n    \"venue\": \"University of Vienna, Vienna, Austria\",\n    \"agenda\": \"A broad conference covering all aspects of Machine Learning, including theoretical foundations, algorithms, and applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sophia Rodriguez\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Michael Chen\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon AI\",\n        \"IBM Research\",\n        \"EU Horizon Europe\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Ingrid Schmidt\",\n            \"affiliation\": \"Max Planck Institute\"\n        },\n        {\n            \"name\": \"Dr. Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/conferences/2024/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71336", "text": "{\n    \"event_name\": \"International Conference on Deep Learning Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Institute\",\n            \"affiliation\": \"Non-profit Research Organization\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Key topics include convolutional neural networks, recurrent neural networks, generative adversarial networks, and deep reinforcement learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Intel\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal (but speaking in a non-university capacity)\"\n        }\n    ],\n    \"registration_link\": \"https://www.deeplearningconf.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71336", "text": "{\n    \"event_name\": \"Annual Machine Learning Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Stanford, CA\",\n    \"agenda\": \"Covers a broad range of machine learning topics including deep learning, supervised learning, and unsupervised learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Facebook\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://mlsymposium.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71337", "text": "{\n    \"event_name\": \"International Conference on Neural Networks (ICNN)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Prof. Kenji Tanaka\",\n            \"affiliation\": \"Kyoto University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Vancouver Convention Center, Vancouver, Canada\",\n    \"agenda\": \"The conference will cover the latest research in neural networks, including convolutional neural networks, recurrent neural networks, generative adversarial networks, and their applications in computer vision, natural language processing, and robotics. Special emphasis on explainable AI and federated learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Canada Foundation for Innovation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.icnnconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71337", "text": "{\n    \"event_name\": \"AI Frontiers Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Private Sector\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Exploring the latest trends and applications of AI in business and society. Focus on practical implementations and industry use cases.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71338", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Workshops for beginners and advanced researchers are planned.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Facebook AI Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71338", "text": "{\n    \"event_name\": \"Medical AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Healthcare Innovation Group\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Boston Convention Center, Boston, MA\",\n    \"agenda\": \"Focuses on AI applications in radiology, pathology, drug discovery, and personalized medicine. Sessions designed for practicing physicians and medical researchers.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Pfizer\"\n        }\n    ],\n    \"sponsors\": [\n        \"Siemens Healthineers\",\n        \"GE Healthcare\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"registration_link\": \"https://medicalaisummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71339", "text": "{\n    \"event_name\": \"European AI Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Cutting-edge research in AI, including machine learning, deep learning, and natural language processing. Workshops, poster sessions, and invited talks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"Tokyo Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Isabella Rossi\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"National Science Foundation (France)\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computer Vision\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/european-ai-symposium-2024\"\n}"}
