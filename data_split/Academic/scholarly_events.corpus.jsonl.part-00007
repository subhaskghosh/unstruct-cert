{"_id": "Academic--scholarly_events--p--71194", "text": "{\n    \"event_name\": \"AI Ethics and Safety Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Center for AI Safety\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, California, USA\",\n    \"agenda\": \"Discussions on AI alignment, fairness, accountability, and transparency. Includes workshops on responsible AI development.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Open Philanthropy\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Stuart Russell\",\n            \"affiliation\": \"UC Berkeley\",\n            \"expertise\": \"AI Safety\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"AI Ethics\"\n        }\n    ],\n    \"registration_link\": \"https://www.aisafetyworkshop.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71194", "text": "{\n    \"event_name\": \"AI Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"TechSolutions Inc.\",\n            \"affiliation\": \"Commercial Enterprise\"\n        }\n    ],\n    \"event_date\": \"2024-11-22\",\n    \"venue\": \"New York City, USA\",\n    \"agenda\": \"Showcasing AI applications in business, marketing, and sales. Focus on ROI and practical implementation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Marketing Agency\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Salesforce\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Microsoft\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"TechSolutions Inc.\",\n            \"expertise\": \"AI for Business\"\n        }\n    ],\n    \"registration_link\": \"https://www.aibusinesstechnology.com/register\",\n    \"registration_fee\": 650\n}"}
{"_id": "Academic--scholarly_events--p--71195", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Keynotes on recent advancements in deep learning, workshops on AI applications in healthcare and finance, panel discussions on the ethical implications of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon Web Services\",\n        \"Microsoft Azure\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/registration\"\n}"}
