{"_id": "Academic--scholarly_events--p--71980", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA, USA\",\n    \"agenda\": \"Keynote speeches, research paper presentations, workshops on cutting-edge AI techniques, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"expertise\": \"Deep Learning\"\n        },\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\",\n            \"expertise\": \"Convolutional Neural Networks\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
