{"_id": "Academic--scholarly_events--n--71115", "text": "{\n    \"event_name\": \"AI in Business Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"TechConnect\",\n            \"affiliation\": \"TechConnect Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York City, USA\",\n    \"agenda\": \"Practical applications of AI in various business sectors, case studies, and vendor demonstrations.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Satya Nadella\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"registration_link\": \"https://aiinbusinesssummit.com/\"\n}"}
{"_id": "Academic--scholarly_events--p--71116", "text": "{\n    \"event_name\": \"European Conference on Artificial Intelligence (ECAI 2024)\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence (AAAI)\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"The conference agenda includes tracks on knowledge representation, reasoning, machine learning, natural language processing, computer vision, robotics, and multi-agent systems. Workshops and tutorials are also planned.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"Austrian Federal Ministry of Education, Science and Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ecai2024.org/registration/\"\n}"}
{"_id": "Academic--scholarly_events--n--71116", "text": "{\n    \"event_name\": \"AI & Big Data Expo Europe 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"TechEx Event Management Ltd\",\n            \"affiliation\": \"TechEx\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"The expo focuses on showcasing the latest AI and big data solutions for businesses. Sessions include case studies, practical workshops, and vendor demonstrations.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Data Solutions Inc.\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"IBM\",\n        \"AWS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Satya Nadella\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-bigdata-expo.com/europe/#registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71117", "text": "{\n    \"event_name\": \"AI Applications Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This workshop will cover practical applications of AI in healthcare, finance, and transportation. Includes hands-on sessions on TensorFlow and PyTorch. Topics include deep learning, reinforcement learning, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Data Scientist, Acme Corp\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"PhD Student, MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"registration_link\": \"https://aiworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71117", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Thomas Grey\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Oxford University, UK\",\n    \"agenda\": \"This conference will explore the mathematical and philosophical underpinnings of Artificial General Intelligence. Topics include formal logic, computational complexity, and the nature of consciousness.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Green\",\n            \"affiliation\": \"PhD Student, Oxford University\"\n        },\n        {\n            \"name\": \"Mark Davis\",\n            \"affiliation\": \"Postdoc, Cambridge University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Oxford University\",\n        \"The Leverhulme Trust\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alan Turing II\",\n            \"affiliation\": \"University of Theoretical Physics\"\n        }\n    ],\n    \"registration_link\": \"https://agi-theory.ox.ac.uk\"\n}"}
{"_id": "Academic--scholarly_events--p--71118", "text": "{\n    \"event_name\": \"European AI & Machine Learning Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Institute\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Data Science Europe\",\n            \"affiliation\": \"Independent Organization\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning, with a focus on industrial applications and case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71118", "text": "{\n    \"event_name\": \"International Conference on Theoretical AI\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Theory Group\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Focuses on the mathematical foundations of artificial intelligence, algorithmic complexity, and formal methods. Emphasizes rigorous proofs and theoretical advancements.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-theory-conf-2024\",\n    \"registration_fee\": 1500\n}"}
{"_id": "Academic--scholarly_events--p--71119", "text": "{\n    \"event_name\": \"International Conference on Machine Learning Theory and Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"UC Berkeley\",\n            \"affiliation\": \"AI Research Lab\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston, Massachusetts, USA\",\n    \"agenda\": \"The conference will cover topics such as deep learning, reinforcement learning, generative models, and Bayesian methods, with sessions dedicated to both theoretical advancements and real-world applications in healthcare, finance, and autonomous systems.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google AI\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/icmla2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71119", "text": "{\n    \"event_name\": \"AI Solutions Expo 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"TechForward Events\",\n            \"affiliation\": \"Event Management Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Las Vegas, Nevada, USA\",\n    \"agenda\": \"This expo focuses on showcasing the latest AI products and services for business. Sessions will highlight case studies of successful AI implementations and offer demonstrations of cutting-edge technologies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Miller\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Sarah Wilson\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aisolutions2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71120", "text": "{\n    \"event_name\": \"AI & Ethics in Practice Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This workshop explores the practical implementation of ethical AI principles. Topics include bias detection and mitigation, fairness in algorithms, and responsible data handling. Case studies will be presented focusing on real-world applications in healthcare and finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiethics.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71120", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"MIT Computer Science Department\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"MIT Media Lab, Cambridge, MA\",\n    \"agenda\": \"This conference delves into the theoretical underpinnings of AI, including advanced mathematical frameworks, computational complexity, and philosophical implications. Focus is placed on fundamental research and abstract concepts.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"DARPA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"registration_link\": \"https://theoryai.mit.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71121", "text": "{\n    \"event_name\": \"European AI and Machine Learning Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Institute for Advanced Technology, Germany\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University, France\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Berlin Conference Center, Berlin, Germany\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Workshops and poster sessions are also planned.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"Tokyo University\"\n        },\n        {\n            \"name\": \"Professor Emily Carter\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Siemens\",\n        \"Bosch\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/eaimls2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71121", "text": "{\n    \"event_name\": \"AI Frontiers Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Stanford University, USA\"\n        }\n    ],\n    \"event_date\": \"2024-12-10\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Covers a wide range of AI topics, including machine learning, robotics, and AI ethics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Maria Rodriguez\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com\"\n}"}
{"_id": "Academic--scholarly_events--p--71122", "text": "{\n    \"event_name\": \"International Conference on AI Ethics and Governance\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Prof. Kenji Tanaka\",\n            \"affiliation\": \"Kyoto University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Oxford University, UK\",\n    \"agenda\": \"Key topics include fairness, accountability, transparency, and the societal impact of AI. Sessions will feature research presentations, panel discussions, and workshops.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Alfred P. Sloan Foundation\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiethics.oxford.edu/register\"\n}"}
