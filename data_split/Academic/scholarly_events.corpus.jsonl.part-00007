{"_id": "Academic--scholarly_events--p--71006", "text": "{\n    \"event_name\": \"AI Ethics and Responsible Innovation Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford Center for Artificial Intelligence\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Workshops on fairness, accountability, and transparency in AI systems. Discussions on AI safety and societal impact. Case studies of ethical dilemmas in AI development.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT Media Lab\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71006", "text": "{\n    \"event_name\": \"Global AI Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"TechConnect Events\",\n            \"affiliation\": \"Private Event Company\"\n        }\n    ],\n    \"event_date\": \"2024-11-28\",\n    \"venue\": \"New York City, NY\",\n    \"agenda\": \"Comprehensive coverage of AI technologies including machine learning, deep learning, natural language processing, and computer vision. Tracks for industry applications, research breakthroughs, and future trends.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Microsoft\"\n        },\n        {\n            \"name\": \"Eve Frank\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"Microsoft\",\n        \"IBM\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://www.globalaisummit.com/register\",\n    \"attendees_count\": 650\n}"}
{"_id": "Academic--scholarly_events--p--71007", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"Keynotes on latest AI research, workshops on deep learning, and panel discussions on the future of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"NYU\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
