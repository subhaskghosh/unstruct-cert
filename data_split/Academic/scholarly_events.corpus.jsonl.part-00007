{"_id": "Academic--scholarly_events--p--70277", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"The conference will feature cutting-edge research on generative models, reinforcement learning, and the ethical implications of AI. Sessions include presentations on the latest advancements in Large Language Models and their applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70277", "text": "{\n    \"event_name\": \"International Conference on Data Mining\",\n    \"organizers\": [\n        {\n            \"name\": \"Data Mining Association\",\n            \"affiliation\": \"Professional Organization\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Hilton Hotel, Chicago, IL\",\n    \"agenda\": \"The conference covers a broad range of data mining techniques, including clustering, classification, and association rule learning. Emphasis on established methods and practical applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"Accenture\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Accenture\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Jiawei Han\",\n            \"affiliation\": \"University of Illinois at Urbana-Champaign\"\n        }\n    ],\n    \"registration_link\": \"https://www.dataminingconf.org/register\"\n}"}
