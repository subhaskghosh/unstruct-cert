{"_id": "Academic--scholarly_events--p--70732", "text": "{\n    \"event_name\": \"AI in Healthcare Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"UCSF Medical Center\",\n            \"affiliation\": \"Research Department\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Moscone Center, San Francisco, CA\",\n    \"agenda\": \"Keynotes on AI diagnostics, workshops on machine learning applications in surgery, presentations on AI-powered drug discovery, and panel discussions on ethical considerations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcare2024.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70732", "text": "{\n    \"event_name\": \"Foundations of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"MIT Campus, Cambridge, MA\",\n    \"agenda\": \"A deep dive into the mathematical and philosophical underpinnings of artificial intelligence, covering topics like logic, probability, and computational complexity. Presentations on formal verification and theorem proving.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        },\n        {\n            \"name\": \"Professor Daphne Koller\",\n            \"affiliation\": \"Insitut d'Etudes Avancées de Paris\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": null\n}"}
{"_id": "Academic--scholarly_events--p--70733", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Keynotes on deep learning, workshops on reinforcement learning, and paper presentations on the latest advancements in AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://icaiml.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70733", "text": "{\n    \"event_name\": \"Annual History Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Historical Society of America\",\n            \"affiliation\": \"Non-profit Organization\"\n        }\n    ],\n    \"event_date\": \"2024-05-20\",\n    \"venue\": \"Washington D.C. Convention Center\",\n    \"agenda\": \"Presentations on various historical topics, panel discussions, and a book fair.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Brown\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Diana Miller\",\n            \"affiliation\": \"Smithsonian Institution\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Endowment for the Humanities\",\n        \"Ford Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Reynolds\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"registration_link\": \"https://historysymposium.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70734", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Day 1: Keynote on Deep Learning, Workshops on Reinforcement Learning. Day 2: Panel Discussion on Ethical AI, Paper Presentations. Day 3: Hackathon.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70734", "text": "{\n    \"event_name\": \"Annual History Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Historical Society of America\",\n            \"affiliation\": \"Non-profit Organization\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Washington D.C. Convention Center\",\n    \"agenda\": \"Morning session: Presentations on Medieval History. Afternoon session: Roundtable discussion on 20th-century conflicts. Evening: Gala Dinner.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Brown\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"Columbia University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Endowment for the Humanities\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor John Smith\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"registration_link\": \"https://historysymposium.org/register\",\n    \"registration_fee\": 650\n}"}
{"_id": "Academic--scholarly_events--p--70735", "text": "{\n    \"event_name\": \"International Conference on Advanced AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"This conference explores the latest advancements in deep learning, neural networks, and AI ethics, focusing on innovative applications in healthcare and robotics. Topics include generative AI, explainable AI, and reinforcement learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computer Vision\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--70735", "text": "{\n    \"event_name\": \"Traditional Statistics and Data Analysis Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"Department of Statistics\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"A workshop covering fundamental statistical methods, including regression analysis, hypothesis testing, and experimental design. Focuses on established techniques and practical applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"UC Berkeley Statistical Computing Facility\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Tukey\",\n            \"affiliation\": \"Princeton University (historical)\",\n            \"expertise\": \"Exploratory Data Analysis\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/stats-workshop-registration\",\n    \"registration_fee\": 750\n}"}
