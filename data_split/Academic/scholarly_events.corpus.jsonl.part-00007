{"_id": "Academic--scholarly_events--p--70396", "text": "{\n    \"event_name\": \"European Conference on AI Ethics and Governance\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Ethics Association\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"European Commission - Digital Innovation Hubs\",\n            \"affiliation\": \"European Commission\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Key topics include bias in AI, fairness, accountability, transparency, and the societal impact of AI. Workshops on implementing ethical AI frameworks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Prof. Jean Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"IBM Research\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aieethicsconference.eu/register\"\n}"}
