{"_id": "Academic--scholarly_events--p--70341", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University College London\",\n            \"affiliation\": \"UCL, London\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"ExCeL London\",\n    \"agenda\": \"Exploration of cutting-edge research in AI, machine learning, and deep learning, including presentations on generative models, reinforcement learning, and ethical considerations. Focus on future trends and disruptive technologies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Google DeepMind\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning, AI Ethics\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.co.uk/registration\"\n}"}
