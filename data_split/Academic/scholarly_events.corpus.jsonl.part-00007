{"_id": "Academic--scholarly_events--p--71908", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University Center for AI Ethics\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"Key topics include bias in AI, algorithmic fairness, responsible AI development, and the societal impact of AI technologies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Alfred P. Sloan Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Timnit Gebru\",\n            \"affiliation\": \"Distributed AI Research Institute\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71908", "text": "{\n    \"event_name\": \"Global AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"TechForward Institute\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Cutting-edge advancements in AI, machine learning, and deep learning applications across various industries.\",\n    \"attendees\": [\n        {\n            \"name\": \"Eve Rodriguez\",\n            \"affiliation\": \"Amazon\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Meta\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        },\n        {\n            \"name\": \"Professor Daphne Koller\",\n            \"affiliation\": \"insitro\"\n        }\n    ],\n    \"registration_link\": \"https://www.globalaisummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71909", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"The conference covers cutting-edge research in AI, including deep learning, natural language processing, computer vision, and robotics. It includes keynote speeches, workshops, and poster sessions. Sessions will cover both theoretical advances and practical applications in healthcare, finance, and transportation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.com/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71909", "text": "{\n    \"event_name\": \"AI and Machine Learning Webinar Series\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Insights Group\",\n            \"affiliation\": \"TIG\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Online\",\n    \"agenda\": \"A series of webinars covering introductory concepts in AI and Machine Learning. Topics include linear regression, clustering, and basic neural networks. The focus is on providing a gentle introduction for beginners.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Beginner AI Enthusiast\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Data Science Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"Tech Insights Group\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Miller\",\n            \"affiliation\": \"Tech Insights Group\"\n        }\n    ],\n    \"registration_link\": \"https://www.techinsightsgroup.com/webinar-series\"\n}"}
