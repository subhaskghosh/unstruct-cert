{"_id": "Academic--scholarly_events--p--71178", "text": "{\n    \"event_name\": \"AI Ethics and Governance Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University, Center for AI Safety\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Keynote speeches on AI bias, fairness, accountability, and transparency. Panel discussions on AI regulation and societal impact. Workshops on implementing ethical AI frameworks. Research paper presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Ethan Foster\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Alfred P. Sloan Foundation\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Isabelle Klein\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/aiethicsconference2024\"\n}"}
