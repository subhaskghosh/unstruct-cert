{"_id": "Academic--scholarly_events--p--71103", "text": "{\n    \"event_name\": \"European Conference on Artificial Intelligence Advances\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence (AAAI)\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"The conference will cover topics such as deep learning, natural language processing, computer vision, and robotics. Key sessions include workshops on generative models and ethical AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Union\",\n        \"IBM\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.ecaia-conf.org/register\"\n}"}
