{"_id": "Academic--scholarly_events--p--71186", "text": "{\n    \"event_name\": \"International Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"AI Research Institute\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"University of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco Convention Center, CA\",\n    \"agenda\": \"Cutting-edge research in machine learning, deep learning, natural language processing, and computer vision. Includes workshops on AI applications in healthcare and finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Mark Wilson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Emily Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-conference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71186", "text": "{\n    \"event_name\": \"AI Ethics and Society Forum\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Sarah Jones\",\n            \"affiliation\": \"Center for Responsible AI\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Online Webinar\",\n    \"agenda\": \"Discussions on the ethical challenges and societal impact of artificial intelligence. Topics include bias, fairness, accountability, and transparency.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Human Rights Watch\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"Ethical AI Consulting\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Ford Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Laura Miller\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsforum.org/register\"\n}"}
