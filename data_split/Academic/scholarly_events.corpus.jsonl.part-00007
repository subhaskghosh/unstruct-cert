{"_id": "Academic--scholarly_events--p--71537", "text": "{\n    \"event_name\": \"AI for Good: Ethical and Sustainable Frontiers\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford AI Lab\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT Media Lab\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Key topics include AI ethics, responsible AI development, sustainable AI practices, AI in healthcare, and AI for environmental conservation. Workshops on algorithmic bias and fairness.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"OpenAI\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"h_index\": 65\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"h_index\": 80\n        }\n    ],\n    \"registration_link\": \"https://www.aiforgoodconference.org/register\"\n}"}
