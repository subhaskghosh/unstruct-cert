{"_id": "Academic--scholarly_events--p--71366", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"Key topics include: Deep Learning Applications, Computer Vision, Natural Language Processing, Reinforcement Learning, and AI Ethics.  Workshops on practical implementation of AI models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71366", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial Intelligence Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Institute for Advanced Studies\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Princeton University, New Jersey\",\n    \"agenda\": \"Focuses on the mathematical and philosophical underpinnings of AI. Topics include: Formal Logic, Computational Complexity, and the Limits of Computation. No practical workshops or case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. John McCarthy\",\n            \"affiliation\": \"Stanford University (Emeritus)\"\n        }\n    ],\n    \"registration_link\": \"https://theoreticalai.org/register\"\n}"}
