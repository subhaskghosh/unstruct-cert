{"_id": "Academic--scholarly_events--p--70730", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence Advancements\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Latest research in machine learning, deep learning, natural language processing, and computer vision. Workshops on ethical AI and responsible innovation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"topic\": \"The Future of Deep Learning\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"Human-Centered AI\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70730", "text": "{\n    \"event_name\": \"Historical Linguistics Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"The Linguistic Society of America\",\n            \"affiliation\": \"Linguistic Society of America\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"University of Oxford, UK\",\n    \"agenda\": \"Presentations on the history of languages, etymology, and language change. Focus on Indo-European languages.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Darwin\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Noam Chomsky\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"The British Academy\",\n        \"Oxford University Press\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Crystal\",\n            \"affiliation\": \"University of Reading\",\n            \"topic\": \"The Cambridge Encyclopedia of Language\"\n        }\n    ],\n    \"registration_link\": \"https://linguisticsymposium.ox.ac.uk/register\"\n}"}
