{"_id": "Academic--scholarly_events--n--70195", "text": "{\n    \"event_name\": \"Machine Learning Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Carnegie Mellon University Machine Learning Department\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"CMU Campus, Pittsburgh\",\n    \"agenda\": \"This workshop will focus exclusively on the latest advancements in supervised and unsupervised machine learning algorithms. Topics will include deep learning, reinforcement learning, and Bayesian methods.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Amazon AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Judea Pearl\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"registration_link\": \"https://www.mlworkshop.org/register\"\n}"}
