{"_id": "Academic--scholarly_events--p--70347", "text": "{\n    \"event_name\": \"International Conference on Advanced Machine Learning (ICAML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"The conference will cover topics such as generative AI, reinforcement learning, explainable AI, and novel deep learning architectures. A dedicated workshop on quantum machine learning is also included.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://icaml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70347", "text": "{\n    \"event_name\": \"Workshop on Traditional Statistical Modeling\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"This workshop focuses on linear regression, ANOVA, and time series analysis. It's aimed at providing a foundational understanding of statistical modeling techniques.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Ruppert\",\n            \"affiliation\": \"Duke University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Bradley Efron\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://statmodel.berkeley.edu/register\"\n}"}
