{"_id": "Academic--scholarly_events--p--70121", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"This conference focuses on cutting-edge research in Artificial Intelligence, Machine Learning, Deep Learning, and related fields. Topics include Natural Language Processing, Computer Vision, and Robotics. Special track for early career researchers.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70121", "text": "{\n    \"event_name\": \"International Conference on Machine Learning 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"This conference covers all aspects of Machine Learning, including theoretical foundations, algorithms, and applications.  Includes sessions on AI and data science.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"IBM\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.icml2024.org/register\"\n}"}
