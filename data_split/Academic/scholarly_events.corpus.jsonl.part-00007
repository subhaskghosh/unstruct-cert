{"_id": "Academic--scholarly_events--p--71675", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Frontiers Foundation\",\n            \"affiliation\": \"Non-profit organization\"\n        }\n    ],\n    \"event_date\": \"2024-11-22\",\n    \"venue\": \"Moscone Center, San Francisco, CA\",\n    \"agenda\": \"The conference agenda includes sessions on Large Language Models, Generative AI, Reinforcement Learning, and AI Ethics. Workshops on practical AI implementation will also be offered.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Amazon Web Services\",\n        \"Microsoft Azure\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71675", "text": "{\n    \"event_name\": \"AI & Society Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Social Impact AI Group\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-18\",\n    \"venue\": \"Hyatt Regency, San Francisco, CA\",\n    \"agenda\": \"The symposium focuses on the societal implications of AI, including bias, fairness, and accountability. Discussions will cover policy and ethical considerations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Human Rights Watch\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Electronic Frontier Foundation\"\n        }\n    ],\n    \"sponsors\": [\n        \"Meta\",\n        \"OpenAI\",\n        \"Ford Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Kate Crawford\",\n            \"affiliation\": \"University of Southern California\"\n        }\n    ],\n    \"registration_link\": \"https://www.aisociety.org/symposium\"\n}"}
{"_id": "Academic--scholarly_events--p--71676", "text": "{\n    \"event_name\": \"AI in Industry Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Industrial AI\",\n            \"affiliation\": \"AIIA\"\n        },\n        {\n            \"name\": \"TechForward Conferences\",\n            \"affiliation\": \"TFC\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include: Machine Learning Applications in Manufacturing, AI-Driven Healthcare Solutions, and the Future of Robotics. Workshops on deploying AI models in real-world scenarios will be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"HealthSolutions Inc.\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiindustrys.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71676", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"International AI Research Group\",\n            \"affiliation\": \"IAR\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"University of California, Berkeley\",\n    \"agenda\": \"This conference will explore the abstract mathematical underpinnings of Artificial Intelligence, including advanced topics in logic, game theory, and computational complexity. Focus is on pure theoretical research.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alan Turing Jr.\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"registration_link\": \"https://theoreticalai.org/registration\"\n}"}
