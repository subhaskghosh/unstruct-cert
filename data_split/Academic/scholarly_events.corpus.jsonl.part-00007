{"_id": "Academic--scholarly_events--p--70793", "text": "{\n    \"event_name\": \"International Conference on AI Frontiers\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-04-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"This conference will cover cutting-edge research in deep learning, natural language processing, computer vision, and robotics. Sessions include workshops on generative AI, ethical considerations in AI, and the future of AI-driven healthcare. The agenda is designed to inspire innovation and collaborative problem-solving in the field of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"IBM\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70793", "text": "{\n    \"event_name\": \"Data Science and Analytics Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Texas at Austin\",\n            \"affiliation\": \"McCombs School of Business\"\n        }\n    ],\n    \"event_date\": \"2024-05-20\",\n    \"venue\": \"Austin Convention Center, TX\",\n    \"agenda\": \"This symposium focuses on practical applications of data science in business and industry. Topics include data mining, machine learning, and data visualization.  Sessions will cover case studies and best practices.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Deloitte\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Accenture\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"SAS Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"registration_link\": \"https://www.datasymposium.com/register\"\n}"}
