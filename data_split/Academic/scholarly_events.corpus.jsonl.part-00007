{"_id": "Academic--scholarly_events--n--71638", "text": "{\n    \"event_name\": \"AI in Business Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Industry Event Organizer\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Anaheim Convention Center, California, USA\",\n    \"agenda\": \"Focuses on the practical application of AI and Machine Learning in various industries. Includes case studies, workshops on tools, and vendor demonstrations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Lee\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Mark Davis\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiinbusiness.com/register\"\n}"}
