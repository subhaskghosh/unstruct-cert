{"_id": "Academic--scholarly_events--p--70723", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Keynotes on Deep Learning, Computer Vision, Natural Language Processing, and Robotics. Workshops on AI ethics and applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Edward Wilson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Fiona Green\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"George Hall\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Hannah Ito\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Ian King\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"Julia Lee\",\n            \"affiliation\": \"Facebook AI Research\"\n        },\n        {\n            \"name\": \"Kevin Moore\",\n            \"affiliation\": \"Amazon AI\"\n        },\n        {\n            \"name\": \"Laura Nash\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Michael Owens\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Nancy Perez\",\n            \"affiliation\": \"Yale University\"\n        },\n        {\n            \"name\": \"Oliver Quinn\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Patricia Roberts\",\n            \"affiliation\": \"Cornell University\"\n        },\n        {\n            \"name\": \"Quentin Stone\",\n            \"affiliation\": \"Columbia University\"\n        },\n        {\n            \"name\": \"Rachel Thomas\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Samuel Underwood\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Tina Vance\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Ursula White\",\n            \"affiliation\": \"National University of Singapore\"\n        },\n        {\n            \"name\": \"Victor Xavier\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-registration\"\n}"}
