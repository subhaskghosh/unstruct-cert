{"_id": "Academic--scholarly_events--p--70509", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference will explore the latest advancements in AI, including deep learning, natural language processing, and computer vision. Topics include explainable AI, generative models, and the ethical implications of AI. Focus on emerging technologies like neuromorphic computing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70509", "text": "{\n    \"event_name\": \"Annual Humanities Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Oxford University\",\n            \"affiliation\": \"Faculty of Arts and Humanities\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Oxford University, Oxford, UK\",\n    \"agenda\": \"A multidisciplinary symposium exploring themes in literature, history, and philosophy. Discussions will cover classical texts, modern interpretations, and the future of humanities research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"sponsors\": [\n        \"The National Endowment for the Humanities\",\n        \"The British Academy\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Noam Chomsky\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://humanities-symposium.oxford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70510", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML 2024)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Keynote speeches, workshops, poster sessions covering latest advancements in AI/ML, including deep learning, natural language processing, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://icaiml.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70510", "text": "{\n    \"event_name\": \"Workshop on Data Mining and Knowledge Discovery\",\n    \"organizers\": [\n        {\n            \"name\": \"California State University, Long Beach\",\n            \"affiliation\": \"Department of Computer Engineering and Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"California State University, Long Beach, CA\",\n    \"agenda\": \"Practical sessions on data mining algorithms and applications. Focus on business analytics and introductory machine learning techniques.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Local Business Analyst\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Student, CSULB\"\n        }\n    ],\n    \"sponsors\": [\n        \"California State University, Long Beach\",\n        \"KPMG\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"CSULB\"\n        }\n    ],\n    \"registration_link\": \"https://dmkd.csulb.edu/workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--70511", "text": "{\n    \"event_name\": \"International Conference on Advanced Machine Learning (ICAML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"ICAML will feature presentations on the latest advancements in deep learning, reinforcement learning, generative models, and explainable AI.  Topics include novel architectures, efficient training methods, and applications in healthcare, finance, and autonomous systems. Focus will be on research exploring fundamental limits and breakthrough innovations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google Brain\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70511", "text": "{\n    \"event_name\": \"Workshop on Practical Machine Learning Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"Data Science Consulting Group\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York City Conference Center\",\n    \"agenda\": \"This workshop will cover the basics of applying machine learning to solve real-world business problems. Topics include data cleaning, feature engineering, and model evaluation using common libraries like scikit-learn.  Focus is on pragmatic implementations rather than theoretical research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Beta Inc.\"\n        }\n    ],\n    \"sponsors\": [\n        \"Data Science Consulting Group\",\n        \"Amazon AWS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Data Science Consulting Group\"\n        }\n    ],\n    \"registration_link\": \"https://www.datascienceworkshop.com/register\"\n}"}
