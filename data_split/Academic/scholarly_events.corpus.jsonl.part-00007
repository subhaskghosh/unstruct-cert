{"_id": "Academic--scholarly_events--n--71878", "text": "{\n    \"event_name\": \"International Conference on Neural Information Processing Systems (NeurIPS 2024)\",\n    \"organizers\": [\n        {\n            \"name\": \"NeurIPS Organising Committee\",\n            \"affiliation\": \"NeurIPS Foundation\"\n        }\n    ],\n    \"event_date\": \"2024-12-08\",\n    \"venue\": \"Vancouver, BC, Canada\",\n    \"agenda\": \"Covers all areas of neural information processing systems, with a strong emphasis on deep learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"Facebook\",\n        \"Google\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://neurips.cc/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71879", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and robotics. Research paper presentations, poster sessions, and panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://ai-research-conf.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71879", "text": "{\n    \"event_name\": \"AI Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"TechSolutions Inc.\",\n            \"affiliation\": \"AI Division\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Online (Zoom)\",\n    \"agenda\": \"Hands-on tutorials on using AI tools for business applications. Focus on practical implementation and case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Beta Ltd.\"\n        }\n    ],\n    \"sponsors\": [\n        \"TechSolutions Inc.\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://techsolutions.com/ai-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71880", "text": "{\n    \"event_name\": \"AI Ethics & Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford Center for Artificial Intelligence\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Oxford Internet Institute\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Keynote speeches on AI bias, fairness, accountability, and transparency. Panel discussions on the societal impact of AI, workshops on ethical AI development, and poster sessions showcasing research in AI ethics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Timnit Gebru\",\n            \"affiliation\": \"Distributed AI Research Institute\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiethics2024\"\n}"}
