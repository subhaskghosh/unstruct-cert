{"_id": "Academic--scholarly_events--p--70193", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"This conference covers cutting-edge research in Artificial Intelligence, Machine Learning, Deep Learning, Natural Language Processing, and Computer Vision. Key topics include generative models, reinforcement learning, and AI ethics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Grace Taylor\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Henry Moore\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Ivy Green\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Jack White\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Kelly Black\",\n            \"affiliation\": \"National University of Singapore\"\n        },\n        {\n            \"name\": \"Liam Gray\",\n            \"affiliation\": \"Tsinghua University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://icaiml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70193", "text": "{\n    \"event_name\": \"Workshop on Bioinformatics and Computational Biology\",\n    \"organizers\": [\n        {\n            \"name\": \"Harvard Medical School\",\n            \"affiliation\": \"Department of Genetics\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Harvard University, Cambridge, MA\",\n    \"agenda\": \"This workshop focuses on the latest advances in bioinformatics, genomics, proteomics, and computational biology. Topics include sequence alignment, phylogenetic analysis, and protein structure prediction.\",\n    \"attendees\": [\n        {\n            \"name\": \"Olivia Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Peter Jones\",\n            \"affiliation\": \"Broad Institute\"\n        },\n        {\n            \"name\": \"Quinn Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ryan Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Broad Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Eric Lander\",\n            \"affiliation\": \"Broad Institute\"\n        }\n    ],\n    \"registration_link\": \"https://bioinformatics.harvard.edu/workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--70194", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Hyatt Regency, San Francisco\",\n    \"agenda\": \"Latest advancements in Generative AI, Reinforcement Learning, and Ethical AI. Workshops on deploying AI in healthcare and finance. Discussion on the future of AGI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70194", "text": "{\n    \"event_name\": \"Historical Perspectives in Computer Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Professor Emily Wilson\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"The British Library, London\",\n    \"agenda\": \"A retrospective look at the foundational algorithms and architectures in computer science. Discussions on the pioneers of computing and their contributions. Analysis of early programming languages.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Sarah Green\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"The Heritage Lottery Fund\",\n        \"The Royal Society\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alan Turing (posthumously)\",\n            \"affiliation\": \"University of Manchester\"\n        },\n        {\n            \"name\": \"Grace Hopper (posthumously)\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"registration_link\": \"https://historycompsci.org/registration\"\n}"}
