{"_id": "Academic--scholarly_events--n--71595", "text": "{\n    \"event_name\": \"Symposium on Formal Methods in Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"University of Oxford, Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Oxford University, UK\",\n    \"agenda\": \"Presentations on formal verification of AI systems, logical reasoning in AI, and theoretical foundations of machine learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Emily Green\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"EPSRC\",\n        \"The Alan Turing Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Martin Hofmann\",\n            \"affiliation\": \"RWTH Aachen University\"\n        }\n    ],\n    \"registration_link\": \"https://www.formalai.org/register\"\n}"}
