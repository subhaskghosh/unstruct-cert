{"_id": "Academic--scholarly_events--n--70855", "text": "{\n    \"event_name\": \"European History and Culture Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Ingrid Olsen\",\n            \"affiliation\": \"University of Oslo\"\n        },\n        {\n            \"name\": \"Prof. Alessandro Rossi\",\n            \"affiliation\": \"University of Rome\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"This symposium will cover topics in European history from the medieval period to the present day, including political, social, and cultural aspects.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Elizabeth Carter\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Dr. Hans Müller\",\n            \"affiliation\": \"Heidelberg University\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Cultural Foundation\",\n        \"UNESCO\",\n        \"French Ministry of Culture\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Natalie Zemon Davis\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Christopher Bayly\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"registration_link\": \"https://www.eurohistorysymposium.org/register\"\n}"}
