{"_id": "Academic--scholarly_events--n--70382", "text": "{\n    \"event_name\": \"European History Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"University of Paris\"\n        },\n        {\n            \"name\": \"Prof. Eleanor Green\",\n            \"affiliation\": \"University of Rome\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Rome, Italy\",\n    \"agenda\": \"Explores various periods and themes in European history. Includes presentations on political, social, and cultural developments.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Emily Clark\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Cultural Foundation\",\n        \"National Endowment for the Humanities\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. John White\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"registration_link\": \"https://history-symposium.org/register\"\n}"}
