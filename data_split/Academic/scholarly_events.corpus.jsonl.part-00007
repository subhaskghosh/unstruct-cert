{"_id": "Academic--scholarly_events--p--71290", "text": "{\n    \"event_name\": \"AI Ethics and Safety Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford Center for AI Safety\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Partnership on AI\",\n            \"affiliation\": \"Industry Consortium\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Topics include: AI bias, fairness, accountability, transparency, robustness, and long-term AI safety. Workshops and panel discussions will be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Stuart Russell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.aisafetyconf.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71290", "text": "{\n    \"event_name\": \"Machine Learning Applications in Business\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York Marriott Marquis, New York, NY\",\n    \"agenda\": \"Focuses on practical applications of machine learning in marketing, finance, and operations. Includes case studies and hands-on workshops.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\",\n        \"AWS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://www.mlbusiness.com/register\"\n}"}
