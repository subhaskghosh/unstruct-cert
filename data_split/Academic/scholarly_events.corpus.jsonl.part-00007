{"_id": "Academic--scholarly_events--p--71443", "text": "{\n    \"event_name\": \"European AI and Machine Learning Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Conference Organizers Ltd.\",\n            \"affiliation\": \"Independent Conference Company\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Advanced topics in Deep Learning, Reinforcement Learning, and Generative AI. Focus on research and practical applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aisummit\"\n}"}
{"_id": "Academic--scholarly_events--n--71443", "text": "{\n    \"event_name\": \"Introduction to AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"RWTH Aachen University\",\n            \"affiliation\": \"RWTH Aachen University\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Aachen, Germany\",\n    \"agenda\": \"Basic concepts of AI, introductory Python programming for Machine Learning, and simple model building.\",\n    \"attendees\": [\n        {\n            \"name\": \"Lisa Müller\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"Hans Schmidt\",\n            \"affiliation\": \"Beginner\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local IT Companies\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Elena Weber\",\n            \"affiliation\": \"RWTH Aachen University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiworkshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71444", "text": "{\n    \"event_name\": \"California AI & Machine Learning Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"UC Berkeley EECS Department\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"This symposium focuses on cutting-edge research in Artificial Intelligence and Machine Learning, including deep learning, natural language processing, and computer vision. Topics include generative models, reinforcement learning, and ethical considerations in AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"California Energy Commission\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/caimlsymposium2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71444", "text": "{\n    \"event_name\": \"International Conference on Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Global Data Science Institute\",\n            \"affiliation\": \"Various\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"New York, NY\",\n    \"agenda\": \"This conference covers a broad range of data science topics, including statistical modeling, data mining, and data visualization. Some sessions touch upon machine learning applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Amazon\"\n        },\n        {\n            \"name\": \"Frank Green\",\n            \"affiliation\": \"Deloitte\"\n        },\n        {\n            \"name\": \"Grace Hall\",\n            \"affiliation\": \"JP Morgan\"\n        },\n        {\n            \"name\": \"Henry King\",\n            \"affiliation\": \"Netflix\"\n        }\n    ],\n    \"sponsors\": [\n        \"TechCorp Solutions\",\n        \"Data Analytics Inc.\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Sarah Miller\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/datascienceconference2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71445", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        },\n        {\n            \"name\": \"Machine Learning Research Group\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Moscone Center, San Francisco, CA\",\n    \"agenda\": \"Keynote talks on deep learning, reinforcement learning, and natural language processing. Workshops on applying AI to finance and cybersecurity. Poster sessions showcasing recent research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"Amazon AI\"\n        },\n        {\n            \"name\": \"Frank Garcia\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Grace Kim\",\n            \"affiliation\": \"CMU\"\n        },\n        {\n            \"name\": \"Henry Nguyen\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Ivy Patel\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Jack Rodriguez\",\n            \"affiliation\": \"Georgia Tech\"\n        },\n        {\n            \"name\": \"Kelly Thompson\",\n            \"affiliation\": \"University of Texas at Austin\"\n        },\n        {\n            \"name\": \"Liam White\",\n            \"affiliation\": \"University of Illinois at Urbana-Champaign\"\n        },\n        {\n            \"name\": \"Mia Harris\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Noah Martin\",\n            \"affiliation\": \"Yale University\"\n        },\n        {\n            \"name\": \"Olivia Anderson\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71445", "text": "{\n    \"event_name\": \"AI in Healthcare Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Healthcare Informatics Association\",\n            \"affiliation\": \"HIA\"\n        },\n        {\n            \"name\": \"Medical AI Research Institute\",\n            \"affiliation\": \"MARI\"\n        }\n    ],\n    \"event_date\": \"2024-12-10\",\n    \"venue\": \"Hyatt Regency, Boston, MA\",\n    \"agenda\": \"Presentations on using AI for disease diagnosis, drug discovery, and personalized medicine. Panel discussions on the ethical implications of AI in healthcare. Workshops on implementing AI solutions in hospitals.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Robert Davis\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Johns Hopkins Hospital\"\n        },\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"Cleveland Clinic\"\n        },\n        {\n            \"name\": \"Ashley Taylor\",\n            \"affiliation\": \"UCSF Medical Center\"\n        }\n    ],\n    \"sponsors\": [\n        \"Pfizer\",\n        \"Johnson & Johnson\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Eric Topol\",\n            \"affiliation\": \"Scripps Research\"\n        },\n        {\n            \"name\": \"Anthony Fauci\",\n            \"affiliation\": \"NIAID\"\n        }\n    ],\n    \"registration_link\": \"https://www.aihealthcare.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71446", "text": "{\n    \"event_name\": \"European Conference on Applied AI & Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Institute\",\n            \"affiliation\": \"University of Zurich\"\n        },\n        {\n            \"name\": \"ML Innovations Ltd.\",\n            \"affiliation\": \"Private Sector\"\n        }\n    ],\n    \"event_date\": \"2024-03-10\",\n    \"venue\": \"Berlin Congress Center, Germany\",\n    \"agenda\": \"Deep Learning, Computer Vision, NLP, Reinforcement Learning, AI in Robotics, Responsible AI, Ethical Considerations, Case Studies in Industry Applications\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ecaai2024\"\n}"}
