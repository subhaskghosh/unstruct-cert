{"_id": "Academic--scholarly_events--p--71672", "text": "{\n    \"event_name\": \"AI for Business Innovation Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"TechForward Inc.\",\n            \"affiliation\": \"Industry Consortium\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Workshops on applying AI in marketing, finance, and healthcare. Case studies of successful AI implementations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Data Analytics Corp.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Innovate Solutions\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"AWS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aibusinnesummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71672", "text": "{\n    \"event_name\": \"Foundations of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"The Theoretical AI Society\",\n            \"affiliation\": \"Academic Organization\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"Discussions on the philosophical implications of AGI, formal proofs of AI algorithm convergence, and the limits of computability.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alan Turing Jr.\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"registration_link\": \"https://www.agi-foundations.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71673", "text": "{\n    \"event_name\": \"International Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"Keynote speeches on generative models, reinforcement learning, and ethical AI. Workshops on deep learning frameworks and applications. Poster sessions for recent research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71673", "text": "{\n    \"event_name\": \"AI for Business Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"TechSolutions Inc.\",\n            \"affiliation\": \"Private Consulting Firm\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Online - Zoom Webinar\",\n    \"agenda\": \"Introduction to AI concepts for business applications. Case studies on AI implementation. Hands-on exercises with popular AI tools.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"ABC Corp\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"XYZ Inc\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://techsolutions.com/aiworkshop\"\n}"}
