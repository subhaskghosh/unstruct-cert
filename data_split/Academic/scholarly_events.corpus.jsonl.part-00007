{"_id": "Academic--scholarly_events--p--70497", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"Boston Convention and Exhibition Center\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Workshops and tutorials will also be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiml.org/register\"\n}"}
