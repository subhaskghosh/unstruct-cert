{"_id": "Academic--scholarly_events--p--70797", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Department of Computer Science, Stanford University\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Center for AI and Ethics, MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include algorithmic bias, fairness in AI, explainable AI, and the societal impact of AI technologies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Ethan Foster\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google AI\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Isabelle Rodriguez\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconf.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70797", "text": "{\n    \"event_name\": \"International Conference on Machine Learning 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Hiroshi Tanaka\",\n            \"affiliation\": \"Association for Machine Learning\"\n        }\n    ],\n    \"event_date\": \"2024-07-22\",\n    \"venue\": \"Vancouver Convention Center, Vancouver, BC\",\n    \"agenda\": \"Focuses on all aspects of machine learning including deep learning, reinforcement learning, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Grace Lee\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Dr. Jack Miller\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon Web Services\",\n        \"Microsoft\",\n        \"Facebook AI Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Kevin Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.icml.cc/register\",\n    \"registration_fee\": 650\n}"}
{"_id": "Academic--scholarly_events--p--70798", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Keynotes on Deep Learning, Reinforcement Learning, Natural Language Processing, and Computer Vision. Workshops on Ethical AI and AI safety.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NSF\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://icaiml.org/register\"\n}"}
