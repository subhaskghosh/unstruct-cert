{"_id": "Academic--scholarly_events--n--71572", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"MIT Artificial Intelligence Laboratory\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"MIT Media Lab, Cambridge, MA\",\n    \"agenda\": \"Advanced discussions on mathematical logic, complexity theory, and the philosophical implications of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Charles Lee\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Dr. Sophia Rodriguez\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor David Chen\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aitheory2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71573", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Institute for Responsible AI\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Online (Virtual)\",\n    \"agenda\": \"Keynotes on AI bias, fairness, accountability, and transparency. Workshops on implementing ethical AI frameworks. Panel discussions on societal impact.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\",\n        \"Element AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"The Future of AI Governance\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71573", "text": "{\n    \"event_name\": \"Advanced Robotics and AI Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Robotics Innovation Lab\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Boston Convention Center, Boston, MA\",\n    \"agenda\": \"Presentations on cutting-edge robotics, AI-powered automation, and machine learning applications in manufacturing. Demonstrations of new robotic platforms.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Motors\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"sponsors\": [\n        \"Intel\",\n        \"NVIDIA\",\n        \"Boston Dynamics\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Hiroshi Tanaka\",\n            \"affiliation\": \"Tokyo Institute of Technology\",\n            \"topic\": \"Human-Robot Collaboration\"\n        }\n    ],\n    \"registration_link\": \"https://www.roboticsaisymposium.com/register\"\n}"}
