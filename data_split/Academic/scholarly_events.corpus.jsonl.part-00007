{"_id": "Academic--scholarly_events--p--71409", "text": "{\n    \"event_name\": \"International Conference on Deep Learning and Artificial Intelligence (ICDLAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Key topics include: convolutional neural networks, recurrent neural networks, generative adversarial networks, reinforcement learning, and applications of deep learning in computer vision, natural language processing, and robotics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        },\n        {\n            \"name\": \"Many more...\",\n            \"affiliation\": \"Various\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.icdlai.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71409", "text": "{\n    \"event_name\": \"Workshop on Statistical Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"Statistics Department\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Berkeley, CA\",\n    \"agenda\": \"The workshop will cover foundational concepts in statistical machine learning, including linear regression, logistic regression, support vector machines, and decision trees.\",\n    \"attendees\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Blei\",\n            \"affiliation\": \"Columbia University\"\n        },\n        {\n            \"name\": \"Bernhard Schölkopf\",\n            \"affiliation\": \"Max Planck Institute\"\n        },\n        {\n            \"name\": \"20 other attendees\",\n            \"affiliation\": \"Various\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.statmlworkshop.org/register\"\n}"}
