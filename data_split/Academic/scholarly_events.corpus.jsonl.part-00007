{"_id": "Academic--scholarly_events--p--71565", "text": "{\n    \"event_name\": \"NeurIPS 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Neural Information Processing Systems Foundation\",\n            \"affiliation\": \"Non-profit organization\"\n        }\n    ],\n    \"event_date\": \"2024-12-08\",\n    \"venue\": \"Vancouver Convention Centre, Vancouver, BC, Canada\",\n    \"agenda\": \"Cutting-edge research in all areas of machine learning and artificial intelligence, including deep learning, reinforcement learning, computer vision, and natural language processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://neurips.cc/Conferences/2024/Registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71565", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Frontiers\",\n            \"affiliation\": \"Conference Organizers Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"A broad overview of AI applications and research. Includes workshops and talks on various AI topics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Intel\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/\"\n}"}
{"_id": "Academic--scholarly_events--p--71566", "text": "{\n    \"event_name\": \"AI Ethics and Governance Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Klaus Mueller\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Berlin Congress Center, Germany\",\n    \"agenda\": \"Key topics include algorithmic bias, fairness in AI, responsible AI development, and AI policy.  Workshops and presentations from leading academics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"University of Oxford\",\n        \"Max Planck Society\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Kate Crawford\",\n            \"affiliation\": \"University of Southern California\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiegs.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71566", "text": "{\n    \"event_name\": \"AI in Business Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Tech Events Ltd.\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"London Excel Centre, UK\",\n    \"agenda\": \"Focuses on practical applications of AI in various industries, including marketing, finance, and healthcare.  Case studies and vendor presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Marketing Director, Acme Corp\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Data Scientist, Beta Inc\",\n            \"affiliation\": \"Beta Inc\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Microsoft\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Industry Leader, AI Solutions\",\n            \"affiliation\": \"AI Solutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://www.aibusinessconf.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71567", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        },\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Advanced Deep Learning Techniques, Generative AI, Reinforcement Learning, AI Ethics and Governance, Responsible AI Development.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71567", "text": "{\n    \"event_name\": \"Introduction to AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Local Tech Meetup Group\",\n            \"affiliation\": \"Meetup.com\"\n        }\n    ],\n    \"event_date\": \"2024-10-27\",\n    \"venue\": \"Austin, TX\",\n    \"agenda\": \"What is AI?, Machine Learning Basics, Simple Neural Networks, AI Applications in Everyday Life.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"University of Texas\"\n        },\n        {\n            \"name\": \"Mark Williams\",\n            \"affiliation\": \"Independent Learner\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Company\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Local University\"\n        }\n    ],\n    \"registration_link\": \"https://www.localtechgroup.com/workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71568", "text": "{\n    \"event_name\": \"European AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Conference Solutions Ltd.\",\n            \"affiliation\": \"Private Event Management Company\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Berlin Congress Center, Germany\",\n    \"agenda\": \"The summit will cover the latest advancements in Generative AI, Reinforcement Learning, and Explainable AI. Discussions will include novel architectures, ethical considerations, and real-world applications of AI technologies. Advanced research papers and industry presentations will be featured.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Research Scientist, DeepMind\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Professor, Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.europeanai.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71568", "text": "{\n    \"event_name\": \"AI in Education Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Emily Johnson\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Oxford University, UK\",\n    \"agenda\": \"The workshop will explore the application of AI in educational settings. Topics include personalized learning, automated assessment, and intelligent tutoring systems. It will focus on practical implementations and pedagogical considerations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Educational Technologist, Cambridge University\"\n        },\n        {\n            \"name\": \"Sarah Brown\",\n            \"affiliation\": \"Teacher, London School\"\n        }\n    ],\n    \"sponsors\": [\n        \"Department for Education (UK)\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Rose Luckin\",\n            \"affiliation\": \"UCL Knowledge Lab\"\n        }\n    ],\n    \"registration_link\": \"https://www.oxfordai.edu/workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71569", "text": "{\n    \"event_name\": \"International Conference on Applied Machine Learning (ICAML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Workshops on deep learning, reinforcement learning, and computer vision.  Paper presentations on the latest advancements in machine learning algorithms and their applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://icaml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71569", "text": "{\n    \"event_name\": \"Symposium on Foundations of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Cambridge, MA\",\n    \"agenda\": \"Discussions on logical reasoning, knowledge representation, and automated theorem proving.  Focus on theoretical properties of AI systems.\",\n    \"attendees\": [\n        {\n            \"name\": \"Grace Wilson\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Henry Martin\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Defense Advanced Research Projects Agency (DARPA)\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://fsai.org/register\"\n}"}
