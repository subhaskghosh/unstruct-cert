{"_id": "Academic--scholarly_events--p--71854", "text": "{\n    \"event_name\": \"International Conference on Practical Applications of Machine Learning (ICPAML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"The conference will cover topics such as computer vision, natural language processing, reinforcement learning, and applications in healthcare and finance. It includes workshops, tutorials, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://icpaml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71854", "text": "{\n    \"event_name\": \"European Symposium on Theoretical Computer Science (ESTCS)\",\n    \"organizers\": [\n        {\n            \"name\": \"Prof. Klaus Schmidt\",\n            \"affiliation\": \"RWTH Aachen University\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"The symposium will delve into the mathematical foundations of computation, including complexity theory, automata theory, and formal languages.  The focus is on rigorous proofs and abstract models.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of Cambridge, PhD Candidate\"\n        },\n        {\n            \"name\": \"Eva Green\",\n            \"affiliation\": \"Imperial College London, PhD Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Manuela Schmidt\",\n            \"affiliation\": \"University of Heidelberg\"\n        }\n    ],\n    \"registration_link\": \"https://estcs.org/register\"\n}"}
