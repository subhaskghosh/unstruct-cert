{"_id": "Academic--scholarly_events--n--70338", "text": "{\n    \"event_name\": \"AI Workshop for Beginners\",\n    \"organizers\": [\n        {\n            \"name\": \"City College\",\n            \"affiliation\": \"Continuing Education Department\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"City College Auditorium\",\n    \"agenda\": \"Introduction to AI concepts, hands-on coding exercises using Python.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Local High School Student\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Independent Learner\"\n        }\n    ],\n    \"sponsors\": [\n        \"City College Alumni Association\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"City College\",\n            \"topic\": \"Introduction to Machine Learning\"\n        }\n    ],\n    \"registration_link\": \"https://citycollege.edu/ai-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--70339", "text": "{\n    \"event_name\": \"International Conference on AI and Collaborative Systems\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston, MA\",\n    \"agenda\": \"Key topics include machine learning, deep learning, natural language processing, and collaborative AI development. Workshops focused on open-source AI tools.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"NSF\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--70339", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"TechSolutions Inc.\",\n            \"affiliation\": \"Private Sector Consulting\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"New York, NY\",\n    \"agenda\": \"Focuses on the application of AI in marketing, sales, and finance. Case studies on successful AI implementations in Fortune 500 companies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Diana Lee\",\n            \"affiliation\": \"Salesforce\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-business-summit\"\n}"}
