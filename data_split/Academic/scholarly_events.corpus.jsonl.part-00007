{"_id": "Academic--scholarly_events--p--70786", "text": "{\n    \"event_name\": \"AI Ethics and Governance Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Massachusetts Institute of Technology, Cambridge, MA\",\n    \"agenda\": \"Day 1: Introduction to AI Ethics, Bias in Algorithms. Day 2: Fairness and Accountability, Privacy Concerns. Day 3: Responsible AI Development, Future of AI Governance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"DeepMind\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
