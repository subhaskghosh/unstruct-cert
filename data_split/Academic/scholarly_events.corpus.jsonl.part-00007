{"_id": "Academic--scholarly_events--p--71301", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAAI\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Keynotes on recent AI advancements, workshops on deep learning frameworks, and industry panels discussing practical AI applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Amazon Web Services\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71301", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Foundations of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Society for Logic and Computation\",\n            \"affiliation\": \"SLC\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"New York, NY\",\n    \"agenda\": \"Presentations on formal methods, computational complexity, and logical reasoning in AI. Focus is heavily on mathematical proofs and theoretical models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Noam Chomsky\",\n            \"affiliation\": \"University of Pennsylvania\"\n        }\n    ],\n    \"registration_link\": \"https://www.symposium-tfa.org/register\",\n    \"registration_fee\": 650\n}"}
