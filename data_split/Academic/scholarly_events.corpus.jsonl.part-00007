{"_id": "Academic--scholarly_events--p--70609", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"UC Berkeley AI Research\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference features groundbreaking research in deep learning, reinforcement learning, and generative AI, including workshops on the latest advancements and ethical considerations. Topics include novel neural network architectures, explainable AI, and applications in healthcare and robotics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Amazon AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70609", "text": "{\n    \"event_name\": \"International Conference on Data Mining 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Data Mining\",\n            \"affiliation\": \"Professional Association\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"Hilton Hotel, Chicago, IL\",\n    \"agenda\": \"The conference covers a broad range of data mining techniques, including clustering, classification, and association rule mining. It features presentations on real-world applications in marketing and finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"XYZ Corp\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Data Analytics Inc.\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Microsoft\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.dataminingconference.org/register\"\n}"}
