{"_id": "Academic--scholarly_events--p--71771", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence Frontiers (ICAIF)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"AI Research Institute\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Cutting-edge research in deep learning, natural language processing, computer vision, and robotics. Panel discussions on ethical AI and future trends.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Ethan Fisher\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Grace Lee\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Professor Henry Moore\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaif.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71771", "text": "{\n    \"event_name\": \"AI for Beginners Bootcamp\",\n    \"organizers\": [\n        {\n            \"name\": \"Sarah Miller\",\n            \"affiliation\": \"DataCamp\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Online\",\n    \"agenda\": \"Introduction to Python, basic machine learning algorithms, and data visualization techniques. Designed for individuals with no prior AI experience.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Career Changer\"\n        }\n    ],\n    \"sponsors\": [\n        \"DataCamp\",\n        \"Udemy\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"DataCamp Instructor\"\n        }\n    ],\n    \"registration_link\": \"https://www.datacamp.com/bootcamp\"\n}"}
{"_id": "Academic--scholarly_events--p--71772", "text": "{\n    \"event_name\": \"AI in Business: From Theory to Practice\",\n    \"organizers\": [\n        {\n            \"name\": \"Data Science Institute\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Workshops on machine learning applications, case studies of AI implementation, networking sessions with industry leaders.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiinbusiness\"\n}"}
