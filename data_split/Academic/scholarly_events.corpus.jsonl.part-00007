{"_id": "Academic--scholarly_events--p--71102", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence (ICAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Silicon Valley, CA\",\n    \"agenda\": \"<ul><li>Keynote: The Future of AI</li><li>Session 1: Deep Learning Advances</li><li>Session 2: Natural Language Processing</li><li>Session 3: Computer Vision Applications</li><li>Session 4: Reinforcement Learning</li><li>Workshop: AI Ethics and Bias</li><li>Poster Session</li></ul>\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.icai-conference.org/register\"\n}"}
