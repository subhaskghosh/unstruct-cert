{"_id": "Academic--scholarly_events--p--70317", "text": "{\n    \"event_name\": \"National AI & Society Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"National Science Foundation\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT Media Lab\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Washington D.C.\",\n    \"agenda\": \"Discussions on AI ethics, policy, and societal impact. Workshops on responsible AI development and deployment. Panel discussions on the future of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Department of Energy\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Evelyn Reed\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-registration\"\n}"}
