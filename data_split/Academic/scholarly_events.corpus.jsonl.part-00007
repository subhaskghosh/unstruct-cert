{"_id": "Academic--scholarly_events--p--70713", "text": "{\n    \"event_name\": \"International Conference on Advanced AI Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center\",\n    \"agenda\": \"This conference will cover the latest advancements in Artificial Intelligence, Machine Learning, Deep Learning, and Neural Networks. Topics include generative models, explainable AI, and AI ethics. A specific session is dedicated to recent breakthroughs in large language models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Amazon Web Services\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-conference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70713", "text": "{\n    \"event_name\": \"Workshop on Data Science and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Seattle Convention Center\",\n    \"agenda\": \"This workshop focuses on practical applications of data science and machine learning in various industries. It includes sessions on data visualization, statistical modeling, and introductory machine learning algorithms. Artificial Intelligence concepts will be briefly touched upon.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Data Insights Inc.\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"IBM\",\n        \"Tableau\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. John Davis\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"registration_link\": \"https://www.data-science-workshop.com\"\n}"}
