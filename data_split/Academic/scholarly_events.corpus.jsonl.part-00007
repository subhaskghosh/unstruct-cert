{"_id": "Academic--scholarly_events--p--70928", "text": "{\n    \"event_name\": \"International Conference on AI & Machine Learning - ICML 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"UC Berkeley\",\n            \"affiliation\": \"AI Research Lab\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Moscone Center, San Francisco, CA\",\n    \"agenda\": \"Keynotes on deep learning, workshops on NLP, and poster sessions on computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Dan Garcia\",\n            \"affiliation\": \"Georgia Tech\"\n        },\n        {\n            \"name\": \"Eve Hernandez\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Frank Ito\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Grace Kim\",\n            \"affiliation\": \"Cornell University\"\n        },\n        {\n            \"name\": \"Harry Lin\",\n            \"affiliation\": \"University of Illinois\"\n        },\n        {\n            \"name\": \"Ivy Nguyen\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Jack Olsen\",\n            \"affiliation\": \"University of Texas\"\n        },\n        {\n            \"name\": \"Kelly Park\",\n            \"affiliation\": \"University of Pennsylvania\"\n        },\n        {\n            \"name\": \"Liam Rodriguez\",\n            \"affiliation\": \"Columbia University\"\n        },\n        {\n            \"name\": \"Mia Sanchez\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Noah Thompson\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Olivia Vargas\",\n            \"affiliation\": \"Johns Hopkins University\"\n        },\n        {\n            \"name\": \"Peter Wilson\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.icml2024.org/register\"\n}"}
