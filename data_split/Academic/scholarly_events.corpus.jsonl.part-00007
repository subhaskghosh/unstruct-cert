{"_id": "Academic--scholarly_events--p--71378", "text": "{\n    \"event_name\": \"AI Frontiers for Young Researchers Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Institute for Advanced AI Studies\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Tutorials on deep learning, reinforcement learning, and generative models. Hands-on workshops on implementing AI solutions. Poster session for early career researchers.\",\n    \"attendees\": [\n        {\n            \"name\": \"Chloe Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI Research Grants\",\n        \"Allen Institute for AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Evelyn Hayes\",\n            \"affiliation\": \"DeepMind\",\n            \"topic\": \"The Future of Explainable AI\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiersworkshop.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71378", "text": "{\n    \"event_name\": \"Global AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Global Tech Events Inc.\",\n            \"affiliation\": \"Corporate Event Planner\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York City, NY\",\n    \"agenda\": \"Keynote speeches from industry leaders, panel discussions on AI trends, and networking opportunities.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Sundar Pichai\",\n            \"affiliation\": \"Google\",\n            \"topic\": \"AI-Powered Innovation\"\n        }\n    ],\n    \"registration_link\": \"https://globalsummit.ai/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71379", "text": "{\n    \"event_name\": \"International Conference on Advanced Machine Learning (ICAML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include Deep Learning, Reinforcement Learning, Generative Models, and Explainable AI. Workshops on practical applications of Machine Learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://icaml.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71379", "text": "{\n    \"event_name\": \"Workshop on Traditional Statistical Modeling\",\n    \"organizers\": [\n        {\n            \"name\": \"State University\",\n            \"affiliation\": \"Department of Statistics\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"State University Conference Center, Anytown, USA\",\n    \"agenda\": \"Covers classical statistical methods, regression analysis, and hypothesis testing. Focuses on established techniques.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Local Research Institute\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"State Government Agency\"\n        }\n    ],\n    \"sponsors\": [\n        \"State Statistical Society\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Emily Green\",\n            \"affiliation\": \"State University\"\n        }\n    ],\n    \"registration_link\": \"https://statworkshop.stateu.edu\"\n}"}
{"_id": "Academic--scholarly_events--p--71380", "text": "{\n    \"event_name\": \"European Conference on Explainable AI (ECEAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Key topics include: XAI methods, fairness and transparency, applications in healthcare and finance, and ethical considerations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Cynthia Rudin\",\n            \"affiliation\": \"Duke University\"\n        },\n        {\n            \"name\": \"Prof. Rich Sutton\",\n            \"affiliation\": \"University of Alberta\"\n        }\n    ],\n    \"registration_link\": \"https://eceai.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71380", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Mark Thompson\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-02-22\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Focuses on the practical implementation of AI in various business sectors. Case studies and workshops on machine learning for marketing, sales, and customer service.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Lee\",\n            \"affiliation\": \"Amazon\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"Deloitte\",\n        \"Accenture\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"TechCorp\"\n        }\n    ],\n    \"registration_link\": \"https://aibusinesseurope.com\"\n}"}
{"_id": "Academic--scholarly_events--p--71381", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"MIT CSAIL\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Cutting-edge research in Machine Learning, Deep Learning, Computer Vision, and Natural Language Processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Dr. Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        },\n        {\n            \"name\": \"Dr. Daphne Koller\",\n            \"affiliation\": \"insitro\"\n        },\n        {\n            \"name\": \"Dr. Juergen Schmidhuber\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71381", "text": "{\n    \"event_name\": \"European AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Institute\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"Exploration of current trends and future directions in Artificial Intelligence research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Stuart Russell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Michael Wooldridge\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"registration_link\": \"https://www.europeanai.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71382", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Innovation Labs\",\n            \"affiliation\": \"TechForward Institute\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Day 1: Generative AI Applications in Healthcare & Finance. Day 2: Advancements in Large Language Models. Day 3: Responsible AI and Ethical Considerations. Workshops on deploying AI solutions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71382", "text": "{\n    \"event_name\": \"Foundations of Artificial Intelligence Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"Berkeley, CA\",\n    \"agenda\": \"Mathematical logic underlying AI, probabilistic graphical models, formal methods for AI verification, computational complexity.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley PhD Student\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"MIT Postdoc\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://ai-foundations.berkeley.edu\"\n}"}
{"_id": "Academic--scholarly_events--p--71383", "text": "{\n    \"event_name\": \"International Conference on Practical Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"UC Berkeley\",\n            \"affiliation\": \"AI Research Lab\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Topics include deep learning applications, reinforcement learning, and machine learning in healthcare and finance. Workshops on model deployment and scalability.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/icpml\"\n}"}
{"_id": "Academic--scholarly_events--n--71383", "text": "{\n    \"event_name\": \"Theoretical Foundations of Machine Learning Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"Department of Electrical Engineering and Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-02-28\",\n    \"venue\": \"Cambridge, MA\",\n    \"agenda\": \"Focused on the mathematical and statistical underpinnings of machine learning algorithms. Topics include convexity, optimization, and statistical learning theory.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/tfml\"\n}"}
{"_id": "Academic--scholarly_events--p--71384", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford Center for AI Ethics\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Keynotes on AI bias, fairness, accountability, and transparency. Panel discussions on the societal impact of AI. Workshops on implementing ethical AI frameworks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Kate Crawford\",\n            \"affiliation\": \"USC Annenberg\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71384", "text": "{\n    \"event_name\": \"Introduction to Machine Learning Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Data Science Bootcamp\",\n            \"affiliation\": \"Private Institute\"\n        }\n    ],\n    \"event_date\": \"2024-10-27\",\n    \"venue\": \"Los Angeles, CA\",\n    \"agenda\": \"Basic concepts of machine learning, supervised and unsupervised learning algorithms, hands-on coding exercises in Python.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Data Analyst\"\n        }\n    ],\n    \"sponsors\": [\n        \"Data Science Bootcamp\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [],\n    \"registration_link\": \"https://datasciencebootcamp.com/workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71385", "text": "{\n    \"event_name\": \"International Conference on AI and Society\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Oxford Internet Institute\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"This conference will explore the ethical and societal implications of artificial intelligence, with key topics including AI bias, fairness, accountability, and transparency. Sessions will cover responsible innovation, AI governance, and the future of work in the age of AI. Panel discussions and workshops will encourage collaboration between researchers, policymakers, and industry leaders.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Nick Bostrom\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Timnit Gebru\",\n            \"affiliation\": \"Distributed AI Research Institute\"\n        },\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aisocietyconf.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71385", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"TechSolutions Inc.\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"New York City, NY\",\n    \"agenda\": \"This summit focuses on the practical applications of AI in business, covering topics such as machine learning for marketing, AI-powered customer service, and data analytics for decision-making. Case studies and demonstrations will highlight successful AI implementations across various industries.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"ABC Corp\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"XYZ Ltd.\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiinbusinesssummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71386", "text": "{\n    \"event_name\": \"AI & Practical Applications Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT Computer Science Department\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"New York City, NY, USA\",\n    \"agenda\": \"Topics include deep learning, computer vision, natural language processing, and AI ethics with a focus on real-world implementations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"expertise\": \"Machine Learning\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-conference-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71386", "text": "{\n    \"event_name\": \"AI Frontiers Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-08-20\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Cutting-edge research in AI, including theoretical foundations and emerging trends.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Facebook AI Research\"\n        },\n        {\n            \"name\": \"Dan Martinez\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Meta\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"Mila\",\n            \"expertise\": \"Deep Learning\"\n        }\n    ],\n    \"registration_link\": \"https://ai-frontiers.org\"\n}"}
{"_id": "Academic--scholarly_events--p--71387", "text": "{\n    \"event_name\": \"AI Ethics & Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Oxford Internet Institute\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include algorithmic bias, AI governance, responsible innovation, and the societal impact of AI. Workshops on practical ethical frameworks.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Kate Crawford\",\n            \"affiliation\": \"USC Annenberg\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Timnit Gebru\",\n            \"affiliation\": \"Distributed AI Research Institute\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconference.stanford.edu/register\",\n    \"registration_fee\": 450\n}"}
