{"_id": "Academic--scholarly_events--p--71173", "text": "{\n    \"event_name\": \"International Conference on AI Ethics and Governance\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center\",\n    \"agenda\": \"Key topics include bias in AI, responsible AI development, and AI policy. Workshops and panel discussions will be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
