{"_id": "Academic--scholarly_events--p--71192", "text": "{\n    \"event_name\": \"International Conference on Machine Learning and Data Science (ICMLDS)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Tracks include deep learning, reinforcement learning, natural language processing, and data mining. Workshops and tutorials will be provided.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI\",\n        \"IEEE\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://icml-ds.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71192", "text": "{\n    \"event_name\": \"AI in Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Event Horizon Inc.\",\n            \"affiliation\": \"Corporate Event Planner\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"New York, NY\",\n    \"agenda\": \"Focuses on practical applications of AI in marketing, sales, and finance. Case studies and vendor presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"registration_link\": \"https://ai-business-summit.com\"\n}"}
