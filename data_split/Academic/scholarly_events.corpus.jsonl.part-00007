{"_id": "Academic--scholarly_events--p--70256", "text": "{\n    \"event_name\": \"International Conference on Advanced AI Technologies\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center\",\n    \"agenda\": \"This conference explores the latest advancements in Artificial Intelligence, including Machine Learning, Deep Learning, Natural Language Processing, and Computer Vision.  Focus areas include autonomous systems and robotics. No specific medical applications will be covered.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-conference-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--70256", "text": "{\n    \"event_name\": \"AI in Healthcare Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Harvard Medical School\",\n            \"affiliation\": \"Department of Biomedical Informatics\"\n        },\n        {\n            \"name\": \"Massachusetts General Hospital\",\n            \"affiliation\": \"Research Department\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Harvard Medical School Campus\",\n    \"agenda\": \"This symposium focuses on the application of Artificial Intelligence and Machine Learning in healthcare, covering areas like disease diagnosis, personalized medicine, and drug discovery. Topics include AI-powered imaging, predictive analytics for patient outcomes, and robotic surgery.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Johns Hopkins Hospital\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"sponsors\": [\n        \"Pfizer\",\n        \"Johnson & Johnson\",\n        \"Roche\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Eric Topol\",\n            \"affiliation\": \"Scripps Research\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-healthcare-2024\"\n}"}
