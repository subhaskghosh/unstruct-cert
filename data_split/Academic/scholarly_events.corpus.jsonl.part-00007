{"_id": "Academic--scholarly_events--p--70112", "text": "{\n    \"event_name\": \"AI Ethics and Societal Impact Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University - Center for AI Safety\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Discussions on bias in AI, algorithmic fairness, responsible AI development, and the future of work.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"OpenAI\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Timnit Gebru\",\n            \"affiliation\": \"Distributed AI Research Institute (DAIR)\",\n            \"topic\": \"The Ethical Implications of Large Language Models\"\n        },\n        {\n            \"name\": \"Dr. Kate Crawford\",\n            \"affiliation\": \"USC Annenberg\",\n            \"topic\": \"Atlas of AI: Power, Politics, and the Planetary Costs of Artificial Intelligence\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiethicsconference\"\n}"}
