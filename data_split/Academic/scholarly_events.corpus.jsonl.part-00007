{"_id": "Academic--scholarly_events--n--70950", "text": "{\n    \"event_name\": \"Workshop on Emerging Trends in Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Sarah Green\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Seattle Convention Center\",\n    \"agenda\": \"Focuses on data visualization, statistical modeling, and ethical considerations in data science.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Local Analytics Company\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"SAS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/data-science-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--70951", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"UC Berkeley\",\n            \"affiliation\": \"AI Research Lab\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Moscone Center, San Francisco\",\n    \"agenda\": \"Keynote speeches, workshops on deep learning, natural language processing, and computer vision. Poster sessions showcasing recent research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Meta AI\"\n        },\n        {\n            \"name\": \"Eve Garcia\",\n            \"affiliation\": \"Amazon AI\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Grace Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Henry Rodriguez\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Ivy Wilson\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Jack Moore\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Kelly Taylor\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Liam Anderson\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"Meta\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--70951", "text": "{\n    \"event_name\": \"Workshop on Bioethics and AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Hastings Center\",\n            \"affiliation\": \"Bioethics Research Institute\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"New York Academy of Medicine\",\n    \"agenda\": \"Discussion panels on the ethical implications of AI in healthcare. Case studies and debates on algorithmic bias.\",\n    \"attendees\": [\n        {\n            \"name\": \"Anna Smith\",\n            \"affiliation\": \"Johns Hopkins University\"\n        },\n        {\n            \"name\": \"Peter Jones\",\n            \"affiliation\": \"Yale University\"\n        },\n        {\n            \"name\": \"Susan Brown\",\n            \"affiliation\": \"Columbia University\"\n        },\n        {\n            \"name\": \"Michael Green\",\n            \"affiliation\": \"Harvard Law School\"\n        },\n        {\n            \"name\": \"Linda White\",\n            \"affiliation\": \"University of Pennsylvania\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Robert Wood Johnson Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Françoise Baylis\",\n            \"affiliation\": \"Dalhousie University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/bioethics-ai-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--70952", "text": "{\n    \"event_name\": \"International Conference on Advanced AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include Generative AI, Reinforcement Learning, Deep Learning Architectures, Ethical AI, and the Future of AI in Healthcare and Finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-conference.org/register\"\n}"}
