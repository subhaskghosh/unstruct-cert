{"_id": "Academic--scholarly_events--p--70403", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford, UK\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University, France\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Paris Convention Centre, France\",\n    \"agenda\": \"Keynote speeches on deep learning, reinforcement learning, and computer vision. Workshops on practical applications of AI in healthcare and finance. Poster sessions showcasing the latest research.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-conference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70403", "text": "{\n    \"event_name\": \"Historical Linguistics Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Professor Thomas Müller\",\n            \"affiliation\": \"Heidelberg University, Germany\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Heidelberg, Germany\",\n    \"agenda\": \"Presentations on the evolution of language families, comparative philology, and historical lexicography. Discussions on the reconstruction of Proto-Indo-European.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Max Planck Society\",\n        \"Volkswagen Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Peter Trask\",\n            \"affiliation\": \"University of Sussex\"\n        }\n    ],\n    \"registration_link\": \"https://www.histolinguistics.de/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70404", "text": "{\n    \"event_name\": \"International Conference on Advanced AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"This conference will cover cutting-edge research in artificial intelligence, machine learning, deep learning, and neural networks. Topics include generative models, reinforcement learning, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70404", "text": "{\n    \"event_name\": \"Workshop on Data Science Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"City College of New York\",\n            \"affiliation\": \"Department of Statistics\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"City College of New York, New York, NY\",\n    \"agenda\": \"This workshop focuses on the practical application of data science techniques in various fields, including marketing and finance.  We will cover data visualization, basic statistical modeling, and data cleaning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"JPMorgan Chase\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Bloomberg\"\n        }\n    ],\n    \"sponsors\": [\n        \"Bloomberg\",\n        \"JPMorgan Chase\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Green\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://datascience-workshop.ccny.edu/register\",\n    \"registration_fee\": 600\n}"}
{"_id": "Academic--scholarly_events--p--70405", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"This conference delves into the latest advancements in deep learning, reinforcement learning, and generative models, featuring presentations on novel architectures and applications. We will explore topics such as transformers, diffusion models, and the ethical implications of AI.  Expect to see research pushing the boundaries of what’s possible.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--70405", "text": "{\n    \"event_name\": \"European Symposium on Artificial Intelligence 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for Artificial Intelligence\",\n            \"affiliation\": \"EurAI\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"This symposium will cover a broad range of AI topics, including knowledge representation, reasoning, and machine learning.  Presentations will focus on established methodologies and practical applications in various domains.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor Alan Turing\",\n            \"affiliation\": \"University of Manchester\"\n        },\n        {\n            \"name\": \"Barbara Liskov\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Siemens\",\n        \"SAP\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://www.esiai2024.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70406", "text": "{\n    \"event_name\": \"AI Ethics & Governance Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for AI Law and Ethics\",\n            \"affiliation\": \"University of Amsterdam\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Discussions on bias in AI, data privacy, algorithmic accountability, and the future of AI regulation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Commission\",\n        \"German Federal Ministry of Education and Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Evelyn Reed\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"The Social Impact of AI\"\n        },\n        {\n            \"name\": \"Prof. David Chen\",\n            \"affiliation\": \"Carnegie Mellon University\",\n            \"topic\": \"AI and Legal Frameworks\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiethics2024\"\n}"}
