{"_id": "Academic--scholarly_events--p--70380", "text": "{\n    \"event_name\": \"Applied AI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"AI Research Institute\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Tech Events Ltd.\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Discussions on practical applications of AI in various industries, workshops on machine learning tools, and presentations on real-world case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Data Solutions Inc.\"\n        },\n        {\n            \"name\": \"Robert Lee\",\n            \"affiliation\": \"TechCorp\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"Google AI\",\n            \"topic\": \"The Future of AI in Healthcare\"\n        },\n        {\n            \"name\": \"David Rodriguez\",\n            \"affiliation\": \"Microsoft Research\",\n            \"topic\": \"Responsible AI Development\"\n        }\n    ],\n    \"registration_link\": \"https://appliedaisummit.com/register\"\n}"}
