{"_id": "Academic--scholarly_events--p--71131", "text": "{\n    \"event_name\": \"International Conference on AI Ethics and Innovation\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include fairness, accountability, transparency in AI, AI safety, and responsible innovation. Workshops will focus on practical applications of ethical AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"title\": \"The Future of Human-Centered AI\"\n        }\n    ],\n    \"registration_link\": \"https://aiethicsconf.stanford.edu/register\"\n}"}
