{"_id": "Academic--scholarly_events--n--71414", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"International Association for Symbolic Logic\",\n            \"affiliation\": \"IASL\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"A workshop dedicated to the foundational mathematical and logical principles underlying artificial intelligence. Topics include formal verification, computational complexity, and knowledge representation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"German Research Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John McCarthy (Posthumous)\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alan Turing (Posthumous)\",\n            \"affiliation\": \"University of Manchester\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-theory-workshop\"\n}"}
