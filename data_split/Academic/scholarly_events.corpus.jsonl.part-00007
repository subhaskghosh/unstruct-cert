{"_id": "Academic--scholarly_events--n--70327", "text": "{\n    \"event_name\": \"AI in Healthcare Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Mayo Clinic Research\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Harvard Medical School\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Boston, MA\",\n    \"agenda\": \"Dedicated to the application of Artificial Intelligence in medical diagnosis, treatment planning, and drug discovery.  Focus on AI-powered medical imaging, genomics, and personalized medicine.  Heavy focus on Artificial Intelligence.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Johns Hopkins Medicine\"\n        }\n    ],\n    \"sponsors\": [\n        \"Johnson & Johnson\",\n        \"Pfizer\",\n        \"IBM Watson Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Eric Topol\",\n            \"affiliation\": \"Scripps Research\"\n        }\n    ],\n    \"registration_link\": \"https://aihealthcare.com/register2024\"\n}"}
