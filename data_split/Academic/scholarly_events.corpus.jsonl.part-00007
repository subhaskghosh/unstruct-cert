{"_id": "Academic--scholarly_events--p--70930", "text": "{\n    \"event_name\": \"European AI & Society Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for AI\",\n            \"affiliation\": \"EAAI\"\n        },\n        {\n            \"name\": \"University of Amsterdam\",\n            \"affiliation\": \"UvA\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Amsterdam, Netherlands\",\n    \"agenda\": \"Key topics include the societal impact of AI, ethical considerations, AI policy, and future trends. Panel discussions and workshops will focus on collaborative problem-solving.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Commission\",\n        \"Netherlands Ministry of Education, Culture and Science\",\n        \"Google AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Evelyn Reed\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"The Future of AI Ethics\"\n        },\n        {\n            \"name\": \"Professor Jian Li\",\n            \"affiliation\": \"Tsinghua University\",\n            \"topic\": \"AI and Global Governance\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-2024\"\n}"}
