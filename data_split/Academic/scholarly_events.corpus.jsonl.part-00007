{"_id": "Academic--scholarly_events--n--71071", "text": "{\n    \"event_name\": \"AI Ethics and Society Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Center for AI and Humanity\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford, CA, USA\",\n    \"agenda\": \"Discussions on bias in AI, fairness, accountability, transparency, and the societal impact of artificial intelligence.  Case studies on responsible AI deployment.\",\n    \"attendees\": [\n        {\n            \"name\": \"Kate Crawford\",\n            \"affiliation\": \"USC Annenberg\"\n        },\n        {\n            \"name\": \"Timnit Gebru\",\n            \"affiliation\": \"Distributed AI Research Institute\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"Partnership on AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Shoshana Zuboff\",\n            \"affiliation\": \"Harvard Business School\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicssummit.org\"\n}"}
{"_id": "Academic--scholarly_events--p--71072", "text": "{\n    \"event_name\": \"AI & Ethics in Practice Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Center for Responsible AI\",\n            \"affiliation\": \"Non-profit Organization\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"New York City, NY, USA\",\n    \"agenda\": \"Keynote speeches on AI bias, workshops on ethical AI development, panel discussions on responsible AI implementation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/aiethicsconference\"\n}"}
