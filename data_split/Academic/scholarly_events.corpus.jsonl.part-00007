{"_id": "Academic--scholarly_events--p--70954", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Keynote speeches on the latest advancements in AI, workshops on machine learning, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Alfred P. Sloan Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"The Future of AI\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"topic\": \"Deep Learning and its Applications\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70954", "text": "{\n    \"event_name\": \"InnovateAI Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"TechForward Inc.\",\n            \"affiliation\": \"AI Solutions Provider\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"San Francisco Convention Center, San Francisco, CA\",\n    \"agenda\": \"Presentations on AI tools and applications for business, networking events, and product demos.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Salesforce\"\n        },\n        {\n            \"name\": \"Diana Rodriguez\",\n            \"affiliation\": \"Google\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Amazon\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\",\n            \"topic\": \"AI in Business\"\n        }\n    ],\n    \"registration_link\": \"https://innovateai.techforward.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70955", "text": "{\n    \"event_name\": \"AI for Business Innovation Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying AI in marketing, finance, and operations. Case studies and practical exercises. Focus on LLMs, computer vision and predictive analytics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"sponsors\": [\n        \"Nvidia\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiworkshop.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70955", "text": "{\n    \"event_name\": \"Foundational Aspects of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Oxford University, Oxford, UK\",\n    \"agenda\": \"A deep dive into the philosophical and mathematical underpinnings of AGI. Exploration of formal logic, game theory, and computational complexity. Discussions on consciousness and ethical implications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alan Turing Jr.\",\n            \"affiliation\": \"Cambridge University\"\n        },\n        {\n            \"name\": \"Professor Ada Lovelace\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"DeepMind\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://agi.oxford.edu/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--70956", "text": "{\n    \"event_name\": \"AI Ethics and Governance Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for AI\",\n            \"affiliation\": \"EAAI\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Key topics include fairness, accountability, transparency, and the societal impact of AI. Workshops on AI regulations and responsible innovation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Isabelle Dubois\",\n            \"affiliation\": \"Sorbonne University\",\n            \"title\": \"The Future of Ethical AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aievent.org/register\"\n}"}
