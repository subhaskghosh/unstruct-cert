{"_id": "Academic--scholarly_events--p--70515", "text": "{\n    \"event_name\": \"European AI & Machine Learning Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"ETH Zurich\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Geneva International Conference Centre, Switzerland\",\n    \"agenda\": \"Key topics include: Deep Learning architectures, Reinforcement Learning, Computer Vision, Natural Language Processing, and applications in robotics. Workshops on TensorFlow and PyTorch will be offered.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"NVIDIA\",\n        \"IBM Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-symposium-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--70515", "text": "{\n    \"event_name\": \"AI Ethics and Societal Impact Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Ingrid Volkov\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Lars Christensen\",\n            \"affiliation\": \"Copenhagen University\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Oslo Conference Center, Norway\",\n    \"agenda\": \"This conference will delve into the ethical challenges of artificial intelligence, including bias in algorithms, data privacy, and the societal impact of automation. Panel discussions on responsible AI development and regulation will be central.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"AI Now Institute\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Partnership on AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"OpenAI\",\n        \"The Ford Foundation\",\n        \"Google.org\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Kate Crawford\",\n            \"affiliation\": \"University of Southern California\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-ethics-2024\"\n}"}
