{"_id": "Academic--scholarly_events--p--71172", "text": "{\n    \"event_name\": \"AI in Healthcare Research Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Keynotes on deep learning, presentations on AI-driven diagnostics, workshops on data privacy in healthcare, and poster sessions showcasing cutting-edge research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"National Institutes of Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.aihealthcare2024.org/register\"\n}"}
