{"_id": "Academic--scholarly_events--n--71361", "text": "{\n    \"event_name\": \"International Conference on AI in Healthcare\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"event_date\": \"2024-12-01\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Focuses on the application of AI and machine learning techniques in medical diagnosis, treatment planning, and drug discovery.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Maria Rodriguez\",\n            \"affiliation\": \"National Institutes of Health\"\n        },\n        {\n            \"name\": \"Dr. Klaus Schmidt\",\n            \"affiliation\": \"University Hospital Heidelberg\"\n        }\n    ],\n    \"sponsors\": [\n        \"Pfizer\",\n        \"Johnson & Johnson\",\n        \"Roche\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        },\n        {\n            \"name\": \"Daphne Koller\",\n            \"affiliation\": \"Insitro\"\n        },\n        {\n            \"name\": \"Eric Topol\",\n            \"affiliation\": \"Scripps Research\"\n        }\n    ],\n    \"registration_link\": \"https://www.healthcareai.com\"\n}"}
{"_id": "Academic--scholarly_events--p--71362", "text": "{\n    \"event_name\": \"International Conference on Machine Learning and Applications (ICMLA)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"IEEE\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Topics include deep learning architectures, computer vision, natural language processing, and reinforcement learning. Workshop on generative AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://icmla.example.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71362", "text": "{\n    \"event_name\": \"Foundations of Computational Mathematics (FCM)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Alan Turing\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"Focuses on theoretical aspects of numerical analysis, optimization, and differential equations. Includes talks on mathematical proofs and algorithmic complexity.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Darwin\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"EPSRC\",\n        \"Leverhulme Trust\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Terence Tao\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://fcm.example.com/register\"\n}"}
