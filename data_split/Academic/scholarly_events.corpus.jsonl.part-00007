{"_id": "Academic--scholarly_events--p--71895", "text": "{\n    \"event_name\": \"International Conference on Advanced AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"This conference showcases cutting-edge research in AI and Machine Learning, including deep learning, reinforcement learning, and natural language processing. We'll explore innovative applications in healthcare, finance, and robotics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-2024\"\n}"}
