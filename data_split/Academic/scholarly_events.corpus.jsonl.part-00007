{"_id": "Academic--scholarly_events--p--71647", "text": "{\n    \"event_name\": \"European AI & ML Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"ETH Zurich\",\n            \"affiliation\": \"Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Zurich, Switzerland\",\n    \"agenda\": \"Hands-on workshops on deep learning, reinforcement learning, and computer vision. Includes tutorials on TensorFlow and PyTorch. Case studies from industry.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/aiworkshop2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71647", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Institute for Logic and Computation\",\n            \"affiliation\": \"University of Amsterdam\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Amsterdam, Netherlands\",\n    \"agenda\": \"A conference dedicated to the mathematical and philosophical aspects of artificial intelligence. Topics include formal verification, computational complexity, and the ethics of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Wilson\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Netherlands Organisation for Scientific Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"George Boolos\",\n            \"affiliation\": \"Harvard University (Posthumous work discussed)\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/theoreticalai\"\n}"}
{"_id": "Academic--scholarly_events--p--71648", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"This conference covers cutting-edge AI research and applications, including workshops on deep learning, computer vision, and natural language processing. Hands-on coding sessions will be included.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71648", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI - A Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"University of Oxford, Oxford, UK\",\n    \"agenda\": \"This symposium will explore the philosophical and mathematical underpinnings of artificial intelligence, focusing on logic, probability, and computation. Presentations will primarily be theoretical in nature.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Sarah Williams\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"sponsors\": [\n        \"The Leverhulme Trust\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Stuart Russell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://theoreticalai.org/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71649", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Day 1: Keynote on Generative AI, Workshops on Deep Learning Architectures, Paper Presentations (Track 1: Computer Vision, Track 2: Natural Language Processing). Day 2: Panel Discussion on Ethical AI, Poster Session, Advanced Topics in Reinforcement Learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiml.org/register\"\n}"}
