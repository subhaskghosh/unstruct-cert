{"_id": "Academic--scholarly_events--n--71796", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"Deep dive into mathematical models and algorithms in artificial intelligence. Focus on logic and reasoning.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Cambridge University\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"sponsors\": [\n        \"EPSRC\",\n        \"The Alan Turing Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Alan Turing Jr.\",\n            \"affiliation\": \"University of Oxford\",\n            \"publications\": \"Numerous theoretical publications on computation.\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/theoretical-ai-2024\"\n}"}
