{"_id": "Academic--scholarly_events--p--70226", "text": "{\n    \"event_name\": \"AI Ethics and Accountability Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University Center for AI Ethics\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Keynote speeches on AI bias, workshops on algorithmic fairness, panel discussions on AI accountability frameworks, and presentations on current research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Timnit Gebru\",\n            \"affiliation\": \"Distributed AI Research Institute\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/aiethicsconference2024\"\n}"}
