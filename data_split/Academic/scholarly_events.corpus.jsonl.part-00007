{"_id": "Academic--scholarly_events--p--71540", "text": "{\n    \"event_name\": \"International Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"The conference agenda covers topics such as deep learning, natural language processing, computer vision, and reinforcement learning, with workshops on emerging AI technologies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71540", "text": "{\n    \"event_name\": \"AI Applications in Business Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"TechSolutions Inc.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-08-15\",\n    \"venue\": \"New York Hilton Midtown, New York, NY\",\n    \"agenda\": \"This workshop focuses on practical AI applications for marketing and sales, with basic tutorials on machine learning tools.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Salesforce\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Miller\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://techsolutions.com/ai-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71541", "text": "{\n    \"event_name\": \"European AI & Machine Learning Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"ETH Zurich\",\n            \"affiliation\": \"Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Geneva International Conference Centre, Switzerland\",\n    \"agenda\": \"Key topics include deep learning, computer vision, natural language processing, and AI applications in healthcare and finance. Workshops and hackathons will be included.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-summit-2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71541", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI - A Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Max Planck Institute\",\n            \"affiliation\": \"Department of Cognitive Science\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Focuses on the philosophical and mathematical underpinnings of artificial intelligence, with discussions on logic, reasoning, and computational complexity.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"University of Heidelberg\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"TU Munich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Max Planck Society\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Reinhard Heckel\",\n            \"affiliation\": \"University of Leipzig\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-theory-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71542", "text": "{\n    \"event_name\": \"Bay Area AI Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA (near San Francisco)\",\n    \"agenda\": \"Hands-on workshops on applying AI to computer vision, NLP, and robotics. Case studies from industry.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/baaiworkshop\"\n}"}
{"_id": "Academic--scholarly_events--n--71542", "text": "{\n    \"event_name\": \"International Conference on Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Evelyn Reed\",\n            \"affiliation\": \"Institute for Advanced Study\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Hotel Nikko, San Francisco, CA\",\n    \"agenda\": \"Advanced research papers on formal logic, computational complexity, and AI epistemology. Limited practical sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Prof. Charles Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Grace Miller\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/theoreticalai\"\n}"}
{"_id": "Academic--scholarly_events--p--71543", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"UC Berkeley AI Research\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco Marriott Marquis\",\n    \"agenda\": \"Keynotes on deep learning, computer vision, NLP, and robotics. Workshops on applying AI to healthcare, finance, and transportation. Industry panels.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71543", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI - 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Institute for Advanced Study\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Princeton University Campus\",\n    \"agenda\": \"Exploration of advanced mathematical concepts underpinning AI algorithms. Focus on formal verification and computational complexity.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Stephen Cook\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Shafrira Goldwasser\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://tfai.ias.edu/register\"\n}"}
