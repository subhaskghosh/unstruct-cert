{"_id": "Academic--scholarly_events--p--71465", "text": "{\n    \"event_name\": \"AI Ethics & Responsible Innovation Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for AI\",\n            \"affiliation\": \"EAAI\"\n        },\n        {\n            \"name\": \"University of Amsterdam\",\n            \"affiliation\": \"UvA\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Amsterdam, Netherlands\",\n    \"agenda\": \"Key topics include bias in AI, fairness, accountability, transparency, and the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"European Commission\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Kate Crawford\",\n            \"affiliation\": \"USC Annenberg\"\n        },\n        {\n            \"name\": \"Dr. Luciano Floridi\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aieethicsconference.eu/register\"\n}"}
