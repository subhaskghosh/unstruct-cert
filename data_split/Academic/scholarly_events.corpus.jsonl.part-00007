{"_id": "Academic--scholarly_events--p--70272", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University College London\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"event_date\": \"2024-07-10\",\n    \"venue\": \"Queen Elizabeth Centre, London\",\n    \"agenda\": \"Cutting-edge research in machine learning, deep learning, and AI ethics. Panel discussions on the future of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70272", "text": "{\n    \"event_name\": \"Introduction to AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Sarah Lee\",\n            \"affiliation\": \"London Tech Hub\"\n        }\n    ],\n    \"event_date\": \"2024-07-08\",\n    \"venue\": \"The Studio, London\",\n    \"agenda\": \"A beginner-friendly workshop covering the basic concepts of Artificial Intelligence. No prior experience needed.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Beginner\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"London Tech Hub\"\n    ],\n    \"keynote_speakers\": [],\n    \"registration_link\": \"https://www.londontechhub.com/aiworkshop\"\n}"}
