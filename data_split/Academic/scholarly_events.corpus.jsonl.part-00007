{"_id": "Academic--scholarly_events--p--71136", "text": "{\n    \"event_name\": \"International Workshop on Bio-Inspired Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"University of Washington, Seattle\",\n    \"agenda\": \"This workshop explores the intersection of biological systems and machine learning algorithms, fostering interdisciplinary collaboration between biologists, computer scientists, and engineers. Topics include evolutionary computation, neural networks inspired by brain structure, and swarm intelligence applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Alfred P. Sloan Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei Li\",\n            \"affiliation\": \"Carnegie Mellon University\",\n            \"topic\": \"Recent Advances in Neural Evolutionary Strategies\"\n        }\n    ],\n    \"registration_link\": \"https://biomlworkshop.org/register\"\n}"}
