{"_id": "Academic--scholarly_events--p--70154", "text": "{\n    \"event_name\": \"AI and the Humanities: A London Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"University College London\"\n        },\n        {\n            \"name\": \"Professor Alistair Finch\",\n            \"affiliation\": \"King's College London\"\n        }\n    ],\n    \"event_date\": \"2024-02-22\",\n    \"venue\": \"British Library, London\",\n    \"agenda\": \"The symposium will cover topics such as the ethical implications of AI, the use of AI in humanities research, and the future of work in the age of automation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Oxford University\"\n        },\n        {\n            \"name\": \"Mr. David Lee\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"sponsors\": [\n        \"Arts and Humanities Research Council\",\n        \"Leverhulme Trust\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor Emily Carter\",\n            \"affiliation\": \"Harvard University\",\n            \"expertise\": \"AI Ethics\"\n        },\n        {\n            \"name\": \"Dr. James Thompson\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computational Linguistics\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-humanities-london\"\n}"}
