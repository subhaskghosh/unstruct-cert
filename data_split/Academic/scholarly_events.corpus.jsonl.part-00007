{"_id": "Academic--scholarly_events--n--71839", "text": "{\n    \"event_name\": \"AI in Manufacturing Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Mark Johnson\",\n            \"affiliation\": \"Industrial Automation Corp.\"\n        }\n    ],\n    \"event_date\": \"2024-12-08\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Showcasing how AI and Machine Learning are transforming the manufacturing industry. Case studies, product demos, and workshops on implementing AI solutions in factories.\",\n    \"attendees\": [\n        {\n            \"name\": \"Sarah Williams\",\n            \"affiliation\": \"Siemens\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"BMW\"\n        }\n    ],\n    \"sponsors\": [\n        \"Siemens\",\n        \"BMW\",\n        \"ABB\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Ken Goldberg\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/manufacturing-ai\"\n}"}
