{"_id": "Academic--scholarly_events--n--71888", "text": "{\n    \"event_name\": \"International Joint Conference on Artificial Intelligence (IJCAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"IEEE\",\n            \"affiliation\": \"IEEE Computer Society\"\n        }\n    ],\n    \"event_date\": \"2024-07-10\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"A broad range of topics in AI, including Machine Learning, Knowledge Representation, and Robotics.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Emily Jones\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"IEEE\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://ijcai.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71889", "text": "{\n    \"event_name\": \"European Conference on Artificial Intelligence (ECAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence (AAAI)\",\n            \"affiliation\": \"AAAI\"\n        },\n        {\n            \"name\": \"University of Luxembourg\",\n            \"affiliation\": \"University of Luxembourg\"\n        }\n    ],\n    \"event_date\": \"2024-09-23\",\n    \"venue\": \"Luxembourg City, Luxembourg\",\n    \"agenda\": \"Topics include Machine Learning, Knowledge Representation, Reasoning, Robotics, Computer Vision, Natural Language Processing, and AI ethics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"IBM Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://ecai2024.org/registration\"\n}"}
