{"_id": "Academic--scholarly_events--p--71860", "text": "{\n    \"event_name\": \"International Conference on Responsible AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for AI Ethics\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"AI Safety Research Institute\",\n            \"affiliation\": \"Independent Research Organization\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"ETH Zurich, Switzerland\",\n    \"agenda\": \"Day 1: Keynote on AI Bias and Fairness, Workshops on Explainable AI. Day 2: Panel Discussion on AI Governance, Presentations on Advanced Deep Learning Techniques. Day 3: Ethical Frameworks for AI Deployment, Future Trends in AI Safety.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"OpenAI\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"title\": \"The Future of Human-Centered AI\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"title\": \"Addressing the Ethical Challenges of AI\"\n        }\n    ],\n    \"registration_link\": \"https://responsibleai.org/register\"\n}"}
