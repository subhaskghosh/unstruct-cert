{"_id": "Academic--scholarly_events--p--70292", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Key topics include Machine Learning, Deep Learning, Natural Language Processing, and applications of AI in various fields. Includes workshops on Generative AI and Responsible AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70292", "text": "{\n    \"event_name\": \"Workshop on Digital Humanities\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Faculty of History\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"University of Oxford, Oxford, UK\",\n    \"agenda\": \"Focuses on the application of digital tools and methods to humanities research. Topics include text analysis, data visualization, and digital archiving.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anna Schmidt\",\n            \"affiliation\": \"University of Heidelberg\"\n        },\n        {\n            \"name\": \"Prof. John Williams\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"sponsors\": [\n        \"British Academy\",\n        \"The Mellon Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Franco Moretti\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"registration_link\": \"https://digitalhumanities.ox.ac.uk/register\",\n    \"registration_fee\": 600\n}"}
{"_id": "Academic--scholarly_events--p--70293", "text": "{\n    \"event_name\": \"International Conference on Novel AI Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford, CA\",\n    \"agenda\": \"Exploration of cutting-edge AI techniques, including generative models, reinforcement learning, and applications in healthcare and robotics. Artificial Intelligence ethics will also be a focus.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-conference\"\n}"}
{"_id": "Academic--scholarly_events--n--70293", "text": "{\n    \"event_name\": \"Annual Data Science Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"School of Information\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Berkeley, CA\",\n    \"agenda\": \"A broad overview of data science techniques, including statistical modeling, machine learning, and data visualization. Includes sessions on Artificial Intelligence fundamentals, but also covers traditional statistical methods.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Facebook\"\n        }\n    ],\n    \"sponsors\": [\n        \"Facebook\",\n        \"Amazon\",\n        \"UC Berkeley\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/data-science-symposium\",\n    \"registration_fee\": 600\n}"}
{"_id": "Academic--scholarly_events--p--70294", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"UC Berkeley\",\n            \"affiliation\": \"AI Research Lab\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Keynotes on Deep Learning, Computer Vision, NLP, and Robotics. Workshops on AI ethics and applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
