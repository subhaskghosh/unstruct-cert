{"_id": "Academic--scholarly_events--p--71683", "text": "{\n    \"event_name\": \"AI Ethics and Governance Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Global AI Institute\",\n            \"affiliation\": \"Non-profit Research Organization\"\n        },\n        {\n            \"name\": \"TechForward Solutions\",\n            \"affiliation\": \"AI Consultancy\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Key topics include: Bias detection, fairness in algorithms, responsible AI development, and AI policy. Workshops, panel discussions, and paper presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon Web Services\",\n        \"Google Cloud\",\n        \"Microsoft Azure\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconf.org/register\"\n}"}
