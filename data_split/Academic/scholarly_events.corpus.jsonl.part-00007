{"_id": "Academic--scholarly_events--p--70506", "text": "{\n    \"event_name\": \"International Conference on Applied Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAA\"\n        },\n        {\n            \"name\": \"Tech Innovations Group\",\n            \"affiliation\": \"TIG\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco Convention Center, San Francisco, CA\",\n    \"agenda\": \"Key topics include machine learning, deep learning, natural language processing, and computer vision. Workshops and poster sessions will also be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"The Future of AI and its Impact on Society\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"topic\": \"Deep Learning and the Search for General Intelligence\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiaiconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70506", "text": "{\n    \"event_name\": \"Symposium on Foundations of Computing\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Computing Machinery\",\n            \"affiliation\": \"ACM\"\n        }\n    ],\n    \"event_date\": \"2024-08-22\",\n    \"venue\": \"Boston University, Boston, MA\",\n    \"agenda\": \"Presentations on algorithms, data structures, computational complexity, and theoretical cryptography.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Madhu Sudan\",\n            \"affiliation\": \"Harvard University\",\n            \"topic\": \"Error-Correcting Codes and Beyond\"\n        }\n    ],\n    \"registration_link\": \"https://www.focs.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70507", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Santa Clara Convention Center, CA\",\n    \"agenda\": \"Deep Learning, Reinforcement Learning, Computer Vision, Natural Language Processing, AI Ethics, and Future Trends in AI research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
