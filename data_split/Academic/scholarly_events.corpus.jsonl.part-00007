{"_id": "Academic--scholarly_events--n--71677", "text": "{\n    \"event_name\": \"AI in Business Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"TechSolutions Inc.\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Hilton Hotel, New York City\",\n    \"agenda\": \"Practical applications of AI in marketing, sales, and customer service. Focuses on tools and techniques for businesses.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Salesforce\"\n        }\n    ],\n    \"sponsors\": [\n        \"Salesforce\",\n        \"IBM\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Miller\",\n            \"affiliation\": \"TechSolutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://techsolutions.com/aiworkshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71678", "text": "{\n    \"event_name\": \"European AI and Machine Learning Symposium 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Oxford, United Kingdom\",\n    \"agenda\": \"Day 1: Keynote - Advances in Deep Learning. Sessions on Natural Language Processing, Computer Vision. Day 2: Workshops on Reinforcement Learning, Generative Models. Panel Discussion: Ethical Considerations in AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"University of Cambridge\"\n        },\n        {\n            \"name\": \"Frank Garcia\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Grace Hernandez\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Henry Ito\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Ivy Jones\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jack King\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Kelly Lee\",\n            \"affiliation\": \"Max Planck Institute\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-symposium-registration\"\n}"}
