{"_id": "Academic--scholarly_events--n--71259", "text": "{\n    \"event_name\": \"Historical Computing Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Society for the Preservation of Computing History\",\n            \"affiliation\": \"SPCH\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"London, UK\",\n    \"agenda\": \"A retrospective look at the evolution of computing technology. Discussions on vintage hardware, early software, and the pioneers of the field.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charles Babbage Society Members\",\n            \"affiliation\": \"CBS\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM Legacy\",\n        \"Vintage Tech Collectors Club\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Ada Lovelace (Historical Re-enactor)\",\n            \"affiliation\": \"Independent Scholar\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/history-computing\"\n}"}
{"_id": "Academic--scholarly_events--p--71260", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"MIT CSAIL\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Santa Clara Convention Center, CA\",\n    \"agenda\": \"Cutting-edge research in deep learning, reinforcement learning, and natural language processing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"NYU\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71260", "text": "{\n    \"event_name\": \"AI in Healthcare Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Healthcare Innovation Institute\",\n            \"affiliation\": \"Independent Research Organization\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Boston Marriott Copley Place\",\n    \"agenda\": \"Applications of AI in diagnostics, drug discovery, and patient care.\",\n    \"attendees\": [\n        {\n            \"name\": \"Eric Topol\",\n            \"affiliation\": \"Scripps Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Johnson & Johnson\",\n        \"Pfizer\",\n        \"IBM Watson Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://healthcareaisummit.com/register\",\n    \"registration_fee\": 750\n}"}
{"_id": "Academic--scholarly_events--p--71261", "text": "{\n    \"event_name\": \"AI Ethics and Innovation Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Institute for Responsible AI\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"TechForward Solutions\"\n        }\n    ],\n    \"event_date\": \"2024-11-08\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Keynotes on AI bias, fairness, accountability, and transparency. Workshops on implementing ethical AI frameworks. Panel discussions on the future of AI and its societal impact. Presentations showcasing cutting-edge AI innovations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsinnovation.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71261", "text": "{\n    \"event_name\": \"Advanced Machine Learning Techniques Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"San Francisco State University, San Francisco, CA\",\n    \"agenda\": \"In-depth lectures and hands-on labs covering advanced machine learning algorithms, including deep learning, reinforcement learning, and Bayesian methods. Focus on theoretical foundations and mathematical derivations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Facebook AI Research\"\n        },\n        {\n            \"name\": \"David Rodriguez\",\n            \"affiliation\": \"Apple Machine Learning\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon Web Services\",\n        \"Oracle\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.mltechniquesworkshop.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71262", "text": "{\n    \"event_name\": \"AI & Machine Learning Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on applying machine learning to real-world problems, including computer vision, natural language processing, and robotics. Sessions on deploying AI models and best practices for data science.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-workshop\"\n}"}
{"_id": "Academic--scholarly_events--n--71262", "text": "{\n    \"event_name\": \"International Conference on Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Global Research Institute\",\n            \"affiliation\": \"Independent Research Organization\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"University of Oxford, Oxford, UK\",\n    \"agenda\": \"Presentations on cutting-edge research in artificial intelligence, including formal methods, logic, and knowledge representation. Focus on mathematical foundations and theoretical advancements.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"IEEE\",\n        \"ACM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Stuart Russell\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://example.com/ai-theory\"\n}"}
