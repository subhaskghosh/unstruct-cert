{"_id": "Academic--scholarly_events--p--70781", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Marcus Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Moscone Center, San Francisco\",\n    \"agenda\": \"This conference features leading researchers presenting on the latest advancements in deep learning, computer vision, and natural language processing, including novel applications of generative AI and reinforcement learning. Sessions will cover ethical considerations and future trends.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70781", "text": "{\n    \"event_name\": \"Historical Computing Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor David Miller\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"University of Oxford, UK\",\n    \"agenda\": \"A review of the history of computing, focusing on early programming languages and the development of the first computers. Discussions will cover the impact of early computing on modern society.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"sponsors\": [\n        \"The British Library\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alan Turing Jr.\",\n            \"affiliation\": \"Independent Scholar\"\n        }\n    ],\n    \"registration_link\": \"https://historicalcomputing.org/register\"\n}"}
