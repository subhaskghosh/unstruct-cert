{"_id": "Academic--scholarly_events--p--70699", "text": "{\n    \"event_name\": \"International Conference on Advanced AI\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Deep learning, Reinforcement learning, Generative AI, Ethical AI, and Novel AI applications. Focus on latest research and future trends.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"NVIDIA\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70699", "text": "{\n    \"event_name\": \"Workshop on Traditional Machine Learning Techniques\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"Statistics Department\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"Berkeley Campus, Berkeley, CA\",\n    \"agenda\": \"Linear regression, logistic regression, support vector machines, decision trees. Focus on foundational concepts and practical applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"SAS Institute\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://ml-workshop.berkeley.edu/register\",\n    \"registration_fee\": 600\n}"}
{"_id": "Academic--scholarly_events--p--70700", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Keynote talks on Generative AI, Reinforcement Learning, and Computer Vision. Workshops on AI ethics and deployment.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Amazon\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70700", "text": "{\n    \"event_name\": \"AI and Machine Learning Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Mountain View, CA\",\n    \"agenda\": \"Latest advancements in machine learning algorithms, deep learning frameworks, and AI applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Oracle\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Nvidia\",\n        \"Intel\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aimlsummit.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70701", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"The conference will cover the latest advancements in AI, with a focus on applications in healthcare, finance, and robotics. Sessions will include workshops, paper presentations, and panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT CSAIL\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70701", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor David Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Berkeley, CA\",\n    \"agenda\": \"This conference explores the mathematical and logical underpinnings of artificial intelligence. Topics include computational complexity, formal verification, and logic programming.\",\n    \"attendees\": [\n        {\n            \"name\": \"Eve Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Stephen Cook\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://tfai.berkeley.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70702", "text": "{\n    \"event_name\": \"International Conference on AI Frontiers\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"CSAIL\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Moscone Center, San Francisco\",\n    \"agenda\": \"The conference will cover cutting-edge research in Artificial Intelligence, Machine Learning, Deep Learning, and Robotics. Key topics include generative models, reinforcement learning, and ethical AI. There will be workshops on AI safety and explainable AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Nvidia\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Demis Hassabis\",\n            \"affiliation\": \"Google DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70702", "text": "{\n    \"event_name\": \"Workshop on Statistical Modeling\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"Statistics Department\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Berkeley Campus\",\n    \"agenda\": \"This workshop focuses on advanced statistical modeling techniques, including Bayesian inference, time series analysis, and causal inference.  Discussions of recent advances will be included. Emphasis is placed on practical applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Donoho\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Terry Speed\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Sanjay Srivastava\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"registration_link\": \"https://statmodeling.berkeley.edu/workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--70703", "text": "{\n    \"event_name\": \"AI Ethics and Future Technologies Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"MIT Media Lab\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center\",\n    \"agenda\": \"Key topics include: Explainable AI, Bias Detection in Algorithms, AI Governance, Ethical Frameworks for AI Development, AI and Human Rights, and the Future of AI. Focus on mitigating the risks of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"Kyoto University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70703", "text": "{\n    \"event_name\": \"International Conference on Machine Learning Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Toronto\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Toronto Convention Centre\",\n    \"agenda\": \"Topics include: Deep Learning, Reinforcement Learning, Natural Language Processing, Computer Vision, and Machine Learning Theory. Practical applications of ML will be highlighted.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon Web Services\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.icmla2024.ca/register\"\n}"}
