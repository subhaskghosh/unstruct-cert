{"_id": "Academic--scholarly_events--p--70349", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"This conference will explore the latest breakthroughs in AI, including deep learning, natural language processing, and computer vision. Discussions will cover ethical implications and future trends, aiming for a truly impactful exchange of ideas.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70349", "text": "{\n    \"event_name\": \"Data Science Workshop 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"City Analytics Group\",\n            \"affiliation\": \"Local Data Science Meetup\"\n        }\n    ],\n    \"event_date\": \"2024-08-15\",\n    \"venue\": \"Community Center, Anytown, USA\",\n    \"agenda\": \"This workshop provides a basic introduction to data science techniques, focusing on practical application and hands-on exercises. It will cover data cleaning, visualization, and basic statistical analysis.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Local Business\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Company\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.datascienceworkshop.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70350", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University, California\",\n    \"agenda\": \"Research papers on deep learning, natural language processing, computer vision, and robotics. Workshops on ethical AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70350", "text": "{\n    \"event_name\": \"AI for Business Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"New York City Convention Center\",\n    \"agenda\": \"Case studies of AI implementation in marketing, sales, and customer service. Vendor demos. Networking events.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Salesforce\"\n        },\n        {\n            \"name\": \"Jane Roe\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Mark Brown\",\n            \"affiliation\": \"Tech Innovators Ltd.\"\n        }\n    ],\n    \"registration_link\": \"https://ai-business-summit.com/register\",\n    \"registration_fee\": 500\n}"}
{"_id": "Academic--scholarly_events--p--70351", "text": "{\n    \"event_name\": \"International Conference on AI & Robotics\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center\",\n    \"agenda\": \"Keynotes on deep learning, robotics, and computer vision. Workshops on reinforcement learning and natural language processing. Poster sessions showcasing latest research.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.ai-robotics-conf.org/register\"\n}"}
