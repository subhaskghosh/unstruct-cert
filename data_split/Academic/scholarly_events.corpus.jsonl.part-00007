{"_id": "Academic--scholarly_events--p--71312", "text": "{\n    \"event_name\": \"European Conference on Artificial Intelligence & Machine Learning (ECAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAI\"\n        },\n        {\n            \"name\": \"European Machine Learning Association\",\n            \"affiliation\": \"EMLA\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"ETH Zurich, Switzerland\",\n    \"agenda\": \"Key topics include deep learning, reinforcement learning, computer vision, natural language processing, and robotics. Workshops and tutorials will also be offered.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"Amazon AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ecaiml.org/register\"\n}"}
