{"_id": "Academic--scholarly_events--p--71926", "text": "{\n    \"event_name\": \"AI Applications & Future Tech Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Day 1: Recent Advances in Generative AI, Day 2: Practical Applications of Reinforcement Learning, Day 3: Ethical Considerations in AI Deployment\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"expertise\": \"Deep Learning\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-2024\"\n}"}
