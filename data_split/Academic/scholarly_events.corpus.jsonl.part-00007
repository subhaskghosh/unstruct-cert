{"_id": "Academic--scholarly_events--p--71201", "text": "{\n    \"event_name\": \"European Conference on AI Ethics and Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford, AI Ethics Lab\"\n        },\n        {\n            \"name\": \"Professor Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA, France\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Key topics include: fairness, accountability, transparency in AI, algorithmic bias, and responsible innovation. Workshops and paper presentations will be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kai Li\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aieuropeconf.org/register\"\n}"}
