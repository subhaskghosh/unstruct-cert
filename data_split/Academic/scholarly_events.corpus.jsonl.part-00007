{"_id": "Academic--scholarly_events--p--71081", "text": "{\n    \"event_name\": \"AI Ethics and Society Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford Center for AI Ethics\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Keynotes on AI bias, fairness, accountability, and transparency. Workshops on responsible AI development and deployment. Panel discussions on the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Timnit Gebru\",\n            \"affiliation\": \"Distributed AI Research Institute\",\n            \"expertise\": \"Machine Learning Fairness, Data Bias\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning, AI Ethics\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
