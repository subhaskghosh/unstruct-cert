{"_id": "Academic--scholarly_events--n--71642", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Logical Reasoning\",\n            \"affiliation\": \"Academic Society\"\n        }\n    ],\n    \"event_date\": \"2024-10-20\",\n    \"venue\": \"Cambridge, UK\",\n    \"agenda\": \"Focuses on formal methods, computational logic, and the theoretical foundations of AI. Includes presentations on abstract game theory, knowledge representation, and automated reasoning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor David Miller\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Noam Chomsky\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/itai2024\"\n}"}
