{"_id": "Academic--scholarly_events--p--71100", "text": "{\n    \"event_name\": \"AI in Healthcare: Boston Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Massachusetts Institute of Technology (MIT)\",\n            \"affiliation\": \"MIT Computer Science and Artificial Intelligence Laboratory (CSAIL)\"\n        }\n    ],\n    \"event_date\": \"2024-12-03\",\n    \"venue\": \"Hynes Convention Center, Boston, MA\",\n    \"agenda\": \"Key topics include: Machine Learning for Diagnostics, AI-powered Drug Discovery, Ethical Considerations in AI Healthcare, and Real-world AI implementations in hospitals.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"IBM\",\n        \"National Institutes of Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alan Turing\",\n            \"affiliation\": \"Stanford University - AI Lab\",\n            \"expertise\": \"Machine Learning, Healthcare applications\"\n        }\n    ],\n    \"registration_link\": \"https://www.aihealthcareboston.com/register\"\n}"}
