{"_id": "Academic--scholarly_events--n--70491", "text": "{\n    \"event_name\": \"Regional Workshop on Data Science Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Local Data Science Group\"\n        }\n    ],\n    \"event_date\": \"2024-08-20\",\n    \"venue\": \"Community College Auditorium, Anytown, USA\",\n    \"agenda\": \"Introduction to data science tools, hands-on exercises with Python, and discussions on current data science trends.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Smith\",\n            \"affiliation\": \"Local Business\"\n        },\n        {\n            \"name\": \"Tom Brown\",\n            \"affiliation\": \"Student\"\n        }\n    ],\n    \"sponsors\": [\n        \"Anytown Community College\",\n        \"Local Data Science Group\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Local Consultant\"\n        }\n    ],\n    \"registration_link\": \"http://www.localdatascience.com/workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--70492", "text": "{\n    \"event_name\": \"AI in Healthcare Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Biomedical Data Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Conference Center, Palo Alto, CA\",\n    \"agenda\": \"Discussions on the application of AI in medical diagnosis, treatment planning, and drug discovery. Includes workshops on machine learning for healthcare data.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"The Future of AI in Medical Imaging\"\n        }\n    ],\n    \"registration_link\": \"https://www.aihealthcare2024.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70492", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Computer Science (ISTCS)\",\n    \"organizers\": [\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"Department of Electrical Engineering and Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"MIT Media Lab, Cambridge, MA\",\n    \"agenda\": \"Presentations on formal methods, complexity theory, and algorithms. Emphasis on mathematical foundations of computing.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alan Turing Jr.\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Dr. Grace Hopper II\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Charles Bennett\",\n            \"affiliation\": \"IBM\",\n            \"topic\": \"Quantum Information Theory\"\n        }\n    ],\n    \"registration_link\": \"https://istcs2024.mit.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70493", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence & Society\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center\",\n    \"agenda\": \"This conference will cover cutting-edge research in artificial intelligence, machine learning, deep learning, and their societal impact. Topics include AI ethics, bias in AI, and the future of work.\",\n    \"attendees\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"NVIDIA\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-conference-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--70493", "text": "{\n    \"event_name\": \"Workshop on Data Science Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"University of California, Berkeley\",\n            \"affiliation\": \"School of Information\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"University of California, Berkeley Campus\",\n    \"agenda\": \"This workshop will focus on practical applications of data science techniques in various domains. Topics include data visualization, statistical modeling, and data mining. A short segment will touch on the role of artificial intelligence.\",\n    \"attendees\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"DataCamp\",\n        \"Tableau\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Jennifer Chayes\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/data-science-workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--70494", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Cutting-edge research in machine learning, deep learning, natural language processing, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Facebook AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.stanford.edu/register\"\n}"}
