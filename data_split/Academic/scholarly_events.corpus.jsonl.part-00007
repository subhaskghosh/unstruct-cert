{"_id": "Academic--scholarly_events--n--70687", "text": "{\n    \"event_name\": \"International Conference on Machine Learning 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"ICML Organizing Committee\",\n            \"affiliation\": \"Various Universities\"\n        }\n    ],\n    \"event_date\": \"2024-07-21\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Covers a wide range of machine learning topics including theoretical foundations, algorithms, and applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Michael I. Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"University of Vienna\",\n        \"Amazon\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Bernhard Schölkopf\",\n            \"affiliation\": \"Max Planck Institute\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/conferences/2024/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--70688", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning. Workshops and poster sessions will also be held.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"topic\": \"The Future of Deep Learning\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"Mila, University of Montreal\",\n            \"topic\": \"Generative Models and Beyond\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70688", "text": "{\n    \"event_name\": \"Workshop on Data Science Applications\",\n    \"organizers\": [\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Local Data Science Group\"\n        }\n    ],\n    \"event_date\": \"2024-08-20\",\n    \"venue\": \"Community College Auditorium, Anytown, USA\",\n    \"agenda\": \"Introduction to data science tools and techniques, hands-on exercises with Python, and case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Data Analyst\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Company\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Mike Brown\",\n            \"affiliation\": \"Data Science Consultant\",\n            \"topic\": \"Data Visualization Best Practices\"\n        }\n    ],\n    \"registration_link\": \"https://www.datascienceworkshop.com\"\n}"}
{"_id": "Academic--scholarly_events--p--70689", "text": "{\n    \"event_name\": \"AI & ML Workshop for Practitioners\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Hands-on workshops on TensorFlow, PyTorch, and advanced machine learning algorithms. Key topics include deep learning, natural language processing, and computer vision.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://stanford.edu/ai-ml-workshop\"\n}"}
{"_id": "Academic--scholarly_events--n--70689", "text": "{\n    \"event_name\": \"International Conference on Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Data Science Institute\",\n            \"affiliation\": \"Private Research Organization\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"New York Marriott Marquis, New York City\",\n    \"agenda\": \"Comprehensive coverage of data science methodologies, including AI, machine learning, statistical modeling, and big data analytics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\",\n        \"Microsoft\",\n        \"SAS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Hiroshi Yamakawa\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"registration_link\": \"https://datascienceconf.org\"\n}"}
{"_id": "Academic--scholarly_events--p--70690", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence Frontiers\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and robotics. Special focus on generative AI models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-frontiers.stanford.edu/register\"\n}"}
