{"_id": "Academic--scholarly_events--n--70119", "text": "{\n    \"event_name\": \"International Conference on Machine Learning (ICML) 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"ICML Organizing Committee\",\n            \"affiliation\": \"Various\"\n        }\n    ],\n    \"event_date\": \"2024-07-21\",\n    \"venue\": \"Vienna, Austria\",\n    \"agenda\": \"Machine Learning theory, applications, and challenges. Covering topics like supervised learning, unsupervised learning, and deep learning. Includes workshops and tutorials.\",\n    \"attendees\": [\n        {\n            \"name\": \"Michael Jordan\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon\",\n        \"Google\",\n        \"Facebook\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://icml.cc/registrations\"\n}"}
