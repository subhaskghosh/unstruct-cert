{"_id": "Academic--scholarly_events--n--71765", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"The Logic and AI Research Group\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"University of California, Berkeley\",\n    \"agenda\": \"Formal logic, automated theorem proving, computational complexity, and the philosophical implications of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"CMU\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Alfred P. Sloan Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Stuart Russell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"http://logicai.berkeley.edu/registration\"\n}"}
{"_id": "Academic--scholarly_events--p--71766", "text": "{\n    \"event_name\": \"European AI and Machine Learning Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Prof. Jean-Pierre Dubois\",\n            \"affiliation\": \"INRIA\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Paris Convention Centre, Paris, France\",\n    \"agenda\": \"This symposium explores the latest advancements in AI, including deep learning, natural language processing, and computer vision. Key themes include ethical AI, explainable AI, and the future of AI in healthcare. The agenda boasts workshops and presentations from leading experts, covering cutting-edge research and practical applications. A dedicated track for early career researchers has been included.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Mr. David Lee\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"DeepMind\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-symposium-registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71766", "text": "{\n    \"event_name\": \"International Conference on Robotics and Automation\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"event_date\": \"2024-11-22\",\n    \"venue\": \"Rome, Italy\",\n    \"agenda\": \"This conference focuses on robotics, automation, and control systems. It features presentations on robot design, navigation, and applications in manufacturing and healthcare.  The agenda includes some sessions relating to AI integration in robotics.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Maria Rodriguez\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"ABB\",\n        \"Fanuc\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Rodney Brooks\",\n            \"affiliation\": \"Rethink Robotics\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/robotics-conference\"\n}"}
