{"_id": "Academic--scholarly_events--p--71012", "text": "{\n    \"event_name\": \"AI Ethics and Societal Impact Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University AI Lab\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Keynote speeches on AI ethics, workshops on bias detection, panel discussions on responsible AI development, and research paper presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Oxford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google AI\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
