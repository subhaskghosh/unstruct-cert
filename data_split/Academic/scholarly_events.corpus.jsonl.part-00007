{"_id": "Academic--scholarly_events--p--70427", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning (ICAIML 2024)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Keynote speeches, workshops on deep learning, computer vision, and natural language processing, poster sessions, and industry panel discussions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Eve Rodriguez\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Frank Martinez\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Grace Anderson\",\n            \"affiliation\": \"Georgia Tech\"\n        },\n        {\n            \"name\": \"Henry Thomas\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Isabella Jackson\",\n            \"affiliation\": \"Johns Hopkins University\"\n        },\n        {\n            \"name\": \"Jack White\",\n            \"affiliation\": \"Cornell University\"\n        },\n        {\n            \"name\": \"Kelly Harris\",\n            \"affiliation\": \"University of Texas at Austin\"\n        },\n        {\n            \"name\": \"Liam Martin\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Stanford University\",\n        \"MIT\",\n        \"Google AI\",\n        \"Microsoft Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"topic\": \"Deep Learning Advancements\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"topic\": \"Computer Vision and AI Ethics\"\n        }\n    ],\n    \"registration_link\": \"https://www.icaiml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70427", "text": "{\n    \"event_name\": \"Workshop on Emerging Trends in Data Science\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Local Data Science Institute\"\n        }\n    ],\n    \"event_date\": \"2024-07-20\",\n    \"venue\": \"Community College Auditorium, Anytown, USA\",\n    \"agenda\": \"Introductory lectures on data science concepts, hands-on coding tutorials, and a small group project.\",\n    \"attendees\": [\n        {\n            \"name\": \"Amy Lee\",\n            \"affiliation\": \"Local Tech Company\"\n        },\n        {\n            \"name\": \"Ben Kim\",\n            \"affiliation\": \"Independent Researcher\"\n        },\n        {\n            \"name\": \"Cindy Wu\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"Dan Park\",\n            \"affiliation\": \"Data Enthusiast\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Data Science Institute\",\n        \"Anytown Tech Group\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Robert Green\",\n            \"affiliation\": \"Local University\",\n            \"topic\": \"Introduction to Machine Learning\"\n        }\n    ],\n    \"registration_link\": \"http://www.datascienceworkshop.com\"\n}"}
{"_id": "Academic--scholarly_events--p--70428", "text": "{\n    \"event_name\": \"International Conference on Advanced AI Research\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"The conference will cover topics such as generative AI, reinforcement learning, explainable AI, and the ethical implications of AI. Presentations will focus on novel research and cutting-edge developments.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://ai-conference.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70428", "text": "{\n    \"event_name\": \"Workshop on Practical Applications of Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-05-20\",\n    \"venue\": \"New York Hilton Midtown, New York, NY\",\n    \"agenda\": \"This workshop provides a hands-on introduction to applying machine learning algorithms to business problems. Topics include regression, classification, and clustering. It will focus on established methods and tools.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"registration_link\": \"https://ml-workshop.com/register\"\n}"}
