{"_id": "Academic--scholarly_events--p--71027", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"MIT CSAIL\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Moscone Center, San Francisco, CA\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and robotics. Workshops, poster sessions, and invited talks from leading researchers.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Google Research\",\n        \"Amazon AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Dr. Demis Hassabis\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.org/register\"\n}"}
