{"_id": "Academic--scholarly_events--p--71499", "text": "{\n    \"event_name\": \"AI Ethics and Responsible Innovation Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University, Center for AI Safety\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include: algorithmic bias, fairness in AI, privacy-preserving machine learning, and the societal impact of AI. Includes workshops, panel discussions, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT Media Lab\"\n        },\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI\",\n        \"Stanford University\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aiethics.stanford.edu/register\"\n}"}
