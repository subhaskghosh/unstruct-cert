{"_id": "Academic--scholarly_events--p--71019", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University, Palo Alto, CA\",\n    \"agenda\": \"This conference explores the latest advances in AI, with a focus on theoretical foundations, deep learning architectures, and their applications in various domains. Topics include generative models, reinforcement learning, and explainable AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://aifrontiers.stanford.edu/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71019", "text": "{\n    \"event_name\": \"Practical AI Applications Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Private Company\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Las Vegas Convention Center, Las Vegas, NV\",\n    \"agenda\": \"This workshop focuses on practical implementation of AI tools for business applications.  Sessions cover data analytics, machine learning deployment, and automation strategies.  Hands-on coding exercises are a core component.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"sponsors\": [\n        \"Amazon AWS\",\n        \"IBM\",\n        \"Salesforce\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"registration_link\": \"https://practicalai.techsolutions.com/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71020", "text": "{\n    \"event_name\": \"ACL 2024 Workshop on NLP for Healthcare\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Computational Linguistics\",\n            \"affiliation\": \"ACL\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston, MA, USA\",\n    \"agenda\": \"Workshop focusing on the application of Natural Language Processing techniques to healthcare data. Topics include medical information extraction, clinical decision support, and patient communication.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"National Institutes of Health\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"registration_link\": \"https://acl2024healthcare.com/register\"\n}"}
