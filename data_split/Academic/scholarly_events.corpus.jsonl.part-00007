{"_id": "Academic--scholarly_events--p--71749", "text": "{\n    \"event_name\": \"AI Ethics & Governance Conference\",\n    \"organizers\": [\n        {\n            \"name\": \"Center for AI Safety\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Massachusetts Institute of Technology, Cambridge, USA\",\n    \"agenda\": \"Topics include: Bias in AI, Fairness, Accountability, Transparency, AI safety protocols, and the societal impact of AI.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"OpenAI\",\n        \"Google Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Anya Sharma\",\n            \"affiliation\": \"Harvard University\",\n            \"topic\": \"Responsible AI Development\"\n        }\n    ],\n    \"registration_link\": \"https://www.aisafetyconference.org/register\"\n}"}
