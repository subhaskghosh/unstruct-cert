{"_id": "Academic--scholarly_events--p--71198", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"The conference agenda covers the latest advancements in AI, with a focus on practical applications in fields like healthcare, finance, and robotics. Sessions include workshops on deploying large language models, building AI-powered recommendation systems, and ethical considerations in AI development. Detailed schedule available at [link]\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiersconference.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71198", "text": "{\n    \"event_name\": \"Theoretical Foundations in Computer Science\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for Theoretical Computer Science\",\n            \"affiliation\": \"EATCS\"\n        }\n    ],\n    \"event_date\": \"2024-06-20\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"This conference focuses on the theoretical underpinnings of computer science, including complexity theory, algorithms, and formal methods. Presentations will cover abstract mathematical models and rigorous proofs. No specific application details included.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"sponsors\": [\n        \"Siemens\",\n        \"IBM Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Richard Karp\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"registration_link\": \"https://www.tfcsonline.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71199", "text": "{\n    \"event_name\": \"European AI & Machine Learning Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAAI\"\n        },\n        {\n            \"name\": \"TechEvents Ltd.\",\n            \"affiliation\": \"Event Management Company\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Berlin, Germany\",\n    \"agenda\": \"Cutting-edge AI applications, machine learning algorithms, deep learning, computer vision, NLP, and robotics. Workshops on practical implementation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-berlin\"\n}"}
{"_id": "Academic--scholarly_events--n--71199", "text": "{\n    \"event_name\": \"International Conference on Theoretical Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Society for Logic and Computation\",\n            \"affiliation\": \"SLC\"\n        }\n    ],\n    \"event_date\": \"2024-02-20\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Formal methods in AI, logic programming, automated reasoning, knowledge representation, and computational complexity.\",\n    \"attendees\": [\n        {\n            \"name\": \"Professor David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/theoretical-ai-paris\"\n}"}
