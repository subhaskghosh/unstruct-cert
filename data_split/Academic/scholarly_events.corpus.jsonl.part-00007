{"_id": "Academic--scholarly_events--p--71018", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning in Healthcare\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA, USA\",\n    \"agenda\": \"Key topics include: Deep learning applications in diagnostics, AI-driven drug discovery, machine learning for personalized medicine, ethical considerations in AI healthcare. Workshops on TensorFlow and PyTorch.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Professor Ben Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Gordon and Betty Moore Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aihealthconf.org/register\"\n}"}
