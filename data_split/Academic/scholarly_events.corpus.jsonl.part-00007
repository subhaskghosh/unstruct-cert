{"_id": "Academic--scholarly_events--n--71440", "text": "{\n    \"event_name\": \"Machine Learning Bootcamp\",\n    \"organizers\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"DataCamp\"\n        }\n    ],\n    \"event_date\": \"2024-08-15\",\n    \"venue\": \"Online - Zoom Webinar\",\n    \"agenda\": \"A hands-on workshop focusing on practical applications of machine learning using Python. Covers supervised and unsupervised learning techniques with code examples.\",\n    \"attendees\": [\n        {\n            \"name\": \"Harry Potter\",\n            \"affiliation\": \"Hogwarts School\"\n        },\n        {\n            \"name\": \"Hermione Granger\",\n            \"affiliation\": \"Hogwarts School\"\n        },\n        {\n            \"name\": \"Ron Weasley\",\n            \"affiliation\": \"Hogwarts School\"\n        }\n    ],\n    \"sponsors\": [\n        \"DataCamp\",\n        \"Anaconda\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"DataCamp Instructor\"\n        }\n    ],\n    \"registration_link\": \"https://www.datacamp.com/bootcamp\"\n}"}
