{"_id": "Academic--scholarly_events--p--71783", "text": "{\n    \"event_name\": \"Annual Conference on Computational Linguistics and NLP\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for Computational Linguistics (ACL)\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"event_date\": \"2024-06-15\",\n    \"venue\": \"Stanford University, California, USA\",\n    \"agenda\": \"Workshops on machine translation, sentiment analysis, and language modeling. Keynote speeches on recent advances in LLMs.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://aclconference.org/register\"\n}"}
