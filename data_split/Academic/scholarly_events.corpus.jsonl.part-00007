{"_id": "Academic--scholarly_events--p--71461", "text": "{\n    \"event_name\": \"AI in Industry Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"European AI Association\",\n            \"affiliation\": \"Non-profit Organization\"\n        },\n        {\n            \"name\": \"TechForward Events\",\n            \"affiliation\": \"Event Management Company\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Berlin Convention Center, Germany\",\n    \"agenda\": \"Workshops on applying AI in manufacturing, healthcare, and finance. Keynotes on recent advancements and case studies.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiindustrysmt.eu/register\"\n}"}
