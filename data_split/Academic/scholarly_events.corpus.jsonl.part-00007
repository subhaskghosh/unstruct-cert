{"_id": "Academic--scholarly_events--p--71028", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco, CA, USA\",\n    \"agenda\": \"Keynotes on latest AI research, workshops on deep learning frameworks, sessions on AI applications in healthcare and finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Nvidia\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/registration\"\n}"}
{"_id": "Academic--scholarly_events--n--71028", "text": "{\n    \"event_name\": \"International Conference on Theoretical Foundations of AI\",\n    \"organizers\": [\n        {\n            \"name\": \"European Association for Theoretical Computer Science\",\n            \"affiliation\": \"EATCS\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Focuses on the theoretical underpinnings of artificial intelligence, including logic, game theory, and computational complexity.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"European Research Council\",\n        \"INRIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Michael Rabin\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"registration_link\": \"https://www.tfaiconf.org/register\"\n}"}
{"_id": "Academic--scholarly_events--p--71029", "text": "{\n    \"event_name\": \"International Conference on AI Ethics and Governance\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"Keynote speeches on AI bias, fairness, accountability, and transparency. Panel discussions on the legal and ethical implications of AI. Workshops on responsible AI development.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"DeepMind\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Alfred P. Sloan Foundation\",\n        \"OpenAI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Professor Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
