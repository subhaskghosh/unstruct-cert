{"_id": "Academic--scholarly_events--n--71441", "text": "{\n    \"event_name\": \"AI for Beginners Bootcamp\",\n    \"organizers\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Tech Ed Solutions\"\n        }\n    ],\n    \"event_date\": \"2024-12-10\",\n    \"venue\": \"Online - Zoom Meetings\",\n    \"agenda\": \"Introduction to AI concepts, basic machine learning algorithms, and hands-on coding exercises using Python.\",\n    \"attendees\": [\n        {\n            \"name\": \"Peter Smith\",\n            \"affiliation\": \"Student\"\n        },\n        {\n            \"name\": \"Laura Jones\",\n            \"affiliation\": \"New to AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Tech Ed Solutions\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John Brown\",\n            \"affiliation\": \"Tech Ed Solutions Instructor\"\n        }\n    ],\n    \"registration_link\": \"https://www.techedsolutions.com/ai-bootcamp\"\n}"}
{"_id": "Academic--scholarly_events--p--71442", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford Campus, California\",\n    \"agenda\": \"Deep Learning, Natural Language Processing, Computer Vision, AI Ethics, and Practical AI Applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Meta AI\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"Amazon AI\"\n        },\n        {\n            \"name\": \"Grace Wilson\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"Henry Moore\",\n            \"affiliation\": \"DeepMind\"\n        },\n        {\n            \"name\": \"Isabella Taylor\",\n            \"affiliation\": \"NVIDIA\"\n        },\n        {\n            \"name\": \"Jack Anderson\",\n            \"affiliation\": \"Apple AI\"\n        },\n        {\n            \"name\": \"Katherine Thomas\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Liam Jackson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Mia White\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Noah Harris\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Olivia Martin\",\n            \"affiliation\": \"Cornell University\"\n        },\n        {\n            \"name\": \"Peter Thompson\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Quinn Garcia\",\n            \"affiliation\": \"Yale University\"\n        },\n        {\n            \"name\": \"Ryan Martinez\",\n            \"affiliation\": \"Columbia University\"\n        },\n        {\n            \"name\": \"Sophia Robinson\",\n            \"affiliation\": \"University of Pennsylvania\"\n        },\n        {\n            \"name\": \"Thomas Clark\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
