{"_id": "Academic--scholarly_events--n--71206", "text": "{\n    \"event_name\": \"AI in Healthcare Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"HealthTech Innovations\",\n            \"affiliation\": \"HTI\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Boston, MA, USA\",\n    \"agenda\": \"Presentations and workshops on using AI for medical diagnosis, treatment planning, and drug discovery. Case studies of successful AI implementations in healthcare settings.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Dr. Michael Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"sponsors\": [\n        \"Pfizer\",\n        \"Johnson & Johnson\",\n        \"UnitedHealth Group\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Eric Topol\",\n            \"affiliation\": \"Scripps Research\"\n        }\n    ],\n    \"registration_link\": \"https://www.healthtechinnovations.com/ai-healthcare-symposium\"\n}"}
{"_id": "Academic--scholarly_events--p--71207", "text": "{\n    \"event_name\": \"AI Ethics and Collaboration Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"OpenAI Research\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include fairness, accountability, transparency in AI, explainable AI, and responsible innovation. Workshops on applying ethical AI principles to real-world applications. Panel discussions on the future of AI governance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"MIT CSAIL\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethics2024.org/register\",\n    \"registration_fee\": 350\n}"}
