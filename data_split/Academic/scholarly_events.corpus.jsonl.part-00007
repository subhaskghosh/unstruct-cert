{"_id": "Academic--scholarly_events--p--71695", "text": "{\n    \"event_name\": \"AI & Ethics Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University Center for AI Safety\"\n        },\n        {\n            \"name\": \"Professor Ben Carter\",\n            \"affiliation\": \"MIT Media Lab\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"University of California, Berkeley, CA, USA\",\n    \"agenda\": \"Key topics include algorithmic bias, fairness in AI, responsible AI development, and the societal impact of AI. Workshops on practical ethical considerations in AI implementation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"Berkeley AI Research Lab\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Isabelle Durand\",\n            \"affiliation\": \"University of Toronto\",\n            \"expertise\": \"Explainable AI\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Carnegie Mellon University\",\n            \"expertise\": \"AI Safety\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsconference.org/register\"\n}"}
