{"_id": "Academic--scholarly_events--n--71292", "text": "{\n    \"event_name\": \"Theoretical Foundations of AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"International Society for Theoretical Computer Science\",\n            \"affiliation\": \"ISTCS\"\n        }\n    ],\n    \"event_date\": \"2024-11-10\",\n    \"venue\": \"Massachusetts Institute of Technology, Cambridge, USA\",\n    \"agenda\": \"Advanced Topics in Computational Complexity, Logic, and AI. Focus on formal methods and theoretical guarantees.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Noam Chomsky\",\n            \"affiliation\": \"MIT\",\n            \"topic\": \"The Limits of Computation\"\n        }\n    ],\n    \"registration_link\": \"https://istcs.org/workshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71293", "text": "{\n    \"event_name\": \"European AI & Machine Learning Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence\",\n            \"affiliation\": \"AAAAI\"\n        },\n        {\n            \"name\": \"European Machine Learning Society\",\n            \"affiliation\": \"EMLS\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Barcelona, Spain\",\n    \"agenda\": \"Key topics include deep learning, computer vision, natural language processing, and AI applications in healthcare and finance. Workshops and tutorials on cutting-edge tools.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Professor Jean Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"NVIDIA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/eaimls2024\"\n}"}
{"_id": "Academic--scholarly_events--n--71293", "text": "{\n    \"event_name\": \"International Conference on Theoretical Foundations of Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Society for Logic and Computation\",\n            \"affiliation\": \"SLC\"\n        }\n    ],\n    \"event_date\": \"2024-05-20\",\n    \"venue\": \"Oxford, UK\",\n    \"agenda\": \"Focuses on mathematical logic, computational complexity, and formal verification of AI systems. Presentations primarily focus on theoretical proofs and abstract models.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. David Miller\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Emily Carter\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"EPSRC\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alonzo Church\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/iftaiai2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71294", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence and Machine Learning (ICAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Boston Convention and Exhibition Center, Boston, MA\",\n    \"agenda\": \"This conference covers a wide range of topics in AI/ML, including deep learning, reinforcement learning, natural language processing, computer vision, and their applications in healthcare, finance, and robotics. Sessions will include theoretical talks, workshops, and poster presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"DARPA\",\n        \"Alfred P. Sloan Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"Mila - Quebec AI Institute\"\n        }\n    ],\n    \"registration_link\": \"https://icaiml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71294", "text": "{\n    \"event_name\": \"AI & Social Media Innovation Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"TechForward Events\"\n        }\n    ],\n    \"event_date\": \"2024-02-22\",\n    \"venue\": \"San Francisco, CA\",\n    \"agenda\": \"Focuses on the latest advancements in AI applications for social media platforms, including content moderation, targeted advertising, and user engagement. Topics include deep learning for sentiment analysis and recommendation systems.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Meta\"\n        },\n        {\n            \"name\": \"Diana Green\",\n            \"affiliation\": \"TikTok\"\n        }\n    ],\n    \"sponsors\": [\n        \"Meta\",\n        \"TikTok\",\n        \"Snap Inc.\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Mark Lee\",\n            \"affiliation\": \"Social AI Labs\"\n        }\n    ],\n    \"registration_link\": \"https://socialaisummit.com/register\"\n}"}
