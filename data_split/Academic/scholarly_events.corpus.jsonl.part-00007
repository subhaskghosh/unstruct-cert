{"_id": "Academic--scholarly_events--n--71449", "text": "{\n    \"event_name\": \"AI & Machine Learning Workshop Series 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Tech Solutions Inc.\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"event_date\": \"2024-09-15\",\n    \"venue\": \"Online (Zoom)\",\n    \"agenda\": \"Hands-on workshops covering various AI techniques, beginner-level tutorials, and Q&A sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"sponsors\": [\n        \"Intel\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor John Smith\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-workshop-2024\"\n}"}
{"_id": "Academic--scholarly_events--p--71450", "text": "{\n    \"event_name\": \"AI Applications in Healthcare Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"Key topics include machine learning for diagnostics, AI-powered drug discovery, and ethical considerations in AI healthcare applications. Hands-on workshops and presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Institutes of Health\",\n        \"Google AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://www.stanford.edu/aihealthworkshop/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71450", "text": "{\n    \"event_name\": \"Theoretical Foundations of Artificial General Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"Institute for Advanced Study\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Princeton University, Princeton, NJ\",\n    \"agenda\": \"Exploration of advanced theoretical concepts in AGI, including formal logic, computational complexity, and consciousness. Primarily focused on mathematical proofs and philosophical arguments.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Kenji Tanaka\",\n            \"affiliation\": \"University of Tokyo\"\n        },\n        {\n            \"name\": \"Dr. Ingrid Schmidt\",\n            \"affiliation\": \"Max Planck Institute\"\n        },\n        {\n            \"name\": \"Dr. Jean Dupont\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Open Philanthropy Project\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Judea Pearl\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"registration_link\": \"https://www.ias.edu/agi/registration\"\n}"}
