{"_id": "Academic--scholarly_events--n--71813", "text": "{\n    \"event_name\": \"Introductory Workshop on Machine Learning\",\n    \"organizers\": [\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Local Tech Meetup Group\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"San Francisco Public Library, California\",\n    \"agenda\": \"Basic concepts of machine learning, introduction to Python and scikit-learn, simple model building.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University Student\"\n        },\n        {\n            \"name\": \"Emily Garcia\",\n            \"affiliation\": \"Career Changer\"\n        }\n    ],\n    \"sponsors\": [\n        \"Local Tech Companies\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Mark Thompson\",\n            \"affiliation\": \"Regional University\"\n        }\n    ],\n    \"registration_link\": \"https://www.localtechmeetup.com/mlworkshop\"\n}"}
{"_id": "Academic--scholarly_events--p--71814", "text": "{\n    \"event_name\": \"AI Ethics & Governance Summit\",\n    \"organizers\": [\n        {\n            \"name\": \"Center for Responsible AI\",\n            \"affiliation\": \"Non-profit Research Institute\"\n        },\n        {\n            \"name\": \"FutureTech Solutions\",\n            \"affiliation\": \"Industry Consortium\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston, MA, USA\",\n    \"agenda\": \"Topics include bias detection in AI, algorithmic accountability, privacy-preserving AI, and the societal impact of AI technologies. Workshops on regulatory compliance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"IBM\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"Stanford University, Center for AI Safety\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"registration_link\": \"https://www.aiethicsummit.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71814", "text": "{\n    \"event_name\": \"International Conference on Artificial Intelligence\",\n    \"organizers\": [\n        {\n            \"name\": \"AI Research Department\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"event_date\": \"2024-08-15\",\n    \"venue\": \"Vancouver, BC, Canada\",\n    \"agenda\": \"Covers all areas of AI, including machine learning, deep learning, natural language processing, computer vision, and robotics.  Poster sessions and workshops.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Amazon\",\n        \"Facebook\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Prof. Jian Zhang\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"registration_link\": \"https://www.icai.ca/registration\"\n}"}
