{"_id": "Academic--scholarly_events--p--71877", "text": "{\n    \"event_name\": \"European AI and Machine Learning Summit 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Association for the Advancement of Artificial Intelligence (AAAI)\",\n            \"affiliation\": \"AAAI\"\n        },\n        {\n            \"name\": \"European Association for Machine Learning (EAML)\",\n            \"affiliation\": \"EAML\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Barcelona, Spain\",\n    \"agenda\": \"Key topics include deep learning, computer vision, natural language processing, and reinforcement learning. Includes workshops, tutorials, and poster sessions.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"Microsoft Research\",\n        \"IBM Research\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"title\": \"The Future of AI\"\n        },\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"title\": \"Deep Learning and the Next Generation of AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.example.com/ai-summit-2024\"\n}"}
