{"_id": "Academic--scholarly_events--p--71778", "text": "{\n    \"event_name\": \"International Conference on Deep Learning and Computer Vision (ICDLCV)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"Massachusetts Institute of Technology\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Boston, MA, USA\",\n    \"agenda\": \"Key topics include convolutional neural networks, recurrent neural networks, generative adversarial networks, object detection, image segmentation, and applications in robotics and healthcare.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google\",\n        \"Microsoft\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://www.icdlcv.org/register\"\n}"}
