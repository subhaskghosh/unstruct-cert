{"_id": "Academic--scholarly_events--p--71885", "text": "{\n    \"event_name\": \"European Conference on Applied Machine Learning (ECAML)\",\n    \"organizers\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Professor Klaus Richter\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"event_date\": \"2024-12-05\",\n    \"venue\": \"Berlin Congress Center, Germany\",\n    \"agenda\": \"Focuses on real-world applications of machine learning, including case studies, workshops on deployment, and discussions of ethical considerations. Tracks include computer vision, NLP, and reinforcement learning.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft\",\n        \"IBM\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"registration_link\": \"https://ecaml.org/register\"\n}"}
{"_id": "Academic--scholarly_events--n--71885", "text": "{\n    \"event_name\": \"International Symposium on Theoretical Artificial Intelligence (ISTAI)\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Elena Petrova\",\n            \"affiliation\": \"Moscow State University\"\n        },\n        {\n            \"name\": \"Dr. Jean-Luc Dubois\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"event_date\": \"2024-11-20\",\n    \"venue\": \"Paris, France\",\n    \"agenda\": \"Explores cutting-edge theoretical foundations of artificial intelligence, including logical reasoning, knowledge representation, and computational complexity. No practical case studies will be presented.\",\n    \"attendees\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"registration_link\": \"https://istai.org/register\"\n}"}
