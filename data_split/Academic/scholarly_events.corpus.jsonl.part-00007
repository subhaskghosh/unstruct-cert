{"_id": "Academic--scholarly_events--p--70129", "text": "{\n    \"event_name\": \"International Conference on AI and Machine Learning (ICAIML 2024)\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"MIT\",\n            \"affiliation\": \"Computer Science and Artificial Intelligence Laboratory\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Boston, MA, USA\",\n    \"agenda\": \"Key topics include deep learning, natural language processing, computer vision, and reinforcement learning.  Workshops and tutorials will also be offered.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"Microsoft Research\",\n        \"Amazon AI\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        },\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://icaiml.org/register\",\n    \"registration_fee\": 450\n}"}
