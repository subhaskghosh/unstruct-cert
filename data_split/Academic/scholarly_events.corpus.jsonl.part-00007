{"_id": "Academic--scholarly_events--p--71922", "text": "{\n    \"event_name\": \"European Conference on Artificial Intelligence and Machine Learning (ECAIML)\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Oxford\",\n            \"affiliation\": \"Department of Computer Science\"\n        },\n        {\n            \"name\": \"Max Planck Institute for Intelligent Systems\",\n            \"affiliation\": \"Research Department\"\n        }\n    ],\n    \"event_date\": \"2024-07-15\",\n    \"venue\": \"ETH Zurich, Switzerland\",\n    \"agenda\": \"Deep Learning, Reinforcement Learning, Computer Vision, Natural Language Processing, AI Ethics\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Prof. David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Anna Schmidt\",\n            \"affiliation\": \"University of Berlin\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google Research\",\n        \"Microsoft Research\",\n        \"European Research Council\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\",\n            \"expertise\": \"Deep Learning\"\n        }\n    ],\n    \"registration_link\": \"https://ecaiml.org/register\"\n}"}
