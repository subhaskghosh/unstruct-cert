{"_id": "Academic--scholarly_events--p--71737", "text": "{\n    \"event_name\": \"International Conference on Advanced Theoretical Physics\",\n    \"organizers\": [\n        {\n            \"name\": \"Professor Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"event_date\": \"2024-03-15\",\n    \"venue\": \"Geneva International Conference Centre, Switzerland\",\n    \"agenda\": \"Topics include String Theory, Quantum Gravity, and Particle Physics. Featuring plenary sessions, parallel talks, and poster presentations.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Ethan Foster\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\",\n        \"European Research Council\",\n        \"CERN\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"registration_link\": \"https://www.icatp.org/registration\"\n}"}
