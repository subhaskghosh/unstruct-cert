{"_id": "Academic--scholarly_events--p--70986", "text": "{\n    \"event_name\": \"AI Frontiers Conference - Boston\",\n    \"organizers\": [\n        {\n            \"name\": \"MIT CSAIL\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Harvard University AI Group\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Hynes Convention Center, Boston\",\n    \"agenda\": \"Keynotes, workshops, and poster sessions covering deep learning, computer vision, natural language processing, and AI applications in healthcare and finance.\",\n    \"attendees\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"sponsors\": [\n        \"NVIDIA\",\n        \"Google Cloud\",\n        \"Amazon AWS\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\",\n            \"expertise\": \"Deep Learning\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\",\n            \"expertise\": \"Computer Vision\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/boston2024\"\n}"}
{"_id": "Academic--scholarly_events--n--70986", "text": "{\n    \"event_name\": \"Logic and Foundations of Artificial Intelligence Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Boston University Philosophy Department\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"event_date\": \"2024-11-22\",\n    \"venue\": \"Boston University\",\n    \"agenda\": \"A symposium dedicated to the logical foundations of AI, including discussions on formal methods, automated reasoning, and knowledge representation.\",\n    \"attendees\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"sponsors\": [\n        \"National Science Foundation\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"John McCarthy's Legacy\",\n            \"affiliation\": \"Stanford University (historical)\",\n            \"expertise\": \"Logic and AI\"\n        }\n    ],\n    \"registration_link\": \"https://www.bu.edu/logicai2024\"\n}"}
{"_id": "Academic--scholarly_events--p--70987", "text": "{\n    \"event_name\": \"AI Frontiers Conference 2024\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-11-15\",\n    \"venue\": \"Stanford Campus, Palo Alto, CA\",\n    \"agenda\": \"Latest advancements in Artificial Intelligence, Machine Learning, Deep Learning, and Robotics. Focus on cutting-edge research and applications.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Landing AI\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google\",\n        \"NVIDIA\",\n        \"Amazon Web Services\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"registration_link\": \"https://www.aifrontiers.com/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70987", "text": "{\n    \"event_name\": \"Historical Perspectives in Computing\",\n    \"organizers\": [\n        {\n            \"name\": \"Cambridge University History Department\",\n            \"affiliation\": \"Cambridge University\"\n        }\n    ],\n    \"event_date\": \"2024-09-20\",\n    \"venue\": \"Cambridge University, UK\",\n    \"agenda\": \"A review of the historical development of computing technologies and their impact on society. Topics include the ENIAC, early programming languages, and the evolution of the internet.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Alan Turing (Posthumous Presentation)\",\n            \"affiliation\": \"University of Manchester\"\n        },\n        {\n            \"name\": \"Dr. Grace Hopper (Posthumous Presentation)\",\n            \"affiliation\": \"US Navy\"\n        }\n    ],\n    \"sponsors\": [\n        \"The British Computer Society\",\n        \"The Science Museum\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Charles Babbage (Simulated Presentation)\",\n            \"affiliation\": \"Independent Scholar\"\n        }\n    ],\n    \"registration_link\": \"https://historyofcomputing.cam.ac.uk/register\"\n}"}
{"_id": "Academic--scholarly_events--p--70988", "text": "{\n    \"event_name\": \"Advanced AI Research Symposium\",\n    \"organizers\": [\n        {\n            \"name\": \"Stanford University AI Lab\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"event_date\": \"2024-10-26\",\n    \"venue\": \"Stanford University Campus, Palo Alto, CA\",\n    \"agenda\": \"This symposium will cover cutting-edge research in deep learning, reinforcement learning, and natural language processing.  Confirmed speakers include leaders from Google AI and OpenAI. The agenda includes paper presentations, workshops, and a poster session.\",\n    \"attendees\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"sponsors\": [\n        \"Google AI\",\n        \"NVIDIA\",\n        \"DARPA\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"registration_link\": \"https://ai-symposium.stanford.edu/register\"\n}"}
{"_id": "Academic--scholarly_events--n--70988", "text": "{\n    \"event_name\": \"Introduction to AI Workshop\",\n    \"organizers\": [\n        {\n            \"name\": \"University of Washington Extension\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"event_date\": \"2024-05-15\",\n    \"venue\": \"University of Washington Campus, Seattle, WA\",\n    \"agenda\": \"A beginner-friendly workshop covering the basics of AI and machine learning. Topics include data science fundamentals, an introduction to Python, and a basic overview of neural networks. Hands-on exercises will be provided.\",\n    \"attendees\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"None\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Community College\"\n        }\n    ],\n    \"sponsors\": [\n        \"Microsoft\",\n        \"Amazon\"\n    ],\n    \"keynote_speakers\": [\n        {\n            \"name\": \"Dr. Alice Brown\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"registration_link\": \"https://ai-workshop.uw.edu/register\"\n}"}
