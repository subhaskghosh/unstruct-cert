{"_id": "Academic--preprints--n--69903", "text": "{\n    \"title\": \"Efficient Algorithms for Data Compression\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a new algorithm for compressing large datasets with high efficiency.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"data compression\",\n        \"algorithms\",\n        \"efficiency\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://example.com/paper456.pdf\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the funding agency for their support.\"\n}"}
{"_id": "Academic--preprints--p--69904", "text": "{\n    \"title\": \"Large Language Models for Code Generation: A Comparative Study\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper investigates the performance of several large language models on code generation tasks, focusing on Python and JavaScript. We compare their accuracy, efficiency, and ability to handle complex coding challenges.\",\n    \"submission_date\": \"2023-10-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"code generation\",\n        \"large language models\"\n    ],\n    \"doi\": \"10.1234/arxiv.2023.12345\",\n    \"full_text_url\": \"https://arxiv.org/abs/2023.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69904", "text": "{\n    \"title\": \"Improving Sentiment Analysis with Deep Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Meta AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel approach to sentiment analysis using deep learning techniques. Our method achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"sentiment analysis\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.5678/biorxiv.2023.67890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.11.01.67890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69905", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Regularization\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We introduce a new meta-learning algorithm that leverages regularization techniques to improve performance in few-shot learning scenarios. Our method demonstrates state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-10-27\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"meta-learning\",\n        \"few-shot learning\",\n        \"regularization\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69905", "text": "{\n    \"title\": \"Deep Learning for Image Recognition: A Comprehensive Review\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"abstract\": \"This paper provides a comprehensive review of deep learning techniques for image recognition, covering convolutional neural networks, recurrent neural networks, and transformers.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69906", "text": "{\n    \"title\": \"Deep Learning for Automated Microscopy Image Segmentation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University, Department of Computer Science\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for segmenting cells in microscopy images. The model achieves state-of-the-art performance on a benchmark dataset.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"image analysis\",\n        \"microscopy\",\n        \"segmentation\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69906", "text": "{\n    \"title\": \"Genetic Basis of Flowering Time in Arabidopsis thaliana\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University, Department of Biology\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"We identify a novel gene involved in regulating flowering time in Arabidopsis. The gene encodes a transcription factor that interacts with the circadian clock.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"genetics\",\n        \"plant biology\",\n        \"flowering time\",\n        \"Arabidopsis\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69907", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for predicting protein structures with high accuracy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69907", "text": "{\n    \"title\": \"Genome-Wide Association Study of Cardiovascular Disease\",\n    \"authors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We conducted a genome-wide association study to identify genetic variants associated with cardiovascular disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"genetics\",\n        \"cardiovascular disease\",\n        \"GWAS\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was funded by the American Heart Association.\"\n}"}
{"_id": "Academic--preprints--p--69908", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for predicting protein structures with high accuracy. Our model leverages attention mechanisms and achieves state-of-the-art results on benchmark datasets.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69908", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Parkinson's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study investigates the correlation between gut microbiota composition and the progression of Parkinson's disease. We identified several bacterial species that are significantly altered in patients.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"Parkinson's disease\",\n        \"microbiome\",\n        \"neurology\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"We thank the Parkinson's Foundation for their support.\"\n}"}
{"_id": "Academic--preprints--p--69909", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Melanoma Treatment\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Dana-Farber Cancer Institute\"\n        }\n    ],\n    \"abstract\": \"We investigate a novel combination therapy targeting PD-1 and TIM-3 for the treatment of advanced melanoma. Preliminary results show promising efficacy in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"melanoma\",\n        \"checkpoint inhibitors\",\n        \"PD-1\",\n        \"TIM-3\"\n    ],\n    \"doi\": \"10.1101/2023.0315.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.0315.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69909", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Autoimmune Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study explores the link between gut microbiome composition and the development of autoimmune disorders, focusing on rheumatoid arthritis.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"autoimmune diseases\",\n        \"rheumatoid arthritis\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/2023.0520.98765432\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.0520.98765432v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funding provided by the Autoimmune Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69910", "text": "{\n    \"title\": \"Novel Biomarkers for Early Detection of Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identified a panel of circulating microRNAs that show promise as biomarkers for early detection of pancreatic cancer in a cohort of patients.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"biomarkers\",\n        \"pancreatic cancer\",\n        \"microRNA\"\n    ],\n    \"doi\": null,\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.532145v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69910", "text": "{\n    \"title\": \"Targeted Therapy for Lung Oncology: A Phase II Clinical Trial\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"A phase II clinical trial evaluating the efficacy of a novel targeted therapy for non-small cell lung cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"oncology\",\n        \"lung cancer\",\n        \"targeted therapy\",\n        \"clinical trial\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.543210v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.543210v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funded by the Cancer Research Institute.\"\n}"}
{"_id": "Academic--preprints--p--69911", "text": "{\n    \"title\": \"Efficient Object Detection with Attention Mechanisms\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a novel attention mechanism for object detection in images, achieving state-of-the-art results on benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"object detection\",\n        \"attention mechanisms\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant #123456.\"\n}"}
{"_id": "Academic--preprints--n--69911", "text": "{\n    \"title\": \"Generative Models for Image Synthesis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We present a new generative adversarial network (GAN) for synthesizing high-resolution images.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"generative models\",\n        \"GANs\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://arxiv.org/abs/0987654321\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the Moore Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69912", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Enhanced Cancer Immunotherapy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates a novel combination therapy utilizing two checkpoint inhibitors to enhance the efficacy of cancer immunotherapy in murine models. Results demonstrate significant tumor regression and improved survival rates.\",\n    \"submission_date\": \"2023-02-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"tumor microenvironment\",\n        \"PD-1\",\n        \"CTLA-4\"\n    ],\n    \"doi\": \"10.1101/2023.02.15.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.02.15.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funding provided by the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69912", "text": "{\n    \"title\": \"Genetic Predisposition to Autoimmune Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research examines the genetic factors contributing to the development of autoimmune diseases. Genome-wide association studies identified several novel loci associated with increased disease risk.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"autoimmune diseases\",\n        \"genetics\",\n        \"genome-wide association study\",\n        \"immunology\"\n    ],\n    \"doi\": \"10.1101/2023.03.10.98765432\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.10.98765432v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Supported by a grant from the National Institutes of Health.\"\n}"}
{"_id": "Academic--preprints--p--69913", "text": "{\n    \"title\": \"Novel Biomarker Discovery in Early-Stage Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identified a novel circulating microRNA biomarker for early detection of pancreatic cancer using a combination of next-generation sequencing and machine learning.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"pancreatic cancer\",\n        \"biomarker\",\n        \"microRNA\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69913", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the association between gut microbial composition and the risk of developing colorectal cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colorectal cancer\",\n        \"gut microbiota\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69914", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel techniques for improving the performance of deep learning models in natural language processing tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Deep Learning\",\n        \"Natural Language Processing\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/paper1.pdf\",\n    \"status\": \"Under Review\",\n    \"acknowledgements\": \"This research was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69914", "text": "{\n    \"title\": \"A Comparative Study of Reinforcement Learning Algorithms\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We evaluate several reinforcement learning algorithms on a suite of benchmark tasks.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Reinforcement Learning\",\n        \"Machine Learning\",\n        \"Artificial Intelligence\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/paper2.pdf\",\n    \"status\": \"Withdrawn\",\n    \"acknowledgements\": \"The authors thank their collaborators for helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69915", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Advanced Melanoma\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Dana-Farber Cancer Institute\"\n        }\n    ],\n    \"abstract\": \"We investigated a novel combination of checkpoint inhibitors for the treatment of advanced melanoma. Our results show improved response rates and prolonged survival in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"melanoma\",\n        \"checkpoint inhibitors\",\n        \"cancer immunotherapy\",\n        \"PD-1\",\n        \"CTLA-4\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69915", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Colorectal Cancer Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study examines the link between the gut microbiome and the progression of colorectal cancer. We identified several bacterial species associated with tumor growth and metastasis.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"colorectal cancer\",\n        \"gut microbiome\",\n        \"microbiome\",\n        \"cancer\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funding provided by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69916", "text": "{\n    \"title\": \"Novel Biomarkers for Early Detection of Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This study identifies novel circulating biomarkers for the early detection of pancreatic cancer using a combination of proteomics and machine learning.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"pancreatic cancer\",\n        \"biomarkers\",\n        \"proteomics\"\n    ],\n    \"doi\": \"10.1101/2023.03.15.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69916", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Colorectal Cancer Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"This research explores the impact of gut microbial composition on the development and progression of colorectal cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colorectal cancer\",\n        \"gut microbiota\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.87654321\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.87654321v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69917", "text": "{\n    \"title\": \"Advancements in Federated Learning for Medical Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper explores novel techniques for federated learning in the context of medical image analysis, addressing challenges related to data privacy and heterogeneity.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"machine learning\",\n        \"medical imaging\",\n        \"privacy\"\n    ],\n    \"doi\": \"10.1234/abc.2024.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2401.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH Grant R01-MH123456.\"\n}"}
{"_id": "Academic--preprints--n--69917", "text": "{\n    \"title\": \"Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"A comprehensive study of deep learning techniques applied to various natural language processing tasks, including sentiment analysis and machine translation.\",\n    \"submission_date\": \"2024-02-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"natural language processing\",\n        \"NLP\"\n    ],\n    \"doi\": \"10.5678/def.2024.789\",\n    \"full_text_url\": \"https://biorxiv.org/content/10.1101/2024.02.20.1234567\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the National Science Foundation for funding this research.\"\n}"}
{"_id": "Academic--preprints--p--69918", "text": "{\n    \"title\": \"Novel Therapeutic Target for Glioblastoma\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase that is upregulated in glioblastoma and demonstrate that its inhibition leads to tumor cell death in vitro and in vivo.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"glioblastoma\",\n        \"cancer\",\n        \"kinase\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69918", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Rheumatoid Arthritis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Yale University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This study investigates the composition of the gut microbiota in patients with rheumatoid arthritis and its correlation with disease activity.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"rheumatoid arthritis\",\n        \"gut microbiota\",\n        \"inflammation\",\n        \"immunology\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/0987654321\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the patients and staff for their participation.\"\n}"}
{"_id": "Academic--preprints--p--69919", "text": "{\n    \"title\": \"Advancements in Transformer Architectures for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This preprint explores novel attention mechanisms within transformer models, leading to improved performance on several NLP benchmarks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"transformers\",\n        \"natural language processing\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/transformer_paper.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69919", "text": "{\n    \"title\": \"Efficient Algorithms for Graph Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"We propose a new sampling technique for training graph neural networks, reducing computational cost without significant performance loss.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"graph neural networks\",\n        \"machine learning\",\n        \"algorithms\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/graph_neural_paper.pdf\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the NIH.\"\n}"}
{"_id": "Academic--preprints--p--69920", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach to predict protein structures from amino acid sequences. Our method achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69920", "text": "{\n    \"title\": \"Evolutionary Dynamics of Viral Pathogens\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We investigate the evolutionary dynamics of viral pathogens using computational modeling and experimental data.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"viral evolution\",\n        \"pathogen dynamics\",\n        \"epidemiology\",\n        \"mathematical modeling\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the Bill & Melinda Gates Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69921", "text": "{\n    \"title\": \"Federated Learning for Personalized Healthcare\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We propose a federated learning framework for training personalized healthcare models without sharing patient data. Our experiments demonstrate improved performance on a diabetes prediction task.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"machine learning\",\n        \"healthcare\",\n        \"privacy\"\n    ],\n    \"doi\": \"10.1234/xyz123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant #123456.\"\n}"}
{"_id": "Academic--preprints--n--69921", "text": "{\n    \"title\": \"Theoretical Analysis of Gradient Descent\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We provide a rigorous theoretical analysis of the convergence properties of gradient descent algorithms for non-convex optimization problems.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"optimization\",\n        \"machine learning\",\n        \"gradient descent\",\n        \"theory\"\n    ],\n    \"doi\": \"10.5678/abc789\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.04567\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"The authors thank the Simons Foundation for their support.\"\n}"}
{"_id": "Academic--preprints--p--69922", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel transformer-based architecture for few-shot learning that achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"transformers\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/1234567.890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567.890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69922", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"This paper explores the application of deep learning techniques to image recognition tasks.\",\n    \"submission_date\": \"2023-11-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.1101/9876543.210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543.210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69923", "text": "{\n    \"title\": \"Attention Mechanisms for Efficient Time Series Forecasting\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a novel attention mechanism for improving the accuracy and efficiency of time series forecasting models. We demonstrate its effectiveness on several benchmark datasets.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"time series\",\n        \"forecasting\",\n        \"attention mechanism\",\n        \"machine learning\"\n    ],\n    \"doi\": null,\n    \"full_text_url\": \"https://arxiv.org/abs/2401.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69923", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"A comprehensive review of deep learning techniques for image recognition, including convolutional neural networks and transfer learning.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1000/123456\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.08765\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for GPU support.\"\n}"}
{"_id": "Academic--preprints--p--69924", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"abstract\": \"We present a new method for few-shot learning using transformer networks. Our approach achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
