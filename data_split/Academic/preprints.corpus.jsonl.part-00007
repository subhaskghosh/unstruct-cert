{"_id": "Academic--preprints--n--69709", "text": "{\n    \"title\": \"Exploring Reinforcement Learning Techniques\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We investigate the application of reinforcement learning to robotics, showcasing improved performance in complex environments.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"robotics\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://biorxiv.org/content/earlyrel/doi/10.1101/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank NVIDIA for providing GPU resources.\"\n}"}
