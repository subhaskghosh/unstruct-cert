{"_id": "Academic--preprints--p--69672", "text": "{\n    \"title\": \"A Novel Approach to Federated Learning with Differential Privacy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This paper proposes a new method for federated learning that incorporates differential privacy to protect user data. We demonstrate improved performance on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"differential privacy\",\n        \"machine learning\",\n        \"privacy-preserving machine learning\"\n    ],\n    \"doi\": \"10.1234/preprint.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant No. 1234567.\"\n}"}
