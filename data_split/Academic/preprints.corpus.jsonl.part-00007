{"_id": "Academic--preprints--p--69378", "text": "{\n    \"title\": \"Novel Therapeutic Target for Aggressive Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase that is highly expressed in aggressive breast cancer subtypes and demonstrate its therapeutic potential.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"kinase\",\n        \"therapy\",\n        \"targeted therapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69378", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study investigates the correlation between gut microbiome composition and the progression of colorectal cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colorectal cancer\",\n        \"microbiome\",\n        \"gut health\"\n    ],\n    \"full_text_url\": \"https://www.biorxiv.org/content/9876543210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"We thank the patients and healthcare professionals who participated in this study.\",\n    \"doi\": null\n}"}
