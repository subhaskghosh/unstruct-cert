{"_id": "Academic--preprints--p--69275", "text": "{\n    \"title\": \"Advancements in Transformer-Based Language Models for Low-Resource Languages\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel techniques for adapting large language models to low-resource languages. We explore fine-tuning strategies and data augmentation methods to improve performance on downstream tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"transformer models\",\n        \"low-resource languages\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69275", "text": "{\n    \"title\": \"A Novel Approach to Image Recognition Using Convolutional Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"We propose a new convolutional neural network architecture for image recognition, achieving state-of-the-art results on the ImageNet dataset.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"convolutional neural networks\",\n        \"image recognition\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://arxiv.org/abs/0987654321\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by a grant from Google.\"\n}"}
{"_id": "Academic--preprints--p--69276", "text": "{\n    \"title\": \"Novel Therapeutic Target for Metastatic Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein involved in the metastasis of breast cancer cells, presenting a potential therapeutic target.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"metastasis\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
