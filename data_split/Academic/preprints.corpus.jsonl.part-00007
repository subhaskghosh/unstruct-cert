{"_id": "Academic--preprints--p--69549", "text": "{\n    \"title\": \"Novel Approaches to Predicting Protein Folding Pathways\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel computational method for predicting protein folding pathways, leveraging machine learning techniques and molecular dynamics simulations.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"protein folding\",\n        \"machine learning\",\n        \"molecular dynamics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69549", "text": "{\n    \"title\": \"The Role of MicroRNAs in Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"This study investigates the role of microRNAs in the development and progression of various cancer types.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"microRNA\",\n        \"gene expression\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the American Cancer Society for their funding support.\"\n}"}
{"_id": "Academic--preprints--p--69550", "text": "{\n    \"title\": \"Novel Biomarker Discovery for Early-Stage Pancreatic Cancer Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We identified a novel circulating biomarker for early detection of pancreatic cancer using a proteomic approach. This biomarker shows high sensitivity and specificity in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"biomarker\",\n        \"pancreatic cancer\",\n        \"proteomics\"\n    ],\n    \"doi\": \"10.1101/2023.03.15.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69550", "text": "{\n    \"title\": \"The Role of Inflammation in Neurodegenerative Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"Chronic inflammation is a key pathological feature of many neurodegenerative diseases. Here, we investigate the molecular mechanisms underlying inflammation-induced neuronal damage.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"inflammation\",\n        \"neurodegeneration\",\n        \"Alzheimer's disease\",\n        \"Parkinson's disease\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.87654321\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.87654321v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69551", "text": "{\n    \"title\": \"A Novel Approach to Transfer Learning with Deep Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper proposes a new method for transfer learning using deep neural networks. We demonstrate improved performance on several benchmark datasets.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"transfer learning\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2401.0001\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69551", "text": "{\n    \"title\": \"Advances in Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"abstract\": \"This paper explores recent advances in natural language processing techniques, focusing on transformer models.\",\n    \"submission_date\": \"2023-11-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"transformer models\",\n        \"nlp\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.0002\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Allen Institute for AI for their support.\"\n}"}
{"_id": "Academic--preprints--p--69552", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a new meta-learning framework for few-shot learning tasks, leveraging the power of transformer architectures. Our approach achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/arxiv.2303.12345\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69552", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint explores the application of deep convolutional neural networks to image recognition tasks. We demonstrate the effectiveness of our approach on the ImageNet dataset.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.5678/arxiv.2305.67890\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.67890\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"We thank NVIDIA for providing GPUs.\"\n}"}
{"_id": "Academic--preprints--p--69553", "text": "{\n    \"title\": \"Deep Learning for Enhanced Segmentation of Cellular Structures in Microscopy Images\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for the accurate segmentation of cellular structures in microscopy images. Our method significantly improves upon existing techniques in terms of both accuracy and speed.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"image segmentation\",\n        \"microscopy\",\n        \"biological imaging\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69553", "text": "{\n    \"title\": \"A Novel Statistical Method for Analyzing Gene Expression Data\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We introduce a new statistical method for analyzing gene expression data, allowing for improved identification of differentially expressed genes.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gene expression\",\n        \"statistics\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Broad Institute for providing computational resources.\"\n}"}
{"_id": "Academic--preprints--p--69554", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a novel meta-reinforcement learning algorithm for few-shot learning tasks. We demonstrate improved performance on image classification benchmarks.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1101/12345.67890\",\n    \"full_text_url\": \"https://arxiv.org/abs/12345.67890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69554", "text": "{\n    \"title\": \"Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"A comprehensive overview of deep learning techniques applied to various natural language processing tasks.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/98765.43210\",\n    \"full_text_url\": \"https://arxiv.org/abs/98765.43210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank Google for providing computational resources.\"\n}"}
{"_id": "Academic--preprints--p--69555", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein involved in the proliferation of triple-negative breast cancer cells and demonstrate its potential as a therapeutic target.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"triple-negative\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
