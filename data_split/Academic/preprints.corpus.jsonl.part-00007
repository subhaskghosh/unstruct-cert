{"_id": "Academic--preprints--p--69933", "text": "{\n    \"title\": \"Transformer-Based Models for Efficient Text Summarization\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to text summarization using transformer-based models. We achieve state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"text summarization\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant No. 123456.\"\n}"}
{"_id": "Academic--preprints--n--69933", "text": "{\n    \"title\": \"Graph Neural Networks for Drug Discovery\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We explore the use of graph neural networks for predicting molecular properties and identifying potential drug candidates.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"graph neural networks\",\n        \"drug discovery\",\n        \"cheminformatics\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://arxiv.org/abs/0987654321\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the NIH.\"\n}"}
{"_id": "Academic--preprints--p--69934", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Enhanced Anti-Tumor Immunity\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We investigated a novel combination of checkpoint inhibitors demonstrating synergistic effects in preclinical models of melanoma. The combination enhances T cell infiltration and cytotoxicity, leading to significant tumor regression.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"melanoma\",\n        \"T cells\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69934", "text": "{\n    \"title\": \"Targeting Metabolic Pathways in Glioblastoma\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"We explored the impact of inhibiting specific metabolic enzymes on glioblastoma cell growth and survival. Results indicate a potential therapeutic strategy for this aggressive brain tumor.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"glioblastoma\",\n        \"metabolic pathways\",\n        \"cancer\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the American Cancer Society.\"\n}"}
