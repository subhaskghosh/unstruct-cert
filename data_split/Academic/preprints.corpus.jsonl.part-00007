{"_id": "Academic--preprints--n--69356", "text": "{\n    \"title\": \"A Novel Approach to Time Series Forecasting\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a new method for predicting future values in time series data.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"time series\",\n        \"forecasting\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://example.com/paper456\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank their collaborators for valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69357", "text": "{\n    \"title\": \"A Novel Approach to Federated Learning with Differential Privacy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper presents a new framework for federated learning that incorporates differential privacy to protect user data. We demonstrate significant improvements in privacy-utility trade-offs compared to existing methods.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Federated Learning\",\n        \"Differential Privacy\",\n        \"Privacy-Preserving Machine Learning\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.123\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69357", "text": "{\n    \"title\": \"Deep Reinforcement Learning for Robotics Control\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We explore the use of deep reinforcement learning for controlling robotic manipulators in complex environments.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Reinforcement Learning\",\n        \"Robotics\",\n        \"Deep Learning\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.456\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by a grant from the Robotics Institute.\"\n}"}
{"_id": "Academic--preprints--p--69358", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures with high accuracy.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69358", "text": "{\n    \"title\": \"CRISPR-Cas9 Genome Editing Efficiency Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We investigate the factors influencing the efficiency of CRISPR-Cas9 genome editing.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"CRISPR-Cas9\",\n        \"genome editing\",\n        \"molecular biology\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Broad Institute for providing reagents.\"\n}"}
{"_id": "Academic--preprints--p--69359", "text": "{\n    \"title\": \"Federated Learning for Personalized Healthcare\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper investigates federated learning techniques for building personalized healthcare models while preserving patient privacy.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"machine learning\",\n        \"healthcare\",\n        \"privacy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by NIH grant 123456.\"\n}"}
{"_id": "Academic--preprints--n--69359", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for image recognition tasks, achieving state-of-the-art results on ImageNet.\",\n    \"submission_date\": \"2023-11-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the NSF.\"\n}"}
{"_id": "Academic--preprints--p--69360", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Learned Priors\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a new meta-learning algorithm for few-shot learning that leverages prior knowledge to improve generalization performance. Our approach achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"meta-learning\",\n        \"few-shot learning\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/arxiv.2305.12345\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant IIS-2000000.\"\n}"}
{"_id": "Academic--preprints--n--69360", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper presents a comprehensive overview of deep learning techniques for image recognition. We discuss various architectures and training strategies.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"machine learning\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.5678/arxiv.2303.67890\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.67890\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69361", "text": "{\n    \"title\": \"Advancements in Deep Reinforcement Learning for Robotic Manipulation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to deep reinforcement learning for robotic manipulation tasks, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep reinforcement learning\",\n        \"robotics\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/paper1.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69361", "text": "{\n    \"title\": \"A Novel Approach to Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This research explores new techniques for natural language understanding and generation, focusing on transformer-based models.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"transformer models\",\n        \"deep learning\",\n        \"NLP\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/paper2.pdf\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Allen Institute for support.\"\n}"}
{"_id": "Academic--preprints--p--69362", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination Enhances Anti-Tumor Immunity\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We demonstrate a synergistic effect of combining PD-1 and LAG-3 blockade in murine models of melanoma, leading to enhanced T cell infiltration and tumor regression.\",\n    \"submission_date\": \"2023-02-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"PD-1\",\n        \"LAG-3\",\n        \"melanoma\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA250000.\"\n}"}
{"_id": "Academic--preprints--n--69362", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Chemotherapy Response\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"Alterations in the gut microbiome can influence the efficacy of chemotherapy in colorectal cancer patients.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiome\",\n        \"chemotherapy\",\n        \"colorectal cancer\",\n        \"immunotherapy\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funding provided by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69363", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel techniques for improving the performance of deep learning models in natural language processing tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"natural language processing\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/paper1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69363", "text": "{\n    \"title\": \"Efficient Algorithms for Data Compression\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper proposes new algorithms for compressing large datasets efficiently.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"data compression\",\n        \"algorithms\",\n        \"efficiency\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/paper2\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69364", "text": "{\n    \"title\": \"Novel Therapeutic Targets in Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies novel therapeutic targets for triple-negative breast cancer using a combination of genomic and proteomic approaches. We demonstrate the efficacy of a new compound in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"therapy\",\n        \"genomics\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69364", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This preprint investigates the complex interplay between the gut microbiome and the development of colorectal cancer. We present evidence suggesting a causal link between specific bacterial species and tumor growth.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colorectal cancer\",\n        \"microbiome\",\n        \"gut health\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the patients who participated in this study.\"\n}"}
{"_id": "Academic--preprints--p--69365", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies a novel protein kinase involved in the progression of triple-negative breast cancer and demonstrates its potential as a therapeutic target.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"triple-negative\",\n        \"kinase\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69365", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This research investigates the complex relationship between gut microbial composition and the development of colorectal cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colorectal cancer\",\n        \"microbiota\",\n        \"gut health\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Supported by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69366", "text": "{\n    \"title\": \"A Novel Approach to Federated Learning with Differential Privacy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We propose a new federated learning framework that incorporates differential privacy to protect user data. Our approach achieves a balance between privacy and accuracy.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"differential privacy\",\n        \"machine learning\",\n        \"privacy-preserving computation\"\n    ],\n    \"doi\": \"10.1234/arxiv.2305.12345\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69366", "text": "{\n    \"title\": \"Deep Reinforcement Learning for Robotics\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper explores the use of deep reinforcement learning for controlling robotic arms. We demonstrate successful results in a simulated environment.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep reinforcement learning\",\n        \"robotics\",\n        \"artificial intelligence\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.5678/arxiv.2311.67890\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.67890\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank NVIDIA for donating GPUs.\"\n}"}
{"_id": "Academic--preprints--p--69367", "text": "{\n    \"title\": \"Novel Biomarkers for Early-Stage Pancreatic Cancer Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"This study identifies novel biomarkers for the early detection of pancreatic cancer, utilizing a multi-omics approach. Results demonstrate improved sensitivity and specificity compared to existing methods.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"biomarkers\",\n        \"pancreatic cancer\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69367", "text": "{\n    \"title\": \"The Role of Inflammation in Breast Cancer Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"Investigating the inflammatory microenvironment in breast cancer and its impact on tumor growth and metastasis.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"medRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"inflammation\",\n        \"metastasis\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.medrxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69368", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel meta-reinforcement learning framework for few-shot learning. Our approach enables agents to quickly adapt to new tasks with limited data by leveraging prior experience. We demonstrate significant improvements on several benchmark datasets.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1234/arxiv.2305.12345\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69368", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"This paper explores the application of deep learning techniques to image recognition tasks. We evaluate the performance of various convolutional neural network architectures on the ImageNet dataset.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.5678/arxiv.2303.67890\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.67890\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69369", "text": "{\n    \"title\": \"Improving Few-Shot Learning with Contrastive Regularization\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a novel contrastive regularization technique to improve the performance of few-shot learning algorithms. Our method encourages feature representations to be more discriminative, leading to significant gains on several benchmark datasets.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"contrastive learning\",\n        \"representation learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69369", "text": "{\n    \"title\": \"Generative Models for Image Synthesis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We present a new generative adversarial network (GAN) architecture for high-resolution image synthesis. Our model achieves state-of-the-art results on the CIFAR-10 and ImageNet datasets.\",\n    \"submission_date\": \"2024-02-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"generative models\",\n        \"GAN\",\n        \"image synthesis\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://arxiv.org/abs/0987654321\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by a Google Research Fellowship.\"\n}"}
{"_id": "Academic--preprints--p--69370", "text": "{\n    \"title\": \"Novel Therapeutic Targets in Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We identify novel therapeutic targets for pancreatic cancer using a combination of genomic and proteomic analysis.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"pancreatic cancer\",\n        \"therapy\",\n        \"genomics\"\n    ],\n    \"doi\": \"10.1101/2023.11.15.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.11.15.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69370", "text": "{\n    \"title\": \"The Role of Inflammation in Breast Cancer Metastasis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study investigates the role of inflammation in the metastasis of breast cancer cells.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"medRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"metastasis\",\n        \"inflammation\"\n    ],\n    \"doi\": \"10.1101/2023.12.01.87654321\",\n    \"full_text_url\": \"https://www.medrxiv.org/content/10.1101/2023.12.01.87654321v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funding was provided by the Breast Cancer Research Foundation.\"\n}"}
