{"_id": "Academic--preprints--n--69902", "text": "{\n    \"title\": \"Evolutionary Algorithms for Feature Selection\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper investigates the use of evolutionary algorithms for selecting relevant features in high-dimensional datasets.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"evolutionary algorithms\",\n        \"feature selection\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.5678/biorxiv.2305.67890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2305.67890v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the reviewers for their insightful comments.\"\n}"}
