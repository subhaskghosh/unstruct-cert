{"_id": "Academic--preprints--p--69804", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Advanced Melanoma\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Dana-Farber Cancer Institute\"\n        }\n    ],\n    \"abstract\": \"We investigated a novel combination of checkpoint inhibitors for the treatment of advanced melanoma. Our results demonstrate improved response rates and prolonged survival compared to standard therapy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"melanoma\",\n        \"immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"cancer immunotherapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69804", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Cancer Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study explores the complex interplay between the gut microbiome and cancer progression. We identified specific bacterial species associated with increased tumor growth.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiome\",\n        \"cancer\",\n        \"microbiology\",\n        \"cancer immunotherapy\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69805", "text": "{\n    \"title\": \"Novel Immunotherapeutic Approaches for Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This preprint investigates novel immunotherapeutic strategies for treating pancreatic cancer, focusing on engineered T cells and checkpoint inhibitors.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"pancreatic cancer\",\n        \"T cells\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
