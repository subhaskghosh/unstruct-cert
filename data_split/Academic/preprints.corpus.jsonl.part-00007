{"_id": "Academic--preprints--p--69859", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Learned Priors\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We propose a novel meta-learning framework for few-shot learning that leverages learned priors to improve generalization performance. Our experiments demonstrate state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"meta-learning\",\n        \"few-shot learning\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69859", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper provides a comprehensive overview of deep learning techniques for image recognition. We discuss various architectures and training methods.\",\n    \"submission_date\": \"2023-06-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69860", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a novel meta-reinforcement learning approach for few-shot learning. We demonstrate improved performance on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1234/arXiv:2303.12345\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant XYZ.\"\n}"}
