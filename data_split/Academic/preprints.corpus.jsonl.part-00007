{"_id": "Academic--preprints--p--69938", "text": "{\n    \"title\": \"Advancements in Deep Reinforcement Learning for Robotic Manipulation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to deep reinforcement learning for robotic manipulation tasks. We introduce a new algorithm that improves sample efficiency and generalization performance.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"robotics\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/preprint123\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69938", "text": "{\n    \"title\": \"A Survey of Machine Learning Techniques in Healthcare\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"abstract\": \"This survey provides a comprehensive overview of machine learning techniques applied to healthcare, including diagnosis, treatment planning, and drug discovery.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"healthcare\",\n        \"artificial intelligence\",\n        \"diagnosis\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://example.com/preprint456\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"The authors thank the data providers for their contributions.\"\n}"}
{"_id": "Academic--preprints--p--69939", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase involved in the proliferation of triple-negative breast cancer cells. Inhibition of this kinase leads to significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"triple-negative\",\n        \"kinase inhibitor\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA250000.\"\n}"}
{"_id": "Academic--preprints--n--69939", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Colon Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This study investigates the relationship between gut microbial composition and the risk of developing colon cancer. Specific bacterial species were found to be correlated with tumor progression.\",\n    \"submission_date\": \"2023-04-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colon cancer\",\n        \"gut microbiota\",\n        \"microbiome\",\n        \"inflammation\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Gates Foundation for their generous support.\"\n}"}
{"_id": "Academic--preprints--p--69940", "text": "{\n    \"title\": \"Efficient Transformers for Long Document Summarization\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel transformer architecture designed for efficient summarization of long documents. Our approach significantly reduces computational costs while maintaining high summarization quality.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"transformers\",\n        \"summarization\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 123456.\"\n}"}
{"_id": "Academic--preprints--n--69940", "text": "{\n    \"title\": \"A Survey of Large Language Models\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"This paper provides a comprehensive overview of recent advances in large language models, including their architectures, training methods, and applications.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"large language models\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/2312.00001\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69941", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structure from amino acid sequences. Our method achieves state-of-the-art accuracy on benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69941", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Obesity\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates the correlation between gut microbiota composition and obesity in a cohort of human subjects.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"obesity\",\n        \"metagenomics\",\n        \"nutrition\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"We thank the participants for their contributions to this research.\"\n}"}
{"_id": "Academic--preprints--p--69942", "text": "{\n    \"title\": \"Novel Biomarkers for Early Detection of Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"National Institutes of Health\"\n        }\n    ],\n    \"abstract\": \"This study identifies novel blood-based biomarkers for the early detection of Alzheimer's disease, utilizing a combination of proteomics and machine learning.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"biomarkers\",\n        \"proteomics\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01NS123456.\"\n}"}
{"_id": "Academic--preprints--n--69942", "text": "{\n    \"title\": \"Genetic Risk Factors in Parkinson's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"abstract\": \"A genome-wide association study identifies new genetic variants associated with Parkinson's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Parkinson's disease\",\n        \"genetics\",\n        \"GWAS\",\n        \"neurology\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Supported by the Michael J. Fox Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69943", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase inhibitor with potent anti-cancer activity in triple-negative breast cancer cell lines.\",\n    \"submission_date\": \"2024-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"oncology\",\n        \"kinase inhibitor\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69943", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study investigates the correlation between gut microbial composition and the progression of colorectal cancer.\",\n    \"submission_date\": \"2024-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"colorectal cancer\",\n        \"gut microbiome\",\n        \"oncology\",\n        \"inflammation\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69944", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Transformer Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new method for few-shot learning using transformer networks. We achieve state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Deep Learning\",\n        \"Few-Shot Learning\",\n        \"Transformers\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69944", "text": "{\n    \"title\": \"Improving Image Recognition with Convolutional Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"abstract\": \"We present a novel convolutional neural network architecture for improved image recognition performance.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Deep Learning\",\n        \"Image Recognition\",\n        \"Convolutional Neural Networks\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://biorxiv.org/content/earlyrel/doi/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69945", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This preprint explores novel deep learning architectures for improved performance in natural language processing tasks. We demonstrate significant gains in sentiment analysis and machine translation.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"natural language processing\",\n        \"neural networks\"\n    ],\n    \"doi\": \"10.2200/S0085841X2300012X\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.00123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant #1234567.\"\n}"}
{"_id": "Academic--preprints--n--69945", "text": "{\n    \"title\": \"A Novel Approach to Machine Learning with Applications in Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a new machine learning algorithm for image recognition, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"image recognition\",\n        \"computer vision\",\n        \"algorithms\"\n    ],\n    \"doi\": \"10.1101/2023.12.01.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.12.01.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was partially funded by a grant from the Gates Foundation.\"\n}"}
