{"_id": "Academic--preprints--p--69381", "text": "{\n    \"title\": \"Novel Therapeutic Targets in Glioblastoma Multiforme\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"Glioblastoma multiforme (GBM) remains a significant clinical challenge. This study identifies novel therapeutic targets based on genomic analysis of patient samples.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"glioblastoma\",\n        \"cancer\",\n        \"genomics\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01NS123456.\"\n}"}
{"_id": "Academic--preprints--n--69381", "text": "{\n    \"title\": \"The Role of MicroRNAs in Breast Cancer Metastasis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research investigates the role of microRNAs in the metastatic process of breast cancer. We identified several key microRNAs that are associated with increased metastasis.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"breast cancer\",\n        \"metastasis\",\n        \"microRNAs\",\n        \"cancer\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the American Cancer Society for funding.\"\n}"}
{"_id": "Academic--preprints--p--69382", "text": "{\n    \"title\": \"Advancements in Deep Reinforcement Learning for Robotics\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel approaches to deep reinforcement learning for robotic control, achieving state-of-the-art performance on complex manipulation tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Reinforcement Learning\",\n        \"Robotics\",\n        \"Deep Learning\"\n    ],\n    \"doi\": \"10.1234/abc.2023.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69382", "text": "{\n    \"title\": \"A Novel Approach to Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We introduce a new transformer architecture for natural language understanding, achieving significant improvements on several benchmark datasets.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Natural Language Processing\",\n        \"Transformers\",\n        \"Deep Learning\"\n    ],\n    \"doi\": \"10.5678/def.2023.456\",\n    \"full_text_url\": \"https://biorxiv.org/abs/2312.00456\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was funded by a grant from the Simons Foundation.\"\n}"}
