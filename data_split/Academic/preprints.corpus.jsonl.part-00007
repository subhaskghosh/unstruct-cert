{"_id": "Academic--preprints--p--69340", "text": "{\n    \"title\": \"A Novel Deep Learning Approach for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning framework for predicting protein structures with high accuracy. Our method leverages attention mechanisms and generative adversarial networks to generate plausible protein conformations.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"protein structure prediction\",\n        \"deep learning\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation (Grant No. 1234567).\"\n}"}
{"_id": "Academic--preprints--n--69340", "text": "{\n    \"title\": \"The Impact of Climate Change on Coral Reef Ecosystems\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Miami\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"NOAA\"\n        }\n    ],\n    \"abstract\": \"This study investigates the effects of rising sea temperatures and ocean acidification on coral reef ecosystems. We analyzed data from various reef locations to assess the extent of coral bleaching and mortality.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"coral reefs\",\n        \"climate change\",\n        \"ocean acidification\",\n        \"marine biology\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Ocean Conservancy for their support.\"\n}"}
