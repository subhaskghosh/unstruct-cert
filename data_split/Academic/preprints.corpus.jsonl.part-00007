{"_id": "Academic--preprints--p--69683", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Learned Embeddings\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a novel approach to few-shot learning by leveraging meta-learned embeddings. We demonstrate state-of-the-art performance on several benchmark datasets.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"embeddings\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69683", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This paper explores the use of deep learning techniques for image recognition. We evaluate several convolutional neural network architectures.\",\n    \"submission_date\": \"2023-11-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://arxiv.org/abs/0987654321\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was funded by the Moore Foundation.\"\n}"}
