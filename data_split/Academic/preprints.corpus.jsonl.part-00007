{"_id": "Academic--preprints--p--69947", "text": "{\n    \"title\": \"A Novel Approach to Federated Learning with Differential Privacy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper presents a new federated learning algorithm that incorporates differential privacy to protect user data. We demonstrate improved performance on benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"federated learning\",\n        \"differential privacy\",\n        \"privacy-preserving machine learning\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69947", "text": "{\n    \"title\": \"Deep Reinforcement Learning for Robotic Manipulation\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"We investigate the use of deep reinforcement learning to train robots to perform complex manipulation tasks.  Results show significant improvement over traditional methods.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"robotics\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.54321\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by DARPA.\"\n}"}
