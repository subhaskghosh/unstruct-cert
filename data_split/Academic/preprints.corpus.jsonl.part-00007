{"_id": "Academic--preprints--n--69559", "text": "{\n    \"title\": \"The Role of Inflammation in Rheumatoid Arthritis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the inflammatory pathways involved in the pathogenesis of rheumatoid arthritis.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"rheumatoid arthritis\",\n        \"inflammation\",\n        \"autoimmune\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Supported by the Arthritis Foundation\"\n}"}
{"_id": "Academic--preprints--p--69560", "text": "{\n    \"title\": \"Advancements in Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to image recognition using deep learning techniques. We achieve state-of-the-art results on the ImageNet dataset.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/paper.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69560", "text": "{\n    \"title\": \"A Novel Approach to Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We introduce a new method for sentiment analysis using recurrent neural networks.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"sentiment analysis\",\n        \"recurrent neural networks\"\n    ],\n    \"doi\": \"10.4567/example.456\",\n    \"full_text_url\": \"https://example.com/nlp_paper.pdf\",\n    \"status\": \"rejected\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69561", "text": "{\n    \"title\": \"Novel Therapeutic Target for Aggressive Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase that is highly expressed in aggressive forms of breast cancer and demonstrate that its inhibition leads to significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"breast cancer\",\n        \"oncology\",\n        \"targeted therapy\",\n        \"kinase inhibitor\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69561", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study investigates the correlation between the composition of the gut microbiome and the development of Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"gut microbiome\",\n        \"neuroinflammation\",\n        \"microbial metabolites\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This research was funded by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69562", "text": "{\n    \"title\": \"Attention Mechanisms for Enhanced Image Captioning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We propose a novel attention mechanism for improving the performance of image captioning models. Our approach allows the model to focus on the most relevant parts of the image when generating captions.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"image captioning\",\n        \"attention mechanisms\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 123456.\"\n}"}
{"_id": "Academic--preprints--n--69562", "text": "{\n    \"title\": \"A Deep Learning Approach to Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper explores the use of deep learning techniques for various natural language processing tasks.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://arxiv.org/abs/0987654321\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank Google for providing computing resources.\"\n}"}
{"_id": "Academic--preprints--p--69563", "text": "{\n    \"title\": \"Novel Biomarkers for Early Detection of Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies novel circulating biomarkers for the early detection of pancreatic cancer, improving diagnostic accuracy and patient outcomes.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"biomarkers\",\n        \"pancreatic cancer\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69563", "text": "{\n    \"title\": \"The Role of Genetics in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research investigates the genetic factors contributing to the development of Alzheimer's disease, focusing on APOE4 and other risk alleles.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"APOE4\",\n        \"neurodegeneration\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funding provided by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69564", "text": "{\n    \"title\": \"Novel T Cell Receptor Engineering Strategies for Enhanced Cancer Immunotherapy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present novel approaches to engineer T cell receptors for improved specificity and efficacy in cancer immunotherapy. Our findings demonstrate enhanced tumor cell killing in vitro and in vivo.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"T cell engineering\",\n        \"immunology\",\n        \"cancer\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69564", "text": "{\n    \"title\": \"The Role of Microglia in Neurodegenerative Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This study investigates the role of microglia in the pathogenesis of Alzheimer's and Parkinson's diseases.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"microglia\",\n        \"neurodegeneration\",\n        \"Alzheimer's disease\",\n        \"Parkinson's disease\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funded by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69565", "text": "{\n    \"title\": \"Efficient Image Recognition with Deep Convolutional Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to image recognition using deep convolutional neural networks. We achieve state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"deep learning\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69565", "text": "{\n    \"title\": \"Generative Models for Realistic Image Synthesis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We propose a new generative model for synthesizing realistic images. The model is based on a variational autoencoder with a novel regularization term.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"generative models\",\n        \"image synthesis\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by the NIH.\"\n}"}
{"_id": "Academic--preprints--p--69566", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase involved in the progression of triple-negative breast cancer and demonstrate its therapeutic potential using a small molecule inhibitor.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"triple-negative\",\n        \"kinase inhibitor\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69566", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We investigate the correlation between gut microbial composition and the development of Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"gut microbiota\",\n        \"neurodegeneration\",\n        \"inflammation\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Alzheimer's Association for their support.\"\n}"}
{"_id": "Academic--preprints--p--69567", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel techniques for improving the performance of deep learning models on various NLP tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"natural language processing\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/preprint1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant ABC-123.\"\n}"}
{"_id": "Academic--preprints--n--69567", "text": "{\n    \"title\": \"A Novel Approach to Computer Vision\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This preprint introduces a new computer vision algorithm with potential applications in image recognition.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"computer vision\",\n        \"image recognition\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/preprint2\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank the university for providing resources.\"\n}"}
{"_id": "Academic--preprints--p--69568", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase involved in the proliferation of triple-negative breast cancer cells. Inhibition of this kinase leads to significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"kinase\",\n        \"therapy\",\n        \"triple-negative\"\n    ],\n    \"doi\": \"10.1101/123456.789\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.789\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69568", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study explores the complex interplay between the gut microbiome and the development of colorectal cancer. We identify specific bacterial species associated with increased cancer risk.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colorectal cancer\",\n        \"microbiome\",\n        \"gut bacteria\"\n    ],\n    \"doi\": \"10.1101/987654.321\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.321\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69569", "text": "{\n    \"title\": \"Novel Biomarkers for Early Detection of Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies novel circulating biomarkers for the early detection of pancreatic cancer using advanced proteomic techniques. Our findings demonstrate improved sensitivity and specificity compared to existing methods.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"pancreatic cancer\",\n        \"biomarkers\",\n        \"proteomics\",\n        \"early detection\",\n        \"cancer\"\n    ],\n    \"doi\": \"10.1101/2023.0315.1234567\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.0315.1234567v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69569", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Colorectal Cancer Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the influence of gut microbiome composition on the progression of colorectal cancer. We observed significant correlations between specific bacterial species and tumor aggressiveness.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"colorectal cancer\",\n        \"gut microbiome\",\n        \"microbiota\",\n        \"cancer\"\n    ],\n    \"doi\": \"10.1101/2023.0520.9876543\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.0520.9876543v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69570", "text": "{\n    \"title\": \"Advancements in Deep Reinforcement Learning for Robotic Manipulation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to robotic manipulation using deep reinforcement learning. We demonstrate improved performance on complex tasks requiring precise control and adaptability.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"robotics\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF Grant #1234567.\"\n}"}
{"_id": "Academic--preprints--n--69570", "text": "{\n    \"title\": \"A Novel Framework for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new framework for image recognition based on convolutional neural networks. We achieve state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"image recognition\",\n        \"computer vision\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://biorxiv.org/content/10.1101/0987654321\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was funded by the NIH.\"\n}"}
{"_id": "Academic--preprints--p--69571", "text": "{\n    \"title\": \"Novel Immunotherapy Targets for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates the efficacy of novel immunotherapy approaches in treating triple-negative breast cancer. We identify two potential therapeutic targets and demonstrate their effectiveness in preclinical models.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"triple-negative\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funding from the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69571", "text": "{\n    \"title\": \"Genetic Predisposition to Lung Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We performed a genome-wide association study to identify genetic markers associated with lung cancer risk. Our findings suggest a strong correlation between specific SNPs and disease susceptibility.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"genetics\",\n        \"GWAS\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Supported by the American Lung Association.\"\n}"}
{"_id": "Academic--preprints--p--69572", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Gradient Optimization\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We propose a new meta-learning algorithm for few-shot learning tasks. Our method utilizes gradient-based meta-optimization to efficiently learn task-specific parameters. Experimental results demonstrate significant performance improvements on standard benchmarks.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"meta-learning\",\n        \"few-shot learning\",\n        \"optimization\"\n    ],\n    \"doi\": \"10.1234/arxiv.2303.01234\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by a grant from the Simons Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69572", "text": "{\n    \"title\": \"Improving Image Classification with Deep Convolutional Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"abstract\": \"We present a deep convolutional neural network architecture for image classification. Our model achieves state-of-the-art results on the ImageNet dataset. We explore various techniques for improving model accuracy and efficiency.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"image classification\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.5678/arxiv.2305.05678\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.05678\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation under grant number CNS-1852288.\"\n}"}
{"_id": "Academic--preprints--p--69573", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel techniques for improving the performance of deep learning models in natural language processing tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"natural language processing\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/paper.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69573", "text": "{\n    \"title\": \"A Novel Approach to Time Series Forecasting\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"abstract\": \"This paper proposes a new method for forecasting time series data using recurrent neural networks.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"time series\",\n        \"forecasting\",\n        \"machine learning\"\n    ],\n    \"full_text_url\": \"https://example.com/paper2.pdf\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the funding agency for their support.\"\n}"}
{"_id": "Academic--preprints--p--69574", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies a novel protein kinase as a potential therapeutic target for triple-negative breast cancer. We demonstrate that inhibition of this kinase significantly reduces tumor growth in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"breast cancer\",\n        \"cancer\",\n        \"kinase inhibitor\",\n        \"targeted therapy\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69574", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We investigated the correlation between gut microbiome composition and the development of colorectal cancer. Our findings suggest a link between specific bacterial species and increased cancer risk.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"colorectal cancer\",\n        \"cancer\",\n        \"gut microbiome\",\n        \"microbiology\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Supported by a grant from the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69575", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Melanoma Treatment\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates a novel combination therapy using checkpoint inhibitors for the treatment of melanoma.  Results show improved response rates and reduced tumor burden in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"melanoma\",\n        \"cancer immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"PD-1\",\n        \"CTLA-4\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by NIH grant R01CA250000.\"\n}"}
{"_id": "Academic--preprints--n--69575", "text": "{\n    \"title\": \"Targeting Tumor Microenvironment in Lung Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research focuses on the role of the tumor microenvironment in lung cancer progression and explores potential therapeutic strategies.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"lung cancer\",\n        \"tumor microenvironment\",\n        \"angiogenesis\",\n        \"targeted therapy\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Supported by a Cancer Research Institute grant.\"\n}"}
{"_id": "Academic--preprints--p--69576", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This preprint explores novel deep learning architectures for improving performance on various natural language processing tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"machine learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/paper1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69576", "text": "{\n    \"title\": \"A Novel Approach to Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This preprint presents a new method for image recognition using convolutional neural networks.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"image recognition\",\n        \"convolutional neural networks\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/paper2\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the NIH.\"\n}"}
{"_id": "Academic--preprints--p--69577", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Advanced Melanoma\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Dana-Farber Cancer Institute\"\n        }\n    ],\n    \"abstract\": \"This study investigates a novel combination of checkpoint inhibitors for the treatment of advanced melanoma. Results demonstrate improved efficacy and reduced toxicity compared to current standard of care.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"melanoma\",\n        \"checkpoint inhibitors\",\n        \"PD-1\",\n        \"CTLA-4\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69577", "text": "{\n    \"title\": \"Targeting Tumor Microenvironment in Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores strategies to modulate the tumor microenvironment in pancreatic cancer to enhance therapeutic responses.\",\n    \"submission_date\": \"2023-10-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"pancreatic cancer\",\n        \"tumor microenvironment\",\n        \"immunotherapy\",\n        \"fibrosis\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funded by the Pancreatic Cancer Action Network.\"\n}"}
{"_id": "Academic--preprints--p--69578", "text": "{\n    \"title\": \"Novel T-cell therapies for metastatic melanoma\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a novel approach to engineering T-cells to target metastatic melanoma, achieving promising results in preclinical models.\",\n    \"submission_date\": \"2024-02-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"T-cells\",\n        \"melanoma\",\n        \"immunotherapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Institutes of Health (NIH) grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69578", "text": "{\n    \"title\": \"The role of gut microbiome in autoimmune diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the complex interplay between the gut microbiome and the development of autoimmune diseases.\",\n    \"submission_date\": \"2024-03-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiome\",\n        \"autoimmune diseases\",\n        \"inflammation\",\n        \"immunology\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"posted\",\n    \"acknowledgements\": \"We thank the generous support of the American Heart Association.\"\n}"}
