{"_id": "Academic--preprints--p--69374", "text": "{\n    \"title\": \"Novel Therapeutic Strategy Targeting Mutant KRAS in Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Dana-Farber Cancer Institute\"\n        }\n    ],\n    \"abstract\": \"We report a novel therapeutic approach for pancreatic cancer, specifically targeting mutant KRAS. Our findings demonstrate significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"KRAS\",\n        \"therapy\",\n        \"pancreatic cancer\",\n        \"targeted therapy\"\n    ],\n    \"doi\": \"10.1101/2023.03.15.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69374", "text": "{\n    \"title\": \"Biomarker Discovery for Early Detection of Lung Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We identify a novel biomarker panel for the early detection of lung cancer. This panel shows high sensitivity and specificity in a cohort of patients.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"biomarker\",\n        \"diagnosis\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.98765432\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.98765432v1\",\n    \"status\": \"posted\",\n    \"acknowledgements\": \"This study was funded by the American Cancer Society.\"\n}"}
