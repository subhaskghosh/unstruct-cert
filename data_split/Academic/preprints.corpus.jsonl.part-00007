{"_id": "Academic--preprints--p--69580", "text": "{\n    \"title\": \"A Novel Approach to Reinforcement Learning with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This preprint introduces a new architecture for reinforcement learning agents based on transformer networks. We demonstrate improved performance on several benchmark tasks.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"transformers\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2401.0001\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69580", "text": "{\n    \"title\": \"Efficient Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"abstract\": \"We present a novel method for training deep convolutional neural networks for image recognition, achieving state-of-the-art results on ImageNet.\",\n    \"submission_date\": \"2023-11-10\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://biorxiv.org/abs/2311.0002\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPU resources.\"\n}"}
