{"_id": "Academic--preprints--p--69529", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for predicting protein structures with high accuracy.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69529", "text": "{\n    \"title\": \"Genomic Analysis of Viral Evolution\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"abstract\": \"We investigate the genomic evolution of influenza viruses using phylogenetic analysis.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"viral evolution\",\n        \"genomics\",\n        \"phylogenetics\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank the CDC for providing viral sequences.\"\n}"}
{"_id": "Academic--preprints--p--69530", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for predicting protein structure from amino acid sequence. The model achieves state-of-the-art performance on benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation (Grant No. 1234567).\"\n}"}
{"_id": "Academic--preprints--n--69530", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Autoimmune Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"This study investigates the relationship between gut microbiota composition and the development of autoimmune diseases.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"autoimmune diseases\",\n        \"immunology\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/789012\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the NIH for their support.\"\n}"}
{"_id": "Academic--preprints--p--69531", "text": "{\n    \"title\": \"A Novel Approach to Image Segmentation using Deep Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper presents a new method for image segmentation based on a deep convolutional neural network. We achieve state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"image segmentation\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/1234567.890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69531", "text": "{\n    \"title\": \"Real-time Object Detection with YOLO\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a real-time object detection system based on the YOLO architecture. Our system achieves high accuracy and speed.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"object detection\",\n        \"YOLO\"\n    ],\n    \"doi\": \"10.1101/9876543.210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by a grant from Google.\"\n}"}
{"_id": "Academic--preprints--p--69532", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We propose a novel meta-reinforcement learning framework for few-shot learning. Our approach enables agents to quickly adapt to new tasks with limited experience, achieving state-of-the-art performance on several benchmark datasets.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69532", "text": "{\n    \"title\": \"Deep Learning for Image Recognition: A Comprehensive Review\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper provides a comprehensive review of deep learning techniques for image recognition. We discuss recent advances in convolutional neural networks, recurrent neural networks, and generative adversarial networks.\",\n    \"submission_date\": \"2023-09-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69533", "text": "{\n    \"title\": \"Scaling Laws for Retrieval-Augmented Language Models\",\n    \"authors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"abstract\": \"We investigate the scaling laws for retrieval-augmented language models, focusing on the impact of corpus size and retriever accuracy on downstream task performance. Our results demonstrate that retrieval can significantly improve performance, particularly in low-data regimes.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Transformer\",\n        \"Retrieval\",\n        \"Language Models\",\n        \"Scaling Laws\"\n    ],\n    \"doi\": \"10.48550/arXiv.2311.01234\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant ABC-123.\"\n}"}
{"_id": "Academic--preprints--n--69533", "text": "{\n    \"title\": \"Efficient Transformer Inference with Quantization\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"abstract\": \"We present a novel quantization technique for reducing the memory footprint of Transformer models during inference. This method achieves significant speedups without substantial accuracy loss.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Transformer\",\n        \"Quantization\",\n        \"Inference\",\n        \"Efficiency\"\n    ],\n    \"doi\": \"10.48550/arXiv.2312.04567\",\n    \"full_text_url\": \"https://arxiv.org/abs/2312.04567\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by a grant from the Allen Institute for AI.\"\n}"}
{"_id": "Academic--preprints--p--69534", "text": "{\n    \"title\": \"Novel Therapeutic Targets in Glioblastoma Multiforme\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"Glioblastoma multiforme (GBM) remains a highly aggressive and incurable malignancy. This study identifies novel therapeutic targets based on genomic and proteomic analyses of GBM patient samples.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"glioblastoma\",\n        \"cancer\",\n        \"genomics\",\n        \"proteomics\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/2023.03.15.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01NS123456 and the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--n--69534", "text": "{\n    \"title\": \"The Role of Microbiome in Inflammatory Bowel Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study investigates the composition of the gut microbiome in patients with Crohn's disease and ulcerative colitis, and its correlation with disease severity.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"microbiome\",\n        \"IBD\",\n        \"Crohn's disease\",\n        \"ulcerative colitis\",\n        \"inflammation\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.98765432\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.98765432v1\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This research was supported by a private foundation dedicated to gut health.\"\n}"}
{"_id": "Academic--preprints--p--69535", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures from amino acid sequences. Our method achieves state-of-the-art accuracy on benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Institutes of Health (NIH) grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69535", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Autoimmune Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"This study investigates the complex interplay between gut microbiota composition and the development of autoimmune diseases. We identify specific microbial signatures associated with increased disease risk.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"autoimmune diseases\",\n        \"immunology\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the American Heart Association for their support.\"\n}"}
{"_id": "Academic--preprints--p--69536", "text": "{\n    \"title\": \"Novel Therapeutic Target in Glioblastoma Multiforme\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel therapeutic target for glioblastoma multiforme using CRISPR-based screening. Inhibition of this target leads to significant tumor regression in vitro and in vivo.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"glioblastoma\",\n        \"cancer\",\n        \"CRISPR\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/2023.0315.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.0315.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01NS123456.\"\n}"}
{"_id": "Academic--preprints--n--69536", "text": "{\n    \"title\": \"The Role of MicroRNAs in Breast Cancer Metastasis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the role of microRNAs in breast cancer metastasis. We find that specific microRNAs are upregulated in metastatic cells and promote invasion.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"breast cancer\",\n        \"metastasis\",\n        \"microRNA\",\n        \"RNA sequencing\"\n    ],\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.0520.98765432v1\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"We thank the American Cancer Society for their funding.\"\n}"}
{"_id": "Academic--preprints--p--69537", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for predicting protein structures from amino acid sequences. Our method achieves state-of-the-art results on benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69537", "text": "{\n    \"title\": \"Genetic Basis of Flower Color Variation\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We identify the genes responsible for the diverse range of flower colors observed in a model plant species.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"genetics\",\n        \"plant biology\",\n        \"flower color\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the NSF.\"\n}"}
{"_id": "Academic--preprints--p--69538", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new meta-reinforcement learning algorithm for few-shot learning. We demonstrate improved performance on image classification tasks with limited data.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1234/arxiv.2303.12345\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69538", "text": "{\n    \"title\": \"Improving Natural Language Understanding with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Meta AI\"\n        }\n    ],\n    \"abstract\": \"We present a new transformer-based model for natural language understanding tasks, achieving state-of-the-art results on several benchmarks.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"deep learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.5678/biorxiv.2305.67890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.5678/biorxiv.2305.67890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69539", "text": "{\n    \"title\": \"Novel Immunotherapeutic Approaches for Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates new strategies to enhance anti-tumor immunity in pancreatic cancer using a combination of checkpoint inhibitors and adoptive T-cell therapy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"pancreatic cancer\",\n        \"checkpoint inhibitors\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01CA250000.\"\n}"}
{"_id": "Academic--preprints--n--69539", "text": "{\n    \"title\": \"Genetic Mutations in Lung Adenocarcinoma\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"We present a comprehensive analysis of genetic mutations found in lung adenocarcinoma, focusing on EGFR and KRAS alterations.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"genetics\",\n        \"mutation\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Supported by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69540", "text": "{\n    \"title\": \"Novel Immunotherapy Targets for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify novel immunotherapy targets for triple-negative breast cancer using a CRISPR-based screening approach.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"CRISPR\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by grants from the National Institutes of Health (NIH) and the Breast Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69540", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Alzheimer's Disease Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We investigate the link between gut microbiota composition and the progression of Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"gut microbiota\",\n        \"neuroinflammation\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"We thank the Alzheimer's Association for their support.\"\n}"}
{"_id": "Academic--preprints--p--69541", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint proposes a new meta-reinforcement learning algorithm for few-shot learning. We demonstrate its effectiveness on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant #1234567.\"\n}"}
{"_id": "Academic--preprints--n--69541", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"This paper investigates the use of deep convolutional neural networks for image recognition tasks.  We achieve state-of-the-art results on ImageNet.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for GPU support.\"\n}"}
{"_id": "Academic--preprints--p--69542", "text": "{\n    \"title\": \"Advancements in Deep Reinforcement Learning for Robotic Manipulation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to deep reinforcement learning for robotic manipulation tasks. We demonstrate improved performance on a set of challenging benchmark problems.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Deep Learning\",\n        \"Reinforcement Learning\",\n        \"Robotics\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69542", "text": "{\n    \"title\": \"A Survey of Natural Language Processing Techniques\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This survey provides a comprehensive overview of recent advances in natural language processing, focusing on transformer-based models.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Natural Language Processing\",\n        \"Deep Learning\",\n        \"Transformers\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.456\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The author thanks the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69543", "text": "{\n    \"title\": \"A Novel Approach to Transformer Networks for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We propose a new transformer architecture for image recognition that achieves state-of-the-art results on the ImageNet dataset.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"transformers\",\n        \"image recognition\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69543", "text": "{\n    \"title\": \"Improving Efficiency of Convolutional Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel pruning technique for convolutional neural networks that reduces their computational cost without significantly sacrificing accuracy.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"convolutional neural networks\",\n        \"pruning\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.05678\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69544", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination Enhances Anti-Tumor Immunity\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates a novel combination of checkpoint inhibitors that synergistically enhance anti-tumor immunity in preclinical models of melanoma.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"melanoma\",\n        \"anti-tumor immunity\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by NIH grant CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69544", "text": "{\n    \"title\": \"The Role of Microbiome in Cancer Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research examines the complex interplay between the gut microbiome and cancer progression, focusing on colorectal cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"microbiome\",\n        \"cancer progression\",\n        \"colorectal cancer\",\n        \"gut health\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Supported by the Cancer Research Institute.\"\n}"}
{"_id": "Academic--preprints--p--69545", "text": "{\n    \"title\": \"Novel Therapeutic Target for Glioblastoma Multiforme\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel therapeutic target for glioblastoma multiforme and demonstrate its efficacy in preclinical models.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"glioblastoma\",\n        \"cancer\",\n        \"therapy\",\n        \"brain tumor\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": null\n}"}
{"_id": "Academic--preprints--n--69545", "text": "{\n    \"title\": \"The Role of MicroRNAs in Breast Cancer Metastasis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the role of microRNAs in breast cancer metastasis and identifies potential biomarkers.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"breast cancer\",\n        \"metastasis\",\n        \"microRNA\",\n        \"biomarker\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456 and the Breast Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69546", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new method for few-shot learning using transformer-based models. We demonstrate improved performance on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/arxiv.2303.01234\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant #1234567.\"\n}"}
{"_id": "Academic--preprints--n--69546", "text": "{\n    \"title\": \"Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"A comprehensive review of deep learning techniques applied to natural language processing tasks.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.5678/arxiv.2305.05678\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.05678\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69547", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures with high accuracy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69547", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"abstract\": \"This study investigates the correlation between gut microbiota composition and the progression of Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"gut microbiota\",\n        \"neuroinflammation\"\n    ],\n    \"doi\": \"10.1101/789012\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank the Alzheimer's Association for their support.\"\n}"}
