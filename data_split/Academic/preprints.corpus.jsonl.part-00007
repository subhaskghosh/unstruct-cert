{"_id": "Academic--preprints--p--69290", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new meta-learning framework based on transformers for achieving state-of-the-art results in few-shot learning scenarios. We demonstrate improved performance on benchmark datasets.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"meta-learning\",\n        \"few-shot learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/arxiv.2401.0001\",\n    \"full_text_url\": \"https://arxiv.org/abs/2401.0001\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69290", "text": "{\n    \"title\": \"Enhancing Image Classification with Convolutional Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We explore the application of CNNs to image classification tasks and propose a novel architecture for improving accuracy.\",\n    \"submission_date\": \"2023-11-10\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image classification\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.5678/arxiv.2311.0002\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.0002\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for GPU support.\"\n}"}
{"_id": "Academic--preprints--p--69291", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel advancements in deep learning architectures for natural language processing tasks, achieving state-of-the-art results on benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"natural language processing\",\n        \"neural networks\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/paper1.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69291", "text": "{\n    \"title\": \"A Survey of Reinforcement Learning Techniques\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"abstract\": \"This survey provides a comprehensive overview of recent advancements in reinforcement learning, covering both theoretical foundations and practical applications.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/paper2.pdf\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank their colleagues for valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69292", "text": "{\n    \"title\": \"Novel Immunotherapeutic Approaches for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We investigate new immunotherapy strategies to combat triple-negative breast cancer, demonstrating enhanced efficacy in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"triple-negative\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funding from the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69292", "text": "{\n    \"title\": \"Genetic Predisposition to Lung Cancer in Non-Smokers\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This study explores the genetic factors contributing to lung cancer development in individuals with no history of smoking.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"genetics\",\n        \"non-smokers\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Supported by a grant from the American Lung Association.\"\n}"}
{"_id": "Academic--preprints--p--69293", "text": "{\n    \"title\": \"Efficient Training of Deep Neural Networks with Sparse Data\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a novel approach to training deep neural networks with sparse data, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"sparse data\",\n        \"neural networks\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/preprint123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
