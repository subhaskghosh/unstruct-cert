{"_id": "Academic--preprints--p--69517", "text": "{\n    \"title\": \"Federated Learning for Personalized Recommendation Systems\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper explores the use of federated learning techniques to build personalized recommendation systems while preserving user privacy.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"federated learning\",\n        \"recommendation systems\",\n        \"privacy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF Grant No. 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69517", "text": "{\n    \"title\": \"Deep Reinforcement Learning for Game Playing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep reinforcement learning algorithm for achieving super-human performance in complex games.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep reinforcement learning\",\n        \"game playing\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by a grant from OpenAI.\"\n}"}
{"_id": "Academic--preprints--p--69518", "text": "{\n    \"title\": \"Deep Learning for Image Recognition: A Novel Approach\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This preprint presents a novel deep learning architecture for image recognition, achieving state-of-the-art results on benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/deeplearning.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69518", "text": "{\n    \"title\": \"Machine Learning Applications in Healthcare\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint explores the application of machine learning techniques to improve healthcare outcomes.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"healthcare\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://example.com/healthcareml.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by a grant from the NIH.\"\n}"}
{"_id": "Academic--preprints--p--69519", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for predicting protein structures with high accuracy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69519", "text": "{\n    \"title\": \"Genome-Wide Association Study of Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We performed a genome-wide association study to identify genetic variants associated with Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"genome-wide association study\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"This research was funded by the Alzheimer's Association.\"\n}"}
