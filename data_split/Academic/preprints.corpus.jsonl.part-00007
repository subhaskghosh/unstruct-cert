{"_id": "Academic--preprints--p--69931", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Lee\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new meta-learning framework for few-shot learning tasks, leveraging transformer architectures to effectively adapt to novel classes with limited data. We achieve state-of-the-art results on benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"meta-learning\",\n        \"few-shot learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/arxiv.2311.01234\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69931", "text": "{\n    \"title\": \"Deep Reinforcement Learning for Robotics Control\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"We explore the application of deep reinforcement learning algorithms to robotic control tasks. The results demonstrate significant improvements in performance compared to traditional control methods.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"robotics\",\n        \"deep learning\",\n        \"control systems\"\n    ],\n    \"doi\": \"10.5678/biorxiv.2312.00001\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.12.01.567890\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This research was funded by a grant from the Robotics Foundation.\"\n}"}
