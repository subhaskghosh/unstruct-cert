{"_id": "Academic--preprints--n--69398", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Autoimmune Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates the connection between the composition of gut microbiota and the development of autoimmune diseases.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"autoimmune diseases\",\n        \"immunology\",\n        \"inflammation\"\n    ],\n    \"full_text_url\": \"https://www.biorxiv.org/content/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the patients who participated in this study.\"\n}"}
