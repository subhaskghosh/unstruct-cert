{"_id": "Academic--preprints--p--69868", "text": "{\n    \"title\": \"A Novel Approach to Reinforcement Learning with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"We present a novel approach to reinforcement learning that leverages the power of transformer architectures. Our results demonstrate significant improvements in performance on a variety of challenging benchmark tasks.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by a grant from the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69868", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We explore the application of deep learning techniques to image recognition tasks. Our results show that convolutional neural networks can achieve state-of-the-art performance on standard datasets.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by the NIH.\"\n}"}
