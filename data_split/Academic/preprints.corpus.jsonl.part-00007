{"_id": "Academic--preprints--n--69684", "text": "{\n    \"title\": \"A Novel Approach to Machine Learning with Gaussian Processes\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We introduce a new method for applying Gaussian processes to machine learning problems.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"gaussian processes\",\n        \"regression\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/preprint2\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Moore Foundation for their support.\"\n}"}
{"_id": "Academic--preprints--p--69685", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Contrastive Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel contrastive learning framework for few-shot learning that significantly improves performance on image classification tasks. Our approach leverages...\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Few-Shot Learning\",\n        \"Contrastive Learning\",\n        \"Image Classification\"\n    ],\n    \"doi\": \"10.1101/12345.67890\",\n    \"full_text_url\": \"https://arxiv.org/abs/12345.67890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF Grant #1234567.\"\n}"}
{"_id": "Academic--preprints--n--69685", "text": "{\n    \"title\": \"Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint explores the application of deep learning techniques to various natural language processing tasks, including...\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Deep Learning\",\n        \"Natural Language Processing\",\n        \"NLP\",\n        \"Machine Learning\"\n    ],\n    \"doi\": \"10.1101/98765.43210\",\n    \"full_text_url\": \"https://arxiv.org/abs/98765.43210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"The authors thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69686", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Enhanced Anti-Tumor Immunity\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We investigate a novel combination therapy targeting PD-1 and LAG-3 to enhance anti-tumor immune responses in murine models of melanoma. Preliminary results suggest synergistic effects and improved tumor control.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"PD-1\",\n        \"LAG-3\",\n        \"melanoma\"\n    ],\n    \"doi\": null,\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.532189v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA250000.\"\n}"}
{"_id": "Academic--preprints--n--69686", "text": "{\n    \"title\": \"Targeting Tumor Microenvironment for Improved Immunotherapy Response\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"Modulating the tumor microenvironment, specifically by inhibiting TGF-beta signaling, can enhance the efficacy of adoptive T cell therapy. This study demonstrates improved T cell infiltration and anti-tumor activity in preclinical models.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"tumor microenvironment\",\n        \"TGF-beta\",\n        \"adoptive T cell therapy\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.812345v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.812345v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funded by the Cancer Research Institute.\"\n}"}
{"_id": "Academic--preprints--p--69687", "text": "{\n    \"title\": \"Federated Learning for Personalized Healthcare with Differential Privacy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper proposes a novel federated learning framework for personalized healthcare, incorporating differential privacy to protect patient data. We demonstrate improved model performance and privacy guarantees on a benchmark dataset.\",\n    \"submission_date\": \"2023-10-27\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"machine learning\",\n        \"differential privacy\",\n        \"healthcare\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69687", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for image recognition, achieving state-of-the-art results on ImageNet.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was partially funded by a Google Research Grant.\"\n}"}
{"_id": "Academic--preprints--p--69688", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new meta-reinforcement learning algorithm for few-shot learning. We demonstrate its effectiveness on several benchmark datasets.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1234/example.001\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69688", "text": "{\n    \"title\": \"Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"A comprehensive review of deep learning techniques applied to natural language processing tasks.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"NLP\"\n    ],\n    \"doi\": \"10.5678/example.002\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.65432\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69689", "text": "{\n    \"title\": \"A Novel Deep Learning Approach for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a new deep learning model for predicting protein structure from amino acid sequence. Our model achieves state-of-the-art accuracy on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"protein structure prediction\",\n        \"deep learning\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69689", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Autoimmune Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"This study investigates the link between gut microbiota composition and the development of autoimmune diseases. We found significant correlations between specific bacterial species and disease severity.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"autoimmune diseases\",\n        \"immunology\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank the patients who participated in this study.\"\n}"}
{"_id": "Academic--preprints--p--69690", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures with high accuracy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69690", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"This study investigates the correlation between gut microbiome composition and the onset of Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"Alzheimer's disease\",\n        \"neuroscience\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/789012\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank the Alzheimer's Association for funding this research.\"\n}"}
{"_id": "Academic--preprints--p--69691", "text": "{\n    \"title\": \"Advancements in Transformer Networks for Sentiment Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to sentiment analysis using transformer networks, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-10-27\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"sentiment analysis\",\n        \"transformer networks\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/paper123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69691", "text": "{\n    \"title\": \"A Comparative Study of Reinforcement Learning Algorithms\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper compares the performance of several reinforcement learning algorithms on a suite of challenging control tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"control theory\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://example.com/paper456\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for the GPU donation.\"\n}"}
{"_id": "Academic--preprints--p--69692", "text": "{\n    \"title\": \"A Novel Approach to Transformer-Based Language Modeling\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a new method for training transformer models that improves performance on a variety of natural language processing tasks.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"transformers\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/abc.2023.001\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.00001\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69692", "text": "{\n    \"title\": \"Efficient Algorithms for Large-Scale Machine Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper introduces novel algorithms for training machine learning models on massive datasets.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"algorithms\",\n        \"optimization\",\n        \"data science\"\n    ],\n    \"doi\": \"10.5678/def.2023.002\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.00002\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank Google for providing computational resources.\"\n}"}
{"_id": "Academic--preprints--p--69693", "text": "{\n    \"title\": \"Novel Immunotherapy Approaches for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"Triple-negative breast cancer (TNBC) is an aggressive subtype with limited treatment options. This study investigates novel immunotherapy combinations targeting PD-1 and LAG-3. We demonstrate enhanced T-cell infiltration and tumor regression in preclinical models.  Our findings suggest a promising therapeutic strategy for TNBC patients. This work builds on previous research demonstrating...\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"PD-1\",\n        \"LAG-3\"\n    ],\n    \"doi\": \"10.1101/2023.03.15.532147\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.532147v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01CA222222.\"\n}"}
{"_id": "Academic--preprints--n--69693", "text": "{\n    \"title\": \"MicroRNA Regulation in Glioma Cells\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study examines the role of microRNAs in glioma cell proliferation. We identified several miRNAs that are differentially expressed in glioma samples. Further investigation is needed to validate these findings.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"glioma\",\n        \"microRNA\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.654321\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.654321v1\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"Funded by the California Institute for Regenerative Medicine.\"\n}"}
{"_id": "Academic--preprints--p--69694", "text": "{\n    \"title\": \"Efficient Training of Deep Neural Networks via Quantization\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel quantization technique for training deep neural networks, achieving significant speedups and memory reductions without sacrificing accuracy.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"quantization\",\n        \"neural networks\"\n    ],\n    \"doi\": \"10.1234/arxiv.2311.01234\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69694", "text": "{\n    \"title\": \"Reinforcement Learning for Robotics\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We explore the application of reinforcement learning to robotic control tasks, achieving state-of-the-art performance on several benchmark problems.\",\n    \"submission_date\": \"2023-11-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"robotics\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.5678/biorxiv.2311.00456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.11.01.5678\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"This research was funded by the Robotics Society.\"\n}"}
{"_id": "Academic--preprints--p--69695", "text": "{\n    \"title\": \"Novel Biomarkers for Early Detection of Lung Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify novel circulating biomarkers for the early detection of lung cancer using a combination of proteomics and machine learning.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"lung cancer\",\n        \"biomarkers\",\n        \"proteomics\",\n        \"early detection\",\n        \"cancer\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69695", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Inflammatory Bowel Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the impact of gut microbiota composition on the pathogenesis of inflammatory bowel disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"inflammatory bowel disease\",\n        \"IBD\",\n        \"microbiome\"\n    ],\n    \"full_text_url\": \"https://www.biorxiv.org/content/9876543210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"Supported by the Crohn's & Colitis Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69696", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new meta-learning algorithm for few-shot learning tasks. We demonstrate improved performance on image classification benchmarks.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"meta-learning\",\n        \"few-shot learning\",\n        \"image classification\"\n    ],\n    \"doi\": \"10.1234/abc.2023.0515\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant ABC-1234567.\"\n}"}
{"_id": "Academic--preprints--n--69696", "text": "{\n    \"title\": \"Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper provides a survey of recent advances in deep learning for NLP tasks.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"machine learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.5678/def.2023.0820\",\n    \"full_text_url\": \"https://arxiv.org/abs/2308.09876\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank Google for providing computational resources.\"\n}"}
{"_id": "Academic--preprints--p--69697", "text": "{\n    \"title\": \"Novel Therapeutic Target for Aggressive Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase that is overexpressed in aggressive forms of breast cancer and demonstrate its potential as a therapeutic target.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"kinase\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69697", "text": "{\n    \"title\": \"The Role of Inflammation in Colon Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the link between chronic inflammation and the development of colon cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colon cancer\",\n        \"inflammation\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69698", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures with high accuracy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation grant NSF-1234567.\"\n}"}
{"_id": "Academic--preprints--n--69698", "text": "{\n    \"title\": \"Genome-Wide Association Study of Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"abstract\": \"A genome-wide association study identifies novel genetic markers associated with Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"GWAS\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Alzheimer's Association for their support.\"\n}"}
{"_id": "Academic--preprints--p--69699", "text": "{\n    \"title\": \"Novel Biomarkers for Early Detection of Lung Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies novel biomarkers for the early detection of lung cancer using a multi-omics approach.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"biomarkers\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69699", "text": "{\n    \"title\": \"Targeted Therapy in Breast Cancer: A Comprehensive Review\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"A review of recent advances in targeted therapy for breast cancer, focusing on clinical trials and future directions.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"targeted therapy\",\n        \"clinical trials\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the Breast Cancer Research Foundation for their support.\"\n}"}
{"_id": "Academic--preprints--p--69700", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for predicting protein structures from amino acid sequences.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69700", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Autoimmune Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Martinez\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates the complex relationship between the gut microbiome and the development of autoimmune conditions.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"autoimmune diseases\",\n        \"immunology\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Gates Foundation for their support.\"\n}"}
{"_id": "Academic--preprints--p--69701", "text": "{\n    \"title\": \"A Novel Machine Learning Approach for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a new machine learning model for predicting protein structures with improved accuracy and efficiency. The model leverages attention mechanisms and graph neural networks to capture complex protein interactions.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"protein structure prediction\",\n        \"graph neural networks\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69701", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"abstract\": \"This paper explores the application of deep learning techniques to image recognition tasks, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/earlyrel/doi/10.5678/example.456\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by NIH grant ABC789.\"\n}"}
{"_id": "Academic--preprints--p--69702", "text": "{\n    \"title\": \"Large Language Models for Sentiment Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint explores the application of large language models to sentiment analysis tasks, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"sentiment analysis\",\n        \"large language models\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/paper123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69702", "text": "{\n    \"title\": \"Improving Machine Translation with Attention Mechanisms\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"We present a novel attention mechanism for machine translation, significantly improving BLEU scores on several language pairs.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"machine translation\",\n        \"attention mechanisms\"\n    ],\n    \"doi\": \"10.4567/example.456\",\n    \"full_text_url\": \"https://example.com/paper456\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was funded by the NIH.\"\n}"}
{"_id": "Academic--preprints--p--69703", "text": "{\n    \"title\": \"Novel Therapeutic Target Identification for Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel therapeutic target for pancreatic cancer based on genomic analysis of patient samples. Our findings suggest that inhibiting protein X can significantly reduce tumor growth in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"pancreatic cancer\",\n        \"therapeutic target\",\n        \"genomics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the NIH grant #12345.\"\n}"}
{"_id": "Academic--preprints--n--69703", "text": "{\n    \"title\": \"The Role of Microbiome in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the relationship between gut microbiome composition and colorectal cancer development. We observed significant differences in microbial diversity between healthy individuals and patients with colorectal cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colorectal cancer\",\n        \"microbiome\",\n        \"gut health\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the patients who participated in this study.\"\n}"}
{"_id": "Academic--preprints--p--69704", "text": "{\n    \"title\": \"Scaling Laws for Neural Language Models\",\n    \"authors\": [\n        {\n            \"name\": \"Kaplan, Jared\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"McCarthy, Sam\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"abstract\": \"We investigate the scaling laws for neural language models. Our results show that performance improves with increasing model size, dataset size, and compute.\",\n    \"submission_date\": \"2023-02-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Large Language Models\",\n        \"Scaling Laws\",\n        \"Neural Networks\"\n    ],\n    \"doi\": \"10.48550/arXiv.2302.00001\",\n    \"full_text_url\": \"https://arxiv.org/abs/2302.00001\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by OpenAI.\"\n}"}
{"_id": "Academic--preprints--n--69704", "text": "{\n    \"title\": \"Efficient Training of Language Models with Quantization\",\n    \"authors\": [\n        {\n            \"name\": \"Wu, Tianyi\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Zhou, Yuchen\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"abstract\": \"We present a new method for quantizing language models, enabling efficient training and inference.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Quantization\",\n        \"Language Models\",\n        \"Efficient Training\"\n    ],\n    \"doi\": \"10.48550/arXiv.2303.00002\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.00002\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"This research was funded by the Google Research initiative.\"\n}"}
{"_id": "Academic--preprints--p--69705", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a new meta-reinforcement learning algorithm for few-shot learning. Our approach achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69705", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper explores the use of deep convolutional neural networks for image recognition. We demonstrate strong performance on the ImageNet dataset.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by Google.\"\n}"}
{"_id": "Academic--preprints--p--69706", "text": "{\n    \"title\": \"Attention is All You Need: A Novel Transformer Network for Machine Translation\",\n    \"authors\": [\n        {\n            \"name\": \"Vaswani, Ashish\",\n            \"affiliation\": \"Google Brain\"\n        },\n        {\n            \"name\": \"Shazeer, Noam\",\n            \"affiliation\": \"Google Brain\"\n        }\n    ],\n    \"abstract\": \"We propose a novel neural network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely. Our experiments demonstrate the superior performance of this architecture on machine translation tasks.\",\n    \"submission_date\": \"2023-02-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Translation\",\n        \"Neural Networks\",\n        \"Transformer Networks\",\n        \"Attention Mechanisms\"\n    ],\n    \"doi\": \"10.1101/1234567\",\n    \"full_text_url\": \"https://arxiv.org/abs/1706.03762\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by a grant from the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69706", "text": "{\n    \"title\": \"Improving Language Models with Transformer Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Brown, Tom B.\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"Mannor, Samuel\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"abstract\": \"We present a comprehensive evaluation of Transformer Networks for pre-training large language models. The results demonstrate significant improvements in performance across a range of NLP tasks.\",\n    \"submission_date\": \"2023-03-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Language Models\",\n        \"Transformer Networks\",\n        \"Pre-training\",\n        \"NLP\"\n    ],\n    \"doi\": \"10.1101/7654321\",\n    \"full_text_url\": \"https://arxiv.org/abs/2005.14165\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the OpenAI compute team for their support.\"\n}"}
{"_id": "Academic--preprints--p--69707", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies a novel protein kinase as a potential therapeutic target for triple-negative breast cancer. We demonstrate that inhibition of this kinase leads to significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"triple-negative\",\n        \"kinase\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69707", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We investigated the composition of the gut microbiota in patients with colorectal cancer and found significant differences compared to healthy controls. These findings suggest that the gut microbiota may play a role in the development of this disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colorectal cancer\",\n        \"gut microbiota\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69708", "text": "{\n    \"title\": \"A Novel Deep Learning Approach for Image Classification\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper presents a new deep learning architecture for image classification, achieving state-of-the-art results on the ImageNet dataset.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image classification\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69708", "text": "{\n    \"title\": \"The Role of Machine Learning in Drug Discovery\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Broad Institute\"\n        }\n    ],\n    \"abstract\": \"We explore the application of machine learning techniques to accelerate drug discovery and identify potential drug candidates.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"drug discovery\",\n        \"cheminformatics\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/0987654321\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"This research was funded by a grant from the NIH.\"\n}"}
