{"_id": "Academic--preprints--p--69900", "text": "{\n    \"title\": \"Advancements in Deep Reinforcement Learning for Robotic Manipulation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University, Department of Computer Science\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to deep reinforcement learning for robotic manipulation tasks. We introduce a new algorithm that improves sample efficiency and robustness.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep reinforcement learning\",\n        \"robotics\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.48550/arXiv.2303.08321\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.08321\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant IIS-2204345.\"\n}"}
{"_id": "Academic--preprints--n--69900", "text": "{\n    \"title\": \"A Novel Approach to Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology, Linguistics Department\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a new model for natural language processing that achieves state-of-the-art results on several benchmark tasks.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"NLP\",\n        \"deep learning\",\n        \"transformer models\"\n    ],\n    \"full_text_url\": \"https://arxiv.org/abs/2305.10112\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was funded by the Sloan Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69901", "text": "{\n    \"title\": \"Advancements in Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel deep learning architectures for improving image recognition accuracy. We demonstrate state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"machine learning\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.1109/ICCVW.2023.00123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69901", "text": "{\n    \"title\": \"A Novel Approach to Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a new method for natural language understanding using transformer networks. Our approach achieves competitive performance on various NLP tasks.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"transformer networks\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.321098\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.321098v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by a grant from the Simons Foundation.\"\n}"}
