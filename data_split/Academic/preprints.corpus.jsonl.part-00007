{"_id": "Academic--preprints--n--69478", "text": "{\n    \"title\": \"The Role of Genetics in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"This study investigates the genetic factors associated with the development of Alzheimer's disease, focusing on APOE4 and other risk alleles.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"neuroscience\",\n        \"APOE4\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Alzheimer's Association for their support.\"\n}"}
{"_id": "Academic--preprints--p--69479", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures with high accuracy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69479", "text": "{\n    \"title\": \"Evolutionary Analysis of Viral Genomes\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We investigate the evolutionary dynamics of viral genomes using phylogenetic methods.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"viral evolution\",\n        \"phylogenetics\",\n        \"genomics\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Moore Foundation for funding.\"\n}"}
{"_id": "Academic--preprints--p--69480", "text": "{\n    \"title\": \"Vision Transformers for Medical Image Segmentation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a novel application of Vision Transformers to medical image segmentation, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"medical imaging\",\n        \"segmentation\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01-MH123456.\"\n}"}
{"_id": "Academic--preprints--n--69480", "text": "{\n    \"title\": \"Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper explores the use of deep learning techniques for various NLP tasks.\",\n    \"submission_date\": \"2023-11-10\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69481", "text": "{\n    \"title\": \"Efficient Training of Deep Neural Networks with Sparse Gradients\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel method for training deep neural networks that leverages sparse gradients to improve efficiency and scalability. Our approach significantly reduces communication costs and memory requirements, enabling training on larger datasets and models.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"sparse gradients\",\n        \"optimization\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF grant ABC-123.\"\n}"}
{"_id": "Academic--preprints--n--69481", "text": "{\n    \"title\": \"Large Language Models for Scientific Discovery\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We explore the potential of large language models for accelerating scientific discovery. We demonstrate that these models can effectively summarize research papers and generate novel hypotheses.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"scientific discovery\",\n        \"large language models\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/2312.00001\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the NIH.\"\n}"}
{"_id": "Academic--preprints--p--69482", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures with high accuracy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation grant #1234567.\"\n}"}
{"_id": "Academic--preprints--n--69482", "text": "{\n    \"title\": \"Genome-Wide Association Study of Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We conducted a genome-wide association study to identify genetic risk factors for Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"genome-wide association study\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Alzheimer's Association for their support.\"\n}"}
{"_id": "Academic--preprints--p--69483", "text": "{\n    \"title\": \"Novel Immunotherapeutic Approaches for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates the efficacy of a novel combination immunotherapy for treating triple-negative breast cancer. Results demonstrate significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"triple-negative\"\n    ],\n    \"doi\": \"10.1101/123456.0\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.0\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funding provided by the NIH.\"\n}"}
{"_id": "Academic--preprints--n--69483", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores the complex relationship between the gut microbiome and various types of cancer. It highlights potential diagnostic and therapeutic opportunities.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"gut microbiome\",\n        \"microbiota\",\n        \"immunology\"\n    ],\n    \"doi\": \"10.1101/789012.0\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.0\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Supported by a grant from the Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69484", "text": "{\n    \"title\": \"Federated Learning with Differential Privacy for Healthcare Data\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper explores the application of federated learning with differential privacy to protect patient data while enabling collaborative model training. We demonstrate improved performance on a benchmark healthcare dataset.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"differential privacy\",\n        \"healthcare\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01-MH123456.\"\n}"}
{"_id": "Academic--preprints--n--69484", "text": "{\n    \"title\": \"Transformer Networks for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel application of transformer networks to machine translation. Our results show significant improvements over existing models.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"transformers\",\n        \"natural language processing\",\n        \"machine learning\",\n        \"translation\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://arxiv.org/abs/0987654321\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69485", "text": "{\n    \"title\": \"Novel Biomarker for Early Detection of Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We identify a novel circulating biomarker for the early detection of pancreatic cancer, improving diagnostic accuracy and patient outcomes.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"pancreatic cancer\",\n        \"biomarker\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by NIH Grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69485", "text": "{\n    \"title\": \"The Role of MicroRNAs in Breast Oncology\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Dana-Farber Cancer Institute\"\n        }\n    ],\n    \"abstract\": \"This study investigates the role of specific microRNAs in the progression of breast cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"oncology\",\n        \"breast cancer\",\n        \"microRNA\",\n        \"gene expression\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Supported by a grant from the Breast Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69486", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint proposes a new method for few-shot learning using transformers. We demonstrate improved performance on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69486", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This preprint presents a comprehensive overview of deep learning techniques for image recognition.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.04567\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69487", "text": "{\n    \"title\": \"Large Language Models for Code Generation: A Comprehensive Study\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a comprehensive study of large language models for code generation, evaluating their performance on a variety of benchmarks and exploring techniques for improving their accuracy and efficiency.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Natural Language Processing\",\n        \"Code Generation\",\n        \"Large Language Models\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69487", "text": "{\n    \"title\": \"A Novel Approach to Sentiment Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a novel approach to sentiment analysis based on deep learning techniques.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Natural Language Processing\",\n        \"Sentiment Analysis\",\n        \"Deep Learning\"\n    ],\n    \"doi\": \"10.1102/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1102/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"The authors thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69488", "text": "{\n    \"title\": \"Novel Immunotherapeutic Strategies for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"This study investigates a novel combination immunotherapy approach for treating triple-negative breast cancer. We demonstrate promising results in preclinical models, suggesting a potential new therapeutic strategy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"therapeutic strategy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69488", "text": "{\n    \"title\": \"Genome-Wide Association Study of Skin Pigmentation\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We conducted a genome-wide association study to identify genetic variants associated with skin pigmentation in a diverse population.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"genetics\",\n        \"skin pigmentation\",\n        \"GWAS\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This research was funded by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69489", "text": "{\n    \"title\": \"A Novel Approach to Contrastive Learning for Self-Supervised Representation Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a novel contrastive learning framework that improves the quality of learned representations without relying on extensive data augmentation techniques.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"contrastive learning\",\n        \"self-supervised learning\",\n        \"representation learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69489", "text": "{\n    \"title\": \"Deep Learning with TensorFlow for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"This paper presents a deep learning model built with TensorFlow for image recognition tasks. We achieve state-of-the-art results on the ImageNet dataset.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"tensorflow\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://arxiv.org/abs/0987654321\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by Google AI.\"\n}"}
{"_id": "Academic--preprints--p--69490", "text": "{\n    \"title\": \"Efficient Training of Deep Neural Networks with Adaptive Learning Rates\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We propose a novel method for training deep neural networks that dynamically adjusts learning rates based on gradient statistics.  This approach significantly accelerates convergence and improves generalization performance.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"optimization\",\n        \"adaptive learning rates\"\n    ],\n    \"doi\": \"10.1234/abc.123\",\n    \"full_text_url\": \"https://example.com/preprint1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant ABC-123456.\"\n}"}
{"_id": "Academic--preprints--n--69490", "text": "{\n    \"title\": \"A Survey of Reinforcement Learning Algorithms\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper provides a comprehensive overview of recent advances in reinforcement learning, covering both theoretical foundations and practical applications.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.5678/def.789\",\n    \"full_text_url\": \"https://example.com/preprint2\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69491", "text": "{\n    \"title\": \"A Novel Approach to Reinforcement Learning with Transformer Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a new reinforcement learning algorithm that leverages the power of transformer networks to achieve state-of-the-art performance on a variety of benchmark tasks.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/paper1.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant #1234567.\"\n}"}
{"_id": "Academic--preprints--n--69491", "text": "{\n    \"title\": \"Deep Learning for Image Recognition: A Comprehensive Review\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"This paper provides a comprehensive review of recent advances in deep learning for image recognition.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/paper2.pdf\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the Simons Foundation for support.\"\n}"}
{"_id": "Academic--preprints--p--69492", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for predicting protein structures from amino acid sequences.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69492", "text": "{\n    \"title\": \"The Role of Genetics in Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"This study investigates the genetic factors contributing to the development of various types of cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"genetics\",\n        \"cancer\",\n        \"genomics\",\n        \"oncology\"\n    ],\n    \"doi\": \"10.1101/789012\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funding provided by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69493", "text": "{\n    \"title\": \"Federated Learning with Differential Privacy for Medical Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel federated learning framework with differential privacy guarantees for training models on distributed medical image datasets. We demonstrate improved performance and privacy preservation compared to existing methods.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"differential privacy\",\n        \"medical imaging\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01-MH123456.\"\n}"}
{"_id": "Academic--preprints--n--69493", "text": "{\n    \"title\": \"A Deep Learning Approach to Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We introduce a new deep learning model for improving performance on a range of natural language processing tasks.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.01234\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69494", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel techniques for improving the performance of deep learning models in natural language processing tasks.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"natural language processing\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/paper123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69494", "text": "{\n    \"title\": \"A Novel Approach to Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper proposes a new algorithm for reinforcement learning that achieves state-of-the-art performance.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"artificial intelligence\"\n    ],\n    \"doi\": \"10.4567/example.456\",\n    \"full_text_url\": \"https://example.com/paper456\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank their collaborators for valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69495", "text": "{\n    \"title\": \"Federated Learning with Differential Privacy for Medical Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper investigates the application of federated learning with differential privacy to medical image analysis. We demonstrate improved privacy-preserving performance on a benchmark dataset.\",\n    \"submission_date\": \"2023-10-27\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"differential privacy\",\n        \"medical imaging\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69495", "text": "{\n    \"title\": \"Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"A comprehensive overview of deep learning techniques applied to natural language processing tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"The authors thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69496", "text": "{\n    \"title\": \"Novel Biomarkers for Predicting Response to PD-1 Blockade in Melanoma\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Dana-Farber Cancer Institute\"\n        }\n    ],\n    \"abstract\": \"We identify a novel set of biomarkers associated with response to PD-1 blockade in melanoma patients. These biomarkers may help to predict which patients will benefit from immunotherapy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"melanoma\",\n        \"PD-1 blockade\",\n        \"immunotherapy\",\n        \"cancer immunotherapy\",\n        \"biomarkers\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69496", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Diego\"\n        }\n    ],\n    \"abstract\": \"This study investigates the complex relationship between gut microbiota and cancer development. We show that certain microbial species can promote tumor growth.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"cancer\",\n        \"microbiome\",\n        \"cancer development\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"This research was funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69497", "text": "{\n    \"title\": \"Advancements in Reinforcement Learning with Transformer Architectures\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel approach to reinforcement learning leveraging transformer architectures, achieving state-of-the-art performance on several benchmark tasks. Our method demonstrates improved sample efficiency and generalization capabilities.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"transformers\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/arxiv.2023.0515\",\n    \"full_text_url\": \"https://arxiv.org/abs/2023.0515\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation under Grant No. 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69497", "text": "{\n    \"title\": \"A Novel Approach to Image Segmentation Using Deep Convolutional Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"We propose a novel deep convolutional network for image segmentation, achieving high accuracy on standard datasets. The method incorporates attention mechanisms to improve performance.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"image processing\",\n        \"image segmentation\",\n        \"deep learning\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.5678/arxiv.2023.0820\",\n    \"full_text_url\": \"https://arxiv.org/abs/2023.0820\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the Defense Advanced Research Projects Agency (DARPA).\"\n}"}
{"_id": "Academic--preprints--p--69498", "text": "{\n    \"title\": \"Improving Transformer Models with Enhanced Attention Mechanisms\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We propose a novel attention mechanism for transformer models that improves performance on various natural language processing tasks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"transformer models\",\n        \"attention mechanisms\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/preprint1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69498", "text": "{\n    \"title\": \"A Survey of Deep Learning Techniques in Computer Vision\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This survey provides an overview of recent advances in deep learning for computer vision applications.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://example.com/preprint2\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The author thanks the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69499", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures from amino acid sequences. Our model achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69499", "text": "{\n    \"title\": \"Genome-Wide Association Study of Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We performed a genome-wide association study to identify genetic variants associated with Alzheimer's disease.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"genome-wide association study\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"This work was funded by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69500", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures with high accuracy. Our model utilizes attention mechanisms and a transformer architecture to capture long-range dependencies in protein sequences.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69500", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Inflammatory Bowel Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"abstract\": \"This study investigates the complex interplay between gut microbiota composition and the development of inflammatory bowel disease. We analyzed fecal samples from patients with Crohn's disease and ulcerative colitis.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"inflammatory bowel disease\",\n        \"microbiome\",\n        \"immunology\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"We thank the patients who participated in this study.\"\n}"}
{"_id": "Academic--preprints--p--69501", "text": "{\n    \"title\": \"Novel Biomarker Discovery for Early-Stage Lung Cancer Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel circulating biomarker panel for the early detection of non-small cell lung cancer. The panel demonstrates high sensitivity and specificity in a cohort of patients.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"biomarkers\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69501", "text": "{\n    \"title\": \"The Role of Inflammation in Breast Cancer Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We investigate the link between chronic inflammation and the progression of breast cancer. Our findings suggest that inflammatory pathways play a critical role in metastasis.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"medRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"inflammation\",\n        \"metastasis\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.medrxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Breast Cancer Research Foundation for funding this research.\"\n}"}
{"_id": "Academic--preprints--p--69502", "text": "{\n    \"title\": \"Advancements in Deep Reinforcement Learning for Robotic Manipulation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint presents novel algorithms for deep reinforcement learning applied to robotic manipulation tasks. We demonstrate improved performance on complex grasping and assembly benchmarks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"robotics\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/arxiv.2311.01234\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69502", "text": "{\n    \"title\": \"A Survey of Generative Models for Image Synthesis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"This paper provides a comprehensive overview of generative models for image synthesis, including GANs, VAEs, and diffusion models.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"generative models\",\n        \"image synthesis\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.5678/biorxiv.2312.00001\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.5678/biorxiv.2312.00001v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69503", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for predicting protein structures from amino acid sequences. Our approach demonstrates improved accuracy compared to existing methods.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69503", "text": "{\n    \"title\": \"Genome-Wide Association Study of Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"A genome-wide association study identifies novel genetic loci associated with an increased risk of Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"GWAS\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Supported by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69504", "text": "{\n    \"title\": \"Advancements in Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel deep learning architecture for image recognition, achieving state-of-the-art results on benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"machine learning\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/paper1.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69504", "text": "{\n    \"title\": \"Reinforcement Learning for Robotic Control\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"We explore the application of reinforcement learning algorithms to robotic control tasks.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"robotics\",\n        \"machine learning\",\n        \"control systems\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/paper2.pdf\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"This research was funded by a private donation.\"\n}"}
{"_id": "Academic--preprints--p--69505", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel deep learning architectures for improved performance on natural language processing tasks.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"transformer networks\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/paper1.pdf\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69505", "text": "{\n    \"title\": \"A Novel Approach to Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a new reinforcement learning algorithm that achieves state-of-the-art results on several benchmark tasks.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"artificial intelligence\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.9876/example.456\",\n    \"full_text_url\": \"https://example.com/paper2.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was funded by a generous donation.\"\n}"}
{"_id": "Academic--preprints--p--69506", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We propose a new method for few-shot learning using transformer networks. Our approach leverages meta-learning techniques to quickly adapt to new tasks with limited data.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"transformers\",\n        \"meta-learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69506", "text": "{\n    \"title\": \"Deep Reinforcement Learning for Robotic Manipulation\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We investigate the use of deep reinforcement learning for training robots to perform complex manipulation tasks.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"robotics\",\n        \"deep learning\",\n        \"manipulation\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://biorxiv.org/abs/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"This research was funded by a grant from the Robotics Institute.\"\n}"}
{"_id": "Academic--preprints--p--69507", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a novel meta-reinforcement learning algorithm for few-shot learning. Our approach significantly improves performance on challenging few-shot learning tasks.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1234/arxiv.2023.0515\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69507", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a deep learning model for image recognition that achieves state-of-the-art results on ImageNet.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"machine learning\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.5678/arxiv.2023.0310\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.56789\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was funded by a Google Research Grant.\"\n}"}
{"_id": "Academic--preprints--p--69508", "text": "{\n    \"title\": \"Efficient Transformers with Dynamic Sparse Attention\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"abstract\": \"We present a novel approach to sparse attention in transformer networks, significantly reducing computational cost without sacrificing performance. Our method dynamically adjusts the sparsity pattern based on input data characteristics.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"transformers\",\n        \"sparse attention\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/arxiv.2023.12345\",\n    \"full_text_url\": \"https://arxiv.org/abs/2023.12345\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69508", "text": "{\n    \"title\": \"Improving Language Modeling with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper explores techniques for improving language modeling performance using transformer architectures. We focus on pre-training strategies and fine-tuning methods.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"transformers\",\n        \"language modeling\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.5678/arxiv.2023.67890\",\n    \"full_text_url\": \"https://arxiv.org/abs/2023.67890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank the reviewers for their insightful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69509", "text": "{\n    \"title\": \"A Novel Approach to Federated Learning with Differential Privacy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a novel federated learning framework that incorporates differential privacy to protect sensitive user data. We demonstrate improved performance compared to existing approaches.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"federated learning\",\n        \"differential privacy\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF Grant No. 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69509", "text": "{\n    \"title\": \"Deep Reinforcement Learning for Robotics\",\n    \"authors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a deep reinforcement learning approach for controlling robotic manipulators. Our method achieves state-of-the-art performance on several benchmark tasks.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"robotics\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.456\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was funded by a Google Research Grant.\"\n}"}
{"_id": "Academic--preprints--p--69510", "text": "{\n    \"title\": \"Deep Learning for Early Cancer Detection from Histopathology Images\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This study investigates the application of deep learning techniques to improve the accuracy and efficiency of early cancer detection using histopathology images. We propose a novel convolutional neural network architecture that achieves state-of-the-art performance on a large dataset of cancer samples.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"cancer\",\n        \"histopathology\",\n        \"image analysis\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Institutes of Health.\"\n}"}
{"_id": "Academic--preprints--n--69510", "text": "{\n    \"title\": \"Machine Learning Approaches to Predicting Cancer Drug Response\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a machine learning pipeline for predicting patient response to different cancer drugs based on genomic and clinical data.  The model utilizes a random forest algorithm and demonstrates promising results in a validation cohort.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"cancer\",\n        \"drug response\",\n        \"genomics\",\n        \"clinical data\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funding was provided by the Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69511", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a novel meta-learning framework for few-shot learning, leveraging transformer architectures. Our approach demonstrates state-of-the-art performance on benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Meta-Learning\",\n        \"Few-Shot Learning\",\n        \"Transformers\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": null\n}"}
{"_id": "Academic--preprints--n--69511", "text": "{\n    \"title\": \"Deep Reinforcement Learning for Robotic Manipulation\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"We investigate the use of deep reinforcement learning for controlling robotic arms in complex manipulation tasks. Results show improved performance compared to traditional methods.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Reinforcement Learning\",\n        \"Robotics\",\n        \"Deep Learning\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.05678\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation under grant number XYZ123.\"\n}"}
{"_id": "Academic--preprints--p--69512", "text": "{\n    \"title\": \"A Novel Approach to Image Recognition using Deep Convolutional Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a new deep convolutional network architecture for image recognition. Our approach achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"deep learning\",\n        \"image recognition\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/example\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69512", "text": "{\n    \"title\": \"Improving Object Detection with Transformer Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a novel transformer-based approach for object detection. Our results demonstrate significant improvements over existing methods.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"object detection\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://biorxiv.org/abs/example2\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank NVIDIA for the GPU donation.\"\n}"}
{"_id": "Academic--preprints--p--69513", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This preprint details novel techniques for improving the performance of deep learning models on natural language processing tasks.\",\n    \"submission_date\": \"2023-06-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"natural language processing\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/preprint1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by a grant from the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69513", "text": "{\n    \"title\": \"A Novel Approach to Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This preprint proposes a new reinforcement learning algorithm with improved sample efficiency.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/preprint2\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank their colleagues for helpful discussions.\"\n}"}
{"_id": "Academic--preprints--p--69514", "text": "{\n    \"title\": \"Novel therapeutic target for triple-negative breast cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase that is highly expressed in triple-negative breast cancer cells and demonstrate its potential as a therapeutic target.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"triple-negative\",\n        \"kinase\",\n        \"therapy\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69514", "text": "{\n    \"title\": \"The role of inflammation in lung cancer progression\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study investigates the inflammatory microenvironment in lung cancer and its impact on tumor growth and metastasis.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"inflammation\",\n        \"metastasis\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"We thank the American Cancer Society for funding this research.\"\n}"}
{"_id": "Academic--preprints--p--69515", "text": "{\n    \"title\": \"Novel Biomarkers for Early-Stage Lung Cancer Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We identify novel circulating biomarkers that demonstrate potential for early-stage lung cancer detection using a cohort of patient samples. These biomarkers show improved sensitivity and specificity compared to existing methods.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"biomarkers\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69515", "text": "{\n    \"title\": \"The Role of Inflammation in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"We investigate the role of neuroinflammation in the progression of Alzheimer's disease and identify potential therapeutic targets.  Our results suggest a link between microglial activation and amyloid plaque formation.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"inflammation\",\n        \"neurodegeneration\",\n        \"microglia\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funding provided by the Alzheimer's Association.\"\n}"}
