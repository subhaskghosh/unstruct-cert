{"_id": "Academic--preprints--p--69469", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper proposes a novel meta-reinforcement learning framework for few-shot learning. We demonstrate significant improvements over existing methods on benchmark datasets.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69469", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for image recognition. Our model achieves state-of-the-art performance on ImageNet.\",\n    \"submission_date\": \"2023-11-10\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://arxiv.org/abs/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by Google AI.\"\n}"}
