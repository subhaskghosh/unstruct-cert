{"_id": "Academic--preprints--p--69558", "text": "{\n    \"title\": \"Novel Biomarkers for Early Detection of Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We identify a panel of novel circulating biomarkers for the early detection of pancreatic cancer using a combination of proteomics and machine learning.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"pancreatic cancer\",\n        \"biomarkers\",\n        \"proteomics\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/123456.0\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.0\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
