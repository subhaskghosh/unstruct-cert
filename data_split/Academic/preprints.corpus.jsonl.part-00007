{"_id": "Academic--preprints--n--69399", "text": "{\n    \"title\": \"Novel Machine Learning Techniques for Gene Expression Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We investigate the application of machine learning to identify patterns in gene expression data.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gene expression\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Broad Institute for providing computational resources.\"\n}"}
{"_id": "Academic--preprints--p--69400", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a novel meta-reinforcement learning algorithm for few-shot learning. Our approach leverages the power of reinforcement learning to quickly adapt to new tasks with limited data.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": null,\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant...\"\n}"}
{"_id": "Academic--preprints--n--69400", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper presents a comprehensive overview of deep learning techniques for image recognition.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.1000/123456\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.05678\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for GPU support.\"\n}"}
{"_id": "Academic--preprints--p--69401", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein involved in the proliferation of triple-negative breast cancer cells. Inhibition of this protein significantly reduces tumor growth in preclinical models.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"triple-negative\",\n        \"therapy\",\n        \"target\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69401", "text": "{\n    \"title\": \"The Role of MicroRNAs in Lung Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the dysregulation of microRNAs in lung cancer and their impact on tumor progression.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"microRNA\",\n        \"oncogenesis\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69402", "text": "{\n    \"title\": \"Novel Biomarker for Early Detection of Lung Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies a novel biomarker for the early detection of lung cancer, improving diagnostic accuracy and patient outcomes.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"biomarker\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69402", "text": "{\n    \"title\": \"The Role of Genetics in Breast Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This preprint investigates the genetic factors contributing to breast cancer development.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"genetics\"\n    ],\n    \"doi\": \"10.1101/0987654321\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/0987654321\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funded by the Breast Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69403", "text": "{\n    \"title\": \"Advancements in Deep Reinforcement Learning for Robotics\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This preprint presents a novel approach to deep reinforcement learning for robotic manipulation tasks. We demonstrate improved performance on several benchmark problems.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"robotics\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69403", "text": "{\n    \"title\": \"A Survey of Machine Learning Techniques in Healthcare\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint provides a comprehensive overview of machine learning applications in healthcare, including diagnosis, treatment planning, and drug discovery.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"healthcare\",\n        \"artificial intelligence\",\n        \"medical imaging\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://biorxiv.org/abs/example.456\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the funding agencies for their support.\"\n}"}
{"_id": "Academic--preprints--p--69404", "text": "{\n    \"title\": \"Novel Immunotherapy Approaches for Advanced Lung Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates new immunotherapy strategies for treating advanced non-small cell lung cancer, showing promising results in preclinical models.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"lung cancer\",\n        \"treatment\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69404", "text": "{\n    \"title\": \"The Role of Genetics in Breast Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores the genetic factors contributing to the development of breast cancer, identifying several novel gene mutations.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"medRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"genetics\",\n        \"breast cancer\",\n        \"mutation\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.medrxiv.org/content/10.1101/9876543210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"Supported by the Breast Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69405", "text": "{\n    \"title\": \"Enhancing CAR-T Cell Therapy with Novel Checkpoint Inhibitors\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We investigated the synergistic effects of combining CAR-T cell therapy with PD-1 and CTLA-4 checkpoint inhibitors in a preclinical model of leukemia. Our results demonstrate significantly improved tumor clearance and prolonged survival.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"CAR-T cell therapy\",\n        \"cancer immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"leukemia\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69405", "text": "{\n    \"title\": \"The Role of MicroRNAs in Breast Cancer Metastasis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study identifies several microRNAs that are differentially expressed in metastatic breast cancer cells. These microRNAs may serve as potential therapeutic targets.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"breast cancer\",\n        \"metastasis\",\n        \"microRNA\",\n        \"cancer biology\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funded by the Breast Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69406", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new meta-learning algorithm for few-shot learning tasks. We achieve state-of-the-art performance on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Meta-Learning\",\n        \"Few-Shot Learning\"\n    ],\n    \"doi\": \"10.1234/arxiv.2023.0315\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant No. 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69406", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We present a deep learning model for image recognition that achieves high accuracy on ImageNet.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Deep Learning\",\n        \"Image Recognition\"\n    ],\n    \"doi\": \"10.5678/arxiv.2023.0520\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.06789\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPUs.\"\n}"}
