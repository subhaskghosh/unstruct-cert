{"_id": "Academic--preprints--p--69813", "text": "{\n    \"title\": \"Scaling Laws for Neural Language Models\",\n    \"authors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"abstract\": \"We investigate the scaling laws governing the performance of neural language models. Our results show a clear power-law relationship between model size, dataset size, and performance.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Large Language Models\",\n        \"Scaling Laws\",\n        \"Deep Learning\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
