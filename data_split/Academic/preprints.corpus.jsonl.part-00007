{"_id": "Academic--preprints--p--69471", "text": "{\n    \"title\": \"Novel Therapeutic Target for Aggressive Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies a novel therapeutic target for aggressive breast cancer subtypes. Our findings demonstrate that inhibiting protein X leads to significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"therapy\",\n        \"target discovery\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69471", "text": "{\n    \"title\": \"The Role of MicroRNAs in Lung Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint investigates the role of microRNAs in lung cancer development and progression. We present evidence suggesting that miR-21 is a key regulator of cell proliferation.\",\n    \"submission_date\": \"2023-03-10\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"lung cancer\",\n        \"microRNA\",\n        \"regulation\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by the American Cancer Society.\"\n}"}
