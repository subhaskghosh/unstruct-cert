{"_id": "Academic--preprints--p--69711", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structure with improved accuracy.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456.0\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.0\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69711", "text": "{\n    \"title\": \"The Role of Genetics in Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"abstract\": \"This research investigates the genetic factors contributing to cancer development.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"genetics\",\n        \"cancer\",\n        \"oncology\",\n        \"genomics\"\n    ],\n    \"doi\": \"10.1101/789012.0\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.0\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the American Cancer Society for funding.\"\n}"}
{"_id": "Academic--preprints--p--69712", "text": "{\n    \"title\": \"Novel Combination Therapy Enhances Anti-Tumor Immunity in Murine Models\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates a novel combination therapy that synergistically enhances anti-tumor immunity in murine models. The results demonstrate significant tumor regression and prolonged survival.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"tumor microenvironment\",\n        \"immune checkpoint blockade\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69712", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores the complex interplay between the gut microbiota and cancer development, focusing on the impact of microbial metabolites on tumor progression.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"cancer\",\n        \"microbial metabolites\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69713", "text": "{\n    \"title\": \"Advancements in Deep Reinforcement Learning for Robotics\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel approaches to deep reinforcement learning for robotic manipulation tasks. We demonstrate improved performance and robustness in complex environments.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"robotics\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/preprint1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69713", "text": "{\n    \"title\": \"A Novel Approach to Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We propose a new model for natural language understanding, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"machine learning\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://example.com/preprint2\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank the Allen Institute for generous support.\"\n}"}
{"_id": "Academic--preprints--p--69714", "text": "{\n    \"title\": \"Novel Therapeutic Target in Glioblastoma Multiforme\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein interaction crucial for glioblastoma cell survival. Inhibition of this interaction leads to significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"glioblastoma\",\n        \"cancer\",\n        \"therapy\",\n        \"protein interaction\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01NS123456.\"\n}"}
{"_id": "Academic--preprints--n--69714", "text": "{\n    \"title\": \"The Role of MicroRNAs in Breast Cancer Metastasis\",\n    \"authors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the role of specific microRNAs in regulating the metastatic potential of breast cancer cells.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"breast cancer\",\n        \"metastasis\",\n        \"microRNA\",\n        \"cancer\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funded by the Breast Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69715", "text": "{\n    \"title\": \"Improved Transformer Architectures for Time Series Forecasting\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a novel transformer architecture for time series forecasting that achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"time series\",\n        \"machine learning\",\n        \"transformer networks\",\n        \"forecasting\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation under grant number CNS-1900000.\"\n}"}
{"_id": "Academic--preprints--n--69715", "text": "{\n    \"title\": \"Federated Learning for Privacy-Preserving Medical Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We present a federated learning approach for training models on distributed medical image datasets while preserving patient privacy.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"machine learning\",\n        \"medical imaging\",\n        \"privacy\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://arxiv.org/abs/2308.67890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research benefited from access to computational resources provided by the Massachusetts Institute of Technology.\"\n}"}
{"_id": "Academic--preprints--p--69716", "text": "{\n    \"title\": \"Transformer-Based Models for Low-Resource Machine Translation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint explores the application of transformer models to machine translation in scenarios with limited parallel data. We propose a novel pre-training strategy that improves performance on low-resource language pairs.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"machine translation\",\n        \"transformer models\",\n        \"low-resource languages\"\n    ],\n    \"doi\": \"10.1234/abc.2023.03.15\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.12345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69716", "text": "{\n    \"title\": \"A Survey of Deep Learning Techniques in Computer Vision\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"abstract\": \"This survey provides a comprehensive overview of recent advances in deep learning for computer vision tasks, including image classification, object detection, and image segmentation.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"computer vision\",\n        \"image recognition\",\n        \"object detection\"\n    ],\n    \"doi\": \"10.5678/def.2023.05.20\",\n    \"full_text_url\": \"https://biorxiv.org/content/earlyrel/doi/10.5678/def.2023.05.20\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69717", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Melanoma Treatment\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates a novel combination therapy utilizing two checkpoint inhibitors for the treatment of metastatic melanoma. Results demonstrate enhanced anti-tumor activity and improved patient survival rates.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"melanoma\",\n        \"checkpoint inhibitors\",\n        \"cancer immunotherapy\",\n        \"PD-1\",\n        \"CTLA-4\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69717", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Asthma Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study explores the correlation between gut microbiome composition and the development of asthma in children. We identify specific bacterial species associated with increased risk.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"asthma\",\n        \"gut microbiome\",\n        \"inflammation\",\n        \"children's health\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the participants and the funding from the American Lung Association.\"\n}"}
{"_id": "Academic--preprints--p--69718", "text": "{\n    \"title\": \"Novel Immunotherapy Targets for Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates new immunotherapy approaches for treating pancreatic cancer, focusing on the role of T-cell exhaustion and potential targets for intervention.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"pancreatic cancer\",\n        \"T-cells\"\n    ],\n    \"doi\": \"10.1101/2023.0315.123456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.0315.123456v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the National Institutes of Health (NIH) grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69718", "text": "{\n    \"title\": \"The Role of Genetics in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores the genetic factors contributing to the development of Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's\",\n        \"genetics\",\n        \"neurodegenerative disease\"\n    ],\n    \"doi\": \"10.1101/2023.0520.789012\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.0520.789012v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Alzheimer's Association for their support.\"\n}"}
{"_id": "Academic--preprints--p--69719", "text": "{\n    \"title\": \"Novel Biomarker for Early Detection of Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies a novel circulating biomarker for the early detection of pancreatic cancer, improving diagnostic accuracy and patient outcomes.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"biomarker\",\n        \"pancreatic cancer\",\n        \"early detection\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69719", "text": "{\n    \"title\": \"Genetic Predisposition to Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We investigated the genetic factors contributing to the development of Alzheimer's disease in a large cohort study.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"neurodegeneration\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69720", "text": "{\n    \"title\": \"Targeting Mutant KRAS in Pancreatic Cancer with Novel Inhibitors\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University, Department of Biology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT, Koch Institute\"\n        }\n    ],\n    \"abstract\": \"We report the discovery of a novel series of inhibitors targeting mutant KRAS in pancreatic cancer. These inhibitors demonstrate potent anti-tumor activity in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"KRAS\",\n        \"inhibitors\",\n        \"pancreatic cancer\",\n        \"targeted therapy\"\n    ],\n    \"doi\": \"10.1101/2023.03.15.532187\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.532187v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69720", "text": "{\n    \"title\": \"The Role of Microbiota in Colorectal Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University, School of Medicine\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study investigates the relationship between gut microbiota composition and the development of colorectal cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"microbiota\",\n        \"colorectal cancer\",\n        \"gut health\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.678901\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.678901v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Funded by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69721", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for accurate protein structure prediction, achieving state-of-the-art results on CASP15.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69721", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"This study investigates the correlation between gut microbiome composition and the progression of Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiome\",\n        \"Alzheimer's disease\",\n        \"neuroscience\",\n        \"microbiology\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Alzheimer's Association for funding.\"\n}"}
{"_id": "Academic--preprints--p--69722", "text": "{\n    \"title\": \"Novel Therapeutic Target for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"This study identifies a novel protein kinase as a potential therapeutic target for triple-negative breast cancer. We demonstrate that inhibition of this kinase leads to significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"triple-negative\",\n        \"therapy\",\n        \"kinase\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69722", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"We investigate the relationship between the gut microbiome composition and the development of Alzheimer's disease. Our findings suggest that dysbiosis may contribute to neuroinflammation.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"microbiome\",\n        \"neuroinflammation\",\n        \"gut health\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This research was funded by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69723", "text": "{\n    \"title\": \"Deep Learning for Diabetic Retinopathy Detection using Fundus Images\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University, Department of Ophthalmology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for the automated detection of diabetic retinopathy from fundus images. Our model achieves state-of-the-art performance on a large publicly available dataset.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"diabetic retinopathy\",\n        \"medical imaging\",\n        \"fundus images\"\n    ],\n    \"doi\": \"10.1101/2023.03.15.532187\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.532187v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by a grant from the National Institutes of Health.\"\n}"}
{"_id": "Academic--preprints--n--69723", "text": "{\n    \"title\": \"Evolutionary Dynamics of Viral Populations\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University, Department of Biology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"We investigate the evolutionary dynamics of viral populations under different selective pressures. Our results provide insights into the emergence of drug resistance.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"viral evolution\",\n        \"population genetics\",\n        \"drug resistance\",\n        \"evolutionary biology\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.648921\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.648921v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by the Simons Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69724", "text": "{\n    \"title\": \"Scalable Deep Learning with Sparse Activation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel approach to scalable deep learning using sparse activation functions. Our method significantly reduces computational cost and memory usage without sacrificing accuracy.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"sparse activation\",\n        \"scalability\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://example.com/paper123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69724", "text": "{\n    \"title\": \"Advancements in Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper explores recent advancements in natural language processing techniques, focusing on transformer models and their applications.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"transformer models\",\n        \"NLP\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://example.com/paper456\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Allen Institute for generous support.\"\n}"}
{"_id": "Academic--preprints--p--69725", "text": "{\n    \"title\": \"Deep learning for protein structure prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University, Department of Biology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structure with high accuracy. Our model significantly outperforms existing methods on benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"biology\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69725", "text": "{\n    \"title\": \"The role of gut microbiome in autoimmune diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"This study investigates the link between gut microbiome composition and the development of autoimmune diseases. We identified several bacterial species associated with increased disease risk.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiome\",\n        \"autoimmune diseases\",\n        \"immunology\",\n        \"microbiology\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the American Heart Association.\"\n}"}
{"_id": "Academic--preprints--p--69726", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination Enhances Anti-Tumor Immunity\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates a novel combination therapy using checkpoint inhibitors to enhance anti-tumor immunity in melanoma patients. Results demonstrate significant improvements in tumor regression and overall survival.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"melanoma\",\n        \"anti-tumor immunity\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69726", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Autoimmune Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores the complex relationship between the gut microbiota and the development of autoimmune diseases. We identified specific microbial signatures associated with increased disease risk.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"autoimmune disease\",\n        \"inflammation\",\n        \"microbiome\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"This study was funded by the Gates Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69727", "text": "{\n    \"title\": \"Novel Therapeutic Targets in Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies potential new drug targets for pancreatic cancer based on genomic analysis.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"pancreatic cancer\",\n        \"genomics\",\n        \"drug targets\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by NIH Grant R01CA123456\"\n}"}
{"_id": "Academic--preprints--n--69727", "text": "{\n    \"title\": \"The Role of Inflammation in Breast Cancer Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores the link between chronic inflammation and the development of breast cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"inflammation\",\n        \"immunology\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Supported by the Breast Cancer Research Foundation\"\n}"}
{"_id": "Academic--preprints--p--69728", "text": "{\n    \"title\": \"Advancements in Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This preprint explores novel deep learning architectures for improved performance in natural language processing tasks.\",\n    \"submission_date\": \"2023-10-27\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"machine learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/nlp.001\",\n    \"full_text_url\": \"https://example.com/nlp_preprint.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69728", "text": "{\n    \"title\": \"A Novel Approach to Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a new reinforcement learning algorithm with improved sample efficiency.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"artificial intelligence\",\n        \"control theory\"\n    ],\n    \"doi\": \"10.5678/rl.002\",\n    \"full_text_url\": \"https://example.com/rl_preprint.pdf\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was funded by a private donation.\"\n}"}
{"_id": "Academic--preprints--p--69729", "text": "{\n    \"title\": \"A Novel Approach to Federated Learning with Differential Privacy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper proposes a new framework for federated learning that incorporates differential privacy to protect user data. We demonstrate significant improvements in model accuracy compared to existing methods.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"federated learning\",\n        \"machine learning\",\n        \"differential privacy\",\n        \"privacy-preserving AI\"\n    ],\n    \"doi\": \"10.1234/arxiv.2023.0315.1\",\n    \"full_text_url\": \"https://arxiv.org/abs/2023.0315.1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69729", "text": "{\n    \"title\": \"Efficient Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for image recognition that achieves state-of-the-art performance on the ImageNet dataset.\",\n    \"submission_date\": \"2023-06-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.5678/arxiv.2023.0620.2\",\n    \"full_text_url\": \"https://arxiv.org/abs/2023.0620.2\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank NVIDIA for providing GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69730", "text": "{\n    \"title\": \"Targeting CD47 to Enhance Cancer Immunotherapy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We demonstrate that blocking the CD47-SIRPα axis enhances the efficacy of PD-1 checkpoint inhibitors in murine models of cancer. This suggests a novel therapeutic strategy for improving cancer immunotherapy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"CD47\",\n        \"SIRPα\",\n        \"PD-1\",\n        \"tumor microenvironment\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69730", "text": "{\n    \"title\": \"Novel Biomarkers for Early Cancer Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"We identify a panel of circulating microRNAs that show promise as biomarkers for early detection of several cancer types.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"biomarkers\",\n        \"microRNAs\",\n        \"cancer detection\",\n        \"early diagnosis\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by the Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69731", "text": "{\n    \"title\": \"Efficient Object Detection with Transformer-Based Models\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel approach to object detection using transformer networks, achieving state-of-the-art performance on standard benchmarks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"object detection\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69731", "text": "{\n    \"title\": \"Generative Models for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We propose a new generative model for text, capable of producing highly coherent and realistic passages.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"generative models\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://biorxiv.org/content/10.1101/1234567\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was funded by a private donation.\"\n}"}
{"_id": "Academic--preprints--p--69732", "text": "{\n    \"title\": \"Scaling Laws for Neural Language Models with Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Kaplan, Jared\",\n            \"affiliation\": \"OpenAI\"\n        },\n        {\n            \"name\": \"McCarthy, Sam\",\n            \"affiliation\": \"OpenAI\"\n        }\n    ],\n    \"abstract\": \"We demonstrate that the performance of neural language models scales predictably with model size, dataset size, and compute.  Our findings suggest that scaling up these models can lead to substantial improvements in performance.\",\n    \"submission_date\": \"2023-02-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"transformers\",\n        \"language models\",\n        \"scaling laws\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.48550/arXiv.2302.08746\",\n    \"full_text_url\": \"https://arxiv.org/abs/2302.08746\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by OpenAI.\"\n}"}
{"_id": "Academic--preprints--n--69732", "text": "{\n    \"title\": \"Efficient Attention Mechanisms for Long Sequences\",\n    \"authors\": [\n        {\n            \"name\": \"Child, Rowan\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"Lee, Jaehyun\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"abstract\": \"We propose a novel attention mechanism that reduces the computational complexity of transformers when dealing with very long sequences. This allows for the efficient processing of documents and other large text inputs.\",\n    \"submission_date\": \"2022-12-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"transformers\",\n        \"attention mechanisms\",\n        \"long sequences\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.48550/arXiv.2212.07015\",\n    \"full_text_url\": \"https://arxiv.org/abs/2212.07015\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Supported by Google Research.\"\n}"}
{"_id": "Academic--preprints--p--69733", "text": "{\n    \"title\": \"Advancements in Transformer Architectures for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper presents novel improvements to the transformer architecture, focusing on attention mechanisms and positional encoding. We demonstrate superior performance on several NLP benchmarks.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"transformers\",\n        \"natural language processing\"\n    ],\n    \"doi\": \"10.1234/arxiv.2311.0001\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.0001\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by the NSF Grant ABC-123.\"\n}"}
{"_id": "Academic--preprints--n--69733", "text": "{\n    \"title\": \"A Novel Approach to Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"We introduce a new reinforcement learning algorithm that improves sample efficiency and stability. The algorithm is based on...\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"artificial intelligence\",\n        \"control theory\"\n    ],\n    \"doi\": \"10.5678/biorxiv.2312.0002\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.12.01.864532v1\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"We thank the MIT AI Lab for support.\"\n}"}
{"_id": "Academic--preprints--p--69734", "text": "{\n    \"title\": \"Efficient Training of Deep Neural Networks for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel method for efficiently training deep neural networks, achieving state-of-the-art results on image recognition tasks.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"image recognition\",\n        \"neural networks\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/example\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69734", "text": "{\n    \"title\": \"A Novel Approach to Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new technique for processing natural language, demonstrating improved performance on sentiment analysis tasks.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"sentiment analysis\",\n        \"machine learning\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://arxiv.org/abs/another_example\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69735", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Reinforcement Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a new meta-reinforcement learning algorithm for few-shot learning that achieves state-of-the-art performance on a variety of benchmark tasks.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"few-shot learning\",\n        \"meta-learning\",\n        \"reinforcement learning\"\n    ],\n    \"doi\": \"10.1101/12345.0\",\n    \"full_text_url\": \"https://arxiv.org/abs/12345.0\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69735", "text": "{\n    \"title\": \"Efficient Deep Learning for Image Classification\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for image classification that achieves high accuracy with reduced computational cost.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image classification\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.1101/67890.1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/67890.1v1\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This research was funded by NIH.\"\n}"}
{"_id": "Academic--preprints--p--69736", "text": "{\n    \"title\": \"Novel Immunotherapy for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Dana-Farber Cancer Institute\"\n        }\n    ],\n    \"abstract\": \"We present a novel immunotherapy approach for treating triple-negative breast cancer. This therapy utilizes engineered T cells to target tumor-specific antigens, leading to significant tumor regression in preclinical models. Our findings suggest a promising new treatment avenue for this aggressive cancer subtype.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"treatment\",\n        \"T cells\"\n    ],\n    \"doi\": \"10.1101/123456.1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funding from the NIH.\"\n}"}
{"_id": "Academic--preprints--n--69736", "text": "{\n    \"title\": \"Genetic Basis of Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"This study investigates the genetic risk factors associated with Alzheimer's disease. We performed a genome-wide association study and identified several novel loci significantly associated with disease onset. Our results provide insights into the underlying mechanisms of Alzheimer's pathology.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"neurodegeneration\",\n        \"genetics\",\n        \"risk factors\"\n    ],\n    \"doi\": \"10.1101/789012.3\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.3\",\n    \"status\": \"completed\",\n    \"acknowledgements\": \"Supported by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69737", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We propose a novel meta-learning framework based on transformers for few-shot learning. Our approach achieves state-of-the-art performance on several benchmark datasets.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"meta-learning\",\n        \"transformers\",\n        \"few-shot learning\"\n    ],\n    \"doi\": \"10.1101/12345.6\",\n    \"full_text_url\": \"https://arxiv.org/abs/12345.6\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69737", "text": "{\n    \"title\": \"Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint explores the application of deep learning techniques to various NLP tasks, including machine translation and sentiment analysis.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"natural language processing\",\n        \"machine translation\",\n        \"sentiment analysis\"\n    ],\n    \"doi\": \"10.1101/78901.2\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/78901.2\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69738", "text": "{\n    \"title\": \"A Novel Approach to Sentiment Analysis using Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a novel transformer-based model for sentiment analysis. We achieve state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"transformers\",\n        \"sentiment analysis\"\n    ],\n    \"doi\": \"10.1101/1234567.89012345\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567.89012345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 1234567.\"\n}"}
{"_id": "Academic--preprints--n--69738", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a deep learning model for image recognition. The model achieves high accuracy on the ImageNet dataset.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"image recognition\"\n    ],\n    \"doi\": \"10.1101/9876543.21098765\",\n    \"full_text_url\": \"https://biorxiv.org/abs/9876543.21098765\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank NVIDIA for providing the GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69739", "text": "{\n    \"title\": \"Advancements in Transformer-Based Deep Learning for Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This preprint explores novel architectures and training techniques for transformer models, achieving state-of-the-art results on several NLP benchmarks.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"transformers\",\n        \"natural language processing\",\n        \"NLP\"\n    ],\n    \"doi\": \"10.2200/S008178X0V001X001A\",\n    \"full_text_url\": \"https://arxiv.org/abs/2401.00001\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant IIS-2212345.\"\n}"}
{"_id": "Academic--preprints--n--69739", "text": "{\n    \"title\": \"A Comparative Study of Deep Learning Methods for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We compare the performance of different deep learning architectures on a standard image recognition dataset.\",\n    \"submission_date\": \"2023-11-01\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.1101/1234567.890\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.00002\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"The authors thank NVIDIA for GPU support.\"\n}"}
{"_id": "Academic--preprints--p--69740", "text": "{\n    \"title\": \"Scalable Deep Learning for Biomedical Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning architecture for scalable biomedical image analysis. Our method achieves state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"image analysis\",\n        \"biomedical imaging\"\n    ],\n    \"doi\": \"10.1101/1234567.89012345\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567.89012345\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69740", "text": "{\n    \"title\": \"Advancements in Natural Language Processing\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new approach to natural language processing, focusing on transformer models and attention mechanisms.\",\n    \"submission_date\": \"2024-02-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"natural language processing\",\n        \"machine learning\",\n        \"transformer models\"\n    ],\n    \"doi\": \"10.1101/9876543.21098765\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543.21098765v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"The authors thank the reviewers for their helpful feedback.\"\n}"}
{"_id": "Academic--preprints--p--69741", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning approach for predicting protein structures from amino acid sequences. Our method achieves state-of-the-art accuracy on benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by the National Science Foundation.\"\n}"}
{"_id": "Academic--preprints--n--69741", "text": "{\n    \"title\": \"Genetic Basis of Disease Resistance in Plants\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We investigate the genetic mechanisms underlying disease resistance in a model plant species. Our findings identify several key genes involved in the immune response.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"plant genetics\",\n        \"disease resistance\",\n        \"immunology\",\n        \"genomics\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This research was funded by the Bill & Melinda Gates Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69742", "text": "{\n    \"title\": \"Novel Biomarkers for Early Detection of Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study identifies a panel of novel biomarkers for the early detection of pancreatic cancer using a combination of genomic and proteomic analysis. These biomarkers show promising results in preclinical studies.\",\n    \"submission_date\": \"2024-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"biomarkers\",\n        \"pancreatic cancer\",\n        \"genomics\",\n        \"proteomics\"\n    ],\n    \"doi\": \"10.1101/2024.0315.123456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2024.0315.123456\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69742", "text": "{\n    \"title\": \"The Role of Microbiota in Colon Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores the complex interplay between the gut microbiota and the development of colon cancer. We investigate the mechanisms by which specific bacterial species influence tumor growth and metastasis.\",\n    \"submission_date\": \"2024-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"microbiota\",\n        \"colon cancer\",\n        \"gut microbiome\"\n    ],\n    \"doi\": \"10.1101/2024.0520.789012\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2024.0520.789012\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funding was provided by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69743", "text": "{\n    \"title\": \"Deep Learning for Automated Diagnosis of Retinal Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We present a novel deep learning model for the automated diagnosis of retinal diseases from fundus images. Our model achieves state-of-the-art performance on multiple benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"retinal diseases\",\n        \"image analysis\",\n        \"healthcare\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01GM123456.\"\n}"}
{"_id": "Academic--preprints--n--69743", "text": "{\n    \"title\": \"Evolutionary Dynamics of Viral Populations\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We investigate the evolutionary dynamics of viral populations using a combination of theoretical modeling and experimental data.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"viral evolution\",\n        \"population genetics\",\n        \"mathematical modeling\",\n        \"biology\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by the NSF.\"\n}"}
{"_id": "Academic--preprints--p--69744", "text": "{\n    \"title\": \"A Novel Machine Learning Approach for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We present a new machine learning model for predicting protein structures with improved accuracy and efficiency.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"protein structure\",\n        \"bioinformatics\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69744", "text": "{\n    \"title\": \"Impact of Climate Change on Coral Reefs\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Marine Biology Institute\"\n        }\n    ],\n    \"abstract\": \"This study investigates the effects of rising ocean temperatures on coral reef ecosystems.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"climate change\",\n        \"coral reefs\",\n        \"marine biology\",\n        \"oceanography\"\n    ],\n    \"doi\": \"10.5678/example.2\",\n    \"full_text_url\": \"https://biorxiv.org/abs/example.2\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the Ocean Conservancy for their support.\"\n}"}
{"_id": "Academic--preprints--p--69745", "text": "{\n    \"title\": \"Novel Therapeutic Target for Aggressive Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein kinase involved in the progression of triple-negative breast cancer and demonstrate its therapeutic potential in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"therapy\",\n        \"kinase\",\n        \"triple-negative\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69745", "text": "{\n    \"title\": \"The Role of Gut Microbiome in Colon Cancer Development\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This study investigates the correlation between specific gut bacteria and the development of colon cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"colon cancer\",\n        \"gut microbiome\",\n        \"microbiology\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Supported by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69746", "text": "{\n    \"title\": \"A Novel Approach to Image Segmentation using Deep Learning\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper presents a novel deep learning architecture for image segmentation, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-11-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"image segmentation\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/2311.01234\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"This work was supported by NSF Grant XYZ.\"\n}"}
{"_id": "Academic--preprints--n--69746", "text": "{\n    \"title\": \"Enhancing Object Detection with Attention Mechanisms\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"We propose a novel attention mechanism to improve the performance of object detection models.\",\n    \"submission_date\": \"2023-12-01\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"computer vision\",\n        \"object detection\",\n        \"attention mechanisms\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.12.01.864589v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank the reviewers for their valuable feedback.\"\n}"}
{"_id": "Academic--preprints--p--69747", "text": "{\n    \"title\": \"A Novel Approach to Transformer-Based Sentiment Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"We propose a new method for sentiment analysis using transformer networks, achieving state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Natural Language Processing\",\n        \"Sentiment Analysis\",\n        \"Transformers\"\n    ],\n    \"doi\": \"10.1234/example.1\",\n    \"full_text_url\": \"https://example.com/paper1.pdf\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant XYZ.\"\n}"}
