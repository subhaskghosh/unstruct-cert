{"_id": "Academic--preprints--p--69863", "text": "{\n    \"title\": \"Deep Learning for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University, Department of Biochemistry\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This preprint explores the application of deep learning techniques to predict protein structures, significantly improving accuracy in biological contexts. We demonstrate the use of novel convolutional neural networks for modeling protein folding.\",\n    \"submission_date\": \"2024-02-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"protein structure\",\n        \"deep learning\",\n        \"biology\",\n        \"bioinformatics\"\n    ],\n    \"doi\": \"10.1101/12345678.90\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/12345678.90\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NIH grant R01GM123456.\"\n}"}
