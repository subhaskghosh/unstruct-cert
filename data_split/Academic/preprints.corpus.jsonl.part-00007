{"_id": "Academic--preprints--p--69757", "text": "{\n    \"title\": \"Novel Therapeutic Target in Glioblastoma\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"abstract\": \"We identify a novel protein interaction crucial for glioblastoma cell survival. Inhibition of this interaction leads to significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"glioblastoma\",\n        \"cancer\",\n        \"therapeutic target\",\n        \"protein interaction\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69757", "text": "{\n    \"title\": \"The Role of Microbiomes in Autoimmune Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"abstract\": \"This study investigates the complex interplay between gut microbiomes and the development of autoimmune disorders. We identify specific microbial signatures associated with different autoimmune conditions.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"microbiome\",\n        \"autoimmune disease\",\n        \"inflammation\",\n        \"gut health\"\n    ],\n    \"doi\": \"10.1101/789012.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v1\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This research was funded by the Chan Zuckerberg Biohub.\"\n}"}
{"_id": "Academic--preprints--p--69758", "text": "{\n    \"title\": \"Novel Biomarker Discovery in Early-Stage Lung Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We identified a novel circulating microRNA signature that demonstrates high sensitivity and specificity for early-stage non-small cell lung cancer. This biomarker shows potential for non-invasive cancer detection.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"lung cancer\",\n        \"biomarker\",\n        \"microRNA\",\n        \"early detection\",\n        \"cancer\"\n    ],\n    \"doi\": \"10.1101/2023.03.15.532148\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.532148v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA222222.\"\n}"}
{"_id": "Academic--preprints--n--69758", "text": "{\n    \"title\": \"The Role of Gut Microbiota in Inflammatory Bowel Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study investigates the compositional changes in gut microbiota associated with different subtypes of inflammatory bowel disease. We observed significant differences in bacterial diversity between Crohn's disease and ulcerative colitis patients.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"gut microbiota\",\n        \"IBD\",\n        \"Crohn's disease\",\n        \"ulcerative colitis\",\n        \"inflammation\"\n    ],\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.728954v1\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"We thank the patients and clinicians who participated in this study.\"\n}"}
