{"_id": "Academic--preprints--n--69344", "text": "{\n    \"title\": \"Efficient Algorithms for Data Compression\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces new algorithms for efficient data compression, achieving significant reductions in file size.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"data compression\",\n        \"algorithms\",\n        \"efficiency\"\n    ],\n    \"doi\": \"10.5678/example.456\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/example.456\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"We thank the funding agencies for their support.\"\n}"}
{"_id": "Academic--preprints--p--69345", "text": "{\n    \"title\": \"Novel Immunotherapeutic Approaches for Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates new strategies for treating pancreatic cancer using immunotherapy. We demonstrate promising results in preclinical models.\",\n    \"submission_date\": \"2023-05-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"pancreatic cancer\",\n        \"preclinical\"\n    ],\n    \"doi\": \"10.1101/123456.v1\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funding was provided by the National Institutes of Health.\"\n}"}
{"_id": "Academic--preprints--n--69345", "text": "{\n    \"title\": \"Genetic Predisposition to Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"A comprehensive analysis of genetic markers associated with breast cancer risk.\",\n    \"submission_date\": \"2023-08-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"genetics\",\n        \"risk factors\"\n    ],\n    \"doi\": \"10.1101/789012.v2\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.v2\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Supported by the Breast Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69346", "text": "{\n    \"title\": \"Novel Immunotherapy Strategies for Pancreatic Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates new immunotherapy approaches for pancreatic cancer, showing promising results in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"pancreatic cancer\",\n        \"PD-1\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funding from the National Institutes of Health.\"\n}"}
{"_id": "Academic--preprints--n--69346", "text": "{\n    \"title\": \"The Role of Genetics in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores the genetic factors contributing to the development of Alzheimer's disease.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"neurodegeneration\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"Supported by the Alzheimer's Association.\"\n}"}
{"_id": "Academic--preprints--p--69347", "text": "{\n    \"title\": \"A Novel Approach to Few-Shot Learning with Meta-Transformers\",\n    \"authors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This paper introduces a new meta-learning framework based on Transformers for improving few-shot learning performance. We demonstrate state-of-the-art results on several benchmark datasets.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"meta-learning\",\n        \"few-shot learning\",\n        \"transformers\"\n    ],\n    \"doi\": \"10.1234/arXiv.2303.01234\",\n    \"full_text_url\": \"https://arxiv.org/abs/2303.01234\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was supported by NSF grant XYZ123.\"\n}"}
{"_id": "Academic--preprints--n--69347", "text": "{\n    \"title\": \"Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Peter Brown\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"abstract\": \"A comprehensive survey of deep learning techniques for image recognition tasks. We cover convolutional neural networks, recurrent neural networks, and their applications.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"doi\": \"10.5678/arXiv.2305.04567\",\n    \"full_text_url\": \"https://arxiv.org/abs/2305.04567\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"We thank NVIDIA for providing GPU resources.\"\n}"}
{"_id": "Academic--preprints--p--69348", "text": "{\n    \"title\": \"Novel Immunotherapeutic Approach for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates a novel combination immunotherapy for treating triple-negative breast cancer, demonstrating improved efficacy in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"therapeutic interventions\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funding provided by the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69348", "text": "{\n    \"title\": \"Genome-Wide Association Study of Prostate Cancer Risk\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"We conducted a genome-wide association study to identify genetic variants associated with prostate cancer risk.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"prostate cancer\",\n        \"genetics\",\n        \"GWAS\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"This work was supported by a grant from the Prostate Cancer Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69349", "text": "{\n    \"title\": \"Novel Immunotherapeutic Strategies for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This study investigates new approaches to target triple-negative breast cancer using immune checkpoint inhibitors and adoptive T-cell therapy.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"T-cells\"\n    ],\n    \"doi\": \"10.1101/123456.0\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.0\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by the National Cancer Institute.\"\n}"}
{"_id": "Academic--preprints--n--69349", "text": "{\n    \"title\": \"The Role of MicroRNAs in Glioblastoma Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This research explores the involvement of specific microRNAs in the development and progression of glioblastoma multiforme.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"glioblastoma\",\n        \"microRNAs\",\n        \"neuro-oncology\"\n    ],\n    \"doi\": \"10.1101/789012.0\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/789012.0\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Supported by a grant from the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69350", "text": "{\n    \"title\": \"Novel Checkpoint Inhibitor Combination for Advanced Melanoma\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Dana-Farber Cancer Institute\"\n        }\n    ],\n    \"abstract\": \"We present a novel combination therapy using two checkpoint inhibitors to enhance anti-tumor immunity in advanced melanoma patients.  Our results show improved response rates and prolonged survival compared to standard treatment.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer immunotherapy\",\n        \"checkpoint inhibitors\",\n        \"melanoma\",\n        \"anti-PD-1\",\n        \"anti-CTLA-4\"\n    ],\n    \"doi\": \"10.1101/1234567890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/1234567890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA250000.\"\n}"}
{"_id": "Academic--preprints--n--69350", "text": "{\n    \"title\": \"In Vitro Effects of a Novel Compound on Cancer Cell Lines\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"abstract\": \"We investigated the effects of a new compound on various cancer cell lines grown in culture.  The compound showed promising results in inhibiting cell proliferation.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"in vitro\",\n        \"cell proliferation\",\n        \"drug screening\"\n    ],\n    \"doi\": \"10.1101/9876543210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543210\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"Funded by the California Institute for Regenerative Medicine.\"\n}"}
{"_id": "Academic--preprints--p--69351", "text": "{\n    \"title\": \"Novel Immunotherapy Approach for Triple-Negative Breast Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We present a novel immunotherapy approach targeting PD-L1 in triple-negative breast cancer cells, demonstrating significant tumor regression in preclinical models.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"immunotherapy\",\n        \"breast cancer\",\n        \"PD-L1\"\n    ],\n    \"doi\": \"10.1101/123456.7890\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/123456.7890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This research was funded by the NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69351", "text": "{\n    \"title\": \"Genetic Predisposition to Lung Cancer\",\n    \"authors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"abstract\": \"This study identifies novel genetic markers associated with increased risk of lung cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"genetics\",\n        \"lung cancer\",\n        \"SNPs\"\n    ],\n    \"doi\": \"10.1101/987654.3210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/987654.3210\",\n    \"status\": \"published\",\n    \"acknowledgements\": \"Supported by the American Cancer Society.\"\n}"}
{"_id": "Academic--preprints--p--69352", "text": "{\n    \"title\": \"Efficient Transformers for Long-Range Dependencies\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"We present a novel transformer architecture capable of efficiently processing long sequences, addressing a key limitation of traditional transformers.\",\n    \"submission_date\": \"2024-01-15\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"transformers\",\n        \"long sequences\"\n    ],\n    \"doi\": \"10.1101/1234567.890\",\n    \"full_text_url\": \"https://arxiv.org/abs/1234567.890\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF grant 123456.\"\n}"}
{"_id": "Academic--preprints--n--69352", "text": "{\n    \"title\": \"A Survey of Large Language Models\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"This survey provides a comprehensive overview of recent advances in large language models and their applications.\",\n    \"submission_date\": \"2023-11-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"machine learning\",\n        \"natural language processing\",\n        \"large language models\",\n        \"deep learning\"\n    ],\n    \"doi\": \"10.1101/9876543.210\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/9876543.210\",\n    \"status\": \"accepted\",\n    \"acknowledgements\": \"The authors thank Google for providing computational resources.\"\n}"}
{"_id": "Academic--preprints--p--69353", "text": "{\n    \"title\": \"Targeting Mutant KRAS in Pancreatic Cancer with Novel Inhibitors\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We report the development of novel inhibitors targeting mutant KRAS in pancreatic cancer cells. These inhibitors demonstrate promising preclinical activity.\",\n    \"submission_date\": \"2023-03-15\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"KRAS\",\n        \"inhibitors\",\n        \"pancreatic cancer\",\n        \"targeted therapy\"\n    ],\n    \"doi\": \"10.1101/2023.03.15.12345678\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.03.15.12345678v1\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NIH grant R01CA123456.\"\n}"}
{"_id": "Academic--preprints--n--69353", "text": "{\n    \"title\": \"The Role of Inflammation in Breast Cancer Progression\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"abstract\": \"This study investigates the connection between chronic inflammation and the development of breast cancer.\",\n    \"submission_date\": \"2023-05-20\",\n    \"preprint_platform\": \"bioRxiv\",\n    \"keywords\": [\n        \"cancer\",\n        \"breast cancer\",\n        \"inflammation\",\n        \"tumor microenvironment\"\n    ],\n    \"doi\": \"10.1101/2023.05.20.98765432\",\n    \"full_text_url\": \"https://www.biorxiv.org/content/10.1101/2023.05.20.98765432v1\",\n    \"status\": \"withdrawn\",\n    \"acknowledgements\": \"Funding was provided by the Breast Cancer Research Foundation.\"\n}"}
{"_id": "Academic--preprints--p--69354", "text": "{\n    \"title\": \"Novel Deep Learning Architecture for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"abstract\": \"We propose a novel deep learning architecture for image recognition that achieves state-of-the-art results on the ImageNet dataset.\",\n    \"submission_date\": \"2023-10-27\",\n    \"preprint_platform\": \"arXiv\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"image recognition\",\n        \"computer vision\"\n    ],\n    \"doi\": \"10.1234/example.123\",\n    \"full_text_url\": \"https://arxiv.org/abs/example.123\",\n    \"status\": \"under review\",\n    \"acknowledgements\": \"This work was supported by NSF Grant 1234567.\"\n}"}
