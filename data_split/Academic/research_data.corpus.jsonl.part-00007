{"_id": "Academic--research_data--p--70749", "text": "{\n    \"dataset_name\": \"High-Resolution Arctic Temperature Data\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"Polar Research Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Automated weather stations distributed across the Arctic region.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Arctic Temperatures\",\n            \"authors\": [\n                \"Sharma, A.\",\n                \"Lee, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
