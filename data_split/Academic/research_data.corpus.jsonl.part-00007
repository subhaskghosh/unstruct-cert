{"_id": "Academic--research_data--p--70296", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling at fixed stations across Lake Erie\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Lake Erie Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70296", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Urban Environmental Research Institute\",\n        \"affiliation\": \"UER Institute\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Mobile monitoring using sensor-equipped vehicles\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.example.com/air_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data is pre-processed and missing values are imputed.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70297", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--70297", "text": "{\n    \"dataset_name\": \"Historical Weather Records - Europe\",\n    \"creator\": {\n        \"name\": \"National Meteorological Archives of France\",\n        \"affiliation\": \"Météo-France\"\n    },\n    \"date_collected\": \"2018-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Research Use Only\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climatological Data for France\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/european_weather_data\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Detailed historical weather records for several European cities\"\n    }\n}"}
{"_id": "Academic--research_data--p--70298", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples collected from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
