{"_id": "Academic--research_data--n--71026", "text": "{\n    \"dataset_name\": \"Remote Sensing of Forest Carbon - Canada\",\n    \"creator\": {\n        \"name\": \"Canadian Forest Service\",\n        \"affiliation\": \"Natural Resources Canada\"\n    },\n    \"date_collected\": \"2022-11-15T15:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Net Primary Productivity\",\n            \"units\": \"gC/m²/year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Open Data Licence - Canada\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Stocks in Canadian Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/canada_forest_carbon.tif\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data derived from Landsat imagery\"\n    }\n}"}
{"_id": "Academic--research_data--p--71027", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London boroughs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes timestamps and geolocation coordinates for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71027", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest_health.xml\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes species identification and forest structure parameters.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71028", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular in-situ measurements at fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
