{"_id": "Academic--research_data--p--70808", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Regional Impacts\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Earth Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Precipitation Change\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Impacts of Global Warming\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70808", "text": "{\n    \"dataset_name\": \"Historical Weather Data - 1980-2000\",\n    \"creator\": {\n        \"name\": \"Robert Miller\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2000-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from US weather stations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data is pre-processed for easy analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70809", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Monthly average surface temperature anomalies.\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\",\n            \"description\": \"Geographical latitude of measurement.\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\",\n            \"description\": \"Geographical longitude of measurement.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global network of weather stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Change\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags and uncertainty estimates are provided.\"\n    }\n}"}
