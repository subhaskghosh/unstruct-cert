{"_id": "Academic--research_data--p--66013", "text": "{\n    \"dataset_name\": \"COVID-19 Radiography Database\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"US National Library of Medicine\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Path\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"COVID-19 Lung CT Image Dataset\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/covid_radiography\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-verified bounding boxes\"\n    }\n}"}
{"_id": "Academic--research_data--n--66013", "text": "{\n    \"dataset_name\": \"Cardiac MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Massachusetts General Hospital\",\n        \"affiliation\": \"Harvard Medical School\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Path\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"Ejection Fraction\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Retrospective case-control study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Cardiac Function Analysis using MRI\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/cardiac_mri\",\n    \"metadata\": {\n        \"data_size\": \"30GB\",\n        \"annotations\": \"Automated segmentation masks\"\n    }\n}"}
{"_id": "Academic--research_data--p--66014", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
