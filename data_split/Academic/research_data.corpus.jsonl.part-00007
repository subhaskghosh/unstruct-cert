{"_id": "Academic--research_data--p--68689", "text": "{\n    \"dataset_name\": \"Urban Air Quality and Climate Change\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Populations\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Data cleaned and quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68689", "text": "{\n    \"dataset_name\": \"Remote Sensing of Forest Carbon\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2019-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC 4.0 International\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating Forest Carbon Stocks Using Remote Sensing\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, A.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.tif\",\n    \"metadata\": {\n        \"data_size\": \"2.2GB\",\n        \"annotations\": \"Data preprocessed with atmospheric correction.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68690", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Team\",\n        \"affiliation\": \"United States Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Passive air quality sensors deployed at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality-controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68690", "text": "{\n    \"dataset_name\": \"Climate Model Output - Scenario A2\",\n    \"creator\": {\n        \"name\": \"Global Climate Modeling Consortium\",\n        \"affiliation\": \"International Research Institute\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"°C\",\n            \"description\": \"Predicted temperature change relative to pre-industrial levels\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"unit\": \"mm\",\n            \"description\": \"Projected sea level rise\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Numerical simulation using a complex climate model with anthropogenic forcing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios and Their Impacts\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Model output based on A2 emissions scenario.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68691", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - High Resolution\",\n    \"creator\": {\n        \"name\": \"Environmental Science Lab, City University\",\n        \"affiliation\": \"City University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Fixed-site monitoring stations with hourly readings.\",\n    \"related_publications\": [\n        {\n            \"title\": \"High-Resolution Air Quality Mapping in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data is quality-controlled and includes missing value flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68691", "text": "{\n    \"dataset_name\": \"Coastal Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"Marine Biology Institute\",\n        \"affiliation\": \"Oceanographic Research Center\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Ship-based water sampling at various coastal locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coastal Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_ecosystem.json\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes metadata about sampling locations and methods.\"\n    }\n}"}
