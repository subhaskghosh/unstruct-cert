notations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70827", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in California Forests\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Species identification validated by experts\"\n    }\n}"}
{"_id": "Academic--research_data--p--70828", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"co2_level\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global monitoring stations with daily readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric CO2\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70828", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"wheat_yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"corn_yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"country\",\n            \"units\": null\n        },\n        {\n            \"name\": \"year\",\n            \"units\": null\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Annual surveys of agricultural production\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Security Outlook\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data gaps filled using interpolation\"\n    }\n}"}
{"_id": "Academic--research_data--p--70829", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2022-2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data validated against EU standards\"\n    }\n}"}
{"_id": "Academic--research_data--n--70829", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Research Institute\",\n        \"affiliation\": \"Ecology Department\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Random plot sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon Rainforest\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Oliveira, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Detailed species identification provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--70830", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular grab samples collected weekly at multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70830", "text": "{\n    \"dataset_name\": \"Global Air Pollution Monitoring\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Data collected from monitoring stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global burden of disease attributable to air pollution\",\n            \"authors\": [\n                \"Cohen, A.\",\n                \"Brauer, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_airpollution.xml\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data includes station metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70831", "text": "{\n    \"dataset_name\": \"Human Activity Recognition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Jane Doe\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"acceleration_x\",\n            \"units\": \"m/s^2\"\n        },\n        {\n            \"name\": \"acceleration_y\",\n            \"units\": \"m/s^2\"\n        },\n        {\n            \"name\": \"activity\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Wearable sensor data collected from volunteers performing various activities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Human Activity Recognition Using Wearable Sensors\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/har_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Activities are labeled as walking, running, sitting, and standing.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70831", "text": "{\n    \"dataset_name\": \"Astronomy Image Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. John Smith\",\n        \"affiliation\": \"Space Telescope Science Institute\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"redshift\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"magnitude\",\n            \"units\": \"stellar magnitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Data obtained from the Hubble Space Telescope.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Galaxy Redshift Measurements\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/astronomy_images.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains redshift and magnitude values for thousands of galaxies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70832", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphorus Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoys and discrete water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70832", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Environmental Monitoring Center\",\n        \"affiliation\": \"Beijing Government\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality assessment in Beijing\",\n            \"authors\": [\n                \"Li, W.\",\n                \"Zhang, Y.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Hourly averages\"\n    }\n}"}
{"_id": "Academic--research_data--p--70833", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Dataset - Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter 2.5 (µg/m³)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70833", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data\",\n    \"creator\": {\n        \"name\": \"Dr. James Wilson\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2022-11-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity (PSU)\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth (m)\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Ocean Temperature\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70834", "text": "{\n    \"dataset_name\": \"COVID-19 Chest X-ray Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Data Consortium\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Image_ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"Image_Type\",\n            \"units\": \"PA or AP\"\n        },\n        {\n            \"variable_name\": \"Finding\",\n            \"units\": \"presence/absence of pneumonia\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective collection from hospital archives\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep learning for COVID-19 detection on chest X-rays\",\n            \"authors\": [\n                \"Smith et al.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/covid_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Radiologist-verified labels for pneumonia\"\n    }\n}"}
{"_id": "Academic--research_data--n--70834", "text": "{\n    \"dataset_name\": \"Large-Scale Genomic Dataset\",\n    \"creator\": {\n        \"name\": \"Genomics Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-08-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Gene_ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"Expression_Level\",\n            \"units\": \"RNA-Seq counts\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Whole-genome sequencing of patient samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Genome-wide association study of complex traits\",\n            \"authors\": [\n                \"Jones et al.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/genomic_dataset\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Gene ontology annotations\"\n    }\n}"}
{"_id": "Academic--research_data--p--70835", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Regular sampling at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70835", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_records.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Includes missing data\"\n    }\n}"}
