{"_id": "Academic--research_data--p--70786", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Greenhouse Gas Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Solar Irradiance\",\n            \"units\": \"W/m^2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global sensor network and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Impacts of Climate Change on Global Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
