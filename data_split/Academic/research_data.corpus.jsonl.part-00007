{"_id": "Academic--research_data--p--71898", "text": "{\n    \"dataset_name\": \"CoastalTemperatureImpacts\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara - Marine Science Institute\"\n    },\n    \"date_collected\": \"2021-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"coastal_erosion_rate\",\n            \"unit\": \"meters/year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Automated buoy network with monthly data collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rising Sea Temperatures on California Coastal Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes quality control flags and metadata on buoy locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71898", "text": "{\n    \"dataset_name\": \"GlobalForestCover\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis Project\",\n        \"affiliation\": \"International Forestry Institute\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"forest_cover_percentage\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"biomass\",\n            \"unit\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis with annual updates.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Forest Cover\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Jones, M.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.geojson\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes land cover classification and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71899", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atmospheric Composition on Global Climate\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71899", "text": "{\n    \"dataset_name\": \"California Air Quality Study\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Mobile monitoring vans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://berkeley.edu/airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71900", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Europe\",\n    \"creator\": {\n        \"name\": \"European Environment Agency (EEA)\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"O3 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"SO2 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"CO Concentration\",\n            \"units\": \"mg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across major European cities, hourly averages.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe - 2023 Report\",\n            \"authors\": \"EEA\"\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality_europe.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71900", "text": "{\n    \"dataset_name\": \"National Particulate Matter Monitoring - USA\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10 Concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Fixed and mobile monitoring stations, 24-hour averages.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Air Quality Trends Report\",\n            \"authors\": \"EPA\"\n        }\n    ],\n    \"download_url\": \"https://example.com/pm_usa.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data completeness indicators provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71901", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentrations - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2022\",\n            \"authors\": \"Friedlingstein et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://gml.noaa.gov/ccgg/datasets/co2-data/\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71901", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature and Salinity\",\n    \"creator\": {\n        \"name\": \"World Ocean Database\",\n        \"affiliation\": \"National Oceanographic Data Center\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Ship-based measurements and Argo floats\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Heat Content and Climate Change\",\n            \"authors\": \"Cheng et al.\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.nodc.noaa.gov/OC5/WOD/wod.html\",\n    \"metadata\": {\n        \"data_size\": \"400MB\",\n        \"annotations\": \"Quality control procedures applied.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71902", "text": "{\n    \"dataset_name\": \"Chest X-Ray Abnormalities Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Research Group\",\n        \"affiliation\": \"University of Toronto\"\n    },\n    \"date_collected\": \"2024-03-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"unit\": \"file path\"\n        },\n        {\n            \"name\": \"pneumonia_present\",\n            \"unit\": \"boolean\"\n        },\n        {\n            \"name\": \"abnormality_type\",\n            \"unit\": \"categorical (e.g., pneumonia, effusion)\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Retrospective cohort study from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Automated Pneumonia Detection\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"3.5GB\",\n        \"annotations\": \"Expert radiologist annotations provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71902", "text": "{\n    \"dataset_name\": \"Brain MRI Collection\",\n    \"creator\": {\n        \"name\": \"Neuroimaging Lab\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"mri_sequence\",\n            \"unit\": \"T1-weighted, T2-weighted\"\n        },\n        {\n            \"name\": \"brain_region\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Prospective study of healthy adults\",\n    \"related_publications\": [\n        {\n            \"title\": \"Structural MRI Analysis of Brain Development\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset.tar.gz\",\n    \"metadata\": {\n        \"data_size\": \"6.2GB\",\n        \"annotations\": \"Automated segmentation masks available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71903", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71903", "text": "{\n    \"dataset_name\": \"Industrial Emissions Report - Germany\",\n    \"creator\": {\n        \"name\": \"Siemens Energy\",\n        \"affiliation\": \"Corporate Research\"\n    },\n    \"date_collected\": \"2022-12-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NOx Emissions\",\n            \"units\": \"kg/hour\"\n        },\n        {\n            \"name\": \"SO2 Emissions\",\n            \"units\": \"kg/hour\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Self-reported by industrial facilities\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/germany_emissions.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is subject to reporting inaccuracies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71904", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"OpenAQ\",\n        \"affiliation\": \"Open Source Environmental Data\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Network of ground-based sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Air Pollution\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Impact of Air Quality on Public Health\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://openaq.org/data\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71904", "text": "{\n    \"dataset_name\": \"Lake Erie Phytoplankton Monitoring\",\n    \"creator\": {\n        \"name\": \"NOAA Great Lakes Environmental Research Laboratory\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2023-06-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular water sample collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Harmful Algal Blooms in Lake Erie\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.glerl.noaa.gov/data/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality control procedures documented\"\n    }\n}"}
{"_id": "Academic--research_data--p--71905", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations across London boroughs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2022-2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages for key pollutants.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71905", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"Remote Sensing Division\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NDVI\",\n            \"units\": \"Dimensionless\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Satellite imagery and ground truthing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment using Remote Sensing\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://forestrydata.gov/foresthealth.tif\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data represents forest health metrics derived from satellite imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71906", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71906", "text": "{\n    \"dataset_name\": \"Coastal Ecosystem Monitoring - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"University of Washington Oceanography Department\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\",\n            \"description\": \"Practical salinity units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Water temperature\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Monthly water samples collected from coastal sites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_ecosystem_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data collected during low tide\"\n    }\n}"}
{"_id": "Academic--research_data--p--71907", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"parts per million\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at globally distributed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/noaa_co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data is quality-controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71907", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Africa\",\n    \"creator\": {\n        \"name\": \"African Meteorological Society\",\n        \"affiliation\": \"Regional Climate Center\"\n    },\n    \"date_collected\": \"2019-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Location ID\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Daily measurements at select weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in Sub-Saharan Africa\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://example.com/africa_rainfall.xml\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes some missing values.\"\n    }\n}"}
