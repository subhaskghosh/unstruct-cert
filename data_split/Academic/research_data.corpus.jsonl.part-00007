{"_id": "Academic--research_data--n--69027", "text": "{\n    \"dataset_name\": \"US Climate Normals\",\n    \"creator\": {\n        \"name\": \"NOAA\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Normals for the United States\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/us_climate_normals.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Contains historical climate data for the United States.\"\n    }\n}"}
