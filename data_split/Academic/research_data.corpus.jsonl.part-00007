{"_id": "Academic--research_data--p--69360", "text": "{\n    \"dataset_name\": \"Neuronal Oscillations Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"Stanford Neurosciences Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"frequency\",\n            \"units\": \"Hz\"\n        },\n        {\n            \"name\": \"amplitude\",\n            \"units\": \"uV\"\n        },\n        {\n            \"name\": \"phase\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"In vivo electrophysiology recordings from rodent hippocampus.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oscillatory Dynamics of Hippocampal Neurons\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/neuronal_oscillations.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes timestamps and neuron IDs.\"\n    }\n}"}
