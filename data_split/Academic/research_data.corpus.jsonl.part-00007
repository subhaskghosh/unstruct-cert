{"_id": "Academic--research_data--n--71286", "text": "{\n    \"dataset_name\": \"OceanCurrents_Pacific_2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Pacific Marine Environmental Laboratory\"\n    },\n    \"date_collected\": \"2024-01-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CurrentSpeed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"CurrentDirection\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Moored buoys and ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Current Dynamics\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_currents_2024.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71287", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Gridded monthly temperature anomalies based on station data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Surface Temperature Change\",\n            \"authors\": \"James Hansen et al.\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains anomaly data relative to a base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71287", "text": "{\n    \"dataset_name\": \"North Pacific Phytoplankton Data\",\n    \"creator\": {\n        \"name\": \"Ocean Research Group\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chlorophyll-a Concentration\",\n            \"units\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Ship-based measurements and satellite remote sensing.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Phytoplankton Dynamics in the North Pacific\",\n            \"authors\": \"Jane Doe et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://oceanresearch.uw.edu/data/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data collected during research cruises in the North Pacific.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71288", "text": "{\n    \"dataset_name\": \"Twitter COVID-19 Vaccine Sentiment\",\n    \"creator\": {\n        \"name\": \"Social Media Insights Corp\",\n        \"affiliation\": \"Private Analytics Firm\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tweet_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"text\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"sentiment\",\n            \"unit\": \"scale of -1 to 1\"\n        },\n        {\n            \"name\": \"location\",\n            \"unit\": \"country code\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Streamed Twitter API data using keywords related to COVID-19 vaccines\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/twitter_vaccine_sentiment.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Sentiment analysis performed using a pre-trained model.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71288", "text": "{\n    \"dataset_name\": \"Stanford Social Media and Health Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"post_text\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"health_topic\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"engagement_count\",\n            \"unit\": \"integer\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Random sample of public Facebook posts related to health.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Social Media and Public Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://stanford.edu/health_social_media.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Manually annotated for health topics.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71289", "text": "{\n    \"dataset_name\": \"Freshwater Lake Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular interval sampling from multiple lake locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Nutrient Runoff on Freshwater Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"journal\": \"Environmental Science & Technology\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71289", "text": "{\n    \"dataset_name\": \"Coastal Oceanographic Data\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Autonomous underwater vehicle surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Current Dynamics in the Gulf Stream\",\n            \"authors\": [\n                \"Davis, R.\",\n                \"Brown, S.\"\n            ],\n            \"journal\": \"Journal of Geophysical Research: Oceans\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data is pre-processed and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71290", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"Harvard University Atmospheric Research Group\",\n        \"affiliation\": \"Harvard University\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        },\n        {\n            \"title\": \"Spatial and Temporal Patterns of PM2.5 in Boston\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
