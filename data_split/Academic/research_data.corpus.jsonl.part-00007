{"_id": "Academic--research_data--p--69729", "text": "{\n    \"dataset_name\": \"Lung Cancer CT Scans\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Image Resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Tumor Size\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Tumor Location\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Early Detection of Lung Cancer using CT Imaging\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_cancer_ct_scans\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-verified tumor segmentations\"\n    }\n}"}
