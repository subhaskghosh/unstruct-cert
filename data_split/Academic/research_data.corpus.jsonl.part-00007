{"_id": "Academic--research_data--p--66935", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_resolution_x\",\n            \"unit\": \"pixels\"\n        },\n        {\n            \"name\": \"image_resolution_y\",\n            \"unit\": \"pixels\"\n        },\n        {\n            \"name\": \"MRI_scan_type\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Manual segmentation masks available\"\n    }\n}"}
