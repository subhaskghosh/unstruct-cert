{"_id": "Academic--research_data--p--71236", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements - Global Stations\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations globally.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric CO2\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71236", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - North America\",\n    \"creator\": {\n        \"name\": \"Global Weather Inc.\",\n        \"affiliation\": \"Private Meteorological Company\"\n    },\n    \"date_collected\": \"2018-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation (mm)\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed (km/h)\",\n            \"units\": \"km/h\"\n        },\n        {\n            \"name\": \"Humidity (%)\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Data collected from weather stations and radar systems.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data missing for certain regions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71237", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2022\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, King's College London\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in parts per billion.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in air quality in London\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london_2022.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71237", "text": "{\n    \"dataset_name\": \"SoilComposition_RuralFrance_2018\",\n    \"creator\": {\n        \"name\": \"Institut National de la Recherche Agronomique\",\n        \"affiliation\": \"INRA\"\n    },\n    \"date_collected\": \"2018-07-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"units\"\n        },\n        {\n            \"name\": \"OrganicMatter\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random soil samples across rural France\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil composition analysis in French agricultural lands\",\n            \"year\": 2019,\n            \"authors\": [\n                \"Dupont, P.\",\n                \"Leroy, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_france_2018.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Preliminary data, some inconsistencies may exist.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71238", "text": "{\n    \"dataset_name\": \"LakeWaterQualityMonitoring2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute of California\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from various locations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of Water Quality Trends in California Lakes\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lakewaterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Data includes quality control flags and location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71238", "text": "{\n    \"dataset_name\": \"AtmosphericPollutionStudy2022\",\n    \"creator\": {\n        \"name\": \"Air Quality Research Group\",\n        \"affiliation\": \"National Institute of Environmental Health Sciences\"\n    },\n    \"date_collected\": \"2022-03-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Continuous monitoring data from fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Air Pollution Levels\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/airpollution.json\",\n    \"metadata\": {\n        \"data_size\": \"15.8MB\",\n        \"annotations\": \"Data includes missing value flags and station metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71239", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, University College London\",\n        \"affiliation\": \"UCL\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
