{"_id": "Academic--research_data--p--71390", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - City of Boston\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Continuous monitoring stations located throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes timestamps, latitude, and longitude of each measurement.\"\n    }\n}"}
