{"_id": "Academic--research_data--p--71094", "text": "{\n    \"dataset_name\": \"Brain MRI Segmentation Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Resolution X\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Image Resolution Y\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Slice Thickness\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Brain Structure\",\n            \"units\": \"category\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Prospective MRI study with healthy volunteers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation using Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Manual segmentations by expert radiologists\"\n    }\n}"}
