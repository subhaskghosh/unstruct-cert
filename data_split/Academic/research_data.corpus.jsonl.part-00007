{"_id": "Academic--research_data--n--70253", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Carbon Flux - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Amazonian Research Institute\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol/m²/s\"\n        },\n        {\n            \"name\": \"Water Vapor Flux\",\n            \"units\": \"mmol/m²/s\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Eddy covariance measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Dynamics in Amazonian Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_carbon_flux.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data includes daily averages\"\n    }\n}"}
