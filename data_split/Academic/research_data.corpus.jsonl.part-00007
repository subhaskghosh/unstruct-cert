{"_id": "Academic--research_data--n--69596", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Non-Commercial\",\n    \"sampling_method\": \"Satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Trends\",\n            \"authors\": [\n                \"Meier, W.\",\n                \"Parkinson, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Daily sea ice extent data\"\n    }\n}"}
{"_id": "Academic--research_data--p--69597", "text": "{\n    \"dataset_name\": \"Cardiac MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"pixel_intensity\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"heart_rate\",\n            \"units\": \"bpm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Prospective, single-center study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Cardiac Segmentation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/cardiac_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Segmented left ventricle\"\n    }\n}"}
