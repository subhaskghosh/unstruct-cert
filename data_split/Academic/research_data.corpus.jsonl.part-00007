{"_id": "Academic--research_data--p--70551", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Deforestation 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute for Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Deforestation Area\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"millimeters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis combined with ground-based surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Deforestation on Amazonian Biodiversity\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_deforestation_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes annotations for land cover types.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70551", "text": "{\n    \"dataset_name\": \"Urban Air Quality in London\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"micrograms/m^3\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations throughout London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution and Respiratory Health in Urban Environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes timestamps and geographical coordinates.\"\n    }\n}"}
