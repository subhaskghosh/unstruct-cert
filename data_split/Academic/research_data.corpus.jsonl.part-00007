{"_id": "Academic--research_data--p--71703", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"ODC-BY\",\n    \"sampling_method\": \"Automated buoys and discrete water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71703", "text": "{\n    \"dataset_name\": \"Global River Discharge Data\",\n    \"creator\": {\n        \"name\": \"University of Bristol\",\n        \"affiliation\": \"Hydrology Research Group\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"River Discharge\",\n            \"units\": \"m^3/s\"\n        },\n        {\n            \"name\": \"Water Level\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Satellite remote sensing and gauge measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating global river discharge\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_discharge.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data gaps present in some regions\"\n    }\n}"}
{"_id": "Academic--research_data--p--71704", "text": "{\n    \"dataset_name\": \"LakeWaterQualityMonitoring2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"dissolved_oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular interval sampling at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Lake Water Quality\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakewaterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71704", "text": "{\n    \"dataset_name\": \"IndustrialWastewaterAnalysis\",\n    \"creator\": {\n        \"name\": \"Private Consulting Firm\",\n        \"affiliation\": \"ABC Industries\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"chemical_concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"flow_rate\",\n            \"units\": \"m^3/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Event-triggered sampling based on industrial output.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/wastewater.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71705", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2021-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Warming Trends in Global Surface Temperatures\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-temperature/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71705", "text": "{\n    \"dataset_name\": \"Historical Weather Data - 1900-2010\",\n    \"creator\": {\n        \"name\": \"Environment Canada\",\n        \"affiliation\": \"Meteorological Service of Canada\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government Licence - Canada\",\n    \"sampling_method\": \"Automated weather stations across Canada\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Variability in Canada\",\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://climate.weather.gc.ca/historical_data/index_e.html\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Missing values may be present\"\n    }\n}"}
{"_id": "Academic--research_data--p--71706", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Measurements in the Arctic\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous measurements from a research station\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Atmospheric Trends\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Impact of Permafrost Thaw on Greenhouse Gas Emissions\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71706", "text": "{\n    \"dataset_name\": \"Historical Weather Data of London\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2018-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Daily records from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Climate Variability\",\n            \"year\": 2010\n        }\n    ],\n    \"download_url\": \"https://example.com/london_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Missing data values represented as NaN\"\n    }\n}"}
{"_id": "Academic--research_data--p--71707", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71707", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Database\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Environmental Systems Research Institute (ESRI)\"\n    },\n    \"date_collected\": \"2023-11-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Remote sensing and field measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Carbon Stocks\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data derived from satellite imagery\"\n    }\n}"}
{"_id": "Academic--research_data--p--71708", "text": "{\n    \"dataset_name\": \"US Historical Temperature Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Station-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in US Temperatures\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/tool/MrSID/MrSID.html\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71708", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Marine Research Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Buoy and satellite measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://marine.ucsd.edu/data\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data includes error estimates\"\n    }\n}"}
{"_id": "Academic--research_data--p--71709", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71709", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - 1998\",\n    \"creator\": {\n        \"name\": \"Robert Jones\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"1998-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°F\",\n            \"description\": \"Daily average temperature.\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity.\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Manual recordings\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/weather_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data completeness varies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71710", "text": "{\n    \"dataset_name\": \"LongTermEcosystemData\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"CO2_Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Manual and semi-automated sensor readings with quality control checks.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Ecosystem Changes\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/longtermeco.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes annotations for species identification.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71710", "text": "{\n    \"dataset_name\": \"GlobalAirQualityData\",\n    \"creator\": {\n        \"name\": \"Global Monitoring Consortium\",\n        \"affiliation\": \"International Environmental Agency\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"ParticulateMatter2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Fully automated sensor network.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Worldwide Air Quality Trends\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Data is regularly updated.\"\n    }\n}"}
