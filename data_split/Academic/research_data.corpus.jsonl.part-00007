{"_id": "Academic--research_data--p--67492", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across central London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67492", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Monitoring - Amazon 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2023-06-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Satellite imagery and ground-based sensor network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Dynamics in the Amazon Basin\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data processed using machine learning algorithms.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67493", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen dioxide concentration.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Continuous monitoring stations throughout London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67493", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Society\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"count\",\n            \"description\": \"Number of trees of a particular species.\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\",\n            \"description\": \"Height of the forest canopy.\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\",\n            \"description\": \"Measure of leaf density.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://amazonconservation.org/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67494", "text": "{\n    \"dataset_name\": \"Riverine Nitrate Levels - Chesapeake Bay\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Smithsonian Environmental Research Center\"\n    },\n    \"date_collected\": \"2023-03-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected bi-weekly at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Nitrate Loading and Eutrophication in the Chesapeake Bay\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chesapeake_nitrate.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67494", "text": "{\n    \"dataset_name\": \"Urban Air Pollution in California\",\n    \"creator\": {\n        \"name\": \"David Lee\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-20T09:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring using stationary sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Impact of Traffic on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/california_air.csv\",\n    \"metadata\": {\n        \"data_size\": \"800 KB\",\n        \"annotations\": \"Data is hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67495", "text": "{\n    \"dataset_name\": \"Air Quality and Meteorological Data - Urban Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution and Health Impacts\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags and metadata regarding station location are included.\"\n    }\n}"}
