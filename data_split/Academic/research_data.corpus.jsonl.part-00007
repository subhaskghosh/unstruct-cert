{"_id": "Academic--research_data--p--70929", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Time\",\n            \"unit\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Uncertainty\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen et al.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"High-resolution global temperature data\"\n    }\n}"}
{"_id": "Academic--research_data--n--70929", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ship-based salinity measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity Variations\",\n            \"authors\": [\n                \"Smith et al.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/salinity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Ocean salinity data\"\n    }\n}"}
{"_id": "Academic--research_data--p--70930", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Monitoring Data - Oregon\",\n    \"creator\": {\n        \"name\": \"Oregon Department of Forestry\",\n        \"affiliation\": \"State of Oregon\"\n    },\n    \"date_collected\": \"2023-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random stratified sampling across forest stands.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment in Oregon\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/oregon_forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality control flags for each observation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70930", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"London City Hall\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government License\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data is hourly averaged.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70931", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Data\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species_ID\",\n            \"description\": \"Unique identifier for each species observed\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"Tree_Height\",\n            \"description\": \"Height of the tree in meters\",\n            \"units\": \"m\"\n        },\n        {\n            \"variable_name\": \"Leaf_Area\",\n            \"description\": \"Average leaf area in square centimeters\",\n            \"units\": \"cm^2\"\n        },\n        {\n            \"variable_name\": \"Soil_Moisture\",\n            \"description\": \"Percentage of water in the soil\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots within the rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70931", "text": "{\n    \"dataset_name\": \"Coral Reef Health Indicators\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"Marine Biology Institute\"\n    },\n    \"date_collected\": \"2022-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Coral_Coverage\",\n            \"description\": \"Percentage of reef covered by live coral\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"Water_Temperature\",\n            \"description\": \"Sea water temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Visual surveys at 50 reef sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coral Reefs\",\n            \"authors\": [\n                \"Tanaka, K.\",\n                \"Lee, S.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_health.csv\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data includes observations from SCUBA divers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70932", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling within defined plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon Rainforest\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes species identification and habitat classifications.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70932", "text": "{\n    \"dataset_name\": \"Urban Air Quality Data - London\",\n    \"creator\": {\n        \"name\": \"Air Quality Monitoring Ltd.\",\n        \"affiliation\": \"Environmental Agency\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring stations throughout London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Real-time data from monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70933", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality controlled data with missing value imputation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70933", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Environmental Issues\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Social Science Research Center\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"String\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Twitter API data collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Sentiment analysis performed using a pre-trained model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70934", "text": "{\n    \"dataset_name\": \"Global Forest Watch Climate Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_cover_loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"carbon_emissions\",\n            \"units\": \"tons CO2e\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch annual report\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/datasets/gfw-climate/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains data on deforestation and carbon emissions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70934", "text": "{\n    \"dataset_name\": \"Public Opinion on Climate Change\",\n    \"creator\": {\n        \"name\": \"Pew Research Center\",\n        \"affiliation\": \"Pew Charitable Trusts\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"concern_level\",\n            \"units\": \"scale of 1-7\"\n        },\n        {\n            \"name\": \"political_affiliation\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Nationwide survey\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change and Public Opinion\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.pewresearch.org/climate/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains survey responses on climate change perceptions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70935", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular sampling buoys and ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12.5MB\",\n        \"annotations\": \"Data has been quality-controlled and flagged for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70935", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Measurements\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Fixed monitoring stations throughout the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality assessment in urban areas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70936", "text": "{\n    \"dataset_name\": \"Atmospheric Particulate Matter Data - Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"EPA-approved standardized monitoring stations with continuous data logging.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Respiratory Health in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/pm25_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70936", "text": "{\n    \"dataset_name\": \"Citizen Science Bird Observations - North America\",\n    \"creator\": {\n        \"name\": \"North American Birdwatchers Association\",\n        \"affiliation\": \"NABA\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Opportunistic observations reported by citizen scientists via mobile app.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Distribution Patterns of Migratory Birds\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Observation timestamps included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70937", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and calibrated against EPA standards.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70937", "text": "{\n    \"dataset_name\": \"Industrial Emissions Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Pollution Control Agency\",\n        \"affiliation\": \"Regional Government\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM10)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Lead\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Stack emissions testing at industrial facilities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Industrial Emissions on Local Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/industrial_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected as part of regulatory compliance monitoring.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70938", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Cornell Lab of Ornithology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"species_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"migration_speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated tracking using GPS tags on migratory birds.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in avian migration\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality flags for GPS accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70938", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover\",\n    \"creator\": {\n        \"name\": \"City Planning Department\",\n        \"affiliation\": \"Metropolis City Hall\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"canopy_cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Remote sensing using aerial photography.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Mitigation Strategies\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/tree_canopy_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data reflects estimations based on visual interpretation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70939", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sea Level\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
