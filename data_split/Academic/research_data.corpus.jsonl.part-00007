{"_id": "Academic--research_data--p--68837", "text": "{\n    \"dataset_name\": \"Forest Biodiversity and Climate Change\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 10 forest plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Forest Biodiversity\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes species identification verified by experts.\"\n    }\n}"}
