{"_id": "Academic--research_data--n--68718", "text": "{\n    \"dataset_name\": \"Global Air Pollution Levels\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"VOCs\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Data aggregated from monitoring stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global burden of disease attributable to air pollution\",\n            \"authors\": [\n                \"Cohen, A.\",\n                \"Brauer, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airpollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes metadata on monitoring station locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68719", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Grab samples collected monthly at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of Water Quality Trends in US Rivers\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/national-river-water-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"35MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
