{"_id": "Academic--research_data--n--69319", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2021-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Non-Commercial License\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Decline\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/sea_ice_extent.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Daily sea ice extent data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69320", "text": "{\n    \"dataset_name\": \"EEG Resting State Data\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Alpha Power\",\n            \"units\": \"uV^2/Hz\"\n        },\n        {\n            \"name\": \"Beta Frequency\",\n            \"units\": \"Hz\"\n        },\n        {\n            \"name\": \"Gamma Band Amplitude\",\n            \"units\": \"uV/Hz\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Resting-state EEG recording with 64 channels.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Neural Oscillations in Cognitive Control\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/eeg_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data was preprocessed to remove artifacts.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69320", "text": "{\n    \"dataset_name\": \"fMRI Task-Based Data\",\n    \"creator\": {\n        \"name\": \"Dr. Ben Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"BOLD Signal\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Reaction Time\",\n            \"units\": \"milliseconds\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"fMRI scanning during a working memory task.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Working Memory and Prefrontal Cortex Activity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/fmri_data.nii.gz\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Data was slice-timing corrected and spatially normalized.\"\n    }\n}"}
