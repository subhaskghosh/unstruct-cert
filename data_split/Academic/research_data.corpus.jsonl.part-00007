{"_id": "Academic--research_data--n--66907", "text": "{\n    \"dataset_name\": \"Ocean Acidity Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification and its Impacts\",\n            \"authors\": [\n                \"Richard Feely\",\n                \"Chris Langdon\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/ocean-acidification-data\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Measurements of ocean pH levels\"\n    }\n}"}
