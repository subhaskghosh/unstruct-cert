{"_id": "Academic--research_data--p--71986", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data validated and quality controlled\"\n    }\n}"}
{"_id": "Academic--research_data--n--71986", "text": "{\n    \"dataset_name\": \"Industrial Emissions - Petrochemical Plant\",\n    \"creator\": {\n        \"name\": \"ChemCorp Ltd\",\n        \"affiliation\": \"Environmental Compliance Department\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2 Emissions\",\n            \"units\": \"tons/year\"\n        },\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"tons/year\"\n        },\n        {\n            \"name\": \"VOC Emissions\",\n            \"units\": \"kg/hour\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Restricted Use\",\n    \"sampling_method\": \"Stack emission monitoring\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimization of Emission Control Technologies\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/petrochemical_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Raw emission data from plant sensors\"\n    }\n}"}
{"_id": "Academic--research_data--p--71987", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2023\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Forest Loss\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_change_2023.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Includes data on deforestation rates and carbon emissions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71987", "text": "{\n    \"dataset_name\": \"Theoretical Climate Model Output\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation Rate\",\n            \"unit\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Numerical simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sensitivity of climate models to parameter variations\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_output.nc\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Output from a complex general circulation model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71988", "text": "{\n    \"dataset_name\": \"AirQuality_London_2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Trends in London\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london.csv\",\n    \"metadata\": {\n        \"data_size\": \"35MB\",\n        \"annotations\": \"Data quality checked and missing values imputed.\"\n    }\n}"}
