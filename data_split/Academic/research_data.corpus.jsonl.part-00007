{"_id": "Academic--research_data--p--69242", "text": "{\n    \"dataset_name\": \"ImageNet-2023-Subset\",\n    \"creator\": {\n        \"name\": \"Stanford AI Lab\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"image_height\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"object_class\",\n            \"units\": \"category\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Random sampling from ImageNet\",\n    \"related_publications\": [\n        {\n            \"title\": \"Large Scale Visual Recognition Challenge 2023\",\n            \"authors\": [\n                \"Deng et al.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/imagenet_subset.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Image labels\"\n    }\n}"}
