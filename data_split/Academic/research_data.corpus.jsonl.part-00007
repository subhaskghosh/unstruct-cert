{"_id": "Academic--research_data--n--67511", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Instituto Nacional de Pesquisas da Amazônia\",\n        \"affiliation\": \"Research Department\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Research Use Only\",\n    \"sampling_method\": \"Random transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Amazon Rainforest\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://amazonresearch.org/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes species identification and location.\"\n    }\n}"}
