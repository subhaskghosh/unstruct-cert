{"_id": "Academic--research_data--p--67972", "text": "{\n    \"dataset_name\": \"Global Forest Watch Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"units\": \"tonnes of CO2 equivalent\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch data for monitoring climate change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Data includes layers for tree cover loss, gain, and carbon emissions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67972", "text": "{\n    \"dataset_name\": \"City of London Air Quality Data\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"London City Hall\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Dioxide Levels\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Government License v3.0\",\n    \"sampling_method\": \"Ground-based sensor network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Monitoring in London\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/dataset/air-quality\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Real-time and historical air quality data from monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67973", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages\"\n    }\n}"}
{"_id": "Academic--research_data--n--67973", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Normalized Difference Vegetation Index\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery and field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Monitoring using Remote Sensing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://forestry.gov/foresthealth.tif\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data derived from Landsat 8 imagery\"\n    }\n}"}
{"_id": "Academic--research_data--p--67974", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67974", "text": "{\n    \"dataset_name\": \"Bird Species Observations\",\n    \"creator\": {\n        \"name\": \"Citizen Science Initiative\",\n        \"affiliation\": \"Non-profit organization\"\n    },\n    \"date_collected\": \"2022-01-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Common name of the bird species.\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Latitude of observation.\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Longitude of observation.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Opportunistic citizen observations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/bird_observations.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Observations submitted by volunteers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67975", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GISTEMP)\",\n    \"creator\": {\n        \"name\": \"Gavin Schmidt\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies (GISS)\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature in October 2023\",\n            \"authors\": [\n                \"Gavin Schmidt\",\n                \"Reto Knutti\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly and annual global surface temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67975", "text": "{\n    \"dataset_name\": \"Historical Weather Records - City A\",\n    \"creator\": {\n        \"name\": \"Local Weather Station\",\n        \"affiliation\": \"City A Municipality\"\n    },\n    \"date_collected\": \"2019-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"Text\",\n    \"license\": \"Restricted Use\",\n    \"sampling_method\": \"Daily measurements at a single location\",\n    \"related_publications\": [],\n    \"download_url\": \"http://citya.gov/weatherdata\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Limited historical weather data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67976", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Major Cities\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
