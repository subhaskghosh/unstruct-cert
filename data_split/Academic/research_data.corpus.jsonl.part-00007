{"_id": "Academic--research_data--p--69985", "text": "{\n    \"dataset_name\": \"Human Activity Recognition Dataset\",\n    \"creator\": {\n        \"name\": \"Alice Johnson\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"acceleration_x\",\n            \"units\": \"m/s^2\"\n        },\n        {\n            \"name\": \"acceleration_y\",\n            \"units\": \"m/s^2\"\n        },\n        {\n            \"name\": \"acceleration_z\",\n            \"units\": \"m/s^2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Accelerometer data from smartphones\",\n    \"related_publications\": [\n        {\n            \"title\": \"Human Activity Recognition using Deep Learning\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\",\n                \"Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/har_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Activity labels: walking, running, sitting, standing\"\n    }\n}"}
{"_id": "Academic--research_data--n--69985", "text": "{\n    \"dataset_name\": \"Climate Change Data\",\n    \"creator\": {\n        \"name\": \"Bob Williams\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2022-12-20T15:45:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Weather stations across the globe\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Temperature\",\n            \"authors\": [\n                \"Davis\",\n                \"Miller\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Daily temperature and precipitation readings\"\n    }\n}"}
{"_id": "Academic--research_data--p--69986", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global grid cell averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen\",\n                \"Sato\",\n                \"Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
