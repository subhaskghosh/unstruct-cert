{"_id": "Academic--research_data--p--68626", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-05-10T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality checks performed and documented.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68626", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geography\"\n    },\n    \"date_collected\": \"2022-12-25T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forestbiomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Derived from Landsat 8 data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68627", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Total Phosphorus\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular vertical profiles collected weekly from multiple locations on the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality in Lake Mendota\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 MB\",\n        \"annotations\": \"Data quality flags are included in the metadata section of the CSV file.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68627", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Discharge Data - Ohio River\",\n    \"creator\": {\n        \"name\": \"Ohio Environmental Protection Agency\",\n        \"affiliation\": \"OEPA\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"BOD\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"COD\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Total Suspended Solids\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Oil & Grease\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Point source monitoring at industrial discharge locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Industrial Discharge on the Ohio River Ecosystem\",\n            \"authors\": \"Jones et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ohioriver_wastewater.json\",\n    \"metadata\": {\n        \"data_size\": \"1.8 MB\",\n        \"annotations\": \"Data includes permit numbers and facility IDs.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68628", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68628", "text": "{\n    \"dataset_name\": \"Global Historical Climate Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"1980-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ],\n            \"year\": 2010\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Comprehensive historical climate records\"\n    }\n}"}
{"_id": "Academic--research_data--p--68629", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Science Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is quality controlled and calibrated.\"\n    }\n}"}
