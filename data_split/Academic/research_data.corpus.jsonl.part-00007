{"_id": "Academic--research_data--p--69903", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images\",\n    \"creator\": {\n        \"name\": \"Radiology Department, University Hospital\",\n        \"affiliation\": \"University Hospital\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"Image Quality\",\n            \"unit\": \"scale of 1-5\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Detection of Pneumonia\",\n            \"authors\": [\n                \"Dr. Smith\",\n                \"Dr. Jones\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xrays.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Bounding boxes for pneumonia regions\"\n    }\n}"}
