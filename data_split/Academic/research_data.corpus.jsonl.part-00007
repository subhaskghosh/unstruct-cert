{"_id": "Academic--research_data--n--71731", "text": "{\n    \"dataset_name\": \"Indoor Air Quality in Office Buildings\",\n    \"creator\": {\n        \"name\": \"Healthy Buildings Initiative\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"VOCs\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Periodic measurements in office spaces\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ventilation on Indoor Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://healthybuildings.berkeley.edu/iaq_data.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Raw data with minimal processing\"\n    }\n}"}
