{"_id": "Academic--research_data--n--66906", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ship-based conductivity measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity Variations\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/salinity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Contains salinity measurements at various depths.\"\n    }\n}"}
