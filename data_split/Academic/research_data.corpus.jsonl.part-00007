{"_id": "Academic--research_data--n--67688", "text": "{\n    \"dataset_name\": \"Ocean Current Measurements - Pacific 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Johnson\",\n        \"affiliation\": \"Scripps Institution of Oceanography\"\n    },\n    \"date_collected\": \"2023-11-20T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Autonomous underwater vehicle (AUV)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Changes in Pacific Ocean Currents\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_currents_2023.nc\",\n    \"metadata\": {\n        \"data_size\": \"12.2MB\",\n        \"annotations\": \"Data collected using an AUV over a 6-month period.\"\n    }\n}"}
