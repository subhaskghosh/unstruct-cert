{"_id": "Academic--research_data--p--66364", "text": "{\n    \"dataset_name\": \"ImageNet-2023\",\n    \"creator\": {\n        \"name\": \"Deng Jiawei\",\n        \"affiliation\": \"Microsoft Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"label\",\n            \"units\": \"category name\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Web scraping and manual annotation\",\n    \"related_publications\": [\n        {\n            \"title\": \"ImageNet: A Large-Scale Visual Recognition Challenge\",\n            \"authors\": [\n                \"Deng Jiawei\",\n                \"Dong Wang\",\n                \"Li Fei-Fei\"\n            ]\n        },\n        {\n            \"title\": \"Deep Convolutional Neural Networks for Image Classification\",\n            \"authors\": [\n                \"Krizhevsky, Sutskever, Hinton\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://imagenet.org/download\",\n    \"metadata\": {\n        \"data_size\": \"150GB\",\n        \"annotations\": \"Bounding boxes and image labels\"\n    }\n}"}
