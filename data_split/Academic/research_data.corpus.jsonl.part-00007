{"_id": "Academic--research_data--p--66515", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66515", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"National Climatic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Station-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climatic Data for the United States\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Daily weather observations from various locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66516", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
