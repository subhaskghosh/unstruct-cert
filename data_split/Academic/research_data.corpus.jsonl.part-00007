{"_id": "Academic--research_data--p--70133", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"TreeHeight\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"DiameterAtBreastHeight\",\n            \"units\": \"cm\"\n        },\n        {\n            \"variable_name\": \"Species\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Random stratified sampling across forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity trends in California forests\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Dataset includes species identification and location data\"\n    }\n}"}
