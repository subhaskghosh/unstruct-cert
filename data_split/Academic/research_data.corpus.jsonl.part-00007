{"_id": "Academic--research_data--p--71754", "text": "{\n    \"dataset_name\": \"AtmosphericComposition_Global_2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Global network of ground-based sensors and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric CO2\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
