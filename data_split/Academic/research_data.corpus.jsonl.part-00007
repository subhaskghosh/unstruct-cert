{"_id": "Academic--research_data--p--66846", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (COVID-19)\",\n    \"creator\": {\n        \"name\": \"Stanford Machine Learning Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_type\",\n            \"unit\": \"frontal/lateral\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"unit\": \"COVID-19/Normal\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective collection from hospital records.\",\n    \"related_publications\": [\n        {\n            \"title\": \"COVID-19 Detection using Chest X-Ray Images\",\n            \"authors\": \"Wang et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_covid19.zip\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Images are labeled with COVID-19 diagnosis.\"\n    }\n}"}
