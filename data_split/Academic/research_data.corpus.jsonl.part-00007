{"_id": "Academic--research_data--p--67531", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database - 2023\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"Office of Water\"\n    },\n    \"date_collected\": \"2023-11-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"variable_name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Grab samples collected from rivers and lakes across the US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program - 2023 Report\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.example.com/water_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes quality control flags and location metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67531", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Data - 2022\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Global Monitoring Laboratory\"\n    },\n    \"date_collected\": \"2022-08-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Carbon Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"Methane\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring from a network of remote sensing stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Greenhouse Gases\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.example.com/atmospheric_data_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Includes instrument calibration data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67532", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Extreme Weather Events\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation Rate\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global sensor network and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Impacts of Anthropogenic Climate Change\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes data quality flags and uncertainty estimates.\"\n    }\n}"}
