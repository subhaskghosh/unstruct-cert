{"_id": "Academic--research_data--p--70751", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - ERA5\",\n    \"creator\": {\n        \"name\": \"Copernicus Climate Change Service (C3S)\",\n        \"affiliation\": \"ECMWF\"\n    },\n    \"date_collected\": \"2021-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0-1.0\",\n    \"sampling_method\": \"Reanalysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"The ERA5 climate reanalysis\",\n            \"authors\": \"Hersbach et al.\",\n            \"year\": 2020,\n            \"journal\": \"Journal of Climate\"\n        }\n    ],\n    \"download_url\": \"https://data.ecmwf.int/data/era5/reanalysis/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains monthly mean temperature anomalies.\"\n    }\n}"}
