{"_id": "Academic--research_data--p--66051", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"MRI Sequence\",\n            \"units\": \"type of sequence\"\n        },\n        {\n            \"name\": \"Tumor Size\",\n            \"units\": \"mm^3\"\n        },\n        {\n            \"name\": \"Tumor Location\",\n            \"units\": \"anatomical region\"\n        },\n        {\n            \"name\": \"Image Resolution\",\n            \"units\": \"pixels\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI Analysis of Brain Tumors\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Radiologist-verified tumor segmentations\"\n    }\n}"}
