{"_id": "Academic--research_data--n--67689", "text": "{\n    \"dataset_name\": \"Hurricane Impact Survey - Florida Keys\",\n    \"creator\": {\n        \"name\": \"Coastal Research Institute\",\n        \"affiliation\": \"Florida State University\"\n    },\n    \"date_collected\": \"2023-09-10T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"wind_speed\",\n            \"unit\": \"m/s\"\n        },\n        {\n            \"name\": \"storm_surge\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"damage_level\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"location_id\",\n            \"unit\": \"integer\"\n        },\n        {\n            \"name\": \"timestamp\",\n            \"unit\": \"datetime\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Post-storm damage assessment surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Immediate Effects of Hurricane Idalia\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/hurricane_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Includes images of damage assessment.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67690", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data is quality controlled and gap-filled.\"\n    }\n}"}
