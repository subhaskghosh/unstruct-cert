{"_id": "Academic--research_data--p--71505", "text": "{\n    \"dataset_name\": \"Urban Air Quality Sensor Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors deployed across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Data quality flags indicate sensor calibration status.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71505", "text": "{\n    \"dataset_name\": \"Forest Birdsong Recordings\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Identified bird species based on song.\"\n        },\n        {\n            \"name\": \"Recording Time\",\n            \"units\": \"seconds\",\n            \"description\": \"Duration of the recording.\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Passive acoustic monitoring using directional microphones.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/birdsong.zip\",\n    \"metadata\": {\n        \"data_size\": \"8.1MB\",\n        \"annotations\": \"Recordings are manually labeled by an ornithologist.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71506", "text": "{\n    \"dataset_name\": \"Freshwater Lake Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Minnesota, Department of Ecology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Systematic sampling from 10 lakes across Minnesota, monthly measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Lake Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71506", "text": "{\n    \"dataset_name\": \"Coastal Oceanographic Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Oregon State University, College of Oceanic and Atmospheric Sciences\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Moored buoys and ship-based surveys in the Pacific Northwest coastal region.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Current Dynamics off the Oregon Coast\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_ocean_data.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data calibrated using standard oceanographic methods.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71507", "text": "{\n    \"dataset_name\": \"Coastal Erosion Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara - Marine Science Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Shoreline Distance\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Sediment Volume\",\n            \"units\": \"cubic meters\"\n        },\n        {\n            \"name\": \"Beach Weight\",\n            \"units\": \"kilograms\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular beach surveys using GPS and drone imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Accelerated Coastal Erosion in California Due to Climate Change\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71507", "text": "{\n    \"dataset_name\": \"Atmospheric Pollutant Levels\",\n    \"creator\": {\n        \"name\": \"Global Air Quality Consortium\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"micrograms/cubic meter\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"parts per billion\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Urban Air Pollution\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data processed for missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71508", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"ug/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality of Lake Mendota\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--71508", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Discharge - Ohio River\",\n    \"creator\": {\n        \"name\": \"Ohio Environmental Protection Agency\",\n        \"affiliation\": \"Ohio EPA\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"BOD\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Total Suspended Solids\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Permitted discharge monitoring\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/ohioriver_wastewater.json\",\n    \"metadata\": {\n        \"data_size\": \"95MB\",\n        \"annotations\": \"Data represents point-source discharges\"\n    }\n}"}
{"_id": "Academic--research_data--p--71509", "text": "{\n    \"dataset_name\": \"North Pacific Climate Variability Dataset\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Moored Buoys and Ship-based Surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in North Pacific Climate Variability\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/north_pacific_climate.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71509", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Science, Policy, and Management\"\n    },\n    \"date_collected\": \"2021-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"counts\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Remote Sensing and Field Observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes species identification details.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71510", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research (INPA)\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes species identification and geolocation data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71510", "text": "{\n    \"dataset_name\": \"California Coastal Water Quality\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-08-20T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Systematic Grid Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Water Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/california_water.csv\",\n    \"metadata\": {\n        \"data_size\": \"70MB\",\n        \"annotations\": \"Data includes water quality parameters and location information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71511", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_NYC\",\n    \"creator\": {\n        \"name\": \"Columbia University Environmental Science Lab\",\n        \"affiliation\": \"Columbia University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_ppm\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"temperature_celsius\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"humidity_percent\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations throughout New York City\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"John Smith\",\n                \"Alice Johnson\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_nyc.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71511", "text": "{\n    \"dataset_name\": \"WaterQualityMonitoring_Amazon\",\n    \"creator\": {\n        \"name\": \"Local Government Agency\",\n        \"affiliation\": \"Amazon Basin Authority\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ph_level\",\n            \"units\": \"pH\"\n        },\n        {\n            \"name\": \"turbidity_ntu\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"dissolved_oxygen_mg_l\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Periodic sampling from key river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Assessment of the Amazon River\",\n            \"authors\": [\n                \"Maria Rodriguez\",\n                \"Carlos Silva\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/waterquality_amazon.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71512", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2021\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data_2021.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--71512", "text": "{\n    \"dataset_name\": \"Soil Composition Analysis - Regional Survey\",\n    \"creator\": {\n        \"name\": \"Agronomy Research Institute\",\n        \"affiliation\": \"State Agricultural College\"\n    },\n    \"date_collected\": \"2019-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Phosphorus Content\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Potassium Content\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random soil samples collected across the region\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Soil Variation Study\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes GPS coordinates of sampling locations\"\n    }\n}"}
{"_id": "Academic--research_data--p--71513", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations at 10 locations across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71513", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Data - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"Oceanographic Institute of Japan\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m³\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Research vessel transects across the Pacific Ocean.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial Variability of Chlorophyll-a in the Pacific Ocean\",\n            \"authors\": \"Tanaka, K. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_marine_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data requires specialized software (e.g., Panoply) for visualization and analysis. Complex data structure.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71514", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, Oceanographic Research Center\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Regular transect surveys with automated sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Runoff on Coastal Ecosystems\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
