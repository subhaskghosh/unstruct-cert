{"_id": "Academic--research_data--n--70755", "text": "{\n    \"dataset_name\": \"Global Climate Policy Database\",\n    \"creator\": {\n        \"name\": \"Policy Insights Group\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Policy Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Country\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Policy Type\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Document review and expert interviews\",\n    \"related_publications\": [\n        {\n            \"title\": \"International Climate Agreements\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_policy.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Policy descriptions available\"\n    }\n}"}
