{"_id": "Academic--research_data--n--69499", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow Dataset\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"vehicle_count\",\n            \"units\": \"vehicles per hour\"\n        },\n        {\n            \"name\": \"average_speed\",\n            \"units\": \"km/h\"\n        },\n        {\n            \"name\": \"road_segment\",\n            \"units\": \"identifier\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated traffic counters\",\n    \"related_publications\": [\n        {\n            \"title\": \"Traffic Congestion Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/traffic_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Missing data handled with imputation\"\n    }\n}"}
