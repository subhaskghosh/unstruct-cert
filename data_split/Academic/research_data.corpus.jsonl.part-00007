{"_id": "Academic--research_data--p--67020", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change - Global Observations\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Carbon Dioxide (CO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"Methane (CH4)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Nitrous Oxide (N2O)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Ozone (O3)\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global trends in atmospheric greenhouse gases\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
