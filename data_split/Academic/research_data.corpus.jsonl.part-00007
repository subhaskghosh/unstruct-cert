{"_id": "Academic--research_data--p--68326", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Sensor Data\",\n    \"creator\": {\n        \"name\": \"GreenTech Solutions\",\n        \"affiliation\": \"Private Research Lab\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature in Celsius.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring with sensor network\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.5 MB\",\n        \"annotations\": \"Data has been pre-processed to remove outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68326", "text": "{\n    \"dataset_name\": \"National Emissions Inventory - 2022\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2 Emissions\",\n            \"unit\": \"tons\",\n            \"description\": \"Sulfur Dioxide emissions reported annually\"\n        },\n        {\n            \"name\": \"NOx Emissions\",\n            \"unit\": \"tons\",\n            \"description\": \"Nitrogen Oxides emissions reported annually\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Modeled emissions based on industry reporting\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Emissions Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.gov/emissions_inventory.json\",\n    \"metadata\": {\n        \"data_size\": \"150 MB\",\n        \"annotations\": \"Data includes estimated emissions from various sources.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68327", "text": "{\n    \"dataset_name\": \"AirQualityData_US_2023\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in the United States\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata_us_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68327", "text": "{\n    \"dataset_name\": \"GlobalOceanPollution_2022\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"International Research Consortium\"\n    },\n    \"date_collected\": \"2022-01-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PlasticConcentration\",\n            \"unit\": \"particles/km³\"\n        },\n        {\n            \"name\": \"ChemicalPollutants\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Ship-based sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Plastic Pollution in the Oceans\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/globaloceanpollution_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Initial data release. Subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68328", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_California\",\n    \"creator\": {\n        \"name\": \"California Environmental Protection Agency\",\n        \"affiliation\": \"CalEPA\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"OzoneConcentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Continuous monitoring stations throughout California\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in California Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/california_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
