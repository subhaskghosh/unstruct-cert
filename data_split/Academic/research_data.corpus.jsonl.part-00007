{"_id": "Academic--research_data--p--71219", "text": "{\n    \"dataset_name\": \"Arctic Temperature Trends\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"Polar Research Institute, Canada\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Ice Thickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoy network and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Arctic Temperatures\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality assessed and verified by expert review.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71219", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Dr. Ben Carter\",\n        \"affiliation\": \"Environmental Monitoring Group, USA\"\n    },\n    \"date_collected\": \"2019-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Area\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Deforestation Rate\",\n            \"units\": \"percent\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Patterns in the Amazon\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_data.geojson\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data derived from Landsat satellite imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71220", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"authors\": \"Hansen et al.\",\n            \"year\": 2013\n        },\n        {\n            \"title\": \"Climate change impacts on forest ecosystems\",\n            \"authors\": \"Bradshaw et al.\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Dataset includes annual tree cover loss and gain data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71220", "text": "{\n    \"dataset_name\": \"Personal Weather Station Data\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Data collected from a personal weather station.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Local weather patterns\",\n            \"authors\": \"Doe, J.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/weatherdata.xml\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data collected from a single location.\"\n    }\n}"}
