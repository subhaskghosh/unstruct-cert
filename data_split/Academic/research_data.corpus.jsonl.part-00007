{"_id": "Academic--research_data--p--70659", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Land Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"name\": \"Ocean Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"name\": \"Ice Cover\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"Anomaly Uncertainty\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global grid cells, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
