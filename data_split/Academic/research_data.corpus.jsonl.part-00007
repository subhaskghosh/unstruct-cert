{"_id": "Academic--research_data--p--70475", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Recent Data\",\n    \"creator\": {\n        \"name\": \"NASA GISS Team\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal (Public Domain Dedication)\",\n    \"sampling_method\": \"Global average temperature calculation from surface temperature observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends 2020\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/csvs/\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Contains monthly global temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70475", "text": "{\n    \"dataset_name\": \"Historical Air Quality Data - Europe\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across Europe.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe 2019\",\n            \"authors\": [\n                \"EEA Report Team\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.eea.europa.eu/data-and-maps/data/air-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains hourly air quality measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70476", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2020-2023\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery (GLAD)\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange2023/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains annual forest loss data globally.\"\n    }\n}"}
