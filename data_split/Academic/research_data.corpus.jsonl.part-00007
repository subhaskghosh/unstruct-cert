{"_id": "Academic--research_data--n--70421", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Environmental Issues\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Sociology\"\n    },\n    \"date_collected\": \"2022-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"variable_name\": \"Post Text\",\n            \"units\": \"Text\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Twitter API streaming data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Perception of Climate Change\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes user IDs and timestamps.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70422", "text": "{\n    \"dataset_name\": \"UrbanAirQualityMonitoring_2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Areas\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data collected from 5 monitoring stations within the city limits.\"\n    }\n}"}
