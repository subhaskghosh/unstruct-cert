{"_id": "Academic--research_data--n--69032", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Oceanography\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2023-03-10T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Argo float deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Salinity Atlas\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/salinity_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"12.2MB\",\n        \"annotations\": \"Ocean salinity measurements from Argo floats.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69033", "text": "{\n    \"dataset_name\": \"Stanford Sentiment Treebank\",\n    \"creator\": {\n        \"name\": \"Richard Socher\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sentence_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"unit\": \"0-5 scale\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0\",\n    \"sampling_method\": \"Crowdsourcing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recursive Deep Models for Semantic Compositionality\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://nlp.stanford.edu/sentiment/treebank.zip\",\n    \"metadata\": {\n        \"data_size\": \"5.5 MB\",\n        \"annotations\": \"Sentiment labels\"\n    }\n}"}
