{"_id": "Academic--research_data--n--69187", "text": "{\n    \"dataset_name\": \"Historical Climate Data - 1950-2019\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Station-based measurements, daily recordings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Trends in the 20th Century\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_climate.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Missing data indicated by -999\"\n    }\n}"}
{"_id": "Academic--research_data--p--69188", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Contains monthly temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--69188", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"variable_name\": \"carbon_dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification in the Pacific Ocean\",\n            \"authors\": [\n                \"Richard Feely\",\n                \"Chris Sabine\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.pmel.noaa.gov/co2/\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Contains measurements of ocean pH and CO2 levels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69189", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Resolution X\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Image Resolution Y\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Random sampling of patients with neurological conditions\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual segmentation of brain tumors\"\n    }\n}"}
{"_id": "Academic--research_data--n--69189", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Rodriguez\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Gender\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective collection of patients presenting with respiratory symptoms\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Detection of Pneumonia in Chest X-Rays\",\n            \"authors\": [\n                \"Rodriguez, D.\",\n                \"Kim, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Radiologist reports\"\n    }\n}"}
{"_id": "Academic--research_data--p--69190", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69190", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"National Geographic Society\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Temperate Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geographic coordinates included\"\n    }\n}"}
{"_id": "Academic--research_data--p--69191", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Impacts Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of CO2 on Global Temperature\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69191", "text": "{\n    \"dataset_name\": \"Ocean Current Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. James Wilson\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Circulation Patterns\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data calibrated using standard methods\"\n    }\n}"}
{"_id": "Academic--research_data--p--69192", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2021\",\n            \"authors\": \"Friedlingstein et al.\"\n        }\n    ],\n    \"download_url\": \"https://gmd.noaa.gov/data/co2/co2-ccgg-global.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69192", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Department of Oceanography\"\n    },\n    \"date_collected\": \"2019-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees West\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite remote sensing and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Heat Content and Climate Change\",\n            \"authors\": \"Lyman et al.\"\n        }\n    ],\n    \"download_url\": \"https://www.whoi.edu/ocean-temp-anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data is spatially interpolated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69193", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2023-2024\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-02-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global average temperature measurements from meteorological stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A 2023 Update\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69193", "text": "{\n    \"dataset_name\": \"Ocean Current Speeds\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"meters/second\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Data collected from research vessels and buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Current Dynamics in the Pacific\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Provides data on ocean currents and salinity levels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69194", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Data - Global Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric CO2\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69194", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies - Pacific Region\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2022-08-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Buoy deployments and ship-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Temperature Variability\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is averaged monthly.\"\n    }\n}"}
