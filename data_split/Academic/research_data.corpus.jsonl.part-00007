{"_id": "Academic--research_data--p--67698", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"units\": \"file path\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"units\": \"binary (positive/negative)\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective cohort study from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"CheXpert: Large Scale Chest X-Ray Interpretation\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"2.5GB\",\n        \"annotations\": \"Radiologist-verified pneumonia labels\"\n    }\n}"}
{"_id": "Academic--research_data--n--67698", "text": "{\n    \"dataset_name\": \"Healthy Brain MRI Collection\",\n    \"creator\": {\n        \"name\": \"University of California, San Francisco\",\n        \"affiliation\": \"UCSF Brain Imaging Center\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"subject_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"scan_type\",\n            \"units\": \"T1-weighted, T2-weighted\"\n        },\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective study of healthy volunteers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Normal Brain MRI Atlases\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/healthy_brains\",\n    \"metadata\": {\n        \"data_size\": \"6.2GB\",\n        \"annotations\": \"No pathological findings\"\n    }\n}"}
{"_id": "Academic--research_data--p--67699", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"Degrees East\"\n        },\n        {\n            \"name\": \"Time\",\n            \"unit\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Temperature anomalies relative to a base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67699", "text": "{\n    \"dataset_name\": \"Historical Weather Records - City A\",\n    \"creator\": {\n        \"name\": \"City A Meteorological Department\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"inches\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"Restricted - Government Use Only\",\n    \"sampling_method\": \"Daily observations at a single weather station\",\n    \"related_publications\": [],\n    \"download_url\": \"http://cityaweather.gov/data\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Raw weather data.\"\n    }\n}"}
