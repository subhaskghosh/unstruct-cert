{"_id": "Academic--research_data--p--67588", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"O3 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67588", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Institute\",\n        \"affiliation\": \"Research Department\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Rainforest\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://conservation.org/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes species identification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67589", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67589", "text": "{\n    \"dataset_name\": \"Forest Bird Sounds\",\n    \"creator\": {\n        \"name\": \"Bioacoustics Research Lab\",\n        \"affiliation\": \"Cornell University\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Bird species identified\"\n        },\n        {\n            \"name\": \"Timestamp\",\n            \"units\": \"N/A\",\n            \"description\": \"Time of recording\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0\",\n    \"sampling_method\": \"Automated recording units\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bird Vocalization Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_sounds.zip\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Manual annotations of bird calls\"\n    }\n}"}
{"_id": "Academic--research_data--p--67590", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (Pneumonia)\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2024-01-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"ImageID\",\n            \"units\": \"Unique Identifier\"\n        },\n        {\n            \"variable_name\": \"PatientAge\",\n            \"units\": \"years\"\n        },\n        {\n            \"variable_name\": \"Pneumonia\",\n            \"units\": \"Binary (Present/Absent)\"\n        },\n        {\n            \"variable_name\": \"ImageQuality\",\n            \"units\": \"Scale 1-5\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Retrospective review of patient records\",\n    \"related_publications\": [\n        {\n            \"title\": \"ChestX-ray8: Dataset and baseline classification\",\n            \"year\": 2017\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Expert radiologist labels\"\n    }\n}"}
{"_id": "Academic--research_data--n--67590", "text": "{\n    \"dataset_name\": \"ISIC Archive - Skin Lesion Analysis\",\n    \"creator\": {\n        \"name\": \"International Skin Imaging Collaboration\",\n        \"affiliation\": \"ISIC\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"age\",\n            \"units\": \"years\"\n        },\n        {\n            \"variable_name\": \"sex\",\n            \"units\": \"categorical (male/female)\"\n        }\n    ],\n    \"data_format\": \"JPG\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Crowdsourced data collection from dermatological clinics\",\n    \"related_publications\": [\n        {\n            \"title\": \"The ISIC Archive\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.isic-archive.com/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Expert dermatologist annotations\"\n    }\n}"}
{"_id": "Academic--research_data--p--67591", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"GISS Team\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"High quality, regularly updated dataset.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67591", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Station-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Daily Global Historical Climatology Network\",\n            \"authors\": [\n                \"Menne et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Long-term historical data, some missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67592", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Sciences Lab\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67592", "text": "{\n    \"dataset_name\": \"Soil Nutrient Levels - Agricultural Regions\",\n    \"creator\": {\n        \"name\": \"Agronomy Research Institute\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrate Levels\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphate Levels\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium Levels\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"pH units\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random soil sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Fertilizer Application\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Jones, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_nutrients.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data represents average values across multiple samples.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67593", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67593", "text": "{\n    \"dataset_name\": \"Bird Species Observations\",\n    \"creator\": {\n        \"name\": \"Ornithological Society\",\n        \"affiliation\": \"Non-profit organization\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Identified bird species.\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Latitude of observation.\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Longitude of observation.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bird Migration Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_observations.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Observations contributed by volunteers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67594", "text": "{\n    \"dataset_name\": \"Global Precipitation and Evapotranspiration Dataset\",\n    \"creator\": {\n        \"name\": \"WorldClim Consortium\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"precipitation\",\n            \"units\": \"mm/month\"\n        },\n        {\n            \"variable_name\": \"evapotranspiration\",\n            \"units\": \"mm/month\"\n        },\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Gridded climate data based on station observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"High-resolution global datasets of precipitation and evapotranspiration\",\n            \"authors\": [\n                \"Fick, S.E.\",\n                \"Hijmans, R.J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://worldclim.org/data/index\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Includes monthly data from 1979-2023\"\n    }\n}"}
{"_id": "Academic--research_data--n--67594", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"temperature_anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Continued Global Warming\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Monthly global temperature anomalies since 1880\"\n    }\n}"}
{"_id": "Academic--research_data--p--67595", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous measurements from ground-based stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric Composition Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67595", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Ocean Current Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Ship-based measurements and buoy deployments.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data interpolated to a 1-degree grid.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67596", "text": "{\n    \"dataset_name\": \"Rare Disease Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Resolution X\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Image Resolution Y\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"MRI Sequence\",\n            \"units\": \"type\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Prospective cohort study with inclusion of patients diagnosed with rare genetic neurological disorders.\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI Characteristics of X-Linked Adrenoleukodystrophy\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        },\n        {\n            \"title\": \"Deep Learning for Automated Detection of Rare Brain Abnormalities\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Lee, J.\",\n                \"Carter, E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/raredisease_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Expert radiologists provided detailed annotations of all MRI scans.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67596", "text": "{\n    \"dataset_name\": \"Common Cold Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Smith\",\n        \"affiliation\": \"Local Hospital\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Resolution X\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Image Resolution Y\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"X-Ray Dose\",\n            \"units\": \"mSv\"\n        },\n        {\n            \"name\": \"Patient Gender\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Retrospective review of chest x-rays from patients presenting with cold symptoms.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Initial Observations on Chest X-Ray Findings in Common Cold Patients\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Smith, D.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/cold_xray.zip\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Limited annotations provided, primarily identifying lung regions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67597", "text": "{\n    \"dataset_name\": \"Global Forest Watch Climate Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_cover_loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"carbon_emissions\",\n            \"units\": \"tonnes CO2e\"\n        },\n        {\n            \"name\": \"biome\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis and ground-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change and its impacts on climate\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data includes annual tree cover loss from 2000-2023.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67597", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in global temperature\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Daily weather records from 1950-2020.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67598", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predicting Air Quality Using Machine Learning\",\n            \"authors\": [\n                \"John Doe\",\n                \"Jane Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included for each measurement\"\n    }\n}"}
{"_id": "Academic--research_data--n--67598", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Latitude/Longitude\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Daily measurements from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Rainfall Patterns\",\n            \"authors\": [\n                \"Alice Brown\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Missing data indicated by -999\"\n    }\n}"}
{"_id": "Academic--research_data--p--67599", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Rural Areas of California\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Relative Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across rural California.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Practices on Rural Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/california_rural_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
