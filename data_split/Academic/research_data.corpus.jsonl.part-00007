{"_id": "Academic--research_data--p--67817", "text": "{\n    \"dataset_name\": \"Global Forest Watch Climate Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"units\": \"tonnes CO2e\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Watch Annual Report 2023\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Provides data on forest loss, gain, and carbon emissions globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67817", "text": "{\n    \"dataset_name\": \"Antarctic Ice Core Atmospheric Composition\",\n    \"creator\": {\n        \"name\": \"British Antarctic Survey\",\n        \"affiliation\": \"NERC\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Ice core extraction and gas analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in atmospheric composition from Antarctic ice cores\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.bas.ac.uk/data/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Detailed records of past atmospheric composition from Antarctic ice cores.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67818", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"Dobson Units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from ground-based stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atmospheric Composition on Global Warming\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67818", "text": "{\n    \"dataset_name\": \"Ocean Temperature Trends\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Buoy measurements and oceanographic surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Ocean Temperatures\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data calibrated using standard oceanographic procedures.\"\n    }\n}"}
