{"_id": "Academic--research_data--n--69070", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees North\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Ship-based conductivity, temperature, and depth (CTD) measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity Variability\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Contains ocean salinity profiles.\"\n    }\n}"}
