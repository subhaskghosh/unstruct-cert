{"_id": "Academic--research_data--n--69414", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Hadley Centre for Climate Prediction and Research\",\n        \"affiliation\": \"UK Met Office\"\n    },\n    \"date_collected\": \"2019-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government Licence v3.0\",\n    \"sampling_method\": \"Reanalysis of ocean temperature data\",\n    \"related_publications\": [\n        {\n            \"title\": \"HadCRUT5\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.metoffice.gov.uk/hadobs/hadcrut5/\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Includes uncertainty estimates.\"\n    }\n}"}
