{"_id": "Academic--research_data--p--70603", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular monitoring stations along major rivers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water-Quality Trends in the United States\",\n            \"authors\": \"USGS Water Science Center\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/national-river-water-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
