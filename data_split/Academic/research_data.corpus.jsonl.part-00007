{"_id": "Academic--research_data--p--69895", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network - Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Temperature\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ],\n            \"journal\": \"Nature Climate Change\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69895", "text": "{\n    \"dataset_name\": \"Ocean Acidification Monitoring Program\",\n    \"creator\": {\n        \"name\": \"Marine Research Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Monthly seawater samples collected from research vessels\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Acidification on Marine Life\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ],\n            \"journal\": \"Marine Ecology Progress Series\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://mri.ucsd.edu/data/oa-monitoring\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data calibrated against standard seawater standards\"\n    }\n}"}
{"_id": "Academic--research_data--p--69896", "text": "{\n    \"dataset_name\": \"Global Temperature Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69896", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Study\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"leaf_area\",\n            \"units\": \"cm^2\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity in California Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/biodiversity_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Species identification verified by experts\"\n    }\n}"}
{"_id": "Academic--research_data--p--69897", "text": "{\n    \"dataset_name\": \"COVID-19 Radiography Database\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_type\",\n            \"units\": \"X-ray, CT scan\"\n        },\n        {\n            \"name\": \"finding\",\n            \"units\": \"presence/absence of COVID-19 indicators\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective collection from hospital archives\",\n    \"related_publications\": [\n        {\n            \"title\": \"Development and Validation of a Deep Learning System for COVID-19 Detection\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\",\n                \"Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/covid_radiography_dataset\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Radiologist-verified bounding boxes\"\n    }\n}"}
{"_id": "Academic--research_data--n--69897", "text": "{\n    \"dataset_name\": \"Mammographic Image Archive\",\n    \"creator\": {\n        \"name\": \"Curative AI\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_type\",\n            \"units\": \"Mammography\"\n        },\n        {\n            \"name\": \"BI-RADS\",\n            \"units\": \"Assessment category\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective study at a single hospital\",\n    \"related_publications\": [\n        {\n            \"title\": \"Improving Breast Cancer Detection with AI\",\n            \"authors\": [\n                \"Doe\",\n                \"Roe\",\n                \"Yoe\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/mammography_dataset\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Radiologist annotations with BI-RADS scores\"\n    }\n}"}
{"_id": "Academic--research_data--p--69898", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"Gavin Schmidt\",\n                \"Drew Shindell\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Monthly temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--69898", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-3.0\",\n    \"sampling_method\": \"Rain gauge network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in US Precipitation\",\n            \"authors\": [\n                \"John Doe\",\n                \"Jane Smith\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/data\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily rainfall totals\"\n    }\n}"}
{"_id": "Academic--research_data--p--69899", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69899", "text": "{\n    \"dataset_name\": \"Arctic Ice Extent - 2022-2023\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2022-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Sea Ice Thickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Satellite imagery analysis of Arctic sea ice.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Arctic Ice Cover\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_ice_extent.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data sourced from NASA satellite observations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69900", "text": "{\n    \"dataset_name\": \"Coastal Water Temperature Data\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Automated buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69900", "text": "{\n    \"dataset_name\": \"Urban Air Quality Readings\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Metropolitan Government\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Fixed site monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Pollution Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Sensor calibration data available\"\n    }\n}"}
