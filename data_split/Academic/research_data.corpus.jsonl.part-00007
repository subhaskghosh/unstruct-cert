{"_id": "Academic--research_data--p--69888", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature in 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes land and ocean surface temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69888", "text": "{\n    \"dataset_name\": \"Atmospheric Pressure Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Atmospheric Pressure\",\n            \"units\": \"Pascals\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 3.0 Unported\",\n    \"sampling_method\": \"Hourly measurements from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Atmospheric Pressure Trends\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_pressure.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from various weather stations across the US.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69889", "text": "{\n    \"dataset_name\": \"Simulated Stock Prices\",\n    \"creator\": {\n        \"name\": \"DataGen Inc.\",\n        \"affiliation\": \"Financial Modeling Department\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Open\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"High\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"Low\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"Close\",\n            \"units\": \"USD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Simulated daily closing prices\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/stock_prices.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Simulated data, not real market data.\"\n    }\n}"}
