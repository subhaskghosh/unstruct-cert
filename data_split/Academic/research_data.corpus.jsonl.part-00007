{"_id": "Academic--research_data--p--66714", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Temperature anomalies relative to a baseline period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66714", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data\",\n    \"creator\": {\n        \"name\": \"Alice Smith\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2019-12-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Rain gauge measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in the 20th Century\",\n            \"authors\": [\n                \"Alice Smith\",\n                \"Bob Johnson\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Daily rainfall amounts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66715", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_NYC\",\n    \"creator\": {\n        \"name\": \"NYC Department of Environmental Protection\",\n        \"affiliation\": \"NYC Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in New York City\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_nyc.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--66715", "text": "{\n    \"dataset_name\": \"OceanTemperatureReadings\",\n    \"creator\": {\n        \"name\": \"Marine Research Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Research vessel surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Temperature Variations in the Pacific\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data from sensors\"\n    }\n}"}
{"_id": "Academic--research_data--p--66716", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tumor Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Edema Volume\",\n            \"units\": \"cm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI-based analysis of brain tumor growth\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/braintumor_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-verified segmentations\"\n    }\n}"}
{"_id": "Academic--research_data--n--66716", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Lung Area\",\n            \"units\": \"cm^2\"\n        },\n        {\n            \"name\": \"Heart Size Ratio\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Retrospective chart review\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated detection of pneumonia in chest X-rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chestxray.zip\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Pneumonia labels\"\n    }\n}"}
