{"_id": "Academic--research_data--p--68000", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Stanford Machine Learning Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"unit\": \"file path\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"unit\": \"binary (positive/negative)\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Retrospective collection of chest X-ray images from hospital records, ensuring a balanced distribution of pneumonia cases.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection in Chest X-Rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_pneumonia.zip\",\n    \"metadata\": {\n        \"data_size\": \"2.5GB\",\n        \"annotations\": \"Expert radiologists labeled images for presence of pneumonia.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68000", "text": "{\n    \"dataset_name\": \"Brain MRI Scans for Tumor Segmentation\",\n    \"creator\": {\n        \"name\": \"Radiology Solutions Inc.\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"scan_type\",\n            \"unit\": \"MRI sequence\"\n        },\n        {\n            \"name\": \"tumor_volume\",\n            \"unit\": \"cm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Proprietary - Limited Use\",\n    \"sampling_method\": \"Prospective study recruiting patients with suspected brain tumors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation Using Deep Neural Networks\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_tumors.zip\",\n    \"metadata\": {\n        \"data_size\": \"8GB\",\n        \"annotations\": \"Segmentation masks generated by trained radiologists.\"\n    }\n}"}
