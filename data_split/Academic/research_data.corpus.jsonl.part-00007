{"_id": "Academic--research_data--n--70323", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Institute\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2019-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Farm surveys, annual data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate on Crop Production\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected from various farms\"\n    }\n}"}
