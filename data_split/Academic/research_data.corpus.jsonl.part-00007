{"_id": "Academic--research_data--p--70736", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--70736", "text": "{\n    \"dataset_name\": \"Forest Bird Species Distribution\",\n    \"creator\": {\n        \"name\": \"Ornithological Society\",\n        \"affiliation\": \"University of California\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"Number of individuals\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Point counts in forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bird Diversity in California Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species identified by expert ornithologists\"\n    }\n}"}
{"_id": "Academic--research_data--p--70737", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentration Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements at global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2023\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included. Comprehensive documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70737", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Amazon Basin\",\n    \"creator\": {\n        \"name\": \"University of São Paulo\",\n        \"affiliation\": \"Institute of Astronomy, Geophysics and Atmospheric Sciences\"\n    },\n    \"date_collected\": \"2019-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees South\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees West\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Daily measurements from rain gauges\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Rainforest Rainfall Patterns\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Some missing data values. Limited documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70738", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Climate Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data is quality controlled and gap-filled using interpolation techniques.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70738", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis - Climate Debate\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2021-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"Character Count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Twitter API Streaming\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/sentiment_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data contains tweets related to climate change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70739", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen, M. C.\",\n                \"Potapov, P. V.\",\n                \"Moore, R.\",\n                \"Houthuyzen, H. M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Dataset includes annual forest loss and gain data globally.\"\n    }\n}"}
