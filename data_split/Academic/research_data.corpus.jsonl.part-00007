{"_id": "Academic--research_data--p--68569", "text": "{\n    \"dataset_name\": \"Twitter Sentiment Analysis - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Computer Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tweet_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"tweet_text\",\n            \"unit\": \"text\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"unit\": \"range -1 to 1\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling of public tweets based on keywords.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis of Twitter Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/twitter_sentiment_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Sentiment scores generated using a pre-trained BERT model.\"\n    }\n}"}
