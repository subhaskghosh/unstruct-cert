{"_id": "Academic--research_data--n--69843", "text": "{\n    \"dataset_name\": \"EEG Sleep Study Data\",\n    \"creator\": {\n        \"name\": \"Sleep Research Lab\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"EEG_channel_1\",\n            \"units\": \"uV\"\n        },\n        {\n            \"name\": \"Sleep_stage\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Polysomnography recordings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sleep Architecture and Cognitive Performance\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/sleep_eeg.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains EEG data from sleep studies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69844", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tumor Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Edema Size\",\n            \"units\": \"mm^3\"\n        },\n        {\n            \"name\": \"Cortex Thickness\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective MRI scans of patients diagnosed with brain tumors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI-based Assessment of Brain Tumor Progression\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual segmentation of tumor regions provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69844", "text": "{\n    \"dataset_name\": \"Chest X-ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-08-20T14:45:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Lung Area\",\n            \"units\": \"cm^2\"\n        },\n        {\n            \"name\": \"Heart Size Ratio\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Detection of Pneumonia in Chest X-rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray.zip\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Pneumonia labels provided by radiologists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69845", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-02-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from globally distributed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69845", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Department of Oceanography\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees West\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Satellite-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Warming on Marine Ecosystems\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data interpolated to a 1-degree grid\"\n    }\n}"}
{"_id": "Academic--research_data--p--69846", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69846", "text": "{\n    \"dataset_name\": \"Ocean Temperature Readings\",\n    \"creator\": {\n        \"name\": \"Marine Biology Department\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-12-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming and Coral Bleaching\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data calibrated with NOAA standards\"\n    }\n}"}
{"_id": "Academic--research_data--p--69847", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentration Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2021-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements at fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2022\",\n            \"authors\": [\n                \"Friedlingstein, P.\",\n                \"O'Sullivan, M.\",\n                \"Jones, M.W.\",\n                \"Andrew, R.M.\",\n                \"Hainsworth, S.\",\n                \"Allan, J.R.\",\n                \"Bopp, L.\",\n                \"Carboni, S.\",\n                \"Chini, L.P.\",\n                \"Collier, F.I.\",\n                \"Doney, S.C.\",\n                \"Gasser, T.\",\n                \"Harris, R.L.\",\n                \"Havenhand, C.\",\n                \"Hooper, T.\",\n                \"Kainuma, M.\",\n                \"Kesselaar, A.E.\",\n                \"Landa, M.G.\",\n                \"Levi, S.\",\n                \"MacKenzie, A.R.\",\n                \"Mohn, W.\",\n                \"Nausbaum, P.\",\n                \"Plattner, G.K.\",\n                \"Reubell, A.\",\n                \"Smith, N.J.\",\n                \"Valks, P.\",\n                \"van der Werf, G.R.\",\n                \"Worden, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://gmd.data.gov/dataset/ccdc0c3d8-e78f-4644-b16f-94912f0a5f3d\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69847", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"Global Historical Climatology Network\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2018-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Station ID\",\n            \"units\": \"Numeric\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily measurements from weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Temperatures\",\n            \"authors\": [\n                \"Jones, P.D.\",\n                \"Dyer, T.S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Missing data values are represented as -9999.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69848", "text": "{\n    \"dataset_name\": \"UCI Machine Learning Repository - Iris Dataset\",\n    \"creator\": {\n        \"name\": \"Jeffrey Mark Siskind\",\n        \"affiliation\": \"UCI Machine Learning Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sepal_length\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"name\": \"sepal_width\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"name\": \"petal_length\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"name\": \"petal_width\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"name\": \"species\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Collected from measurements of iris flowers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Fisher, R. A. (1936). The use of multiple measurements in taxonomic problems.\",\n            \"year\": 1936\n        }\n    ],\n    \"download_url\": \"https://archive.ics.uci.edu/ml/datasets/Iris\",\n    \"metadata\": {\n        \"data_size\": \"64KB\",\n        \"annotations\": \"Contains 150 data points, representing three species of iris.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69848", "text": "{\n    \"dataset_name\": \"Climate Data - Global Temperatures\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"average_temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"minimum_temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"maximum_temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Collected from weather stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Hansen, J., et al. (2006). Global temperature change.\",\n            \"year\": 2006\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Monthly global temperature data from 1880 to present.\"\n    }\n}"}
