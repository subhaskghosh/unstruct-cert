{"_id": "Academic--research_data--n--66394", "text": "{\n    \"dataset_name\": \"Historical Weather Data - North America\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"meters per second\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0 International\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Patterns in North America\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"1.8GB\",\n        \"annotations\": \"Historical daily weather data from across North America.\"\n    }\n}"}
