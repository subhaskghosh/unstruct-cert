{"_id": "Academic--research_data--n--67367", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geography\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"TreeCover2000\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of tree cover in the year 2000.\"\n        },\n        {\n            \"variable_name\": \"Lossyear\",\n            \"units\": \"Year\",\n            \"description\": \"Year of forest loss.\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change Analysis\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Derived from Landsat satellite data.\"\n    }\n}"}
