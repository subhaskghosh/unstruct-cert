{"_id": "Academic--research_data--n--68169", "text": "{\n    \"dataset_name\": \"Global Ocean Salinity Data\",\n    \"creator\": {\n        \"name\": \"National Oceanography Centre\",\n        \"affiliation\": \"University of Southampton\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Ship-based measurements and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity and Climate Change\",\n            \"authors\": \"Jones et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_ocean_salinity.nc\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Processed data with quality control.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68170", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68170", "text": "{\n    \"dataset_name\": \"IndustrialWastewaterDischarge\",\n    \"creator\": {\n        \"name\": \"AquaTech Solutions\",\n        \"affiliation\": \"AquaTech Inc.\"\n    },\n    \"date_collected\": \"2018-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Continuous monitoring of wastewater discharge points.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://aquatech.com/wastewater_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"2.2 MB\",\n        \"annotations\": \"Data is pre-processed and normalized.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68171", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Lab\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes timestamps and location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68171", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data\",\n    \"creator\": {\n        \"name\": \"National Weather Service\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Rain gauges\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Rainfall Trends\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes daily rainfall measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68172", "text": "{\n    \"dataset_name\": \"Water Quality Monitoring in Lake Erie\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from various locations around Lake Erie.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Lake Erie Water Quality Assessment\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
