{"_id": "Academic--research_data--p--71465", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Pacific Marine Environmental Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Autonomous Underwater Vehicle (AUV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Warming on Marine Ecosystems\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71465", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentration\",\n    \"creator\": {\n        \"name\": \"Global Carbon Project\",\n        \"affiliation\": \"University of East Anglia\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2022\",\n            \"authors\": [\n                \"Friedlingstein, P.\",\n                \"O'Sullivan, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data has been quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71466", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2022\",\n    \"creator\": {\n        \"name\": \"Environmental Science Department, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Water pH\",\n            \"units\": \"pH\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--71466", "text": "{\n    \"dataset_name\": \"Industrial Emissions Survey - 2021\",\n    \"creator\": {\n        \"name\": \"ChemCorp Analytics\",\n        \"affiliation\": \"ChemCorp\"\n    },\n    \"date_collected\": \"2021-06-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2 Emissions\",\n            \"units\": \"tons/year\"\n        },\n        {\n            \"name\": \"NOx Emissions\",\n            \"units\": \"tons/year\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Annual facility surveys\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/industrial_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Limited metadata available\"\n    }\n}"}
{"_id": "Academic--research_data--p--71467", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentrations - Global Monitoring\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories (ESRL)\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"parts per million\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at globally distributed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2023\",\n            \"authors\": [\n                \"Friedlingstein, P.\",\n                \"O'Sullivan, M.\",\n                \"Jones, M. W.\",\n                \"Andrew, R. M.\",\n                \"Haskins, R. T.\",\n                \"Peters, G. P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://gml.noaa.gov/ccgg/data/co2/csv/\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71467", "text": "{\n    \"dataset_name\": \"Climate Model Output - CMIP6\",\n    \"creator\": {\n        \"name\": \"Coupled Model Intercomparison Project\",\n        \"affiliation\": \"World Climate Research Programme\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"parts per million\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA 3.0\",\n    \"sampling_method\": \"Simulation using a complex climate model.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The CMIP6 climate model archive\",\n            \"authors\": [\n                \"Eyring, V.\",\n                \"Boucher, O.\",\n                \"Eyring, V.\",\n                \"Schmidt, H.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"250GB\",\n        \"annotations\": \"Model simulation data. Requires post-processing.\"\n    }\n}"}
