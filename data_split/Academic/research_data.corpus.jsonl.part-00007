{"_id": "Academic--research_data--n--68295", "text": "{\n    \"dataset_name\": \"Global Soil Nutrient Levels\",\n    \"creator\": {\n        \"name\": \"FAO\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"units\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Calcium\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Magnesium\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Sulfur\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Boron\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 3.0 IGO\",\n    \"sampling_method\": \"Soil sample collection from various locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Soil Status Report\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.fao.org/soil-data/download\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes measurements from multiple countries.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68296", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Industrial Emissions on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68296", "text": "{\n    \"dataset_name\": \"Rural Forest Ecosystem Study - Scotland\",\n    \"creator\": {\n        \"name\": \"Dr. Alistair McGregor\",\n        \"affiliation\": \"University of Edinburgh\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in Scottish Forests\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/scottish_forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Geospatial data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--68297", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2020-2024\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
