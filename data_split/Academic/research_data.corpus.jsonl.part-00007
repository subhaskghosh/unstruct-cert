{"_id": "Academic--research_data--n--69565", "text": "{\n    \"dataset_name\": \"Historical Climate Data - 1950-2010\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2015-06-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Data collected from a network of weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term climate variations\",\n            \"year\": 2017\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_climate.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Missing values are indicated by -999.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69566", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Ocean Average Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Temperature anomalies relative to a base period.\"\n    }\n}"}
