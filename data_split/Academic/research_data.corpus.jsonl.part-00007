{"_id": "Academic--research_data--n--70679", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis - Election 2024\",\n    \"creator\": {\n        \"name\": \"Political Data Labs\",\n        \"affiliation\": \"Independent Research Firm\"\n    },\n    \"date_collected\": \"2023-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"text\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"User ID\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Streaming API access to Twitter.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Opinion During Elections\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/election_sentiment.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Sentiment scores calculated using a pre-trained model.\"\n    }\n}"}
