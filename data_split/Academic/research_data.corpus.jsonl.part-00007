{"_id": "Academic--research_data--n--68733", "text": "{\n    \"dataset_name\": \"Global Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"NASA Oceanography\",\n        \"affiliation\": \"Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global salinity patterns\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity.nc\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Large dataset requiring specialized software to process.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68734", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality-controlled and gap-filled using interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68734", "text": "{\n    \"dataset_name\": \"Remote Sensing Vegetation Health\",\n    \"creator\": {\n        \"name\": \"Geospatial Analytics Lab\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-08-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"NDVI\",\n            \"units\": \"unitless\",\n            \"description\": \"Normalized Difference Vegetation Index\"\n        },\n        {\n            \"variable_name\": \"EVI\",\n            \"units\": \"unitless\",\n            \"description\": \"Enhanced Vegetation Index\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Research-Only License - Non-Commercial Use Only\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Vegetation Health Monitoring using Remote Sensing\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/vegetation_health.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data derived from Landsat 8 imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68735", "text": "{\n    \"dataset_name\": \"USGS National Water Quality Assessment Program - Field Data\",\n    \"creator\": {\n        \"name\": \"United States Geological Survey\",\n        \"affiliation\": \"USGS\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Systematic Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Surface Water and Groundwater Data\",\n            \"authors\": [\n                \"Paul R. Mueller\",\n                \"Susan P. Marcum\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://waterdata.usgs.gov/nwis/qwdata\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Comprehensive water quality data collected across the United States. Includes metadata for each sampling location and analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68735", "text": "{\n    \"dataset_name\": \"Global Marine Plastic Pollution Database\",\n    \"creator\": {\n        \"name\": \"Ocean Conservancy\",\n        \"affiliation\": \"Ocean Conservancy\"\n    },\n    \"date_collected\": \"2024-01-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plastic Concentration\",\n            \"units\": \"particles/km^2\"\n        },\n        {\n            \"name\": \"Plastic Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Opportunistic beach cleanup data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sources and Distribution of Marine Plastic Pollution\",\n            \"authors\": [\n                \"Erik van Sebille\",\n                \"Laurent Lebreton\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://oceanconservancy.org/trashfreeoceans/plastic-database/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data on plastic pollution found in marine environments worldwide. Data quality varies based on cleanup efforts.\"\n    }\n}"}
