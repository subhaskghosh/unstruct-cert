{"_id": "Academic--research_data--n--71961", "text": "{\n    \"dataset_name\": \"SoilNutrientAnalysis_Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa State University Agronomy Department\",\n        \"affiliation\": \"ISU\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Bulk Density\",\n            \"units\": \"g/cm³\"\n        },\n        {\n            \"name\": \"Soil Texture\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Calcium\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Magnesium\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Sulfur\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Boron\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Iron\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Manganese\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Zinc\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Copper\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Grid sampling\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/soil_iowa.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n  