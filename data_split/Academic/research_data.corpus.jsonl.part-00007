{"_id": "Academic--research_data--n--71116", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"units\": \"Shannon Diversity Index\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Light Intensity\",\n            \"units\": \"lux\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Nitrogen Levels\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphorus Levels\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Potassium Levels\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Water Stress Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Disease Incidence\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Pest Infestation\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Growth Rate\",\n            \"units\": \"cm/year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random plots within forest areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Spatial coordinates included\"\n    }\n}"}
