{"_id": "Academic--research_data--p--69609", "text": "{\n    \"dataset_name\": \"Student Performance Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Student ID\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Math Score\",\n            \"unit\": \"points\"\n        },\n        {\n            \"name\": \"Reading Score\",\n            \"unit\": \"points\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling of students from multiple schools\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Study Habits on Academic Performance\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/student_performance.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data cleaned and preprocessed.\"\n    }\n}"}
