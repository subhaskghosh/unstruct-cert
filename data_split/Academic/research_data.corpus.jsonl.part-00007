{"_id": "Academic--research_data--n--68232", "text": "{\n    \"dataset_name\": \"GlobalForestCarbonStocks\",\n    \"creator\": {\n        \"name\": \"NASA Earth Science Data\",\n        \"affiliation\": \"Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\",\n            \"description\": \"Total aboveground biomass per hectare\"\n        },\n        {\n            \"variable_name\": \"Soil Carbon\",\n            \"units\": \"tonnes/hectare\",\n            \"description\": \"Total soil carbon per hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Remote sensing data and ground measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Stock Assessment\",\n            \"authors\": \"Jones et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forestcarbon.tif\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data derived from satellite imagery\"\n    }\n}"}
{"_id": "Academic--research_data--p--68233", "text": "{\n    \"dataset_name\": \"US River Water Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Grab samples collected weekly from various river locations across the US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68233", "text": "{\n    \"dataset_name\": \"European Lake Sediment Analysis\",\n    \"creator\": {\n        \"name\": \"Helmholtz Centre for Environmental Research\",\n        \"affiliation\": \"Germany\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sediment Organic Carbon\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Sediment Nitrogen\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Sediment cores collected annually from selected European lakes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in lake sediment composition\",\n            \"authors\": [\n                \"Schmidt, K.\",\n                \"Weber, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_sediment_data.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data has been radiometrically dated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68234", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Air Quality Report 2023\",\n            \"authors\": \"GLA Environmental Team\"\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68234", "text": "{\n    \"dataset_name\": \"ClimateModel_OceanTemperature\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Climate Modeling Center\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Climate model simulation output\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Modeling\",\n            \"authors\": \"NOAA Climate Team\"\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Model output with various resolution options.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68235", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global meteorological stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Temperature anomalies relative to the 1951-1980 average.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68235", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Crop Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Country\",\n            \"units\": \"ISO code\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Annual surveys of agricultural production\",\n    \"related_publications\": [\n        {\n            \"title\": \"The State of Food and Agriculture\",\n            \"authors\": [\n                \"FAO Team\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Yield data for major crops worldwide.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68236", "text": "{\n    \"dataset_name\": \"Global Forest Change Data\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Remote sensing analysis using Landsat imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"authors\": \"Hansen et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_change_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes annual tree cover loss and gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68236", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Climate Monitoring Branch\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Data collected from weather stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global surface temperature changes\",\n            \"authors\": \"Brohan et al.\",\n            \"year\": 2006\n        }\n    ],\n    \"download_url\": \"https://example.com/temp_records.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Daily temperature and precipitation data from 1900-2018.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68237", "text": "{\n    \"dataset_name\": \"Coastal Wetland Bird Survey Data\",\n    \"creator\": {\n        \"name\": \"National Audubon Society\",\n        \"affiliation\": \"Non-profit Conservation Organization\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Bird Species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"variable_name\": \"Count\",\n            \"units\": \"number of individuals\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"Habitat Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Point count surveys along established transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Bird Population Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/wetland_birds.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included for each observation\"\n    }\n}"}
{"_id": "Academic--research_data--n--68237", "text": "{\n    \"dataset_name\": \"Forest Carbon Sequestration Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Tree Biomass\",\n            \"units\": \"kg C/ha\"\n        },\n        {\n            \"variable_name\": \"Soil Carbon\",\n            \"units\": \"kg C/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random plot sampling within a defined forest area\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Dynamics in Temperate Forests\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.json\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Includes metadata on plot characteristics and environmental conditions\"\n    }\n}"}
