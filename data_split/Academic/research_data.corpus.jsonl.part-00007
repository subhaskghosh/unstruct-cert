{"_id": "Academic--research_data--p--71112", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - High Resolution\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-10-26T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite-based remote sensing with 1km resolution\",\n    \"related_publications\": [\n        {\n            \"title\": \"High-resolution temperature anomaly detection using satellite data\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data is bias-corrected and quality-controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71112", "text": "{\n    \"dataset_name\": \"Historical Climate Data - Global\",\n    \"creator\": {\n        \"name\": \"Global Climate Consortium\",\n        \"affiliation\": \"Intergovernmental Organization\"\n    },\n    \"date_collected\": \"2018-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Restricted Use - Educational Purposes Only\",\n    \"sampling_method\": \"Ground-based weather stations with irregular spacing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global climate patterns 1900-2020\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data requires significant pre-processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71113", "text": "{\n    \"dataset_name\": \"North American Air Quality Study - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across major cities in North America\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Wildfires on Air Quality in North America\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_na.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Includes data quality flags and station metadata.\"\n    }\n}"}
