{"_id": "Academic--research_data--p--71664", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12.5MB\",\n        \"annotations\": \"Data is quality-assured and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71664", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"NASA Earth Exchange\",\n        \"affiliation\": \"Global Modeling and Assimilation Office\"\n    },\n    \"date_collected\": \"2022-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"NASA Open Data License\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://earthdata.nasa.gov/forestbiomass\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Derived from LiDAR data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71665", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations distributed throughout the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71665", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey - Coral Reefs\",\n    \"creator\": {\n        \"name\": \"Professor David Miller\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Fish Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Underwater visual surveys at designated reef sites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health Assessment\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Thompson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Species identification codes provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--71666", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular transect sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71666", "text": "{\n    \"dataset_name\": \"Urban Air Quality Data\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Urban Air Pollution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data validated by EPA standards.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71667", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"EcoTech Solutions\",\n        \"affiliation\": \"University of Water Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        },\n        {\n            \"name\": \"Conductivity\",\n            \"unit\": \"uS/cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensor deployed at multiple river locations, data logged hourly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Real-time River Water Quality Assessment\",\n            \"authors\": [\n                \"A. Smith\",\n                \"B. Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Sensor calibration data included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71667", "text": "{\n    \"dataset_name\": \"GlobalAirPollutionData\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO\"\n    },\n    \"date_collected\": \"2022-11-20T05:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"ug/m3\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"unit\": \"ug/m3\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Data aggregated from various monitoring stations globally.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Air Quality Trends\",\n            \"authors\": [\n                \"C. Davis\",\n                \"D. Wilson\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71668", "text": "{\n    \"dataset_name\": \"Twitter Sentiment Analysis Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2024-03-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tweet_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"text\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"sentiment\",\n            \"unit\": \"categorical (positive, negative, neutral)\"\n        },\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"unique identifier\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Random sampling of public tweets using the Twitter API\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis of Twitter Data for Brand Monitoring\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/twitter_sentiment.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Sentiment labels generated using a pre-trained model.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71668", "text": "{\n    \"dataset_name\": \"Instagram Image Dataset\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_url\",\n            \"unit\": \"URL\"\n        },\n        {\n            \"name\": \"caption\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"hashtags\",\n            \"unit\": \"array of strings\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0\",\n    \"sampling_method\": \"Scraping of public Instagram posts based on hashtag searches\",\n    \"related_publications\": [\n        {\n            \"title\": \"Visual Trends in Instagram\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/instagram_images.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Image metadata extracted during scraping.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71669", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring_2024\",\n    \"creator\": {\n        \"name\": \"National Institute of Water Research\",\n        \"affiliation\": \"NIWR, USA\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 river sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71669", "text": "{\n    \"dataset_name\": \"SimulatedLakeEcosystemData\",\n    \"creator\": {\n        \"name\": \"EcoSim Labs\",\n        \"affiliation\": \"University of Simulation Studies\"\n    },\n    \"date_collected\": \"2024-05-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"NutrientLevels\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Generated using an ecosystem simulation model.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Modeling Lake Ecosystem Dynamics\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_simulation.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data represents a simulated lake environment.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71670", "text": "{\n    \"dataset_name\": \"Forest Canopy Height - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Evelyn Hayes\",\n        \"affiliation\": \"National Ecological Observatory Network (NEON)\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"canopy_height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"tree_density\",\n            \"unit\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"LiDAR remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Canopy Height and Biomass Estimation in Pacific Northwest Forests\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_canopy_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"7.5MB\",\n        \"annotations\": \"Data includes quality control flags for LiDAR returns.\"\n    }\n}"}
