{"_id": "Academic--research_data--p--70162", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\",\n        \"number_of_samples\": 10000\n    }\n}"}
{"_id": "Academic--research_data--n--70162", "text": "{\n    \"dataset_name\": \"Soil Composition Analysis\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Group\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrogen\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random soil sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Soil Nutrients on Crop Yield\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Basic data description\",\n        \"number_of_samples\": 5000\n    }\n}"}
{"_id": "Academic--research_data--p--70163", "text": "{\n    \"dataset_name\": \"Global Carbon Emissions Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"metric tons\"\n        },\n        {\n            \"name\": \"Methane Emissions\",\n            \"units\": \"metric tons\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Emissions\",\n            \"units\": \"metric tons\"\n        },\n        {\n            \"name\": \"Pollution Levels\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budgets 2023\",\n            \"authors\": \"Friedlingstein et al.\",\n            \"journal\": \"Earth System Science Data\"\n        }\n    ],\n    \"download_url\": \"https://example.com/carbon_emissions.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Contains data from 1990 to 2023\"\n    }\n}"}
{"_id": "Academic--research_data--n--70163", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2018-11-01T05:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Global Weather\",\n            \"authors\": \"Lee et al.\",\n            \"journal\": \"Journal of Climate\"\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Contains daily weather data from 1900 to 2017\"\n    }\n}"}
{"_id": "Academic--research_data--p--70164", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Change Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes daily temperature and precipitation records.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70164", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Climate Change\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Social Science Department\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"Characters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Twitter API\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Policy\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Dataset contains tweets related to climate change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70165", "text": "{\n    \"dataset_name\": \"Coastal Erosion Rate Dataset - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Oceanography\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Erosion Rate\",\n            \"unit\": \"meters/year\"\n        },\n        {\n            \"name\": \"Coastal Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"unit\": \"mm/year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Regular shoreline surveys using LiDAR and GPS\",\n    \"related_publications\": [\n        {\n            \"title\": \"Accelerating Coastal Erosion in the Pacific Northwest\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70165", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of meteorological stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data is gridded and interpolated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70166", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data from satellite observations and ground stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"High-quality, gap-filled dataset.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70166", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Institute\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Crop Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Fertilizer Usage\",\n            \"units\": \"kg/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Farm surveys and government reports.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Crop Production in the Region\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Dataset focused on regional agricultural practices.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70167", "text": "{\n    \"dataset_name\": \"Land Surface Temperature Trends\",\n    \"creator\": {\n        \"name\": \"NASA Earth Science Data\",\n        \"affiliation\": \"Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite-based remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Land Surface Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/land_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70167", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature and Salinity\",\n    \"creator\": {\n        \"name\": \"NOAA Oceanographic Data Center\",\n        \"affiliation\": \"Pacific Marine Environmental Laboratory\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Ocean Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Buoy-based and ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Temperature Variability\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Quality control flags applied\"\n    }\n}"}
{"_id": "Academic--research_data--p--70168", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentrations - Global\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric CO2\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70168", "text": "{\n    \"dataset_name\": \"Historical Temperature Records - Europe\",\n    \"creator\": {\n        \"name\": \"Professor David Miller\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2018-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"City Name\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Daily readings from meteorological stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Impacts in Europe\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/temp_data.json\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Some missing data points\"\n    }\n}"}
{"_id": "Academic--research_data--p--70169", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation Anomaly\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global surface observations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Report - December 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/noaa/temperature_precipitation_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes monthly temperature and precipitation anomalies relative to the 1981-2010 average.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70169", "text": "{\n    \"dataset_name\": \"Historical Crop Yields - 1990-2015\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization of the United Nations (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2015-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"unit\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Rice Yield\",\n            \"unit\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 3.0\",\n    \"sampling_method\": \"Agricultural surveys and statistical modeling\",\n    \"related_publications\": [\n        {\n            \"title\": \"World Food Production Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/fao/crop_yields_1990_2015.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes annual crop yields for various countries.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70170", "text": "{\n    \"dataset_name\": \"Social Interaction Dataset - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Interaction Type\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"Duration\",\n            \"unit\": \"seconds\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"unit\": \"0-1\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling of public forum data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Understanding Social Dynamics in Online Communities\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/social_interaction_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Sentiment analysis labels provided\"\n    }\n}"}
{"_id": "Academic--research_data--n--70170", "text": "{\n    \"dataset_name\": \"Plant Growth Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Height\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"name\": \"Weight\",\n            \"unit\": \"grams\"\n        },\n        {\n            \"name\": \"Watering Frequency\",\n            \"unit\": \"days\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Controlled experiment in a greenhouse\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Plant Growth Conditions\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Smith, A.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/plant_growth_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Plant species identified\"\n    }\n}"}
{"_id": "Academic--research_data--p--70171", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Global weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
