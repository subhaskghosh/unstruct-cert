{"_id": "Academic--research_data--n--70418", "text": "{\n    \"dataset_name\": \"Urban Tree Health Assessment\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Parks Department\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"diameter_at_breast_height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"health_rating\",\n            \"units\": \"1-5\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Random sampling of trees in urban parks\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban forest health indicators\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/tree_health_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes GPS coordinates for each tree.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70419", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Anomalies (1880-2023)\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Contains adjusted temperature data for land and ocean surfaces.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70419", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Output\",\n    \"creator\": {\n        \"name\": \"World Climate Research Programme\",\n        \"affiliation\": \"WCRP\"\n    },\n    \"date_collected\": \"2023-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Climate model simulations, various scenarios\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Model Documentation\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"250GB\",\n        \"annotations\": \"Contains output from various climate models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70420", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70420", "text": "{\n    \"dataset_name\": \"Urban Air Quality Data\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data represents average hourly concentrations.\"\n    }\n}"}
