{"_id": "Academic--research_data--p--70335", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature recorded at the monitoring station.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70335", "text": "{\n    \"dataset_name\": \"Wildlife Observations in National Parks\",\n    \"creator\": {\n        \"name\": \"National Park Service\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Observed species of wildlife.\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Coordinates\",\n            \"description\": \"GPS coordinates of the observation.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Monitoring in National Parks\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/wildlife_observations.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected by volunteers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70336", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations throughout the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Quality on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70336", "text": "{\n    \"dataset_name\": \"Controlled Greenhouse Gas Experiment\",\n    \"creator\": {\n        \"name\": \"University Research Lab\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Emission\",\n            \"units\": \"kg/ha\"\n        },\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Controlled experiments in a greenhouse environment\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Elevated CO2 on Plant Growth\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/greenhouse_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data from controlled experiments, not natural observations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70337", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Updated 2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--70337", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Dataset\",\n        \"affiliation\": \"ECAD\"\n    },\n    \"date_collected\": \"2019-12-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Daily Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Station-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Variability\",\n            \"authors\": [\n                \"Various\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ecad.eu/data\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily weather records for European stations\"\n    }\n}"}
{"_id": "Academic--research_data--p--70338", "text": "{\n    \"dataset_name\": \"Regional Temperature Trends - North America\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"daily_avg_temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"daily_max_temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Daily measurements from weather stations across North America.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Temperature Trends in North America\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/north_america_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data cleaned and quality controlled. Missing values interpolated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70338", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature Database\",\n    \"creator\": {\n        \"name\": \"Oceanographic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"ocean_salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"depth\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Satellite and buoy measurements of ocean properties.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Heat Content\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes quality flags. Derived variables available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70339", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated sensors deployed at fixed locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Water Quality Trends in the Sacramento River\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, W.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
