{"_id": "Academic--research_data--p--70920", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"species_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"migration_speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated tracking using GPS tags\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Distance Migration of North American Birds\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Includes detailed species information and habitat types.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70920", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Tree Species\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"species_name\",\n            \"units\": \"string\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual field measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity of Amazonian Trees\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_trees.csv\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Basic tree measurements and species identification.\"\n    }\n}"}
