{"_id": "Academic--research_data--n--71950", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Department of Agriculture\",\n        \"affiliation\": \"USDA\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"FertilizerUsed\",\n            \"units\": \"kg/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Crop Production Statistics\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.usda.gov/data/crop-yields.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Contains annual crop yield data.\"\n    }\n}"}
