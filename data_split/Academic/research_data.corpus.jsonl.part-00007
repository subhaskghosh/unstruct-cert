{"_id": "Academic--research_data--p--71639", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature (Celsius)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Altitude (meters)\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2023\",\n            \"authors\": [\n                \"Friedlingstein et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data has been quality controlled and flagged for anomalies.\"\n    }\n}"}
