{"_id": "Academic--research_data--p--71518", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Cloud Data from Satellite Observations\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Cloud Fraction\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing (MODIS, VIIRS)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Aerosol Properties from Satellite Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Comprehensive atmospheric data with quality flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71518", "text": "{\n    \"dataset_name\": \"Regional Precipitation Patterns\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm/hour\"\n        },\n        {\n            \"name\": \"Snowfall\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Non-Commercial License\",\n    \"sampling_method\": \"Ground-based rain gauges and weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of Precipitation Trends in California\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/precipitation_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Regional precipitation data from California.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71519", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring_2023\",\n    \"creator\": {\n        \"name\": \"National Institute of Ecological Research\",\n        \"affiliation\": \"NIER, South Korea\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 designated locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71519", "text": "{\n    \"dataset_name\": \"IndustrialWastewaterAnalysis_2022\",\n    \"creator\": {\n        \"name\": \"TechSolutions Inc.\",\n        \"affiliation\": \"Private Environmental Consulting Firm\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Biological Oxygen Demand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Total Suspended Solids\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Commercial Use Only\",\n    \"sampling_method\": \"Composite samples collected monthly from industrial discharge points.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://techsolutions.com/wastewater_data_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Preliminary data - subject to further analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71520", "text": "{\n    \"dataset_name\": \"USGS National Water Quality Assessment (NAWQA) Data\",\n    \"creator\": {\n        \"name\": \"United States Geological Survey\",\n        \"affiliation\": \"US Federal Government\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Conductivity\",\n            \"units\": \"uS/cm\"\n        },\n        {\n            \"name\": \"Nitrate\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling from fixed monitoring sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Surface Water and Groundwater Data\",\n            \"authors\": [\n                \"Church, M.R.\",\n                \"Thelin, S.R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/nawqa/data\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71520", "text": "{\n    \"dataset_name\": \"European River Water Quality Data\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Occasional grab samples from various locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality in Europe\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.eea.europa.eu/data-and-maps/data\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Metadata available in separate file.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71521", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular transect sampling at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Runoff on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and includes flags for suspect values.\"\n    }\n}"}
