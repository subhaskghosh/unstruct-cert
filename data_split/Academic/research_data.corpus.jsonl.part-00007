{"_id": "Academic--research_data--p--67514", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, UCL\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CO\",\n            \"units\": \"ppm\",\n            \"description\": \"Carbon Monoxide concentration\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppm\",\n            \"description\": \"Nitrogen Dioxide concentration\"\n        },\n        {\n            \"variable_name\": \"O3\",\n            \"units\": \"ppm\",\n            \"description\": \"Ozone concentration\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes readings from 50 monitoring stations across London.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67514", "text": "{\n    \"dataset_name\": \"WaterQuality_RiverThames\",\n    \"creator\": {\n        \"name\": \"Thames River Authority\",\n        \"affiliation\": \"TRA\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\",\n            \"description\": \"pH level of the water\"\n        },\n        {\n            \"variable_name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Amount of dissolved oxygen in the water\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\",\n            \"description\": \"Measure of water clarity\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Weekly water samples collected from 20 locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Assessment of the River Thames\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/thames_water_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data covers the period from January 2023 to December 2023.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67515", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Post 2020\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"UCAR\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global Weather Stations and Satellite Data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Global Warming Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Includes daily temperature anomalies from 2021-2023.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67515", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2022-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Argo Floats\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Ocean Salinity\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity.nc\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from Argo floats in the Atlantic Ocean.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67516", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis (Landsat, MODIS)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen et al.\"\n            ],\n            \"journal\": \"Nature Climate Change\"\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.org/datasets/catalog/UMD_hansen_global_forest_change_2023_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Contains data on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67516", "text": "{\n    \"dataset_name\": \"Air Quality Sensor Data - City Park\",\n    \"creator\": {\n        \"name\": \"Local Environmental Group\",\n        \"affiliation\": \"City Parks Department\"\n    },\n    \"date_collected\": \"2023-05-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Single air quality sensor deployed in a city park.\",\n    \"related_publications\": [],\n    \"download_url\": \"http://cityparkdata.org/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10 MB\",\n        \"annotations\": \"Hourly readings from a single sensor.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67517", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global Surface Temperature Analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67517", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - 1980-2000\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2000-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Weather Station Measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Weather Analysis\",\n            \"year\": 2005\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Historical weather data from various stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67518", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2021-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less, a key indicator of air quality.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration, a major component of smog.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen dioxide concentration, a pollutant from combustion sources.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic emissions on urban air quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67518", "text": "{\n    \"dataset_name\": \"Marine Ecosystems - North Atlantic\",\n    \"creator\": {\n        \"name\": \"University of Lisbon\",\n        \"affiliation\": \"Faculty of Sciences\"\n    },\n    \"date_collected\": \"2022-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\",\n            \"description\": \"Salinity of the seawater.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Water temperature.\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m³\",\n            \"description\": \"Concentration of chlorophyll-a, an indicator of phytoplankton biomass.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Research vessel surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Plankton diversity in the North Atlantic\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Costa, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/north_atlantic_marine.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data includes species identification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67519", "text": "{\n    \"dataset_name\": \"Global Precipitation Measurement (GPM) Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Precipitation Measurement Mission\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"precipitation\",\n            \"units\": \"mm/hr\",\n            \"description\": \"Hourly precipitation rate\"\n        },\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\",\n            \"description\": \"Surface temperature\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Global Precipitation Measurement Mission\",\n            \"authors\": [\n                \"R. Joyce\",\n                \"G. Huffman\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://pmm.nasa.gov/data-access\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67519", "text": "{\n    \"dataset_name\": \"Historical Weather Records - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Dataset\",\n        \"affiliation\": \"ECAD\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.ecad.eu/daily-data\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Limited metadata; station-specific information only.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67520", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67520", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Health - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"University of Tokyo\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Seawater Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Temperature of seawater at various depths.\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\",\n            \"description\": \"Salinity of seawater.\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"unit\": \"µg/L\",\n            \"description\": \"Concentration of chlorophyll-a, indicating phytoplankton abundance.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel surveys and buoy deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Marine Ecosystems\",\n            \"authors\": [\n                \"Tanaka, K.\",\n                \"Smith, A.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data calibrated and quality controlled\"\n    }\n}"}
{"_id": "Academic--research_data--p--67521", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data with monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains anomaly data relative to a baseline period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67521", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa State University Agricultural Extension\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2018-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Soybean Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"County\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Annual surveys of agricultural production\",\n    \"related_publications\": [\n        {\n            \"title\": \"Iowa Agricultural Statistics\",\n            \"year\": 2017\n        }\n    ],\n    \"download_url\": \"https://www.extension.iastate.edu/agdm/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes yield estimates for major crops.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67522", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67522", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Biodiversity\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Woods Hole\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"number\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"psu\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Remote Operated Vehicle (ROV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Sea Biodiversity Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species identification codes included\"\n    }\n}"}
{"_id": "Academic--research_data--p--67523", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains monthly mean temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--67523", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Station-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Weather Patterns\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/data-access\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Daily weather observations from various stations\"\n    }\n}"}
{"_id": "Academic--research_data--p--67524", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrogen (Nitrate)\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_wq_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67524", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas - 2022\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"EPA Air Quality Division\"\n    },\n    \"date_collected\": \"2022-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using stationary sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic on urban air quality\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_pollution_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is preliminary and may be subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67525", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Concentration of dissolved oxygen in the water column.\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\",\n            \"description\": \"Acidity or alkalinity of the water.\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\",\n            \"description\": \"Measure of water cloudiness.\"\n        },\n        {\n            \"variable_name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\",\n            \"description\": \"Level of phosphate present in the sample\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling at fixed stations using automated sondes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakeerie_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67525", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"Air Quality Division\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers or less in diameter.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring at fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of air pollution on respiratory health\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_urban.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data validation procedures outlined.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67526", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains monthly average surface temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67526", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"Alice Johnson\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Tweet Text\",\n            \"units\": \"Text\"\n        },\n        {\n            \"variable_name\": \"Sentiment Score\",\n            \"units\": \"0-1\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Twitter API stream\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis of Public Opinion\",\n            \"authors\": [\n                \"Alice Johnson\",\n                \"Bob Williams\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/sentiment_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains tweets related to various topics.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67527", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages and daily maximums\"\n    }\n}"}
{"_id": "Academic--research_data--n--67527", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Instituto Nacional de Pesquisas da Amazônia\",\n        \"affiliation\": \"Brazilian Government Research Institute\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://amazonia.gov.br/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data contains species identification and abundance information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67528", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2022\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppm\",\n            \"description\": \"Nitrogen dioxide concentration.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations throughout London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2022.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67528", "text": "{\n    \"dataset_name\": \"Rural Forest Ecosystem Data - Scotland\",\n    \"creator\": {\n        \"name\": \"Professor David Miller\",\n        \"affiliation\": \"University of Edinburgh\"\n    },\n    \"date_collected\": \"2021-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\",\n            \"description\": \"Average height of trees in the study area.\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of moisture in the soil.\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"units\": \"index\",\n            \"description\": \"Measure of species diversity.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random sampling plots within a forest area\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Ecosystem Dynamics\",\n            \"authors\": \"Miller, D. et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/scotland_forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification and growth measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67529", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring - 2024\",\n    \"creator\": {\n        \"name\": \"Ohio Environmental Protection Agency\",\n        \"affiliation\": \"State of Ohio\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from fixed buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been quality controlled and flagged for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67529", "text": "{\n    \"dataset_name\": \"Atmospheric Pollutant Concentrations - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University X\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial distribution of air pollutants\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data is raw and requires processing.\"\n    }\n}"}
