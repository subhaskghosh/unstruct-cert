{"_id": "Academic--research_data--n--68251", "text": "{\n    \"dataset_name\": \"Primate Social Interactions\",\n    \"creator\": {\n        \"name\": \"Jane Goodall Institute\",\n        \"affiliation\": \"JGI\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Grooming Frequency\",\n            \"units\": \"count/hour\"\n        },\n        {\n            \"name\": \"Aggression Level\",\n            \"units\": \"ordinal scale\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Direct observation of primate groups\",\n    \"related_publications\": [\n        {\n            \"title\": \"Social Dynamics of Chimpanzees\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/primate_data.json\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Video recordings available upon request.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68252", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"variable_name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data\",\n    \"metadata\": {\n        \"data_size\": \"20 GB\",\n        \"annotations\": \"Global map of forest change\"\n    }\n}"}
