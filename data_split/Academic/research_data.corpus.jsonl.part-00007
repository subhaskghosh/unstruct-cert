{"_id": "Academic--research_data--n--68026", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Forest Loss\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Patterns of Forest Loss\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.geojson\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data represents annual changes in forest cover\"\n    }\n}"}
{"_id": "Academic--research_data--p--68027", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"O3\",\n            \"unit\": \"ppb\",\n            \"description\": \"Ozone concentration in parts per billion.\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"unit\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration in parts per billion.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data cleaned and validated with quality control procedures.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68027", "text": "{\n    \"dataset_name\": \"OceanCurrents_Pacific\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CurrentVelocity\",\n            \"unit\": \"m/s\",\n            \"description\": \"Magnitude of the ocean current velocity.\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"unit\": \"PSU\",\n            \"description\": \"Practical Salinity Units\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Satellite altimetry and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Current Dynamics\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.nc\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes error estimates from satellite measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68028", "text": "{\n    \"dataset_name\": \"CardioMRI-Seg Dataset\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_path\",\n            \"units\": \"file path\"\n        },\n        {\n            \"variable_name\": \"left_ventricle_volume\",\n            \"units\": \"ml\"\n        },\n        {\n            \"variable_name\": \"ejection_fraction\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"patient_age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Retrospective cohort study from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Automated Cardiac Segmentation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/cardioMRI.zip\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Manual segmentations by experienced radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--68028", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_path\",\n            \"units\": \"file path\"\n        },\n        {\n            \"variable_name\": \"pneumonia_diagnosis\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling from public hospital database\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pneumonia Detection using CNNs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chestxray.zip\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Automated labels generated by a preliminary algorithm.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68029", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Civil, Environmental and Geomatic Engineering\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68029", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"unit\": \"ppm\",\n            \"description\": \"Concentration of carbon dioxide.\"\n        },\n        {\n            \"name\": \"CH4\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of methane.\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Cycle Dynamics\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Brown, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_atmosphere.nc\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Data derived from satellite observations; potential uncertainties due to atmospheric correction.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68030", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global average measurements from satellite and ground stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Change: Trends and Projections\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68030", "text": "{\n    \"dataset_name\": \"Historical Weather Data - North America\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather reports from across North America.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"15GB\",\n        \"annotations\": \"Daily measurements from weather stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68031", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GSTa)\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/gsta_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"350MB\",\n        \"annotations\": \"Data includes annual average temperatures\"\n    }\n}"}
{"_id": "Academic--research_data--n--68031", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"FAO Statistics Division\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2018-07-20T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Crop Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Country\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Survey data from national agricultural agencies\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Crop Production Trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data covers yields for major crops worldwide\"\n    }\n}"}
{"_id": "Academic--research_data--p--68032", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2024\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of Nitrogen Dioxide\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Open Database License (ODbL)\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68032", "text": "{\n    \"dataset_name\": \"Historical Soil Composition - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"Environmental Sciences Division\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\",\n            \"description\": \"Soil pH level\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of nitrogen in the soil\"\n        },\n        {\n            \"name\": \"Phosphorus Content\",\n            \"units\": \"ppm\",\n            \"description\": \"Parts per million of phosphorus in the soil\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Soil samples collected from various locations within the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Nutrient Dynamics in the Amazon\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://amazonsamples.org/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data includes detailed geographical coordinates.\"\n    }\n}"}
