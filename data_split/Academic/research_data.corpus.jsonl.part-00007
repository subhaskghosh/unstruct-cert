{"_id": "Academic--research_data--n--71307", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery (GLAD)\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Forest Cover Density\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change from 2000 to 2020\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Processed Landsat data.\"\n    }\n}"}
