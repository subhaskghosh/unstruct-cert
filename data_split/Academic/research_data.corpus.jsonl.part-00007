{"_id": "Academic--research_data--p--69619", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Year\",\n            \"unit\": \"Year\"\n        },\n        {\n            \"name\": \"Global Mean Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Northern Hemisphere Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global average from weather station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature Anomalies\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"50KB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69619", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"Tokyo Institute of Technology\"\n    },\n    \"date_collected\": \"2022-05-20T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"pH units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Alkalinity\",\n            \"unit\": \"mmol/kg\"\n        },\n        {\n            \"name\": \"Carbon Dioxide Partial Pressure\",\n            \"unit\": \"uatm\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"unit\": \"uM\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"unit\": \"uM\"\n        },\n        {\n            \"name\": \"Silicate Concentration\",\n            \"unit\": \"uM\"\n        },\n        {\n            \"name\": \"Chlorophyll-a Concentration\",\n            \"unit\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        },\n        {\n            \"name\": \"Zooplankton Biomass\",\n            \"unit\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"unit\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Sea Surface Height\",\n            \"unit\": \"m\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Regular sampling from research vessels\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Acidification on Marine Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_acidification.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data processed with standard algorithms\"\n    }\n}"}
{"_id": "Academic--research_data--p--69620", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
