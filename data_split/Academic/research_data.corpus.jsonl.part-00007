{"_id": "Academic--research_data--p--68795", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentrations - Global\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"University Corporation for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Project 2023 Report\",\n            \"authors\": [\n                \"Le Quéré et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68795", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Biodiversity - North Atlantic\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2022-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"individuals/m^3\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel trawls and plankton tows\",\n    \"related_publications\": [\n        {\n            \"title\": \"North Atlantic Marine Biodiversity Survey\",\n            \"authors\": [\n                \"Smith et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"850 MB\",\n        \"annotations\": \"Species classifications are based on the ICES taxonomy.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68796", "text": "{\n    \"dataset_name\": \"Behavioral Ecology of African Wild Dogs\",\n    \"creator\": {\n        \"name\": \"Dr. Jane Goodall Institute\",\n        \"affiliation\": \"University of Cambridge\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"GPS_Location\",\n            \"unit\": \"Latitude/Longitude\"\n        },\n        {\n            \"variable_name\": \"Activity_Level\",\n            \"unit\": \"Categorical (Resting, Moving, Hunting)\"\n        },\n        {\n            \"variable_name\": \"Pack_Size\",\n            \"unit\": \"Number of individuals\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"GPS Collaring and Direct Observation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Social Dynamics of African Wild Dogs\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/wilddogdata.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes behavioral observations and GPS tracking data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68796", "text": "{\n    \"dataset_name\": \"Plant Biodiversity in Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Souza\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-11-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species_Name\",\n            \"unit\": \"Scientific Name\"\n        },\n        {\n            \"variable_name\": \"Tree_Height\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect Surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazonian Plant Diversity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazondata.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Contains a comprehensive list of plant species with associated characteristics.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68797", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Civil, Environmental and Geomatic Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic Density on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes quality control flags for sensor readings.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68797", "text": "{\n    \"dataset_name\": \"Garden Bird Count - UK\",\n    \"creator\": {\n        \"name\": \"Royal Society for the Protection of Birds (RSPB)\",\n        \"affiliation\": \"RSPB Headquarters\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Number of Blue Tits\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Number of Robins\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Garden Size\",\n            \"units\": \"m²\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Citizen science - observations submitted via a mobile app.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Garden Bird Populations\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_count.json\",\n    \"metadata\": {\n        \"data_size\": \"500KB\",\n        \"annotations\": \"Data includes location information (postcode).\"\n    }\n}"}
{"_id": "Academic--research_data--p--68798", "text": "{\n    \"dataset_name\": \"High-Resolution Atmospheric Composition Data for Climate Modeling\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research (NCAR)\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"Pascals\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from high-altitude balloons and ground-based stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric Composition Changes and Climate Forcing\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_highres.nc\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data includes quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68798", "text": "{\n    \"dataset_name\": \"Historical Weather Records - Global Surface Summary of the Day\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Maximum Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"Inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Variability\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Brown, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes station metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68799", "text": "{\n    \"dataset_name\": \"Coastal Temperature and Precipitation Data - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoy network and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Climate Change Impacts\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68799", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Storage\",\n    \"creator\": {\n        \"name\": \"Dr. Jian Li\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"aboveground_biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"belowground_biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"carbon_stock\",\n            \"units\": \"tonnes C/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Storage in Forests\",\n            \"authors\": \"Li et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.geojson\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is pre-processed and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68800", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data, monthly means\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Contains uncertainties and data quality flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68800", "text": "{\n    \"dataset_name\": \"Local Bird Population Survey - 2022\",\n    \"creator\": {\n        \"name\": \"Amateur Ornithology Club\",\n        \"affiliation\": \"Local Community Group\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Population Count\",\n            \"units\": \"Individuals\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Coordinates\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Opportunistic observation in a local park\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/bird_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100KB\",\n        \"annotations\": \"Limited metadata, primarily raw counts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68801", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Monitoring in the Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Spatial Resolution\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using ground-based sensors and drone surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric Composition Changes in the Amazon Rainforest\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_atmosphere_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data quality flags are included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68801", "text": "{\n    \"dataset_name\": \"Historical Climate Data - Global Temperature Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Global Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of weather stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Contains data from 1880-2023\"\n    }\n}"}
{"_id": "Academic--research_data--p--68802", "text": "{\n    \"dataset_name\": \"Global Soil Moisture Dataset (2021-2023)\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"UCAR\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"soil_moisture\",\n            \"units\": \"m3/m3\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"High-Resolution Global Soil Moisture Analysis\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_moisture_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68802", "text": "{\n    \"dataset_name\": \"Climate Change Perception Survey\",\n    \"creator\": {\n        \"name\": \"Pew Research Center\",\n        \"affiliation\": \"Pew Charitable Trusts\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"belief_in_climate_change\",\n            \"units\": \"scale of 1-7\"\n        },\n        {\n            \"name\": \"political_affiliation\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Public opinion survey\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Attitudes Towards Climate Change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_survey.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Survey responses from a representative sample of the US population.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68803", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"bird_species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"name\": \"altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic grid sampling across major flyways\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in North American Bird Migration\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags for location accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68803", "text": "{\n    \"dataset_name\": \"Global Climate Model Output\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"CO2_concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Model simulation - not direct sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of Climate Change Impacts\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"High-resolution climate model output.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68804", "text": "{\n    \"dataset_name\": \"US River Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley - Environmental Engineering Department\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Grab samples collected monthly from 50 river locations across the US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in US river water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68804", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Europe\",\n    \"creator\": {\n        \"name\": \"National Meteorological Institute\",\n        \"affiliation\": \"NMI\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Daily rainfall measurements from weather stations across Europe.\",\n    \"related_publications\": [\n        {\n            \"title\": \"European rainfall patterns\",\n            \"authors\": [\n                \"Jones, P.\",\n                \"Williams, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes missing value indicators.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68805", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global weather stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68805", "text": "{\n    \"dataset_name\": \"Historical Forest Cover Data\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization of the United Nations (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Area\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Remote sensing and national reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data is based on estimates\"\n    }\n}"}
{"_id": "Academic--research_data--p--68806", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Fine particulate matter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\",\n            \"description\": \"Relative humidity\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68806", "text": "{\n    \"dataset_name\": \"Individual Sensor Readings - 2023\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-12-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO\",\n            \"unit\": \"ppm\",\n            \"description\": \"Carbon Monoxide Level\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Single sensor deployed in a residential area.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/sensor_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Minimal data processing performed\"\n    }\n}"}
{"_id": "Academic--research_data--p--68807", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring 2023-2024\",\n    \"creator\": {\n        \"name\": \"University of Michigan Water Science Lab\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-06-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"variable_name\": \"Phosphate\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68807", "text": "{\n    \"dataset_name\": \"Global Air Quality Data\",\n    \"creator\": {\n        \"name\": \"OpenAQ\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Data aggregated from various monitoring stations worldwide.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/global_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is sourced from publicly available stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68808", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68808", "text": "{\n    \"dataset_name\": \"Bird Species Observations in Rural Areas\",\n    \"creator\": {\n        \"name\": \"Ornithological Society of America\",\n        \"affiliation\": \"Local Birdwatching Club\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Common name of the bird species\"\n        },\n        {\n            \"name\": \"ObservationCount\",\n            \"units\": \"Count\",\n            \"description\": \"Number of individuals observed\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Coordinates\",\n            \"description\": \"Latitude and longitude of the observation\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations submitted through a mobile app\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/bird_observations.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data collected by volunteers, some observations may be unverified.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68809", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - Chesapeake Bay\",\n    \"creator\": {\n        \"name\": \"University of Maryland Center for Environmental Science\",\n        \"affiliation\": \"UMCES\"\n    },\n    \"date_collected\": \"2022-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"ug/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors deployed at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Chesapeake Bay water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chesapeake_bay_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68809", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change 1990-2010\",\n    \"creator\": {\n        \"name\": \"University of Florida\",\n        \"affiliation\": \"UF\"\n    },\n    \"date_collected\": \"2010-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Land Use Type\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping global forest cover change\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_data.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data derived from Landsat imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68810", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2020-2023\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2013\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"journal\": \"Science\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/users/UMD/GFC-2023-v1.1\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Dataset includes annual tree cover loss and gain data globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68810", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2019-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM25\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas\",\n    \"related_publications\": [],\n    \"download_url\": \"http://cityair.example.com/data\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Real-time air quality data from the city.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68811", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Environmental Science and Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68811", "text": "{\n    \"dataset_name\": \"GlobalForestryData\",\n    \"creator\": {\n        \"name\": \"University of Alberta\",\n        \"affiliation\": \"Department of Renewable Resources\"\n    },\n    \"date_collected\": \"2018-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ForestCover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"TreeDensity\",\n            \"units\": \"trees/km²\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground-based surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Forest Cover\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data is based on a combination of remote sensing and field observations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68812", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in London 2023 Report\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality/london-air-quality-monitoring-2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data has been quality checked and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68812", "text": "{\n    \"dataset_name\": \"SoilComposition_RuralFrance_2021\",\n    \"creator\": {\n        \"name\": \"Institut National de la Recherche Agronomique\",\n        \"affiliation\": \"Soil Science Department\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\",\n            \"description\": \"Soil pH level.\"\n        },\n        {\n            \"name\": \"OrganicMatter\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of organic matter in the soil.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling of soil cores across rural France.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Composition in Rural France\",\n            \"authors\": [\n                \"Dupont, L.\",\n                \"Martin, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.inra.fr/soil_composition_data.json\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data is primarily for research purposes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68813", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Discrete water samples collected weekly from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in Lake Mendota water quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags and sampling location details.\"\n    }\n}"}
