{"_id": "Academic--research_data--p--68149", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Time\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Global gridded data with monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"15GB\",\n        \"annotations\": \"Comprehensive temperature data with high spatial and temporal resolution.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68149", "text": "{\n    \"dataset_name\": \"Tropospheric Ozone Measurements\",\n    \"creator\": {\n        \"name\": \"European Space Agency (ESA)\",\n        \"affiliation\": \"ESA\"\n    },\n    \"date_collected\": \"2022-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppbv\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"km\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Satellite-based measurements of tropospheric ozone\",\n    \"related_publications\": [\n        {\n            \"title\": \"Tropospheric Ozone Monitoring\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.esa.int/ozone\",\n    \"metadata\": {\n        \"data_size\": \"8GB\",\n        \"annotations\": \"Detailed measurements of atmospheric ozone levels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68150", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data - North Atlantic\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Autonomous underwater vehicle (AUV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in North Atlantic temperature and salinity\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68150", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Professor Ricardo Silva\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2018-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Ground-based rain gauges\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall patterns in the Amazon\",\n            \"authors\": [\n                \"Silva, R.\"\n            ],\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Some missing data points\"\n    }\n}"}
{"_id": "Academic--research_data--p--68151", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - v4\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Measurement Quality\",\n            \"units\": \"Scale 1-5\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global network of weather stations and sea surface temperature measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Quality controlled temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68151", "text": "{\n    \"dataset_name\": \"Historical Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2018-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Biomass Density\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Species Composition\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Change Rate\",\n            \"units\": \"hectares/year\"\n        },\n        {\n            \"name\": \"Deforestation Drivers\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Protected Area Status\",\n            \"units\": \"Boolean\"\n        },\n        {\n            \"name\": \"Soil Type\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground-based surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change\",\n            \"year\": 2019,\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.geojson\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Historical forest cover data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68152", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Recent Years\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/noaa_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Contains monthly average temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--68152", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - 19th Century\",\n    \"creator\": {\n        \"name\": \"Local Historical Society\",\n        \"affiliation\": \"Town of Oakhaven\"\n    },\n    \"date_collected\": \"1890-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"Text\",\n    \"license\": \"Creative Commons Attribution-NonCommercial\",\n    \"sampling_method\": \"Daily weather logs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oakhaven Weather History\",\n            \"year\": 1995\n        }\n    ],\n    \"download_url\": \"https://example.com/oakhaven_weather.txt\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Handwritten records transcribed to text\"\n    }\n}"}
{"_id": "Academic--research_data--p--68153", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Center for Limnology, University of Wisconsin-Madison\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen (mg/L)\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors deployed at multiple depths\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68153", "text": "{\n    \"dataset_name\": \"Global Soil Nutrient Levels\",\n    \"creator\": {\n        \"name\": \"International Soil Research Institute\",\n        \"affiliation\": \"ISRI\"\n    },\n    \"date_collected\": \"2022-12-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphorus (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Potassium (ppm)\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Random soil samples collected globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global patterns of soil nutrient distribution\",\n            \"authors\": [\n                \"Brown, A.\",\n                \"Green, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_soil_nutrients.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data aggregated from multiple sources.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68154", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network - Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Snow Depth\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Summaries\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily/access/2022/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68154", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis - Climate Change\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Sociology\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"Text\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Twitter API data collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Perception of Climate Change on Social Media\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/socialmedia_climate\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Sentiment analysis labels\"\n    }\n}"}
{"_id": "Academic--research_data--p--68155", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring_2023\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 monitoring stations along the Sacramento River.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing Water Quality Trends in the Sacramento River\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data quality control flags are included for each variable.\"\n    }\n}"}
