{"_id": "Academic--research_data--p--70083", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Species Count - Monkeys\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Species Count - Birds\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"Trees/Hectare\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Water pH\",\n            \"units\": \"pH\"\n        },\n        {\n            \"name\": \"Insect Biodiversity Index\",\n            \"units\": \"Shannon Index\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Liana Density\",\n            \"units\": \"Stems/Hectare\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"Dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Dynamics in the Amazon\",\n            \"authors\": \"Rossi et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Includes geographical coordinates for each sampling plot.\"\n    }\n}"}
