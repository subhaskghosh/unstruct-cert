{"_id": "Academic--research_data--n--69478", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Amazon Basin\",\n    \"creator\": {\n        \"name\": \"INPE\",\n        \"affiliation\": \"National Institute for Space Research (Brazil)\"\n    },\n    \"date_collected\": \"2019-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"unit\": \"millimeters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees South\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees West\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Radar and satellite precipitation estimates.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Rainforest Rainfall Patterns\",\n            \"authors\": [\n                \"Silva, A.\",\n                \"Costa, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.inpe.br/rainfall-data\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Daily rainfall data for the Amazon basin.\"\n    }\n}"}
