{"_id": "Academic--research_data--n--71980", "text": "{\n    \"dataset_name\": \"Pacific Ocean Current Velocity Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-08-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Current Velocity\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Autonomous underwater vehicle deployments.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Characterizing Ocean Currents in the Pacific Basin\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"8.9MB\",\n        \"annotations\": \"Data includes calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71981", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring - Illinois\",\n    \"creator\": {\n        \"name\": \"Illinois Water Survey\",\n        \"affiliation\": \"University of Illinois at Urbana-Champaign\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from designated sites along the Illinois River.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of Water Quality Trends in the Illinois River\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/illinois_river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Includes data quality flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71981", "text": "{\n    \"dataset_name\": \"Pacific Ocean Plankton Survey\",\n    \"creator\": {\n        \"name\": \"Monterey Bay Aquarium Research Institute\",\n        \"affiliation\": \"MBARI\"\n    },\n    \"date_collected\": \"2023-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chlorophyll-a Concentration\",\n            \"units\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Plankton Abundance\",\n            \"units\": \"cells/L\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous plankton recorder towed behind research vessels in the Pacific Ocean.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Plankton Dynamics in the California Current Ecosystem\",\n            \"authors\": [\n                \"Davis, L.\",\n                \"Wilson, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_plankton.nc\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes geolocation information for each sample.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71982", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 locations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Lake Erie Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_wq_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71982", "text": "{\n    \"dataset_name\": \"Global Air Quality - Historical\",\n    \"creator\": {\n        \"name\": \"AirData Consortium\",\n        \"affiliation\": \"Private Environmental Firm\"\n    },\n    \"date_collected\": \"2021-03-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Proprietary - Research Use Only\",\n    \"sampling_method\": \"Continuous monitoring from fixed stations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/global_air_quality.xml\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data requires significant preprocessing.\"\n    }\n}"}
