{"_id": "Academic--research_data--p--68376", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Data - Global Monitoring\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley Atmospheric Sciences Group\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide (CO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane (CH4)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide (N2O)\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric Greenhouse Gases\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68376", "text": "{\n    \"dataset_name\": \"Regional Temperature Anomalies - Historical Data\",\n    \"creator\": {\n        \"name\": \"Climate Analytics Inc.\",\n        \"affiliation\": \"Climate Analytics\"\n    },\n    \"date_collected\": \"2018-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Gridded historical climate data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Impacts Assessment\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data interpolated from station observations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68377", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2023\",\n            \"authors\": \"Smith, J. et al.\"\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68377", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment - Amazon\",\n    \"creator\": {\n        \"name\": \"Brazilian National Institute for Amazon Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of different species identified.\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\",\n            \"description\": \"Number of trees per hectare.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Dynamics in the Amazon Rainforest\",\n            \"authors\": \"Oliveira, A. et al.\"\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Geographic coordinates included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68378", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring 2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature at monitoring station\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
