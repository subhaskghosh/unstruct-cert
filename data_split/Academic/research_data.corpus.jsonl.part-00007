{"_id": "Academic--research_data--p--68599", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Earthdata\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Aboveground Biomass\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"variable_name\": \"Forest Type\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass with LiDAR\",\n            \"authors\": [\n                \"Anderson-Teixeira et al.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68599", "text": "{\n    \"dataset_name\": \"Climate Model Output - Temperature Projections\",\n    \"creator\": {\n        \"name\": \"IPCC Data Distribution Centre\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"General Circulation Model (GCM) simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"authors\": [\n                \"Smith et al.\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Model output from CMIP6 experiments.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68600", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68600", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2023-07-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Phytoplankton Species 1\",\n            \"units\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Phytoplankton Species 2\",\n            \"units\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Phytoplankton Species 3\",\n            \"units\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Zooplankton Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Benthic Invertebrate Diversity\",\n            \"units\": \"index\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"kg/m²\"\n        },\n        {\n            \"name\": \"Seabird Population\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Marine Mammal Sightings\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Plastic Concentration\",\n            \"units\": \"particles/m³\"\n        },\n        {\n            \"name\": \"Microplastic Size Distribution\",\n            \"units\": \"µm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel transects and underwater surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Biodiversity Assessment\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://oceaninstitute.org/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes species identification and abundance measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68601", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"sea_level_pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A Comprehensive Analysis\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been quality controlled and bias corrected.\"\n    }\n}"}
