{"_id": "Academic--research_data--n--71539", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Initiative\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2022-01-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NDVI\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Remote sensing data from satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Monitoring Forest Health with Remote Sensing\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data processed to Level 2\"\n    }\n}"}
{"_id": "Academic--research_data--p--71540", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of Ozone.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of Nitrogen Dioxide.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations distributed throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is quality controlled and missing values are flagged.\"\n    }\n}"}
