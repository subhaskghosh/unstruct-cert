{"_id": "Academic--research_data--n--70380", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Tree Species Inventory\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"species\",\n            \"units\": \"scientific name\"\n        },\n        {\n            \"name\": \"diameter_at_breast_height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"coordinates\",\n            \"units\": \"latitude, longitude\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Systematic plot sampling within designated forest areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity assessment of the central Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_tree_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes notes on tree health and observed interactions with fauna.\"\n    }\n}"}
