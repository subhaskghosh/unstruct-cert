{"_id": "Academic--research_data--p--67377", "text": "{\n    \"dataset_name\": \"Global Forest Watch Tree Cover Loss Dataset\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover_loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"year\",\n            \"unit\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping tropical forest carbon stocks\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"150 GB\",\n        \"annotations\": \"Tree cover loss data, forest gain data\"\n    }\n}"}
