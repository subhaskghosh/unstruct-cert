{"_id": "Academic--research_data--p--67693", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Environmental Impacts\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Glacier Mass Balance\",\n            \"units\": \"kilograms per square meter\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite observations and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Accelerated Glacier Melt in the 21st Century\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67693", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - North America\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2018-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in North American Weather\",\n            \"authors\": [\n                \"Davis, R.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data cleaned for missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67694", "text": "{\n    \"dataset_name\": \"Global Forest Watch Climate Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"units\": \"tonnes CO2e\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis combined with ground-based verification\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping tree cover loss in a global context\",\n            \"authors\": \"Tyukavina et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data includes annotations on forest type and degradation levels.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67694", "text": "{\n    \"dataset_name\": \"Climate Model Simulations - CMIP6\",\n    \"creator\": {\n        \"name\": \"CMIP6 Collaboration\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2023-10-27T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Sea Level Pressure\",\n            \"units\": \"Pascal\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Global climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The CMIP6 model archive\",\n            \"authors\": \"Eyring et al.\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Data represents projections based on various climate scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67695", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley - Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-11-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Geographic Location\",\n            \"unit\": \"latitude, longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and satellites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature Anomalies\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67695", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - 1990-2010\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Rainfall\",\n            \"unit\": \"millimeters\"\n        },\n        {\n            \"name\": \"Location\",\n            \"unit\": \"station ID\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Rain gauge measurements from across the United States.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Rainfall Patterns in the US\",\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_rainfall.xml\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data contains missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67696", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"World Air Quality Index (WAQI)\",\n        \"affiliation\": \"WAQI, Inc.\"\n    },\n    \"date_collected\": \"2023-02-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Wind Direction\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Air Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
