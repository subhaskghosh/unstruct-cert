{"_id": "Academic--research_data--n--66022", "text": "{\n    \"dataset_name\": \"Historical Climate Reconstruction\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Paleoclimate proxies\",\n    \"related_publications\": [\n        {\n            \"title\": \"Reconstructing Past Climates\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_climate.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Uncertainty estimates provided\"\n    }\n}"}
