{"_id": "Academic--research_data--n--71243", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change 1990-2020\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery (GLAD)\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2020-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Assessment of Forest Change\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_data.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Derived from Landsat satellite imagery.\"\n    }\n}"}
