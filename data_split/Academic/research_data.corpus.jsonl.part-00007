{"_id": "Academic--research_data--n--71698", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Study - 2022\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Forest Service\"\n    },\n    \"date_collected\": \"2022-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random plot sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Temperate Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data contains species identification and location information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71699", "text": "{\n    \"dataset_name\": \"European Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Europe\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/european_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"last_updated\": \"2023-11-01T12:00:00Z\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
