{"_id": "Academic--research_data--n--68415", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Research Institute\",\n        \"affiliation\": \"Ecology Department\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Research Use Only\",\n    \"sampling_method\": \"Remote sensing and field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity assessment in the Amazon rainforest\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data is raw and requires preprocessing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68416", "text": "{\n    \"dataset_name\": \"North American Freshwater Fish Abundance\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Michigan, School of Natural Resources and Environment\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"fish_species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"variable_name\": \"abundance\",\n            \"units\": \"individuals per square meter\"\n        },\n        {\n            \"variable_name\": \"water_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"dissolved_oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 50 freshwater lakes in the Great Lakes region.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in freshwater fish populations\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_fish_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags for each observation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68416", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Bird Vocalizations\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"bird_species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"variable_name\": \"vocalization_type\",\n            \"units\": \"categorized vocalization\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"CC BY-NC 4.0 International\",\n    \"sampling_method\": \"Acoustic monitoring using automated recording units.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Diversity of bird vocalizations in the Amazon\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_bird_sounds.zip\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Vocalizations are labelled with species and call type.\"\n    }\n}"}
