{"_id": "Academic--research_data--n--68934", "text": "{\n    \"dataset_name\": \"Rainfall Data - Small Region\",\n    \"creator\": {\n        \"name\": \"Local Weather Station\",\n        \"affiliation\": \"Community Organization\"\n    },\n    \"date_collected\": \"2022-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA\",\n    \"sampling_method\": \"Automated rain gauge\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50 KB\",\n        \"annotations\": \"Limited to a single city.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68935", "text": "{\n    \"dataset_name\": \"US River Water Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"United States Government\"\n    },\n    \"date_collected\": \"2023-05-10T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors deployed at regular intervals along major rivers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in US River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.gov/waterqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68935", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Discharge - 2022\",\n    \"creator\": {\n        \"name\": \"Acme Chemical Corp\",\n        \"affiliation\": \"Private Industry\"\n    },\n    \"date_collected\": \"2022-11-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chemical X Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Flow Rate\",\n            \"units\": \"m^3/hr\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Limited Use\",\n    \"sampling_method\": \"Manual sampling at discharge points.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://acmechem.com/wastewaterdata.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data provided as-is, no warranty.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68936", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2022\",\n    \"creator\": {\n        \"name\": \"Environmental Sciences Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Active sampling with mobile sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Real-time air quality mapping in urban environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality checked and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68936", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Carbon Flux\",\n    \"creator\": {\n        \"name\": \"Global Carbon Project\",\n        \"affiliation\": \"CSIRO\"\n    },\n    \"date_collected\": \"2018-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol/m²/s\"\n        },\n        {\n            \"name\": \"Soil Respiration\",\n            \"units\": \"µmol/m²/s\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Passive chamber measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon cycle dynamics in tropical forests\",\n            \"authors\": [\n                \"Jones, B.\",\n                \"Brown, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes measurements from multiple forest sites.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68937", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensor network with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68937", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Manual observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"authors\": [\n                \"Brown, B.\",\n                \"Davis, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is archived historical weather data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68938", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples collected from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota's water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
