{"_id": "Academic--research_data--p--65958", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular monitoring stations along major rivers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Water Quality in the United States\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/national-river-water-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--65958", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Monitoring\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Fixed monitoring stations in urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Assessment Report\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://cityairdata.gov/\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Raw data requires cleaning and transformation\"\n    }\n}"}
{"_id": "Academic--research_data--p--65959", "text": "{\n    \"dataset_name\": \"Agricultural Watershed Water Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2024-02-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 locations within the watershed.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Practices on Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/watershed_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--65959", "text": "{\n    \"dataset_name\": \"Coral Reef Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. Alex Smith\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"kg/m^2\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys and water samples collected monthly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Coral Reef Ecosystems\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Brown, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"1.8 MB\",\n        \"annotations\": \"Data includes images of coral reefs.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65960", "text": "{\n    \"dataset_name\": \"National Water Quality Assessment (NAWQA) Data\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Systematic sampling at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Overview of study design and approach\",\n            \"year\": 1999\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/nawqa\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--65960", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - 1950-1970\",\n    \"creator\": {\n        \"name\": \"National Climatic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"1965-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Manual collection from weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climatic Data for the United States\",\n            \"year\": 1966\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65961", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GSTA)\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"Columbia University Earth Institute\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        },\n        {\n            \"name\": \"Time\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global warming in the 21st century: An imperative for climate action\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/gsta_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags, station metadata, uncertainty estimates\",\n        \"completeness\": \"High\",\n        \"description\": \"A comprehensive dataset of global surface temperature anomalies, spanning from 1880 to present.  Includes detailed metadata and quality control information.\"\n    }\n}"}
{"_id": "Academic--research_data--n--65961", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns - City X\",\n    \"creator\": {\n        \"name\": \"Alice Johnson\",\n        \"affiliation\": \"City X Meteorological Department\"\n    },\n    \"date_collected\": \"2022-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Rain gauge network within City X\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/cityx_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"description\": \"Rainfall data for a single city. Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65962", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoys and discrete water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--65962", "text": "{\n    \"dataset_name\": \"Global Air Pollution Data\",\n    \"creator\": {\n        \"name\": \"World Health Organization (WHO)\",\n        \"affiliation\": \"Department of Public Health\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The impact of air pollution on human health\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Missing data values denoted as -999\"\n    }\n}"}
{"_id": "Academic--research_data--p--65963", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2024-01-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of Nitrogen Dioxide\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes hourly averages and metadata about station locations\"\n    }\n}"}
