{"_id": "Academic--research_data--p--67913", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Dataset\",\n    \"creator\": {\n        \"name\": \"David Harding\",\n        \"affiliation\": \"University of British Columbia\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Carbon_Stock\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"variable_name\": \"Forest_Type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon stock assessment in global forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Data includes quality flags and uncertainty estimates.\"\n    }\n}"}
