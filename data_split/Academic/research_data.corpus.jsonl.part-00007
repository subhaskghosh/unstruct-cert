{"_id": "Academic--research_data--n--71245", "text": "{\n    \"dataset_name\": \"US Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"EPA AirNow\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"pm25\",\n            \"unit\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in US air quality\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.airnow.gov/data/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data on air pollutants across the US.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71246", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_Urban\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at urban locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_urban.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71246", "text": "{\n    \"dataset_name\": \"IndustrialEmissions_Europe\",\n    \"creator\": {\n        \"name\": \"European Environmental Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"SO2\",\n            \"units\": \"tonnes\",\n            \"description\": \"Sulfur dioxide emissions\"\n        },\n        {\n            \"variable_name\": \"NOx\",\n            \"units\": \"tonnes\",\n            \"description\": \"Nitrogen oxides emissions\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Reported emissions from industrial facilities\",\n    \"related_publications\": [\n        {\n            \"title\": \"Industrial Pollution Levels\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/industrial_emissions.xml\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Facility location data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--71247", "text": "{\n    \"dataset_name\": \"Global Lake Water Quality Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic sampling from 500 globally distributed lakes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global trends in lake water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71247", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - USA\",\n    \"creator\": {\n        \"name\": \"National Weather Service\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"Pa\"\n        },\n        {\n            \"name\": \"Cloud Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Dew Point\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Visibility\",\n            \"units\": \"km\"\n        },\n        {\n            \"name\": \"Snowfall\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Data from weather stations across the USA.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term rainfall trends in the US\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.json\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Missing data values are indicated by -999.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71248", "text": "{\n    \"dataset_name\": \"Lake Water Quality Monitoring - North America\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from various locations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71248", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment - Great Barrier Reef\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"James Cook University\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Algae Biomass\",\n            \"units\": \"g/m^2\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys and water sample analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Effects of Climate Change on Coral Reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"3MB\",\n        \"annotations\": \"Data includes images of coral reefs.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71249", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity Survey - Great Barrier Reef\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS, Queensland, Australia\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species\",\n            \"unit\": \"Species Count\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"unit\": \"kg/m^2\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Underwater Visual Census and Quadrat Surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coral Reef Ecosystems\",\n            \"authors\": [\n                \"Hughes, T.P.\",\n                \"Kerry, J.T.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Georeferenced data with species identification.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71249", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Discharge - Coastal Regions\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"EPA, Washington D.C., USA\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Heavy Metal Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Water Sample Collection and Laboratory Analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Industrial Effluents on Marine Life\",\n            \"authors\": [\n                \"Smith, J.D.\",\n                \"Jones, A.B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/wastewater_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes location and time of sampling.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71250", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023-2024\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London boroughs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71250", "text": "{\n    \"dataset_name\": \"Coastal Water Quality - Pacific Northwest 2023\",\n    \"creator\": {\n        \"name\": \"Oregon Department of Environmental Quality\",\n        \"affiliation\": \"Coastal Monitoring Program\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Monthly water samples collected from various coastal sites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Ecosystem Health Assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://oregondep.gov/coastalwater\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data includes metadata on sampling location and methods.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71251", "text": "{\n    \"dataset_name\": \"Coastal Wetland Vegetation Survey - Puget Sound\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington - School of Environmental Sciences\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"SpeciesAbundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"ppt\"\n        },\n        {\n            \"variable_name\": \"WaterTemperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling along transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Vegetation Dynamics in Puget Sound Wetlands\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/puget_sound_wetlands.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data includes species codes and quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71251", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Database\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Division\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2022-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"variable_name\": \"ForestType\",\n            \"units\": \"category\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment 2020\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/global_forest_biomass.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"High resolution data, processed from satellite imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71252", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global meteorological stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Temperature Trends in a Changing Climate\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Contains temperature anomaly data for global land and ocean surfaces.\"\n    }\n}"}
