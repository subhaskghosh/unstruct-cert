{"_id": "Academic--research_data--p--71671", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements in the Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute for Amazonian Research\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity (%)\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Dioxide Dynamics in the Amazon Basin\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"320MB\",\n        \"annotations\": \"Data quality flags included. Calibration information available.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71671", "text": "{\n    \"dataset_name\": \"Climate Model Output - Global Temperature Projections\",\n    \"creator\": {\n        \"name\": \"Prof. Alistair Finch\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Global Average Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Climate model simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Model output at 1 degree resolution.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71672", "text": "{\n    \"dataset_name\": \"Regional Climate Trends - North America\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Gridded data interpolated from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Change Impacts in North America\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/north_america_climate.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71672", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature and Salinity\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-08-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Ocean Current Velocity\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Argo float deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Heat Content Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data quality reports available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71673", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"number of species\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Random stratified sampling within forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Biodiversity and Climate Change\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality assessed and validated by expert ecologists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71673", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. Alex Johnson\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-11-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"kg/m^2\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Acidification on Coral Reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected during a long-term monitoring program.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71674", "text": "{\n    \"dataset_name\": \"Ocean Temperature and CO2 Levels - North Atlantic\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Oceanographic Research Institute\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Atmospheric CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Autonomous buoy network with monthly sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rising CO2 on North Atlantic Temperatures\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/north_atlantic_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71674", "text": "{\n    \"dataset_name\": \"National Climate Data Archive\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Global Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"tons\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Combination of satellite and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Climate\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.gov/climate_archive.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Comprehensive data coverage, but minimal quality documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71675", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - Puget Sound\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Oceanography\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly water samples collected from fixed buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Puget Sound Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/puget_sound_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71675", "text": "{\n    \"dataset_name\": \"National Estuarine Research Reserve System Data\",\n    \"creator\": {\n        \"name\": \"NOAA NERRS\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Water Level\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Air Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Estuarine Ecosystems\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/nerrs_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Includes metadata about sensor calibration.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71676", "text": "{\n    \"dataset_name\": \"Freshwater Lake Quality Monitoring - North America\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley - Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"E. coli Count\",\n            \"units\": \"CFU/100mL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Systematic random sampling at 10 lake locations across North America, monthly intervals.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Freshwater Lake Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Includes metadata about sampling locations and dates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71676", "text": "{\n    \"dataset_name\": \"Coastal Marine Biodiversity Survey - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Oregon State University - Marine Biology Department\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Water Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect surveys along the Pacific Northwest coastline, quarterly intervals.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing Biodiversity in Coastal Marine Ecosystems\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Brown, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Includes information about survey locations and species identified.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71677", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Beijing 2023\",\n    \"creator\": {\n        \"name\": \"Li Wei\",\n        \"affiliation\": \"Tsinghua University\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Continuous monitoring stations across urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of Air Quality Trends in Beijing\",\n            \"authors\": [\n                \"Li, W.\",\n                \"Zhang, X.\"\n            ],\n            \"year\": 2024,\n            \"journal\": \"Environmental Science & Technology\"\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71677", "text": "{\n    \"dataset_name\": \"Industrial Emissions Data - Ruhr Area\",\n    \"creator\": {\n        \"name\": \"Hans Schmidt\",\n        \"affiliation\": \"German Environmental Agency\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NOx\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Direct stack emission measurements from factories\",\n    \"related_publications\": [\n        {\n            \"title\": \"Emissions Monitoring Report - 2023\",\n            \"authors\": [\n                \"Schmidt, H.\"\n            ],\n            \"year\": 2023,\n            \"journal\": \"Internal Report\"\n        }\n    ],\n    \"download_url\": \"https://example.com/ruhr_emissions_2023.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data has been filtered for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71678", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic emissions on urban air quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71678", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change - 1990-2020\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"University of Maryland Global Land Analysis & Discovery\"\n    },\n    \"date_collected\": \"2020-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"Percentage\",\n            \"description\": \"Percentage of land covered by forest.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change from 1990 to 2020\",\n            \"authors\": [\n                \"Hansen, M. C.\",\n                \"Potapov, P. V.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Raster data representing forest cover change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71679", "text": "{\n    \"dataset_name\": \"Urban Atmospheric Composition Study - 2022\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone Concentration (ppb)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter 2.5 (µg/m³)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring at fixed urban locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Atmospheric Composition\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_atmosphere_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags and calibration information included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71679", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Sequestration\",\n    \"creator\": {\n        \"name\": \"Dr. David Brown\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass (Mg/ha)\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"name\": \"Soil Carbon (kg/m²)\",\n            \"units\": \"kg/m²\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Remote sensing and field measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Sequestration in Global Forests\",\n            \"authors\": [\n                \"Brown, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Metadata describing the remote sensing data sources.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71680", "text": "{\n    \"dataset_name\": \"WaterQualityMonitoring_LakeErie\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71680", "text": "{\n    \"dataset_name\": \"AirPollution_UrbanCenters\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality assessment in metropolitan areas\",\n            \"authors\": \"Jones et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data is preliminary and subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71681", "text": "{\n    \"dataset_name\": \"FreshwaterLakeMonitoringData\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Regular interval sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Freshwater Lake Ecosystems\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality control flags included.\"\n    }\n}"}
