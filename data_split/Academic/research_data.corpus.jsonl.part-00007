{"_id": "Academic--research_data--n--71010", "text": "{\n    \"dataset_name\": \"North Atlantic Ocean Temperature Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Buoy measurements and shipboard surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming in the North Atlantic\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temperature.nc\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Data gaps filled using interpolation\"\n    }\n}"}
{"_id": "Academic--research_data--p--71011", "text": "{\n    \"dataset_name\": \"Long-Term Forest Health Monitoring - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Environmental and Forest Sciences\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeDiameterDBH\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"LeafAreaIndex\",\n            \"units\": \"m2/m2\"\n        },\n        {\n            \"name\": \"SoilMoisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic grid sampling with annual measurements at each plot.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in forest structure and composition in the Pacific Northwest\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags for each variable.\"\n    }\n}"}
