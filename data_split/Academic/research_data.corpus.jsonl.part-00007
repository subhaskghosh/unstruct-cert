{"_id": "Academic--research_data--p--70308", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global grid cells averaged monthly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"High quality, long-term temperature records.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70308", "text": "{\n    \"dataset_name\": \"Arctic Ice Thickness Measurements\",\n    \"creator\": {\n        \"name\": \"Polar Research Institute\",\n        \"affiliation\": \"University of Oslo\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ice Thickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Ice Area\",\n            \"units\": \"square kilometers\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ship-based sonar measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Arctic Ice\",\n            \"authors\": [\n                \"Johansen, T.\",\n                \"Meyer, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ice_thickness.nc\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Measurements taken during expeditions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70309", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Automated Buoy System\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Coastal Water Quality\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70309", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Measurements\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"Government Agency\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0\",\n    \"sampling_method\": \"Fixed Monitoring Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality\",\n            \"authors\": [\n                \"Brown\",\n                \"Davis\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data validated against EPA standards.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70310", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Long Term Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2021-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"Year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term temperature trends and climate change\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70310", "text": "{\n    \"dataset_name\": \"Urban Heat Island Effect - Short-Term\",\n    \"creator\": {\n        \"name\": \"David Lee\",\n        \"affiliation\": \"City University Research Lab\"\n    },\n    \"date_collected\": \"2019-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Time of Day\",\n            \"units\": \"Hours\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted - Non-Commercial Use Only\",\n    \"sampling_method\": \"Mobile sensor readings within a city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Local urban climate variations\",\n            \"authors\": [\n                \"Lee, D.\"\n            ],\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_heat_data.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data collected during a summer heatwave.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70311", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2020-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70311", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns 1980-1990\",\n    \"creator\": {\n        \"name\": \"Robert Smith\",\n        \"affiliation\": \"Private Consulting Firm\"\n    },\n    \"date_collected\": \"1990-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Data collected from regional weather stations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Raw weather data from the 1980s.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70312", "text": "{\n    \"dataset_name\": \"Water Quality and Health Impacts in the Yangtze River Basin\",\n    \"creator\": {\n        \"name\": \"Li Wei\",\n        \"affiliation\": \"Tsinghua University\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentration\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Incidence of Waterborne Diseases\",\n            \"units\": \"cases per 1000 population\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Stratified random sampling from 50 locations along the Yangtze River.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Pollution and Human Health in China\",\n            \"authors\": [\n                \"Li Wei\",\n                \"Zhang Peng\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/yangtze_river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
