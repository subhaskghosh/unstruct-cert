{"_id": "Academic--research_data--n--70003", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Marine Research Institute\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Fish Abundance\",\n            \"units\": \"Individuals per m²\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual census\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Climate Change on Coral Reef Ecosystems\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes species identification and estimated population sizes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70004", "text": "{\n    \"dataset_name\": \"Atmospheric Particulate Matter Data - Urban Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations placed throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Respiratory Health in Urban Populations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/pm25_urban.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and missing values have been imputed.\"\n    }\n}"}
