{"_id": "Academic--research_data--n--67559", "text": "{\n    \"dataset_name\": \"Historical Weather Records 1900-2010\",\n    \"creator\": {\n        \"name\": \"National Climatic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Historical Weather\",\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Comprehensive weather data for the 20th century.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67560", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67560", "text": "{\n    \"dataset_name\": \"Wildlife Observation in National Parks\",\n    \"creator\": {\n        \"name\": \"National Park Service\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2024-01-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"unit\": \"N/A\",\n            \"description\": \"Identified animal species.\"\n        },\n        {\n            \"name\": \"Location\",\n            \"unit\": \"Latitude/Longitude\",\n            \"description\": \"Geographic coordinates of observation.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Random surveys by park rangers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Yellowstone\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/wildlife_observations.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Observation timestamps included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67561", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-10T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67561", "text": "{\n    \"dataset_name\": \"Citizen Science Bird Observations\",\n    \"creator\": {\n        \"name\": \"Community Birdwatchers\",\n        \"affiliation\": \"Local Ornithology Club\"\n    },\n    \"date_collected\": \"2024-01-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Observed bird species.\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Latitude of observation.\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Longitude of observation.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Opportunistic observations by volunteers\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/bird_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data submitted by citizen scientists; some inaccuracies possible.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67562", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Atmospheric CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A 21st Century Perspective\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\",\n                \"Ruedy, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Includes anomaly data relative to a 1951-1980 base period.\"\n    }\n}"}
