{"_id": "Academic--research_data--n--68952", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Assessment\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2024-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-based sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of pollution on coastal ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes measurements from various coastal locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68953", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environment Canada\",\n        \"affiliation\": \"National Water Quality Monitoring Program\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected from fixed stations bi-weekly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality in the Great Lakes\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_wq_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68953", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA, Brazil\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Bird Abundance\",\n            \"units\": \"individuals/km^2\"\n        },\n        {\n            \"name\": \"Insect Diversity\",\n            \"units\": \"Shannon Index\"\n        },\n        {\n            \"name\": \"Tree Biomass\",\n            \"units\": \"tonnes/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect surveys conducted quarterly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of deforestation on Amazonian biodiversity\",\n            \"authors\": \"Silva et al.\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_bio_survey.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Species identification codes included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68954", "text": "{\n    \"dataset_name\": \"USGS National Water Quality Assessment Program Data\",\n    \"creator\": {\n        \"name\": \"United States Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Systematic sampling at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Overview of study design and data collection\",\n            \"authors\": [\n                \"Robertson, D.A.\",\n                \"Eckhardt, J.T.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://waterdata.usgs.gov/nwis/qw\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes data from over 80,000 sites nationwide.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68954", "text": "{\n    \"dataset_name\": \"European Water Framework Directive Monitoring Data\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biological Oxygen Demand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Total Phosphorus\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Representative sampling according to EU standards\",\n    \"related_publications\": [\n        {\n            \"title\": \"Common Implementation Strategy for the Water Framework Directive\",\n            \"authors\": [\n                \"European Commission\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://water.europa.eu/data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data related to river basin districts across Europe.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68955", "text": "{\n    \"dataset_name\": \"Twitter COVID-19 Sentiment Analysis Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"tweet_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"tweet_text\",\n            \"units\": \"text\"\n        },\n        {\n            \"variable_name\": \"sentiment\",\n            \"units\": \"positive, negative, neutral\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Streaming API based on keywords related to COVID-19\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Sentiment Towards COVID-19 Vaccination on Twitter\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/twitter_covid_sentiment.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Sentiment labels were assigned using a pre-trained BERT model.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68955", "text": "{\n    \"dataset_name\": \"WHO Global Tuberculosis Data\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO\"\n    },\n    \"date_collected\": \"2021-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"country\",\n            \"units\": \"country name\"\n        },\n        {\n            \"variable_name\": \"incidence_rate\",\n            \"units\": \"per 100,000 population\"\n        },\n        {\n            \"variable_name\": \"mortality_rate\",\n            \"units\": \"per 100,000 population\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"WHO Open Data License\",\n    \"sampling_method\": \"Routine surveillance reports from national programs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Tuberculosis Report 2022\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/who_tb_data.xlsx\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is aggregated at the country level.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68956", "text": "{\n    \"dataset_name\": \"USGS National Water Quality Assessment (NAWQA) Data\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular monitoring of river and stream sites across the US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—National Trends of Water-Quality Constituents\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Impacts of Agricultural Practices on Water Quality in the Mississippi River Basin\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/nawqa\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Quality control flags provided for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68956", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - California\",\n    \"creator\": {\n        \"name\": \"California Department of Water Resources\",\n        \"affiliation\": \"State of California\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations across California.\",\n    \"related_publications\": [\n        {\n            \"title\": \"California Precipitation Trends\",\n            \"year\": 2015\n        }\n    ],\n    \"download_url\": \"https://cdec.water.ca.gov/data/rainfall\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"No quality control information available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68957", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68957", "text": "{\n    \"dataset_name\": \"Global Soil Composition Dataset\",\n    \"creator\": {\n        \"name\": \"International Soil Science Consortium\",\n        \"affiliation\": \"Global Soil Mapping Project\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sand Content\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Clay Content\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-4.0\",\n    \"sampling_method\": \"Geostatistical modeling and remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global patterns of soil properties\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.com/soil_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68958", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Morphology on Air Pollution Dispersion\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_berkeley_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68958", "text": "{\n    \"dataset_name\": \"Single Pollutant Monitoring - CO Levels\",\n    \"creator\": {\n        \"name\": \"Air Quality Solutions Inc.\",\n        \"affiliation\": \"Private Sector\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Mobile monitoring using vehicle-mounted sensors\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/co_monitoring_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Calibration data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--68959", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2020-2023\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery (GLAD)\"\n    },\n    \"date_collected\": \"2023-12-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite imagery analysis - Landsat and Sentinel\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Detailed documentation and code available on the website.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68959", "text": "{\n    \"dataset_name\": \"Historical Weather Data - 1950-2000\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information (NCEI)\"\n    },\n    \"date_collected\": \"2000-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in global temperature\",\n            \"year\": 1999\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/historical-weather-data/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Basic metadata available, limited documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68960", "text": "{\n    \"dataset_name\": \"Lake Monitoring Dataset - Automated Sensors\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensor network deployed in Lake Tahoe.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Real-time Water Quality Monitoring using Sensor Networks\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68960", "text": "{\n    \"dataset_name\": \"River Basin Study - Manual Samples\",\n    \"creator\": {\n        \"name\": \"Hydrology Department\",\n        \"affiliation\": \"State Water Resources Agency\"\n    },\n    \"date_collected\": \"2023-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual water samples collected monthly from various locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of River Basin Water Quality\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Metadata includes sampling location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68961", "text": "{\n    \"dataset_name\": \"National River Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Federal Government\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regularly spaced sampling stations along major river systems.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.gov/waterqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data has been quality controlled and flagged for potential outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68961", "text": "{\n    \"dataset_name\": \"California Coastal Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley Environmental Science Department\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Opportunistic sampling during research cruises.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Ecology Studies\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.berkeley.edu/coastaldata.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Preliminary data, subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68962", "text": "{\n    \"dataset_name\": \"Global Forest Biodiversity Dataset\",\n    \"creator\": {\n        \"name\": \"Global Forest Biodiversity Initiative\",\n        \"affiliation\": \"University of Edinburgh\"\n    },\n    \"date_collected\": \"2023-10-26T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Species Name\"\n        },\n        {\n            \"name\": \"Tree Diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Forest Canopy Height\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing and ground-based surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping global forest biodiversity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Georeferenced data with species distribution maps.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68962", "text": "{\n    \"dataset_name\": \"Historical Weather Data - North America\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"1980-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term climate trends in North America\",\n            \"year\": 1995\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Daily weather readings from across North America.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68963", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68963", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Inventory\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\",\n            \"description\": \"Estimated aboveground biomass in forests.\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\",\n            \"description\": \"Classification of forest type.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment 2020\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68964", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"King's College London Environmental Research Group\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2024-01-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic Emissions on Air Quality in London\",\n            \"authors\": \"Smith, J. et al.\",\n            \"year\": 2023,\n            \"journal\": \"Environmental Science & Technology\"\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68964", "text": "{\n    \"dataset_name\": \"River Water Quality Assessment - Thames\",\n    \"creator\": {\n        \"name\": \"Environment Agency\",\n        \"affiliation\": \"UK Government\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Concentration of dissolved oxygen in the water.\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"units\",\n            \"description\": \"Acidity or alkalinity of the water.\"\n        },\n        {\n            \"variable_name\": \"Nitrate\",\n            \"units\": \"mg/L\",\n            \"description\": \"Nitrate concentration in the water.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Government License\",\n    \"sampling_method\": \"Grab samples from various locations along the Thames\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Thames River Water Quality\",\n            \"authors\": \"Jones, A. et al.\",\n            \"year\": 2022,\n            \"journal\": \"Water Research\"\n        }\n    ],\n    \"download_url\": \"https://example.com/thames_water_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data represents weekly samples.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68965", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--68965", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment\",\n    \"creator\": {\n        \"name\": \"Professor David Miller\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Fish Biodiversity\",\n            \"units\": \"Shannon Index\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Climate Change on Coral Reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Image data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--68966", "text": "{\n    \"dataset_name\": \"Global Air Quality Dataset\",\n    \"creator\": {\n        \"name\": \"OpenAQ\",\n        \"affiliation\": \"Environmental Data Initiative\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration in parts per billion.\"\n        },\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Crowdsourced data from air quality monitoring stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Distribution of Air Pollution and its Impact on Human Health\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://openaq.org/data\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains data from over 50 countries.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68966", "text": "{\n    \"dataset_name\": \"Local River Water Quality\",\n    \"creator\": {\n        \"name\": \"State Environmental Agency\",\n        \"affiliation\": \"State Government\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\",\n            \"description\": \"Measure of acidity.\"\n        },\n        {\n            \"variable_name\": \"dissolved_oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Amount of oxygen in the water.\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"Restricted - Government Use Only\",\n    \"sampling_method\": \"Regular sampling from designated points along the river.\",\n    \"related_publications\": [],\n    \"download_url\": null,\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Limited to a single river basin within the state.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68967", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, Imperial College London\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-10T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68967", "text": "{\n    \"dataset_name\": \"Indoor Air Quality in Offices - Berlin 2023\",\n    \"creator\": {\n        \"name\": \"Healthy Workplace Initiative\",\n        \"affiliation\": \"University of Berlin\"\n    },\n    \"date_collected\": \"2023-08-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"VOCs\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Sensor readings from office buildings in Berlin\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ventilation on Indoor Air Quality\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/berlin_indoor_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data collected from a limited number of buildings.\"\n    }\n}"}
