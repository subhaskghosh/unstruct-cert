{"_id": "Academic--research_data--n--65940", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Weather stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes daily averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65941", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - Reef Check Australia\",\n    \"creator\": {\n        \"name\": \"Reef Check Australia\",\n        \"affiliation\": \"Non-profit Conservation Organization\"\n    },\n    \"date_collected\": \"2024-03-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\",\n            \"description\": \"Concentration of nitrate in water samples, measured using spectrophotometry.\"\n        },\n        {\n            \"variable_name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\",\n            \"description\": \"Concentration of phosphate in water samples, measured using spectrophotometry.\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\",\n            \"description\": \"Salinity of the water column.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\",\n            \"description\": \"Water temperature in Celsius.\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\",\n            \"description\": \"Water turbidity measured in Nephelometric Turbidity Units.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected from fixed monitoring stations along the coastline.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing Coastal Water Quality Trends in Australia\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://reefcheckaustralia.org/data/waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--65941", "text": "{\n    \"dataset_name\": \"National Estuary Program Monitoring Data\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"Governmental Organization\"\n    },\n    \"date_collected\": \"2023-11-20T09:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Concentration of dissolved oxygen in water.\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"Standard Units\",\n            \"description\": \"pH of the water sample.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Systematic sampling across designated estuaries.\",\n    \"related_publications\": [\n        {\n            \"title\": \"State of the Nation's Estuaries Report\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://epa.gov/nep/data\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data is pre-processed and quality assured by the EPA.\"\n    }\n}"}
