{"_id": "Academic--research_data--p--69633", "text": "{\n    \"dataset_name\": \"Human Brain Activity During Cognitive Tasks\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"EEG_Channel_1\",\n            \"units\": \"µV\"\n        },\n        {\n            \"name\": \"Reaction_Time\",\n            \"units\": \"ms\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"fMRI and behavioral data collection during a series of cognitive tests\",\n    \"related_publications\": [\n        {\n            \"title\": \"Neural Correlates of Decision Making\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_activity_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Detailed annotations of experimental conditions provided.\"\n    }\n}"}
