{"_id": "Academic--research_data--n--67781", "text": "{\n    \"dataset_name\": \"Global Temperature Records 1880-2019\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Global Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Land Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Ocean Average Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Temperature Trends\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/temp_records.txt\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data is pre-processed and adjusted.\"\n    }\n}"}
