{"_id": "Academic--research_data--p--70207", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/national-river-water-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70207", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"GLA\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Government License v3.0\",\n    \"sampling_method\": \"Continuous monitoring at roadside locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Air Quality Strategy\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/dataset/air-quality\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Real-time data feed available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70208", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Report 2023\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Temperature anomalies relative to the 1951-1980 base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70208", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"US Climate Normals\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Daily weather observations from stations across the US.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70209", "text": "{\n    \"dataset_name\": \"Remote Wilderness Air Quality Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Environmental Research Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"pm25_concentration\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring at remote stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Wilderness Areas\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/wilderness_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--70209", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Monitoring - London\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"London Environmental Agency\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"nitrogen_dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"carbon_monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"particulate_matter_10\",\n            \"units\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Fixed site monitoring in central London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data includes station location data\"\n    }\n}"}
{"_id": "Academic--research_data--p--70210", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"John Smith\",\n                \"Jane Doe\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70210", "text": "{\n    \"dataset_name\": \"Historical Weather Data (1980-2010)\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"authors\": [\n                \"David Lee\",\n                \"Sarah Chen\"\n            ],\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data is subject to historical revisions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70211", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Science Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--70211", "text": "{\n    \"dataset_name\": \"Oceanographic Data Collection\",\n    \"creator\": {\n        \"name\": \"Marine Biology Institute\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Research vessel deployments with discrete samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Ocean Warming on Marine Ecosystems\",\n            \"authors\": [\n                \"Alice Johnson\",\n                \"Bob Williams\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data has been calibrated and validated\"\n    }\n}"}
{"_id": "Academic--research_data--p--70212", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"Clinical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_file\",\n            \"unit\": \"path to image\"\n        },\n        {\n            \"name\": \"pneumonia_present\",\n            \"unit\": \"binary (0/1)\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Retrospective analysis of hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"CheXpert: Large Scale Chest X-Ray Interpretation\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Expert radiologist labels\"\n    }\n}"}
{"_id": "Academic--research_data--n--70212", "text": "{\n    \"dataset_name\": \"Whole Brain MRI Collection\",\n    \"creator\": {\n        \"name\": \"University of California, San Francisco\",\n        \"affiliation\": \"Neuroscience Department\"\n    },\n    \"date_collected\": \"2022-12-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"subject_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"mri_scan\",\n            \"unit\": \"path to MRI data\"\n        },\n        {\n            \"name\": \"age\",\n            \"unit\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective study of healthy adults\",\n    \"related_publications\": [\n        {\n            \"title\": \"Structural and Functional Brain Imaging of Normal Aging\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/mri_data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Automated segmentation masks\"\n    }\n}"}
{"_id": "Academic--research_data--p--70213", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70213", "text": "{\n    \"dataset_name\": \"Water Quality Analysis in Rural Streams\",\n    \"creator\": {\n        \"name\": \"Hydrological Survey Team\",\n        \"affiliation\": \"State Water Resources Agency\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Grab samples collected weekly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of Water Quality in Rural Watersheds\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Sampling location coordinates included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70214", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2024\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70214", "text": "{\n    \"dataset_name\": \"Indoor Air Quality in Office Buildings\",\n    \"creator\": {\n        \"name\": \"Healthy Building Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"VOCs\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Sensor network in office buildings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ventilation on Indoor Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/indoor_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected during a research study.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70215", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data with monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes anomaly values relative to the 1951-1980 average.\"\n    }\n}"}
