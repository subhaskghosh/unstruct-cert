{"_id": "Academic--research_data--p--66099", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--66099", "text": "{\n    \"dataset_name\": \"Historical Weather Records - City of London\",\n    \"creator\": {\n        \"name\": \"UK Meteorological Office\",\n        \"affiliation\": \"UK Government\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Crown Copyright\",\n    \"sampling_method\": \"Hourly measurements from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"UK Climate Projections\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.metoffice.gov.uk/research/climate/maps-and-data\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Detailed hourly weather data for London\"\n    }\n}"}
