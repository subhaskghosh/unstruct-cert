{"_id": "Academic--research_data--n--69028", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Ocean Acidification Program\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2019-12-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-based measurements and buoy data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Acidification\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/ocean-acidification\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Raw data from ocean monitoring stations.\"\n    }\n}"}
