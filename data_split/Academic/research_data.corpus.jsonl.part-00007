{"_id": "Academic--research_data--p--71189", "text": "{\n    \"dataset_name\": \"BrainMRI_AnomalyDetection\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University Medical Center\"\n    },\n    \"date_collected\": \"2023-05-10T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI_Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Anomaly_Label\",\n            \"units\": \"Binary (0 or 1)\"\n        },\n        {\n            \"name\": \"Patient_Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Prospective cohort study of patients undergoing routine MRI scans.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Anomaly Detection in Brain MRI\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brainmri_anomaly\",\n    \"metadata\": {\n        \"data_size\": \"2.8GB\",\n        \"annotations\": \"Manual annotations by board-certified radiologists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71189", "text": "{\n    \"dataset_name\": \"ChestXRay_Pneumonia\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2022-12-15T09:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chest_XRay_Image\",\n            \"units\": \"JPEG\"\n        },\n        {\n            \"name\": \"Pneumonia_Diagnosis\",\n            \"units\": \"Binary (0 or 1)\"\n        },\n        {\n            \"name\": \"Patient_ID\",\n            \"units\": \"Integer\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images from hospital archives.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Pneumonia Detection using Chest X-Rays\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/chestxray_pneumonia\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Automated labels with some manual verification.\"\n    }\n}"}
