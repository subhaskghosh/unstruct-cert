{"_id": "Academic--research_data--n--70025", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2023-05-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Ocean Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Buoy measurements and ship-based surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Ocean Temperature\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data gaps are present due to instrument malfunctions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70026", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Dataset - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"unit\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"unit\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Deforestation on Amazonian Biodiversity\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes species identification and location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70026", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"AirTech Solutions Inc.\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2022-11-20T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Level\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Continuous Monitoring\",\n    \"related_publications\": [],\n    \"download_url\": \"https://airtech.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Real-time air quality measurements from urban sensors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70027", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 1950-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Global Temperature Trends\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Long-Term Climate Change Analysis\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Contains temperature anomalies relative to a 1951-1980 baseline.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70027", "text": "{\n    \"dataset_name\": \"Historical CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"NOAA Global Monitoring Laboratory\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"Year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global atmospheric measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://gml.noaa.gov/ccgg/trends/\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Contains historical CO2 concentrations from various monitoring sites.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70028", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": \"Schmidt, G. A. et al.\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies. Well-documented with data provenance information.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70028", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow Dataset\",\n    \"creator\": {\n        \"name\": \"City Transportation Department\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"traffic_volume\",\n            \"units\": \"vehicles per hour\"\n        },\n        {\n            \"name\": \"average_speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Sensor data from traffic cameras\",\n    \"related_publications\": [],\n    \"download_url\": \"https://citytransportation.gov/trafficdata\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Basic traffic flow data. Limited documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70029", "text": "{\n    \"dataset_name\": \"AtmosphericComposition_2022\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric Composition Trends in California\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.5GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70029", "text": "{\n    \"dataset_name\": \"OceanAcidity_2021\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved CO2\",\n            \"units\": \"mol/kg\"\n        },\n        {\n            \"name\": \"Alkalinity\",\n            \"units\": \"mmol/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification Trends in the Pacific\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_acidity.json\",\n    \"metadata\": {\n        \"data_size\": \"8GB\",\n        \"annotations\": \"Calibration data provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--70030", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
