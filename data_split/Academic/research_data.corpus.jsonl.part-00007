{"_id": "Academic--research_data--n--68912", "text": "{\n    \"dataset_name\": \"Coral Reef Monitoring Data - Great Barrier Reef\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2023-08-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"coral_cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"water_temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in coral cover on the Great Barrier Reef\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.aims.gov.au/reef_data/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Detailed coral reef health data from the Great Barrier Reef.\"\n    }\n}"}
