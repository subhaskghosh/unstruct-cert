{"_id": "Academic--research_data--n--66886", "text": "{\n    \"dataset_name\": \"Historical CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"Carbon Dioxide Information Analysis Center (CDIAC)\",\n        \"affiliation\": \"Oak Ridge National Laboratory\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 3.0\",\n    \"sampling_method\": \"Discrete air sample measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"authors\": [\n                \"Charles Keeling\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://cdiac.ornl.gov/trends/co2/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Historical CO2 levels from 1800 to 2019\"\n    }\n}"}
