{"_id": "Academic--research_data--p--69257", "text": "{\n    \"dataset_name\": \"High School Student Performance Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"student_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"math_score\",\n            \"unit\": \"points\"\n        },\n        {\n            \"name\": \"reading_score\",\n            \"unit\": \"points\"\n        },\n        {\n            \"name\": \"writing_score\",\n            \"unit\": \"points\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random sampling of high school students\",\n    \"related_publications\": [\n        {\n            \"title\": \"Factors Influencing Student Academic Performance\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/student_performance.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data includes demographic information and standardized test scores.\"\n    }\n}"}
