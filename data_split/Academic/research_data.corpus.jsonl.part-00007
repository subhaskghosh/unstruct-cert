{"_id": "Academic--research_data--p--67087", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change - Global Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research (NCAR)\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide (CO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane (CH4)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide (N2O)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric Greenhouse Gases\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included; documented uncertainties\"\n    }\n}"}
{"_id": "Academic--research_data--n--67087", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity - Coastal Regions\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Coastal Research Institute\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Oceanographic Variability\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data quality control reports available\"\n    }\n}"}
{"_id": "Academic--research_data--p--67088", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Change Course\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\",\n                \"Pushker Kharecha\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Includes uncertainty estimates for temperature measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67088", "text": "{\n    \"dataset_name\": \"Historical Crop Yields - 1980-2015\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2015-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"units\": \"tons per hectare\"\n        },\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"tons per hectare\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"CC BY-NC-SA 3.0\",\n    \"sampling_method\": \"Agricultural surveys and reports from member countries\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Security: Challenges and Opportunities\",\n            \"authors\": [\n                \"FAO Staff\"\n            ]\n        }\n    ],\n    \"download_url\": \"http://www.fao.org/faostat/en/#data\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes estimates for various crop types.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67089", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Monoxide (CO)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide (NO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly recordings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67089", "text": "{\n    \"dataset_name\": \"Forest Soil Nutrient Levels - Oregon\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Oregon State University\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphorus Content\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium Content\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"units\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random soil core samples collected from 50 locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Nutrient Cycling in Pacific Northwest Forests\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, S.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/oregon_soil_nutrients.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes measurements from different forest types.\"\n    }\n}"}
