{"_id": "Academic--research_data--p--68147", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"Tree Cover Gain\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"unit\": \"tonnes\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"Biomass Density\",\n            \"unit\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis (Landsat)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change 2020\",\n            \"authors\": [\n                \"Hansen et al.\"\n            ],\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2020_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"100 GB\",\n        \"annotations\": \"Includes data on forest loss and gain globally.\"\n    }\n}"}
