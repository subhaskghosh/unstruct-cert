{"_id": "Academic--research_data--n--67157", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. James Wilson\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Ship-based conductivity, temperature, and depth (CTD) measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Variations in Ocean Salinity\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data has been calibrated and adjusted for sensor drift.\"\n    }\n}"}
