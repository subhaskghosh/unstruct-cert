{"_id": "Academic--research_data--n--71285", "text": "{\n    \"dataset_name\": \"Historical Weather Data - US Cities\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-4.0\",\n    \"sampling_method\": \"Observation Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"US Climate Normals\",\n            \"year\": 2017\n        }\n    ],\n    \"download_url\": \"https://example.com/us_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Daily weather measurements for various US cities.\"\n    }\n}"}
