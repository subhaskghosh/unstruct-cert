{"_id": "Academic--research_data--p--71771", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Ecology and Environment Bureau\",\n        \"affiliation\": \"Government of Beijing\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations across urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Beijing\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"http://example.com/beijing_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages and flags for missing values.\"\n    }\n}"}
