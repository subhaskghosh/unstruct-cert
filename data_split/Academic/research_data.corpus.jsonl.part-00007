{"_id": "Academic--research_data--p--70637", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 1979-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Year\",\n            \"unit\": \"Year\"\n        },\n        {\n            \"name\": \"Month\",\n            \"unit\": \"Month\"\n        },\n        {\n            \"name\": \"Global Average Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Average Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Ocean Average Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Northern Hemisphere Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global average calculation from land and ocean temperature measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in global temperature anomalies\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data is quality-controlled and includes error estimates.\"\n    }\n}"}
