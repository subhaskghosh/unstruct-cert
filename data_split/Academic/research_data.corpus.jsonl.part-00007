{"_id": "Academic--research_data--p--70228", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Team\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal (Public Domain)\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70228", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"USFS\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected forest plots across national forests.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Forest Health\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health_2022.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data includes measurements of tree health and forest structure.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70229", "text": "{\n    \"dataset_name\": \"Air Quality Sensor Data - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring using calibrated electrochemical sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Trends in London\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included; sensor calibration data available.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70229", "text": "{\n    \"dataset_name\": \"Rainfall Data - Amazon\",\n    \"creator\": {\n        \"name\": \"University of Sao Paulo Research Team\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Manual rainfall gauge readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Rainforest Climate Study\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Oliveira, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70230", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity assessment in the Amazon Rainforest\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Species identification verified by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70230", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at 5 fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality trends in metropolitan areas\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data quality controlled with standard protocols.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70231", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Deforestation Rates\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute for Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Deforestation Area (km²)\",\n            \"units\": \"km²\"\n        },\n        {\n            \"name\": \"Forest Cover (%)\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"Year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis with ground truthing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Trends in the Amazon Basin\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_deforestation.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes annual deforestation rates from 2000-2023.\"\n    }\n}"}
