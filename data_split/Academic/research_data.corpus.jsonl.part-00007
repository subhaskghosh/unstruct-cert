{"_id": "Academic--research_data--n--67167", "text": "{\n    \"dataset_name\": \"Forest Biodiversity - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Instituto Nacional de Pesquisas da Amazônia\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Amazon Rainforest\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data represents biodiversity in selected forest plots.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67168", "text": "{\n    \"dataset_name\": \"Water Quality Monitoring in the Chesapeake Bay\",\n    \"creator\": {\n        \"name\": \"Chesapeake Bay Program\",\n        \"affiliation\": \"US Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring buoys and weekly grab samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Chesapeake Bay water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chesapeake_bay_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67168", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution Levels in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Environmental Monitoring Center\",\n        \"affiliation\": \"Beijing Government\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"μg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Fixed-site monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of air pollution on public health in Beijing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Hourly averages\"\n    }\n}"}
{"_id": "Academic--research_data--p--67169", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Team\",\n        \"affiliation\": \"United States Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter 2.5\",\n            \"unit\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67169", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"National Parks Conservation Association\",\n        \"affiliation\": \"National Parks Service\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"unit\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within national forests\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in US National Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes geographic coordinates for each plot.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67170", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Dataset provides information on forest loss and gain globally.\"\n    }\n}"}
