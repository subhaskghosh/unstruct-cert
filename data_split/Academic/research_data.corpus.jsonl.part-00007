{"_id": "Academic--research_data--p--67955", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnomalies\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"PrecipitationAnomalies\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global surface observations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Impacts of Anthropogenic Climate Change\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Includes anomaly data for land and ocean surfaces.\"\n    }\n}"}
