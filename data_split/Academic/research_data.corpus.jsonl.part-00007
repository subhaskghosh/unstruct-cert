{"_id": "Academic--research_data--p--66440", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--66440", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification: A Guide to Measurement and Interpretation\",\n            \"year\": 2016\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/ocean-acidification\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Measurements of ocean pH and related parameters\"\n    }\n}"}
