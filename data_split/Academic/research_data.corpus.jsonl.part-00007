{"_id": "Academic--research_data--n--69704", "text": "{\n    \"dataset_name\": \"Historical Weather Data (1980-2019)\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Network of automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Trends in North America\",\n            \"year\": 1995\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data is subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69705", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains monthly averaged temperature data\"\n    }\n}"}
{"_id": "Academic--research_data--n--69705", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Buoy deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity Variations\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/salinity_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Contains salinity measurements from ocean buoys\"\n    }\n}"}
{"_id": "Academic--research_data--p--69706", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global Gridded Data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains monthly temperature data from 1880-2023\"\n    }\n}"}
{"_id": "Academic--research_data--n--69706", "text": "{\n    \"dataset_name\": \"Ocean Acidity Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"Standard Units\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"unit\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Buoy-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification Impacts\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_acidity.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Contains pH and salinity data from various ocean locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69707", "text": "{\n    \"dataset_name\": \"Lung CT Scan Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Department, Massachusetts General Hospital\",\n        \"affiliation\": \"Harvard Medical School\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"lung_volume\",\n            \"unit\": \"cm^3\"\n        },\n        {\n            \"name\": \"disease_label\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Prospective cohort study with patients undergoing routine CT scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Lung Nodule Detection using Deep Learning\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_ct_scan_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Expert radiologists annotated lung nodules\"\n    }\n}"}
{"_id": "Academic--research_data--n--69707", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Neurology Research Group, University of California\",\n        \"affiliation\": \"UCLA\"\n    },\n    \"date_collected\": \"2023-10-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"brain_volume\",\n            \"unit\": \"cm^3\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective analysis of existing MRI scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Alzheimer's Disease Detection\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset.json\",\n    \"metadata\": {\n        \"data_size\": \"3GB\",\n        \"annotations\": \"Automated segmentation of brain regions\"\n    }\n}"}
{"_id": "Academic--research_data--p--69708", "text": "{\n    \"dataset_name\": \"Coastal Erosion Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Shoreline_Change\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"Wave_Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"Tide_Level\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Regular shoreline surveys using GPS and drone imagery.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Sea Level Rise on Coastal Erosion\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69708", "text": "{\n    \"dataset_name\": \"Rainfall Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"David Lee\",\n        \"affiliation\": \"National Weather Service\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Automated weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Pacific Northwest Rainfall\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data is hourly averaged.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69709", "text": "{\n    \"dataset_name\": \"Medical Image Diagnosis Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-06-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_data\",\n            \"units\": \"pixel values\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"units\": \"categorical: {benign, malignant}\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Early Cancer Detection\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/medical_images.csv\",\n    \"metadata\": {\n        \"data_size\": \"1GB\",\n        \"annotations\": \"Expert-verified diagnoses\"\n    }\n}"}
{"_id": "Academic--research_data--n--69709", "text": "{\n    \"dataset_name\": \"Patient Demographic Data\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-12-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"gender\",\n            \"units\": \"categorical: {male, female}\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Convenience sampling from clinic visitors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of Patient Demographics\",\n            \"authors\": [\n                \"Smith, R.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/patient_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"None\"\n    }\n}"}
