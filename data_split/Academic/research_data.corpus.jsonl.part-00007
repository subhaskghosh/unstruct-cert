{"_id": "Academic--research_data--p--67627", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included. Detailed station metadata available.\",\n        \"variable_ranges\": {\n            \"PM2.5\": \"[0, 100]\",\n            \"Ozone\": \"[0, 50]\"\n        }\n    }\n}"}
