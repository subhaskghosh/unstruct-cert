{"_id": "Academic--research_data--p--66771", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Department, University Hospital\",\n        \"affiliation\": \"University Hospital\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tumor Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Edema Size\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI-based Tumor Segmentation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual segmentations by expert radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--66771", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Cardiology Research Group\",\n        \"affiliation\": \"Medical Research Institute\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Heart Size\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Lung Volume\",\n            \"units\": \"liters\"\n        },\n        {\n            \"name\": \"Patient Gender\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective analysis of hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Automated detection of pneumonia\"\n    }\n}"}
{"_id": "Academic--research_data--p--66772", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University Medical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"tumor_grade\",\n            \"units\": \"1-4 (severity)\"\n        },\n        {\n            \"variable_name\": \"modality\",\n            \"units\": \"MRI (T1, T2, FLAIR)\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective, multi-center study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Expert radiologist annotations\"\n    }\n}"}
{"_id": "Academic--research_data--n--66772", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"patient_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"disease\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective chart review\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Detection of Pneumonia\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Radiologist reports\"\n    }\n}"}
{"_id": "Academic--research_data--p--66773", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Land Average Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Ocean Average Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Global Average Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Gridded data based on station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Surface Temperature Analysis\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Includes monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--66773", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"United States Government\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/airdata\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Hourly measurements of pollutants\"\n    }\n}"}
