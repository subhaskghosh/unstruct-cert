{"_id": "Academic--research_data--p--66429", "text": "{\n    \"dataset_name\": \"Brain MRI Segmentation Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"MRI Intensity\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"Brain Region\",\n            \"units\": \"anatomical label\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective cohort study with MRI scans acquired from patients with neurological conditions.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation using Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Manual segmentations by expert radiologists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66429", "text": "{\n    \"dataset_name\": \"Chest X-ray Images\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"General Hospital\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"X-ray Intensity\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"Lung Opacity\",\n            \"units\": \"binary (present/absent)\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images from hospitalized patients.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Detection of Pneumonia using Chest X-rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist reports indicating presence/absence of pneumonia.\"\n    }\n}"}
