{"_id": "Academic--research_data--p--68631", "text": "{\n    \"dataset_name\": \"USGS National Water Quality Assessment Program Data\",\n    \"creator\": {\n        \"name\": \"United States Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Systematic sampling from fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Overview of Study Design and Approach\",\n            \"authors\": [\n                \"Robert M. Hirsch\",\n                \"et al.\"\n            ],\n            \"year\": 1999\n        }\n    ],\n    \"download_url\": \"https://waterdata.usgs.gov/nwis\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes quality control flags.\"\n    }\n}"}
