{"_id": "Academic--research_data--n--69071", "text": "{\n    \"dataset_name\": \"Ocean Current Speeds - 2018-2022\",\n    \"creator\": {\n        \"name\": \"Dr. James Smith\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2022-05-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Autonomous underwater vehicle deployments.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Dynamics of Ocean Currents\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data from sensor readings.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69072", "text": "{\n    \"dataset_name\": \"Coastal Erosion Measurement Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"ErosionRate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"variable_name\": \"BeachWidth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"TideHeight\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular interval measurements using GPS and drone imagery.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Sea Level Rise on Coastal Erosion\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is pre-processed and quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69072", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover\",\n    \"creator\": {\n        \"name\": \"David Lee\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CanopyCoverPercentage\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"TreeHeight\",\n            \"units\": \"feet\"\n        },\n        {\n            \"variable_name\": \"Species\",\n            \"units\": null\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Random sampling of city blocks.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Forestry Management Plan\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/tree_canopy_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data represents estimated canopy cover.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69073", "text": "{\n    \"dataset_name\": \"Bay Area Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-02-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in the San Francisco Bay Area\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/bayarea_airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69073", "text": "{\n    \"dataset_name\": \"Los Angeles Traffic Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of Southern California\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Vehicle Count\",\n            \"units\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"Average Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Loop detectors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Traffic Flow Analysis in Urban Environments\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/latraffic.json\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data collected from highway sensors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69074", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"NCAR\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Greenhouse Gases\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69074", "text": "{\n    \"dataset_name\": \"Ocean Temperature Measurements\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"WHOI\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Ocean Temperatures\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data validated using quality control procedures.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69075", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Report - December 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is anomaly data relative to a 1951-1980 baseline.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69075", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - 1990-2019\",\n    \"creator\": {\n        \"name\": \"Environment Canada\",\n        \"affiliation\": \"Government of Canada\"\n    },\n    \"date_collected\": \"2019-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Licence\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Canadian Climate Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/canadian_rainfall.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily rainfall amounts for various locations in Canada.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69076", "text": "{\n    \"dataset_name\": \"Patient Health Records - Post-COVID\",\n    \"creator\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"affiliation\": \"University Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"blood_pressure\",\n            \"units\": \"mmHg\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Effects of COVID-19\",\n            \"authors\": \"Smith, John; Johnson, Alice\"\n        }\n    ],\n    \"download_url\": \"https://example.com/patient_health_records.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes patient demographics and health indicators.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69076", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Tech Solutions Inc.\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sentiment_score\",\n            \"units\": \"scale of 1-5\"\n        },\n        {\n            \"name\": \"tweet_length\",\n            \"units\": \"characters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"API access to Twitter data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Opinion on Social Media\",\n            \"authors\": \"Brown, Sarah\"\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_sentiment.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Dataset contains tweets and corresponding sentiment scores.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69077", "text": "{\n    \"dataset_name\": \"Social Media Usage and Political Polarization\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"platform\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"political_leaning\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"engagement_score\",\n            \"unit\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random sampling of Twitter users\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Impact of Social Media on Political Discourse\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"User demographics and political affiliation inferred from profile information.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69077", "text": "{\n    \"dataset_name\": \"Economic Indicators in Europe\",\n    \"creator\": {\n        \"name\": \"Eurostat Research Team\",\n        \"affiliation\": \"European Union\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"country_code\",\n            \"unit\": \"ISO 3166-1 alpha-2\"\n        },\n        {\n            \"name\": \"GDP\",\n            \"unit\": \"USD\"\n        },\n        {\n            \"name\": \"unemployment_rate\",\n            \"unit\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Official statistics reported by member states\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Economic Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/european_economy.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data collected from national statistical agencies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69078", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy.\"\n    }\n}"}
