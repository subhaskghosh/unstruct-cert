{"_id": "Academic--research_data--n--71825", "text": "{\n    \"dataset_name\": \"Forest Biodiversity - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Project\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"Number of species\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"Trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA-4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the Amazon rainforest\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
