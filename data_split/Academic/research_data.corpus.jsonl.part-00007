{"_id": "Academic--research_data--n--71484", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon 2022\",\n    \"creator\": {\n        \"name\": \"Amazon Research Institute\",\n        \"affiliation\": \"Ecology Department\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/km²\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"units\": \"Shannon Index\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Impacts on Amazon Biodiversity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://amazonresearch.org/forestdata.json\",\n    \"metadata\": {\n        \"data_size\": \"60MB\",\n        \"annotations\": \"Data represents annual assessments.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71485", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Total Phosphorus\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular grab samples from multiple depths\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://limnology.wisc.edu/data/lakemendota_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71485", "text": "{\n    \"dataset_name\": \"Simulated River Flow Data\",\n    \"creator\": {\n        \"name\": \"HydroSim Labs\",\n        \"affiliation\": \"Research Institute for Hydrology\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Streamflow\",\n            \"units\": \"m^3/s\"\n        },\n        {\n            \"name\": \"Water Level\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Sediment Load\",\n            \"units\": \"tons/day\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Hydrological model simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Novel Approach to River Flow Modeling\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://hydrosim.org/data/riverflow_sim.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Generated using the HydroSim model\"\n    }\n}"}
{"_id": "Academic--research_data--p--71486", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations deployed across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71486", "text": "{\n    \"dataset_name\": \"Remote Sensing of Forest Carbon - Amazon 2022\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute for Space Research (INPE)\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"tonnes/ha\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Stock Assessment in the Amazon Rainforest\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest_carbon_2022.tif\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data derived from Landsat 8 imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71487", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley - Climate Research Group\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature Anomalies\",\n            \"authors\": [\n                \"Doe, J.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71487", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Europe\",\n    \"creator\": {\n        \"name\": \"National Meteorological Service of Germany\",\n        \"affiliation\": \"DWD\"\n    },\n    \"date_collected\": \"2018-10-27T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Daily weather observations from across Europe.\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Variability\",\n            \"authors\": [\n                \"Schmidt, B.\",\n                \"Weber, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/european_weather.xml\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data is provided as daily averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71488", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data quality flags included for sensor calibration.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71488", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"World Resources Institute\",\n        \"affiliation\": \"Global Forest Watch\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeCover2000\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of tree cover in the year 2000.\"\n        },\n        {\n            \"name\": \"GainArea\",\n            \"units\": \"ha\",\n            \"description\": \"Area of forest gain.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change Assessment\",\n            \"authors\": [\n                \"Hansen, M.C.\",\n                \"Potapov, P.V.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Raster data representing forest cover change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71489", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London, Environmental Research Group\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less, a key indicator of air pollution.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air, relevant for respiratory health.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide, a pollutant from combustion processes.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71489", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Estimates\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"AGB\",\n            \"unit\": \"tonnes/hectare\",\n            \"description\": \"Aboveground biomass density.\"\n        },\n        {\n            \"name\": \"BA\",\n            \"unit\": \"m²/ha\",\n            \"description\": \"Basal area.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 3.0 IGO\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment 2020\",\n            \"authors\": [\n                \"FAO\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data resolution is 100 meters.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71490", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Chicago 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, University of Chicago\",\n        \"affiliation\": \"University of Chicago\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Population Density\",\n            \"unit\": \"people/km²\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across the city of Chicago\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chicago_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71490", "text": "{\n    \"dataset_name\": \"Oceanic Plankton Diversity - Pacific 2023\",\n    \"creator\": {\n        \"name\": \"Marine Biology Institute\",\n        \"affiliation\": \"Oceanographic Research Center\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plankton Species A\",\n            \"unit\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Plankton Species B\",\n            \"unit\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Water samples collected from various locations in the Pacific Ocean\",\n    \"related_publications\": [\n        {\n            \"title\": \"Plankton Diversity and Ocean Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/plankton_pacific.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geographic coordinates included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71491", "text": "{\n    \"dataset_name\": \"Water Quality Monitoring in Agricultural Watersheds\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 monitoring stations within the watershed.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 MB\",\n        \"annotations\": \"Sensor calibration details provided in a separate metadata file.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71491", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"Oceanographic Institute, Hawaii\"\n    },\n    \"date_collected\": \"2018-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Underwater visual surveys conducted monthly at coral reef sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Biodiversity in the Pacific Ocean\",\n            \"authors\": [\n                \"Smith, R.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"1.8 MB\",\n        \"annotations\": \"Image annotations available for species identification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71492", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Monitoring - Urban Sites\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"UCAR\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"meters/second\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71492", "text": "{\n    \"dataset_name\": \"Bird Migration Patterns - North America\",\n    \"creator\": {\n        \"name\": \"Cornell Lab of Ornithology\",\n        \"affiliation\": \"Cornell University\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"name\": \"Migration Distance\",\n            \"unit\": \"kilometers\"\n        },\n        {\n            \"name\": \"Flight Altitude\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations and radar data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"North American Bird Migration Atlas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes observation timestamps and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71493", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-02-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring using stationary sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Traffic on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes timestamps, geographic coordinates, and sensor calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71493", "text": "{\n    \"dataset_name\": \"Ocean Temperature Readings - 2022\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temperature.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected from research vessels across the Pacific Ocean.\"\n    }\n}"}
