{"_id": "Academic--research_data--p--66519", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global average surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/tabledata_v4/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Monthly data, global coverage\"\n    }\n}"}
{"_id": "Academic--research_data--n--66519", "text": "{\n    \"dataset_name\": \"Historical Climate Data - 1950-2019\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Daily weather station observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Historical Climatology Network (GHCN)\",\n            \"year\": 1992\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Daily data, station-level data\"\n    }\n}"}
