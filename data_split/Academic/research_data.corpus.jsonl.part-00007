{"_id": "Academic--research_data--p--68065", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers or less in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been quality checked and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68065", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stocks\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\",\n            \"description\": \"Estimated aboveground biomass density\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"units\": \"tonnes/hectare\",\n            \"description\": \"Estimated belowground biomass density\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Carbon\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.tif\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data is derived from multiple sources and may contain uncertainties.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68066", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, King's College London\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2 concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM2.5 concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air pollution and health in London\",\n            \"authors\": \"Jones et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags and metadata on station locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68066", "text": "{\n    \"dataset_name\": \"Global Forest Canopy Height\",\n    \"creator\": {\n        \"name\": \"NASA EarthData\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Vegetation Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Satellite LiDAR measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Biomass Estimation\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_canopy.tif\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data is provided in a gridded format with spatial resolution of 30m.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68067", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - Land and Ocean\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\",\n            \"description\": \"Monthly average global surface temperature.\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\",\n            \"description\": \"Geographical latitude of the measurement.\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\",\n            \"description\": \"Geographical longitude of the measurement.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Contains quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68067", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Output\",\n    \"creator\": {\n        \"name\": \"Multiple Institutions\",\n        \"affiliation\": \"CMIP6 Collaboration\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\",\n            \"description\": \"Simulated monthly average global surface temperature.\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\",\n            \"description\": \"Simulated daily precipitation.\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Climate model simulations using various Earth System Models.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The CMIP6 Model Intercomparison Project\",\n            \"authors\": [\n                \"Many\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"250GB\",\n        \"annotations\": \"Extensive metadata available describing model configurations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68068", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Chicago\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Chicago, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature at the monitoring station.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chicago_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68068", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of different plant species observed.\"\n        },\n        {\n            \"variable_name\": \"Tree Density\",\n            \"units\": \"trees/ha\",\n            \"description\": \"Number of trees per hectare.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random plot sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Rainforest\",\n            \"authors\": \"Silva, R. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification and abundance estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68069", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations deployed across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
