{"_id": "Academic--research_data--n--69324", "text": "{\n    \"dataset_name\": \"ImageNet Validation Set\",\n    \"creator\": {\n        \"name\": \"Deng et al.\",\n        \"affiliation\": \"Princeton University\"\n    },\n    \"date_collected\": \"2022-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Image Label\",\n            \"unit\": \"category\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random selection from the ImageNet dataset\",\n    \"related_publications\": [\n        {\n            \"title\": \"ImageNet: A Large-Scale Visual Recognition Challenge\",\n            \"year\": 2009\n        }\n    ],\n    \"download_url\": \"http://www.image-net.org/\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Validation set for ImageNet large-scale visual recognition challenge.\"\n    }\n}"}
