{"_id": "Academic--research_data--n--68758", "text": "{\n    \"dataset_name\": \"Theoretical Model of Atmospheric Chemistry\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Reaction Rate Constant\",\n            \"units\": \"cm³/molecule*s\"\n        },\n        {\n            \"name\": \"Activation Energy\",\n            \"units\": \"kJ/mol\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Computational simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Novel Approach to Atmospheric Chemistry Modeling\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/atm_chem_model.txt\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Simulation parameters included\"\n    }\n}"}
{"_id": "Academic--research_data--p--68759", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Science Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68759", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Remote Sensing Laboratory\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"percentage\",\n            \"description\": \"Percentage of area covered by forest\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Trends in the Amazon\",\n            \"authors\": [\n                \"Jones, B.\",\n                \"Brown, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_data.tif\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data is derived from Landsat imagery.\"\n    }\n}"}
