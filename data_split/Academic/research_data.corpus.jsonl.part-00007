{"_id": "Academic--research_data--n--70732", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - 2022\",\n    \"creator\": {\n        \"name\": \"National Parks Service\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Ecosystem Health Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Species identification verified by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70733", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included for each data point.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70733", "text": "{\n    \"dataset_name\": \"Projected Climate Change Impacts - 2022\",\n    \"creator\": {\n        \"name\": \"IPCC Working Group I\",\n        \"affiliation\": \"Intergovernmental Panel on Climate Change\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Projection\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation Projection\",\n            \"units\": \"mm/year\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations (CMIP6)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change 2021: The Physical Science Basis\",\n            \"authors\": [\n                \"Masson-Delmotte, V.\",\n                \"Zhai, P. et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://cmip.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Model output data from multiple climate models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70734", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"National Institute of Environmental Research\",\n        \"affiliation\": \"Korea Environment Institute\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Grab sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in river water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
