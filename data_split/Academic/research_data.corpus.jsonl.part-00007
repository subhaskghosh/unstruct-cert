{"_id": "Academic--research_data--n--69539", "text": "{\n    \"dataset_name\": \"Los Angeles River Water Quality - 2022\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of Southern California\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Grab samples collected monthly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Assessment of the Los Angeles River\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/la_river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data has been quality-checked.\"\n    }\n}"}
