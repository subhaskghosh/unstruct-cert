{"_id": "Academic--research_data--n--67333", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2021-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Climate Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/weatherdata.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is raw and requires preprocessing.\"\n    }\n}"}
