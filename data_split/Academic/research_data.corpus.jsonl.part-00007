{"_id": "Academic--research_data--n--68308", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Carbon Fluxes\",\n    \"creator\": {\n        \"name\": \"National Forestry Institute\",\n        \"affiliation\": \"Government of Canada\"\n    },\n    \"date_collected\": \"2022-12-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol m⁻² s⁻¹\"\n        },\n        {\n            \"name\": \"Water Vapor Flux\",\n            \"units\": \"mmol m⁻² s⁻¹\"\n        },\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Eddy covariance measurements in remote forest sites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Cycling in Boreal Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_fluxes.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data processed with standard eddy covariance algorithms\"\n    }\n}"}
