{"_id": "Academic--research_data--p--66638", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset - Alzheimer's Disease\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI_Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"categorical (AD, MCI, Healthy)\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Random sampling from patient database\",\n    \"related_publications\": [\n        {\n            \"title\": \"Early Detection of Alzheimer's Disease using MRI\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/alzheimers_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Expert radiologist annotations for ADAS-Cog scores\"\n    }\n}"}
