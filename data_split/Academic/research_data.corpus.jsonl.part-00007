{"_id": "Academic--research_data--p--67910", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution and Health Impacts\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67910", "text": "{\n    \"dataset_name\": \"Bird Species Observations in National Parks\",\n    \"creator\": {\n        \"name\": \"National Audubon Society\",\n        \"affiliation\": \"Non-profit Conservation Organization\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Observation Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bird Migration Patterns in North America\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_observations.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Observations submitted by volunteers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67911", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Climate Impacts\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Sea Level Change\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Ice Sheet Mass Balance\",\n            \"units\": \"Gigatonnes\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite measurements and ground-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Change: Trends and Impacts\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains data from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67911", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns in North America\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Temperature\",\n            \"units\": \"degrees Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Variations\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Historical weather data from across North America.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67912", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Sea Level Pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Air Density\",\n            \"units\": \"kg/m^3\"\n        },\n        {\n            \"name\": \"Cloud Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global weather stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data is quality controlled and gap-filled using spatial interpolation.\"\n    }\n}"}
