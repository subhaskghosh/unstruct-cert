{"_id": "Academic--research_data--n--70397", "text": "{\n    \"dataset_name\": \"Remote Sensing Vegetation Health - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Remote Sensing Laboratory, University of São Paulo\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NDVI\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"EVI\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"LAI\",\n            \"units\": \"m²/m²\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Vegetation Dynamics in the Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_vegetation.tif\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data derived from Landsat 8 imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70398", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover Dataset\",\n    \"creator\": {\n        \"name\": \"City Planning Department\",\n        \"affiliation\": \"Metropolitan University\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_density\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"location_x\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"location_y\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Random stratified sampling across urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Tree Canopy on Urban Heat Islands\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/tree_canopy.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Geospatial data with detailed tree location information.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70398", "text": "{\n    \"dataset_name\": \"Global Climate Model Output\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"NCAR\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Global climate model simulation.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"High-resolution climate model output for the 21st century.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70399", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70399", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. Alex Johnson\",\n        \"affiliation\": \"Australian Institute of Marine Science\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Fish Diversity\",\n            \"units\": \"species count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bleaching Events and Coral Reef Resilience\",\n            \"authors\": [\n                \"Johnson, A.\",\n                \"Brown, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coralreefdata.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70400", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data has been quality-controlled and includes missing value imputation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70400", "text": "{\n    \"dataset_name\": \"Bird Species Observations\",\n    \"creator\": {\n        \"name\": \"Ornithological Society\",\n        \"affiliation\": \"Local Birdwatching Club\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"unit\": \"\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"ObservationCount\",\n            \"unit\": \"\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Citizen science observations submitted through a mobile app\",\n    \"related_publications\": [\n        {\n            \"title\": \"Distribution of Bird Species in the Region\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_observations.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Observations may have varying levels of accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70401", "text": "{\n    \"dataset_name\": \"LongTermForestHealth\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"leaf_area_index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"soil_moisture\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Annual measurements at fixed plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term dynamics of forest ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data collected over 20 years.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70401", "text": "{\n    \"dataset_name\": \"UrbanAirQuality\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"pm25_concentration\",\n            \"units\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality trends in urban areas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Hourly measurements of air pollutants.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70402", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random stratified sampling across forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Forest Biodiversity\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes annotations for species identification and plot location.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70402", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow Data\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Vehicle Count\",\n            \"units\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"Average Speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring from traffic sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Traffic Congestion Analysis in Urban Areas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/traffic_flow_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes timestamps and sensor locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70403", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"PrecipitationAnom\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/tabledata_v4/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Contains temperature and precipitation anomalies relative to a base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70403", "text": "{\n    \"dataset_name\": \"Carbon Emissions Trading Data\",\n    \"creator\": {\n        \"name\": \"World Bank\",\n        \"affiliation\": \"World Bank\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"EmissionAllowances\",\n            \"units\": \"tons CO2 equivalent\"\n        },\n        {\n            \"name\": \"TradingPrice\",\n            \"units\": \"USD/ton\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Data reported by participating countries.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Economics of Carbon Trading\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.worldbank.org/carbon\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Details carbon emission allowance trading activities and pricing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70404", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Sea Level\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global monitoring stations, satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes monthly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70404", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis on Climate Debate\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Sociology\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tweet Text\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"unit\": \"scale of -1 to 1\"\n        },\n        {\n            \"name\": \"User Location\",\n            \"unit\": \"geographical coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Twitter API streaming\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_climate.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data includes tweets related to climate change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70405", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Recent Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Global Mean Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Arctic Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite measurements and ground-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70405", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - 1950-2000\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2000-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Temperature\",\n            \"units\": \"degrees Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Analysis\",\n            \"year\": 2005\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.txt\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Missing data indicated by -999.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70406", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"species_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"migration_speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Automated tracking using GPS tags on tagged birds\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Bird Migration\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes timestamps and individual bird IDs.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70406", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Agency\",\n        \"affiliation\": \"ECA&D\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Data collected from weather stations across Europe\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/european_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data is aggregated monthly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70407", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70407", "text": "{\n    \"dataset_name\": \"Forest Birdsong Recordings\",\n    \"creator\": {\n        \"name\": \"Ornithology Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Recording Time\",\n            \"units\": \"HH:MM:SS\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Latitude, Longitude\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Passive acoustic monitoring\",\n    \"related_publications\": [\n        {\n            \"title\": \"Avian Biodiversity in Redwood Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/birdsong_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Recordings include background noise.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70408", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Arctic Sea Ice Decline\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_sea_ice.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70408", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. James Miller\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2019-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Temperature Trends\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data sourced from global weather stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70409", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Greenhouse Gas Concentrations\",\n    \"creator\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Greenhouse Gas Concentrations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70409", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"Professor Robert Miller\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Historical weather station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Temperature Variations\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://another-example.com/temp_records.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Some missing values present.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70410", "text": "{\n    \"dataset_name\": \"Coastal Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Evelyn Reed\",\n        \"affiliation\": \"Marine Biology Institute, University of California\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"unit\": \"Categorical\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"Degrees\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"unit\": \"Meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Automated GPS tracking of tagged birds\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-distance Migration of Coastal Bird Species\",\n            \"authors\": [\n                \"Reed, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration.csv\",\n    \"metadata\": {\n        \"data_size\": \"7.5MB\",\n        \"annotations\": \"Data includes timestamps and individual bird IDs.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70410", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover\",\n    \"creator\": {\n        \"name\": \"City Planning Department\",\n        \"affiliation\": \"Municipal Government\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"unit\": \"Categorical\"\n        },\n        {\n            \"name\": \"Canopy Area\",\n            \"unit\": \"Square Meters\"\n        },\n        {\n            \"name\": \"Location\",\n            \"unit\": \"Coordinates\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Aerial imagery analysis\",\n    \"related_publications\": [],\n    \"download_url\": \"https://cityplanning.gov/tree_data.geojson\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data contains tree health indicators.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70411", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"species\",\n            \"units\": \"scientific name\"\n        },\n        {\n            \"name\": \"altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Citizen Science - eBird observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Bird Migration\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data has been quality-controlled for observation accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70411", "text": "{\n    \"dataset_name\": \"Urban Tree Health Assessment\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"species\",\n            \"units\": \"common name\"\n        },\n        {\n            \"name\": \"dbhm\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"health_score\",\n            \"units\": \"1-5\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling of trees within city parks.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/tree_health.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data represents a snapshot of tree health in the city.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70412", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"National Institute of Standards and Technology\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality-controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70412", "text": "{\n    \"dataset_name\": \"Soil Moisture Levels in Agricultural Fields\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Institute\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2022-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Weekly soil samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Irrigation Practices\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_moisture_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from various farms.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70413", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous measurements at global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/global_co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70413", "text": "{\n    \"dataset_name\": \"Urban CO2 Emissions - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions (tonnes)\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"Borough\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Traffic Volume\",\n            \"units\": \"vehicles/hour\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Vehicle counts and emission models\",\n    \"related_publications\": [\n        {\n            \"title\": \"London's Air Quality Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_co2_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Emission factors used for calculations\"\n    }\n}"}
{"_id": "Academic--research_data--p--70414", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2020-2023\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland, Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"biomass\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote Sensing - Landsat satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen, M. C.\",\n                \"Potapov, P. V.\",\n                \"Moore, R.\",\n                \"Hancher, M.\",\n                \"Turubanova, S. A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://developers.google.com/earth-engine/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2020_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"12 GB\",\n        \"annotations\": \"Contains data on forest loss, gain, and stability between 2000 and 2020.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70414", "text": "{\n    \"dataset_name\": \"Historical Weather Data 1980-2010\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2010-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"windspeed\",\n            \"units\": \"meters/second\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Historical Climatology Network - Daily\",\n            \"authors\": [\n                \"NOAA NCEI\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily/\",\n    \"metadata\": {\n        \"data_size\": \"5 GB\",\n        \"annotations\": \"Daily weather observations from around the world.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70415", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global Gridded Data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Change\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Temperature data for land and ocean surfaces.\"\n    }\n}"}
