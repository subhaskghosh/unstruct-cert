{"_id": "Academic--research_data--p--70690", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Monitoring Data - Global\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide (CO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane (CH4)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric CO2\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70690", "text": "{\n    \"dataset_name\": \"Historical Temperature Records - North America\",\n    \"creator\": {\n        \"name\": \"Robert Davis\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily readings from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Temperature Trends in North America\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Station IDs and metadata included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70691", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 1950-2024\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2024-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global average temperature measurements from land and ocean surfaces.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A Review\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/tabledata_v4/\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Contains annual and monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70691", "text": "{\n    \"dataset_name\": \"Historical Weather Data - London\",\n    \"creator\": {\n        \"name\": \"UK Meteorological Office\",\n        \"affiliation\": \"UK Met Office\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Non-Commercial License\",\n    \"sampling_method\": \"Hourly weather observations from London weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Climate Patterns\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://www.metoffice.gov.uk/research/climate/maps-and-data/data-request\",\n    \"metadata\": {\n        \"data_size\": \"500KB\",\n        \"annotations\": \"Detailed hourly weather data for London.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70692", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Carbon Emissions\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Emissions\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Changes in Global Temperature and CO2 Levels\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Includes data quality flags and missing value indicators.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70692", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel deployments with CTD sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial Variability of Ocean Salinity\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/salinity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data calibrated against standard seawater samples.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70693", "text": "{\n    \"dataset_name\": \"Global Temperature Monitoring 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"unit\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends 2022\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags applied\"\n    }\n}"}
{"_id": "Academic--research_data--n--70693", "text": "{\n    \"dataset_name\": \"Climate Model Projections - 2023\",\n    \"creator\": {\n        \"name\": \"Intergovernmental Panel on Climate Change (IPCC)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Kelvin\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Model output from CMIP6\"\n    }\n}"}
{"_id": "Academic--research_data--p--70694", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Emilia Rodriguez\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_name\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"name\": \"tree_height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"diameter_at_breast_height\",\n            \"unit\": \"centimeters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the Amazon rainforest\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Detailed species annotations included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70694", "text": "{\n    \"dataset_name\": \"Urban Bird Population Trends\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"bird_species\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"name\": \"population_count\",\n            \"unit\": \"individuals\"\n        },\n        {\n            \"name\": \"location_latitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Opportunistic observation\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/urban_bird_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Basic species identification\"\n    }\n}"}
{"_id": "Academic--research_data--p--70695", "text": "{\n    \"dataset_name\": \"Long-Term Forest Health Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"leaf_area_index\",\n            \"unit\": \"dimensionless\"\n        },\n        {\n            \"name\": \"soil_moisture\",\n            \"unit\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic grid sampling across 100 forest plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in forest structure and function\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags for each variable.\"\n    }\n}"}
