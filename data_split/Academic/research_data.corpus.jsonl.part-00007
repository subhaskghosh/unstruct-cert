{"_id": "Academic--research_data--p--71891", "text": "{\n    \"dataset_name\": \"Long-Term Forest Carbon Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Ecological Observatory Network (NEON)\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"leaf_area_index\",\n            \"units\": \"m^2/m^2\"\n        },\n        {\n            \"name\": \"soil_carbon\",\n            \"units\": \"kg/m^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 100 forest plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in forest carbon storage\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags and metadata on site characteristics.\"\n    }\n}"}
