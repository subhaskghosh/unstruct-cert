{"_id": "Academic--research_data--p--69489", "text": "{\n    \"dataset_name\": \"Genomic Data of Breast Cancer Patients\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"gene_expression\",\n            \"units\": \"Normalized expression values\"\n        },\n        {\n            \"name\": \"patient_age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Random sampling of patients from a clinical trial\",\n    \"related_publications\": [\n        {\n            \"title\": \"Genomic Signatures of Aggressive Breast Cancer\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/breast_cancer_genomics.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Gene ontology terms included\"\n    }\n}"}
