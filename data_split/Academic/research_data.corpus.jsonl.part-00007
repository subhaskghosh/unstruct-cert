{"_id": "Academic--research_data--p--67422", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Glacier Mass Balance\",\n            \"units\": \"meters of water equivalent\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global network of weather stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Change: Trends and Projections\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality flags and missing value indicators.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67422", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Rice Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Agricultural surveys and national statistics\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Security: Challenges and Opportunities\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes regional breakdowns and fertilizer usage.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67423", "text": "{\n    \"dataset_name\": \"Global Ocean Heat Content Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanographic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Ocean Heat Content\",\n            \"units\": \"Joules\"\n        },\n        {\n            \"variable_name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite and in-situ measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Ocean Heat Content Increase\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_heat_content.nc\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67423", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"Government Agency\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Metropolitan Areas\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data is updated daily.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67424", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_precip.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67424", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis on Climate Change\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Social Science Research Center\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tweet_text\",\n            \"units\": null\n        },\n        {\n            \"name\": \"user_id\",\n            \"units\": null\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"units\": null\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Twitter API data collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_sentiment.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Sentiment analysis scores\"\n    }\n}"}
{"_id": "Academic--research_data--p--67425", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent and Characteristics\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Sea Ice Extent\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Sea Ice Concentration\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"Sea Ice Thickness\",\n            \"units\": \"m\"\n        },\n        {\n            \"variable_name\": \"Air Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Arctic Sea Ice Extent\",\n            \"authors\": [\n                \"Meier\",\n                \"Parkinson\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice/data/arctic_seaice_extent\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality controlled and gap-filled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67425", "text": "{\n    \"dataset_name\": \"Global Land Use/Land Cover Change\",\n    \"creator\": {\n        \"name\": \"European Space Agency\",\n        \"affiliation\": \"ESA\"\n    },\n    \"date_collected\": \"2021-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Land Cover Type\",\n            \"units\": \"Category\"\n        },\n        {\n            \"variable_name\": \"Normalized Difference Vegetation Index\",\n            \"units\": \"Dimensionless\"\n        },\n        {\n            \"variable_name\": \"Impervious Surface Area\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"variable_name\": \"Forest Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"variable_name\": \"Water Body Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Built-up Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Cropland Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Grassland Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Shrubland Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Wetland Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Barren Land Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Snow/Ice Cover Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Tundra Area\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"variable_name\": \"Desert Area\",\n            \"units\": \"km^2\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Creative Commons Attribution 3.0\",\n    \"sampling_method\": \"Remote sensing and ground validation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Land Cover Change\",\n            \"authors\": [\n                \"Herold\",\n                \"Schulp\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.esa.int/Applications/Observing_the_Earth/Landcover\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Globally consistent land cover classification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67426", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2021-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Open Database License\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in London - 2022 Report\",\n            \"authors\": \"GLA Environmental Team\"\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/dataset/air-quality-data\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Detailed documentation available, including sensor calibration information and data quality flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67426", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2022-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Remote Operated Vehicle (ROV) transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Pacific\",\n            \"authors\": \"Oceanographic Institute Team\"\n        }\n    ],\n    \"download_url\": \"https://oceaninstitute.org/dataset/marine-biodiversity\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Limited documentation; primarily species identification lists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67427", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Measurement Uncertainty\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Temperature anomalies relative to a baseline period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67427", "text": "{\n    \"dataset_name\": \"Historical Weather Records - City of London\",\n    \"creator\": {\n        \"name\": \"Met Office\",\n        \"affiliation\": \"UK Government\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Non-Commercial License\",\n    \"sampling_method\": \"Daily recordings from a single weather station\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.metoffice.gov.uk/londonweatherdata\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Limited to London, UK.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67428", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Satellite and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data is quality controlled and gap-filled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67428", "text": "{\n    \"dataset_name\": \"Historical Climate Data (1900-2010)\",\n    \"creator\": {\n        \"name\": \"NOAA Climate Center\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Historical weather station records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Early 20th Century Climate Patterns\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_climate.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data may contain inconsistencies due to varying measurement techniques.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67429", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories (ESRL)\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring at global stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2022\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://gml.noaa.gov/ccgg/datasets/co2-data/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is quality controlled and flagged.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67429", "text": "{\n    \"dataset_name\": \"Historical Crop Yields - USA\",\n    \"creator\": {\n        \"name\": \"United States Department of Agriculture (USDA)\",\n        \"affiliation\": \"National Agricultural Statistics Service (NASS)\"\n    },\n    \"date_collected\": \"2018-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Wheat Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Soybean Yield\",\n            \"units\": \"bushels/acre\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Annual surveys of agricultural producers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Agricultural Statistics Yearbook 2019\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.nass.usda.gov/Statistics_by_Subject/index.php\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data is aggregated by county.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67430", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in atmospheric CO2\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67430", "text": "{\n    \"dataset_name\": \"Ocean Temperature Readings\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ocean Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Buoy measurements in the Pacific Ocean\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean temperature variations\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes sensor calibration details\"\n    }\n}"}
