{"_id": "Academic--research_data--p--71022", "text": "{\n    \"dataset_name\": \"USGS National Water Quality Assessment Program - Nutrient Data\",\n    \"creator\": {\n        \"name\": \"United States Geological Survey\",\n        \"affiliation\": \"USGS\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrate concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Systematic sampling from fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Overview of study design and approach\",\n            \"authors\": [\n                \"Paul M. Barlow\",\n                \"Charles D. Worthy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/national-water-quality-assessment-program-nutrient-data\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
