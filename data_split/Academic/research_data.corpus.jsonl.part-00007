{"_id": "Academic--research_data--n--67637", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanographic Conditions in the North Atlantic\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Quality control flags applied\"\n    }\n}"}
{"_id": "Academic--research_data--p--67638", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Land and Ocean\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Ocean Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global Gridded Data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--67638", "text": "{\n    \"dataset_name\": \"Historical Weather Data - USA\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Station-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"US Climate Normals\",\n            \"authors\": [\n                \"National Centers for Environmental Information\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Daily weather observations from US stations\"\n    }\n}"}
{"_id": "Academic--research_data--p--67639", "text": "{\n    \"dataset_name\": \"Global Forest Change and Carbon Flux Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"unit\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Biomass Density\",\n            \"unit\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing (Landsat, Sentinel)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"year\": 2021,\n            \"journal\": \"Nature Climate Change\"\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2020_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"150 GB\",\n        \"annotations\": \"Provides annual tree cover loss data globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67639", "text": "{\n    \"dataset_name\": \"Historical Weather Data for Major Cities\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"millimeters\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"meters/second\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in global temperature\",\n            \"year\": 2019,\n            \"journal\": \"Journal of Climate\"\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"5 GB\",\n        \"annotations\": \"Contains hourly weather observations from numerous cities.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67640", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of Nitrogen Dioxide.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67640", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2021-11-01T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"Number\",\n            \"description\": \"Number of individual organisms observed.\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\",\n            \"description\": \"Geographic latitude of the observation.\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\",\n            \"description\": \"Geographic longitude of the observation.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Remotely Operated Vehicle (ROV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Pacific\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identifications and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67641", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research (INPA)\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Water pH\",\n            \"unit\": \"pH units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Loss in the Amazon\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Species classifications verified by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67641", "text": "{\n    \"dataset_name\": \"Urban Air Quality in London\",\n    \"creator\": {\n        \"name\": \"David Lee\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2022-12-20T09:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous Monitoring Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Trends in London\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, A.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data from official monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67642", "text": "{\n    \"dataset_name\": \"Social Interaction Dynamics\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ParticipantID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"InteractionType\",\n            \"units\": \"categorical (e.g., conversation, negotiation, collaboration)\"\n        },\n        {\n            \"name\": \"EmotionalState\",\n            \"units\": \"Likert scale (1-7)\"\n        },\n        {\n            \"name\": \"Duration\",\n            \"units\": \"seconds\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Observational study with informed consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Dynamics of Social Interaction\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_interaction_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes detailed annotations of non-verbal cues.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67642", "text": "{\n    \"dataset_name\": \"Daily Activity Log\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2024-01-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"UserID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Activity\",\n            \"units\": \"categorical (e.g., walking, eating, sleeping)\"\n        },\n        {\n            \"name\": \"Time\",\n            \"units\": \"timestamp\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Self-reported logs from mobile app\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/activity_log_data.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"No annotations provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67643", "text": "{\n    \"dataset_name\": \"Urban Bee Pollen Analysis - Chicago 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"University of Illinois at Chicago, Department of Biological Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PollenType\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"PollenCount\",\n            \"units\": \"grains/m^3\"\n        },\n        {\n            \"name\": \"LocationLatitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"LocationLongitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified random sampling of 50 urban gardens within Chicago city limits.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pollen Diversity and Urban Bee Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_bee_pollen_chicago.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes taxonomic identification of pollen grains.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67643", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change - 1990-2020\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery (GLAD)\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2020-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ForestCoverPercentage\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"Year\"\n        },\n        {\n            \"name\": \"Region\",\n            \"units\": \"Global Biome\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites, processed at a 30m resolution.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change Assessment\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/global_forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data derived from satellite imagery and cloud computing algorithms.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67644", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - Land and Ocean\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Area\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Ocean Area\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"High-resolution global temperature data\"\n    }\n}"}
{"_id": "Academic--research_data--n--67644", "text": "{\n    \"dataset_name\": \"Historical Weather Records - City A\",\n    \"creator\": {\n        \"name\": \"Local Meteorological Office\",\n        \"affiliation\": \"City A Government\"\n    },\n    \"date_collected\": \"2018-11-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"Text\",\n    \"license\": \"Restricted Use\",\n    \"sampling_method\": \"Daily recordings from a single weather station\",\n    \"related_publications\": [],\n    \"download_url\": \"http://citya.gov/weatherdata\",\n    \"metadata\": {\n        \"data_size\": \"1MB\",\n        \"annotations\": \"Local weather history\"\n    }\n}"}
{"_id": "Academic--research_data--p--67645", "text": "{\n    \"dataset_name\": \"Global Monthly Precipitation and Temperature\",\n    \"creator\": {\n        \"name\": \"NOAA Climate Data Center\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Total Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Precipitation\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/precipitation_temperature.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67645", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Environmental Issues\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Social Science Research Lab\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"text\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Twitter API search using keywords\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Policy\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_sentiment.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Sentiment analysis performed using VADER algorithm\"\n    }\n}"}
{"_id": "Academic--research_data--p--67646", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, King's College London\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67646", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Project\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Rainforest\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Geographic coordinates provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--67647", "text": "{\n    \"dataset_name\": \"North Atlantic Ocean Temperature and Salinity Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Ship-based CTD casts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming Trends in the North Atlantic\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/north_atlantic_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67647", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-07-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Species identification confirmed by experts\"\n    }\n}"}
{"_id": "Academic--research_data--p--67648", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"United States Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
