{"_id": "Academic--research_data--n--70125", "text": "{\n    \"dataset_name\": \"UrbanAirQualityStudy\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2022-12-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pm25\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous monitoring stations throughout the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Centers\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Hourly measurements of air pollutants.\"\n    }\n}"}
