{"_id": "Academic--research_data--n--69806", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - 2022\",\n    \"creator\": {\n        \"name\": \"National Park Service\",\n        \"affiliation\": \"US Department of Interior\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_species\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"tree_height_m\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"diameter_cm\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in National Parks\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes species counts and measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69807", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"Global Mean Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Northern Hemisphere Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Southern Hemisphere Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Ocean Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Land-Ocean Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Confidence Interval Lower Bound\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Confidence Interval Upper Bound\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Uncertainty\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Region\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Season\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global average measurements from land and ocean surfaces.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Contains monthly and annual global temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69807", "text": "{\n    \"dataset_name\": \"Coral Reef Health Survey\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2022-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Reef Location\",\n            \"units\": \"latitude, longitude\"\n        },\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"kg/m^2\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Water Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Underwater visual surveys conducted by divers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Monitoring Program\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.aims.gov.au/data\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data from long-term monitoring of coral reef ecosystems.\"\n    }\n}"}
