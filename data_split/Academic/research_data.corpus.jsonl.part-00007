{"_id": "Academic--research_data--p--71747", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data - North Atlantic\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Autonomous Underwater Vehicle (AUV) transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Warming on Marine Biodiversity\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
