{"_id": "Academic--research_data--p--71702", "text": "{\n    \"dataset_name\": \"Atmospheric Pollutant Concentrations in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes hourly averages and geographical coordinates\"\n    }\n}"}
