{"_id": "Academic--research_data--n--68692", "text": "{\n    \"dataset_name\": \"Global Climate Model Output\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"NCAR\"\n    },\n    \"date_collected\": \"2021-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"K\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"Pa\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"K\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Cloud Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Climate model simulation, daily averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Model metadata included\"\n    }\n}"}
