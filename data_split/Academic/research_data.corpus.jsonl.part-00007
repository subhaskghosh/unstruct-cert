{"_id": "Academic--research_data--p--71196", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring_2023\",\n    \"creator\": {\n        \"name\": \"National Institute of Hydrology\",\n        \"affiliation\": \"Ministry of Environment, Forest and Climate Change, India\"\n    },\n    \"date_collected\": \"2023-06-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 20 river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": \"Sharma et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes quality control flags and location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71196", "text": "{\n    \"dataset_name\": \"OceanSalinityData_2022\",\n    \"creator\": {\n        \"name\": \"Marine Research Consortium\",\n        \"affiliation\": \"Coastal University\"\n    },\n    \"date_collected\": \"2022-12-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous measurements from a research vessel.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanic Salinity Variations in the North Atlantic\",\n            \"authors\": \"Silva et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity_2022.nc\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data processed with standard oceanographic algorithms.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71197", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations located throughout Greater London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes hourly averages and daily summaries.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71197", "text": "{\n    \"dataset_name\": \"Rural Ecosystem Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"National Park Service\",\n        \"affiliation\": \"Ecology Division\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Plant Biomass\",\n            \"units\": \"kg/m²\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random stratified sampling within national park boundaries.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment Report - Yellowstone\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://parks.gov/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes species identification and abundance estimates.\"\n    }\n}"}
