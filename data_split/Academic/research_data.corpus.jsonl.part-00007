{"_id": "Academic--research_data--p--71436", "text": "{\n    \"dataset_name\": \"Coastal Climate Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Automated Buoy Network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Impacts on Coastal Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included; sensor calibration information available.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71436", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Inventory\",\n    \"creator\": {\n        \"name\": \"Dr. Jian Li\",\n        \"affiliation\": \"National Forestry Institute\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"Forest Area\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite Imagery and Field Surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Sequestration in Tropical Forests\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes estimates of carbon stock.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71437", "text": "{\n    \"dataset_name\": \"Urban Microclimate Monitoring - NYC\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Columbia University, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at 5-minute intervals using automated sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/nyc_microclimate.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags for sensor accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71437", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Assessment\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"aboveground_biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"belowground_biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"carbon_stock\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing data combined with ground-based inventory measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment 2020\",\n            \"authors\": [\n                \"FAO\"\n            ],\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data derived from satellite imagery and statistical models.\"\n    }\n}"}
