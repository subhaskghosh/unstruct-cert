{"_id": "Academic--research_data--p--70812", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023-2024\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-01-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included, station locations provided in separate file.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70812", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Team\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect-based surveys conducted quarterly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"authors\": [\n                \"Garcia, L.\",\n                \"Brown, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Detailed species identification codes included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70813", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Report 2023\",\n            \"authors\": \"Schmidt, G.A. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/tabledata_v4/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Detailed documentation available at the GISS website. Contains data quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70813", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Amazon Basin\",\n    \"creator\": {\n        \"name\": \"INPE - National Institute for Space Research\",\n        \"affiliation\": \"Brazilian Government\"\n    },\n    \"date_collected\": \"2018-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees South\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees West\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Satellite-based rainfall estimates, daily data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in the Amazon\",\n            \"authors\": \"Silva, A. et al.\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_rainfall.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Basic metadata provided. No information on data quality or uncertainty.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70814", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"City University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers or less in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\",\n            \"description\": \"Nitrogen Dioxide concentration\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70814", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Forest Research Institute\",\n        \"affiliation\": \"National Parks Service\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"count\",\n            \"description\": \"Number of individual trees of each species\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\",\n            \"description\": \"Average height of trees\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of ground covered by tree canopy\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of National Forests\",\n            \"authors\": [\n                \"Jones, B.\",\n                \"Williams, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Geospatial coordinates included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70815", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global Gridded Data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global warming in the 21st century: An improved model prediction\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Recent changes in global temperature and their attribution\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes land and ocean surface temperatures.\"\n    }\n}"}
