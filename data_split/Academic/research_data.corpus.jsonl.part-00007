{"_id": "Academic--research_data--p--69545", "text": "{\n    \"dataset_name\": \"resting_state_fMRI_young_adults\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"subject_id\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"fMRI signal intensity\",\n            \"units\": \"Hz\"\n        },\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling of undergraduate students\",\n    \"related_publications\": [\n        {\n            \"title\": \"Resting-State Functional Connectivity in Young Adults\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/resting_state_fMRI.zip\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Datasets include structural and functional MRI scans.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69545", "text": "{\n    \"dataset_name\": \"EEG_sleep_stages\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"subject_id\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"EEG amplitude\",\n            \"units\": \"uV\"\n        },\n        {\n            \"name\": \"sleep_stage\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Convenience sampling of sleep clinic patients\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sleep Stage Classification Using EEG Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/EEG_sleep.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Datasets include EEG recordings during different sleep stages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69546", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global land and ocean surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
