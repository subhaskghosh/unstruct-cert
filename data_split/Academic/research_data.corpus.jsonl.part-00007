{"_id": "Academic--research_data--p--71203", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Dataset\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"aboveground_biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"belowground_biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"carbon_stock\",\n            \"units\": \"tonnes C/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping global forest carbon stocks\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/datasets/global-forest-carbon-stock/\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"High resolution, global coverage\"\n    }\n}"}
