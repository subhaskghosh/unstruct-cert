{"_id": "Academic--research_data--n--71542", "text": "{\n    \"dataset_name\": \"Global Soil Composition Data\",\n    \"creator\": {\n        \"name\": \"National Geographic Society\",\n        \"affiliation\": \"National Geographic\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Geospatial sampling, laboratory analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional variations in soil composition\",\n            \"authors\": [\n                \"C. Davis\",\n                \"D. Miller\"\n            ],\n            \"journal\": \"Geoderma\"\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Raw data from multiple sources.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71543", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"National Institute of Hydrology\",\n        \"affiliation\": \"Government Research Institute\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Conductivity\",\n            \"units\": \"µS/cm\"\n        },\n        {\n            \"name\": \"Nitrate\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Water Quality Trends in Major Rivers\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality assessed through automated checks and manual review.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71543", "text": "{\n    \"dataset_name\": \"AtmosphericPollutionData\",\n    \"creator\": {\n        \"name\": \"Individual Researcher\",\n        \"affiliation\": \"Independent\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NitrogenDioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"SulfurDioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"CO\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"WindSpeed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"WindDirection\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Timestamp\",\n            \"units\": \"UTC\"\n        },\n        {\n            \"name\": \"SensorID\",\n            \"units\": \"ID\"\n        },\n        {\n            \"name\": \"SensorType\",\n            \"units\": \"Type\"\n        },\n        {\n            \"name\": \"DataQualityFlag\",\n            \"units\": \"Flag\"\n        },\n        {\n            \"name\": \"DataValidity\",\n            \"units\": \"Boolean\"\n        },\n        {\n            \"name\": \"SampleRate\",\n            \"units\": \"Hz\"\n        },\n        {\n            \"name\": \"LocationType\",\n            \"units\": \"Type\"\n        },\n        {\n            \"name\": \"WeatherCondition\",\n            \"units\": \"Condition\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Continuous monitoring with automated sensors\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Raw data with minimal quality control.\"\n    }\n}"}
