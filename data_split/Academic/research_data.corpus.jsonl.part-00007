{"_id": "Academic--research_data--p--70861", "text": "{\n    \"dataset_name\": \"Coastal Atmospheric Composition Data - 2022\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Oceanographic Institute, University of California\"\n    },\n    \"date_collected\": \"2022-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous monitoring stations along the California coast.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atmospheric Changes on California Coastal Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data_2022.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70861", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Data - 2021\",\n    \"creator\": {\n        \"name\": \"Dr. David Brown\",\n        \"affiliation\": \"Forestry Research Institute\"\n    },\n    \"date_collected\": \"2021-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA-4.0\",\n    \"sampling_method\": \"Satellite remote sensing and field measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Estimates of Forest Carbon Stocks\",\n            \"authors\": [\n                \"Brown, D.\",\n                \"Smith, A.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass_2021.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data resolution: 30 meters.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70862", "text": "{\n    \"dataset_name\": \"Atmospheric Greenhouse Gas Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Greenhouse Gas Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/greenhouse_gas_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70862", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random forest plots in California\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in California Forests\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Species names are based on the Integrated Taxonomic Information System (ITIS).\"\n    }\n}"}
