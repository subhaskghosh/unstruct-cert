{"_id": "Academic--research_data--n--71958", "text": "{\n    \"dataset_name\": \"Coral Reef Ecosystem Survey\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Marine Biology Institute\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"kg/m²\"\n        },\n        {\n            \"name\": \"Water Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Climate Change on Coral Reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Species identification codes provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--71959", "text": "{\n    \"dataset_name\": \"Rural Air Quality Monitoring - Eastern US\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of North Carolina, Chapel Hill\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.  Measured using tapered element oscillating microbalance (TEOM) instruments, corrected for temperature and pressure. Reflects regional agricultural activity and long-range transport.\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration, measured using UV absorption spectrophotometry.  Influenced by atmospheric conditions and precursor emissions.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature, measured at 2 meters above ground level.  Affects chemical reaction rates and pollutant dispersion.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations with data logged hourly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Practices on Regional Air Quality\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rural_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71959", "text": "{\n    \"dataset_name\": \"Urban Traffic Pollution Study - London\",\n    \"creator\": {\n        \"name\": \"Dr. David Brown\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-07-20T09:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2 Concentration\",\n            \"units\": \"ppm\",\n            \"description\": \"Nitrogen Dioxide concentration.\"\n        },\n        {\n            \"name\": \"CO Concentration\",\n            \"units\": \"ppm\",\n            \"description\": \"Carbon Monoxide concentration.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Mobile monitoring using vehicle-mounted sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Traffic Pollution in London\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Brown, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_traffic.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"GPS coordinates included for each measurement.\"\n    }\n}"}
