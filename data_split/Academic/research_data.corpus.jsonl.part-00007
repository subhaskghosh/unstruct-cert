{"_id": "Academic--research_data--n--67364", "text": "{\n    \"dataset_name\": \"Regional Climate Model Projections - RCP8.5\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Climate Modeling Group\"\n    },\n    \"date_collected\": \"2022-01-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Projection\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation Projection\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations based on RCP8.5 scenario\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios for California\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_projections.nc\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Model output with uncertainty estimates.\"\n    }\n}"}
