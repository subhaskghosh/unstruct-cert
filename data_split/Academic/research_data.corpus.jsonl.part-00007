{"_id": "Academic--research_data--p--69010", "text": "{\n    \"dataset_name\": \"EEG Data of Cognitive Tasks\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Theta Power\",\n            \"units\": \"uV^2\"\n        },\n        {\n            \"name\": \"Alpha Power\",\n            \"units\": \"uV^2\"\n        },\n        {\n            \"name\": \"Beta Power\",\n            \"units\": \"uV^2\"\n        },\n        {\n            \"name\": \"Gamma Power\",\n            \"units\": \"uV^2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"High-density EEG recording during cognitive tasks.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Neural Oscillations and Cognitive Control\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/eeg_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Event-related potentials labeled for each task.\"\n    }\n}"}
