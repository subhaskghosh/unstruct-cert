{"_id": "Academic--research_data--n--68451", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Ocean Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite remote sensing and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Ocean Temperatures\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Brown, A.\"\n            ],\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temps.nc\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data processed for accuracy.\"\n    }\n}"}
