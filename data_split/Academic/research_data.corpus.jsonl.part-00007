{"_id": "Academic--research_data--p--71683", "text": "{\n    \"dataset_name\": \"European Lake Water Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"Helmholtz Centre for Environmental Research - UFZ\",\n        \"affiliation\": \"Germany\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular lake water sampling at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in European lake water quality\",\n            \"authors\": \"Smith et al.\"\n        }\n    ],\n    \"download_url\": \"https://example.com/european_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
