{"_id": "Academic--research_data--p--69088", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2022-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--69088", "text": "{\n    \"dataset_name\": \"Ocean Current Velocities\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ocean Current Velocity\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Argo floats and ship-based ADCP measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Surface Current Estimates\",\n            \"authors\": [\n                \"Susan Wijffels\",\n                \"Gregory Johnson\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/ocean-currents\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"High-resolution ocean current data\"\n    }\n}"}
