{"_id": "Academic--research_data--n--70959", "text": "{\n    \"dataset_name\": \"Corn Yield Analysis - Midwest Farms\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Miller\",\n        \"affiliation\": \"University of Illinois - Urbana Champaign, College of Agricultural, Consumer and Environmental Sciences\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Fertilizer Application\",\n            \"units\": \"kg/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Data collected from a survey of 200 farms.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Corn Yield with Nitrogen Fertilizers\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/corn_yield.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Yield data provided by farmers, verified by extension agents.\"\n    }\n}"}
