{"_id": "Academic--research_data--p--67498", "text": "{\n    \"dataset_name\": \"Coastal Erosion Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Oceanography\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Erosion Rate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"mm/year\"\n        },\n        {\n            \"name\": \"Wave Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular shoreline surveys using LiDAR and GPS.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Accelerated Coastal Erosion in the Pacific Northwest\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Includes data quality flags and metadata about survey conditions.\"\n    }\n}"}
