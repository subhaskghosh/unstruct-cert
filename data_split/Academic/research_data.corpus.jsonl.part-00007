{"_id": "Academic--research_data--n--71193", "text": "{\n    \"dataset_name\": \"North Atlantic Marine Ecosystem Survey\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-10-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Plankton Density\",\n            \"units\": \"cells/mL\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ship-based surveys with CTD casts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in North Atlantic plankton communities\",\n            \"authors\": [\n                \"Brown, C.\",\n                \"Davis, E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/northatlantic_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data is subject to specific usage restrictions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71194", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--71194", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Carbon Flux\",\n    \"creator\": {\n        \"name\": \"University of Washington Atmospheric Sciences\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2022-11-01T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol/m²/s\"\n        },\n        {\n            \"name\": \"Water Vapor Flux\",\n            \"units\": \"mmol/m²/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Eddy covariance measurements in a remote forest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Dynamics in Pacific Northwest Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.json\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Raw data with minimal processing\"\n    }\n}"}
{"_id": "Academic--research_data--p--71195", "text": "{\n    \"dataset_name\": \"Long-Term River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors with weekly manual validation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
