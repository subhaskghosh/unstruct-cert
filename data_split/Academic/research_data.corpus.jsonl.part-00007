{"_id": "Academic--research_data--p--66989", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"National Institute of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"units\": \"file path\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"units\": \"binary (positive/negative)\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_pneumonia\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Radiologist-verified labels\"\n    }\n}"}
{"_id": "Academic--research_data--n--66989", "text": "{\n    \"dataset_name\": \"MRI Brain Tumor Segmentation\",\n    \"creator\": {\n        \"name\": \"University of California, San Francisco\",\n        \"affiliation\": \"UCSF Radiology Department\"\n    },\n    \"date_collected\": \"2022-11-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"units\": \"file path\"\n        },\n        {\n            \"name\": \"tumor_location\",\n            \"units\": \"anatomical region\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective study with IRB approval\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Expert neuro-radiologist annotations\"\n    }\n}"}
{"_id": "Academic--research_data--p--66990", "text": "{\n    \"dataset_name\": \"LIDC-IDRI Lung Nodule Dataset\",\n    \"creator\": {\n        \"name\": \"The Cancer Imaging Archive (TCIA)\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Series UID\",\n            \"units\": \"DICOM Identifier\"\n        },\n        {\n            \"name\": \"Nodule Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Nodule Malignancy\",\n            \"units\": \"Binary (0 or 1)\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 3.0\",\n    \"sampling_method\": \"Multi-center retrospective study\",\n    \"related_publications\": [\n        {\n            \"title\": \"The LIDC-IDRI database: a comprehensive resource for lung nodule detection\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://www.cancerimagingarchive.net/collections/lIDC-IDRI\",\n    \"metadata\": {\n        \"data_size\": \"1.5 TB\",\n        \"annotations\": \"Radiologist annotations for nodule localization and characterization\"\n    }\n}"}
{"_id": "Academic--research_data--n--66990", "text": "{\n    \"dataset_name\": \"CardioMRI Dataset\",\n    \"creator\": {\n        \"name\": \"University of Michigan\",\n        \"affiliation\": \"Department of Radiology\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Left Ventricle Volume\",\n            \"units\": \"ml\"\n        },\n        {\n            \"name\": \"Ejection Fraction\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Prospective study of patients with heart failure\",\n    \"related_publications\": [\n        {\n            \"title\": \"Cardiac MRI for assessment of heart failure\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://example.com/cardioMRI\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Segmentation masks of the left ventricle\"\n    }\n}"}
{"_id": "Academic--research_data--p--66991", "text": "{\n    \"dataset_name\": \"Brain MRI Segmentation Dataset\",\n    \"creator\": {\n        \"name\": \"Medical Imaging Research Group\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"pixel_spacing\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"image_intensity\",\n            \"units\": \"arbitrary units\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective MRI scans of healthy volunteers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation using Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Segmentation masks for tumor regions\"\n    }\n}"}
{"_id": "Academic--research_data--n--66991", "text": "{\n    \"dataset_name\": \"Chest X-ray Pneumonia Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Data Consortium\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"patient_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"image_resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"variable_name\": \"diagnosis\",\n            \"units\": \"binary (pneumonia/no pneumonia)\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection in Chest X-rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Pneumonia labels\"\n    }\n}"}
{"_id": "Academic--research_data--p--66992", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Monthly temperature anomalies\"\n    }\n}"}
