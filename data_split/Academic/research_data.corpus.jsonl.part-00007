{"_id": "Academic--research_data--p--71281", "text": "{\n    \"dataset_name\": \"Urban Temperature Monitoring - NYC\",\n    \"creator\": {\n        \"name\": \"Columbia University Data Science Institute\",\n        \"affiliation\": \"Columbia University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Latitude, Longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Hourly measurements from street-level sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Energy Consumption\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/nyc_temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71281", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2018-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Forest Density\",\n            \"units\": \"Trees per Hectare\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Annual surveys of forest plots.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/forest_health_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Limited documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71282", "text": "{\n    \"dataset_name\": \"Atmospheric Carbon Dioxide Concentrations - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring at global stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2022\",\n            \"authors\": [\n                \"Friedlingstein, P.\",\n                \"O'Sullivan, M.\",\n                \"Jones, M.W.\",\n                \"Andrew, R.M.\",\n                \"Haskins, R.\",\n                \"Marland, G.\",\n                \"Peters, G.P.\",\n                \"Le Quéré, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://gmd.data.gov/data/co2-global\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality controlled data, missing values flagged.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71282", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity - Great Barrier Reef\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"Marine Ecology Program\"\n    },\n    \"date_collected\": \"2022-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees South\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coral Reefs\",\n            \"authors\": [\n                \"Hughes, T.P.\",\n                \"Kerry, J.T.\",\n                \"Alvarez-Romero, J.G.\",\n                \"Anderson, K.D.\",\n                \"Baird, A.H.\",\n                \"Connell, S.D.\",\n                \"Dietzel, A.\",\n                \"Eakin, C.M.\",\n                \"Franklin, E.C.\",\n                \"Kroon, F.J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.aims.gov.au/coral-biodiversity\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Species identification verified by expert taxonomists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71283", "text": "{\n    \"dataset_name\": \"RiverWaterQualityData_2022\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 designated sites along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality_2022.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71283", "text": "{\n    \"dataset_name\": \"GlobalClimateModelOutputs\",\n    \"creator\": {\n        \"name\": \"International Climate Research Group\",\n        \"affiliation\": \"Various Institutions\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"GlobalAverageTemperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"SeaLevelRise\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"PrecipitationRate\",\n            \"units\": \"mm/year\"\n        },\n        {\n            \"name\": \"OceanAcidity\",\n            \"units\": \"pH\"\n        },\n        {\n            \"name\": \"IceSheetMassBalance\",\n            \"units\": \"Gigatonnes\"\n        },\n        {\n            \"name\": \"AtmosphericPressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"WindSpeed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"SolarRadiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"CloudCover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Output from a complex climate model run.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Projections\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_outputs.nc\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Model outputs at various spatial resolutions.\"\n    }\n}"}
