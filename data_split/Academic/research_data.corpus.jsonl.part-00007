{"_id": "Academic--research_data--p--67496", "text": "{\n    \"dataset_name\": \"Global Carbon Emissions Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions (metric tons)\",\n            \"unit\": \"metric tons\"\n        },\n        {\n            \"name\": \"Methane Emissions (kg)\",\n            \"unit\": \"kg\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Emissions (kg)\",\n            \"unit\": \"kg\"\n        },\n        {\n            \"name\": \"Deforestation Rate\",\n            \"unit\": \"% of land area\"\n        },\n        {\n            \"name\": \"Ocean Acidification Level\",\n            \"unit\": \"pH\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budgets 2023\",\n            \"authors\": [\n                \"Friedlingstein et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/carbon_emissions.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Includes data quality flags and uncertainty estimates.\"\n    }\n}"}
