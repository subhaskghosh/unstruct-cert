{"_id": "Academic--research_data--p--66178", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global grid cell averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/tabledata_v4/\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Monthly and annual temperature data\"\n    }\n}"}
{"_id": "Academic--research_data--n--66178", "text": "{\n    \"dataset_name\": \"Historical Weather Data - London\",\n    \"creator\": {\n        \"name\": \"UK Meteorological Office\",\n        \"affiliation\": \"Government Agency\"\n    },\n    \"date_collected\": \"2019-01-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Non-Commercial License\",\n    \"sampling_method\": \"Hourly measurements at specific stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Climate Report\",\n            \"authors\": [\n                \"John Smith\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.metoffice.gov.uk/londonweather/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Hourly weather data for London\"\n    }\n}"}
{"_id": "Academic--research_data--p--66179", "text": "{\n    \"dataset_name\": \"Resting-State fMRI Dataset - Healthy Adults\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"fMRI_signal\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"gender\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random sampling of healthy adult volunteers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Resting-State Functional Connectivity in Healthy Adults\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/fmri_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data preprocessed with SPM12\"\n    }\n}"}
{"_id": "Academic--research_data--n--66179", "text": "{\n    \"dataset_name\": \"EEG Sleep Study - Children\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Boston Children's Hospital\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"EEG_alpha\",\n            \"units\": \"microvolts\"\n        },\n        {\n            \"name\": \"sleep_stage\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Convenience sampling of children undergoing sleep studies.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sleep Patterns in Children with ADHD\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/eeg_sleep.csv\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data filtered and artifact removed\"\n    }\n}"}
{"_id": "Academic--research_data--p--66180", "text": "{\n    \"dataset_name\": \"Urban Air Quality Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Science Department\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
