{"_id": "Academic--research_data--p--70767", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - California\",\n    \"creator\": {\n        \"name\": \"California State Water Resources Control Board\",\n        \"affiliation\": \"California EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Bacteria Count\",\n            \"units\": \"CFU/100mL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular water sample collection at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"California Coastal Water Quality Monitoring Program Annual Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/california_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70767", "text": "{\n    \"dataset_name\": \"Houston Ship Channel Oil Spill Response Data\",\n    \"creator\": {\n        \"name\": \"US Coast Guard\",\n        \"affiliation\": \"Department of Homeland Security\"\n    },\n    \"date_collected\": \"2023-05-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Oil Slick Area\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Oil Type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Containment Boom Length\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Skimmer Capacity\",\n            \"units\": \"barrels/hour\"\n        },\n        {\n            \"name\": \"Weather Conditions\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Response Team Size\",\n            \"units\": \"personnel\"\n        },\n        {\n            \"name\": \"Water Current Speed\",\n            \"units\": \"knots\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Real-time monitoring during spill response operations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of the Houston Ship Channel Oil Spill\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/houston_oil_spill.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data is preliminary and subject to change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70768", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Surface Temperature\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Quality controlled temperature data\"\n    }\n}"}
