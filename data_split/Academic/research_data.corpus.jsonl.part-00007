{"_id": "Academic--research_data--n--68421", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery (GLAD)\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Change\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_change.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is classified into different forest types.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68422", "text": "{\n    \"dataset_name\": \"Local Air Quality Monitoring - City Park\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at a fixed location within the city park.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Greenspace on Local Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_park.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data quality checked and outliers removed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68422", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Earth Sciences\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Water Vapor\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite-based remote sensing of atmospheric composition.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Cycle Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_atmosphere.nc\",\n    \"metadata\": {\n        \"data_size\": \"15GB\",\n        \"annotations\": \"Level 2 data product, processed using standard NASA algorithms.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68423", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_Urban\",\n    \"creator\": {\n        \"name\": \"Environmental Sciences Lab, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring with calibrated sensors. Controlled experiments introducing pollutant sources.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_urban.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data has been quality-controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68423", "text": "{\n    \"dataset_name\": \"ForestEcosystemHealth\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"USDA\"\n    },\n    \"date_collected\": \"2018-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeDensity\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"SpeciesDiversity\",\n            \"units\": \"Shannon Index\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random forest plots with observational data collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Forest Health\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/foresthealth.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Species classifications verified by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68424", "text": "{\n    \"dataset_name\": \"USGS National Water Quality Assessment Program Data\",\n    \"creator\": {\n        \"name\": \"United States Geological Survey\",\n        \"affiliation\": \"USGS\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Systematic sampling from fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Surface Water Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/nwis/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68424", "text": "{\n    \"dataset_name\": \"Industrial Effluent Discharge Records - Rhine River\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Cadmium Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Lead Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Mercury Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Mandatory reporting by industrial facilities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Report on Industrial Pollution in the Rhine River Basin\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.eea.europa.eu/data-and-maps/data/industrial-effluent-discharge\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data identifies specific polluting sources.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68425", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Concentration Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite measurements and ground-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68425", "text": "{\n    \"dataset_name\": \"Historical Rainfall Patterns in Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Data Centre\",\n        \"affiliation\": \"ECADC\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Rainfall Variability\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/european_rainfall.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Station metadata included\"\n    }\n}"}
{"_id": "Academic--research_data--p--68426", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Concentration Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"co2_concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"location\",\n            \"unit\": \"latitude, longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68426", "text": "{\n    \"dataset_name\": \"Climate Change Public Perception Survey\",\n    \"creator\": {\n        \"name\": \"Pew Research Center\",\n        \"affiliation\": \"Social & Demographic Research\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"awareness\",\n            \"unit\": \"scale 1-7\"\n        },\n        {\n            \"name\": \"concern\",\n            \"unit\": \"scale 1-7\"\n        },\n        {\n            \"name\": \"political_affiliation\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Nationwide telephone survey\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Attitudes Toward Climate Change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/public_perception.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Demographic weighting applied.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68427", "text": "{\n    \"dataset_name\": \"Lake Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Freshwater Research Institute\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from various locations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in lake water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68427", "text": "{\n    \"dataset_name\": \"Coastal Marine Ecosystem Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-08-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous measurements from research vessels along the coastline.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of climate change on coastal ecosystems\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_ecosystem.csv\",\n    \"metadata\": {\n        \"data_size\": \"3.1MB\",\n        \"annotations\": \"Data has been pre-processed and corrected for sensor drift.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68428", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Science Department, University of California, Berkeley\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of less than 2.5 micrometers.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\",\n            \"description\": \"Relative humidity of the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations globally distributed.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global trends in air pollution and health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68428", "text": "{\n    \"dataset_name\": \"Local Pollen Counts - Boston\",\n    \"creator\": {\n        \"name\": \"Boston Allergy Clinic\",\n        \"affiliation\": \"Boston Allergy Clinic\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Birch Pollen\",\n            \"unit\": \"grains/m³\"\n        },\n        {\n            \"name\": \"Ragweed Pollen\",\n            \"unit\": \"grains/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Daily pollen trap counts from a single location in Boston.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/pollen_boston.json\",\n    \"metadata\": {\n        \"data_size\": \"20 MB\",\n        \"annotations\": \"None.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68429", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Regular sampling at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68429", "text": "{\n    \"dataset_name\": \"Global River Discharge Data\",\n    \"creator\": {\n        \"name\": \"University of New Hampshire\",\n        \"affiliation\": \"Earth Systems Research Center\"\n    },\n    \"date_collected\": \"2018-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Discharge\",\n            \"units\": \"m3/s\"\n        },\n        {\n            \"name\": \"Water Level\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite-based observations and gauge data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating global river discharge using remote sensing\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_discharge_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data includes uncertainties.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68430", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Weekly grab samples collected from various depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68430", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"NASA Earth Exchange\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"variable_name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite remote sensing data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping global forest biomass using LiDAR\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forestbiomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Processed data with spatial resolution of 30m.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68431", "text": "{\n    \"dataset_name\": \"North American Forest Plant Biodiversity Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of British Columbia\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_name\",\n            \"units\": \"scientific name\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"decimal degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"decimal degrees\"\n        },\n        {\n            \"name\": \"plant_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"stem_diameter\",\n            \"units\": \"centimeters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 50 forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in North American forests\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_plant_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags and species identification confidence levels.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68431", "text": "{\n    \"dataset_name\": \"Urban Birdsong Recordings\",\n    \"creator\": {\n        \"name\": \"David Lee\",\n        \"affiliation\": \"City Wildlife Society\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"bird_species\",\n            \"units\": \"common name\"\n        },\n        {\n            \"name\": \"recording_duration\",\n            \"units\": \"seconds\"\n        },\n        {\n            \"name\": \"sound_pressure_level\",\n            \"units\": \"dB\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Opportunistic recordings in urban parks\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of urbanization on bird vocalizations\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_bird_recordings.zip\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Recordings are annotated with species identification, but may contain background noise.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68432", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation Anomaly\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Global gridded data based on station observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/anomalies/\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68432", "text": "{\n    \"dataset_name\": \"High-Resolution Land Cover Map\",\n    \"creator\": {\n        \"name\": \"European Space Agency (ESA)\",\n        \"affiliation\": \"ESA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Cover Type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Red Band Reflectance\",\n            \"units\": \"reflectance\"\n        },\n        {\n            \"name\": \"Green Band Reflectance\",\n            \"units\": \"reflectance\"\n        },\n        {\n            \"name\": \"Blue Band Reflectance\",\n            \"units\": \"reflectance\"\n        },\n        {\n            \"name\": \"NIR Band Reflectance\",\n            \"units\": \"reflectance\"\n        },\n        {\n            \"name\": \"SWIR Band Reflectance\",\n            \"units\": \"reflectance\"\n        },\n        {\n            \"name\": \"NDVI\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-SA 3.0\",\n    \"sampling_method\": \"Satellite imagery analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Land Cover Mapping\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://landcover.esa.int/\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"High-resolution land cover data for global coverage.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68433", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environment Canada\",\n        \"affiliation\": \"Canadian Department of Environment and Climate Change\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular sampling at fixed stations throughout the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68433", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentrations Global\",\n    \"creator\": {\n        \"name\": \"NOAA Global Monitoring Laboratory\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2021-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at remote stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global carbon cycle trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68434", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - Chesapeake Bay\",\n    \"creator\": {\n        \"name\": \"Chesapeake Bay Program\",\n        \"affiliation\": \"US Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen (mg/L)\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity (PSU)\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Discrete water samples collected weekly at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Chesapeake Bay Water Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chesapeake_bay_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68434", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane (ppb)\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"NASA Open Data Policy\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Cycle\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_atmosphere.nc\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data processed to Level 2.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68435", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring - USA\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"unit\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at various river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of River Water Quality Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Includes quality control flags for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68435", "text": "{\n    \"dataset_name\": \"Laboratory Analysis of Water Samples\",\n    \"creator\": {\n        \"name\": \"University Research Lab\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Iron Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Copper Concentration\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Water samples analyzed in a controlled laboratory environment.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Metal Ions on Water\",\n            \"authors\": [\n                \"Brown, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lab_water_analysis.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Results from laboratory experiments.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68436", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023-2024\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68436", "text": "{\n    \"dataset_name\": \"Regional Climate Model Output - UK 2024\",\n    \"creator\": {\n        \"name\": \"Met Office Hadley Centre\",\n        \"affiliation\": \"UKRI\"\n    },\n    \"date_collected\": \"2024-01-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Regional Climate Model Simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios for the UK\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/uk_climate_model.nc\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Model output at 12km resolution.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68437", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature and Salinity Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanographic Centre\",\n        \"affiliation\": \"University of Southampton\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Argo floats and ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Heat Content Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68437", "text": "{\n    \"dataset_name\": \"Regional Air Quality Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Particulate Matter\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data from major metropolitan areas\"\n    }\n}"}
{"_id": "Academic--research_data--p--68438", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"Hadley Centre for Climate Prediction and Research\",\n        \"affiliation\": \"UK Met Office\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of meteorological stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature trends since the industrial revolution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Temperature anomalies relative to the 1961-1990 average\"\n    }\n}"}
{"_id": "Academic--research_data--n--68438", "text": "{\n    \"dataset_name\": \"Public Opinion on Climate Change Policies\",\n    \"creator\": {\n        \"name\": \"Pew Research Center\",\n        \"affiliation\": \"Pew Charitable Trusts\"\n    },\n    \"date_collected\": \"2022-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Political Affiliation\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Concern about Climate Change\",\n            \"units\": \"Likert Scale\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Nationwide telephone survey\",\n    \"related_publications\": [\n        {\n            \"title\": \"American Attitudes on Climate Change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/opinion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Survey responses on climate change attitudes\"\n    }\n}"}
{"_id": "Academic--research_data--p--68439", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-10T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags and sensor calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68439", "text": "{\n    \"dataset_name\": \"Oceanographic Data - Coastal Regions\",\n    \"creator\": {\n        \"name\": \"Marine Research Institute\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-01-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ship-based sampling with monthly measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Currents and Marine Ecosystems\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes sensor calibration and processing steps.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68440", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"University of Michigan Water Science Group\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Regular sampling from 10 fixed locations across the lake, monthly intervals.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags and metadata about sampling location and depth.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68440", "text": "{\n    \"dataset_name\": \"Global River Discharge Rates\",\n    \"creator\": {\n        \"name\": \"Global Runoff Data Centre\",\n        \"affiliation\": \"Federal Institute for Hydrology\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"River Discharge\",\n            \"units\": \"m^3/s\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Aggregated data from various national hydrological services.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/global_rivers.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes information about river basin and catchment area.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68441", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68441", "text": "{\n    \"dataset_name\": \"Industrial Emissions - Ruhr Area\",\n    \"creator\": {\n        \"name\": \"German Federal Environment Agency\",\n        \"affiliation\": \"Department of Industrial Pollution Control\"\n    },\n    \"date_collected\": \"2024-03-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2\",\n            \"unit\": \"mg/m³\",\n            \"description\": \"Sulfur dioxide emissions\"\n        },\n        {\n            \"name\": \"NOx\",\n            \"unit\": \"mg/m³\",\n            \"description\": \"Nitrogen oxide emissions\"\n        },\n        {\n            \"name\": \"CO\",\n            \"unit\": \"mg/m³\",\n            \"description\": \"Carbon monoxide emissions\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Periodic stack testing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Emission Control Technologies\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ruhr_emissions.xml\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Complex emission factor calculations\"\n    }\n}"}
{"_id": "Academic--research_data--p--68442", "text": "{\n    \"dataset_name\": \"Global Soil Moisture Dataset - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"soil_moisture\",\n            \"units\": \"m3/m3\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"In-situ measurements from soil sensors distributed across diverse terrestrial biomes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Soil Moisture on Vegetation Growth\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_moisture_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
