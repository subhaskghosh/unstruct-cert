{"_id": "Academic--research_data--p--71991", "text": "{\n    \"dataset_name\": \"Global Precipitation and Temperature Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Satellite observations with ground station verification\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71991", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow Dataset\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2021-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"traffic_volume\",\n            \"units\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"average_speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Loop detectors and traffic cameras\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Mobility Patterns\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/traffic_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Contains anonymized vehicle IDs.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71992", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - V4\",\n    \"creator\": {\n        \"name\": \"James Hansen and colleagues\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Land Area\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"variable_name\": \"Ocean Area\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"variable_name\": \"Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Surface Temperature Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"High resolution, comprehensive data for climate modeling.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71992", "text": "{\n    \"dataset_name\": \"Historical Weather Records - City of London\",\n    \"creator\": {\n        \"name\": \"London Environmental Agency\",\n        \"affiliation\": \"City of London Corporation\"\n    },\n    \"date_collected\": \"2018-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"variable_name\": \"Rainfall\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution License\",\n    \"sampling_method\": \"Daily measurements at various locations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/london_weather\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Local weather data for London.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71993", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"National Center for Environmental Assessment\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/national-water-quality-monitoring-database\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71993", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Measurements\",\n    \"creator\": {\n        \"name\": \"City University Research Group\",\n        \"affiliation\": \"Department of Environmental Sciences\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at roadside locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Areas\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"http://cityresearch.edu/airdata\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is preliminary and subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71994", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"National Institute of Environmental Health Sciences\",\n        \"affiliation\": \"NIEHS\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Distance to nearest road\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71994", "text": "{\n    \"dataset_name\": \"Ocean Temperature Profiles\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"WHOI\"\n    },\n    \"date_collected\": \"2023-08-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming and its Impacts\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/oceantempdata.nc\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data calibrated with standard procedures\"\n    }\n}"}
{"_id": "Academic--research_data--p--71995", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations strategically located throughout London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71995", "text": "{\n    \"dataset_name\": \"Rural Forest Ecosystem Study\",\n    \"creator\": {\n        \"name\": \"University of Montana Ecology Lab\",\n        \"affiliation\": \"University of Montana\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random plot sampling in Montana forests\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Ecosystem Dynamics\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data collected during summer months.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71996", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Greenhouse Gas Concentrations\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Harvard University, Department of Earth and Planetary Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across North America\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Greenhouse Gas Concentrations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71996", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NOAA Oceanographic Research Division\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2022-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Ocean Heat Content\",\n            \"units\": \"Joules\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming and Climate Change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2 GB\",\n        \"annotations\": \"Data is gap-filled using interpolation\"\n    }\n}"}
{"_id": "Academic--research_data--p--71997", "text": "{\n    \"dataset_name\": \"Freshwater Lake Monitoring - 2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Environmental Science\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Grab samples collected weekly from multiple points in the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71997", "text": "{\n    \"dataset_name\": \"Coastal Oceanographic Data - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous measurements from a buoy.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Currents and Marine Life Distribution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data has been filtered for noise.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71998", "text": "{\n    \"dataset_name\": \"BrainMRI-Resolution\",\n    \"creator\": {\n        \"name\": \"Stanford Medical Imaging Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_resolution_x\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"image_resolution_y\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"slice_thickness\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Prospective MRI scans of healthy volunteers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"High-Resolution Brain MRI Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brainmri-resolution.zip\",\n    \"metadata\": {\n        \"data_size\": \"320MB\",\n        \"annotations\": \"Segmentation masks for brain regions provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71998", "text": "{\n    \"dataset_name\": \"ChestXRay-Pneumonia\",\n    \"creator\": {\n        \"name\": \"Radiology Associates Inc.\",\n        \"affiliation\": \"Private Practice\"\n    },\n    \"date_collected\": \"2023-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"image_height\",\n            \"units\": \"pixels\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pneumonia Detection using Chest X-Rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chestxray-pneumonia.zip\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Binary labels indicating presence or absence of pneumonia.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71999", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of River Water Quality on Public Health in Coastal Communities\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71999", "text": "{\n    \"dataset_name\": \"AtmosphericPollutionData\",\n    \"creator\": {\n        \"name\": \"Robert Davis\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-11-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Pollution in Urban Areas\",\n            \"authors\": [\n                \"Davis, R.\",\n                \"Brown, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data is pre-processed but lacks detailed documentation.\"\n    }\n}"}
