{"_id": "Academic--research_data--p--71867", "text": "{\n    \"dataset_name\": \"Freshwater Lake Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Agency\",\n        \"affiliation\": \"State University Research Lab\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regularly spaced sampling locations around the lake perimeter.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Trends in Freshwater Lakes\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71867", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Data - Coastal Regions\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"National Oceanography Centre\"\n    },\n    \"date_collected\": \"2023-11-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Seawater Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ship-based sampling along coastal transects.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Marine Biodiversity Assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data calibrated to standard oceanographic profiles.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71868", "text": "{\n    \"dataset_name\": \"Lake Monitoring Dataset - 2022\",\n    \"creator\": {\n        \"name\": \"Environmental Sciences Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated sensor buoys deployed across the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Water Quality Trends in Lake Merced\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags indicate potential sensor malfunctions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71868", "text": "{\n    \"dataset_name\": \"Global Soil Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Global Land Institute\",\n        \"affiliation\": \"Harvard University\"\n    },\n    \"date_collected\": \"2018-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Soil core samples collected from various global locations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71869", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"University Corporation for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Greenhouse Gas Concentrations\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes quality control flags and uncertainty estimates for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71869", "text": "{\n    \"dataset_name\": \"Pacific Ocean Temperature Records\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Coastal Research Foundation\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming in the Pacific\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71870", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, University of California, Berkeley\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Mixed: Automated sensors supplemented by manual validation samples.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71870", "text": "{\n    \"dataset_name\": \"Global Sea Level Change\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Level Anomaly\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Fully automated satellite altimetry.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Sea Level\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/sea_level_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is gridded and interpolated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71871", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"variable_name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in parts per billion.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed throughout Greater London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71871", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon\",\n    \"creator\": {\n        \"name\": \"University of São Paulo\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"NDVI\",\n            \"units\": \"dimensionless\",\n            \"description\": \"Normalized Difference Vegetation Index.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground-based surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon Rainforest\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data includes metadata about sensor calibration.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71872", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from 50 river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of River Water Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71872", "text": "{\n    \"dataset_name\": \"GlobalOceanSalinityData\",\n    \"creator\": {\n        \"name\": \"National Oceanographic Centre\",\n        \"affiliation\": \"University of Southampton\"\n    },\n    \"date_collected\": \"2022-11-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Continuous measurements from research vessels and buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Variability of Ocean Salinity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity.nc\",\n    \"metadata\": {\n        \"data_size\": \"40MB\",\n        \"annotations\": \"Data has been processed to remove outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71873", "text": "{\n    \"dataset_name\": \"Urban Heat Island Effect - Seattle\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, Department of Atmospheric Sciences\"\n    },\n    \"date_collected\": \"2023-05-10T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"Percentage\"\n        },\n        {\n            \"name\": \"Land Cover Type\",\n            \"unit\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random stratified sampling across urban and suburban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Local Climate\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_heat_island_seattle.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71873", "text": "{\n    \"dataset_name\": \"Forest Birdsong Recordings - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"unit\": \"Categorical\"\n        },\n        {\n            \"name\": \"Recording Duration\",\n            \"unit\": \"Seconds\"\n        },\n        {\n            \"name\": \"Location Coordinates\",\n            \"unit\": \"Latitude/Longitude\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Opportunistic recordings at various locations within the rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Acoustic Monitoring of Amazonian Birdlife\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_birdsong.zip\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Recordings are labeled with identified bird species.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71874", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"species_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"variable_name\": \"timestamp\",\n            \"units\": \"ISO 8601\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Automated tracking via GPS loggers attached to birds.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Migration Patterns of North American Birds\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data includes quality control flags for GPS accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71874", "text": "{\n    \"dataset_name\": \"Australian Reef Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"James Cook University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"coral_cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"variable_name\": \"water_temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Underwater visual surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coral Reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/reef_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes metadata about survey locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71875", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover - Boston\",\n    \"creator\": {\n        \"name\": \"City of Boston GIS Department\",\n        \"affiliation\": \"Boston Municipality\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_canopy_coverage\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"tree_species\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"Shapefile\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"LiDAR remote sensing\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/boston_tree_canopy.zip\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Dataset contains data on urban tree canopy cover in Boston, MA.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71875", "text": "{\n    \"dataset_name\": \"Global Climate Model Output - CMIP6\",\n    \"creator\": {\n        \"name\": \"CMIP6 Collaboration\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm/day\"\n        },\n        {\n            \"name\": \"sea_level_pressure\",\n            \"unit\": \"Pascal\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Climate modelling simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Model Documentation\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/cmip6_data.tar.gz\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Global climate model output from the CMIP6 project.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71876", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Map 2021\",\n    \"creator\": {\n        \"name\": \"University of Maryland, Global Forest Watch\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"carbon_stock\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"name\": \"forest_cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"biomass\",\n            \"units\": \"tons\"\n        },\n        {\n            \"name\": \"leaf_area_index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"aboveground_biomass\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"name\": \"belowground_biomass\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"name\": \"carbon_emissions_avoided\",\n            \"units\": \"tons CO2e\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing using satellite imagery (Landsat, Sentinel)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global maps of forest carbon stocks and change\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_map.tif\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data processed with standard quality control procedures.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71876", "text": "{\n    \"dataset_name\": \"Global Economic Impact of Climate Change\",\n    \"creator\": {\n        \"name\": \"World Bank\",\n        \"affiliation\": \"World Bank\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"gdp_loss\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"agricultural_yield_change\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"infrastructure_damage\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"employment_impact\",\n            \"units\": \"number of jobs\"\n        },\n        {\n            \"name\": \"inflation_rate\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Economic modeling and statistical analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Economic Costs of Climate Change\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/economic_impact.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Model outputs based on various climate scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71877", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Limnology Department\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Discrete water samples collected from various depths using a Van Dorn sampler.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71877", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Deforestation - Satellite Imagery\",\n    \"creator\": {\n        \"name\": \"National Institute for Space Research (INPE)\",\n        \"affiliation\": \"Brazilian Government\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Normalized Difference Vegetation Index (NDVI)\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Forest Cover Percentage\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Remote sensing data acquired by Landsat 8 satellite.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation patterns in the Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_deforestation.tif\",\n    \"metadata\": {\n        \"data_size\": \"60MB\",\n        \"annotations\": \"Pre-processed satellite images.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71878", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular interval sampling at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71878", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Environmental Monitoring Center\",\n        \"affiliation\": \"Beijing Municipality\"\n    },\n    \"date_collected\": \"2022-12-20T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality assessment in a megacity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71879", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network - Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information\",\n        \"affiliation\": \"NOAA/NCEI\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TMAX\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"TMIN\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"PRCP\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature trends and their impacts\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71879", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis - Political Opinions\",\n    \"creator\": {\n        \"name\": \"Data Insights Lab\",\n        \"affiliation\": \"TechCorp Inc.\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Topic\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Twitter API streaming\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Opinion on Political Issues\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://techcorp.com/datasets/sentiment\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Preprocessed text data\"\n    }\n}"}
{"_id": "Academic--research_data--p--71880", "text": "{\n    \"dataset_name\": \"Global Water Quality Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Agency\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Conductivity\",\n            \"units\": \"uS/cm\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling from rivers and lakes worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--71880", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Major Cities\",\n    \"creator\": {\n        \"name\": \"City Air Quality Consortium\",\n        \"affiliation\": \"Various Municipalities\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_dataset.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data contains missing values and outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71881", "text": "{\n    \"dataset_name\": \"CardioMRI Segmentation Challenge Dataset\",\n    \"creator\": {\n        \"name\": \"The Medical Imaging Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-06-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"slice_thickness\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"heart_volume\",\n            \"units\": \"cm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective collection from clinical MRI scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Segmentation of the Heart in MRI\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/cardio_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"3.5GB\",\n        \"annotations\": \"Manual segmentations provided by expert radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--71881", "text": "{\n    \"dataset_name\": \"Dermatological Image Dataset\",\n    \"creator\": {\n        \"name\": \"The Dermatology Research Team\",\n        \"affiliation\": \"University of California, Irvine\"\n    },\n    \"date_collected\": \"2023-09-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"disease_type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"severity\",\n            \"units\": \"ordinal scale\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Collection from dermatology clinic patients\",\n    \"related_publications\": [\n        {\n            \"title\": \"Image-Based Diagnosis of Skin Diseases\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/dermatology_images\",\n    \"metadata\": {\n        \"data_size\": \"7GB\",\n        \"annotations\": \"Diagnosis labels provided by dermatologists\"\n    }\n}"}
{"_id": "Academic--research_data--p--71882", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers or less in diameter\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppm\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71882", "text": "{\n    \"dataset_name\": \"Water Quality Assessment of Rivers\",\n    \"creator\": {\n        \"name\": \"Hydrological Survey Group\",\n        \"affiliation\": \"National Water Agency\"\n    },\n    \"date_collected\": \"2023-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Amount of dissolved oxygen in water\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"units\",\n            \"description\": \"Acidity or alkalinity of water\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Grab samples collected monthly\",\n    \"related_publications\": [\n        {\n            \"title\": \"River Water Quality Trends\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71883", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regularly spaced buoy measurements and ship-based surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71883", "text": "{\n    \"dataset_name\": \"Textile Mill Effluent Analysis\",\n    \"creator\": {\n        \"name\": \"Advanced Environmental Solutions Inc.\",\n        \"affiliation\": \"Private Consultancy\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"BOD5\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Dye Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Grab samples from effluent discharge pipes.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/textile_effluent.json\",\n    \"metadata\": {\n        \"data_size\": \"350MB\",\n        \"annotations\": \"Data represents effluent only.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71884", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Temperature anomalies relative to the 1951-1980 base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71884", "text": "{\n    \"dataset_name\": \"Historical Weather Records - 1900-2010\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2010-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Station-based observations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Comprehensive historical weather data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71885", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing using Landsat data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Provides data on global forest cover change.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71885", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Pacific Marine Environmental Laboratory\"\n    },\n    \"date_collected\": \"2022-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"dissolved_oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean acidification and its impacts\",\n            \"year\": 2015\n        }\n    ],\n    \"download_url\": \"https://www.pmel.noaa.gov/oa/disclaimer\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Contains ocean pH and dissolved oxygen measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71886", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Science Department, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Alice Johnson\",\n                \"Bob Williams\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes timestamps, location coordinates, and sensor IDs.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71886", "text": "{\n    \"dataset_name\": \"Human Genome Project Data\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Genome Sequence\",\n            \"units\": \"Base Pairs\"\n        }\n    ],\n    \"data_format\": \"FASTA\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Whole Genome Sequencing\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Human Genome\",\n            \"authors\": [\n                \"Francis Collins\",\n                \"Eric Lander\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/genome_data.fasta\",\n    \"metadata\": {\n        \"data_size\": \"2TB\",\n        \"annotations\": \"Complete human genome sequence data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71887", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Lab\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard pH units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"NitrateConcentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"PhosphateConcentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular sampling from 10 river locations, monthly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"35MB\",\n        \"annotations\": \"Data has been quality-controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71887", "text": "{\n    \"dataset_name\": \"IndustrialWastewaterAnalysis\",\n    \"creator\": {\n        \"name\": \"AquaTech Solutions\",\n        \"affiliation\": \"Private Environmental Consulting Firm\"\n    },\n    \"date_collected\": \"2019-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ChemicalOxygenDemand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"BiologicalOxygenDemand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"TotalSuspendedSolids\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Spot samples collected from industrial discharge points.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://aquatechsolutions.com/wastewater_data.json\",\n    \"metadata\": {\n        \"data_size\": \"60MB\",\n        \"annotations\": \"Data is raw and may contain errors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71888", "text": "{\n    \"dataset_name\": \"UrbanAirQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Urban Research Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
