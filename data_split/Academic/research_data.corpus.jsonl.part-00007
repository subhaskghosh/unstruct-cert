{"_id": "Academic--research_data--p--66641", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ImageID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"PatientAge\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"TumorGrade\",\n            \"units\": \"I-IV\"\n        },\n        {\n            \"name\": \"ImageType\",\n            \"units\": \"T1-weighted, T2-weighted, FLAIR\"\n        },\n        {\n            \"name\": \"ImageResolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"TumorLocation\",\n            \"units\": \"brain region\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Prospective, hospital-based study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/braintumor_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Manual segmentation by expert radiologists\"\n    }\n}"}
