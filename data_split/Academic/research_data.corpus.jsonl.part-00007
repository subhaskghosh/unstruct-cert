{"_id": "Academic--research_data--p--67432", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A Comprehensive Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes monthly averages and annual trends.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67432", "text": "{\n    \"dataset_name\": \"Historical Weather Data - 1980-2010\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather station readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Variability in the 20th Century\",\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data contains daily temperature and precipitation records.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67433", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"University Corporation for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67433", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Department of Agriculture\",\n        \"affiliation\": \"Ministry of Food and Resources\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"crop_yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"fertilizer_use\",\n            \"units\": \"kg/hectare\"\n        },\n        {\n            \"name\": \"irrigation_water\",\n            \"units\": \"cubic meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Farm surveys and government records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Agricultural Productivity in the 21st Century\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data cleaned for outliers\"\n    }\n}"}
{"_id": "Academic--research_data--p--67434", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        },\n        {\n            \"name\": \"Sensor Model\",\n            \"units\": \"string\",\n            \"description\": \"Model of the air quality sensor used.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67434", "text": "{\n    \"dataset_name\": \"Forest Biodiversity - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of species observed in a plot.\"\n        },\n        {\n            \"name\": \"Basal Area\",\n            \"units\": \"m²/ha\",\n            \"description\": \"Total cross-sectional area of trees in a plot.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://amazonresearch.org/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes species identification information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67435", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/land_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"High-quality, gap-filled data using kriging interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67435", "text": "{\n    \"dataset_name\": \"Pacific Ocean Marine Ecosystem Data\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Lab\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2022-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Currents\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected during research cruises.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67436", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\",\n            \"description\": \"Concentration of nitrogen dioxide\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67436", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - 2023\",\n    \"creator\": {\n        \"name\": \"Forestry Department\",\n        \"affiliation\": \"State Government of Oregon\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\",\n            \"description\": \"Number of trees per hectare\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\",\n            \"description\": \"Measure of the foliage density\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of water in the soil\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Carbon Sequestration in Oregon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes measurements from various forest types.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67437", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"U.S. Department of Commerce\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global Surface Temperature Network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes annual and monthly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67437", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Amazon Basin\",\n    \"creator\": {\n        \"name\": \"Amazon Research Institute\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2018-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Rainfall\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0\",\n    \"sampling_method\": \"Rain Gauge Network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in the Amazon\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data collected from various locations within the Amazon rainforest.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67438", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"World Air Quality Index (WAQI)\",\n        \"affiliation\": \"WAQI Inc.\"\n    },\n    \"date_collected\": \"2023-02-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Air Pollution Levels\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67438", "text": "{\n    \"dataset_name\": \"Local Pollen Count Dataset\",\n    \"creator\": {\n        \"name\": \"Allergy Research Group\",\n        \"affiliation\": \"University of Springfield\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Birch Pollen\",\n            \"units\": \"grains/m³\"\n        },\n        {\n            \"name\": \"Ragweed Pollen\",\n            \"units\": \"grains/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Daily pollen traps\",\n    \"related_publications\": [\n        {\n            \"title\": \"Seasonal Allergy Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/pollen.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Pollen type classifications\"\n    }\n}"}
{"_id": "Academic--research_data--p--67439", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67439", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather reports from various stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Some missing data points.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67440", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Science Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less, measured in micrograms per cubic meter (µg/m³). Determined using a tapered element oscillating microbalance (TEOM) analyzer.\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"description\": \"Ground-level ozone concentration, measured in parts per billion (ppb). Determined using UV photometric method.\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"description\": \"Ambient air temperature, measured in degrees Celsius (°C) using a calibrated thermistor.\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67440", "text": "{\n    \"dataset_name\": \"Soil Moisture Levels\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Institute\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"SoilMoisture\",\n            \"description\": \"Soil moisture content.\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"description\": \"Temperature\",\n            \"units\": \"C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random sampling at different locations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/soil_moisture.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is raw and may contain errors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67441", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Change 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Earth Exchange\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Change in Biomass\",\n            \"units\": \"tonnes/hectare/year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite LiDAR and Optical Data Fusion\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global assessment of forest biomass change\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass_2021-2023.tif\",\n    \"metadata\": {\n        \"data_size\": \"15 GB\",\n        \"annotations\": \"Includes quality flags for data accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67441", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 1980-2024\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of weather stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"2 MB\",\n        \"annotations\": \"Monthly average temperature anomalies relative to the 20th-century average.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67442", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GSTA)\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of land and ocean observing stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/gsta/v5/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67442", "text": "{\n    \"dataset_name\": \"Forest Canopy Height in Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Elena Rodriguez\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"LiDAR remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Rainforest Structure\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest_data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Includes data from multiple LiDAR flights.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67443", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change - North America\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across North America\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of CO2 on Regional Climate Patterns\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_na.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"The dataset is suitable for high school and undergraduate level educational projects focusing on climate change.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67443", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch Team\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Tree Cover Density\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"Gross Tree Cover Loss\",\n            \"units\": \"hectares/year\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Change\",\n            \"authors\": [\n                \"Hansen, M.\",\n                \"Potapov, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.geojson\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"This dataset focuses on deforestation patterns and may be more appropriate for advanced research than introductory education.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67444", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 different locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67444", "text": "{\n    \"dataset_name\": \"ForestBirdsongRecordings\",\n    \"creator\": {\n        \"name\": \"Ornithology Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Recording Duration\",\n            \"units\": \"seconds\"\n        },\n        {\n            \"name\": \"Signal Strength\",\n            \"units\": \"dB\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous recording using automated sound recorders placed in forest habitats.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Birdsong Diversity in California Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/birdsong_recordings.zip\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Recordings have been manually annotated with bird species.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67445", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TMAX\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"TMIN\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"PRCP\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Daily Temperature Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcnd/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67445", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis - Climate Change\",\n    \"creator\": {\n        \"name\": \"Data Insights Inc.\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2021-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Post Text\",\n            \"units\": \"Text\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted - Academic Use Only\",\n    \"sampling_method\": \"Twitter API scraping\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis of Climate Change Discourse\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.datainsights.com/climate_sentiment\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"User demographics available upon request\"\n    }\n}"}
{"_id": "Academic--research_data--p--67446", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Global sensor network and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67446", "text": "{\n    \"dataset_name\": \"Historical Crop Yields 1980-2010\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Institute\",\n        \"affiliation\": \"University of Illinois\"\n    },\n    \"date_collected\": \"2010-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Farm surveys and government reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Crop Production\",\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields_1980_2010.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Limited metadata available\"\n    }\n}"}
{"_id": "Academic--research_data--p--67447", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"description\": \"Concentration of ozone in the air.\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Nitrogen Dioxide\",\n            \"description\": \"Concentration of nitrogen dioxide.\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations throughout London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67447", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Study - Amazon\",\n    \"creator\": {\n        \"name\": \"University of Sao Paulo Biodiversity Lab\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species Richness\",\n            \"description\": \"Number of different species observed.\",\n            \"units\": \"count\"\n        },\n        {\n            \"variable_name\": \"Tree Height\",\n            \"description\": \"Average height of trees in a plot.\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Species identification confirmed by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67448", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67448", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2021-12-31T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"No data quality information\"\n    }\n}"}
{"_id": "Academic--research_data--p--67449", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"surface_temperature\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Monthly average surface temperature anomalies.\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees North\",\n            \"description\": \"Latitude of measurement location.\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees East\",\n            \"description\": \"Longitude of measurement location.\"\n        },\n        {\n            \"variable_name\": \"altitude\",\n            \"units\": \"meters\",\n            \"description\": \"Altitude of measurement station.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Updated Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\",\n                \"Pushker Kharecha\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags are included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67449", "text": "{\n    \"dataset_name\": \"Historical Weather Records - 1990s\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"1995-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"variable_name\": \"precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"Text\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Limited regional weather stations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/historical_weather_data.txt\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data may contain missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67450", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Quality on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data is cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67450", "text": "{\n    \"dataset_name\": \"Forest Birdsong Recordings\",\n    \"creator\": {\n        \"name\": \"Ornithological Society\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Recording Duration\",\n            \"units\": \"seconds\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Field recordings using directional microphones\",\n    \"related_publications\": [\n        {\n            \"title\": \"Birdsong Diversity in Temperate Forests\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/birdsong_recordings.zip\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Recordings are labeled with species identification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67451", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        },\n        {\n            \"name\": \"Measurement Uncertainty\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of weather stations and sea buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A Comprehensive Analysis\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Quality controlled and homogenized temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67451", "text": "{\n    \"dataset_name\": \"Regional Rainfall Patterns in Africa\",\n    \"creator\": {\n        \"name\": \"African Climate Research Institute\",\n        \"affiliation\": \"University of Nairobi\"\n    },\n    \"date_collected\": \"2019-08-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Rain gauge measurements from select locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Variability in Eastern Africa\",\n            \"authors\": [\n                \"Mwangi, P.\",\n                \"Ochieng, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/africa_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Preliminary rainfall data; may contain inconsistencies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67452", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 1990 to 2000\",\n            \"authors\": [\n                \"Hansen\",\n                \"et al.\"\n            ],\n            \"year\": 2000\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2000_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains information on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67452", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Ecology and Environment Bureau\",\n        \"affiliation\": \"Beijing Government\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Restricted Access\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Air Pollution in Beijing\",\n            \"authors\": [\n                \"Wang\",\n                \"et al.\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"http://example.com/beijing_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Real-time air quality data collected from various stations in Beijing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67453", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Contains monthly temperature anomalies from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67453", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species Richness\",\n            \"units\": \"number of species\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees South\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in coral reef biodiversity\",\n            \"authors\": [\n                \"David Hughes\",\n                \"Terry Done\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.aims.gov.au/data\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data on coral reef biodiversity along the Great Barrier Reef.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67454", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes monthly average temperature anomalies. High resolution data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67454", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Africa\",\n    \"creator\": {\n        \"name\": \"World Bank\",\n        \"affiliation\": \"Development Research Group\"\n    },\n    \"date_collected\": \"2018-01-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Station-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in Africa\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/africa_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Daily rainfall measurements from select African stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67455", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - v4\",\n    \"creator\": {\n        \"name\": \"Hadley Centre\",\n        \"affiliation\": \"UK Met Office\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global network of meteorological stations and sea-based observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global surface temperature variations in 2023\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/gsat_v4.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67455", "text": "{\n    \"dataset_name\": \"Projected Climate Change Scenarios - RCP8.5\",\n    \"creator\": {\n        \"name\": \"IPCC AR6 Working Group I\",\n        \"affiliation\": \"Intergovernmental Panel on Climate Change\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Projection\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation Projection\",\n            \"units\": \"mm/year\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA 3.0\",\n    \"sampling_method\": \"Climate model simulations using RCP8.5 emissions scenario.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change 2021: The Physical Science Basis\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/rcp85_projections.nc\",\n    \"metadata\": {\n        \"data_size\": \"1GB\",\n        \"annotations\": \"Model outputs with ensemble members.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67456", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Concentrations - ICOS\",\n    \"creator\": {\n        \"name\": \"ICOS Carbon Portal\",\n        \"affiliation\": \"Integrated Carbon Observation System\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous measurements from fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Integrated Carbon Observation System (ICOS) - A European Infrastructure for Carbon Cycle Science\",\n            \"authors\": [\n                \"Haszpra et al.\"\n            ],\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.icos-cp.eu/data\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67456", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - UK Met Office\",\n    \"creator\": {\n        \"name\": \"UK Met Office\",\n        \"affiliation\": \"UK Government\"\n    },\n    \"date_collected\": \"2019-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Open Government Licence\",\n    \"sampling_method\": \"Daily readings from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"UK Climate Projections\",\n            \"authors\": [\n                \"Sexton et al.\"\n            ],\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://www.metoffice.gov.uk/research/data\",\n    \"metadata\": {\n        \"data_size\": \"5 GB\",\n        \"annotations\": \"Data includes quality control information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67457", "text": "{\n    \"dataset_name\": \"Global Forest Change Data\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Provides information about forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67457", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA GISS\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Surface temperature measurements from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature trends\",\n            \"authors\": \"Hansen, J.\",\n            \"year\": 2006\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Monthly global surface temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67458", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (COVID-19)\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"COVID-19 Status\",\n            \"units\": \"Boolean\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective cohort study of patients admitted with respiratory symptoms.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Development and Evaluation of a Deep Learning System for COVID-19 Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://nihcc.nih.gov/chestxray\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Radiologist-verified bounding boxes for pneumonia and COVID-19.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67458", "text": "{\n    \"dataset_name\": \"Brain MRI Scans (Healthy Controls)\",\n    \"creator\": {\n        \"name\": \"University of California, San Francisco\",\n        \"affiliation\": \"UCSF Brain Imaging Center\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Sequence\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Participant Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Gender\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Random sampling of healthy volunteers from the San Francisco Bay Area.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Normal Brain MRI Variability\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://ucsf.edu/brainmri\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"No specific annotations provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67459", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (COVID-19)\",\n    \"creator\": {\n        \"name\": \"Daniel Kermany\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"pneumonia\",\n            \"units\": \"binary (0/1)\"\n        },\n        {\n            \"variable_name\": \"covid_19\",\n            \"units\": \"binary (0/1)\"\n        },\n        {\n            \"variable_name\": \"image_file\",\n            \"units\": \"file path\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Retrospective collection from public sources\",\n    \"related_publications\": [\n        {\n            \"title\": \"Learning COVID-19 from Chest X-ray Images\",\n            \"authors\": [\n                \"Kermany\",\n                \"Zhang\",\n                \"Goldstein\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://github.com/ieee80211/covid-chestxray-dataset\",\n    \"metadata\": {\n        \"data_size\": \"1892 MB\",\n        \"annotations\": \"Expert radiologist annotations\"\n    }\n}"}
{"_id": "Academic--research_data--n--67459", "text": "{\n    \"dataset_name\": \"Mammography Images for Tumor Detection\",\n    \"creator\": {\n        \"name\": \"Anna Smith\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"patient_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"image_quality\",\n            \"units\": \"categorical (good, fair, poor)\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Research Use Only\",\n    \"sampling_method\": \"Prospective clinical trial\",\n    \"related_publications\": [\n        {\n            \"title\": \"Improved Tumor Detection in Mammography\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\",\n                \"Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/mammography_dataset\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Radiologist reports\"\n    }\n}"}
{"_id": "Academic--research_data--p--67460", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67460", "text": "{\n    \"dataset_name\": \"Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Cornell University\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Bird Migration\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes observations from volunteer birdwatchers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67461", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global station data, gridded\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Contains monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67461", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Climate Change\",\n    \"creator\": {\n        \"name\": \"Data Insights Lab\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"text\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Twitter API stream\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Action\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": null,\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Sentiment analysis results on climate-related tweets.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67462", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"variable_name\": \"Anomaly\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded dataset, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Updated Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"High temporal resolution data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67462", "text": "{\n    \"dataset_name\": \"Local Weather Observations - Springfield\",\n    \"creator\": {\n        \"name\": \"Springfield Community Weather Station\",\n        \"affiliation\": \"Local Volunteers\"\n    },\n    \"date_collected\": \"2019-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Manual readings taken daily\",\n    \"related_publications\": [],\n    \"download_url\": \"http://springfieldweather.org/data.json\",\n    \"metadata\": {\n        \"data_size\": \"1MB\",\n        \"annotations\": \"Limited data coverage.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67463", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality-controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67463", "text": "{\n    \"dataset_name\": \"Remote Sensing of Forest Biomass - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute for Space Research (INPE)\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass Density\",\n            \"units\": \"tonnes/hectare\",\n            \"description\": \"Estimate of above-ground biomass density.\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\",\n            \"description\": \"Measure of the leaf area per unit ground area.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis (Landsat, Sentinel)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biomass Estimation in Amazonia\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Derived from remotely sensed data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67464", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Agency\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution and Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data has been quality controlled and verified.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67464", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data may contain some missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67465", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global network of land and ocean-based weather stations, satellite measurements, and data assimilation techniques. Data is quality-controlled and homogenized using established best practices.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: 2021-2023 Update\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes uncertainty estimates and metadata regarding station quality.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67465", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns in Amazon Basin\",\n    \"creator\": {\n        \"name\": \"University of Sao Paulo\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2019-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"GPS coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Opportunistic rainfall measurements collected by researchers during field expeditions. Limited quality control procedures.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Variability in the Amazon\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data represents a small subset of the Amazon basin.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67466", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Environmental Sciences Department, Imperial College London\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data quality checked and missing values imputed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67466", "text": "{\n    \"dataset_name\": \"GlobalForestryData\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Division\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"forest_area\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"tree_species\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"biomass\",\n            \"units\": \"tonnes\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing and ground surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/global_forests.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data derived from satellite imagery and national reports.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67467", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - NOAA\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"LandAvgTemp\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"OceanAvgTemp\",\n            \"units\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-temperature-report/\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Dataset includes monthly and annual temperature anomalies, land and ocean average temperatures, and uncertainty estimates.  Full provenance tracking documented. Comprehensive data quality flags provided.\",\n        \"data_quality\": \"High\"\n    }\n}"}
{"_id": "Academic--research_data--n--67467", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Kenya\",\n    \"creator\": {\n        \"name\": \"Kenya Meteorological Department\",\n        \"affiliation\": \"Government of Kenya\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Rain gauge measurements from regional stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.kmd.go.ke/data/\",\n    \"metadata\": {\n        \"data_size\": \"500KB\",\n        \"annotations\": \"Basic rainfall measurements. Limited documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67468", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NCEI\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnomalies\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"PrecipitationAnomalies\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"SeaLevelPressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"WindSpeed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface observations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Summaries\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-temperature-report/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes monthly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67468", "text": "{\n    \"dataset_name\": \"Local Weather Patterns - City X\",\n    \"creator\": {\n        \"name\": \"City X Meteorological Office\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2019-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted - Non-Commercial Use Only\",\n    \"sampling_method\": \"Local weather station measurements\",\n    \"related_publications\": [],\n    \"download_url\": \"http://cityx.gov/weatherdata\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data from a single weather station.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67469", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change - Global\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research (NCAR)\"\n    },\n    \"date_collected\": \"2022-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of ground-based and satellite measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric Greenhouse Gases\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_global.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Includes quality control flags and data uncertainties.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67469", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - North America\",\n    \"creator\": {\n        \"name\": \"Robert Miller\",\n        \"affiliation\": \"State University of New York\"\n    },\n    \"date_collected\": \"2018-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Weather stations across North America\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Variability in North America\",\n            \"authors\": [\n                \"Miller, R.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data_na.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data is missing for some locations during certain periods.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67470", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2021\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2021-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percentage\",\n            \"description\": \"Percentage of tree cover in the year 2000.\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\",\n            \"description\": \"Year of forest loss.\"\n        },\n        {\n            \"variable_name\": \"gain\",\n            \"units\": \"hectares\",\n            \"description\": \"Area of forest gain.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing analysis of Landsat imagery.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\",\n                \"Hooijer\",\n                \"Krabbenhoeft\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2021_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Global coverage, 30m resolution\"\n    }\n}"}
{"_id": "Academic--research_data--n--67470", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"Met Office Hadley Centre\",\n        \"affiliation\": \"UK Met Office\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"mean_temperature\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Average global surface temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government License v3.0\",\n    \"sampling_method\": \"Global network of meteorological stations and sea-surface temperature measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global climate models and temperature trends\",\n            \"authors\": [\n                \"Jones\",\n                \"Dyer\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.metoffice.gov.uk/hadobs/hadcrut5/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Monthly global average temperature data\"\n    }\n}"}
{"_id": "Academic--research_data--p--67471", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67471", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Botanical Society of America\",\n        \"affiliation\": \"National Geographic Society\"\n    },\n    \"date_collected\": \"2024-01-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Name of the plant species.\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\",\n            \"description\": \"Height of the tree.\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\",\n            \"description\": \"Diameter of the tree trunk at breast height.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random sampling plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Plant Diversity in Temperate Forests\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geographic coordinates included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67472", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"World Air Quality Index (WAQI)\",\n        \"affiliation\": \"WAQI Inc.\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Assessment of Air Pollution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes daily averages and hourly measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67472", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns in Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Data Centre (ECADC)\",\n        \"affiliation\": \"ECADC Research Group\"\n    },\n    \"date_collected\": \"2018-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Reanalysis of historical weather station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Variability in Europe\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data covers the period 1950-2017.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67473", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Michigan, School of Environment and Sustainability\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"variable_name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors deployed at fixed locations, with monthly manual sample collection for validation.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakeerie_wq_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included; sensor calibration information available.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67473", "text": "{\n    \"dataset_name\": \"Urban Air Quality Survey\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Mobile monitoring units driven along major roadways.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://citydata.gov/airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data is preliminary and subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67474", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (COVID-19)\",\n    \"creator\": {\n        \"name\": \"Daniel Freedman\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_file\",\n            \"description\": \"Path to the chest X-ray image file.\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"image_resolution\",\n            \"description\": \"Resolution of the X-ray image in pixels (width x height).\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"variable_name\": \"covid_status\",\n            \"description\": \"Indicates whether the patient has COVID-19 (positive/negative).\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Retrospective review of hospital records.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for COVID-19 Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chestxray_covid19.zip\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Image-level labels indicating COVID-19 status.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67474", "text": "{\n    \"dataset_name\": \"Skin Lesion Analysis Dataset\",\n    \"creator\": {\n        \"name\": \"Anna Schmidt\",\n        \"affiliation\": \"University of Heidelberg\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_file\",\n            \"description\": \"Path to the skin lesion image.\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"diagnosis\",\n            \"description\": \"Diagnosis of the skin lesion (melanoma, nevus, etc.).\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JPG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Dermatological clinic data collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Skin Cancer Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/skinlesions.zip\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Diagnosis labels for each image.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67475", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67475", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"National Geographic Society\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Identified tree species in the survey area\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\",\n            \"description\": \"Height of the tree\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Tropical Forests\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Wilson, E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geographic coordinates included\"\n    }\n}"}
{"_id": "Academic--research_data--p--67476", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67476", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"Number of individuals\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Research vessel transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity in Deep Sea Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species identification codes included\"\n    }\n}"}
{"_id": "Academic--research_data--p--67477", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Surface Temperature\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--67477", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Southeast Asia\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"University of Tokyo\"\n    },\n    \"date_collected\": \"2018-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Location ID\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Rain gauge network across Southeast Asia\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in Southeast Asia\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data_sea.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data quality assessed by regional meteorological agencies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67478", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67478", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa Department of Agriculture\",\n        \"affiliation\": \"State of Iowa\"\n    },\n    \"date_collected\": \"2019-07-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"crop_type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"county\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Annual surveys of farms in Iowa.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Iowa Agriculture\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/iowa_crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Missing data handled with imputation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67479", "text": "{\n    \"dataset_name\": \"Coastal Temperature Trends\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"air_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated buoy network with monthly readings.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Warming Trends in the North Atlantic\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67479", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of Forestry\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"tree_diameter\",\n            \"units\": \"centimeters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random plot sampling in forested areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Temperate Forests\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geographic coordinates included for each plot.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67480", "text": "{\n    \"dataset_name\": \"Water Quality Monitoring in the Chesapeake Bay\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Maryland Center for Environmental Science\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at 10 fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Chesapeake Bay water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chesapeake_bay_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
