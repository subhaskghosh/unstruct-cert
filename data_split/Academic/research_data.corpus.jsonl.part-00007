{"_id": "Academic--research_data--p--70852", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2020-2023\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Gridded monthly mean temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70852", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns 1980-2000\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2000-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Variations\",\n            \"year\": 1995\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Daily weather observations from a network of stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70853", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Monthly global temperature anomaly relative to a 1951-1980 baseline.\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Latitude of the measurement.\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Longitude of the measurement.\"\n        },\n        {\n            \"name\": \"MeasurementQuality\",\n            \"units\": \"scale of 1-5\",\n            \"description\": \"Quality rating for the temperature measurement, with 5 being the highest quality.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station measurements and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A Comprehensive Analysis\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains data quality flags and metadata about data processing.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70853", "text": "{\n    \"dataset_name\": \"Rainfall Patterns in the Amazon\",\n    \"creator\": {\n        \"name\": \"Instituto Nacional de Pesquisas da Amazônia (INPA)\",\n        \"affiliation\": \"Brazilian National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\",\n            \"description\": \"Daily rainfall amount.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Data collected from a network of weather stations in the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Rainforest Hydrology\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Oliveira, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Includes station metadata and data processing details.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70854", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
