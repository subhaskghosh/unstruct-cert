{"_id": "Academic--research_data--p--71853", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Emily Carter\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"ug/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Weekly grab samples from multiple locations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_mendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Detailed sampling location information provided.\"\n    }\n}"}
