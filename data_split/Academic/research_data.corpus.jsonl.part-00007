{"_id": "Academic--research_data--p--71915", "text": "{\n    \"dataset_name\": \"Terrestrial Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"TreeHeight\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"CanopyCover\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"SpeciesRichness\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Random stratified sampling within 1km x 1km grids\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Deforestation on Amazonian Biodiversity\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification based on visual surveys.\"\n    }\n}"}
