{"_id": "Academic--research_data--p--68516", "text": "{\n    \"dataset_name\": \"Coastal Climate Impact Assessment Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"United States Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Air Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Level\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite and buoy measurements, combined with coastal station data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Climate Change on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes data quality flags and metadata about measurement locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68516", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns in the Midwest\",\n    \"creator\": {\n        \"name\": \"Midwest Regional Climate Center\",\n        \"affiliation\": \"University of Illinois\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily High Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Daily Low Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations throughout the Midwest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Midwestern Weather\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/midwest_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes station IDs and metadata about the stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68517", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_California\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"OzoneConcentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"ParticulateMatter2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"WaterTemperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations throughout California\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Wildfires on Air Quality in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_ca.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68517", "text": "{\n    \"dataset_name\": \"ForestBiodiversity_Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeSpecies\",\n            \"units\": \"species name\"\n        },\n        {\n            \"name\": \"TreeDiameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"TreeHeight\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forestbio_amazon.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data includes species identification and measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68518", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68518", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Center\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"number\",\n            \"description\": \"Number of individuals of a specific marine species.\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\",\n            \"description\": \"Depth of the observation.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys using remotely operated vehicles.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Marine Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Expert-verified species identification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68519", "text": "{\n    \"dataset_name\": \"UrbanAirQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO_concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"PM2.5_concentration\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations throughout the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68519", "text": "{\n    \"dataset_name\": \"RuralForestEcosystemData\",\n    \"creator\": {\n        \"name\": \"Forestry Department\",\n        \"affiliation\": \"State University of Oregon\"\n    },\n    \"date_collected\": \"2024-01-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree_Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Soil_Moisture\",\n            \"units\": \"percent\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Species identification included\"\n    }\n}"}
{"_id": "Academic--research_data--p--68520", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"United States Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_precip.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68520", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"wheat_yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"rice_yield\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"National agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Security\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Yield estimates based on reported data\"\n    }\n}"}
{"_id": "Academic--research_data--p--68521", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research (INPA)\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"unit\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified random sampling across 50 plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term ecological changes in central Amazonia\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68521", "text": "{\n    \"dataset_name\": \"London Air Quality Data\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Network\"\n    },\n    \"date_collected\": \"2023-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"NO2 Concentration\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"O3 Concentration\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Government License v3.0\",\n    \"sampling_method\": \"Continuous monitoring at 50 stations across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in London Air Pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Real-time data updates available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68522", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Forest Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Aboveground Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote Sensing - Landsat imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen, M.C.\",\n                \"Potapov, P.V.\",\n                \"Moore, R.\",\n                \"Houthuyzen, K.M.\",\n                \"Leo, F.E.\",\n                \"Tymoshenko, A.\",\n                \"Troshina, S.\",\n                \"Zhang, Y.\",\n                \"Plotnikova, A.\",\n                \"Shvidenko, A.\",\n                \"Sulla-Menashe, D.\",\n                \"Brakenridge, G.R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"250 GB\",\n        \"annotations\": \"Provides annual forest cover loss and gain data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68522", "text": "{\n    \"dataset_name\": \"ERA5 Atmospheric Reanalysis Data\",\n    \"creator\": {\n        \"name\": \"ECMWF\",\n        \"affiliation\": \"European Centre for Medium-Range Weather Forecasts\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"K\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Geopotential\",\n            \"units\": \"m^2/s^2\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-SA 3.0\",\n    \"sampling_method\": \"Atmospheric model reanalysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"The ERA5 reanalysis\",\n            \"authors\": [\n                \"Hersbach, H.\",\n                \"Bell, W.L.\",\n                \"Peubey, C.\",\n                \"Saerbekken, F.\",\n                \"Schepers, S.H.\",\n                \"Simmonds, P.\",\n                \"Vitart, F.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://cds.climate.copernicus.eu/cdsapp/cdsid/c3s-climate-copernicus-reanalysis-era5/\",\n    \"metadata\": {\n        \"data_size\": \"10 TB\",\n        \"annotations\": \"Comprehensive atmospheric data for reanalysis purposes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68523", "text": "{\n    \"dataset_name\": \"European Lake Water Quality Monitoring 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"University of Oxford, UK\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from designated points in 50 lakes across Europe.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in European lake water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/european_lakes_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality controlled and validated by the University of Oxford environmental science team.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68523", "text": "{\n    \"dataset_name\": \"US River Monitoring Data 2022-2023\",\n    \"creator\": {\n        \"name\": \"Dr. John Smith\",\n        \"affiliation\": \"US Geological Survey\"\n    },\n    \"date_collected\": \"2022-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"E. coli Count\",\n            \"units\": \"CFU/100mL\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring using automated sensors in major US rivers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing water quality in US river systems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/us_river_data.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data processed and analyzed by the US Geological Survey.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68524", "text": "{\n    \"dataset_name\": \"Beijing Air Quality Data\",\n    \"creator\": {\n        \"name\": \"Li Wei\",\n        \"affiliation\": \"Tsinghua University\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 10 micrometers or less.\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"unit\": \"ppm\",\n            \"description\": \"Concentration of sulfur dioxide.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"unit\": \"ppm\",\n            \"description\": \"Concentration of nitrogen dioxide.\"\n        },\n        {\n            \"name\": \"O3\",\n            \"unit\": \"ppm\",\n            \"description\": \"Concentration of ozone.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution in Beijing: Trends and Health Impacts\",\n            \"authors\": [\n                \"Li Wei\",\n                \"Zhang Hong\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68524", "text": "{\n    \"dataset_name\": \"River Water Quality\",\n    \"creator\": {\n        \"name\": \"Elena Ramirez\",\n        \"affiliation\": \"University of Barcelona\"\n    },\n    \"date_collected\": \"2023-10-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\",\n            \"description\": \"Acidity of the water.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Water temperature.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Discrete water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Assessment in the Llobregat River\",\n            \"authors\": [\n                \"Elena Ramirez\",\n                \"Garcia Perez\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68525", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68525", "text": "{\n    \"dataset_name\": \"Soil Composition Analysis - Agricultural Fields\",\n    \"creator\": {\n        \"name\": \"AgriData Solutions\",\n        \"affiliation\": \"Private Agricultural Company\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen\",\n            \"units\": \"ppm\",\n            \"description\": \"Nitrogen content in the soil.\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"ppm\",\n            \"description\": \"Phosphorus content in the soil.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Random sampling across agricultural fields\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68526", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Monitoring Data - Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensors and mobile monitoring vans.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68526", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2022-12-20T15:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Tree Diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"GNU General Public License v3.0\",\n    \"sampling_method\": \"Random sampling of forest plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Species identification confirmed by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68527", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research (INPA)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Forest Canopy Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Average Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in the Amazon Rainforest\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Coordinates for sampling locations are provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68527", "text": "{\n    \"dataset_name\": \"Urban Air Quality Data - London\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"London Environmental Agency\"\n    },\n    \"date_collected\": \"2021-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous Monitoring Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"authors\": [\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from fixed monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68528", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples collected at multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality in Lake Mendota\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_mendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
