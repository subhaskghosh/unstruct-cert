{"_id": "Academic--research_data--p--70796", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global warming in the twenty-first century: an inconvenient truth\",\n            \"authors\": [\n                \"Al Gore\"\n            ],\n            \"year\": 2006\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"High-resolution temperature data from 1880 to present\"\n    }\n}"}
{"_id": "Academic--research_data--n--70796", "text": "{\n    \"dataset_name\": \"Regional Precipitation Patterns\",\n    \"creator\": {\n        \"name\": \"Maria Rodriguez\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Rain gauge measurements, daily totals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of climate variability on regional water resources\",\n            \"authors\": [\n                \"Rodriguez, M.\",\n                \"Jones, P.\"\n            ],\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/precipitation_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Daily precipitation data for California\"\n    }\n}"}
{"_id": "Academic--research_data--p--70797", "text": "{\n    \"dataset_name\": \"US River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 50 river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Includes data quality flags and location information.\"\n    }\n}"}
