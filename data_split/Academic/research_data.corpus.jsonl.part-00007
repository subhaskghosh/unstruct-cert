{"_id": "Academic--research_data--n--70246", "text": "{\n    \"dataset_name\": \"Remote Forest Biodiversity\",\n    \"creator\": {\n        \"name\": \"National Geographic Society\",\n        \"affiliation\": \"Non-profit Research Organization\"\n    },\n    \"date_collected\": \"2022-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Remote sensing data and ground surveys in pristine forests.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in Undisturbed Ecosystems\",\n            \"authors\": [\n                \"Alice Brown\",\n                \"Bob Johnson\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from remote sensors and field observations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70247", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"environmental_impact_score\",\n            \"units\": \"index\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Provides annual tree cover loss and gain data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70247", "text": "{\n    \"dataset_name\": \"Stock Market Data 2023-2024\",\n    \"creator\": {\n        \"name\": \"Financial Data Inc.\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"open\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"high\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"low\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"close\",\n            \"units\": \"USD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Real-time market feeds\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of Stock Market Trends\",\n            \"authors\": \"J. Doe\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://financialdata.com/download\",\n    \"metadata\": {\n        \"data_size\": \"60MB\",\n        \"annotations\": \"Historical stock prices for major companies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70248", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": \"Hansen et al.\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/dataset/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Includes data on tree cover loss and gain.\"\n    }\n}"}
