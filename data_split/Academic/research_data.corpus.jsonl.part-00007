{"_id": "Academic--research_data--n--67566", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Tweet Text\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Twitter API\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"authors\": [\n                \"Jones et al.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Sentiment analysis labels\"\n    }\n}"}
{"_id": "Academic--research_data--p--67567", "text": "{\n    \"dataset_name\": \"Global Ocean Heat Content Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanographic Centre\",\n        \"affiliation\": \"University of Southampton\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ocean Heat Content\",\n            \"units\": \"Joules\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Argo float network and satellite measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed changes in ocean heat content\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_heat_content.csv\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67567", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentration\",\n    \"creator\": {\n        \"name\": \"Global Monitoring Division\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5 GB\",\n        \"annotations\": \"Data includes measurement uncertainties\"\n    }\n}"}
{"_id": "Academic--research_data--p--67568", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling at fixed locations using automated sensors and manual water collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67568", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Measurements\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Metropolitan Government\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring from fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Index Trends in the City\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67569", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"High resolution, comprehensive global temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67569", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Climate\",\n    \"creator\": {\n        \"name\": \"University of Example\",\n        \"affiliation\": \"Department of Communication\"\n    },\n    \"date_collected\": \"2021-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"text\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC\",\n    \"sampling_method\": \"Twitter API stream\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.edu/sentimentdata\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Sentiment analysis of tweets related to climate change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67570", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2021\",\n    \"creator\": {\n        \"name\": \"University of Maryland & Google\",\n        \"affiliation\": \"Global Forest Watch\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Forest Loss\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote Sensing - Landsat and Sentinel-2\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"authors\": \"Hansen et al.\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN/GLOBAL_FOREST_CHANGE_2021_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"20 GB\",\n        \"annotations\": \"Provides yearly tree cover loss and gain data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67570", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentration Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Global Monitoring Laboratory\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"In-situ measurements from monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"authors\": \"Dlugokencky et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://gml.noaa.gov/ccgg/trends/\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Provides global measurements of atmospheric CO2 concentrations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67571", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset v1.8\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis using Landsat data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://developers.google.com/earth-engine/datasets/catalog/UMD_hansen_global_forest_change_2020_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"20 GB\",\n        \"annotations\": \"Provides a yearly global forest change dataset.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67571", "text": "{\n    \"dataset_name\": \"NOAA Daily Global Surface Summary of the Day\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tmax\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"tmin\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather station observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Daily Surface Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-summary-of-the-day/\",\n    \"metadata\": {\n        \"data_size\": \"100 MB\",\n        \"annotations\": \"Daily summary of temperature, precipitation, and wind.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67572", "text": "{\n    \"dataset_name\": \"Global Forest Change 2020-2023\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery (GLAD)\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"loss\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Provides yearly tree cover loss and gain data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67572", "text": "{\n    \"dataset_name\": \"Historical Weather Data 1950-2010\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Climate Data Center\"\n    },\n    \"date_collected\": \"2010-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Historical Climatology Network\",\n            \"authors\": \"Peterson, T. C., et al.\",\n            \"year\": 1998\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Daily weather observations from around the world.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67573", "text": "{\n    \"dataset_name\": \"CardioMRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_path\",\n            \"unit\": \"path\"\n        },\n        {\n            \"name\": \"age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"systolic_blood_pressure\",\n            \"unit\": \"mmHg\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Cardiovascular Disease Detection\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/cardio_mri_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Expert radiologists provided annotations for each image.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67573", "text": "{\n    \"dataset_name\": \"Skin Lesion Analysis Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_path\",\n            \"unit\": \"path\"\n        },\n        {\n            \"name\": \"age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"lesion_diameter\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective analysis of dermatological records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Convolutional Neural Networks for Skin Cancer Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/skin_lesion_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Dermatologists provided annotations for lesion characteristics.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67574", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 20 river sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67574", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Composition\",\n    \"creator\": {\n        \"name\": \"ChemCorp Inc.\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Composite samples collected monthly from industrial discharge points.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://chemcorp.com/wastewater_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data provided as-is, no warranty expressed or implied.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67575", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"ha\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Landsat satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 1990 to 2013\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.org/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Contains data on forest loss and gain globally.\"\n    }\n}"}
