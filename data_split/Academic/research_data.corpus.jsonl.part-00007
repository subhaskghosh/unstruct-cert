{"_id": "Academic--research_data--p--67185", "text": "{\n    \"dataset_name\": \"Regional Temperature Trends\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Daily readings from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Regional Temperature Changes\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/regional_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67185", "text": "{\n    \"dataset_name\": \"Global Forest Cover\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization of the United Nations (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover Percentage\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Area\",\n            \"units\": \"Hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Remote sensing data analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Assessment of Forest Resources\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data derived from satellite imagery\"\n    }\n}"}
{"_id": "Academic--research_data--p--67186", "text": "{\n    \"dataset_name\": \"Global Extreme Weather Events Database\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Event Type\",\n            \"units\": \"Categorical (e.g., Hurricane, Flood, Drought)\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Satellite and ground-based sensor networks\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Increasing Frequency of Extreme Weather Events\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/extreme_weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes data quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67186", "text": "{\n    \"dataset_name\": \"Historical Temperature Records of Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Services\",\n        \"affiliation\": \"European Centre for Medium-Range Weather Forecasts\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-4.0\",\n    \"sampling_method\": \"Interpolation of ground station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Temperature Trends in Europe\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/european_temps.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data has been quality controlled and bias corrected.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67187", "text": "{\n    \"dataset_name\": \"USGS National Water Quality Assessment Program - 2023 Data\",\n    \"creator\": {\n        \"name\": \"United States Geological Survey\",\n        \"affiliation\": \"USGS\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected from river and stream sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program: Surface Water and Streamflow Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://waterdata.usgs.gov/nwis/gw\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes quality control flags and metadata about sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67187", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing - 2022\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Ecology and Environment Bureau\",\n        \"affiliation\": \"BMEEB\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted - Government Use Only\",\n    \"sampling_method\": \"Continuous monitoring stations throughout Beijing.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Beijing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"http://beijingair.gov.cn/data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data requires registration and agreement to terms of use.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67188", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Fine particulate matter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67188", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"Data Science Group\",\n        \"affiliation\": \"XYZ University\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"unit\": \"N/A\",\n            \"description\": \"Score indicating sentiment polarity\"\n        },\n        {\n            \"name\": \"Text Content\",\n            \"unit\": \"N/A\",\n            \"description\": \"Raw text of social media posts\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"API data extraction\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Social Media Discourse\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data anonymized\"\n    }\n}"}
{"_id": "Academic--research_data--p--67189", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated data loggers and discrete water samples collected weekly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": \"Carpenter, S.R., et al.\",\n            \"year\": 2016\n        }\n    ],\n    \"download_url\": \"https://limnology.wisc.edu/data/mendota/\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included.  Methods documented on website.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67189", "text": "{\n    \"dataset_name\": \"Coastal Bird Observation Log\",\n    \"creator\": {\n        \"name\": \"Local Audubon Society\",\n        \"affiliation\": \"Citizen Science Group\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Count\",\n            \"units\": \"Number of individuals\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Latitude/Longitude\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC\",\n    \"sampling_method\": \"Opportunistic observations by volunteer birdwatchers.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://audubon.org/coastalbirds\",\n    \"metadata\": {\n        \"data_size\": \"200 KB\",\n        \"annotations\": \"Data collected by amateur ornithologists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67190", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperatures\",\n            \"year\": 2024\n        },\n        {\n            \"title\": \"Impact of Climate Change on Precipitation Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67190", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Rice Yield\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Country-level reports from agricultural agencies\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Production Statistics\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data may contain some inaccuracies due to reporting inconsistencies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67191", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2021-2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Temperature anomalies relative to 1951-1980 baseline\"\n    }\n}"}
{"_id": "Academic--research_data--n--67191", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Southeast Asia\",\n    \"creator\": {\n        \"name\": \"Aung San Suu Kyi\",\n        \"affiliation\": \"Myanmar Meteorological Department\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Rain gauge network\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/rainfall_seasia.xlsx\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Daily rainfall measurements\"\n    }\n}"}
{"_id": "Academic--research_data--p--67192", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67192", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Research Institute\",\n        \"affiliation\": \"Ecology Department\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random transects within designated research plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://amazonresearch.org/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Species names are scientific names\"\n    }\n}"}
{"_id": "Academic--research_data--p--67193", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Environmental Sciences Department\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations at 50 locations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and quality controlled, missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67193", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Tree_Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Identified tree species\"\n        },\n        {\n            \"variable_name\": \"Tree_Height\",\n            \"units\": \"meters\",\n            \"description\": \"Height of the tree\"\n        },\n        {\n            \"variable_name\": \"DBH\",\n            \"units\": \"cm\",\n            \"description\": \"Diameter at Breast Height\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"authors\": \"Silva et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species identification verified by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67194", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring_USA\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA Office of Water\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"variable_name\": \"NitrateConcentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in river water quality in the United States\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/river-water-quality-data\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data is quality controlled and validated by EPA scientists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67194", "text": "{\n    \"dataset_name\": \"HistoricalRainfallData_Africa\",\n    \"creator\": {\n        \"name\": \"Global Weather Initiative\",\n        \"affiliation\": \"International Meteorological Organization\"\n    },\n    \"date_collected\": \"2021-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"DailyRainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Data collected from weather stations across Africa.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Impacts on African Rainfall Patterns\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.globalweather.org/rainfalldata\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is raw and may contain some errors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67195", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated sondes deployed at multiple locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": \"Smith et al.\"\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data has been quality controlled and flagged for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67195", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Inventory\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization of the United Nations (FAO)\",\n        \"affiliation\": \"Forestry Department\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"unit\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing and ground-based surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating global forest biomass using satellite imagery\",\n            \"authors\": \"Jones et al.\"\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass_data.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data is derived from a combination of satellite data and field measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67196", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Earth Sciences Data and Information Services Center\",\n        \"affiliation\": \"NASA/GISS\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide (CO2) Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane (CH4) Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide (N2O) Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite measurements and ground-based sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric Greenhouse Gases\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67196", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Dataset\",\n        \"affiliation\": \"ECAD\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Daily Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"Open Data Commons Attribution\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Variability\",\n            \"authors\": [\n                \"Brown, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.txt\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Contains daily weather readings from various European stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67197", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data validated and quality controlled\"\n    }\n}"}
{"_id": "Academic--research_data--n--67197", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment\",\n    \"creator\": {\n        \"name\": \"National Park Service\",\n        \"affiliation\": \"US Department of Interior\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Random transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in National Parks\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification and location coordinates\"\n    }\n}"}
{"_id": "Academic--research_data--p--67198", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations, hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data is quality-controlled and includes flags for missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67198", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Biodiversity\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random transects, underwater video recordings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Species Distribution in Coastal Waters\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Video recordings available upon request.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67199", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67199", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Coastal Research Center\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species Count\",\n            \"units\": \"count\",\n            \"description\": \"Number of observed species\"\n        },\n        {\n            \"variable_name\": \"Depth\",\n            \"units\": \"meters\",\n            \"description\": \"Water depth\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling during research cruises\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Sea Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marinebiodata.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species identification based on visual observation\"\n    }\n}"}
{"_id": "Academic--research_data--p--67200", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Team\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Wind Direction\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
