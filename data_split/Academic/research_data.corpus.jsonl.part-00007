{"_id": "Academic--research_data--p--71431", "text": "{\n    \"dataset_name\": \"Global Precipitation Measurements Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"University of Maryland, College Park\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm/hr\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite-based remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Precipitation Measurement: An Overview\",\n            \"authors\": [\n                \"R. Huffman\",\n                \"D. Bolten\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/precipitation_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains quality flags for each data point.\"\n    }\n}"}
