{"_id": "Academic--research_data--p--68474", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA GISS Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A Comprehensive Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68474", "text": "{\n    \"dataset_name\": \"Ocean Current Measurements\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of Coastal Studies\"\n    },\n    \"date_collected\": \"2019-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Current Velocity\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Autonomous underwater vehicle deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Current Dynamics\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.xml\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Raw sensor data with quality control flags.\"\n    }\n}"}
