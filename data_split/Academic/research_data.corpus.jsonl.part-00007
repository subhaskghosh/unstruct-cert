{"_id": "Academic--research_data--n--68968", "text": "{\n    \"dataset_name\": \"Global Industrial Emissions Inventory\",\n    \"creator\": {\n        \"name\": \"EcoMetrics Solutions Inc.\",\n        \"affiliation\": \"EcoMetrics Solutions Inc.\"\n    },\n    \"date_collected\": \"2023-02-28T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"SO2 Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"NOx Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"Particulate Matter\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"VOC Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"Methane Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"Ammonia Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"NMHC Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"GHG Emissions\",\n            \"units\": \"tonnes\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Research Use Only\",\n    \"sampling_method\": \"Bottom-up emissions modeling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Emissions Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/industrial_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data represents estimated emissions\"\n    }\n}"}
