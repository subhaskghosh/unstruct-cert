{"_id": "Academic--research_data--n--68304", "text": "{\n    \"dataset_name\": \"Global Soil Composition Database\",\n    \"creator\": {\n        \"name\": \"International Soil Science Consortium\",\n        \"affiliation\": \"Global Organization\"\n    },\n    \"date_collected\": \"2018-11-20T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Sand Content\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Composite sampling from various global locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Patterns of Soil Carbon\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is derived from multiple sources.\"\n    }\n}"}
