{"_id": "Academic--research_data--p--68250", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring-London\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, UCL\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less, a key indicator of air pollution. Measured using a tapered element oscillating microbalance (TEOM) analyzer.\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration in parts per billion. Measured using UV absorption spectroscopy.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration in parts per billion. Measured using chemiluminescence.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68250", "text": "{\n    \"dataset_name\": \"MarineBiodiversity-Pacific\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of Hawaii\"\n    },\n    \"date_collected\": \"2023-11-01T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SpeciesCount\",\n            \"units\": \"count\",\n            \"description\": \"Number of observed species in the sample.\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Geographic latitude of the sample location.\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Geographic longitude of the sample location.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random sampling of marine ecosystems in the Pacific Ocean.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Biodiversity Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes species identification and abundance.\"\n    }\n}"}
