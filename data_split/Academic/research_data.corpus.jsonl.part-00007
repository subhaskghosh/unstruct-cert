{"_id": "Academic--research_data--p--68389", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2021-06-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-summary-of-the-day/access/\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68389", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa State University\",\n        \"affiliation\": \"Department of Agronomy\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Soybean Yield\",\n            \"units\": \"bushels/acre\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0\",\n    \"sampling_method\": \"County-level agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Crop Production in the Midwest\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.iowastatedata.org/crops\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes estimated yields.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68390", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 1990 to 2000\",\n            \"authors\": [\n                \"Hansen\",\n                \"DeFries\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2008_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Contains global maps of forest cover loss and gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68390", "text": "{\n    \"dataset_name\": \"US Historical Climate Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Data collected from weather stations across the United States.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Trends in the United States\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Historical climate data for the US.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68391", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2021-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68391", "text": "{\n    \"dataset_name\": \"Coral Reef Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"Marine Biology Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2022-07-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of reef covered by live coral\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Sea surface temperature\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Climate Change on Coral Reefs\",\n            \"authors\": [\n                \"Lee, B.\",\n                \"Chen, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Image annotations available\"\n    }\n}"}
{"_id": "Academic--research_data--p--68392", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--68392", "text": "{\n    \"dataset_name\": \"Water Quality Assessment of Rural Streams\",\n    \"creator\": {\n        \"name\": \"State Environmental Agency\",\n        \"affiliation\": \"Water Resources Division\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Grab samples collected monthly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Water Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected by field technicians\"\n    }\n}"}
{"_id": "Academic--research_data--p--68393", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"O3\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Location_Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Location_Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution License\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in London 2023 Report\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_london.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68393", "text": "{\n    \"dataset_name\": \"SoilComposition_RuralFrance\",\n    \"creator\": {\n        \"name\": \"French National Agricultural Institute\",\n        \"affiliation\": \"Soil Science Department\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"dimensionless\"\n        },\n        {\n            \"name\": \"OrganicMatter\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Nitrogen\",\n            \"unit\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Random sampling across agricultural fields\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Health in French Agriculture\",\n            \"authors\": [\n                \"Dupont, L.\",\n                \"Martin, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_france.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Initial soil composition data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68394", "text": "{\n    \"dataset_name\": \"Twitter Public Opinion on Climate Change - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"tweet_id\",\n            \"description\": \"Unique identifier for the tweet\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"user_id\",\n            \"description\": \"Unique identifier for the user\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"sentiment_score\",\n            \"description\": \"Sentiment score of the tweet (ranging from -1 to 1)\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"topic_category\",\n            \"description\": \"Category of the tweet (e.g., policy, science, economics)\",\n            \"unit\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling of public tweets using the Twitter API\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Sentiment Towards Climate Change on Twitter\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_change_tweets_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Tweets are annotated for sentiment and topic category.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68394", "text": "{\n    \"dataset_name\": \"Instagram User Engagement - 2022\",\n    \"creator\": {\n        \"name\": \"Social Media Analytics Inc.\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2022-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"post_id\",\n            \"description\": \"Unique ID for each Instagram post\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"likes\",\n            \"description\": \"Number of likes received by the post\",\n            \"unit\": \"Count\"\n        },\n        {\n            \"variable_name\": \"comments\",\n            \"description\": \"Number of comments on the post\",\n            \"unit\": \"Count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Data scraped from Instagram profiles.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/instagram_engagement_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"No manual annotations provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68395", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensor network with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68395", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Instituto Nacional de Pesquisas da Amazônia\",\n        \"affiliation\": \"Brazilian National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual field surveys conducted quarterly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon Rainforest\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://amazonia.inpa.gov.br/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data includes species identification codes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68396", "text": "{\n    \"dataset_name\": \"Urban Tree Health Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"TreeDiameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"variable_name\": \"LeafChlorophyll\",\n            \"units\": \"SPAD units\"\n        },\n        {\n            \"variable_name\": \"AirPollutionLevel\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic sampling across urban parks\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Urban Tree Health\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_tree_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes annotations for tree species and health status.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68396", "text": "{\n    \"dataset_name\": \"Global Fisheries Catch Data\",\n    \"creator\": {\n        \"name\": \"FAO Fisheries Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2023-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CatchWeight\",\n            \"units\": \"metric tons\"\n        },\n        {\n            \"variable_name\": \"SpeciesCode\",\n            \"units\": \"FAO Species Code\"\n        },\n        {\n            \"variable_name\": \"FishingArea\",\n            \"units\": \"FAO Fishing Area\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Data reported by member countries.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The State of World Fisheries and Aquaculture\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/fisheries_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Large-scale global fisheries data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68397", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"ug/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples collected from multiple depths\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data quality flags included for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68397", "text": "{\n    \"dataset_name\": \"Global Air Pollution Data\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 3.0 IGO\",\n    \"sampling_method\": \"Data compiled from national monitoring networks\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/global_airpollution.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes country-level averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68398", "text": "{\n    \"dataset_name\": \"Global Soil Moisture Dataset (2021-2023)\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture (0-10cm)\",\n            \"units\": \"m3/m3\"\n        },\n        {\n            \"name\": \"Temperature (Surface)\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Vegetation Index\",\n            \"units\": \"NDVI\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"In-situ measurements from a network of soil sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Soil Moisture on Regional Climate\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_moisture_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68398", "text": "{\n    \"dataset_name\": \"Landsat 8 Surface Reflectance Data\",\n    \"creator\": {\n        \"name\": \"USGS Earth Resources Observation and Science (EROS) Center\",\n        \"affiliation\": \"US Geological Survey\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Blue Band Reflectance\",\n            \"units\": \"Reflectance\"\n        },\n        {\n            \"name\": \"Green Band Reflectance\",\n            \"units\": \"Reflectance\"\n        },\n        {\n            \"name\": \"Red Band Reflectance\",\n            \"units\": \"Reflectance\"\n        }\n    ],\n    \"data_format\": \"TIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Landsat Data for Environmental Monitoring\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/landsat_data.tif\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Cloud mask provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--68399", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in river water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68399", "text": "{\n    \"dataset_name\": \"IndustrialWastewaterAnalysis\",\n    \"creator\": {\n        \"name\": \"ChemCorp Inc.\",\n        \"affiliation\": \"R&D Department\"\n    },\n    \"date_collected\": \"2022-12-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Total Suspended Solids\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Samples taken from wastewater discharge points during routine monitoring.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/industrial_wastewater.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Preliminary data, subject to change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68400", "text": "{\n    \"dataset_name\": \"Midwest River Basin Water Quality Data\",\n    \"creator\": {\n        \"name\": \"US Geological Survey - Midwest Stream Team\",\n        \"affiliation\": \"USGS\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected monthly at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Midwest River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/midwest_river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been quality controlled and flagged for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68400", "text": "{\n    \"dataset_name\": \"California Coastal Marine Pollution Study\",\n    \"creator\": {\n        \"name\": \"California Oceanographic Institute\",\n        \"affiliation\": \"COI\"\n    },\n    \"date_collected\": \"2024-01-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Plastic Particle Count\",\n            \"units\": \"particles/m^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Automated sensors and periodic water samples collected along the California coastline.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Plastic Pollution on California Marine Ecosystems\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/california_coastal_data.json\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes metadata on sensor calibration and sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68401", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality checked and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--68401", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Alex Johnson\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Reef Health Index\",\n            \"units\": \"scale 1-10\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Underwater visual census\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity of Coral Reefs in the Pacific Ocean\",\n            \"authors\": [\n                \"Johnson, A.\",\n                \"Brown, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data collected during a research expedition\"\n    }\n}"}
{"_id": "Academic--research_data--p--68402", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Monitoring Dataset - PNW\",\n    \"creator\": {\n        \"name\": \"Dr. Evelyn Hayes\",\n        \"affiliation\": \"University of Washington, School of Environmental and Forest Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Tree Diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic plot sampling across 100 forested locations in the Pacific Northwest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in forest biodiversity\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Hayes, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification and quality control notes.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68402", "text": "{\n    \"dataset_name\": \"Urban Air Quality Data - London\",\n    \"creator\": {\n        \"name\": \"AirTech Solutions\",\n        \"affiliation\": \"Private Environmental Consulting Firm\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Commercial License Required\",\n    \"sampling_method\": \"Continuous monitoring at 20 fixed locations across London.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://airtechsolutions.co.uk/london_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data includes timestamped measurements from air quality sensors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68403", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68403", "text": "{\n    \"dataset_name\": \"North Pacific Oceanographic Data\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Current Dynamics\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data collected during a research expedition.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68404", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the atmosphere.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature at the monitoring station.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic emissions on urban air quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68404", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Association\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of different species observed.\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\",\n            \"description\": \"Number of trees per hectare.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the Amazon basin\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Oliveira, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"GPS coordinates included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68405", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using electrochemical sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data includes timestamps and geographic coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68405", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Inventory\",\n    \"creator\": {\n        \"name\": \"Forestry Research Institute\",\n        \"affiliation\": \"Government Agency\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Periodic forest inventory plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating Forest Biomass\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes species identification and plot locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68406", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnomalies\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"PrecipitationAnomalies\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global surface station network with satellite data interpolation.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Summary\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-temperature-and-precipitation/access/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68406", "text": "{\n    \"dataset_name\": \"Historical Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"US Federal Government\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"OzoneConcentration\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"ParticulateMatter2.5\",\n            \"unit\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Fixed air quality monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Air Quality Trends\",\n            \"year\": 2017\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/air-research/air-quality-data\",\n    \"metadata\": {\n        \"data_size\": \"700MB\",\n        \"annotations\": \"Data missing values filled using nearest neighbor interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68407", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring_2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley - Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-07-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at 5 designated locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data cleaned and validated for outliers.\"\n    }\n}"}
