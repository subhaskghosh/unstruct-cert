{"_id": "Academic--research_data--n--66350", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Southeast Asia\",\n    \"creator\": {\n        \"name\": \"Aisha Rahman\",\n        \"affiliation\": \"University of Singapore\"\n    },\n    \"date_collected\": \"2021-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"rainfall\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Rain gauge network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in Southeast Asia\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes daily rainfall measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66351", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Areas - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-02-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_urban_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66351", "text": "{\n    \"dataset_name\": \"Global Weather Patterns\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-12-31T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather model outputs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Projections\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw model output, no data cleaning performed.\"\n    }\n}"}
