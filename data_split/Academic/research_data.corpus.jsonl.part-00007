{"_id": "Academic--research_data--p--71768", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Dataset v4\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station observations and satellite measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Land Surface Temperature Analysis: Methodology and Data\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Ruedy, R.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Includes uncertainty estimates and data quality flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71768", "text": "{\n    \"dataset_name\": \"Coral Reef Bleaching Events - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2022-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Bleaching Index\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees South\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"In-situ surveys of coral reefs in the Pacific Ocean.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Climate Change on Coral Reefs\",\n            \"authors\": [\n                \"Hughes, T.P.\",\n                \"Kerry, J.T.\",\n                \"Alvarez-Romero, J.G.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.aims.gov.au/coralbleaching/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Includes species identification and bleaching severity.\"\n    }\n}"}
