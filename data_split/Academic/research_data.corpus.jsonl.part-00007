{"_id": "Academic--research_data--p--70701", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Automated sensors deployed at multiple depths\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--70701", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality assessment in metropolitan cities\",\n            \"authors\": [\n                \"Brown\",\n                \"Davis\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes timestamps and station IDs\"\n    }\n}"}
{"_id": "Academic--research_data--p--70702", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages of pollutants.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70702", "text": "{\n    \"dataset_name\": \"Soil Nutrient Levels in Agricultural Fields\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Corporation\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Potassium\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Soil sample collection from farms\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Fertilizer Use in Corn Production\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data includes nutrient levels at different depths.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70703", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Climate Forcing\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"Columbia University Earth Institute\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Solar Irradiance\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Includes uncertainty estimates for all temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70703", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa State University Agricultural Department\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2019-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Restricted - Non-Commercial Use Only\",\n    \"sampling_method\": \"Rain gauges across Iowa.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Iowa Rainfall Trends\",\n            \"authors\": [\n                \"John Doe\",\n                \"Jane Smith\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/iowa_rainfall.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is preliminary and subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70704", "text": "{\n    \"dataset_name\": \"Air Quality Data - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 10 micrometers in diameter\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Air Quality Network Report 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data has been quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70704", "text": "{\n    \"dataset_name\": \"Soil Moisture Levels - Rural France\",\n    \"creator\": {\n        \"name\": \"INRAE\",\n        \"affiliation\": \"Agriculture Research Institute\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil_Moisture\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of water in the soil\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Field measurements at irregular intervals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on French Agriculture\",\n            \"authors\": [\n                \"Dupont, L.\",\n                \"Martin, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.fr/soilmoisture.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data, minimal quality control.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70705", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Evelyn Hayes\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"date_observed\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated tracking via radar and visual observation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in avian migration\",\n            \"authors\": [\n                \"Hayes, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Detailed species taxonomy included. Quality control procedures documented.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70705", "text": "{\n    \"dataset_name\": \"Urban Tree Health in London\",\n    \"creator\": {\n        \"name\": \"Liam O'Connell\",\n        \"affiliation\": \"Greater London Authority\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"tree_species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"trunk_diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"variable_name\": \"health_index\",\n            \"units\": \"0-10\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Random sampling of trees in parks and streets\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/tree_health.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Limited annotation; basic tree species classification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70706", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"species_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"migration_date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Automated tracking via bird tags and citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in North American bird migration patterns\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality flags for observation reliability.\"\n    }\n}"}
