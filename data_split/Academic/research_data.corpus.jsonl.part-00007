{"_id": "Academic--research_data--p--70286", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation Anomaly\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"unit\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Atmospheric Pressure\",\n            \"unit\": \"hPa\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Concentration\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global station network and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Summary\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-temperature-report/access/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains monthly and annual anomalies.\"\n    }\n}"}
