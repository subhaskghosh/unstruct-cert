{"_id": "Academic--research_data--n--71016", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Study - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Group\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phytoplankton Concentration\",\n            \"units\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Nutrient Levels\",\n            \"units\": \"µmol/L\"\n        },\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Zooplankton Biomass\",\n            \"units\": \"mg/m³\"\n        },\n        {\n            \"name\": \"Wave Height\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Light Penetration\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Sediment Composition\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Bacterial Count\",\n            \"units\": \"CFU/mL\"\n        },\n        {\n            \"name\": \"Viral Abundance\",\n            \"units\": \"particles/mL\"\n        },\n        {\n            \"name\": \"Pollutant Levels\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Sea Level\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Water Clarity\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity in the Pacific Ocean\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data collected during a 6-month research expedition\"\n    }\n}"}
{"_id": "Academic--research_data--p--71017", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Surface Temperature\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Quality controlled temperature data from around the world.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71017", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Agricultural Research Institute\"\n    },\n    \"date_collected\": \"2018-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"crop_yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"region\",\n            \"units\": \"geographic location\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Fertilizers on Crop Production\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.xml\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Detailed crop yield data by region.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71018", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Environmental Science and Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated. Missing values are flagged.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71018", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Health - Amazon\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Ecology\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Normalized Difference Vegetation Index\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery and field measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Biomass Estimation using Remote Sensing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest_health.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data may contain errors due to cloud cover.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71019", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 and Climate Impact Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature Anomaly (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Sea Level Rise (mm)\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rising CO2 on Global Climate Patterns\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags and metadata on measurement locations.\"\n    }\n}"}
