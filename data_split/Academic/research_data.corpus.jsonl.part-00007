{"_id": "Academic--research_data--n--70678", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Remote Sensing Research Group\",\n        \"affiliation\": \"University of Geoscience\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover Percentage\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Land Use Type\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Trends in the Amazon Basin\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.geojson\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data derived from Landsat satellite imagery.\"\n    }\n}"}
