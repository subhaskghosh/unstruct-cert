{"_id": "Academic--research_data--n--67062", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Scottish Highlands\",\n    \"creator\": {\n        \"name\": \"Forestry Commission Scotland\",\n        \"affiliation\": \"Research Branch\"\n    },\n    \"date_collected\": \"2023-05-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Species Composition\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots across the Scottish Highlands\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment in Scotland\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://forestry.gov.scot/data\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data collected during annual surveys\"\n    }\n}"}
{"_id": "Academic--research_data--p--67063", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67063", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Normalized Difference Vegetation Index\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://forestdata.gov/health.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data derived from Landsat 8 imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67064", "text": "{\n    \"dataset_name\": \"Global Forest Watch Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_cover_loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"carbon_emissions\",\n            \"units\": \"tonnes CO2e\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat and Sentinel satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch: a platform for monitoring forest change\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Data is pre-processed and quality-controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67064", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Europe\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-25T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations across Europe\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Assessment & Dataset\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/europe-historical-weather/\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Data includes daily averages and maximum/minimum values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67065", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Earth Science Data and Information System\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Biomass Density\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"variable_name\": \"Forest Type\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass with High Resolution\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Dataset covers the period 2010-2023\"\n    }\n}"}
{"_id": "Academic--research_data--n--67065", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Urban Air Pollution\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Daily measurements from major US cities\"\n    }\n}"}
{"_id": "Academic--research_data--p--67066", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO\",\n            \"description\": \"Carbon Monoxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"description\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"O3\",\n            \"description\": \"Ozone Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"description\": \"Air Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Continuous Monitoring Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67066", "text": "{\n    \"dataset_name\": \"WaterQualityAssessment_RiverThames\",\n    \"creator\": {\n        \"name\": \"Thames River Trust\",\n        \"affiliation\": \"Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"description\": \"Amount of dissolved oxygen in water\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"description\": \"Acidity or alkalinity of the water\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"description\": \"Cloudiness of the water\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Grab Samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Monitoring in the Thames River\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/thames_water_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes weekly measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67067", "text": "{\n    \"dataset_name\": \"Freshwater Lake Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular stratified random sampling from 10 lakes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Freshwater Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data quality checked and outliers removed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67067", "text": "{\n    \"dataset_name\": \"Coastal Ocean Salinity Data - 2022\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using buoy sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity Variations\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_salinity.json\",\n    \"metadata\": {\n        \"data_size\": \"1.8MB\",\n        \"annotations\": \"Data smoothed using a moving average filter.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67068", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Change Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67068", "text": "{\n    \"dataset_name\": \"Historical Agricultural Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization\",\n        \"affiliation\": \"FAO\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-SA 3.0\",\n    \"sampling_method\": \"National agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Production Statistics\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/ag_yields.xml\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes regional averages\"\n    }\n}"}
{"_id": "Academic--research_data--p--67069", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Gross Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 1990 to 2020\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data\",\n    \"metadata\": {\n        \"data_size\": \"250GB\",\n        \"annotations\": \"Contains data on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67069", "text": "{\n    \"dataset_name\": \"Stratospheric Ozone Measurements\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-06-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"parts per million\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"km\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite-based atmospheric sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in stratospheric ozone\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://ozoneaq.gsfc.nasa.gov/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains data on ozone levels in the stratosphere.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67070", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"air_pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"solar_radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"cloud_cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"ocean_salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"sea_ice_extent\",\n            \"units\": \"km^2\"\n        },\n        {\n            \"name\": \"atmospheric_CO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of weather stations and buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67070", "text": "{\n    \"dataset_name\": \"Local Rainfall Data - Springfield\",\n    \"creator\": {\n        \"name\": \"Springfield Weather Watchers\",\n        \"affiliation\": \"Community Science Group\"\n    },\n    \"date_collected\": \"2022-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"daily_rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"average_temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0\",\n    \"sampling_method\": \"Single rain gauge in Springfield\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/springfield_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"1MB\",\n        \"annotations\": \"Simple daily records\"\n    }\n}"}
{"_id": "Academic--research_data--p--67071", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Atmospheric Pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data is quality controlled and gap-filled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67071", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns - City X\",\n    \"creator\": {\n        \"name\": \"City X Weather Department\",\n        \"affiliation\": \"Municipal Government\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"City Block\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Rain gauges within the city limits\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/cityx_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"100KB\",\n        \"annotations\": \"Raw data from local rain gauges.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67072", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67072", "text": "{\n    \"dataset_name\": \"Oceanographic Data from Coastal Regions\",\n    \"creator\": {\n        \"name\": \"Marine Research Institute\",\n        \"affiliation\": \"University of California\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Ocean Salinity\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes measurements at various depths.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67073", "text": "{\n    \"dataset_name\": \"London Air Quality Monitoring 2023-2024\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter, a key indicator of air pollution.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution License\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67073", "text": "{\n    \"dataset_name\": \"River Thames Water Quality 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environment Agency\",\n        \"affiliation\": \"Water Quality Division\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Concentration of dissolved oxygen in the water.\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\",\n            \"description\": \"Acidity or alkalinity of the water.\"\n        },\n        {\n            \"name\": \"Nitrate Levels\",\n            \"units\": \"mg/L\",\n            \"description\": \"Concentration of nitrate in the water.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular water sample collection from various points along the River Thames\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Assessment of the River Thames\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://environment.data.gov.uk/riverthames\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data is subject to potential measurement errors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67074", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67074", "text": "{\n    \"dataset_name\": \"Historical Pollen Counts\",\n    \"creator\": {\n        \"name\": \"Allergy Research Foundation\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2022-01-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Pollen Count\",\n            \"units\": \"grains/m³\"\n        },\n        {\n            \"name\": \"Pollen Type\",\n            \"units\": \"category\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Daily sampling from collection sites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Seasonal Allergies and Climate Change\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pollen_data.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data represents average daily pollen counts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67075", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data\",\n    \"creator\": {\n        \"name\": \"National Oceanographic Centre\",\n        \"affiliation\": \"University of Southampton\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Autonomous underwater vehicle surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
