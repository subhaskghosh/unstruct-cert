{"_id": "Academic--research_data--n--68819", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Environmental Issues\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Tweet ID\",\n            \"units\": \"Unique Identifier\"\n        },\n        {\n            \"name\": \"User Location\",\n            \"units\": \"Geographic Coordinates\"\n        },\n        {\n            \"name\": \"Keyword Frequency\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Hashtag\",\n            \"units\": \"Text\"\n        },\n        {\n            \"name\": \"Retweet Count\",\n            \"units\": \"Count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Twitter API data collection\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/social_media_data.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Sentiment analysis performed using a pre-trained model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68820", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset v1.8\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2020_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Provides information on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68820", "text": "{\n    \"dataset_name\": \"Historical Climate Data - Global\",\n    \"creator\": {\n        \"name\": \"National Climatic Data Center (NCDC)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Historical Climatology Network (GHCN)\",\n            \"authors\": \"Peterson et al.\",\n            \"year\": 1998\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Daily temperature and precipitation data from around the world.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68821", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Automated sensor network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages and daily maximums.\"\n    }\n}"}
