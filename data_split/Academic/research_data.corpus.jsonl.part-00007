{"_id": "Academic--research_data--n--68469", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"unit\": \"tonnes\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"unit\": \"index value\"\n        },\n        {\n            \"name\": \"Land Use Change\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change from 2000 to 2020\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_change.tif\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"High resolution dataset requiring specialized software.\"\n    }\n}"}
