{"_id": "Academic--research_data--p--70522", "text": "{\n    \"dataset_name\": \"Arctic Temperature Records\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"Polar Research Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Automated weather stations across the Arctic Circle\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Warming Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
