{"_id": "Academic--research_data--p--67149", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Systematic Grab Samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program: Regional Reports\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Trends in Water Quality in the United States\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/national-water-quality-monitoring-database\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
