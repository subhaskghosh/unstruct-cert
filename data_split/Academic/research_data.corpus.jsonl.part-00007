{"_id": "Academic--research_data--n--67533", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-11-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Ocean Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Global Temperature\",\n            \"authors\": [\n                \"Davis, R.\",\n                \"Wilson, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Includes uncertainty estimates\"\n    }\n}"}
{"_id": "Academic--research_data--p--67534", "text": "{\n    \"dataset_name\": \"Arctic Ecosystem Temperature Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Ice Thickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Snow Depth\",\n            \"units\": \"centimeters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated weather stations and field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rising Temperatures on Arctic Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes temperature readings, ice thickness, and snow depth measurements across the Arctic region. Focused on ecosystem health indicators.\",\n        \"keywords\": [\n            \"ecology\",\n            \"ecosystem\",\n            \"temperature\",\n            \"Arctic\",\n            \"climate change\"\n        ]\n    }\n}"}
{"_id": "Academic--research_data--n--67534", "text": "{\n    \"dataset_name\": \"Global Precipitation Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2022-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Precipitation Climatology Project\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/precipitation_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Global precipitation data derived from satellite observations. Useful for hydrological modeling.\",\n        \"keywords\": [\n            \"precipitation\",\n            \"climate\",\n            \"satellite\",\n            \"weather\"\n        ]\n    }\n}"}
{"_id": "Academic--research_data--p--67535", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/data/climate-data\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67535", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis on Climate Change\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Social Science Research Institute\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"String\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"User Location\",\n            \"units\": \"Geographic Coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Twitter API, keyword search\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/socialmedia_climate\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Sentiment analysis labels\"\n    }\n}"}
{"_id": "Academic--research_data--p--67536", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded dataset\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality assessed as 'high'. Thoroughly documented and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67536", "text": "{\n    \"dataset_name\": \"Historical Weather Records 1980-2010\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Station-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Regional Weather Patterns\",\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality is generally good, with some missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67537", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GST)\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information (NCEI)\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Sea Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Land Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations, buoys, and ships\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-summary-of-the-day/\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67537", "text": "{\n    \"dataset_name\": \"Future Climate Projections - CMIP6\",\n    \"creator\": {\n        \"name\": \"Coupled Model Intercomparison Project\",\n        \"affiliation\": \"World Climate Research Programme\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Projected Temperature Change\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Precipitation Change\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Model Outputs\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Model-specific metadata included\"\n    }\n}"}
{"_id": "Academic--research_data--p--67538", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated buoys and periodic grab samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags and metadata about sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67538", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"City of Metropolis Environmental Agency\",\n        \"affiliation\": \"Metropolis City Hall\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Fixed monitoring stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/urban_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67539", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset - Healthy Adults\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Gender\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling of healthy adult volunteers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Normal Brain MRI Atlas\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Age and Gender labels provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67539", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset - Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2024-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"X-Ray Image\",\n            \"units\": \"JPEG\"\n        },\n        {\n            \"name\": \"Pneumonia Status\",\n            \"units\": \"binary\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Hospital patient records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pneumonia Detection using Deep Learning\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Pneumonia status labels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67540", "text": "{\n    \"dataset_name\": \"Coastal Ecosystem Response to Climate Change\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"Coral Cover\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote Sensing and Field Surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Warming Waters on Coastal Ecosystems\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_ecosystem_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"320MB\",\n        \"annotations\": \"Data includes detailed species identification for coral reefs.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67540", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Government Agency\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Global Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Temperature Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global Weather Stations and Satellite Data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Comprehensive historical temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67541", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Wind Direction\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
