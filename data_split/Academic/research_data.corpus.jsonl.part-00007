{"_id": "Academic--research_data--n--68129", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Dynamics\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-07-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random forest plots within a defined area\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in forest structure\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://stanford.edu/forestdata\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data collected as part of a long-term ecological study.\"\n    }\n}"}
