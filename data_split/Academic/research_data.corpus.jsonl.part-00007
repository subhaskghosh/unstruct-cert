{"_id": "Academic--research_data--p--70423", "text": "{\n    \"dataset_name\": \"Coastal Erosion Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Shoreline Retreat Rate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"name\": \"Beach Width\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Regular transect surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Erosion Trends in the Pacific Northwest\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Detailed documentation available at [link]\"\n    }\n}"}
