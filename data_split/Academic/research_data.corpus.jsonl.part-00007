{"_id": "Academic--research_data--p--69134", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes land and ocean temperature anomalies\"\n    }\n}"}
