{"_id": "Academic--research_data--n--71267", "text": "{\n    \"dataset_name\": \"Coral Reef Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-08-15T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Coral Bleaching Index\",\n            \"units\": \"Index\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Remote sensing and in-situ measurements at coral reef locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rising Ocean Temperatures on Coral Reefs\",\n            \"authors\": \"Lee, D. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data calibrated and validated against satellite observations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71268", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atmospheric Composition on Global Warming\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71268", "text": "{\n    \"dataset_name\": \"Ocean Acidification and Marine Life\",\n    \"creator\": {\n        \"name\": \"Dr. James Wilson\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH Level\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA-4.0\",\n    \"sampling_method\": \"Ship-based water sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Ocean Acidification on Coral Reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data calibrated against standard seawater samples\"\n    }\n}"}
{"_id": "Academic--research_data--p--71269", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute of California\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations across urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71269", "text": "{\n    \"dataset_name\": \"Historical Water Quality Data - River Delta\",\n    \"creator\": {\n        \"name\": \"Hydrology Department\",\n        \"affiliation\": \"State Water Resources Agency\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Limited Use\",\n    \"sampling_method\": \"Monthly grab samples from fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"River Delta Water Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": null,\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data requires request for access.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71270", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 1970-2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Year\",\n            \"unit\": \"Year\"\n        },\n        {\n            \"name\": \"Global Average Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Northern Hemisphere Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Southern Hemisphere Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Ocean Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements from land and ocean stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends and Impacts\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes monthly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71270", "text": "{\n    \"dataset_name\": \"Historical Precipitation Data - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Services\",\n        \"affiliation\": \"European Centre for Medium-Range Weather Forecasts\"\n    },\n    \"date_collected\": \"2022-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"Degrees\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Commercial License Required\",\n    \"sampling_method\": \"Rain gauge measurements across Europe.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Precipitation Patterns in Europe\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/european_precipitation.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5MB\",\n        \"annotations\": \"Data is provided at a daily resolution.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71271", "text": "{\n    \"dataset_name\": \"Air Quality in London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature at measurement location.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data includes hourly averages and quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71271", "text": "{\n    \"dataset_name\": \"Coral Reef Health Survey\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"Coral Reef Research Division\"\n    },\n    \"date_collected\": \"2023-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of seabed covered by live coral.\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"g/m²\",\n            \"description\": \"Total biomass of fish species.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys conducted by SCUBA divers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Climate Change on Coral Reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://aims.gov.au/coralreefdata.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data includes species identification and survey locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71272", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"FAO and University of Maryland\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations & University of Maryland\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Carbon Stock\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest biomass and carbon stocks in 2020\",\n            \"authors\": [\n                \"Achard et al.\"\n            ],\n            \"year\": 2020\n        },\n        {\n            \"title\": \"Climate change impacts on forest ecosystems\",\n            \"authors\": [\n                \"IPCC\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data covers forests globally. Includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71272", "text": "{\n    \"dataset_name\": \"London Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"London Environmental Monitoring Network\",\n        \"affiliation\": \"Greater London Authority\"\n    },\n    \"date_collected\": \"2023-10-27T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"ODbL\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality trends in London\",\n            \"authors\": [\n                \"Smith et al.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Real-time air quality data from monitoring stations across London.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71273", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Breathe London\",\n        \"affiliation\": \"Environmental Agency\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://breathelondon.gov.uk/data/london-air-quality-data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71273", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Dynamics\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Academic Non-Commercial License\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Forest Monitoring in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://stanford.edu/forestdata.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes annual measurements.\"\n    }\n}"}
