{"_id": "Academic--research_data--n--67173", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Europe\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Climate Prediction Center\"\n    },\n    \"date_collected\": \"2018-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term climate trends in Europe\",\n            \"authors\": [\n                \"Jones\",\n                \"Smith\",\n                \"Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/data\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Daily weather observations from various European locations.\"\n    }\n}"}
