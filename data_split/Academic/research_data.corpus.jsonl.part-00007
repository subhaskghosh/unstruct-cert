{"_id": "Academic--research_data--n--70254", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Research Institute\",\n        \"affiliation\": \"University of Amazonas\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geographic coordinates included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70255", "text": "{\n    \"dataset_name\": \"Northwood Forest Bird Survey Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Environmental Sciences\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"bird_species\",\n            \"unit\": \"species name\"\n        },\n        {\n            \"name\": \"count\",\n            \"unit\": \"number of individuals\"\n        },\n        {\n            \"name\": \"location_latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"location_longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Point count surveys along established transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term avian population trends in Northwood Forest\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/northwood_birds.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes quality control flags for each observation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70255", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Municipal Government\"\n    },\n    \"date_collected\": \"2023-08-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pollutant\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"timestamp\",\n            \"unit\": \"datetime\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Continuous monitoring stations throughout the city\",\n    \"related_publications\": [],\n    \"download_url\": \"https://citydata.gov/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes sensor calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70256", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite-based measurements and ground station verification\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature trends since the industrial revolution\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly average temperatures for land surfaces globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70256", "text": "{\n    \"dataset_name\": \"Coral Reef Bleaching Events\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2022-06-30T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Coral Bleaching Index\",\n            \"units\": \"Dimensionless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Underwater visual surveys and satellite monitoring\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of climate change on coral reefs\",\n            \"authors\": [\n                \"Terry Hughes\",\n                \"David Bellwood\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://aims.gov.au/coral-reef-bleaching\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Dataset focusing on coral bleaching events in the Great Barrier Reef.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70257", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Data - Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Local Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_atmosphere.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70257", "text": "{\n    \"dataset_name\": \"Global Temperature Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2021-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Global Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Combination of satellite data and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Global Temperature\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Contains historical temperature data from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70258", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing using Landsat satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/\",\n    \"metadata\": {\n        \"data_size\": \"650MB\",\n        \"annotations\": \"Provides information on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70258", "text": "{\n    \"dataset_name\": \"North American Lightning Detection Network (NALDN) Data\",\n    \"creator\": {\n        \"name\": \"Vaisala\",\n        \"affiliation\": \"Vaisala Inc.\"\n    },\n    \"date_collected\": \"2021-07-22T12:34:56Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"flash_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"peak_current\",\n            \"units\": \"kA\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary - Research Use Only\",\n    \"sampling_method\": \"Ground-based lightning detection network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Lightning Activity in North America\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.vaisala.com/en/products/lightning-detection-networks\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Provides real-time and historical lightning data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70259", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (COVID-19)\",\n    \"creator\": {\n        \"name\": \"Radiology Department, Massachusetts General Hospital\",\n        \"affiliation\": \"Harvard Medical School\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"description\": \"Unique identifier for each X-ray image.\",\n            \"units\": \"string\"\n        },\n        {\n            \"variable_name\": \"patient_age\",\n            \"description\": \"Age of the patient at the time of imaging.\",\n            \"units\": \"years\"\n        },\n        {\n            \"variable_name\": \"image_quality\",\n            \"description\": \"Subjective assessment of image quality (1-5).\",\n            \"units\": \"scale\"\n        },\n        {\n            \"variable_name\": \"diagnosis\",\n            \"description\": \"Radiologist's diagnosis (e.g., COVID-19, pneumonia, normal).\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Prospective, consecutive sampling of patients presenting with respiratory symptoms.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for COVID-19 Detection on Chest X-Rays\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/covid_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-verified diagnoses\"\n    }\n}"}
{"_id": "Academic--research_data--n--70259", "text": "{\n    \"dataset_name\": \"Skin Lesion Images\",\n    \"creator\": {\n        \"name\": \"Dermatology Research Group\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"description\": \"Unique identifier for each image\",\n            \"units\": \"string\"\n        },\n        {\n            \"variable_name\": \"age\",\n            \"description\": \"Age of patient.\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"JPG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling from dermatology clinic records.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Skin Cancer Diagnosis\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Green, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/skin_lesion_dataset\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Dermatologist-labeled lesion types\"\n    }\n}"}
{"_id": "Academic--research_data--p--70260", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and City Impacts\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"City Population\",\n            \"units\": \"People\"\n        },\n        {\n            \"name\": \"Impact Score\",\n            \"units\": \"Unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global historical climate data and city demographic information.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effects and Population Vulnerability\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Includes data for major cities worldwide.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70260", "text": "{\n    \"dataset_name\": \"Historical CO2 Levels\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Government Agency\"\n    },\n    \"date_collected\": \"2018-11-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring at various locations globally.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_levels.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Global CO2 concentration data from 1958 to 2022.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70261", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Land and Ocean\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Temperature Anomaly (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Ocean Temperature Anomaly (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Global Average Temperature Anomaly (°C)\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70261", "text": "{\n    \"dataset_name\": \"Historical Weather Data - US Cities\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"US Climate Normals\",\n            \"year\": 2016\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70262", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024,\n            \"journal\": \"Nature\"\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70262", "text": "{\n    \"dataset_name\": \"Soil Composition in Agricultural Fields\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"Agricultural Research Institute\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random soil samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Fertilizer Use for Crop Yields\",\n            \"year\": 2023,\n            \"journal\": \"Agronomy Journal\"\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Location data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70263", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Comprehensive documentation available, including data dictionary and quality control procedures.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70263", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Local Ecology Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"canopy_height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Randomly selected plots within a forest ecosystem\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity of California Forests\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Limited documentation, primarily species lists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70264", "text": "{\n    \"dataset_name\": \"Urban Air Quality and Climate Change Impacts\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly recordings.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The impact of climate change on urban air quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using a Kalman filter. Contains detailed station metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70264", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Green\",\n        \"affiliation\": \"Smithsonian Institution\"\n    },\n    \"date_collected\": \"2022-07-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Tree Diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within a defined forest area.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in Amazonian forests\",\n            \"authors\": [\n                \"Green, R.\",\n                \"Silva, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes species identification and measurements of tree characteristics.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70265", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"variable_name\": \"gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"variable_name\": \"loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"variable_name\": \"stable\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"1.2 TB\",\n        \"annotations\": \"Dataset contains information on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70265", "text": "{\n    \"dataset_name\": \"Local Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM25\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ground-based sensors\",\n    \"related_publications\": [],\n    \"download_url\": \"http://cityairdata.gov/download\",\n    \"metadata\": {\n        \"data_size\": \"100 MB\",\n        \"annotations\": \"Air quality measurements from a single city.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70266", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from various locations around Lake Erie.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Nutrient Runoff on Lake Erie Ecosystem\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70266", "text": "{\n    \"dataset_name\": \"Air Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations in major cities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Urban Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"800KB\",\n        \"annotations\": \"Data has been adjusted for temperature and humidity.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70267", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Extended Reconstructions\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"Columbia University Earth Institute\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements from land and ocean stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global warming in the 21st century: An imperative for climate action\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Includes uncertainty estimates for each temperature anomaly.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70267", "text": "{\n    \"dataset_name\": \"Atmospheric Pollutant Concentrations in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Maria Rodriguez\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2021-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring at fixed urban locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of air pollution on respiratory health\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_pollutants.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags indicate potential measurement errors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70268", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2023\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Landsat satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen et al.\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_change_2023.tif\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Contains data on tree cover loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70268", "text": "{\n    \"dataset_name\": \"Historical Stock Prices 1980-2020\",\n    \"creator\": {\n        \"name\": \"Yahoo Finance\",\n        \"affiliation\": \"Yahoo!\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"open\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"close\",\n            \"units\": \"USD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Daily stock market data\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/stock_prices.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Historical stock prices for various companies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70269", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing analysis using Landsat imagery.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Dataset includes tree cover, forest loss, and gain layers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70269", "text": "{\n    \"dataset_name\": \"City Park Tree Species Inventory\",\n    \"creator\": {\n        \"name\": \"Local Parks Department\",\n        \"affiliation\": \"City of Anytown\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"diameter_at_breast_height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual field surveys of trees in city parks.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://cityofanytown.gov/parks/treeinventory\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Inventory of tree species and sizes within city parks.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70270", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels - Post 2020\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Atmospheric Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal (Public Domain Dedication)\",\n    \"sampling_method\": \"Global network of weather stations and buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70270", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - 1990-2010\",\n    \"creator\": {\n        \"name\": \"Regional Weather Authority\",\n        \"affiliation\": \"State Government\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Location ID\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Rain gauge network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Rainfall Patterns\",\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Missing data indicated by -999\"\n    }\n}"}
{"_id": "Academic--research_data--p--70271", "text": "{\n    \"dataset_name\": \"Coastal Ecosystem Health Indicators\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across coastal zones\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Climate Change on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70271", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow Analysis\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Vehicle Count\",\n            \"units\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"Average Speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring with traffic sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Traffic Signal Timing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/traffic_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been anonymized.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70272", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality in Urban Areas\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included, station locations provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70272", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots across the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Basin\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Species identification validated by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70273", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"University of Michigan Water Research Lab\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Lake Erie Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data has been quality controlled and flagged for outliers.\"\n    }\n}"}
