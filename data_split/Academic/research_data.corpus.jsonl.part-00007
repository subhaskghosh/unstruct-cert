{"_id": "Academic--research_data--p--67307", "text": "{\n    \"dataset_name\": \"Air Quality and Meteorological Data - London 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity of the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations deployed across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67307", "text": "{\n    \"dataset_name\": \"Specific Pollen Count - Manchester 2024\",\n    \"creator\": {\n        \"name\": \"Pollen Monitoring Ltd.\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2024-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Birch Pollen\",\n            \"units\": \"grains/m³\",\n            \"description\": \"Concentration of birch pollen in the air.\"\n        },\n        {\n            \"name\": \"Grass Pollen\",\n            \"units\": \"grains/m³\",\n            \"description\": \"Concentration of grass pollen in the air.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted - Contact for Usage\",\n    \"sampling_method\": \"Automated pollen traps.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/manchester_pollen.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"None\"\n    }\n}"}
{"_id": "Academic--research_data--p--67308", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Monoxide (CO)\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide (NO2)\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67308", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey - Coral Reefs\",\n    \"creator\": {\n        \"name\": \"Professor David Miller\",\n        \"affiliation\": \"University of Queensland\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Fish Abundance\",\n            \"unit\": \"individuals/m^2\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual census and photo transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coral Reef Ecosystems\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification and abundance estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67309", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"variable_name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Remote Sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 1990 to 2000\",\n            \"authors\": [\n                \"Hansen\",\n                \"etal.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_hansen_global_forest_change_2020_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains information on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67309", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate at a Glance\",\n            \"authors\": [\n                \"NOAA\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains daily weather measurements from around the world.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67310", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - v4\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Ice Concentration\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data derived from land and sea-based observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature update: 2021\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/access/monitoring/climate-at-a-glance/global/time-series\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Contains quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67310", "text": "{\n    \"dataset_name\": \"Historical Weather Data - City Centers\",\n    \"creator\": {\n        \"name\": \"Weather Analytics Inc.\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percent\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Commercial\",\n    \"sampling_method\": \"Automated weather stations in major cities.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://weatheranalytics.com/data\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67311", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring - UK\",\n    \"creator\": {\n        \"name\": \"Environment Agency\",\n        \"affiliation\": \"UK Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government Licence v3.0\",\n    \"sampling_method\": \"Regular grab samples from designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Assessment in UK Rivers\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://environment.data.gov.uk/river-water-quality\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67311", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas - Germany\",\n    \"creator\": {\n        \"name\": \"German Federal Environment Agency\",\n        \"affiliation\": \"German Government\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring using automated sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends in Germany\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://luftdaten.de/urban-air-quality\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data includes sensor calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67312", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network - Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Maximum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in global temperature and precipitation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67312", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis - Climate Change\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Sociology\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"Text\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Twitter API data collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public perception of climate change on Twitter\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/social-media-climate-data\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Sentiment analysis labels\"\n    }\n}"}
{"_id": "Academic--research_data--p--67313", "text": "{\n    \"dataset_name\": \"Global Forest Watch Climate Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"units\": \"tonnes CO2e\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis combined with ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch monitoring and reporting\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data covers 2000-present. Includes annual summaries.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67313", "text": "{\n    \"dataset_name\": \"Short-Term Rainfall Patterns in Urban Areas\",\n    \"creator\": {\n        \"name\": \"City Weather Initiative\",\n        \"affiliation\": \"Urban Research Group\"\n    },\n    \"date_collected\": \"2023-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Rainfall Duration\",\n            \"units\": \"minutes\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Automated weather stations within city limits\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rainfall on Urban Flooding\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"http://cityweather.org/data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data collected over a 3-month period during the summer of 2023.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67314", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages\"\n    }\n}"}
