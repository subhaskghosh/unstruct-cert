{"_id": "Academic--research_data--p--68109", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations distributed throughout central London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68109", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Health - Amazon 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Javier Silva\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements in remote Amazonian rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ecosystem Health in the Amazon Basin\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data derived from remote sensing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68110", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags are included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68110", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"NASA Earth Exchange\",\n        \"affiliation\": \"Remote Sensing Group\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\",\n            \"description\": \"Estimated aboveground biomass of forests.\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\",\n            \"description\": \"Classification of forest type.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Biomass Estimates\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is based on LiDAR and radar observations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68111", "text": "{\n    \"dataset_name\": \"Stream Water Quality Monitoring - Colorado\",\n    \"creator\": {\n        \"name\": \"Colorado Department of Public Health and Environment\",\n        \"affiliation\": \"CDPHE\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Grab samples collected monthly from designated stream locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Colorado Stream Water Quality Assessment\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/colorado_stream_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
