{"_id": "Academic--research_data--p--71531", "text": "{\n    \"dataset_name\": \"LIDC-IDRI Lung Nodule Detection\",\n    \"creator\": {\n        \"name\": \"The Cancer Imaging Archive (TCIA)\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"ImageID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"PatientID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"NoduleDiameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"NoduleLocation\",\n            \"units\": \"anatomical region\"\n        },\n        {\n            \"variable_name\": \"MalignancyProbability\",\n            \"units\": \"0-1\"\n        },\n        {\n            \"variable_name\": \"ImageOrientation\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"CT scans from multiple institutions\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Lung Image Database Consortium image collection: 1570 subjects and corresponding pathologically confirmed diagnoses\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://www.cancerimagingarchive.net/ncia/LIDC-IDRI\",\n    \"metadata\": {\n        \"data_size\": \"150 GB\",\n        \"annotations\": \"Radiologist-annotated nodule locations and characteristics\"\n    }\n}"}
