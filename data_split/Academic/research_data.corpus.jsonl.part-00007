{"_id": "Academic--research_data--p--68944", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"OpenAQ\",\n        \"affiliation\": \"Open Source Air Quality Network\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Air Pollution\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://openaq.org/data\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68944", "text": "{\n    \"dataset_name\": \"Historical Climate Data - CO2 Levels\",\n    \"creator\": {\n        \"name\": \"NOAA\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2018-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\",\n            \"description\": \"Atmospheric carbon dioxide concentration\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term CO2 Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.esrl.noaa.gov/gmd/ccgg/trends/\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data gaps present, requiring interpolation\"\n    }\n}"}
{"_id": "Academic--research_data--p--68945", "text": "{\n    \"dataset_name\": \"Air Quality and Temperature Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effect and Air Pollution Correlation\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/urban_air_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68945", "text": "{\n    \"dataset_name\": \"Lake Water Quality Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH Level\",\n            \"units\": \"\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Discrete water samples collected from various lake locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Eutrophication and Water Quality in Freshwater Lakes\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/lake_water_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data validated by laboratory analysis\"\n    }\n}"}
{"_id": "Academic--research_data--p--68946", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_Europe\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"O3 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across Europe\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe – 2023 Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_europe.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68946", "text": "{\n    \"dataset_name\": \"WaterQualityAssessment_USA\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"USGS\"\n    },\n    \"date_collected\": \"2018-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Weekly water samples from rivers and lakes\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/waterquality_usa.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes location information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68947", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensor stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data is quality-controlled and includes metadata about sensor calibration.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68947", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns\",\n    \"creator\": {\n        \"name\": \"National Weather Service\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily readings from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes historical temperature and precipitation records.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68948", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Science Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Traffic on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68948", "text": "{\n    \"dataset_name\": \"Oceanographic Data from the Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Oregon State University\"\n    },\n    \"date_collected\": \"2024-01-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\",\n            \"description\": \"Practical salinity units.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Water temperature.\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Research vessel deployments.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Ocean Currents and Mixing\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Calibration information included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68949", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_2022\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Environmental Science Department\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Wildfires on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_berkeley.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
