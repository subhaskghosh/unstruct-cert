{"_id": "Academic--research_data--p--67106", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Radiology Data Consortium\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-06-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Pneumonia Status\",\n            \"unit\": \"boolean\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"unit\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective collection from hospital archives\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/pneumonia_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Expert radiologist labels\"\n    }\n}"}
{"_id": "Academic--research_data--n--67106", "text": "{\n    \"dataset_name\": \"MRI Brain Scans for Tumor Segmentation\",\n    \"creator\": {\n        \"name\": \"Neuroimaging Research Group\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2023-08-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Tumor Location\",\n            \"unit\": \"coordinates\"\n        },\n        {\n            \"name\": \"Patient Gender\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective study with informed consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Tumor Segmentation using CNNs\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_dataset\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Manual segmentations by neuro-oncologists\"\n    }\n}"}
