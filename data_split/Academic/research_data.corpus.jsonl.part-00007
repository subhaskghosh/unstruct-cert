{"_id": "Academic--research_data--p--66537", "text": "{\n    \"dataset_name\": \"Brain MRI Segmentation Dataset\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Tumor Volume\",\n            \"units\": \"cm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Random sampling from hospital patient records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Manual segmentations by expert radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--66537", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images\",\n    \"creator\": {\n        \"name\": \"Alice Brown\",\n        \"affiliation\": \"University Hospital\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"X-Ray Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Patient Gender\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective collection from emergency room patients\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"authors\": [\n                \"Brown, A.\",\n                \"Davis, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Radiologist reports\"\n    }\n}"}
{"_id": "Academic--research_data--p--66538", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global grid of land and ocean measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes monthly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66538", "text": "{\n    \"dataset_name\": \"Ocean Current Measurements\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"WHOI\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ocean Current Velocity\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Autonomous underwater vehicle surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Circulation Patterns\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data represents high-resolution current profiles.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66539", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2020 Onwards\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Global Mean Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Mean Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Contains temperature anomalies relative to a base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66539", "text": "{\n    \"dataset_name\": \"Historical Climate Data - 1950-2019\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"degrees Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Station-based observations, daily data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Climate Trends\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"5.5 GB\",\n        \"annotations\": \"Provides historical climate data from around the world.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66540", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes annual average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66540", "text": "{\n    \"dataset_name\": \"Historical CO2 Levels\",\n    \"creator\": {\n        \"name\": \"NOAA Earth System Research Laboratories\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Atmospheric measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data represents monthly average CO2 concentrations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66541", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"U.S. Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Global Warming Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality controlled data\"\n    }\n}"}
