{"_id": "Academic--research_data--n--68273", "text": "{\n    \"dataset_name\": \"Global Climate Model Output\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"NCAR\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Model output from a global climate simulation.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Model data with various resolution levels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68274", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"ug/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors and manual water samples collected weekly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68274", "text": "{\n    \"dataset_name\": \"Coastal Marine Ecosystem Survey\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2024-04-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel transects and buoy deployments.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Marine ecosystem dynamics in the Gulf of Mexico\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/coastalmarine_survey.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes spatial coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68275", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change in the Arctic\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring from research station\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Climate Change Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68275", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Area\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Gain/Loss\",\n            \"units\": \"hectares/year\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing using satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Change\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.geojson\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data derived from Landsat imagery.\"\n    }\n}"}
