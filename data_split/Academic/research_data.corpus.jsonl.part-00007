{"_id": "Academic--research_data--p--71128", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"variable_name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality/london-air-quality-monitoring-2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"15.5MB\",\n        \"annotations\": \"Data cleaned and validated against EU standards.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71128", "text": "{\n    \"dataset_name\": \"River Water Quality Assessment - Thames 2023\",\n    \"creator\": {\n        \"name\": \"Environment Agency\",\n        \"affiliation\": \"Water Quality Division\"\n    },\n    \"date_collected\": \"2023-09-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Amount of oxygen dissolved in water.\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"unitless\",\n            \"description\": \"Acidity or alkalinity of the water.\"\n        },\n        {\n            \"variable_name\": \"Nitrate\",\n            \"units\": \"mg/L\",\n            \"description\": \"Nitrate concentration in water.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Government License\",\n    \"sampling_method\": \"Regular sampling at designated points along the river\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Report - Thames River\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://environment.gov.uk/waterquality/thames-river-data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71129", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71129", "text": "{\n    \"dataset_name\": \"Schoolyard Air Quality Experiment - 2022\",\n    \"creator\": {\n        \"name\": \"Local High School Science Club\",\n        \"affiliation\": \"High School\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\",\n            \"description\": \"Carbon Dioxide levels near school.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Manual measurements once a week\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/school_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Limited data quality control\"\n    }\n}"}
{"_id": "Academic--research_data--p--71130", "text": "{\n    \"dataset_name\": \"Freshwater Lake Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley - Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Lake Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71130", "text": "{\n    \"dataset_name\": \"Coastal Ocean Salinity Data\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Jones\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA-4.0\",\n    \"sampling_method\": \"Continuous measurements from a buoy.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanographic Currents and Salinity Variations\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_salinity_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been calibrated against standard seawater samples.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71131", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"bird_species\",\n            \"units\": \"species name\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Automated tracking with GPS loggers attached to birds\",\n    \"related_publications\": [\n        {\n            \"title\": \"Migration Patterns of North American Songbirds\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags for GPS accuracy\"\n    }\n}"}
{"_id": "Academic--research_data--n--71131", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Private Research Firm\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"location\",\n            \"units\": \"coordinates\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary - No Commercial Use\",\n    \"sampling_method\": \"Data aggregated from global weather stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Aggregated monthly averages\"\n    }\n}"}
