{"_id": "Academic--research_data--n--67731", "text": "{\n    \"dataset_name\": \"Urban Heat Island Effect Study - Boston\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Boston University\"\n    },\n    \"date_collected\": \"2019-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"building_density\",\n            \"units\": \"buildings per square kilometer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ground-based sensor network, localized measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"The effects of urban geometry on local temperature\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"http://example.com/boston_uhi_data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data focuses on a specific city and its immediate surroundings.\"\n    }\n}"}
