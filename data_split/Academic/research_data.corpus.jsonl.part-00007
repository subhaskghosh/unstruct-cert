{"_id": "Academic--research_data--n--68501", "text": "{\n    \"dataset_name\": \"Industrial Effluent Monitoring - Emergency Spill\",\n    \"creator\": {\n        \"name\": \"River Authority Monitoring Team\",\n        \"affiliation\": \"State Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Grab samples collected immediately following a spill event.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rapid assessment of water quality following an industrial accident.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/spill_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data collected under emergency response protocols.\"\n    }\n}"}
