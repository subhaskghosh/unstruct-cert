{"_id": "Academic--research_data--n--67153", "text": "{\n    \"dataset_name\": \"North Atlantic Ocean Temperature and Salinity\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Department of Oceanography\"\n    },\n    \"date_collected\": \"2022-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Sea Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Ship-based measurements and buoy deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in the North Atlantic Subtropical Gyre\",\n            \"authors\": [\n                \"Smeed, E.A.\",\n                \"Johns, W.E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.whoi.edu/oceanus/data/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data calibrated against standard seawater samples.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67154", "text": "{\n    \"dataset_name\": \"AirQuality_London_2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Network\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in parts per billion.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government Licence\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution and Respiratory Health in London\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67154", "text": "{\n    \"dataset_name\": \"TrafficNoise_CityCenter_2022\",\n    \"creator\": {\n        \"name\": \"City Planning Department\",\n        \"affiliation\": \"Urban Research Institute\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"NoiseLevel\",\n            \"units\": \"dB\",\n            \"description\": \"Average sound pressure level in decibels.\"\n        },\n        {\n            \"variable_name\": \"TrafficVolume\",\n            \"units\": \"vehicles/hour\",\n            \"description\": \"Number of vehicles passing a given point per hour.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Spot measurements at various locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Noise Pollution on City Residents\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/trafficnoise_citycenter_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Location data included.\"\n    }\n}"}
