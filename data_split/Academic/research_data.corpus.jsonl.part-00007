{"_id": "Academic--research_data--p--69209", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Recent\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global gridded data from weather stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69209", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA PMEL\",\n        \"affiliation\": \"Pacific Marine Environmental Laboratory\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Discrete water samples collected from research vessels.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification in the Pacific Ocean\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.pmel.noaa.gov/oa/\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"High-resolution measurements of ocean pH.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69210", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Warming Trends\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\",\n                \"Brown\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains global temperature anomaly data from 1880-2023\"\n    }\n}"}
{"_id": "Academic--research_data--n--69210", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Discrete water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of CO2 on Ocean pH\",\n            \"authors\": [\n                \"Williams\",\n                \"Davis\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_acidification.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Measurements of ocean pH and salinity\"\n    }\n}"}
{"_id": "Academic--research_data--p--69211", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2020-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes land and ocean temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69211", "text": "{\n    \"dataset_name\": \"Historical Weather Data - North America\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Hourly observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"North American Climate Variability\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data covers major North American cities.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69212", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 1970-2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Year\",\n            \"units\": \"Year\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been quality controlled and missing values have been interpolated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69212", "text": "{\n    \"dataset_name\": \"City Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"Government Research Lab\"\n    },\n    \"date_collected\": \"2022-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Pollutant\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Concentration\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous air quality monitoring stations in major cities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution\",\n            \"authors\": [\n                \"Brown, A.\",\n                \"Davis, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes hourly average pollutant concentrations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69213", "text": "{\n    \"dataset_name\": \"Air Quality and Temperature Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"ozone_level\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy\"\n    }\n}"}
{"_id": "Academic--research_data--n--69213", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Assessment\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"carbon_stock\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"forest_area\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-SA-3.0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes uncertainty estimates\"\n    }\n}"}
{"_id": "Academic--research_data--p--69214", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Global grid of land and ocean stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": \"GISS Team\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69214", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity\",\n    \"creator\": {\n        \"name\": \"INPA Research Group\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA-4.0\",\n    \"sampling_method\": \"Random sampling across the Amazon basin\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon\",\n            \"authors\": \"INPA Team\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://inpa.gov.br/biodiversity/\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Contains species counts and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69215", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements in the Arctic\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2021-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring with automated sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic CO2 Trends and Climate Feedback\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flagged based on sensor calibration\"\n    }\n}"}
{"_id": "Academic--research_data--n--69215", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2019-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Warming Patterns\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69216", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"patient_age\",\n            \"units\": \"years\"\n        },\n        {\n            \"variable_name\": \"image_resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"variable_name\": \"MRI_scan_type\",\n            \"units\": \"type\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Manually annotated tumor regions\"\n    }\n}"}
{"_id": "Academic--research_data--n--69216", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"patient_id\",\n            \"units\": \"ID\"\n        },\n        {\n            \"variable_name\": \"image_file_path\",\n            \"units\": \"path\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Detection of Pneumonia\",\n            \"authors\": \"Lee, D. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Radiologist reports\"\n    }\n}"}
{"_id": "Academic--research_data--p--69217", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69217", "text": "{\n    \"dataset_name\": \"Water Quality Assessment of Rivers\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Grab samples collected weekly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Agricultural Runoff on Water Quality\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/waterqualitydata.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Sample locations geocoded\"\n    }\n}"}
{"_id": "Academic--research_data--p--69218", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"MRI_Image_ID\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"Tumor_Size\",\n            \"unit\": \"mm^3\"\n        },\n        {\n            \"variable_name\": \"Lesion_Location\",\n            \"unit\": \"coordinates\"\n        },\n        {\n            \"variable_name\": \"Patient_Age\",\n            \"unit\": \"years\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Random sampling of patients undergoing MRI scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Segmentation masks for tumors\"\n    }\n}"}
{"_id": "Academic--research_data--n--69218", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-04-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"XRay_Image_ID\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"Patient_Gender\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"variable_name\": \"Pneumonia_Diagnosis\",\n            \"unit\": \"boolean\"\n        },\n        {\n            \"variable_name\": \"Patient_Age\",\n            \"unit\": \"years\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Prospective collection of patients presenting with respiratory symptoms\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Pneumonia Detection from Chest X-rays\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray.csv\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Bounding boxes for pneumonia regions\"\n    }\n}"}
