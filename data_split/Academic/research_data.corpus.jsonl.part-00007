{"_id": "Academic--research_data--n--71274", "text": "{\n    \"dataset_name\": \"LakeWaterSamples_2021\",\n    \"creator\": {\n        \"name\": \"Local High School Science Club\",\n        \"affiliation\": \"Springfield High School\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Clarity\",\n            \"units\": \"Qualitative - Clear/Cloudy\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Manual water sample collection - weekly\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/lake_samples_2021.xlsx\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Basic water quality assessment.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71275", "text": "{\n    \"dataset_name\": \"Freshwater Lake Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Minnesota, Limnology Department\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 different locations in the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in freshwater lake quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71275", "text": "{\n    \"dataset_name\": \"Coastal Oceanographic Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"Scripps Institution of Oceanography\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous measurements from a research vessel along a transect.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean current dynamics in the California Current System\",\n            \"authors\": [\n                \"Davis, R.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data has been corrected for instrument drift.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71276", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Civil, Environmental and Geomatic Engineering\"\n    },\n    \"date_collected\": \"2023-05-10T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic Emissions on Air Quality in Urban Environments\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"7.5MB\",\n        \"annotations\": \"Data quality flags included. Missing values are represented as NaN.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71276", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Carbon Fluxes - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research (INPA)\"\n    },\n    \"date_collected\": \"2021-11-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol m⁻² s⁻¹\"\n        },\n        {\n            \"name\": \"Water Vapor Flux\",\n            \"units\": \"mmol m⁻² s⁻¹\"\n        },\n        {\n            \"name\": \"Photosynthetic Rate\",\n            \"units\": \"µmol m⁻² s⁻¹\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Eddy covariance measurements in a primary rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Dynamics of Amazonian Forests\",\n            \"year\": 2022,\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_carbon_fluxes.json\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71277", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Nitrogen dioxide concentration.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations distributed throughout Greater London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71277", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Society\",\n        \"affiliation\": \"Research Department\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"SpeciesCount\",\n            \"units\": \"count\",\n            \"description\": \"Number of identified species in a given plot.\"\n        },\n        {\n            \"variable_name\": \"TreeDensity\",\n            \"units\": \"trees/ha\",\n            \"description\": \"Number of trees per hectare.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Rainforest Biodiversity\",\n            \"year\": 2020,\n            \"authors\": [\n                \"Davis, B.\",\n                \"Wilson, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"GPS coordinates included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71278", "text": "{\n    \"dataset_name\": \"Arctic Temperature Trends\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Polar Research Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Ice Thickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Impact of Arctic Warming on Global Climate\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--71278", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"University of Environmental Studies\"\n    },\n    \"date_collected\": \"2019-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Stock\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Sequestration in Tropical Forests\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.json\",\n    \"metadata\": {\n        \"data_size\": \"8GB\",\n        \"annotations\": \"Data includes uncertainty estimates\"\n    }\n}"}
{"_id": "Academic--research_data--p--71279", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information (NCEI)\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global surface temperature observations from land and ocean stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Surface Temperature Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-summary-of-the-day/access/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Quality controlled temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71279", "text": "{\n    \"dataset_name\": \"Climate Model Output - CMIP6\",\n    \"creator\": {\n        \"name\": \"Coupled Model Intercomparison Project\",\n        \"affiliation\": \"World Climate Research Programme\"\n    },\n    \"date_collected\": \"2022-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Climate model simulations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Model Documentation\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Output from multiple climate models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71280", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Measurements from the Arctic\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from research station\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Arctic Atmospheric Composition\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_composition_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"550MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
