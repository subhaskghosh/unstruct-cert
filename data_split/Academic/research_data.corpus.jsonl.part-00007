{"_id": "Academic--research_data--p--71808", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Sensor Data\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, University of Tech\",\n        \"affiliation\": \"University of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring using low-cost sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predicting Air Quality using Machine Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data is quality checked and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71808", "text": "{\n    \"dataset_name\": \"National Forest Health Assessment\",\n    \"creator\": {\n        \"name\": \"US Forest Service\",\n        \"affiliation\": \"United States Government\"\n    },\n    \"date_collected\": \"2023-06-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Forest Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Remote sensing and field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Trends in the US\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://governmentdata.gov/forest_health.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data covers the entire US national forest system.\"\n    }\n}"}
