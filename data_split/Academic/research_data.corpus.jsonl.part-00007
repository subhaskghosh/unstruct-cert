{"_id": "Academic--research_data--p--70598", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, University College London\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_ppb\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"pm25_ugm3\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"temperature_celsius\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70598", "text": "{\n    \"dataset_name\": \"SoilMoisture_Iowa_2023\",\n    \"creator\": {\n        \"name\": \"Iowa State University Agricultural Department\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"soil_moisture_percentage\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"soil_temperature_celsius\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"gps_latitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Field measurements at regular intervals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil moisture dynamics in Iowa\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/iowa_soil_moisture.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes sensor calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70599", "text": "{\n    \"dataset_name\": \"Lung CT Scan Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Research Group\",\n        \"affiliation\": \"University Hospital\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tumor Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Nodule Volume\",\n            \"units\": \"mm^3\"\n        },\n        {\n            \"name\": \"Lung Capacity\",\n            \"units\": \"liters\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Prospective clinical study with informed consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Early Detection of Lung Nodules using CT Imaging\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_ct_scan_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Radiologist-verified annotations for nodule detection\"\n    }\n}"}
{"_id": "Academic--research_data--n--70599", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Neurology Imaging Lab\",\n        \"affiliation\": \"National Institute of Health\"\n    },\n    \"date_collected\": \"2023-08-20T14:45:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Brain Volume\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"Cortical Thickness\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"White Matter Lesion Load\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of existing MRI scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Alzheimer's Disease Progression and Brain Volume Changes\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Automated segmentation of brain regions\"\n    }\n}"}
{"_id": "Academic--research_data--p--70600", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Geographic Location\",\n            \"units\": \"Latitude, Longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and ocean buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Change Course\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70600", "text": "{\n    \"dataset_name\": \"Projected Climate Change Scenarios\",\n    \"creator\": {\n        \"name\": \"Intergovernmental Panel on Climate Change\",\n        \"affiliation\": \"IPCC\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Projected Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Projected Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sixth Assessment Report\",\n            \"authors\": [\n                \"IPCC Authors\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ipcc.ch/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Results from various climate models under different emission scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70601", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Deforestation Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute for Space Research (INPE)\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Deforestation Area (km²)\",\n            \"units\": \"km²\"\n        },\n        {\n            \"name\": \"Forest Cover (%)\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis with ground truthing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Monitoring Deforestation in the Amazon Basin\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_deforestation.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes annotations for deforestation events.\"\n    }\n}"}
