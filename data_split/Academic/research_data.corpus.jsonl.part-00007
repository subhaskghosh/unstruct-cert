{"_id": "Academic--research_data--p--67301", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentration Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2023\",\n            \"authors\": [\n                \"Friedlingstein, P.\",\n                \"O'Sullivan, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://gmd.noaa.gov/data/co2/\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
