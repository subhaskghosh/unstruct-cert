{"_id": "Academic--research_data--n--69038", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mL/L\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-based measurements of ocean water chemistry.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Monitoring Ocean Acidification\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.pmel.noaa.gov/oa/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Measurements from various ocean locations.\"\n    }\n}"}
