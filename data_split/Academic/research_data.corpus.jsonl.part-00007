{"_id": "Academic--research_data--n--70707", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center (NSIDC)\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2019-12-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"millions of square kilometers\"\n        },\n        {\n            \"name\": \"Month\",\n            \"units\": \"numerical representation\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0 International\",\n    \"sampling_method\": \"Satellite observations, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Decline\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/sea_ice.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Basic documentation provided.\"\n    }\n}"}
