{"_id": "Academic--research_data--p--68534", "text": "{\n    \"dataset_name\": \"Solar Panel Performance Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Panel Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Power Output\",\n            \"unit\": \"Watts\"\n        },\n        {\n            \"name\": \"Irradiance\",\n            \"unit\": \"W/m^2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring of solar panel arrays\",\n    \"related_publications\": [\n        {\n            \"title\": \"Efficiency of Novel Solar Panel Designs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/solar_panel_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and preprocessed for time series analysis\"\n    }\n}"}
{"_id": "Academic--research_data--n--68534", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution Levels\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"Harvard University\"\n    },\n    \"date_collected\": \"2022-12-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m^3\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Air quality monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Pollution on Public Health\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/pollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Raw data from air quality sensors\"\n    }\n}"}
{"_id": "Academic--research_data--p--68535", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed.\"\n    }\n}"}
