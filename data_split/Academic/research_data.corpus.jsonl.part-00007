{"_id": "Academic--research_data--p--69955", "text": "{\n    \"dataset_name\": \"CardioMRI Segmentation Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"pixel_spacing\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"ventricle_volume\",\n            \"units\": \"cm^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective analysis of cardiac MRI scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Segmentation of Cardiac Structures\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/cardio_mri_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5GB\",\n        \"annotations\": \"Manual segmentations by expert radiologists\"\n    }\n}"}
