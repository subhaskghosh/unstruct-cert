{"_id": "Academic--research_data--p--71127", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global observational network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Change Course\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Quality controlled temperature data\"\n    }\n}"}
