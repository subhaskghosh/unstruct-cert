{"_id": "Academic--research_data--n--67888", "text": "{\n    \"dataset_name\": \"Historical Rainfall Patterns in Amazon\",\n    \"creator\": {\n        \"name\": \"University of Sao Paulo\",\n        \"affiliation\": \"USP\"\n    },\n    \"date_collected\": \"2019-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Rain gauge measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall trends in the Amazon basin\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"http://example.com/amazon_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Regional rainfall data\"\n    }\n}"}
{"_id": "Academic--research_data--p--67889", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Monthly mean surface temperature anomalies.\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Latitude of the measurement point.\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Longitude of the measurement point.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, based on station measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Transform Energy Policies\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Includes uncertainty estimates for temperature anomalies.\"\n    }\n}"}
