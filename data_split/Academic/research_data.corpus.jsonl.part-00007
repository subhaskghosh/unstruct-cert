{"_id": "Academic--research_data--n--67977", "text": "{\n    \"dataset_name\": \"Industrial Emissions Data\",\n    \"creator\": {\n        \"name\": \"Acme Corp\",\n        \"affiliation\": \"Acme Corporation Headquarters\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NOx\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Stack emission testing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Emission Control Technologies\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://acmecorp.com/emissions.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Raw emission readings.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67978", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"variable_name\": \"time\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature in 2020\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67978", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"Mark Serreze\",\n        \"affiliation\": \"National Snow and Ice Data Center\"\n    },\n    \"date_collected\": \"2019-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"sea_ice_extent\",\n            \"units\": \"millions of square kilometers\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Non-Commercial License\",\n    \"sampling_method\": \"Satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Arctic Sea Ice\",\n            \"authors\": [\n                \"Serreze, M.\",\n                \"Meier, W.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/sea_ice_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Satellite metadata included\"\n    }\n}"}
{"_id": "Academic--research_data--p--67979", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"time\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Reduce Emissions\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Temperature anomalies relative to the 1951-1980 base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67979", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"crop_yield\",\n            \"units\": \"tons per hectare\"\n        },\n        {\n            \"name\": \"country\",\n            \"units\": \"ISO country code\"\n        },\n        {\n            \"name\": \"year\",\n            \"units\": \"YYYY\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"FAO Data License\",\n    \"sampling_method\": \"National agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"The State of Food and Agriculture\",\n            \"authors\": [\n                \"FAO Staff\"\n            ]\n        }\n    ],\n    \"download_url\": \"http://www.fao.org/faostat/en/#data\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Annual crop production data.\"\n    }\n}"}
