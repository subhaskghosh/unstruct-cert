{"_id": "Academic--research_data--n--69020", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based salinity measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity Variations in the Atlantic\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data includes salinity measurements at various depths.\"\n    }\n}"}
