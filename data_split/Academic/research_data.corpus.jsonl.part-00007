{"_id": "Academic--research_data--p--70313", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-02-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Warming\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70313", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - 1990-2000\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Meteorological Agency\"\n    },\n    \"date_collected\": \"2000-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Weather Variations\",\n            \"year\": 2001\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Historical weather data for various regions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70314", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70314", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Woods Hole\"\n    },\n    \"date_collected\": \"2022-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phytoplankton Density\",\n            \"units\": \"cells/mL\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Marine Biodiversity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Metadata includes location details\"\n    }\n}"}
{"_id": "Academic--research_data--p--70315", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 10 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide gas.\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of sulfur dioxide gas.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70315", "text": "{\n    \"dataset_name\": \"Bird Species Observations\",\n    \"creator\": {\n        \"name\": \"Ornithology Society\",\n        \"affiliation\": \"Local Audubon Chapter\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Identified bird species.\"\n        },\n        {\n            \"name\": \"Observation Count\",\n            \"units\": \"count\",\n            \"description\": \"Number of individuals observed.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bird Migration Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_observations.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data collected by volunteer observers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70316", "text": "{\n    \"dataset_name\": \"Alpine Meadow Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Evelyn Hayes\",\n        \"affiliation\": \"University of Colorado, Boulder\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"unit\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random stratified sampling across five alpine meadows.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Alpine Meadows\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/alpine_meadow_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes species identification codes.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70316", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Analysis\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Heavy Metal Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Regular sampling from wastewater outflow points.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Industrial Effluent on Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/wastewater_analysis.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes standard methods used for analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70317", "text": "{\n    \"dataset_name\": \"Global Air Quality and Climate Change Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Impact of PM2.5 on Global Climate Patterns\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_climate.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70317", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data in Africa\",\n    \"creator\": {\n        \"name\": \"David Okoro\",\n        \"affiliation\": \"Kenya Meteorological Department\"\n    },\n    \"date_collected\": \"2018-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Rain gauge network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Trends in East Africa\",\n            \"authors\": [\n                \"Okoro, D.\",\n                \"Mwangi, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_africa.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Missing data values are represented as NaN.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70318", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"ha\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing using Landsat satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen et al.\",\n            \"journal\": \"Nature Climate Change\"\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Contains annual tree cover loss and gain data\"\n    }\n}"}
