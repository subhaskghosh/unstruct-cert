{"_id": "Academic--research_data--p--70501", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface observations from land and ocean stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/tool/MRY/dataset/GISTEMP/doc/V4/CSV\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70501", "text": "{\n    \"dataset_name\": \"Climate Model Simulations - CMIP6\",\n    \"creator\": {\n        \"name\": \"Coupled Model Intercomparison Project\",\n        \"affiliation\": \"World Climate Research Programme\"\n    },\n    \"date_collected\": \"2022-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Output from various climate models\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Model Documentation\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"2TB\",\n        \"annotations\": \"Model output data from multiple climate centers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70502", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
