{"_id": "Academic--research_data--n--70024", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"USDA National Agricultural Statistics Service\",\n        \"affiliation\": \"USDA\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Crop Type\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Crop Production in the US\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes estimated yields.\"\n    }\n}"}
