{"_id": "Academic--research_data--n--66344", "text": "{\n    \"dataset_name\": \"Historical Weather Data - 1990-2020\",\n    \"creator\": {\n        \"name\": \"National Weather Service\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2020-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\",\n            \"description\": \"Wind speed in meters per second.\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\",\n            \"description\": \"Amount of precipitation in millimeters.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily averages from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Trends in North America\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Missing values represented as NaN.\"\n    }\n}"}
