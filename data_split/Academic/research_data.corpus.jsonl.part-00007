{"_id": "Academic--research_data--n--70669", "text": "{\n    \"dataset_name\": \"UrbanAirQuality_London\",\n    \"creator\": {\n        \"name\": \"London Environmental Agency\",\n        \"affiliation\": \"Greater London Authority\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"nitrogen_dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"particulate_matter_2.5\",\n            \"units\": \"ug/m^3\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations throughout London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality trends in London\",\n            \"authors\": \"Smith, J. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data includes hourly air quality measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70670", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains monthly temperature anomalies from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70670", "text": "{\n    \"dataset_name\": \"North Pacific Ocean Phytoplankton Biomass\",\n    \"creator\": {\n        \"name\": \"University of Washington Oceanography Department\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PhytoplanktonBiomass\",\n            \"units\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Ship-based measurements and satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Phytoplankton dynamics in the North Pacific\",\n            \"authors\": [\n                \"John Smith\",\n                \"Jane Doe\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://oceanography.washington.edu/data/phytoplankton\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Dataset on phytoplankton biomass in the North Pacific Ocean.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70671", "text": "{\n    \"dataset_name\": \"CardioMRI Segmentation Challenge Dataset\",\n    \"creator\": {\n        \"name\": \"Medical Imaging Group, University of California San Francisco\",\n        \"affiliation\": \"UCSF\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ImageID\",\n            \"unit\": \"string\",\n            \"description\": \"Unique identifier for each MRI image.\"\n        },\n        {\n            \"name\": \"PixelData\",\n            \"unit\": \"pixel values\",\n            \"description\": \"MRI image pixel data.\"\n        },\n        {\n            \"name\": \"SegmentationMask\",\n            \"unit\": \"pixel values\",\n            \"description\": \"Ground truth segmentation mask for cardiac structures.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective collection from clinical MRI scans.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Cardiac Segmentation with Deep Learning\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/cardioMRI.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Expert cardiologist annotations\"\n    }\n}"}
{"_id": "Academic--research_data--n--70671", "text": "{\n    \"dataset_name\": \"Patient Demographics and Treatment Outcomes\",\n    \"creator\": {\n        \"name\": \"Health Analytics Inc.\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2023-08-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PatientID\",\n            \"unit\": \"integer\",\n            \"description\": \"Unique patient identifier.\"\n        },\n        {\n            \"name\": \"Age\",\n            \"unit\": \"years\",\n            \"description\": \"Patient's age.\"\n        },\n        {\n            \"name\": \"TreatmentType\",\n            \"unit\": \"categorical\",\n            \"description\": \"Type of medical treatment received.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Electronic health record data extraction.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predictive Modeling of Treatment Response\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/patient_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"None\"\n    }\n}"}
{"_id": "Academic--research_data--p--70672", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes anomalies relative to a 1951-1980 baseline.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70672", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa State University Agricultural Department\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2023-10-27T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Soybean Yield\",\n            \"units\": \"bushels/acre\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"County-level surveys, annual data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Iowa Crop Production\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/iowa_crops.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data represents average yields per county.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70673", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Development on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70673", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Assessment - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. David Wilson\",\n        \"affiliation\": \"Oregon State University, College of Oceanic and Atmospheric Sciences\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Research vessel transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Marine Biodiversity\",\n            \"authors\": [\n                \"Wilson, D.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data collected during a two-month expedition.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70674", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - PM2.5\",\n    \"creator\": {\n        \"name\": \"Environmental Science Lab, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70674", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"National Parks Service\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random plot sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in National Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species identification validated by experts\"\n    }\n}"}
{"_id": "Academic--research_data--p--70675", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Brown, A.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70675", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree_Density\",\n            \"units\": \"trees/ha\",\n            \"description\": \"Number of trees per hectare.\"\n        },\n        {\n            \"name\": \"Leaf_Area_Index\",\n            \"units\": \"dimensionless\",\n            \"description\": \"Measure of foliage density.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Remote sensing and field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Impacts on Amazonian Ecosystems\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Satellite imagery metadata included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70676", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature Anomalies\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags are included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70676", "text": "{\n    \"dataset_name\": \"Urban Air Quality in London\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous air quality monitoring stations across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is hourly averaged.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70677", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70677", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"Air Quality Division\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at urban monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic on urban air quality\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
