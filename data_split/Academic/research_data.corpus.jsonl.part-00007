{"_id": "Academic--research_data--n--69595", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution Levels in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Ecology and Environment Bureau\",\n        \"affiliation\": \"Government of Beijing\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"SO2 Concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Assessment in Beijing\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Includes data quality control information\"\n    }\n}"}
