{"_id": "Academic--research_data--n--68779", "text": "{\n    \"dataset_name\": \"Historical Agricultural Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization of the United Nations (FAO)\",\n        \"affiliation\": \"Statistics Division\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"unit\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Rice Yield\",\n            \"unit\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Corn Yield\",\n            \"unit\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"National agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"The State of Food and Agriculture\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"http://www.fao.org/faostat/en/#data\",\n    \"metadata\": {\n        \"data_size\": \"5 MB\",\n        \"annotations\": \"Data includes annual yields for major crops.\"\n    }\n}"}
