{"_id": "Academic--research_data--p--69613", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University Medical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image_ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Pixel_Intensity\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"Tumor_Volume\",\n            \"units\": \"mm^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Prospective cohort study with MRI scans.\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI-based tumor volume prediction\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Tumor regions are manually segmented by expert radiologists.\"\n    }\n}"}
