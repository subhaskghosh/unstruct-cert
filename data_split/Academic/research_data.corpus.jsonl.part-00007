{"_id": "Academic--research_data--n--71526", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"unit\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Remote sensing and field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity assessment in the Amazon rainforest\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest.json\",\n    \"metadata\": {\n        \"data_size\": \"15.8MB\",\n        \"annotations\": \"Satellite imagery processed for vegetation indices\"\n    }\n}"}
