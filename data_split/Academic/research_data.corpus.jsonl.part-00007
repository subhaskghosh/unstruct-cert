{"_id": "Academic--research_data--p--67302", "text": "{\n    \"dataset_name\": \"Long-Term Forest Dynamics Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"diameter_at_breast_height\",\n            \"units\": \"centimeters\"\n        },\n        {\n            \"name\": \"species\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Resilience in a Changing Climate\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes tree measurements collected over 20 years.\"\n    }\n}"}
