{"_id": "Academic--research_data--p--68537", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-06-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 different sites along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68537", "text": "{\n    \"dataset_name\": \"MarineEcosystemHealth\",\n    \"creator\": {\n        \"name\": \"Dr. David Wilson\",\n        \"affiliation\": \"University of Miami\"\n    },\n    \"date_collected\": \"2024-02-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Continuous measurements from a buoy deployed in the ocean.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Marine Chlorophyll-a\",\n            \"authors\": [\n                \"Wilson, D.\",\n                \"Garcia, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_ecosystem.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data has been filtered for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68538", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Data Initiative (EDI)\",\n        \"affiliation\": \"National Ecological Observatory Network (NEON)\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the atmosphere.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature at the measurement location.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across multiple continents.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global trends in air pollution and health impacts\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"320MB\",\n        \"annotations\": \"Includes data from urban and rural monitoring sites.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68538", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"US Geological Survey (USGS)\",\n        \"affiliation\": \"Department of the Interior\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"unit\": \"mm\",\n            \"description\": \"Daily rainfall accumulation.\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Rain gauges in the Pacific Northwest region.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall patterns in the Pacific Northwest\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfalldata.txt\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data primarily covers Washington and Oregon.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68539", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, MIT\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations deployed throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Centers\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68539", "text": "{\n    \"dataset_name\": \"Industrial Emissions Data - Ohio River Valley\",\n    \"creator\": {\n        \"name\": \"Pollution Control Agency\",\n        \"affiliation\": \"Ohio Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-08-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NOx\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter\",\n            \"units\": \"mg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Stack emission testing at industrial facilities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Industrial Activity on Air Quality\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ohio_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Raw data from continuous emission monitoring systems.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68540", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing using Landsat satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_hansen_global_forest_change_2023_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Provides information on global forest loss and gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68540", "text": "{\n    \"dataset_name\": \"Air Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Emily Carter\",\n        \"affiliation\": \"City University of London\"\n    },\n    \"date_collected\": \"2023-10-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring using stationary air quality sensors in select city locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": \"Carter, E., et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10 MB\",\n        \"annotations\": \"Data collected from fixed monitoring stations. Primarily focused on point-source measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68541", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Oceanographic Institute, University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"In-situ measurements from fixed buoys and research vessels.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Nutrient Runoff on Coastal Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
