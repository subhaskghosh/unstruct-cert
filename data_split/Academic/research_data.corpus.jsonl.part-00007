{"_id": "Academic--research_data--p--71098", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"MIT Environmental Solutions Initiative\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Design on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71098", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"NASA Earth Science Data and Information System\",\n        \"affiliation\": \"National Aeronautics and Space Administration\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass with LiDAR\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data processed using standard NASA algorithms.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71099", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71099", "text": "{\n    \"dataset_name\": \"Coastal Ocean Salinity\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Department of Marine Chemistry and Geochemistry\"\n    },\n    \"date_collected\": \"2021-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based CTD casts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Salinity variations in the Northwest Atlantic\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.example.com/coastal_salinity.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Calibration data available\"\n    }\n}"}
{"_id": "Academic--research_data--p--71100", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring - 2022\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Michigan, School of Environment and Sustainability\"\n    },\n    \"date_collected\": \"2022-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Stratified random sampling at multiple depths and locations across the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Lake Erie Water Quality\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality_2022.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes quality control flags and metadata on sampling methodology.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71100", "text": "{\n    \"dataset_name\": \"Global River Discharge Data\",\n    \"creator\": {\n        \"name\": \"Global Runoff Data Centre\",\n        \"affiliation\": \"Federal Institute for Hydrology, Germany\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"River Discharge\",\n            \"units\": \"m^3/s\"\n        }\n    ],\n    \"data_format\": \"TSV\",\n    \"license\": \"CC-BY-NC 3.0\",\n    \"sampling_method\": \"Data aggregated from various national hydrological agencies.\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Global Analysis of River Discharge\",\n            \"year\": 2019,\n            \"authors\": [\n                \"Fekete, B.M.\",\n                \"Vörösmarty, C.J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_river_discharge.tsv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data may contain gaps and inconsistencies due to differing reporting standards.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71101", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Institute of Freshwater Ecology\",\n        \"affiliation\": \"University of Xylos\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 20 river sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Ecosystems\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71101", "text": "{\n    \"dataset_name\": \"Marine Phytoplankton Abundance\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Center\",\n        \"affiliation\": \"Coastal Studies Institute\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Phytoplankton Count\",\n            \"units\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous plankton recorder towed behind research vessel.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Distribution of Phytoplankton in the North Atlantic\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_phytoplankton.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes species identification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71102", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Regular sampling at fixed stations throughout the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Lake Erie Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakeerie_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71102", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution Data - Urban Centers\",\n    \"creator\": {\n        \"name\": \"GreenTech Solutions\",\n        \"affiliation\": \"Private Environmental Consulting Firm\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Mobile monitoring using sensor-equipped vehicles.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/urban_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Preliminary data, subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71103", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Monitoring - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research (INPA)\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"Biomass\",\n            \"units\": \"kilograms\"\n        },\n        {\n            \"variable_name\": \"Species Richness\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Forest Biodiversity Assessment\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ],\n            \"year\": 2024,\n            \"citation_count\": 150\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Detailed species identification and quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71103", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Dynamics - Pacific\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"Oceanographic Institute of Tokyo\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"Fish Biomass\",\n            \"units\": \"kilograms\"\n        },\n        {\n            \"variable_name\": \"Water Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect Surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Ecosystem Study\",\n            \"authors\": [\n                \"Tanaka, K.\",\n                \"Yamamoto, A.\"\n            ],\n            \"year\": 2024,\n            \"citation_count\": 75\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_ecosystem.xml\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Basic species information provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71104", "text": "{\n    \"dataset_name\": \"Lake Mendota Nutrient Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly water samples collected from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in nutrient loading and water quality in Lake Mendota\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, B.\"\n            ]\n        },\n        {\n            \"title\": \"Impact of climate change on freshwater ecosystems\",\n            \"authors\": [\n                \"Brown, C.\",\n                \"Davis, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality control information available in separate document.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71104", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"unit\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots established across the Amazon basin.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity assessment of the Amazon rainforest\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Oliveira, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes species identification based on morphological characteristics.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71105", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Systematic random sampling at fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Surface Water and Groundwater Data\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://waterdata.usgs.gov/nwis/gw\",\n    \"metadata\": {\n        \"data_size\": \"2.5GB\",\n        \"annotations\": \"Includes quality control flags and metadata about sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71105", "text": "{\n    \"dataset_name\": \"Small Stream Insect Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"State University Research Lab\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Insect Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Insect Diversity\",\n            \"units\": \"Shannon Index\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Kick-net sampling in small streams\",\n    \"related_publications\": [\n        {\n            \"title\": \"Insect Communities as Indicators of Stream Health\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.edu/insectdata\",\n    \"metadata\": {\n        \"data_size\": \"50KB\",\n        \"annotations\": \"Data collected from a limited number of streams.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71106", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71106", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network - Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Snowfall\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Weather stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Summary\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data completeness varies by station\"\n    }\n}"}
