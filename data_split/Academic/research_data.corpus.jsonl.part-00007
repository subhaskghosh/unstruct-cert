{"_id": "Academic--research_data--p--66678", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Radiology Department, Stanford University\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Pneumonia Status\",\n            \"units\": \"boolean\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection in Chest X-Rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_pneumonia\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Expert radiologist annotations for pneumonia location\"\n    }\n}"}
{"_id": "Academic--research_data--n--66678", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset for Tumor Segmentation\",\n    \"creator\": {\n        \"name\": \"Neuroimaging Lab, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Tumor Location\",\n            \"units\": \"coordinates\"\n        },\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective study with informed consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation using Deep Convolutional Networks\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_tumor\",\n    \"metadata\": {\n        \"data_size\": \"8GB\",\n        \"annotations\": \"Manual segmentations by trained neuroimaging experts\"\n    }\n}"}
