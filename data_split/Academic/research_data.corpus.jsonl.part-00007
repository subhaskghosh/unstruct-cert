{"_id": "Academic--research_data--p--69713", "text": "{\n    \"dataset_name\": \"COCO 2023 Object Detection\",\n    \"creator\": {\n        \"name\": \"The COCO Consortium\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"bounding_box_x\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"bounding_box_y\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"bounding_box_width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"bounding_box_height\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"object_class\",\n            \"units\": \"category label\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"ImageNet-style data collection and annotation\",\n    \"related_publications\": [\n        {\n            \"title\": \"COCO: Common Objects in Context\",\n            \"year\": 2014\n        }\n    ],\n    \"download_url\": \"https://cocodataset.org/#download\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Bounding boxes, segmentation masks\"\n    }\n}"}
{"_id": "Academic--research_data--n--69713", "text": "{\n    \"dataset_name\": \"MNIST Handwritten Digits\",\n    \"creator\": {\n        \"name\": \"Yann LeCun\",\n        \"affiliation\": \"New York University\"\n    },\n    \"date_collected\": \"2019-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pixel_value\",\n            \"units\": \"grayscale intensity\"\n        },\n        {\n            \"name\": \"digit_label\",\n            \"units\": \"0-9\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"From NIST special database 3 and NIST special database 1\",\n    \"related_publications\": [\n        {\n            \"title\": \"Gradient-Based Learning Applied to Document Recognition\",\n            \"year\": 1998\n        }\n    ],\n    \"download_url\": \"http://yann.lecun.com/exdb/mnist/\",\n    \"metadata\": {\n        \"data_size\": \"60MB\",\n        \"annotations\": \"Digit labels\"\n    }\n}"}
