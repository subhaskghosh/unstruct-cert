{"_id": "Academic--research_data--p--71940", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers or less in diameter\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"unit\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Populations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71940", "text": "{\n    \"dataset_name\": \"GlobalForestCarbonStocks\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"unit\": \"tonnes/ha\",\n            \"description\": \"Estimated aboveground biomass carbon stock\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"unit\": \"tonnes/ha\",\n            \"description\": \"Estimated belowground biomass carbon stock\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing and ground-based inventories\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment 2020\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.xml\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data derived from multiple sources\"\n    }\n}"}
{"_id": "Academic--research_data--p--71941", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"GreenTech Solutions\",\n        \"affiliation\": \"Independent Research Group\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors placed at strategic locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"A. Smith\",\n                \"B. Jones\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags are included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71941", "text": "{\n    \"dataset_name\": \"National Emissions Inventory - USA\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2 Emissions\",\n            \"unit\": \"tons\",\n            \"description\": \"Sulfur dioxide emissions by sector.\"\n        },\n        {\n            \"name\": \"NOx Emissions\",\n            \"unit\": \"tons\",\n            \"description\": \"Nitrogen oxides emissions by sector.\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Emissions factors and activity data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Air Quality Trends Report\",\n            \"authors\": [\n                \"C. Davis\",\n                \"D. Miller\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.gov/national_emissions.xml\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Detailed sector breakdowns provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71942", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Maximum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Daily Minimum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Daily Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Snow Depth\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71942", "text": "{\n    \"dataset_name\": \"Simple Temperature Readings\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"University of Example\"\n    },\n    \"date_collected\": \"2019-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Manual readings from a single thermometer\",\n    \"related_publications\": [],\n    \"download_url\": \"http://example.com/temperature.txt\",\n    \"metadata\": {\n        \"data_size\": \"1KB\",\n        \"annotations\": \"None\"\n    }\n}"}
{"_id": "Academic--research_data--p--71943", "text": "{\n    \"dataset_name\": \"Global Precipitation and Temperature Dataset (2021-2023)\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-06-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Total Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"In-situ measurements from weather stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Precipitation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_precipitation_temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Quality control flags included for each data point.\"\n    }\n}"}
