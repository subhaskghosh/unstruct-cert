{"_id": "Academic--research_data--p--67330", "text": "{\n    \"dataset_name\": \"Lung Cancer CT Scan Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Department, Massachusetts General Hospital\",\n        \"affiliation\": \"Harvard Medical School\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"scan_type\",\n            \"unit\": \"CT\"\n        },\n        {\n            \"name\": \"cancer_stage\",\n            \"unit\": \"I-IV\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Prospective clinical study with informed consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Early Detection of Lung Cancer Using Deep Learning\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Smith\",\n                \"Jones\",\n                \"Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_cancer_dataset\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Radiologist-verified annotations of tumor locations and characteristics\"\n    }\n}"}
{"_id": "Academic--research_data--n--67330", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Neurology Research Group\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"mri_sequence\",\n            \"unit\": \"T1-weighted, T2-weighted\"\n        },\n        {\n            \"name\": \"brain_region\",\n            \"unit\": \"frontal lobe, parietal lobe\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective data collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Alzheimer's Disease Progression Analysis Using MRI\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Garcia\",\n                \"Lee\",\n                \"Wilson\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"200 GB\",\n        \"annotations\": \"Automated segmentation of brain regions\"\n    }\n}"}
