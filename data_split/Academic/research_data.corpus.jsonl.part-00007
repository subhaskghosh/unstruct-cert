{"_id": "Academic--research_data--n--70251", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Trends in Urban Areas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data calibrated and validated\"\n    }\n}"}
{"_id": "Academic--research_data--p--70252", "text": "{\n    \"dataset_name\": \"Lung Cancer CT Scan Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Research Group\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-06-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ImageID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"TumorDiameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"ImageType\",\n            \"units\": \"CT\"\n        },\n        {\n            \"name\": \"PatientAge\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Lung Nodule Detection using Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_cancer_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-verified tumor annotations\"\n    }\n}"}
{"_id": "Academic--research_data--n--70252", "text": "{\n    \"dataset_name\": \"Healthy Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Neuroimaging Consortium\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ImageID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"BrainRegion\",\n            \"units\": \"anatomical location\"\n        },\n        {\n            \"name\": \"ImageType\",\n            \"units\": \"MRI\"\n        },\n        {\n            \"name\": \"PatientAge\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling of healthy volunteers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Normal Brain Anatomy Variation Study\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/healthy_brain_dataset\",\n    \"metadata\": {\n        \"data_size\": \"30GB\",\n        \"annotations\": \"Automated segmentation of brain regions\"\n    }\n}"}
