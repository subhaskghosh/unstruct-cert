{"_id": "Academic--research_data--p--68777", "text": "{\n    \"dataset_name\": \"Water Quality Monitoring in the Yangtze River Basin\",\n    \"creator\": {\n        \"name\": \"Li Wei\",\n        \"affiliation\": \"Institute of Hydrobiology, Chinese Academy of Sciences\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected monthly from 20 locations along the Yangtze River.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Water Quality in the Yangtze River Basin\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/yangtze_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
