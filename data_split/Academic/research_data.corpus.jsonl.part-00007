{"_id": "Academic--research_data--n--69592", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"Bob Williams\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-12-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Text Content\",\n            \"units\": \"String\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Twitter API Streaming\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis in Online Platforms\",\n            \"authors\": [\n                \"Jones\",\n                \"Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/sentiment_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Pre-processed text data\"\n    }\n}"}
{"_id": "Academic--research_data--p--69593", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations and aircraft measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"authors\": \"Dlugokencky, E. J., et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://gmd.noaa.gov/data/co2/data/\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data includes quality flags for accuracy assessment.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69593", "text": "{\n    \"dataset_name\": \"Ocean Temperature Measurements\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Department of Oceanography\"\n    },\n    \"date_collected\": \"2023-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Variability of Ocean Temperatures\",\n            \"authors\": \"Johnson, G. L., et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.whoi.edu/ocean-data/\",\n    \"metadata\": {\n        \"data_size\": \"2.2 GB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69594", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies (2023-2024)\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/tabledata_v4/\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Includes uncertainty estimates.\"\n    }\n}"}
