{"_id": "Academic--research_data--p--69367", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2023-2024\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal (Public Domain Dedication)\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2023\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/temp/csv/2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains monthly temperature anomalies relative to a baseline period.\"\n    }\n}"}
