{"_id": "Academic--research_data--n--68465", "text": "{\n    \"dataset_name\": \"Student Health Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"BMI\",\n            \"units\": \"kg/m²\"\n        },\n        {\n            \"name\": \"Sleep Duration\",\n            \"units\": \"hours\"\n        },\n        {\n            \"name\": \"Stress Level\",\n            \"units\": \"Scale of 1-10\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Questionnaire distributed to students\",\n    \"related_publications\": [\n        {\n            \"title\": \"Health and Wellbeing of University Students\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Brown, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/student_health.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Anonymized data\"\n    }\n}"}
