{"_id": "Academic--research_data--p--71821", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations using calibrated sensors. Data averaged hourly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Traffic on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"last_updated\": \"2024-02-29T14:30:00Z\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71821", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2022-11-20T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest. Data collected during field expeditions.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon Basin\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"last_updated\": \"2022-12-15T09:00:00Z\",\n        \"annotations\": \"Data includes species identification and measurements of tree characteristics.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71822", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London boroughs\",\n    \"related_publications\": [],\n    \"download_url\": \"https://data.london.gov.uk/dataset/air-quality-monitoring-london\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality checked and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71822", "text": "{\n    \"dataset_name\": \"Industrial Emission Spectra - Ruhr Valley\",\n    \"creator\": {\n        \"name\": \"Max Planck Institute for Chemistry\",\n        \"affiliation\": \"Atmospheric Chemistry Department\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NOx\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Spectral Intensity (400nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (500nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (600nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (700nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (800nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (900nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (1000nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (1100nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (1200nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (1300nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (1400nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (1500nm)\",\n            \"units\": \"W/m²\"\n        },\n        {\n            \"name\": \"Spectral Intensity (1600nm)\",\n            \"units\": \"W/m²\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Spectroscopic analysis of industrial flue gas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spectroscopic Analysis of Industrial Pollutants\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/industrial_emissions.txt\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Raw spectral data. Requires preprocessing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71823", "text": "{\n    \"dataset_name\": \"Coastal Temperature Records - North Atlantic\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Buoy measurements, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in North Atlantic Sea Surface Temperature\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71823", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating Forest Biomass Using Remote Sensing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71824", "text": "{\n    \"dataset_name\": \"Social Media Usage Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"platform\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"time_spent\",\n            \"units\": \"minutes\"\n        },\n        {\n            \"name\": \"user_age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"post_engagement\",\n            \"units\": \"number of likes\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling of social media users\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Impact of Social Media on Adolescent Behavior\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data contains anonymized user profiles and engagement metrics.\"\n    }\n}"}
