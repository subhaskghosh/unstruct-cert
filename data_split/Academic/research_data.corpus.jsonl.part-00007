{"_id": "Academic--research_data--p--67133", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/data\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Extensive quality control and documentation provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67133", "text": "{\n    \"dataset_name\": \"Local Rainfall Records\",\n    \"creator\": {\n        \"name\": \"Community Weather Watch Group\",\n        \"affiliation\": \"Local Volunteers\"\n    },\n    \"date_collected\": \"2019-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"Text\",\n    \"license\": \"Creative Commons Attribution-NonCommercial\",\n    \"sampling_method\": \"Manual recordings from rain gauges\",\n    \"related_publications\": [],\n    \"download_url\": \"http://communityweather.org/data\",\n    \"metadata\": {\n        \"data_size\": \"100KB\",\n        \"annotations\": \"Basic rainfall measurements, limited documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67134", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone.\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Lockdown Measures on Air Quality in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67134", "text": "{\n    \"dataset_name\": \"Historical Soil Composition - Rural France\",\n    \"creator\": {\n        \"name\": \"National Institute for Agricultural Research\",\n        \"affiliation\": \"INRAE\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"unitless\",\n            \"description\": \"Soil pH level.\"\n        },\n        {\n            \"variable_name\": \"Organic_Matter\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of organic matter in the soil.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random soil samples collected from agricultural fields.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Soil Fertility\",\n            \"year\": 2015\n        }\n    ],\n    \"download_url\": \"https://example.com/french_soil.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Geographic coordinates included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67135", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-27T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data based on station measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67135", "text": "{\n    \"dataset_name\": \"Historical Ship Manifests\",\n    \"creator\": {\n        \"name\": \"Maritime Historical Society\",\n        \"affiliation\": \"Independent Research Group\"\n    },\n    \"date_collected\": \"2022-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ship Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Cargo Type\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Departure Port\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Creative Commons Attribution-NonCommercial\",\n    \"sampling_method\": \"Digitization of historical documents.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Transatlantic Trade in the 18th Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://maritimehistory.org/manifests\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Detailed records of ship voyages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67136", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67136", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Survey - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m³\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Plankton Density\",\n            \"units\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"kg/m³\"\n        },\n        {\n            \"name\": \"Current Velocity\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Research vessel transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Ecosystem Dynamics\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://oceaninstitute.org/marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67137", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"variable_name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"publication_year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Provides information on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67137", "text": "{\n    \"dataset_name\": \"Air Quality in London\",\n    \"creator\": {\n        \"name\": \"London Environmental Monitoring Network\",\n        \"affiliation\": \"Greater London Authority\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government License v3.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://data.london.gov.uk/dataset/air-quality-london\",\n    \"metadata\": {\n        \"data_size\": \"10 MB\",\n        \"annotations\": \"Hourly air quality measurements in London.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67138", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations at 10 locations throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67138", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"number\",\n            \"description\": \"Number of individuals of a particular species observed.\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\",\n            \"description\": \"Depth of the observation.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Underwater visual surveys conducted by SCUBA divers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health Assessment\",\n            \"authors\": \"Lee, D. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been reviewed by marine biologists.\"\n    }\n}"}
