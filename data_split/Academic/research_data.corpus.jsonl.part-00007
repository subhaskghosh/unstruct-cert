{"_id": "Academic--research_data--n--71742", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Coral Reef Conservation Program\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"unit\": \"%\",\n            \"description\": \"Percentage of coral cover\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"unit\": \"kg/m²\",\n            \"description\": \"Biomass of fish species\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Climate Change on Coral Reefs\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Survey location data included.\"\n    }\n}"}
