{"_id": "Academic--research_data--n--67305", "text": "{\n    \"dataset_name\": \"Climate Model Output - RCP8.5\",\n    \"creator\": {\n        \"name\": \"IPCC AR6 Working Group I\",\n        \"affiliation\": \"IPCC\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Climate model simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Climate Model Projections\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Output from a climate model simulation under the RCP8.5 scenario.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67306", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"Phosphate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated buoy sensors and periodic water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
