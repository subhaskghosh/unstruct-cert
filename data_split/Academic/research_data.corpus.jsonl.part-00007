{"_id": "Academic--research_data--p--67961", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - v4\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global station data, satellite measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Contains data from weather stations, ships, and buoys.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67961", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Projections\",\n    \"creator\": {\n        \"name\": \"CMIP6 Collaboration\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Projection\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"5TB\",\n        \"annotations\": \"Model outputs for various future emission scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67962", "text": "{\n    \"dataset_name\": \"Air Quality in London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide.\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution License\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67962", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"NASA Earth Exchange\",\n        \"affiliation\": \"Biospheric Sciences Laboratory\"\n    },\n    \"date_collected\": \"2023-11-20T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"tonnes/hectare\",\n            \"description\": \"Aboveground forest biomass density.\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\",\n            \"description\": \"Average canopy height.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Maps of Forest Biomass and Carbon Stocks\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://earthdata.nasa.gov/forestbiomass\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67963", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Remote sensing using Landsat satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/\",\n    \"metadata\": {\n        \"data_size\": \"25GB\",\n        \"annotations\": \"Dataset includes maps of forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67963", "text": "{\n    \"dataset_name\": \"Local Bird Species Observations\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"Community Birdwatchers Group\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Observation Count\",\n            \"units\": \"number of birds\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA\",\n    \"sampling_method\": \"Citizen science bird counts\",\n    \"related_publications\": [],\n    \"download_url\": \"https://communitybirdwatch.org/data\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Observations collected by volunteers in a local park.\"\n    }\n}"}
