{"_id": "Academic--research_data--p--71073", "text": "{\n    \"dataset_name\": \"Global Extreme Weather Events Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite and ground station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predicting Extreme Rainfall Events\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/extreme_weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Contains data for major extreme weather events globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71073", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2022-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Pollution on Respiratory Health\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected from urban monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71074", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Monitoring Data - Eastern US\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of North Carolina - Chapel Hill, Department of Environmental Sciences\"\n    },\n    \"date_collected\": \"2022-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity (%)\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed (m/s)\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric CO2 in the Southeastern United States\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data_eastern_us.csv\",\n    \"metadata\": {\n        \"data_size\": \"6.5GB\",\n        \"annotations\": \"Data quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71074", "text": "{\n    \"dataset_name\": \"Global Precipitation Data\",\n    \"creator\": {\n        \"name\": \"Global Weather Consortium\",\n        \"affiliation\": \"International Meteorological Organization\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall (mm)\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Snowfall (cm)\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite-based precipitation estimates\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Global Precipitation Climatology\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\",\n                \"Brown, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_precipitation.nc\",\n    \"metadata\": {\n        \"data_size\": \"15GB\",\n        \"annotations\": \"Data derived from multiple satellite sources.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71075", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (COVID-19)\",\n    \"creator\": {\n        \"name\": \"Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-06-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image File Name\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"categorical (COVID-19, Pneumonia, Normal)\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective analysis of hospital records.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for COVID-19 Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Image-level labels for diagnosis\"\n    }\n}"}
{"_id": "Academic--research_data--n--71075", "text": "{\n    \"dataset_name\": \"Skin Lesion Images\",\n    \"creator\": {\n        \"name\": \"David Lee\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-08-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image File Name\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"categorical (Melanoma, Nevus, Seborrheic Keratosis)\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Online image collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Skin Cancer Classification\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/skin_lesion_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Image-level labels for diagnosis\"\n    }\n}"}
{"_id": "Academic--research_data--p--71076", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Ohio Environmental Protection Agency\",\n        \"affiliation\": \"Ohio EPA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Grab samples collected weekly from various locations around Lake Erie.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakeerie_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Includes data quality flags and location metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71076", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Study - Amazon\",\n    \"creator\": {\n        \"name\": \"Rainforest Conservation Institute\",\n        \"affiliation\": \"RCI\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species Richness\",\n            \"units\": \"species/hectare\"\n        },\n        {\n            \"name\": \"Basal Area\",\n            \"units\": \"m^2/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect surveys conducted annually in the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the Amazon basin\",\n            \"authors\": [\n                \"Garcia, L.\",\n                \"Rodriguez, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"800 KB\",\n        \"annotations\": \"Contains species identification codes and geographical coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71077", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Measurements - Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    },\n    \"date_collected\": \"2022-05-10T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Atmospheric Composition and its Impact on Public Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/urban_atmosphere.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71077", "text": "{\n    \"dataset_name\": \"Historical Temperature Records - Global\",\n    \"creator\": {\n        \"name\": \"Global Historical Climatology Network\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"1995-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Data collected from weather stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Jones, P.\",\n                \"Smith, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/global_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Missing data values are represented by -999\"\n    }\n}"}
{"_id": "Academic--research_data--p--71078", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data - North Atlantic\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Ship-based CTD casts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Warming on North Atlantic Circulation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
