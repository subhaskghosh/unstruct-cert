{"_id": "Academic--research_data--p--68495", "text": "{\n    \"dataset_name\": \"Global Forest Biodiversity and Climate Change\",\n    \"creator\": {\n        \"name\": \"Global Forest Biodiversity Initiative\",\n        \"affiliation\": \"University of Edinburgh\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species Richness\",\n            \"unit\": \"species/hectare\"\n        },\n        {\n            \"name\": \"Basal Area\",\n            \"unit\": \"m^2/hectare\"\n        },\n        {\n            \"name\": \"Forest Canopy Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data combined with field inventories.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global patterns of forest biodiversity\",\n            \"year\": 2023,\n            \"authors\": [\n                \"A. Example\",\n                \"B. Example\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains data on tree species distribution and forest structure globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68495", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentration Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Air Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2019,\n            \"authors\": [\n                \"C. Example\",\n                \"D. Example\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"High-resolution time series of CO2 concentrations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68496", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"Columbia University Earth Institute\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature observations from weather stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Updated Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2021.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Includes uncertainty estimates for temperature measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68496", "text": "{\n    \"dataset_name\": \"Climate Model Simulations - CMIP6\",\n    \"creator\": {\n        \"name\": \"Various\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations using the CMIP6 framework.\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Model Output Analysis\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/cmip6_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"1TB\",\n        \"annotations\": \"Contains output from multiple climate models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68497", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"City Analytics Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Continuous monitoring using stationary sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"authors\": [\n                \"Johnson, A.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68497", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"Environmental Systems Lab\",\n        \"affiliation\": \"National Ecological Observatory Network\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\",\n            \"description\": \"Measure of leaf density in a forest canopy.\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of water in the soil.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-4.0\",\n    \"sampling_method\": \"Periodic field measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment\",\n            \"authors\": [\n                \"Brown, C.\",\n                \"Davis, D.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data validated by expert review\"\n    }\n}"}
{"_id": "Academic--research_data--p--68498", "text": "{\n    \"dataset_name\": \"Global Ocean Carbon and Heat Fluxes\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"National Oceanographic Institute\"\n    },\n    \"date_collected\": \"2022-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Carbon Dioxide Partial Pressure\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ocean Current Velocity\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Chlorophyll-a Concentration\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Mooring buoys and ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Carbon Uptake in a Changing Climate\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
