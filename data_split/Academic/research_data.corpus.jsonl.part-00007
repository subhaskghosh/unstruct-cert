{"_id": "Academic--research_data--n--68131", "text": "{\n    \"dataset_name\": \"Forest Insect Population Dynamics - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Javier Rodriguez\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Insect Species\",\n            \"unit\": \"species name\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Insect Density\",\n            \"unit\": \"insects/m^2\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Systematic trapping and observation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Amazonian Insect Populations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_insect_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"700MB\",\n        \"annotations\": \"Data includes genetic information of insect species.\"\n    }\n}"}
