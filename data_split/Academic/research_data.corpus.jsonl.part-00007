{"_id": "Academic--research_data--p--71058", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_UrbanAreas\",\n    \"creator\": {\n        \"name\": \"Environmental Sciences Department, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends in California\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Impact of Weather Patterns on Air Pollution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_berkeley.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--71058", "text": "{\n    \"dataset_name\": \"ForestBiodiversity_Amazon\",\n    \"creator\": {\n        \"name\": \"Rainforest Conservation Institute\",\n        \"affiliation\": \"RCI\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Transect surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/forestbio_amazon.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species identification verified by experts\"\n    }\n}"}
{"_id": "Academic--research_data--p--71059", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite measurements and ground station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/land_temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes monthly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71059", "text": "{\n    \"dataset_name\": \"Pacific Ocean Phytoplankton Abundance\",\n    \"creator\": {\n        \"name\": \"University of Hawaii Marine Institute\",\n        \"affiliation\": \"University of Hawaii\"\n    },\n    \"date_collected\": \"2021-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Phytoplankton Abundance\",\n            \"units\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based sampling and flow cytometry\",\n    \"related_publications\": [\n        {\n            \"title\": \"Phytoplankton Dynamics in the Pacific\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/phytoplankton_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data represents chlorophyll-a concentrations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71060", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange2021\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Contains information on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71060", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate of the United States\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"1 GB\",\n        \"annotations\": \"Daily weather observations from stations across the US.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71061", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Team\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular sampling at fixed locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71061", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"City Environmental Monitoring Department\",\n        \"affiliation\": \"New York City Government\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at various locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Urban Air Pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is hourly averaged.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71062", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - Chesapeake Bay\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Maryland Center for Environmental Science\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Regular in-situ measurements at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Chesapeake Bay Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chesapeake_bay_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71062", "text": "{\n    \"dataset_name\": \"Global Land Cover Classification\",\n    \"creator\": {\n        \"name\": \"Remote Sensing Team\",\n        \"affiliation\": \"Earth Observation Institute\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Cover Type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"NDVI\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Satellite imagery analysis (Landsat 8).\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Global Land Cover Map at 30m Resolution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_land_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"90MB\",\n        \"annotations\": \"Accuracy assessment metrics provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71063", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Study\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Rainforest\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Includes species identification and geographic coordinates.\"\n    }\n}"}
