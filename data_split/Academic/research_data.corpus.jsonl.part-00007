{"_id": "Academic--research_data--p--71780", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Impacts Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research (NCAR)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across North America\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of CO2 on Regional Temperature Variations\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and quality controlled.\"\n    }\n}"}
