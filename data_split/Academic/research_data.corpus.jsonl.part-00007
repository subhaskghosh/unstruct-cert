{"_id": "Academic--research_data--n--69291", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Image Height\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pneumonia Detection using Convolutional Neural Networks\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Pneumonia labels for each X-ray image\"\n    }\n}"}
