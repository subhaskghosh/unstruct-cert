{"_id": "Academic--research_data--n--69472", "text": "{\n    \"dataset_name\": \"Species Distribution Modeling Data\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Field surveys and species occurrence records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predictive Modeling of Species Distributions\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/species_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Species presence/absence data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69473", "text": "{\n    \"dataset_name\": \"ImageNet Subset for Object Detection\",\n    \"creator\": {\n        \"name\": \"Fei-Fei Li\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"label\",\n            \"unit\": \"object category\"\n        },\n        {\n            \"name\": \"bounding_box\",\n            \"unit\": \"pixels\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling from ImageNet\",\n    \"related_publications\": [\n        {\n            \"title\": \"ImageNet Large Scale Visual Recognition Challenge\",\n            \"year\": 2010\n        }\n    ],\n    \"download_url\": \"http://example.com/imagenet_subset.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Bounding boxes and labels\"\n    }\n}"}
{"_id": "Academic--research_data--n--69473", "text": "{\n    \"dataset_name\": \"Medical Scan Data\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Hospital Clinic\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"scan_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"unit\": \"disease category\"\n        },\n        {\n            \"name\": \"scan_type\",\n            \"unit\": \"MRI, CT, X-ray\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Patient data collected from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Diagnosis using medical imaging\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"http://example.com/medical_scans.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Diagnosis and scan type\"\n    }\n}"}
{"_id": "Academic--research_data--p--69474", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data from weather stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Contains monthly temperature anomalies from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69474", "text": "{\n    \"dataset_name\": \"Historical CO2 Levels\",\n    \"creator\": {\n        \"name\": \"NOAA Earth System Research Laboratories\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Measurements from Mauna Loa Observatory.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://gml.noaa.gov/ccgg/trends/\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Provides historical atmospheric CO2 concentrations.\"\n    }\n}"}
