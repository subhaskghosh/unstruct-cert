{"_id": "Academic--research_data--n--71630", "text": "{\n    \"dataset_name\": \"Historical Air Pollution Data - Europe\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EU\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Continuous monitoring stations across Europe\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in European Air Quality\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Raw data with minimal processing\"\n    }\n}"}
{"_id": "Academic--research_data--p--71631", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Conductivity\",\n            \"units\": \"uS/cm\"\n        },\n        {\n            \"name\": \"Total Dissolved Solids\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Fecal Coliform\",\n            \"units\": \"CFU/100mL\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentration (Lead)\",\n            \"units\": \"ug/L\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentration (Mercury)\",\n            \"units\": \"ug/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Systematic random sampling from designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
