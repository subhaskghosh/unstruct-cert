{"_id": "Academic--research_data--n--71240", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Data - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute of Hawaii\",\n        \"affiliation\": \"University of Hawaii\"\n    },\n    \"date_collected\": \"2022-01-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"unit\": \"mg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Research vessel surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Pacific Ocean\",\n            \"authors\": [\n                \"Lee, B.\",\n                \"Garcia, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
