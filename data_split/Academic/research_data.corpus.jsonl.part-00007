{"_id": "Academic--research_data--p--70566", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Deforestation Rates\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute for Amazonian Research (INPA)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Deforestation Area (km²)\",\n            \"units\": \"km²\"\n        },\n        {\n            \"name\": \"Forest Cover (%)\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0 (Commercial)\",\n    \"sampling_method\": \"Satellite imagery analysis and ground truthing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Trends in the Amazon: A 20-Year Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_deforestation.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes annotations on deforestation events and associated environmental impacts.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70566", "text": "{\n    \"dataset_name\": \"Urban Park Bird Diversity\",\n    \"creator\": {\n        \"name\": \"David Chen\",\n        \"affiliation\": \"City University of New York\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Park Area (m²)\",\n            \"units\": \"m²\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0 (Non-Commercial)\",\n    \"sampling_method\": \"Point count surveys in urban parks\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bird Diversity in Urban Green Spaces\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_birds.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Bird species identified using visual and auditory observations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70567", "text": "{\n    \"dataset_name\": \"Air Quality and Biodiversity in Urban Parks\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"number of species\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Stratified random sampling across ten urban parks.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Urban Biodiversity\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70567", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Global\",\n    \"creator\": {\n        \"name\": \"Global Weather Consortium\",\n        \"affiliation\": \"International Meteorological Organization\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Rainfall Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 MB\",\n        \"annotations\": \"Data is sourced from multiple national weather services.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70568", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Data\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Water pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Air Pollution (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon Rainforest\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes annotations on species identification and data quality.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70568", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow Data\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Vehicle Count\",\n            \"units\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"Average Speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous Monitoring\",\n    \"related_publications\": [\n        {\n            \"title\": \"Traffic Patterns in Metropolitan Areas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_traffic.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes timestamps and location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70569", "text": "{\n    \"dataset_name\": \"Urban Temperature and Humidity Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Geography\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature_celsius\",\n            \"unit\": \"°C\",\n            \"description\": \"Ambient air temperature measured in Celsius.\"\n        },\n        {\n            \"name\": \"relative_humidity\",\n            \"unit\": \"%\",\n            \"description\": \"Relative humidity percentage.\"\n        },\n        {\n            \"name\": \"location_id\",\n            \"unit\": \"N/A\",\n            \"description\": \"Unique identifier for the monitoring location.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring at 15-minute intervals.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Public Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, P.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_temp_humidity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70569", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"unit\": \"count\",\n            \"description\": \"Number of plant species observed in a 10x10 meter plot.\"\n        },\n        {\n            \"name\": \"tree_density\",\n            \"unit\": \"trees/hectare\",\n            \"description\": \"Density of trees in the surveyed area.\"\n        },\n        {\n            \"name\": \"canopy_height\",\n            \"unit\": \"meters\",\n            \"description\": \"Average canopy height.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Basin\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Species names are provided in taxonomic classification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70570", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Temperature\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_precip.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70570", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Reef Check Foundation\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2019-12-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Fish Abundance\",\n            \"units\": \"Individuals per transect\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health Assessment\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Geographic coordinates included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70571", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70571", "text": "{\n    \"dataset_name\": \"Rural Forest Health Assessment\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Indicators\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://forestdata.gov/health.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data collected during annual surveys\"\n    }\n}"}
{"_id": "Academic--research_data--p--70572", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Environmental and Forest Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"species\",\n            \"units\": \"N/A\",\n            \"description\": \"Species of tree observed\"\n        },\n        {\n            \"variable_name\": \"diameter_at_breast_height\",\n            \"units\": \"cm\",\n            \"description\": \"Diameter of the tree trunk at breast height\"\n        },\n        {\n            \"variable_name\": \"tree_height\",\n            \"units\": \"m\",\n            \"description\": \"Height of the tree\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling within designated forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in Pacific Northwest forests\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags for each observation.\"\n    }\n}"}
