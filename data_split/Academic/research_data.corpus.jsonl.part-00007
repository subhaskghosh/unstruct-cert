{"_id": "Academic--research_data--p--67303", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"TemperatureAnomalies\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"PrecipitationAnomalies\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global surface temperature analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Change: Trends and Projections\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes monthly averages and anomalies.\"\n    }\n}"}
