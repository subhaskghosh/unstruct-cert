{"_id": "Academic--research_data--p--69947", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA GISS\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Land Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Ocean Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Atmospheric CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and ocean buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Change Course\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\",\n                \"Pushker Kharecha\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Quality controlled and homogenized temperature data\"\n    }\n}"}
