{"_id": "Academic--research_data--p--71753", "text": "{\n    \"dataset_name\": \"Cardiac MRI Dataset for Diastolic Dysfunction\",\n    \"creator\": {\n        \"name\": \"Stanford Cardiovascular Imaging Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Left Ventricle End-Diastolic Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Left Atrial Volume\",\n            \"units\": \"mL\"\n        },\n        {\n            \"name\": \"E/A Ratio\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Prospective, single-center study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Diastolic Dysfunction Assessment with Cardiac MRI\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Smith\",\n                \"Jones\",\n                \"Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/cardiac_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual segmentation of left ventricle and left atrium\"\n    }\n}"}
