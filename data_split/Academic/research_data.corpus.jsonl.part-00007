{"_id": "Academic--research_data--p--68139", "text": "{\n    \"dataset_name\": \"CardioMRI-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Left Ventricle Volume\",\n            \"units\": \"mL\"\n        },\n        {\n            \"variable_name\": \"Ejection Fraction\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"Wall Thickness\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Prospective, multi-center clinical study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Novel MRI biomarkers for predicting heart failure\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/cardioMRI2024.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual segmentation of heart chambers by expert radiologists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68139", "text": "{\n    \"dataset_name\": \"LungCT-2023\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Lung Nodule Diameter\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of existing CT scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated detection of lung nodules using deep learning\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lungCT2023.zip\",\n    \"metadata\": {\n        \"data_size\": \"30GB\",\n        \"annotations\": \"Automated nodule detection with limited manual verification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68140", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Chicago 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Chicago - Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration (diameter less than 2.5 micrometers)\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        },\n        {\n            \"title\": \"Analysis of PM2.5 Trends in Chicago\",\n            \"authors\": [\n                \"Lee, J.\",\n                \"Carter, E.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chicago_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags provided for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68140", "text": "{\n    \"dataset_name\": \"National Emissions Inventory - 2022\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA - Air Quality Division\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NOx Emissions\",\n            \"units\": \"tons/year\",\n            \"description\": \"Annual emissions of nitrogen oxides\"\n        },\n        {\n            \"name\": \"SO2 Emissions\",\n            \"units\": \"tons/year\",\n            \"description\": \"Annual emissions of sulfur dioxide\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Emission factor modeling and activity data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in US Air Pollutant Emissions\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.gov/national_emissions.xml\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Detailed documentation available on the EPA website.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68141", "text": "{\n    \"dataset_name\": \"LongTermEcologyData\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Ecological Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/long_term_ecology_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality control performed and documented\"\n    }\n}"}
