{"_id": "Academic--research_data--p--67670", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change - Extended Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Relative Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations and research flights\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atmospheric Composition on Global Warming\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_extended.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Includes quality control flags and uncertainty estimates for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67670", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies 1980-2019\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Scripps Institution of Oceanography\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Satellite remote sensing and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Ocean Temperature\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp_anomalies.nc\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data gaps filled using spatial interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67671", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67671", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Amazon\",\n    \"creator\": {\n        \"name\": \"Hydrology Research Institute\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2021-12-20T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Daily rainfall measurements at remote stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in the Amazon Basin\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data gaps may exist due to station failures.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67672", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Long Term\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of weather stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data covers 1880-Present\"\n    }\n}"}
{"_id": "Academic--research_data--n--67672", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center (NSIDC)\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Sea Ice Concentration\",\n            \"units\": \"percent\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite remote sensing (passive microwave data).\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Decline\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Daily and monthly data available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67673", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature Anomaly\",\n            \"units\": \"Degrees Celsius\",\n            \"description\": \"The difference from the average temperature over a baseline period.\"\n        },\n        {\n            \"variable_name\": \"Precipitation Anomaly\",\n            \"units\": \"Percentage\",\n            \"description\": \"The difference from the average precipitation over a baseline period.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data from weather stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Ruedy, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Suitable for educational use; clear variable descriptions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67673", "text": "{\n    \"dataset_name\": \"Atmospheric Chemistry Measurements\",\n    \"creator\": {\n        \"name\": \"Max Planck Institute for Chemistry\",\n        \"affiliation\": \"MPI-BGC\"\n    },\n    \"date_collected\": \"2019-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CH4 Concentration\",\n            \"units\": \"ppb\",\n            \"description\": \"Methane concentration in parts per billion.\"\n        },\n        {\n            \"variable_name\": \"CO2 Concentration\",\n            \"units\": \"ppm\",\n            \"description\": \"Carbon dioxide concentration in parts per million.\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Aircraft-based measurements over Europe.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric Methane Trends\",\n            \"authors\": [\n                \"Smit, H.\",\n                \"et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.mpic.de/data/chemdata/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Requires specialized knowledge for interpretation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67674", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnomalies\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"PrecipitationAnomalies\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data, satellite observations and ground measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Monthly and annual temperature and precipitation anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67674", "text": "{\n    \"dataset_name\": \"Historical Stock Prices\",\n    \"creator\": {\n        \"name\": \"Yahoo Finance\",\n        \"affiliation\": \"Yahoo\"\n    },\n    \"date_collected\": \"2022-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Open\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"High\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"Low\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"Close\",\n            \"units\": \"USD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Daily stock market data\",\n    \"related_publications\": [],\n    \"download_url\": \"https://finance.yahoo.com/\",\n    \"metadata\": {\n        \"data_size\": \"1GB\",\n        \"annotations\": \"Historical stock market data for various companies.\"\n    }\n}"}
