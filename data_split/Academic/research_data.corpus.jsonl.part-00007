{"_id": "Academic--research_data--p--69361", "text": "{\n    \"dataset_name\": \"Oxford Climate Change Dataset - CO2 Levels\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous Monitoring Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of CO2 on Global Temperature\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/oxford_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy.\"\n    }\n}"}
