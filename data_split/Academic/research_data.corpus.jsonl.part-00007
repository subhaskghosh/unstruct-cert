{"_id": "Academic--research_data--p--67397", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoy with weekly sample collection and laboratory analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67397", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Urban Air Research Group\",\n        \"affiliation\": \"City University\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Fixed monitoring stations with hourly measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality assessment in major cities\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67398", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"University Corporation for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide (CO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane (CH4)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide (N2O)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of ground-based stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in atmospheric greenhouse gases\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67398", "text": "{\n    \"dataset_name\": \"Regional Precipitation Patterns\",\n    \"creator\": {\n        \"name\": \"State Meteorological Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Snowfall\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Rain gauge network across the region\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional climate variability\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/precipitation_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes daily averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67399", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"description\": \"Unique identifier for each X-ray image.\",\n            \"units\": \"string\"\n        },\n        {\n            \"variable_name\": \"pneumonia_type\",\n            \"description\": \"Type of pneumonia identified in the image (if any).\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"variable_name\": \"scan_quality\",\n            \"description\": \"Quality score of the X-ray scan.\",\n            \"units\": \"integer (1-5)\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Retrospective collection from hospital records.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Pneumonia Detection Using Deep Learning\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_pneumonia\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Expert radiologists annotated each image for the presence and type of pneumonia.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67399", "text": "{\n    \"dataset_name\": \"Healthy Brain MRI Scans\",\n    \"creator\": {\n        \"name\": \"University of California, San Francisco\",\n        \"affiliation\": \"UCSF Brain Imaging Center\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"subject_id\",\n            \"description\": \"Unique identifier for the participant.\",\n            \"units\": \"string\"\n        },\n        {\n            \"variable_name\": \"age\",\n            \"description\": \"Age of the participant at the time of the scan.\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Volunteers recruited from the local community.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Normative Brain MRI Data for Healthy Adults\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/healthy_brain_mri\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"No pathologies were identified in these scans.\"\n    }\n}"}
