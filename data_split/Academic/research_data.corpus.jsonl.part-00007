{"_id": "Academic--research_data--n--71348", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes species identification and location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71349", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Science Department, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in California Cities\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71349", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute of Woods Hole\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2021-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Underwater remotely operated vehicle (ROV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Deep-Sea Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes species identification and abundance.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71350", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Earth Sciences Data and Information Services Center (GES DISC)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite measurements and ground-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Climate Change on Atmospheric Composition\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes quality flags for reliability assessment.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71350", "text": "{\n    \"dataset_name\": \"Historical Weather Records of Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Dataset\",\n        \"affiliation\": \"ECAD\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Network of meteorological stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends in Europe\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/european_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is regularly updated with quality control measures.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71351", "text": "{\n    \"dataset_name\": \"North American Lake Water Quality Database\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Minnesota, Department of Ecology\"\n    },\n    \"date_collected\": \"2023-05-10T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular sampling from 50 lakes across Minnesota and Wisconsin.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Lake Water Quality\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality-controlled and includes metadata on sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71351", "text": "{\n    \"dataset_name\": \"European Soil Composition Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Klaus Schmidt\",\n        \"affiliation\": \"University of Berlin, Institute of Soil Science\"\n    },\n    \"date_collected\": \"2022-11-15T09:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Organic Matter Content\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random soil core sampling across European agricultural lands.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial Variability of Soil Nutrients\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Schmidt, K.\",\n                \"Weber, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_composition.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes metadata on soil type and land use.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71352", "text": "{\n    \"dataset_name\": \"Global Biodiversity Assessment Dataset\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Shannon Diversity Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Simpson Diversity Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Habitat Area\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Light Intensity\",\n            \"units\": \"lux\"\n        },\n        {\n            \"name\": \"Vegetation Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Animal Abundance\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across various biomes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global patterns of biodiversity\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/biodiversity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes species observations and environmental variables.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71352", "text": "{\n    \"dataset_name\": \"Regional Climate Model Output\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"Climate Modeling Division\"\n    },\n    \"date_collected\": \"2023-10-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Based on high-resolution climate model simulations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional climate change projections\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Output from a regional climate model.\"\n    }\n}"}
