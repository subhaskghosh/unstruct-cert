{"_id": "Academic--research_data--n--66548", "text": "{\n    \"dataset_name\": \"Historical Ice Core Data\",\n    \"creator\": {\n        \"name\": \"Jean-Claude Dutrieux\",\n        \"affiliation\": \"University of Grenoble Alpes\"\n    },\n    \"date_collected\": \"2019-12-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Oxygen Isotopes\",\n            \"units\": \"permil\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ice core extraction from Antarctica\",\n    \"related_publications\": [\n        {\n            \"title\": \"Paleoclimate Reconstruction\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://example.com/ice_core_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Isotopic and gas composition of ancient ice\"\n    }\n}"}
{"_id": "Academic--research_data--p--66549", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"Forest Loss\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2020_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Provides yearly global forest change data\"\n    }\n}"}
