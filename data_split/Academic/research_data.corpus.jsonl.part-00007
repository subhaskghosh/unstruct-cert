{"_id": "Academic--research_data--p--70773", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Loss\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Remote Sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_hansen_global_forest_change_2000_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data covers global forest change from 2000-2020.\"\n    }\n}"}
