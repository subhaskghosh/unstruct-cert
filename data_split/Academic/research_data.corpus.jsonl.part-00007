{"_id": "Academic--research_data--n--66263", "text": "{\n    \"dataset_name\": \"Historical CO2 Emissions\",\n    \"creator\": {\n        \"name\": \"Corinne Le Quéré\",\n        \"affiliation\": \"University of East Anglia\"\n    },\n    \"date_collected\": \"2019-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"Gigatonnes\"\n        },\n        {\n            \"name\": \"Country\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"Year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"National inventory reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global CO2 Emissions\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_emissions.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Annual CO2 emissions by country\"\n    }\n}"}
