{"_id": "Academic--research_data--p--67152", "text": "{\n    \"dataset_name\": \"Coastal Climate Impact Assessment Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_level\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite remote sensing and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Sea Level Rise on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality flags for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67152", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"leaf_area_index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Ground-based forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Californian Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data is categorized by forest type.\"\n    }\n}"}
