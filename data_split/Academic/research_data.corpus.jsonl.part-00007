{"_id": "Academic--research_data--n--67008", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Estimates\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Remote sensing data and ground-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment 2020\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/global_forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"8.9 GB\",\n        \"annotations\": \"Raster data with spatial resolution of 30m.\"\n    }\n}"}
