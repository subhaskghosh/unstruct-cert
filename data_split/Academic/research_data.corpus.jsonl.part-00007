{"_id": "Academic--research_data--n--68471", "text": "{\n    \"dataset_name\": \"Industrial Emissions Monitoring - European Union\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2024-01-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NOx\",\n            \"unit\": \"kg/year\",\n            \"description\": \"Nitrogen oxides emissions from industrial facilities\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"unit\": \"kg/year\",\n            \"description\": \"Sulfur dioxide emissions from industrial facilities\"\n        },\n        {\n            \"name\": \"CO2\",\n            \"unit\": \"tonnes/year\",\n            \"description\": \"Carbon dioxide emissions from industrial facilities\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Mandatory reporting by industrial facilities\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Industrial Emissions Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.eea.europa.eu/industrial-emissions\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Detailed facility-level emissions data, requiring specific access permissions.\"\n    }\n}"}
