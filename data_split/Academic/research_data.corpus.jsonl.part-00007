{"_id": "Academic--research_data--p--66746", "text": "{\n    \"dataset_name\": \"Urban Air Quality and Temperature Monitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"particulate_matter_2.5\",\n            \"unit\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
