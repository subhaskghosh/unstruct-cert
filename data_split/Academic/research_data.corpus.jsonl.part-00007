{"_id": "Academic--research_data--n--67322", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Trends in North America\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Basic data cleaning performed.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67323", "text": "{\n    \"dataset_name\": \"Global Forest Change Impacts Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover_loss\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"biomass_change\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing, Landsat imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/glad/gee_v1_4\",\n    \"metadata\": {\n        \"data_size\": \"100 GB\",\n        \"annotations\": \"Contains data on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67323", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Output\",\n    \"creator\": {\n        \"name\": \"Various\",\n        \"affiliation\": \"International Climate Modeling Community\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"sea_level_pressure\",\n            \"units\": \"Pa\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Coupled Model Intercomparison Project Phase 6 (CMIP6) experimental design\",\n            \"authors\": [\n                \"Eyring\",\n                \"Boucher\",\n                \"Eyring\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"5 TB\",\n        \"annotations\": \"High-resolution climate model output from various institutions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67324", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"TemperatureAnomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67324", "text": "{\n    \"dataset_name\": \"Coral Reef Bleaching Events\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2022-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"BleachingSeverity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"variable_name\": \"CoralSpecies\",\n            \"units\": \"Species Name\"\n        },\n        {\n            \"variable_name\": \"ReefLocation\",\n            \"units\": \"Geographic Coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CSIRO OAR Licence\",\n    \"sampling_method\": \"In-situ surveys of coral reefs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coral Reefs\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.aims.gov.au/reef-bleaching\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data on coral bleaching events across the Great Barrier Reef.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67325", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated Buoys and Shipboard Measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67325", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"EPA Air Quality Division\"\n    },\n    \"date_collected\": \"2023-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0 International\",\n    \"sampling_method\": \"Fixed Monitoring Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic on air quality\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes instrument calibration information.\"\n    }\n}"}
