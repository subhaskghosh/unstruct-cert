{"_id": "Academic--research_data--p--67027", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67027", "text": "{\n    \"dataset_name\": \"Forest Birdsong Recordings\",\n    \"creator\": {\n        \"name\": \"Ornithological Society\",\n        \"affiliation\": \"University of California\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"Species Name\"\n        },\n        {\n            \"name\": \"Recording Duration\",\n            \"units\": \"seconds\"\n        },\n        {\n            \"name\": \"Signal Strength\",\n            \"units\": \"dB\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0\",\n    \"sampling_method\": \"Acoustic monitoring using automated recorders\",\n    \"related_publications\": [\n        {\n            \"title\": \"Birdsong Diversity in California Forests\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/birdsong_recordings.zip\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Bird species identified using automated analysis\"\n    }\n}"}
{"_id": "Academic--research_data--p--67028", "text": "{\n    \"dataset_name\": \"Global Air Quality and Meteorological Data\",\n    \"creator\": {\n        \"name\": \"OpenAQ\",\n        \"affiliation\": \"OpenAQ Platform\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Network of public and private sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in PM2.5 Concentrations\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://openaq.org/data\",\n    \"metadata\": {\n        \"data_size\": \"15 GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
