{"_id": "Academic--research_data--p--71772", "text": "{\n    \"dataset_name\": \"Global Forest Biodiversity Database\",\n    \"creator\": {\n        \"name\": \"Oliver Phillips\",\n        \"affiliation\": \"University of Leeds\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"diameter_at_breast_height\",\n            \"units\": \"centimeters\"\n        },\n        {\n            \"variable_name\": \"species\",\n            \"units\": \"scientific name\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Stratified random sampling in forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global patterns of forest structure and diversity\",\n            \"authors\": [\n                \"Phillips\",\n                \"et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes data from over 1000 forest plots worldwide.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71772", "text": "{\n    \"dataset_name\": \"Deep Subsurface Geochemical Survey\",\n    \"creator\": {\n        \"name\": \"James Holden\",\n        \"affiliation\": \"US Geological Survey\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"radon_concentration\",\n            \"units\": \"Bq/L\"\n        },\n        {\n            \"variable_name\": \"methane_flux\",\n            \"units\": \"mg/m^2/day\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Downhole logging and core sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Earth Geochemical Anomalies\",\n            \"authors\": [\n                \"Holden\",\n                \"et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/geochemical_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data collected from deep subsurface boreholes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71773", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71773", "text": "{\n    \"dataset_name\": \"Global Industrial Emissions\",\n    \"creator\": {\n        \"name\": \"EnviroTech Solutions\",\n        \"affiliation\": \"Commercial Environmental Data Provider\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"SO2 Emissions\",\n            \"units\": \"tonnes\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Reported emissions data from industrial facilities\",\n    \"related_publications\": [],\n    \"download_url\": \"https://envirotechsolutions.com/emissions_data.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is provided as reported by industry, no independent verification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71774", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GSTA)\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Direct observation from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Global Reconstruction of Surface Temperature\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-summary-of-the-day/access/\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71774", "text": "{\n    \"dataset_name\": \"Projected Climate Change Scenarios\",\n    \"creator\": {\n        \"name\": \"Climate Modeling Consortium\",\n        \"affiliation\": \"University of Example\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature_projection\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"precipitation_projection\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Climate model simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Projections\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.edu/climate_data\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Based on CMIP6 models\"\n    }\n}"}
{"_id": "Academic--research_data--p--71775", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"University of Michigan Water Center\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"dissolved_oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"ph\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"conductivity\",\n            \"units\": \"uS/cm\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from fixed buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data has been quality-controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71775", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Environmental Monitoring Center\",\n        \"affiliation\": \"Beijing Government\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pm2.5\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Beijing\",\n            \"authors\": [\n                \"Wang, L.\",\n                \"Zhang, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data is raw and requires preprocessing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71776", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Dataset\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Global grid cell averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent warming trends and impacts\",\n            \"authors\": [\n                \"Hansen\",\n                \"Sato\",\n                \"Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Contains monthly average temperatures from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71776", "text": "{\n    \"dataset_name\": \"North Atlantic Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NOAA Oceanography\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Buoy and satellite measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean heat content changes\",\n            \"authors\": [\n                \"Levitus\",\n                \"Antonov\",\n                \"Boyd\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atlantic_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Provides anomalies in sea surface temperatures for the North Atlantic.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71777", "text": "{\n    \"dataset_name\": \"Global Land Cover Dataset\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"USGS Earth Resources Observation and Science (EROS) Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Cover Type\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Distance to Water\",\n            \"units\": \"kilometers\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Satellite Imagery Analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Land Cover Mapping with High Resolution Satellite Data\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/landcover.tif\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Detailed land cover classifications\"\n    }\n}"}
{"_id": "Academic--research_data--n--71777", "text": "{\n    \"dataset_name\": \"Bee Foraging Behavior\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Flower Species Visited\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Distance from Hive\",\n            \"units\": \"centimeters\"\n        },\n        {\n            \"name\": \"Foraging Time\",\n            \"units\": \"seconds\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Direct Observation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Foraging Patterns of Honeybees in California\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Brown, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bee_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Individual bee foraging behavior\"\n    }\n}"}
{"_id": "Academic--research_data--p--71778", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71778", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Africa\",\n    \"creator\": {\n        \"name\": \"University of Nairobi\",\n        \"affiliation\": \"Department of Meteorology\"\n    },\n    \"date_collected\": \"2018-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Rain gauge network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in East Africa\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.example.com/rainfall_africa.csv\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Missing data values denoted as -999\"\n    }\n}"}
{"_id": "Academic--research_data--p--71779", "text": "{\n    \"dataset_name\": \"Global Marine Ecosystem Survey 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanographic Centre\",\n        \"affiliation\": \"University of Southampton\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a Concentration\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Autonomous Underwater Vehicle (AUV) transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Marine Ecosystems\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
