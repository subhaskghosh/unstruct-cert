{"_id": "Academic--research_data--n--71960", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2018-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Corn Yield\",\n            \"unit\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Soybean Yield\",\n            \"unit\": \"bushels/acre\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Agricultural surveys and farm reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Agricultural Productivity\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.csv\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data validated by agricultural experts\"\n    }\n}"}
