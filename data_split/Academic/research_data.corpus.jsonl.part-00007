{"_id": "Academic--research_data--p--68606", "text": "{\n    \"dataset_name\": \"Lake Erie Nutrient Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA Great Lakes Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Nutrient Loading and Water Quality in Lake Erie\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68606", "text": "{\n    \"dataset_name\": \"Pacific Ocean Marine Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"individuals/m^3\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Ocean Current Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phytoplankton Biomass\",\n            \"units\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Zooplankton Biomass\",\n            \"units\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Chlorophyll-a Concentration\",\n            \"units\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Silicate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Ammonium Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentrations\",\n            \"units\": \"ug/L\"\n        },\n        {\n            \"name\": \"Microplastic Concentration\",\n            \"units\": \"particles/L\"\n        },\n        {\n            \"name\": \"Fish Population Density\",\n            \"units\": \"individuals/km^2\"\n        },\n        {\n            \"name\": \"Benthic Invertebrate Diversity\",\n            \"units\": \"Shannon Index\"\n        },\n        {\n            \"name\": \"Seabed Sediment Type\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Water Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Light Penetration\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Towed net and sensor deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity of the Pacific Ocean\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Lee, B.\",\n                \"Park, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_ocean_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Species identification verified by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68607", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"ug/L\"\n        },\n        {\n            \"name\": \"Total Phosphorus\",\n            \"units\": \"ug/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular transect sampling across the lake at various depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://limnology.wisc.edu/data/mendota/\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68607", "text": "{\n    \"dataset_name\": \"National River Flow Data\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2022-03-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Discharge\",\n            \"units\": \"cubic feet per second\"\n        },\n        {\n            \"name\": \"Water Level\",\n            \"units\": \"feet\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations at key river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"River Flow Trends in the United States\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://waterdata.usgs.gov/nwis\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is provisional and subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68608", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2024-01-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68608", "text": "{\n    \"dataset_name\": \"Coastal Phytoplankton Dynamics - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"NOAA Oceanographic Institute\",\n        \"affiliation\": \"Marine Biology Division\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m³\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-based measurements and satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Phytoplankton Blooms in the Pacific\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/phytoplankton.nc\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data includes spatial coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68609", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-10-26T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Discrete water samples collected at various depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality in Lake Mendota\",\n            \"authors\": \"Smith et al.\"\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_mendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68609", "text": "{\n    \"dataset_name\": \"Global Air Pollution Monitoring\",\n    \"creator\": {\n        \"name\": \"OpenAQ\",\n        \"affiliation\": \"Non-profit organization\"\n    },\n    \"date_collected\": \"2022-01-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Data aggregated from various monitoring stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global patterns of air pollution\",\n            \"authors\": \"Jones et al.\"\n        }\n    ],\n    \"download_url\": \"https://example.com/global_air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"15 MB\",\n        \"annotations\": \"Metadata includes station location and calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68610", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68610", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment - Amazon\",\n    \"creator\": {\n        \"name\": \"University of Sao Paulo\",\n        \"affiliation\": \"Institute of Biosciences\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of different plant species observed.\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\",\n            \"description\": \"Number of trees per hectare.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Rainforest\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Species identification confirmed by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68611", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone Concentration\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ground-level ozone.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        },\n        {\n            \"variable_name\": \"Wind Speed\",\n            \"units\": \"m/s\",\n            \"description\": \"Average wind speed.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensor stations with data loggers and periodic calibration.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Morphology on Air Pollution\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12GB\",\n        \"annotations\": \"Data has been quality controlled and calibrated. Missing values have been imputed using a nearest neighbor method.\",\n        \"file_count\": 250\n    }\n}"}
{"_id": "Academic--research_data--n--68611", "text": "{\n    \"dataset_name\": \"Simple Temperature Readings from a Single Sensor\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Temperature measured by a single sensor.\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Manual readings taken once per hour.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/single_temp_sensor.txt\",\n    \"metadata\": {\n        \"data_size\": \"10KB\",\n        \"annotations\": \"Raw data, no quality control performed.\",\n        \"file_count\": 1\n    }\n}"}
{"_id": "Academic--research_data--p--68612", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Wind Direction\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across Greater London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68612", "text": "{\n    \"dataset_name\": \"Industrial Emissions Report - Midlands\",\n    \"creator\": {\n        \"name\": \"ChemCorp Ltd\",\n        \"affiliation\": \"Private Industrial Company\"\n    },\n    \"date_collected\": \"2024-01-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2 Emissions\",\n            \"units\": \"kg/hr\"\n        },\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"kg/hr\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Proprietary License\",\n    \"sampling_method\": \"Self-reported emissions data from industrial facilities.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/industrial_emissions.xml\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is based on company reports.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68613", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Dataset\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Carbon Stock\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Land Cover Type\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping global forest carbon stocks\",\n            \"authors\": [\n                \"Jones, A.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68613", "text": "{\n    \"dataset_name\": \"Daily Weather Records for London\",\n    \"creator\": {\n        \"name\": \"UK Meteorological Office\",\n        \"affiliation\": \"Government Agency\"\n    },\n    \"date_collected\": \"2022-10-27T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"km/h\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Government License\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate trends in urban environments\",\n            \"authors\": [\n                \"Davis, C.\",\n                \"Wilson, D.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes hourly measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68614", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68614", "text": "{\n    \"dataset_name\": \"Historical Weather Records - Europe\",\n    \"creator\": {\n        \"name\": \"European Meteorological Archives\",\n        \"affiliation\": \"EU Climate Research Consortium\"\n    },\n    \"date_collected\": \"2018-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Daily Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"Average Temperature\",\n            \"units\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted Use License\",\n    \"sampling_method\": \"Automated weather stations across Europe\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Trends\",\n            \"authors\": [\n                \"Hans von Storch\",\n                \"Edward Hanna\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://euclimate.org/data\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Preliminary data, subject to revision\"\n    }\n}"}
{"_id": "Academic--research_data--p--68615", "text": "{\n    \"dataset_name\": \"Lake Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular sampling at fixed locations across the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in lake water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68615", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. James Wilson\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Fish Biodiversity\",\n            \"units\": \"species count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys and water sample collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of climate change on coral reefs\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"3MB\",\n        \"annotations\": \"Data includes images of coral reefs.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68616", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Bird Vocalizations\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"vocalization_frequency\",\n            \"units\": \"Hz\"\n        },\n        {\n            \"name\": \"bird_species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"name\": \"time_of_day\",\n            \"units\": \"HH:mm:ss\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Acoustic monitoring with automated recorders\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Deforestation on Bird Vocalization Patterns\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_bird_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Vocalization types labeled (song, call, alarm)\"\n    }\n}"}
{"_id": "Academic--research_data--n--68616", "text": "{\n    \"dataset_name\": \"Global Fisheries Catch Data\",\n    \"creator\": {\n        \"name\": \"FAO Fisheries Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"catch_weight\",\n            \"units\": \"metric tons\"\n        },\n        {\n            \"name\": \"fish_species\",\n            \"units\": \"species code\"\n        },\n        {\n            \"name\": \"location\",\n            \"units\": \"latitude, longitude\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"FAO Data License\",\n    \"sampling_method\": \"Reports from member countries\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Fisheries\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/fisheries_data.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Catch data aggregated by species and region\"\n    }\n}"}
{"_id": "Academic--research_data--p--68617", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68617", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Deforestation Rate\",\n            \"units\": \"hectares/year\"\n        }\n    ],\n    \"data_format\": \"GeoJSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Deforestation Patterns\",\n            \"authors\": [\n                \"Carter, E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.geojson\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Accuracy assessed using ground truth data\"\n    }\n}"}
{"_id": "Academic--research_data--p--68618", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Gain\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"unit\": \"tonnes\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis using Landsat data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen, M. C.\",\n                \"et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2020_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Dataset covers global forest changes from 2000-2020\"\n    }\n}"}
{"_id": "Academic--research_data--n--68618", "text": "{\n    \"dataset_name\": \"Local Air Quality Measurements - City X\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2022-10-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ground-based sensor network\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/airquality_cityx.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Air quality measurements for City X, collected in October 2022.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68619", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"unit\": \"percent\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis using Landsat data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"publication_year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"150GB\",\n        \"annotations\": \"Contains data on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68619", "text": "{\n    \"dataset_name\": \"African Elephant Movement Data\",\n    \"creator\": {\n        \"name\": \"Holly Strand\",\n        \"affiliation\": \"Save the Elephants\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"speed\",\n            \"unit\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"GPS collar tracking of individual elephants.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-distance dispersal patterns of African elephants.\",\n            \"authors\": \"Strand, H., et al.\",\n            \"publication_year\": 2024\n        }\n    ],\n    \"download_url\": \"https://savetheelephants.org/dataset/elephant-movement-data/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"GPS locations of tracked elephants in Africa.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68620", "text": "{\n    \"dataset_name\": \"Remote Sensing Climate Data - California\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Vegetation Index\",\n            \"units\": \"NDVI\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Satellite Imagery - Landsat 8\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on California Vegetation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/california_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes cloud masking and atmospheric correction.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68620", "text": "{\n    \"dataset_name\": \"Historical Weather Records - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/global_weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68621", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023-2024\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations, hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic emissions on urban air quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data quality flags included, station locations provided in supplementary file.\"\n    }\n}"}
