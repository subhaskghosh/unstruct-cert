{"_id": "Academic--research_data--n--69126", "text": "{\n    \"dataset_name\": \"Ocean Plastic Distribution\",\n    \"creator\": {\n        \"name\": \"Ocean Conservancy\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plastic Concentration\",\n            \"units\": \"kg/km^2\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Ship-based surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Plastic Pollution in Oceans\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/plastic_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data on plastic debris found in ocean surface waters.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69127", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Monthly temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--69127", "text": "{\n    \"dataset_name\": \"Coral Reef Health\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CoralCover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"BleachingLevel\",\n            \"units\": \"index\"\n        },\n        {\n            \"name\": \"WaterQuality\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"SCUBA diving surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term monitoring of coral reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.aims.gov.au/coralreefhealth\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Coral reef condition assessments\"\n    }\n}"}
{"_id": "Academic--research_data--p--69128", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Health\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Image Resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Tumor Size\",\n            \"units\": \"mm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_dataset\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Manual segmentation by radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--69128", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"University Hospital\"\n    },\n    \"date_collected\": \"2023-06-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Image Quality\",\n            \"units\": \"scale of 1-5\"\n        },\n        {\n            \"name\": \"Lung Opacity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Prospective study with patient consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Pneumonia Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Automated and verified by radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--p--69129", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"species_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"migration_date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated tracking using GPS loggers on tagged birds\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-distance migration patterns of North American songbirds\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes observations from 2023-2024 migration seasons\"\n    }\n}"}
{"_id": "Academic--research_data--n--69129", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Tree Species\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"diameter_at_breast_height\",\n            \"units\": \"centimeters\"\n        },\n        {\n            \"name\": \"species_name\",\n            \"units\": \"string\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random forest plots within a defined area\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity assessment of the central Amazon\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_tree_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data collected during the 2022 expedition\"\n    }\n}"}
