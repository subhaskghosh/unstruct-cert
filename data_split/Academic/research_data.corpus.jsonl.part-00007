{"_id": "Academic--research_data--p--70124", "text": "{\n    \"dataset_name\": \"Air Quality and Biodiversity Monitoring in Urban Parks\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Bird Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Plant Biodiversity Index\",\n            \"units\": \"index\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Systematic sampling within designated park zones.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Urban Bird Populations\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70124", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns in Coastal Regions\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring from weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Coastal Climate\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been gap-filled using interpolation.\"\n    }\n}"}
