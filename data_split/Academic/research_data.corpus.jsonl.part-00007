{"_id": "Academic--research_data--n--68894", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"Global Historical Climatology Network\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/temp_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2 GB\",\n        \"annotations\": \"Data quality control procedures are documented separately.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68895", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68895", "text": "{\n    \"dataset_name\": \"Climate Change Projection - 2024\",\n    \"creator\": {\n        \"name\": \"Global Modeling Consortium\",\n        \"affiliation\": \"International Climate Research Institute\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Precipitation Change\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"General Circulation Model (GCM) simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_projection.nc\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Model output based on various emission scenarios\"\n    }\n}"}
{"_id": "Academic--research_data--p--68896", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Standard Deviation\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Temperature data is bias-corrected.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68896", "text": "{\n    \"dataset_name\": \"Specific Coral Reef Biodiversity Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Marine Biology\"\n    },\n    \"date_collected\": \"2021-08-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species A Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Coral Species B Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Coral Species C Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Light Intensity\",\n            \"units\": \"lux\"\n        },\n        {\n            \"name\": \"Fish Species X Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Fish Species Y Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Algae Coverage\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Seagrass Coverage\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Sediment Composition A\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Sediment Composition B\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Sediment Composition C\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Current Velocity\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Wave Height\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Transect surveys of coral reefs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Biodiversity in the Pacific\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from specific reefs in the Pacific Ocean.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68897", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"variable_name\": \"Phosphorus\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated buoys and discrete water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
