{"_id": "Academic--research_data--n--71226", "text": "{\n    \"dataset_name\": \"GeneticMarkers_COVID19\",\n    \"creator\": {\n        \"name\": \"Dr. Alex Johnson\",\n        \"affiliation\": \"Harvard Medical School\"\n    },\n    \"date_collected\": \"2023-11-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Gene_A_Expression\",\n            \"units\": \"Relative Expression\"\n        },\n        {\n            \"name\": \"Gene_B_Mutation\",\n            \"units\": \"Boolean\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Patient sample collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Genetic Factors in COVID-19 Severity\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/covid_genetic_data.json\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Raw genetic data; requires preprocessing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71227", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated Sensor Network\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Air Quality Trends 2020-2024\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data cleaned and validated by GLA.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71227", "text": "{\n    \"dataset_name\": \"BirdSpeciesObservations_UK\",\n    \"creator\": {\n        \"name\": \"Royal Society for the Protection of Birds\",\n        \"affiliation\": \"Citizen Science Programme\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Observation Count\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Latitude, Longitude\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Citizen Science - Visual Observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"UK Bird Population Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.rspb.org.uk/birdsightings.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Observations reported by volunteers across the UK.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71228", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
