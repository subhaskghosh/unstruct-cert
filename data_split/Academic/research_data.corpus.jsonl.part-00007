{"_id": "Academic--research_data--n--70869", "text": "{\n    \"dataset_name\": \"Coastal Water Quality - California\",\n    \"creator\": {\n        \"name\": \"California State Water Resources Control Board\",\n        \"affiliation\": \"Environmental Monitoring Division\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Weekly water sample collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Water Quality Assessment\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://waterdata.ca.gov/coastal.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data represents weekly measurements from coastal monitoring sites.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70870", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2020-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global average temperature measurements from meteorological stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature Anomalies\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70870", "text": "{\n    \"dataset_name\": \"Historical Crop Yields - 1990-2019\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"Agricultural Research Institute\"\n    },\n    \"date_collected\": \"2019-12-31T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Crop Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Fertilizer Usage\",\n            \"units\": \"kg/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Crop yield data collected from agricultural surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Crop Yields Over Three Decades\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.csv\",\n    \"metadata\": {\n        \"data_size\": \"3MB\",\n        \"annotations\": \"Data includes annual crop yields for various regions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70871", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Gross Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"year\": 2013,\n            \"journal\": \"Science\"\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_hansen_global_forest_change_2008_2018_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"200 GB\",\n        \"annotations\": \"High-quality, peer-reviewed dataset with comprehensive documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70871", "text": "{\n    \"dataset_name\": \"Urban Bee Pollen Analysis\",\n    \"creator\": {\n        \"name\": \"Sarah Miller\",\n        \"affiliation\": \"City University\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Pollen Type\",\n            \"units\": \"species\"\n        },\n        {\n            \"name\": \"Pollen Count\",\n            \"units\": \"grains/sample\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Pollen traps in urban gardens\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pollen diversity in urban environments\",\n            \"authors\": \"Miller, S.\",\n            \"year\": 2023,\n            \"journal\": \"Urban Ecology\"\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_bee_pollen\",\n    \"metadata\": {\n        \"data_size\": \"50 MB\",\n        \"annotations\": \"Preliminary analysis, further research needed.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70872", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global station data with infilling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Includes monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--70872", "text": "{\n    \"dataset_name\": \"Soil Moisture Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Academic Non-Commercial License\",\n    \"sampling_method\": \"Field measurements at specific locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Moisture Dynamics\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.edu/soil_moisture_data\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data collected from agricultural lands\"\n    }\n}"}
{"_id": "Academic--research_data--p--70873", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
