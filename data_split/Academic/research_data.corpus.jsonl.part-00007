{"_id": "Academic--research_data--p--71578", "text": "{\n    \"dataset_name\": \"Atmospheric Greenhouse Gas Concentrations - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring at global stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2023\",\n            \"authors\": [\n                \"Friedlingstein, P.\",\n                \"O'Sullivan, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://gmd.noaa.gov/data/co2-ghg-data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"High-quality, globally representative data\"\n    }\n}"}
{"_id": "Academic--research_data--n--71578", "text": "{\n    \"dataset_name\": \"North Atlantic Ocean Temperature and Salinity\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Department of Oceanography\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Ship-based measurements and moorings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Heat Content Changes\",\n            \"authors\": [\n                \"Cheng, L.\",\n                \"Abraham, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.whoi.edu/ocean-data.nc\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Detailed oceanographic data\"\n    }\n}"}
{"_id": "Academic--research_data--p--71579", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (NIH)\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Height\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Image Width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"category\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective collection from patient records\",\n    \"related_publications\": [\n        {\n            \"title\": \"CheXpert: A Large Chest X-Ray Dataset with Annotation and Reporting\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Image-level labels for multiple pathologies\"\n    }\n}"}
{"_id": "Academic--research_data--n--71579", "text": "{\n    \"dataset_name\": \"Cardiac MRI Images\",\n    \"creator\": {\n        \"name\": \"Massachusetts General Hospital\",\n        \"affiliation\": \"MGH Cardiology Department\"\n    },\n    \"date_collected\": \"2024-02-29T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Slice Thickness\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Cardiac Phase\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Prospective study of patients with heart failure\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Segmentation of Cardiac Structures from MRI\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/cardiac_mri\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Manual segmentations of left ventricle, right ventricle, and myocardium\"\n    }\n}"}
{"_id": "Academic--research_data--p--71580", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-10T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass with High Resolution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes uncertainty estimates for biomass density.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71580", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2022-11-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Urban Air Pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71581", "text": "{\n    \"dataset_name\": \"Coastal Erosion Monitoring - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Oceanography\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"ErosionRate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"variable_name\": \"SeaLevelRise\",\n            \"units\": \"mm/year\"\n        },\n        {\n            \"variable_name\": \"WaveHeight\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"SedimentComposition\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular shoreline surveys using GPS and drone imagery.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Erosion Trends in the Pacific Northwest\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"350MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71581", "text": "{\n    \"dataset_name\": \"Greenland Ice Sheet Thickness\",\n    \"creator\": {\n        \"name\": \"Dr. Lars Hansen\",\n        \"affiliation\": \"Danish Meteorological Institute\"\n    },\n    \"date_collected\": \"2021-07-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"IceThickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"SurfaceElevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Radar altimetry from aircraft.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Greenland Ice Sheet Thickness\",\n            \"authors\": [\n                \"Hansen, L.\",\n                \"Schmidt, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/greenland_ice_data.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data is pre-processed to remove noise.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71582", "text": "{\n    \"dataset_name\": \"Remote Sensing Air Quality Data - Montana\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Montana, Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"O3 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing data from satellite imagery combined with ground-based sensor readings.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Air Quality Over the Rocky Mountain Region\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/montana_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags and metadata on sensor calibration.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71582", "text": "{\n    \"dataset_name\": \"New York City Air Quality Monitoring - 2021\",\n    \"creator\": {\n        \"name\": \"NYC Department of Environmental Protection\",\n        \"affiliation\": \"New York City Government\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2 Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations throughout the five boroughs of New York City.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/nyc_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data represents average hourly readings.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71583", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Regular sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71583", "text": "{\n    \"dataset_name\": \"Global Air Pollution Levels\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO\"\n    },\n    \"date_collected\": \"2021-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Data aggregated from monitoring stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Impact of Air Pollution on Human Health\",\n            \"authors\": [\n                \"Brown, A.\",\n                \"Green, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airpollution.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data includes uncertainty estimates\"\n    }\n}"}
{"_id": "Academic--research_data--p--71584", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Oceanography\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Automated sensors deployed on research vessels and fixed buoys. Data collected hourly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Acidification on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated against laboratory measurements. Excellent data lineage and documentation provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71584", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Greater London Authority\"\n    },\n    \"date_collected\": \"2023-08-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Continuous monitoring stations across London. Data collected every 5 minutes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution and Respiratory Health in Urban Populations\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Raw data from monitoring stations. Minimal quality control applied.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71585", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021\",\n    \"creator\": {\n        \"name\": \"Hadley Centre for Climate Prediction and Research\",\n        \"affiliation\": \"UK Met Office\"\n    },\n    \"date_collected\": \"2021-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"sea_ice_extent\",\n            \"units\": \"square kilometers\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Gridded data from weather stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature update: 2021\",\n            \"authors\": [\n                \"Jones, P.D.\",\n                \"et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality flags included for each data point.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71585", "text": "{\n    \"dataset_name\": \"Climate Change Perception Survey - USA\",\n    \"creator\": {\n        \"name\": \"Pew Research Center\",\n        \"affiliation\": \"Pew Research Center\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"belief_in_climate_change\",\n            \"units\": \"Likert scale\"\n        },\n        {\n            \"variable_name\": \"political_affiliation\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Nationally representative survey conducted via telephone.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/survey_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Demographic information included for each respondent.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71586", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Automated sensors deployed at multiple locations along the river\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71586", "text": "{\n    \"dataset_name\": \"AtmosphericPollutionLevels\",\n    \"creator\": {\n        \"name\": \"Dr. David Brown\",\n        \"affiliation\": \"Government Environmental Agency\"\n    },\n    \"date_collected\": \"2022-12-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"authors\": [\n                \"Brown, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data is pre-processed for easy analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71587", "text": "{\n    \"dataset_name\": \"US National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"US Geological Survey & University of Minnesota\",\n        \"affiliation\": \"USGS & UMN\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Systematic sampling at fixed stations across the US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/water/nwqan/data\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes quality control flags and metadata on sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71587", "text": "{\n    \"dataset_name\": \"Local Stream Health Indicators\",\n    \"creator\": {\n        \"name\": \"Community Environmental Group\",\n        \"affiliation\": \"Local Volunteers\"\n    },\n    \"date_collected\": \"2018-08-20T09:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Macroinvertebrate Index\",\n            \"units\": \"Index Score\"\n        },\n        {\n            \"name\": \"Visual Pollution\",\n            \"units\": \"Qualitative Assessment\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"Restricted - for local use only\",\n    \"sampling_method\": \"Opportunistic sampling by volunteers in a single county.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://communitygroup.org/streamdata\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Limited metadata, primarily focused on volunteer observations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71588", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Environmental Sciences\"\n    },\n    \"date_collected\": \"2023-07-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"μg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Location\",\n            \"unit\": \"Latitude, Longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London boroughs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality checked and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71588", "text": "{\n    \"dataset_name\": \"Rural Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Forestry Research Institute\"\n    },\n    \"date_collected\": \"2023-11-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"unit\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"unit\": \"Shannon Diversity Index\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Random forest plots across national forests\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment Report\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected as part of a long-term ecological monitoring program.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71589", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"Boston University Environmental Health Department\",\n        \"affiliation\": \"Boston University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Populations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes hourly averages and quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71589", "text": "{\n    \"dataset_name\": \"Global Forest Inventory Data\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization of the United Nations\",\n        \"affiliation\": \"FAO\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing and field measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment 2025\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_inventory.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes tree-level measurements from various forest plots.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71590", "text": "{\n    \"dataset_name\": \"Twitter Engagement and Sentiment Analysis - 2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Computer Science\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"tweet_text\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"retweet_count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"like_count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"unit\": \"scale of -1 to 1\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Random sampling of public tweets\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Sentiment Trends on Twitter\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/twitter_engagement.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Sentiment analysis labels provided\"\n    }\n}"}
{"_id": "Academic--research_data--n--71590", "text": "{\n    \"dataset_name\": \"Reddit Political Discussion Dataset\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"post_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"subreddit\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"post_text\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"upvote_count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"downvote_count\",\n            \"unit\": \"count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Scraping Reddit posts from specified subreddits\",\n    \"related_publications\": [\n        {\n            \"title\": \"Political Polarization on Reddit\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/reddit_politics.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"None\"\n    }\n}"}
{"_id": "Academic--research_data--p--71591", "text": "{\n    \"dataset_name\": \"Coastal Erosion Impact Study - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Erosion Rate\",\n            \"unit\": \"meters/year\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"unit\": \"mm/year\"\n        },\n        {\n            \"name\": \"Vegetation Cover\",\n            \"unit\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random stratified sampling along 50 coastal locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Sea Level Rise on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71591", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2022\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded dataset based on station data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data is bias-corrected.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71592", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_2024\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Environmental Science Department\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers in diameter\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Wildfires on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_2024.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71592", "text": "{\n    \"dataset_name\": \"WaterQuality_2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Oceanic Research Division\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Amount of dissolved oxygen in water\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"units\",\n            \"description\": \"Acidity or alkalinity of water\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Grab samples from rivers and lakes\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Pollution on Aquatic Ecosystems\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/waterquality_2023.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Sampling locations provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--71593", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Quality on Respiratory Health in Urban Populations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71593", "text": "{\n    \"dataset_name\": \"Indoor Air Quality in Homes - California\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"VOCs\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Sensor data from residential homes\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Ventilation on Indoor Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/california_indoor_air.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data collected during winter months.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71594", "text": "{\n    \"dataset_name\": \"Water Quality Monitoring Data - Lake Mendota\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Weekly grab samples collected at multiple depths\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in lake water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_mendota_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71594", "text": "{\n    \"dataset_name\": \"Global Climate Model Output - CMIP6\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"NCAR\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Sea Surface Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Climate model simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future climate projections under different scenarios\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/cmip6_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data requires significant processing and expertise to interpret.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71595", "text": "{\n    \"dataset_name\": \"North American Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"United States Government\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across North America\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Air Quality in North America\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/north_america_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71595", "text": "{\n    \"dataset_name\": \"Indoor Air Quality in Homes - 2023\",\n    \"creator\": {\n        \"name\": \"Residential Health Studies\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-06-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"VOC Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Carbon Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Voluntary household surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Indoor Air Pollution and Health\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/indoor_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Limited metadata available\"\n    }\n}"}
{"_id": "Academic--research_data--p--71596", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"variable_name\": \"gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"variable_name\": \"loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"carbon_emissions\",\n            \"units\": \"tonnes\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Contains data on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71596", "text": "{\n    \"dataset_name\": \"Urban Temperature Data\",\n    \"creator\": {\n        \"name\": \"City Planning Department\",\n        \"affiliation\": \"Metropolis City Hall\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Sensor network deployed across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effect in Metropolis\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"http://citydata.metropolis.gov/temperature\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Temperature and humidity readings from urban sensors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71597", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Environmental Institute\"\n    },\n    \"date_collected\": \"2023-07-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London boroughs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71597", "text": "{\n    \"dataset_name\": \"Rural Ecosystem Health - Scottish Highlands\",\n    \"creator\": {\n        \"name\": \"Professor Alistair McGregor\",\n        \"affiliation\": \"University of Edinburgh, School of Biological Sciences\"\n    },\n    \"date_collected\": \"2023-05-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"units\": \"Shannon Diversity Index\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling across the Scottish Highlands\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ecosystem Resilience in Remote Areas\",\n            \"authors\": \"McGregor, A. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/scottish_highlands_ecosystem.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes weekly measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71598", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"United States Department of Commerce\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensor deployments and periodic water sample collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Nutrient Runoff on Coastal Ecosystems\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71598", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Inventory\",\n    \"creator\": {\n        \"name\": \"Local University Research Group\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Academic Non-Commercial License\",\n    \"sampling_method\": \"Random plot sampling within designated forest areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Species Distribution Modeling in Temperate Forests\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species names follow international nomenclature standards\"\n    }\n}"}
{"_id": "Academic--research_data--p--71599", "text": "{\n    \"dataset_name\": \"Freshwater Lake Monitoring - Summer 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley - Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-07-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 lake locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Lake Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71599", "text": "{\n    \"dataset_name\": \"Coastal Ocean Salinity Data\",\n    \"creator\": {\n        \"name\": \"Dr. James Olsen\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mL/L\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Autonomous underwater vehicle transects.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanographic Conditions off the Coast of Maine\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_salinity_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data has been calibrated against standard seawater samples.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71600", "text": "{\n    \"dataset_name\": \"Social Interaction Patterns in Public Spaces\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"Independent Research Institute\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Interaction Duration\",\n            \"units\": \"seconds\"\n        },\n        {\n            \"name\": \"Group Size\",\n            \"units\": \"number of people\"\n        },\n        {\n            \"name\": \"Proximity\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Observational study in public parks\",\n    \"related_publications\": [\n        {\n            \"title\": \"Patterns of Social Interaction in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/social_interactions.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data is anonymized and includes demographic estimations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71600", "text": "{\n    \"dataset_name\": \"MIT Social Dynamics Study\",\n    \"creator\": {\n        \"name\": \"Prof. David Chen\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-11-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Communication Frequency\",\n            \"units\": \"messages per hour\"\n        },\n        {\n            \"name\": \"Network Centrality\",\n            \"units\": \"score\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Online social network analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Influence of Network Structure on Social Behavior\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://mit.edu/social_dynamics.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data contains user IDs.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71601", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Wisconsin Department of Natural Resources\",\n        \"affiliation\": \"Wisconsin DNR\"\n    },\n    \"date_collected\": \"2021-07-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Systematic random sampling at fixed locations weekly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71601", "text": "{\n    \"dataset_name\": \"Global River Discharge Data\",\n    \"creator\": {\n        \"name\": \"International Hydrological Programme\",\n        \"affiliation\": \"UNESCO\"\n    },\n    \"date_collected\": \"2018-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"River Discharge\",\n            \"unit\": \"m3/s\"\n        },\n        {\n            \"name\": \"Water Level\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA\",\n    \"sampling_method\": \"Data compiled from various sources, inconsistent sampling frequency\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global trends in river discharge\",\n            \"authors\": [\n                \"Brown, B.\",\n                \"Davis, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_river_discharge.json\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data includes metadata on measurement stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71602", "text": "{\n    \"dataset_name\": \"UrbanAirQuality_NYC_2023\",\n    \"creator\": {\n        \"name\": \"City University of New York Research Team\",\n        \"affiliation\": \"CUNY\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations across Manhattan\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in New York City\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/nyc_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71602", "text": "{\n    \"dataset_name\": \"NOAA_OceanBuoyData_2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Wave Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Automated buoys deployed in the Pacific Ocean\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanographic Data Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/noaa_ocean_data.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data calibrated and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71603", "text": "{\n    \"dataset_name\": \"Urban River Water Quality Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute, University of California\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"E. coli Count\",\n            \"units\": \"CFU/100mL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 20 monitoring stations along the urban rivers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing Water Quality in Urban River Systems\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71603", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Rural Areas\",\n    \"creator\": {\n        \"name\": \"National Weather Service\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"μg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Air Quality\",\n            \"authors\": [\n                \"Alice Brown\",\n                \"Bob Johnson\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data is averaged hourly.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71604", "text": "{\n    \"dataset_name\": \"US River Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"United States Geological Survey (USGS)\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Automated sensors deployed at fixed locations along major US rivers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Water Quality in the United States\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/river-water-quality\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71604", "text": "{\n    \"dataset_name\": \"Global Marine Biodiversity Database\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"International Marine Research Consortium\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Research vessel surveys and remotely operated vehicle (ROV) observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Patterns of Biodiversity in the Deep Sea\",\n            \"authors\": [\n                \"Davis, L.\",\n                \"Wilson, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.oceaninstitute.org/biodiversity-data\",\n    \"metadata\": {\n        \"data_size\": \"1.8 GB\",\n        \"annotations\": \"Species identifications are validated by expert taxonomists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71605", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2023-2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"United States Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Report - March 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71605", "text": "{\n    \"dataset_name\": \"Theoretical Climate Model Outputs\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Earth and Planetary Science\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Model Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"Pascals\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Output from a general circulation model (GCM).\",\n    \"related_publications\": [\n        {\n            \"title\": \"A High-Resolution Climate Model\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_output.nc\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Model output with various parameterizations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71606", "text": "{\n    \"dataset_name\": \"Marine Mammal Behavior Database - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Evelyn Hayes\",\n        \"affiliation\": \"University of Washington, School of Aquatic and Fishery Sciences\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"Behavioral State\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"variable_name\": \"Location Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"Location Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Visual observations from research vessels and drone footage.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Behavioral Ecology of Orcas in the Salish Sea\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Drone-Based Monitoring of Humpback Whale Activity\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_mammal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes annotations for specific behaviors (e.g., foraging, socializing, traveling).\"\n    }\n}"}
{"_id": "Academic--research_data--n--71606", "text": "{\n    \"dataset_name\": \"Forest Insect Diversity in the Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Insect Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"variable_name\": \"Tree Species\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Pitfall traps and light traps.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Insect Biodiversity in Amazonian Rainforests\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_insect_data.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes species identification based on morphological characteristics.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71607", "text": "{\n    \"dataset_name\": \"Global Sea Level Change Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Level (mm)\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Time\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite altimetry and tide gauge measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Sea Level Rise Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/sea_level_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71607", "text": "{\n    \"dataset_name\": \"Historical Climate Reconstructions\",\n    \"creator\": {\n        \"name\": \"University of Ancient Studies\",\n        \"affiliation\": \"Department of Paleoclimatology\"\n    },\n    \"date_collected\": \"1998-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Ice Core Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Academic Research License\",\n    \"sampling_method\": \"Ice core analysis and historical records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Variability\",\n            \"year\": 2005\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_reconstructions.xml\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data requires specialized software for processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71608", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Temperature anomalies relative to a baseline period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71608", "text": "{\n    \"dataset_name\": \"Personal Weather Station Data\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2021-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Single location weather station\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/weatherdata.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Hourly weather measurements from a personal weather station.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71609", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71609", "text": "{\n    \"dataset_name\": \"University Streamflow Measurements\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"State University - Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-10-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Streamflow\",\n            \"units\": \"m^3/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual measurements taken by undergraduate students during field trips.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Introductory Hydrology Course Project\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/streamflow.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is raw and may require cleaning.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71610", "text": "{\n    \"dataset_name\": \"Global Forest Watch Climate Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite Imagery and Ground-based Observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Change\",\n            \"year\": 2014\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Includes uncertainty estimates for all variables.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71610", "text": "{\n    \"dataset_name\": \"Historical Weather Records - 1950-2000\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2000-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based Weather Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term climate trends in North America\",\n            \"year\": 1998\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Data quality control information included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71611", "text": "{\n    \"dataset_name\": \"Coastal Erosion Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Oceanography\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Erosion Rate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"mm/year\"\n        },\n        {\n            \"name\": \"Coastal Vegetation Density\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Regular shoreline surveys and LiDAR data analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Accelerated Coastal Erosion in the Pacific Northwest\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71611", "text": "{\n    \"dataset_name\": \"Global Atmospheric Temperature Records\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Green\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Global Temperature\",\n            \"authors\": [\n                \"Green, R.\",\n                \"Brown, S.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data is quality-controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71612", "text": "{\n    \"dataset_name\": \"Coastal Ecosystem Response to Climate Change\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"Individuals per square meter\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Monthly surveys at fixed transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of warming on coastal biodiversity\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_ecosystem_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71612", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Aerosol Characteristics\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Harvard University\"\n    },\n    \"date_collected\": \"2022-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Continuous monitoring with fixed instruments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in urban air pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data has been calibrated and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71613", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"International Consortium for Atmospheric Research\",\n        \"affiliation\": \"University of California, Berkeley & Max Planck Institute for Chemistry\"\n    },\n    \"date_collected\": \"2021-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across major cities worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Air Pollution\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71613", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Park Service\"\n    },\n    \"date_collected\": \"2018-11-01T15:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots in US National Parks.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in US Forests\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes GPS coordinates of sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71614", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at global observation stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71614", "text": "{\n    \"dataset_name\": \"Coral Reef Health Survey\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"Coral Reef Studies\"\n    },\n    \"date_collected\": \"2023-06-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover (%)\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Water Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Fish Biodiversity Index\",\n            \"units\": \"index\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Warming on Coral Reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Survey locations documented\"\n    }\n}"}
{"_id": "Academic--research_data--p--71615", "text": "{\n    \"dataset_name\": \"US Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Grab samples collected weekly from various river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71615", "text": "{\n    \"dataset_name\": \"Air Quality in European Cities\",\n    \"creator\": {\n        \"name\": \"Jean Dupont\",\n        \"affiliation\": \"European Environment Agency\"\n    },\n    \"date_collected\": \"2022-11-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 3.0\",\n    \"sampling_method\": \"Continuous monitoring from fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Air Pollution in Europe\",\n            \"authors\": [\n                \"Dupont, J.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data is updated daily.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71616", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2023-2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-02-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Report - February 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71616", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Universidade Federal do Amazonas\",\n        \"affiliation\": \"Brazil\"\n    },\n    \"date_collected\": \"2022-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"unit\": \"Count\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"unit\": \"Percentage\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random transects within the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Contains species identification codes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71617", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute of California\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages\"\n    }\n}"}
{"_id": "Academic--research_data--n--71617", "text": "{\n    \"dataset_name\": \"Rural Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. Jane Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Vegetation Index\",\n            \"units\": \"NDVI\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ecosystem Response to Climate Change\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/rural_ecosystem.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected during annual field campaigns\"\n    }\n}"}
{"_id": "Academic--research_data--p--71618", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers or less in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of Ozone\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Traffic on Air Quality\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data is quality-controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71618", "text": "{\n    \"dataset_name\": \"Coastal Ecosystem Biodiversity\",\n    \"creator\": {\n        \"name\": \"Marine Biology Institute\",\n        \"affiliation\": \"Oceanographic Research Center\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\",\n            \"description\": \"Number of individuals of a particular species\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Temperature of the water column\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\",\n            \"description\": \"Salinity of the water\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Underwater surveys and sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity in Coastal Zones\",\n            \"authors\": \"Jones et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"70MB\",\n        \"annotations\": \"Data includes species identification and habitat information.\"\n    }\n}"}
