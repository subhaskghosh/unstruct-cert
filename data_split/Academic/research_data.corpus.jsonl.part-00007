{"_id": "Academic--research_data--p--68342", "text": "{\n    \"dataset_name\": \"Estuarine Biodiversity and Water Chemistry - Chesapeake Bay\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Maryland Center for Environmental Science\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen (mg/L)\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity (PSU)\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Phytoplankton Species Abundance\",\n            \"unit\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Benthic Invertebrate Diversity Index\",\n            \"unit\": \"Index\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected monthly at 10 established stations throughout the Chesapeake Bay.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in estuarine biodiversity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chesapeake_bay_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality control flags included. Station locations provided in a separate shapefile.\"\n    }\n}"}
