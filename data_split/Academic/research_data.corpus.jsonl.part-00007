{"_id": "Academic--research_data--n--68623", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Monitoring\",\n    \"creator\": {\n        \"name\": \"European Space Agency (ESA)\",\n        \"affiliation\": \"ESA\"\n    },\n    \"date_collected\": \"2019-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Ozone Concentration\",\n            \"units\": \"Dobson Units\"\n        },\n        {\n            \"variable_name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Satellite observations and ground-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric Pollution Studies\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/atm_comp_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"1GB\",\n        \"annotations\": \"High-resolution atmospheric composition data.\"\n    }\n}"}
