{"_id": "Academic--research_data--n--67751", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Image Width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Image Height\",\n            \"units\": \"pixels\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Chest X-Ray analysis using deep learning\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Radiology reports available\"\n    }\n}"}
