{"_id": "Academic--research_data--p--70785", "text": "{\n    \"dataset_name\": \"Global Climate Model Output - CMIP6\",\n    \"creator\": {\n        \"name\": \"The CMIP6 Collaboration\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Sea Level Pressure\",\n            \"units\": \"Pa\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Cloud Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Ocean Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Global Climate Model Simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"The CMIP6 Workflow\",\n            \"authors\": \"Eyring et al.\",\n            \"year\": 2016\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"High-resolution climate model output for various scenarios.\"\n    }\n}"}
