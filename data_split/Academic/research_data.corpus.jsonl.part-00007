{"_id": "Academic--research_data--p--68254", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Morphology on Air Pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68254", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Biodiversity\",\n    \"creator\": {\n        \"name\": \"Oceanographic Society\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Sea Biodiversity Assessment\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Species identification codes included\"\n    }\n}"}
{"_id": "Academic--research_data--p--68255", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Institute of Water Research\",\n        \"affiliation\": \"Ministry of Environment\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Pollution Index\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from 20 locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing River Water Quality Trends\",\n            \"authors\": \"Smith, J. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68255", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"University of Forest Sciences\",\n        \"affiliation\": \"Department of Ecology\"\n    },\n    \"date_collected\": \"2022-12-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Ecosystem Resilience\",\n            \"units\": \"index\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Remote sensing and field measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Forest Ecosystem Health\",\n            \"authors\": \"Jones, A. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health.json\",\n    \"metadata\": {\n        \"data_size\": \"3MB\",\n        \"annotations\": \"Data has been preprocessed for analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68256", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Michigan - School of Environment and Sustainability\"\n    },\n    \"date_collected\": \"2023-07-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from multiple locations around Lake Erie.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Lake Erie Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68256", "text": "{\n    \"dataset_name\": \"Global Air Pollution Data 2024\",\n    \"creator\": {\n        \"name\": \"World Air Quality Index\",\n        \"affiliation\": \"WAQI Inc.\"\n    },\n    \"date_collected\": \"2024-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Real-time monitoring stations worldwide.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/global_air_pollution_2024.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes sensor calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68257", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government Licence\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68257", "text": "{\n    \"dataset_name\": \"GlobalForestCover_2022\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geography\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeCover\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of tree cover.\"\n        },\n        {\n            \"name\": \"Biome\",\n            \"units\": \"Categorical\",\n            \"description\": \"Dominant biome type.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://example.com/global_forest_cover_2022.tif\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Raster data with spatial resolution of 30m.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68258", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2021-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples collected at multiple depths.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://limnology.wisc.edu/data/mendota/\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68258", "text": "{\n    \"dataset_name\": \"Global River Discharge Data\",\n    \"creator\": {\n        \"name\": \"UNESCO\",\n        \"affiliation\": \"United Nations Educational, Scientific and Cultural Organization\"\n    },\n    \"date_collected\": \"2018-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Discharge\",\n            \"units\": \"m3/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Modeled data based on global hydrological models.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Patterns of River Discharge\",\n            \"authors\": \"Smith, J. et al.\",\n            \"citation_count\": 125\n        }\n    ],\n    \"download_url\": \"https://www.unesco.org/water/data\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is a synthesis of multiple sources.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68259", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68259", "text": "{\n    \"dataset_name\": \"GlobalAirPollutionStudy\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2024-01-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Wind Direction\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring using fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Global Air Pollution\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"5.5 MB\",\n        \"annotations\": \"Data aggregated hourly\"\n    }\n}"}
{"_id": "Academic--research_data--p--68260", "text": "{\n    \"dataset_name\": \"FreshwaterLakeQualityData\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from 5 lakes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rainfall on Freshwater Lake Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality checked and outliers removed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68260", "text": "{\n    \"dataset_name\": \"GlobalOceanSalinity\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous measurements from research vessels.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Salinity Patterns\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity.nc\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data interpolated to a 1-degree grid.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68261", "text": "{\n    \"dataset_name\": \"Freshwater Lake Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Minnesota, Department of Ecology\"\n    },\n    \"date_collected\": \"2023-05-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from five designated locations within the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Freshwater Lake Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags for outlier detection.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68261", "text": "{\n    \"dataset_name\": \"Oceanic Plankton Diversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plankton Species\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Plankton tows conducted at various depths in the North Atlantic.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Plankton Dynamics in the North Atlantic\",\n            \"authors\": [\n                \"Tanaka, K.\",\n                \"Lee, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/oceanic_plankton_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes taxonomic classifications and geographic coordinates.\"\n    }\n}"}
