{"_id": "Academic--research_data--p--70429", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Recent Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global average monthly temperature anomalies calculated from weather station data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature Anomalies\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70429", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - 1950-2000\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"National Weather Service\"\n    },\n    \"date_collected\": \"2000-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather observations from weather stations across the United States.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in US Weather\",\n            \"authors\": [\n                \"Smith, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Missing values may be present.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70430", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Limnology Lab\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Grab samples collected weekly from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70430", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Environmental Monitoring Center\",\n        \"affiliation\": \"Beijing Municipality\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air pollution trends in Beijing\",\n            \"authors\": [\n                \"Li\",\n                \"Wang\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"800KB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70431", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change - Arctic Expedition 2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Continuous measurements from research vessel and atmospheric probes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Arctic Aerosols on Climate\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality control flags and metadata for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70431", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - Global\",\n    \"creator\": {\n        \"name\": \"Global Weather Institute\",\n        \"affiliation\": \"Independent Research Group\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Daily weather station recordings worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends 1950-2020\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data is aggregated from various national weather services.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70432", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Environmental Science and Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70432", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment - Amazon\",\n    \"creator\": {\n        \"name\": \"University of São Paulo\",\n        \"affiliation\": \"Institute of Biology\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Rainforest\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geospatial data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70433", "text": "{\n    \"dataset_name\": \"LongTermForestHealth\",\n    \"creator\": {\n        \"name\": \"National Ecological Observatory Network (NEON)\",\n        \"affiliation\": \"Battelle\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"leaf_area_index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"soil_moisture\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"annual_precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Random stratified sampling across forest plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"NEON Data Products\",\n            \"authors\": [\n                \"Various\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.neonscience.org/data/data-access\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes measurements collected annually for the past 10 years.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70433", "text": "{\n    \"dataset_name\": \"UrbanAirQualitySnapshot\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2023-04-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"pm25_concentration\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Report\",\n            \"authors\": [\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"http://cityair.gov/data\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"This is a one-time snapshot of air quality data.\"\n    }\n}"}
