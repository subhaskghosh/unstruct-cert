{"_id": "Academic--research_data--p--68687", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at 5 different locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and validated for outliers.\"\n    }\n}"}
