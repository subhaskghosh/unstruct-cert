{"_id": "Academic--research_data--p--67650", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across the globe\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atmospheric Composition on Global Climate\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--67650", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Brown\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2018-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Maximum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Daily temperature readings from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Temperature Trends\",\n            \"authors\": [\n                \"Brown, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temp_records.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data may contain missing values\"\n    }\n}"}
