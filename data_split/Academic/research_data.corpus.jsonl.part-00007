{"_id": "Academic--research_data--p--71328", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Marine Research Institute\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensor buoys deployed at 5 coastal locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Temperature on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71328", "text": "{\n    \"dataset_name\": \"Patient Physiological Data\",\n    \"creator\": {\n        \"name\": \"Healthcare Analytics Group\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Heart Rate\",\n            \"units\": \"bpm\"\n        },\n        {\n            \"name\": \"Blood Pressure\",\n            \"units\": \"mmHg\"\n        },\n        {\n            \"name\": \"Respiration Rate\",\n            \"units\": \"breaths/min\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring of patients in an ICU setting.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predictive Modeling of Patient Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/patient_data.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data is anonymized to protect patient privacy.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71329", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute of California\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Populations\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71329", "text": "{\n    \"dataset_name\": \"Rural Forest Carbon Sequestration Study\",\n    \"creator\": {\n        \"name\": \"Forest Dynamics Lab\",\n        \"affiliation\": \"State University of Oregon\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"kg/ha\"\n        },\n        {\n            \"name\": \"Soil Carbon\",\n            \"units\": \"g/kg\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within forested areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Sequestration Potential of Temperate Forests\",\n            \"authors\": [\n                \"Alice Brown\",\n                \"Bob Green\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Metadata includes plot coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71330", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"m/s\"\n        },\n        {\n            \"name\": \"Wind Direction\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Active monitoring using calibrated sensors at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Traffic on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.2MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71330", "text": "{\n    \"dataset_name\": \"National River Water Quality Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Government Environmental Agency\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Observational data collected from existing monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Trends\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"3.5MB\",\n        \"annotations\": \"Data is preliminary and subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71331", "text": "{\n    \"dataset_name\": \"Global Precipitation and Temperature Dataset - 2021\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite-based remote sensing combined with ground station measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Global Dataset of Precipitation and Temperature\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.example.com/climate_data_2021.csv\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71331", "text": "{\n    \"dataset_name\": \"Historical European Climate Data - 1995\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Dataset\",\n        \"affiliation\": \"European Environment Agency\"\n    },\n    \"date_collected\": \"1995-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Ground station measurements throughout Europe.\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Trends\",\n            \"year\": 1998\n        }\n    ],\n    \"download_url\": \"https://www.example.com/european_climate_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Limited data quality documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71332", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected monthly from fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.example.com/river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71332", "text": "{\n    \"dataset_name\": \"Lake Ecosystem Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Automated sensors and weekly manual samples.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Climate Change on Lake Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.example.com/lake_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes metadata on sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71333", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Dataset - Urban Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"O3 Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using stationary sensors in urban locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Atmospheric Composition and its Impact on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_atmosphere.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71333", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ship-based measurements and buoy data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Ocean Temperature and Salinity\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes metadata about instrument calibration.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71334", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2019-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_hansen_global_forest_change_2018_summary\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Dataset contains information on forest cover loss and gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71334", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Climate Prediction Center\"\n    },\n    \"date_collected\": \"2017-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in global temperatures\",\n            \"year\": 2016\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"1GB\",\n        \"annotations\": \"Daily weather records for various locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71335", "text": "{\n    \"dataset_name\": \"Terrestrial Biodiversity Monitoring in Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"unit\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Species Richness\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Air Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic grid sampling across 100 hectares.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Deforestation on Amazonian Biodiversity\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes quality control flags for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71335", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment in the Great Barrier Reef\",\n    \"creator\": {\n        \"name\": \"Dr. David Chen\",\n        \"affiliation\": \"Australian Institute of Marine Science\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Fish Abundance\",\n            \"unit\": \"fish/square meter\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random transects along the reef.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bleaching Events and Coral Recovery\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes images of coral colonies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71336", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly water samples collected from various depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
