{"_id": "Academic--research_data--p--69204", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"air quality\",\n            \"units\": \"index\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69204", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Forest Loss\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Rates in the Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data represents annual forest cover change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69205", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2023-2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: 2023 Update\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes monthly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69205", "text": "{\n    \"dataset_name\": \"Air Quality in Major Cities\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"United States Government\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Hourly data, averaged across monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69206", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2021.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Temperature anomalies relative to the 1951-1980 base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69206", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent - Historical Data\",\n    \"creator\": {\n        \"name\": \"Mark Serreze\",\n        \"affiliation\": \"National Snow and Ice Data Center\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"million square kilometers\"\n        },\n        {\n            \"name\": \"Month\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Arctic Sea Ice\",\n            \"year\": 2017\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_ice_extent.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Monthly sea ice extent data from 1979 to 2020.\"\n    }\n}"}
