{"_id": "Academic--research_data--p--71965", "text": "{\n    \"dataset_name\": \"Global Land Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"LandAverageTemperatureAnomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"LandAverageTemperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"LandMaxTemperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"LandMinTemperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global historical climate network data, interpolated to a 2x2.5 degree grid.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Surface Temperature Change\",\n            \"authors\": \"James Hansen, et al.\",\n            \"year\": 2010\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Monthly and annual land surface temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71965", "text": "{\n    \"dataset_name\": \"Coral Reef Bleaching Events\",\n    \"creator\": {\n        \"name\": \"ReefBase\",\n        \"affiliation\": \"Global Coral Reef Monitoring Network\"\n    },\n    \"date_collected\": \"2022-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"BleachingSeverity\",\n            \"units\": \"percent\"\n        },\n        {\n            \"variable_name\": \"ReefLocation\",\n            \"units\": \"coordinates\"\n        },\n        {\n            \"variable_name\": \"WaterTemperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Remote sensing and in-situ surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Coral Bleaching 2014-2017\",\n            \"authors\": \"Hughes, T.P. et al.\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.reefbase.org/\",\n    \"metadata\": {\n        \"data_size\": \"500 KB\",\n        \"annotations\": \"Reports of coral bleaching events around the world.\"\n    }\n}"}
