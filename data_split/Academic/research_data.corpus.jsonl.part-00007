{"_id": "Academic--research_data--n--71047", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Rain gauge measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Rainfall Patterns\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes daily rainfall amounts\"\n    }\n}"}
{"_id": "Academic--research_data--p--71048", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Dataset\",\n    \"creator\": {\n        \"name\": \"University of Leeds, School of Geography\",\n        \"affiliation\": \"University of Leeds\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Carbon Stock\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote Sensing and Ground-Based Measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Storage in Tropical Forests\",\n            \"year\": 2022\n        },\n        {\n            \"title\": \"Global Biomass Distribution\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Impacts of Deforestation on Carbon Cycle\",\n            \"year\": 2024\n        },\n        {\n            \"title\": \"Forest Biomass Estimation Using LiDAR\",\n            \"year\": 2021\n        },\n        {\n            \"title\": \"Scaling Forest Carbon Stocks\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes quality flags for each observation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71048", "text": "{\n    \"dataset_name\": \"Climate Change and Agricultural Productivity\",\n    \"creator\": {\n        \"name\": \"National Bureau of Economic Research\",\n        \"affiliation\": \"NBER\"\n    },\n    \"date_collected\": \"2022-08-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Crop Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Statistical Modeling and Surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Impacts on Food Security\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Economic Costs of Climate Change\",\n            \"year\": 2024\n        },\n        {\n            \"title\": \"Agricultural Adaptation Strategies\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/agri_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data contains economic impact indicators.\"\n    }\n}"}
