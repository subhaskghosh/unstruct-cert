{"_id": "Academic--research_data--p--68201", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular depth profiles collected weekly during the ice-free season.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68201", "text": "{\n    \"dataset_name\": \"Global Air Pollution Data\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Data aggregated from monitoring stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ambient air pollution: A global assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airpollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes country-level averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68202", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation Anomaly\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Global gridded data derived from station measurements and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_precipitation.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains data from 1880 to present\"\n    }\n}"}
{"_id": "Academic--research_data--n--68202", "text": "{\n    \"dataset_name\": \"Public Opinion on Climate Change Policies\",\n    \"creator\": {\n        \"name\": \"Pew Research Center\",\n        \"affiliation\": \"Pew Research Center\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Support for Carbon Tax\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Belief in Climate Change\",\n            \"units\": \"index\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Nationwide survey of US adults.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Political Polarization and Climate Change\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/public_opinion.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Survey data with demographic breakdowns.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68203", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Assessment\",\n    \"creator\": {\n        \"name\": \"FAO Global Forest Resources Assessment\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Soil Carbon\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing and ground-based inventory data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Carbon Assessment Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data covers forest areas globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68203", "text": "{\n    \"dataset_name\": \"Los Angeles Urban Heat Island Study\",\n    \"creator\": {\n        \"name\": \"California Institute of Technology\",\n        \"affiliation\": \"Caltech\"\n    },\n    \"date_collected\": \"2022-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Land Cover Type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Building Density\",\n            \"units\": \"buildings/km^2\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"High-resolution satellite imagery and ground sensor network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effects in Los Angeles\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/la_uhi_data.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data focuses specifically on urban areas of Los Angeles.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68204", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2020-2023\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Remote sensing data from Landsat and Sentinel-2 satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from space\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GFC\",\n    \"metadata\": {\n        \"data_size\": \"100 GB\",\n        \"annotations\": \"Global coverage, high resolution\"\n    }\n}"}
{"_id": "Academic--research_data--n--68204", "text": "{\n    \"dataset_name\": \"Simulated Climate Projections - RCP8.5\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"Climate Simulation Division\"\n    },\n    \"date_collected\": \"2021-06-30T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations using CESM\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future climate change scenarios\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://www.earthsystemgrid.org/dataset/NCAR-CESM.1.1.b\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Global climate model output\"\n    }\n}"}
{"_id": "Academic--research_data--p--68205", "text": "{\n    \"dataset_name\": \"Global Forest Watch Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Biomass Density\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Protected Area Status\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch annual report 2023\",\n            \"authors\": [\n                \"Goldman et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes yearly tree cover loss and gain events.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68205", "text": "{\n    \"dataset_name\": \"NOAA Global Surface Summary of the Day\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Maximum Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Quality control of daily temperature data\",\n            \"authors\": [\n                \"Smith et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-summary-of-the-day/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Daily weather data from around the world.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68206", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government Licence v3.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in London 2023 Report\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68206", "text": "{\n    \"dataset_name\": \"Simulated River Flow Data - Amazon Basin\",\n    \"creator\": {\n        \"name\": \"Hydrological Modeling Group\",\n        \"affiliation\": \"University of Amazonas\"\n    },\n    \"date_collected\": \"2023-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"River Discharge\",\n            \"units\": \"m³/s\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Hydrological model output\",\n    \"related_publications\": [\n        {\n            \"title\": \"Modeling River Dynamics in the Amazon\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Oliveira, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_river_data\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data generated from a calibrated hydrological model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68207", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Active Air Sampling with continuous monitors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flagged for sensor calibration.\"\n    }\n}"}
