{"_id": "Academic--research_data--n--68552", "text": "{\n    \"dataset_name\": \"Global Oceanographic Survey\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Oceanic Research Division\"\n    },\n    \"date_collected\": \"2023-08-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Current Direction\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Plankton Abundance\",\n            \"units\": \"cells/mL\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Dynamics\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Comprehensive oceanographic data set.\"\n    }\n}"}
