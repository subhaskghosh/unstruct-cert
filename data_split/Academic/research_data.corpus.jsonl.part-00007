{"_id": "Academic--research_data--p--71319", "text": "{\n    \"dataset_name\": \"Global Marine Ecosystems Dataset\",\n    \"creator\": {\n        \"name\": \"Ocean Research Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a Concentration\",\n            \"units\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phytoplankton Biomass\",\n            \"units\": \"g/m^2\"\n        },\n        {\n            \"name\": \"Zooplankton Abundance\",\n            \"units\": \"individuals/m^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Autonomous Underwater Vehicle (AUV) surveys and satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Warming on Marine Ecosystems\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
