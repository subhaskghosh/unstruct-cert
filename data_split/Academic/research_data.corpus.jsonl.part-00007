{"_id": "Academic--research_data--p--69201", "text": "{\n    \"dataset_name\": \"Lung Cancer CT Scans\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tumor_diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"scan_resolution\",\n            \"units\": \"pixels\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random sampling of patients with confirmed lung cancer\",\n    \"related_publications\": [\n        {\n            \"title\": \"Early Detection of Lung Cancer Using CT Scans\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_cancer_scans.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-verified tumor annotations\"\n    }\n}"}
{"_id": "Academic--research_data--n--69201", "text": "{\n    \"dataset_name\": \"Brain MRI Images\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"brain_volume\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Convenience sampling of healthy adults\",\n    \"related_publications\": [\n        {\n            \"title\": \"Brain Structure and Cognitive Function\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Automated brain segmentation\"\n    }\n}"}
