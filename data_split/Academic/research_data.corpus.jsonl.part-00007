{"_id": "Academic--research_data--p--69344", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2023-2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature_anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes monthly averages\"\n    }\n}"}
{"_id": "Academic--research_data--n--69344", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Southeast Asia\",\n    \"creator\": {\n        \"name\": \"Asian Climate Research Institute\",\n        \"affiliation\": \"University of Tokyo\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"rainfall\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"proprietary\",\n    \"sampling_method\": \"Rain gauge network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in Southeast Asia\",\n            \"authors\": [\n                \"Tanaka, K.\",\n                \"Lee, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily rainfall totals\"\n    }\n}"}
