{"_id": "Academic--research_data--n--70367", "text": "{\n    \"dataset_name\": \"Bird Species Observations in Parks\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Nature Conservation Society\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"\"\n        },\n        {\n            \"name\": \"Observation Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"coordinates\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Distribution of Bird Species in Local Parks\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_observations.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Observations reported by volunteers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70368", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2021-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Impact of Rising CO2 on Global Temperatures\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70368", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow\",\n    \"creator\": {\n        \"name\": \"David Lee\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Vehicle Count\",\n            \"unit\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"Average Speed\",\n            \"unit\": \"km/h\"\n        },\n        {\n            \"name\": \"Road Segment ID\",\n            \"unit\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Loop detectors and traffic cameras\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/traffic_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70369", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphorus Concentration\",\n            \"units\": \"ug/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular buoy measurements at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70369", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Instituto Nacional de Pesquisas da Amazônia\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random transects within the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the Amazon\",\n            \"authors\": [\n                \"Silva\",\n                \"Oliveira\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Species identification verified by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70370", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\",\n            \"description\": \"The concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\",\n            \"description\": \"The concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature measured in degrees Celsius.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity of the air.\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\",\n            \"description\": \"Speed of the wind.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70370", "text": "{\n    \"dataset_name\": \"Historical Soil Composition Data\",\n    \"creator\": {\n        \"name\": \"Geological Survey Institute\",\n        \"affiliation\": \"National Institute of Geology\"\n    },\n    \"date_collected\": \"2022-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SiO2\",\n            \"units\": \"%\",\n            \"description\": \"Silicon Dioxide content.\"\n        },\n        {\n            \"name\": \"Al2O3\",\n            \"units\": \"%\",\n            \"description\": \"Aluminum Oxide content.\"\n        },\n        {\n            \"name\": \"Fe2O3\",\n            \"units\": \"%\",\n            \"description\": \"Ferric Oxide content.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Core sampling at various locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Geochemical Analysis of Soil Profiles\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected over several decades.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70371", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Monitoring - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Environmental and Forest Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Average Tree Diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Understory Vegetation Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Stratified Random Sampling across 100 plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in forest biodiversity in the Pacific Northwest\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_pnw.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
