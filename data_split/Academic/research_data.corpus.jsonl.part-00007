{"_id": "Academic--research_data--n--70154", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Amazon Basin\",\n    \"creator\": {\n        \"name\": \"Ricardo Silva\",\n        \"affiliation\": \"National Institute of Meteorology\"\n    },\n    \"date_collected\": \"2018-06-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"rainfall\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Rain gauge measurements across the Amazon basin.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in the Amazon\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_rainfall.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily rainfall measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70155", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Shannon Diversity Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling across 100 plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in the Amazon\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes species identification and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70155", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at 5 fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Index Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data includes hourly measurements from air quality sensors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70156", "text": "{\n    \"dataset_name\": \"Global Forest Change Data\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Remote sensing data analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/users/UMD/forest-change\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Contains data on forest cover loss and gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70156", "text": "{\n    \"dataset_name\": \"Small Sensor Network Logs\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"Acme Corp\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sensor_id\",\n            \"unit\": \"ID\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous sensor readings\",\n    \"related_publications\": [],\n    \"download_url\": \"http://example.com/sensor_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Logs from a small network of temperature sensors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70157", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen et al.\",\n            \"journal\": \"Nature Climate Change\"\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data contains tree cover loss and gain information globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70157", "text": "{\n    \"dataset_name\": \"Industrial Emissions Data\",\n    \"creator\": {\n        \"name\": \"ACME Corporation\",\n        \"affiliation\": \"ACME Industries\"\n    },\n    \"date_collected\": \"2021-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2_emissions\",\n            \"units\": \"tons\"\n        },\n        {\n            \"name\": \"NOx_emissions\",\n            \"units\": \"tons\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Continuous emissions monitoring systems\",\n    \"related_publications\": [],\n    \"download_url\": \"https://acmecorp.com/emissionsdata\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Detailed emissions data from industrial facilities.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70158", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2023 Update\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations, ocean buoys, and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10 MB\",\n        \"annotations\": \"Comprehensive documentation available online, regularly updated with annual releases.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70158", "text": "{\n    \"dataset_name\": \"Historical Weather Data - US Cities\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-12-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather observations from various US weather stations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Limited documentation, infrequent updates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70159", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70159", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Remote sensing and field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Amazon Forest Biomass\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest.json\",\n    \"metadata\": {\n        \"data_size\": \"850 MB\",\n        \"annotations\": \"Data derived from satellite imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70160", "text": "{\n    \"dataset_name\": \"RiverWaterQuality\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"variable_name\": \"NitrateConcentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors and manual grab samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70160", "text": "{\n    \"dataset_name\": \"AirPollutionLevels\",\n    \"creator\": {\n        \"name\": \"City Council\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in the City\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is preliminary\"\n    }\n}"}
{"_id": "Academic--research_data--p--70161", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2024-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Pneumonia Status\",\n            \"units\": \"Binary (Positive/Negative)\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Retrospective review of patient records\",\n    \"related_publications\": [\n        {\n            \"title\": \"CheXpert: Large Scale Chest X-Ray Interpretation\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"2.5GB\",\n        \"annotations\": \"Radiologist-verified pneumonia labels\"\n    }\n}"}
