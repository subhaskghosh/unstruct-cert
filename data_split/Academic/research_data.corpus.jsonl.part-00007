{"_id": "Academic--research_data--n--71317", "text": "{\n    \"dataset_name\": \"European Air Quality Dataset\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"Intergovernmental Organization\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous monitoring from fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe 2023 Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/european_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data may contain missing values.\"\n    }\n}"}
