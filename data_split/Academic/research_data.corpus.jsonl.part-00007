{"_id": "Academic--research_data--p--71365", "text": "{\n    \"dataset_name\": \"Coastal Temperature Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"air_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated buoy measurements at 5m depth, hourly recordings.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Warming on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
