{"_id": "Academic--research_data--p--71712", "text": "{\n    \"dataset_name\": \"Lung Cancer CT Scan Dataset\",\n    \"creator\": {\n        \"name\": \"Massachusetts Institute of Technology\",\n        \"affiliation\": \"MIT Computer Science and Artificial Intelligence Laboratory\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"CT_scan\",\n            \"units\": \"DICOM format\"\n        },\n        {\n            \"variable_name\": \"diagnosis\",\n            \"units\": \"binary (cancer/no cancer)\"\n        },\n        {\n            \"variable_name\": \"patient_age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Prospective cohort study, CT scans from patients undergoing lung cancer screening.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Lung Nodule Detection\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_cancer_dataset\",\n    \"metadata\": {\n        \"data_size\": \"3.5GB\",\n        \"annotations\": \"Radiologist-verified lung nodule locations\"\n    }\n}"}
{"_id": "Academic--research_data--n--71712", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"University of California, San Francisco\",\n        \"affiliation\": \"UCSF Radiology Department\"\n    },\n    \"date_collected\": \"2023-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"MRI_scan\",\n            \"units\": \"NIfTI format\"\n        },\n        {\n            \"variable_name\": \"brain_structure\",\n            \"units\": \"anatomical region\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Retrospective analysis of existing MRI scans.\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI Analysis of Brain Structures\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"8GB\",\n        \"annotations\": \"Automated segmentation of brain regions\"\n    }\n}"}
{"_id": "Academic--research_data--p--71713", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected monthly from fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/national-river-water-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71713", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Discharge Monitoring\",\n    \"creator\": {\n        \"name\": \"AquaTech Solutions\",\n        \"affiliation\": \"Private Environmental Consulting Firm\"\n    },\n    \"date_collected\": \"2023-11-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"COD\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"BOD\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Total Suspended Solids\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary - Limited Use\",\n    \"sampling_method\": \"Weekly composite samples from industrial outfalls.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.aquatechsolutions.com/data\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data is anonymized.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71714", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--71714", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment\",\n    \"creator\": {\n        \"name\": \"Marine Biology Institute\",\n        \"affiliation\": \"Oceanographic Research Center\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coral Reefs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Image data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--71715", "text": "{\n    \"dataset_name\": \"Freshwater Lake Monitoring Data - North America\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Minnesota\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 lakes across Minnesota and Wisconsin.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Freshwater Lake Quality\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags and metadata for each sampling location.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71715", "text": "{\n    \"dataset_name\": \"Coastal Oceanographic Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Oregon State University\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous measurements from a moored buoy off the coast of Oregon.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanographic Conditions in the Coastal Pacific Northwest\",\n            \"authors\": \"Lee et al.\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data has been calibrated and validated against laboratory measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71716", "text": "{\n    \"dataset_name\": \"Atmospheric Aerosol Composition - North America 2021\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Black Carbon Concentration\",\n            \"units\": \"ng/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"High-volume air sampling at fixed monitoring stations with quality control based on co-located instruments and meteorological data.  Sampling frequency: every 6 hours. Data validated using aerosol mass spectrometry.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Wildfires on Aerosol Composition in North America\",\n            \"year\": 2023,\n            \"doi\": \"10.1000/example1\"\n        }\n    ],\n    \"download_url\": \"https://example.com/aerosol_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data includes flags for quality control and meteorological conditions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71716", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 1950-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA Climate Data Center\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Compilation of historical temperature records from weather stations and ocean buoys. Data represents global average temperature anomalies relative to a baseline period.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Report - 2023\",\n            \"year\": 2024,\n            \"doi\": \"10.2000/example2\"\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data has been gridded and interpolated to a 2.5 degree resolution.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71717", "text": "{\n    \"dataset_name\": \"Urban Air Quality Sensor Network Data\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Real-time Air Quality Monitoring in Urban Environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71717", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health Monitoring\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"US Department of Agriculture\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Periodic field measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Forest Health\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Limited documentation available\"\n    }\n}"}
{"_id": "Academic--research_data--p--71718", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA Climate Data Center\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and ocean buoys; gridded data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A Comprehensive Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/data/temperature-analysis\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71718", "text": "{\n    \"dataset_name\": \"Urban Heat Island Effect - Short Term Study\",\n    \"creator\": {\n        \"name\": \"City University Research Group\",\n        \"affiliation\": \"Urban Planning Department\"\n    },\n    \"date_collected\": \"2019-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Portable weather stations deployed in a single city for one week.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Pavement Materials on Urban Temperatures\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://cityresearch.edu/heatstudy\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Limited geographical scope.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71719", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London, Environmental Research Group\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Design on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71719", "text": "{\n    \"dataset_name\": \"Rural Ecosystem Monitoring - Scotland\",\n    \"creator\": {\n        \"name\": \"Dr. Alistair McGregor\",\n        \"affiliation\": \"University of Edinburgh, Ecology Department\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"m³/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Weekly sample collection from designated plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Ecological Changes in Scotland\",\n            \"authors\": [\n                \"McGregor, A.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/scotland_ecosystem.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Includes species identification data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71720", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling at fixed stations using automated sensors and laboratory analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
