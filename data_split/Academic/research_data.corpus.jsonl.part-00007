{"_id": "Academic--research_data--p--71816", "text": "{\n    \"dataset_name\": \"CardioMRI Dataset\",\n    \"creator\": {\n        \"name\": \"Stanford University Medical Imaging Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"variable_name\": \"heart_rate\",\n            \"units\": \"bpm\"\n        },\n        {\n            \"variable_name\": \"ejection_fraction\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective cohort study from hospital records.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Automated Cardiac Function Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/cardio_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"8.5GB\",\n        \"annotations\": \"Segmentation masks for left ventricle and right ventricle.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71816", "text": "{\n    \"dataset_name\": \"Skin Lesion Analysis Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"variable_name\": \"image_height\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"variable_name\": \"lesion_diameter\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JPG\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Collection of images from online sources.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Convolutional Neural Networks for Skin Cancer Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/skin_lesion_dataset\",\n    \"metadata\": {\n        \"data_size\": \"12GB\",\n        \"annotations\": \"Binary labels indicating malignant or benign lesions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71817", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric Composition Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71817", "text": "{\n    \"dataset_name\": \"Regional Climate Projections\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Impacts\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_projections.xml\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Metadata available in separate file\"\n    }\n}"}
{"_id": "Academic--research_data--p--71818", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"University of Michigan Water Science Group\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular sampling at fixed locations using automated sensors and manual water collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Lake Erie Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71818", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Discharge Data\",\n    \"creator\": {\n        \"name\": \"ChemCorp Solutions\",\n        \"affiliation\": \"ChemCorp Solutions Inc.\"\n    },\n    \"date_collected\": \"2023-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Total Suspended Solids\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Sampling conducted as per regulatory requirements.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/industrial_wastewater.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is provided as-is with no warranty.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71819", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Morphology on Air Pollution Dispersion\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71819", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"National Institute of Ecology\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of different plant species.\"\n        },\n        {\n            \"variable_name\": \"Tree Density\",\n            \"units\": \"trees/ha\",\n            \"description\": \"Number of trees per hectare.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the forest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Climate Change on Forest Ecosystems\",\n            \"year\": 2022,\n            \"authors\": [\n                \"Miller, D.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data represents a limited area.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71820", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated buoys and manual sampling at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
