{"_id": "Academic--research_data--n--70417", "text": "{\n    \"dataset_name\": \"Climate Model Output - CMIP6\",\n    \"creator\": {\n        \"name\": \"World Climate Research Programme (WCRP)\",\n        \"affiliation\": \"International Council for Science\"\n    },\n    \"date_collected\": \"2023-01-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature_projection\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"precipitation_projection\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Model Evaluation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Output from various climate models.\"\n    }\n}"}
