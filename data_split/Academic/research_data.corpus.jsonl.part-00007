{"_id": "Academic--research_data--n--67814", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. James Wilson\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Sea Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite measurements and buoy data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Changes in Ocean Heat Content\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"5 GB\",\n        \"annotations\": \"Data calibrated using World Ocean Database\"\n    }\n}"}
