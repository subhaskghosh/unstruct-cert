{"_id": "Academic--research_data--p--70574", "text": "{\n    \"dataset_name\": \"LongTermForestEcology\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"TreeDiameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"variable_name\": \"LeafAreaIndex\",\n            \"units\": \"m2/m2\"\n        },\n        {\n            \"variable_name\": \"SoilMoisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Systematic grid sampling within forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in forest structure and composition\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_ecology_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes annotations for tree species and health status.\"\n    }\n}"}
