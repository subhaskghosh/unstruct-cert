{"_id": "Academic--research_data--p--70276", "text": "{\n    \"dataset_name\": \"BRATS2023\",\n    \"creator\": {\n        \"name\": \"Brain Tumor Segmentation Challenge\",\n        \"affiliation\": \"Medical Segmentation Decathlon\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"T1-weighted MRI\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"T2-weighted MRI\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"FLAIR MRI\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Ground Truth Segmentation\",\n            \"units\": \"Pixel-wise labels\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Multi-institutional retrospective study\",\n    \"related_publications\": [\n        {\n            \"title\": \"BRATS 2023 Challenge: Brain Tumor Segmentation with Deep Learning\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.medicalsegmentation.com/brats2023/\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Expert radiologist annotations for tumor segmentation\",\n        \"completeness\": \"High\"\n    }\n}"}
