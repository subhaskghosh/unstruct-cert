{"_id": "Academic--research_data--p--70618", "text": "{\n    \"dataset_name\": \"CardioMRI Feature Extraction Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University Medical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image_ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Left_Ventricular_Volume\",\n            \"units\": \"mL\"\n        },\n        {\n            \"name\": \"Ejection_Fraction\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Retrospective analysis of existing patient data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Cardiac Feature Extraction using Deep Learning\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/cardioMRI.zip\",\n    \"metadata\": {\n        \"data_size\": \"320MB\",\n        \"annotations\": \"Detailed segmentation masks for cardiac structures are provided.\",\n        \"documentation\": \"Comprehensive documentation detailing data acquisition, preprocessing, and annotation procedures are available.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70618", "text": "{\n    \"dataset_name\": \"Chest X-ray Images\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image_ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Laterality\",\n            \"units\": \"Left/Right\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective clinical trial.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/chestXray.zip\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Diagnosis labels are provided.\",\n        \"documentation\": \"Basic readme file describing the dataset.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70619", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        },\n        {\n            \"title\": \"Urban Heat Island Effect and Air Quality\",\n            \"authors\": [\n                \"Garcia, M.\",\n                \"Carter, E.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
