{"_id": "Academic--research_data--n--71757", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"USFS\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"unit\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Forest Composition\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Species identification based on expert review.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71758", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors deployed across London boroughs.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality in Urban Environments\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using time-series analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71758", "text": "{\n    \"dataset_name\": \"Remote Sensing of Forest Biomass - Amazon\",\n    \"creator\": {\n        \"name\": \"National Institute for Space Research\",\n        \"affiliation\": \"INPE, Brazil\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Satellite imagery analysis with ground truthing.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating Forest Biomass using Remote Sensing Techniques\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data processed using advanced machine learning algorithms.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71759", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Dataset - Oregon\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Oregon State University\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"variable_name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"diameter\",\n            \"units\": \"centimeters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random stratified sampling within forest plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity assessment in Oregon forests\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/oregon_forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes detailed species identification and growth measurements.\"\n    }\n}"}
