{"_id": "Academic--research_data--n--67104", "text": "{\n    \"dataset_name\": \"Student Performance in Mathematics\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Math Score\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Study Hours\",\n            \"units\": \"Hours per week\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Surveys conducted in classrooms\",\n    \"related_publications\": [\n        {\n            \"title\": \"Factors Influencing Student Achievement\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/student_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Demographic information included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67105", "text": "{\n    \"dataset_name\": \"LongTermEcologyData\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"SpeciesCount\",\n            \"units\": \"Count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensor network with monthly data logging.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Ecological Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/longterecologydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes annotations for major weather events.\"\n    }\n}"}
