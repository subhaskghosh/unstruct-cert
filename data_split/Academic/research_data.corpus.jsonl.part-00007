{"_id": "Academic--research_data--n--71966", "text": "{\n    \"dataset_name\": \"MarineEcosystemSurvey_Hawaii\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"University of Hawaii\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CoralCover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"FishDensity\",\n            \"units\": \"individuals/m²\"\n        },\n        {\n            \"name\": \"WaterTemperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"SCUBA diving surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health in Hawaiian Waters\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_hawaii.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes species identification.\"\n    }\n}"}
