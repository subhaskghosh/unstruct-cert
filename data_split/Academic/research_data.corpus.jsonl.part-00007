{"_id": "Academic--research_data--p--70974", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages\"\n    }\n}"}
{"_id": "Academic--research_data--n--70974", "text": "{\n    \"dataset_name\": \"Rural Ecosystem Carbon Fluxes\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"Ecology Research Division\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol/m²/s\"\n        },\n        {\n            \"name\": \"Water Vapor Flux\",\n            \"units\": \"mmol/m²/s\"\n        },\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Eddy covariance measurements in rural forests\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Dynamics in Forest Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://forestdata.gov/carbonflux.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data represents daily totals\"\n    }\n}"}
{"_id": "Academic--research_data--p--70975", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen et al.\",\n            \"journal\": \"Nature Climate Change\"\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Contains data on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70975", "text": "{\n    \"dataset_name\": \"Local Bird Species Observations\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"Community Wildlife Group\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"count\",\n            \"units\": \"individuals\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://communitywildlifegroup.org/birddata\",\n    \"metadata\": {\n        \"data_size\": \"1MB\",\n        \"annotations\": \"Observations of bird species in a local park.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70976", "text": "{\n    \"dataset_name\": \"ADNI Longitudinal MRI Data\",\n    \"creator\": {\n        \"name\": \"Alzheimer's Disease Neuroimaging Initiative\",\n        \"affiliation\": \"Various Institutions\"\n    },\n    \"date_collected\": \"2024-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI Scan ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Gender\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Cognitive Score\",\n            \"units\": \"points\"\n        },\n        {\n            \"name\": \"Amyloid Beta Load\",\n            \"units\": \"pg/mg\"\n        },\n        {\n            \"name\": \"Tau Protein Load\",\n            \"units\": \"pg/mg\"\n        },\n        {\n            \"name\": \"Hippocampal Volume\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"Entorhinal Cortex Thickness\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Ventricle Volume\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"Whole Brain Volume\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"GM Volume\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"WM Volume\",\n            \"units\": \"cm^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Longitudinal cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI Biomarkers for Early Alzheimer's Disease Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/adni_mri_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"DICOM metadata included\"\n    }\n}"}
