{"_id": "Academic--research_data--p--68156", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Systems Lab\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Automated sensor deployed in river network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Real-time River Water Quality Monitoring using IoT Sensors\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68156", "text": "{\n    \"dataset_name\": \"LakeSedimentAnalysis\",\n    \"creator\": {\n        \"name\": \"Geological Survey Institute\",\n        \"affiliation\": \"State University of New York\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sediment Composition\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual sediment core sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of Lake Sediment Composition and Heavy Metal Contamination\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_sediment.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Geographic coordinates of sampling locations included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68157", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Real-time Air Quality Prediction using Machine Learning\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ],\n            \"year\": 2024,\n            \"venue\": \"Environmental Science & Technology\"\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data includes timestamps, geographical coordinates, and sensor IDs.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68157", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Carbon Fluxes\",\n    \"creator\": {\n        \"name\": \"Professor David Miller\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol m⁻² s⁻¹\"\n        },\n        {\n            \"name\": \"Water Vapor Flux\",\n            \"units\": \"mmol m⁻² s⁻¹\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Eddy covariance measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Theoretical Modeling of Carbon Cycling in Forests\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Garcia, R.\"\n            ],\n            \"year\": 2024,\n            \"venue\": \"Global Change Biology\"\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_fluxes.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data includes environmental variables such as temperature and humidity.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68158", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
