{"_id": "Academic--research_data--n--71399", "text": "{\n    \"dataset_name\": \"Urban Bee Pollination Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2019-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bee Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Pollen Diversity\",\n            \"units\": \"Shannon Index\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Manual observation of bee activity in urban gardens\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Bee Pollination\",\n            \"authors\": [\n                \"Carter, E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bee-data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes observation locations and timestamps.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71400", "text": "{\n    \"dataset_name\": \"North American Plant Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Smithsonian Institution\",\n        \"affiliation\": \"Smithsonian Environmental Research Center\"\n    },\n    \"date_collected\": \"2023-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"decimal degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"decimal degrees\"\n        },\n        {\n            \"name\": \"Plant Height\",\n            \"unit\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across representative biomes\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in North American Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/napbs.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Detailed species identification protocols included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71400", "text": "{\n    \"dataset_name\": \"Individual Garden Plant Observations\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plant Species\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Flower Color\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Observation Date\",\n            \"unit\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Opportunistic observations in a home garden\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/garden_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Basic observations only.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71401", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71401", "text": "{\n    \"dataset_name\": \"Rural Forest Ecosystem Data - Sweden\",\n    \"creator\": {\n        \"name\": \"Swedish University of Agricultural Sciences\",\n        \"affiliation\": \"Department of Ecology\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Ecosystem Dynamics\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/swedish_forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71402", "text": "{\n    \"dataset_name\": \"Urban Temperature Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Automated sensor network deployed across urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effect Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality assessed using statistical methods and validated with independent measurements. High data completeness.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71402", "text": "{\n    \"dataset_name\": \"Coral Reef Ecosystem Survey\",\n    \"creator\": {\n        \"name\": \"Dr. James Thompson\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"coral_cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"water_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"fish_species\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"SCUBA diving surveys conducted at multiple reef locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coral Reefs\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected by trained marine biologists. Subject to potential observer bias.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71403", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Land and Ocean\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"LandArea\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"OceanArea\",\n            \"units\": \"square kilometers\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global surface temperature measurements from land and ocean stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-temperature-report/access/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Monthly anomalies relative to the 1901-2000 average.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71403", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Institute\",\n        \"affiliation\": \"Private Corporation\"\n    },\n    \"date_collected\": \"2019-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"FertilizerUse\",\n            \"units\": \"kg/hectare\"\n        },\n        {\n            \"name\": \"PesticideUse\",\n            \"units\": \"kg/hectare\"\n        },\n        {\n            \"name\": \"SoilType\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Region\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Farm surveys across various agricultural regions.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Crop Production Analysis\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Annual crop yields with associated environmental factors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71404", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2022\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Environmental Science Department\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality_2022.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data cleaned and validated by expert reviewers.\"\n    }\n}"}
