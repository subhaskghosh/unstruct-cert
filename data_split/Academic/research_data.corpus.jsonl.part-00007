{"_id": "Academic--research_data--p--71337", "text": "{\n    \"dataset_name\": \"Urban Air Quality in London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2021-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Populations\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        },\n        {\n            \"title\": \"Climate Change and Air Quality: A London Case Study\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Carter, E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data cleaned and validated against UK air quality standards.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71337", "text": "{\n    \"dataset_name\": \"Rural Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2022-07-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of UK Forests\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes species identification and habitat characteristics.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71338", "text": "{\n    \"dataset_name\": \"Global Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Regular sampling from rivers and lakes across the US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Detailed metadata available in a separate README file.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71338", "text": "{\n    \"dataset_name\": \"Theoretical River Simulation Data\",\n    \"creator\": {\n        \"name\": \"Hydrology Research Group\",\n        \"affiliation\": \"University of California\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Flow Rate\",\n            \"units\": \"m^3/s\"\n        },\n        {\n            \"name\": \"Sediment Concentration\",\n            \"units\": \"kg/m^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Computational model output.\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Novel Approach to River Flow Modeling\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/river_simulation.json\",\n    \"metadata\": {\n        \"data_size\": \"0.5MB\",\n        \"annotations\": \"Data generated from a theoretical model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71339", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"U.S. Department of Commerce\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Time\",\n            \"units\": \"ISO 8601\"\n        },\n        {\n            \"name\": \"Sea Level Pressure\",\n            \"units\": \"Pascals\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Cloud Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Air Density\",\n            \"units\": \"kg/m^3\"\n        },\n        {\n            \"name\": \"Dew Point\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data is quality-controlled and gap-filled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71339", "text": "{\n    \"dataset_name\": \"Local Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Green Earth Initiative\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2022-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Species Name\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"Meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"Centimeters\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"GPS Coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Random sampling within a defined forest area.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Biodiversity in the Region\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Raw data from field surveys.\"\n    }\n}"}
