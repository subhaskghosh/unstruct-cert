{"_id": "Academic--research_data--n--66393", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory (PMEL)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"dissolved_oxygen\",\n            \"units\": \"milliliters per liter\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification: A Comprehensive Assessment\",\n            \"authors\": [\n                \"Richard Feely\",\n                \"Christopher Sabine\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.pmel.noaa.gov/co2/\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Provides data on ocean CO2 levels\"\n    }\n}"}
