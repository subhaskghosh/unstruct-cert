{"_id": "Academic--research_data--n--68330", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change 1990-2020\",\n    \"creator\": {\n        \"name\": \"Hannah Schmidt\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"Hectares\"\n        },\n        {\n            \"name\": \"Loss\",\n            \"units\": \"Hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Forest Cover\",\n            \"authors\": [\n                \"Schmidt, H.\",\n                \"Lee, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Raster data with high spatial resolution.\"\n    }\n}"}
