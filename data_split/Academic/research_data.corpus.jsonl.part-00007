{"_id": "Academic--research_data--p--70096", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - Extended\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Geographic Coordinates\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global meteorological stations and sea surface measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature trends over the past century\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-summary-of-the-day/access/2021/03/15/\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70096", "text": "{\n    \"dataset_name\": \"Hurricane Harvey Rainfall Data\",\n    \"creator\": {\n        \"name\": \"University of Houston\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2018-09-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Location Coordinates\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Rain gauges and radar measurements during Hurricane Harvey.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Hurricane Harvey on Houston's infrastructure\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.uh.edu/hurricane-harvey-data/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"High-resolution rainfall data for Hurricane Harvey.\"\n    }\n}"}
