{"_id": "Academic--research_data--n--69658", "text": "{\n    \"dataset_name\": \"Chest X-ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_quality\",\n            \"unit\": \"score (1-5)\"\n        },\n        {\n            \"name\": \"age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"gender\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective X-ray images from hospital records.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pneumonia detection in chest X-rays\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Radiologist reports are available.\"\n    }\n}"}
