{"_id": "Academic--research_data--p--69349", "text": "{\n    \"dataset_name\": \"EEG Motor Imagery Dataset\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Cz_frequency\",\n            \"units\": \"Hz\"\n        },\n        {\n            \"variable_name\": \"C3_amplitude\",\n            \"units\": \"uV\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Resting-state EEG recording\",\n    \"related_publications\": [\n        {\n            \"title\": \"Motor Imagery EEG Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/eeg_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Event markers for left and right hand movements\"\n    }\n}"}
{"_id": "Academic--research_data--n--69349", "text": "{\n    \"dataset_name\": \"fMRI Resting State Data\",\n    \"creator\": {\n        \"name\": \"Alice Johnson\",\n        \"affiliation\": \"Harvard Medical School\"\n    },\n    \"date_collected\": \"2024-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"BOLD_signal\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"variable_name\": \"Respiration_rate\",\n            \"units\": \"RPM\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Resting-state fMRI scan\",\n    \"related_publications\": [\n        {\n            \"title\": \"Resting State fMRI Connectivity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/fmri_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"No specific event markers\"\n    }\n}"}
{"_id": "Academic--research_data--p--69350", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Mean Global Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Ocean Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Temperature anomalies relative to a 1951-1980 base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69350", "text": "{\n    \"dataset_name\": \"Atmospheric Pollutant Concentrations\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Dioxide Levels\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentrations\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Particulate Matter 2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe – 2022 Report\",\n            \"authors\": [\n                \"European Environment Agency\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.eea.europa.eu/data-and-maps/data/air-quality-eea\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Hourly pollutant concentrations measured across Europe.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69351", "text": "{\n    \"dataset_name\": \"Human Brain Activity during Cognitive Tasks\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"EEG_Channel_1\",\n            \"units\": \"uV\"\n        },\n        {\n            \"name\": \"Reaction_Time\",\n            \"units\": \"ms\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"fMRI and behavioral data collection during cognitive tasks.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Neural Correlates of Decision Making\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/neuroscience_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes annotations for task conditions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69351", "text": "{\n    \"dataset_name\": \"Rodent Olfactory System Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2023-06-20T15:45:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Odor_Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Firing_Rate\",\n            \"units\": \"Hz\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"proprietary\",\n    \"sampling_method\": \"Electrophysiological recordings from rodent olfactory bulb.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Encoding of Odor Information in the Olfactory Bulb\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/rodent_olfactory_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data is preprocessed and filtered.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69352", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2023-2024\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-02-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global grid cells, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69352", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-03-10T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based measurements, irregular intervals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity Variations\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/salinity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data calibration information available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69353", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2020-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69353", "text": "{\n    \"dataset_name\": \"Ocean Acidity Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification Impacts\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Sensor calibration data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--69354", "text": "{\n    \"dataset_name\": \"Urban Heat Island Temperature Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"location\",\n            \"units\": \"latitude, longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Hourly measurements from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Local Temperatures\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_heat_island_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69354", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Inventory\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Smithsonian Institution\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"units\": \"number of species\"\n        },\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"leaf_area\",\n            \"units\": \"square meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Quadrat sampling in forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Temperate Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species identification confirmed by experts\"\n    }\n}"}
{"_id": "Academic--research_data--p--69355", "text": "{\n    \"dataset_name\": \"Oxford Climate Data 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature_celsius\",\n            \"units\": \"°C\",\n            \"description\": \"Average daily temperature in Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Trends in Oxfordshire\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/oxford_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality checked and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69355", "text": "{\n    \"dataset_name\": \"Global Precipitation Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-07-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"precipitation_mm\",\n            \"units\": \"mm\",\n            \"description\": \"Daily precipitation in millimeters\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\",\n            \"description\": \"Average daily wind speed\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Satellite imagery and ground sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Rainfall Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_precipitation.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data processed using standard algorithms.\"\n    }\n}"}
