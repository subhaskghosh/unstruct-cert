{"_id": "Academic--research_data--p--70051", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, University College London\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes hourly averages and daily summaries.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70051", "text": "{\n    \"dataset_name\": \"OceanTemperature_Pacific_2022\",\n    \"creator\": {\n        \"name\": \"Marine Research Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Research vessel transects across the Pacific Ocean\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Temperature Variations\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp_pacific_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data collected during a research expedition.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70052", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\",\n            \"description\": \"Concentration of nitrogen dioxide\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
