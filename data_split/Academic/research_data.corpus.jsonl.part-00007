{"_id": "Academic--research_data--n--70774", "text": "{\n    \"dataset_name\": \"WaterQuality_RiverThames\",\n    \"creator\": {\n        \"name\": \"Thames River Trust\",\n        \"affiliation\": \"Water Monitoring Department\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Weekly water sample collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Assessment of the River Thames\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/thames_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes measurements from 15 locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70775", "text": "{\n    \"dataset_name\": \"Global Precipitation Dataset 2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-06-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Satellite-based observation and ground station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Global Precipitation Patterns\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/precipitation_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70775", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis - Climate Change\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Social Science Research Center\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sentiment_score\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"tweet_text\",\n            \"units\": \"text\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Twitter API data collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/sentiment_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Sentiment analysis labels provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--70776", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Comprehensive global temperature data from 1880 to present. Includes monthly and annual anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70776", "text": "{\n    \"dataset_name\": \"Local Weather Observations\",\n    \"creator\": {\n        \"name\": \"Community Weather Station\",\n        \"affiliation\": \"Local High School\"\n    },\n    \"date_collected\": \"2022-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Automated weather station readings\",\n    \"related_publications\": [],\n    \"download_url\": \"http://localweather.org/data\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Basic weather data collected from a local weather station. Limited geographical coverage.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70777", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Measurements - Global\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2022-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Water Vapor\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric Composition\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_composition.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70777", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. James Lee\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Buoy measurements and remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Ocean Warming Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temperature.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data cleaned for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70778", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoringData\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of River Water Quality in the United States\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70778", "text": "{\n    \"dataset_name\": \"AtmosphericPollutionLevels\",\n    \"creator\": {\n        \"name\": \"National Institute of Health\",\n        \"affiliation\": \"NIH\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"ParticulateMatter2.5\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"NitrogenDioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring from fixed air quality stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in atmospheric pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data has been pre-processed and cleaned.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70779", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Earth Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Greenhouse Gases on Global Climate\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70779", "text": "{\n    \"dataset_name\": \"Ocean Temperature Readings\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Miller\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2022-12-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ocean Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data filtered for outliers\"\n    }\n}"}
{"_id": "Academic--research_data--p--70780", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"NitrateConcentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0-1.0\",\n    \"sampling_method\": \"Grab samples collected weekly from 50 river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70780", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"City Air Monitoring Department\",\n        \"affiliation\": \"City Government\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"OzoneConcentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0-1.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is hourly averaged.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70781", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote Sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"15 GB\",\n        \"annotations\": \"Provides yearly tree cover loss and gain data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70781", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Data Online\",\n            \"year\": 2010\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Hourly weather observations from various locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70782", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-06-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Tumor Size\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Prospective cohort study with MRI scans from patients diagnosed with brain tumors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Novel MRI Biomarkers for Glioma Grading\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Sharma, A.\",\n                \"Li, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Expert radiologists provided segmentations of tumor regions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70782", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Pneumonia Diagnosis\",\n            \"units\": \"binary (0/1)\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images from patients admitted to the emergency department.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Lee, D.\",\n                \"Wang, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray.zip\",\n    \"metadata\": {\n        \"data_size\": \"5 GB\",\n        \"annotations\": \"Radiologist reports were used to determine pneumonia diagnoses.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70783", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--70783", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2022-12-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Daily weather reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes missing values\"\n    }\n}"}
{"_id": "Academic--research_data--p--70784", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"observation_date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"species_id\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Citizen science observations reported via eBird\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in North American Bird Migration\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes observations of over 500 bird species.\"\n    }\n}"}
