{"_id": "Academic--research_data--p--70700", "text": "{\n    \"dataset_name\": \"Twitter Sentiment Analysis Dataset\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"text\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"sentiment\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Random sampling of public tweets\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis on Twitter Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/twitter_sentiment.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Sentiment labels provided by human annotators.\"\n    }\n}"}
