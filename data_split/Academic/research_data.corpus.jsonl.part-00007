{"_id": "Academic--research_data--p--69739", "text": "{\n    \"dataset_name\": \"ImageNet Subset for Object Detection\",\n    \"creator\": {\n        \"name\": \"ImageNet Team\",\n        \"affiliation\": \"Princeton University\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"image_height\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"object_class\",\n            \"units\": \"category label\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Random sampling from the full ImageNet dataset\",\n    \"related_publications\": [\n        {\n            \"title\": \"Large Scale Visual Recognition Challenge 2014\",\n            \"authors\": [\n                \"J. Deng\",\n                \"W. Dong\",\n                \"R. Socher\"\n            ]\n        }\n    ],\n    \"download_url\": \"http://example.com/imagenet_subset.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Bounding boxes for object detection\"\n    }\n}"}
