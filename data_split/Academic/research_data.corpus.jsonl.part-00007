{"_id": "Academic--research_data--n--68750", "text": "{\n    \"dataset_name\": \"GlobalForestCarbonStocks\",\n    \"creator\": {\n        \"name\": \"Forestry Research Institute\",\n        \"affiliation\": \"FRI\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Proprietary - Academic Use Only\",\n    \"sampling_method\": \"Satellite Imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Stock Assessment in Tropical Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forestcarbon.tif\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data derived from LiDAR and optical imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68751", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover - Baltimore 2023\",\n    \"creator\": {\n        \"name\": \"University of Maryland, Department of Environmental Science\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"tree_longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"canopy_cover_percentage\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"tree_species\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Randomly selected city blocks, stratified by socioeconomic status.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Tree Canopy on Baltimore Microclimates\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/baltimore_tree_canopy.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Geospatial data, linked to census tracts.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68751", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2024-01-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2_ppm\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations globally.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Global average concentrations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68752", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Sensor Network\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using a network of distributed sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Density on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68752", "text": "{\n    \"dataset_name\": \"National Emissions Inventory - 2022\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-10T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"SO2 Emissions\",\n            \"units\": \"tons\",\n            \"description\": \"Sulfur Dioxide Emissions\"\n        },\n        {\n            \"variable_name\": \"NOx Emissions\",\n            \"units\": \"tons\",\n            \"description\": \"Nitrogen Oxides Emissions\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Based on reported industrial emissions.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.gov/national_emissions.xml\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Official government data on emissions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68753", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Recent Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Geographic Location\",\n            \"units\": \"latitude, longitude\"\n        },\n        {\n            \"name\": \"Environmental Impact\",\n            \"units\": \"Qualitative assessment\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68753", "text": "{\n    \"dataset_name\": \"Historical Weather Records - North America\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations across North America\",\n    \"related_publications\": [\n        {\n            \"title\": \"North American Climate Variability\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Contains quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68754", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-10-26T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen (mg/L)\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Nitrate Concentration (mg/L)\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic grab samples collected monthly at fixed stations along major river networks.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Assessment of River Water Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/national-river-water-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Includes quality control flags and station metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68754", "text": "{\n    \"dataset_name\": \"Coastal Marine Plankton Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2024-01-15T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plankton Abundance (cells/mL)\",\n            \"units\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Salinity (PSU)\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a Concentration (µg/L)\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Plankton tows and water sample analysis at various coastal locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Marine Plankton Communities\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://scripps.ucsd.edu/plankton_data\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Includes species identification and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68755", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Chicago\",\n    \"creator\": {\n        \"name\": \"University of Chicago Environmental Research Group\",\n        \"affiliation\": \"University of Chicago\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chicago_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68755", "text": "{\n    \"dataset_name\": \"Global Forest Canopy Height\",\n    \"creator\": {\n        \"name\": \"NASA Earth Science Data and Information System\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Canopy Height\",\n            \"units\": \"meters\",\n            \"description\": \"Height of forest canopy as measured by LiDAR\"\n        },\n        {\n            \"variable_name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\",\n            \"description\": \"Measure of the density of leaves in a forest canopy\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite LiDAR measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_canopy.tif\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is pre-processed and cloud-masked\"\n    }\n}"}
