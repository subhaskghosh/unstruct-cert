{"_id": "Academic--research_data--p--71258", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Extreme Weather Events\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atmospheric Composition on Hurricane Intensity\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.example.com/noaa_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
