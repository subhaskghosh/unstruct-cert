{"_id": "Academic--research_data--p--69393", "text": "{\n    \"dataset_name\": \"ML Healthcare Data 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Alice Johnson\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient Age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"Blood Pressure\",\n            \"unit\": \"mmHg\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Machine Learning Applications in Healthcare Diagnosis\",\n            \"authors\": [\n                \"Alice Johnson\",\n                \"Bob Williams\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ml_healthcare_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been anonymized.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69393", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tweet Text\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"unit\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"API scraping of Twitter data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Opinion on Social Media\",\n            \"authors\": [\n                \"David Lee\",\n                \"Carol Brown\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_sentiment.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data contains potentially offensive content.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69394", "text": "{\n    \"dataset_name\": \"Atmospheric Data from Rural Monitoring Stations\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Environmental Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Atmospheric Pressure\",\n            \"units\": \"Pa\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring at 1-hour intervals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Atmospheric Trends in Rural Environments\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rural_atm_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69394", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"David Miller\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO Levels\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2 Levels\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Daily grab samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution in Urban Centers\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data validated by laboratory analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69395", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies (2020-2023)\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69395", "text": "{\n    \"dataset_name\": \"Historical Climate Data (1950-2019)\",\n    \"creator\": {\n        \"name\": \"NOAA NCDC\",\n        \"affiliation\": \"National Climatic Data Center\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Station-based observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Variability\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_climate.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes daily precipitation and temperature.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69396", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains monthly global surface temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69396", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Weather station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Local Climate Patterns\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/historical-weather-data\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Historical weather data from various locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69397", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network - Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Daily observations from weather stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69397", "text": "{\n    \"dataset_name\": \"Oceanic Plankton Abundance\",\n    \"creator\": {\n        \"name\": \"Marine Biological Association\",\n        \"affiliation\": \"Plymouth Marine Laboratory\"\n    },\n    \"date_collected\": \"2019-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plankton Density\",\n            \"units\": \"cells/ml\"\n        },\n        {\n            \"name\": \"Species Composition\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Plankton net tows at various ocean depths\",\n    \"related_publications\": [\n        {\n            \"title\": \"Plankton Dynamics in Coastal Waters\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.mba.ac.uk/planktondata\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Geographic coordinates included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69398", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Segmentation\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University Medical Center\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tumor Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Edema Size\",\n            \"units\": \"mm^3\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective MRI scans of patients with confirmed brain tumors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation using Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Manual segmentations by expert radiologists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69398", "text": "{\n    \"dataset_name\": \"Chest X-Ray Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-06-20T14:45:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"Pneumonia Probability\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection in Chest X-rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_pneumonia.zip\",\n    \"metadata\": {\n        \"data_size\": \"5 GB\",\n        \"annotations\": \"Radiologist-verified pneumonia labels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69399", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2023-2024\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2023\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains temperature anomalies relative to a baseline period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69399", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity\",\n    \"creator\": {\n        \"name\": \"Instituto Nacional de Pesquisas da Amazônia\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 3.0 Unported\",\n    \"sampling_method\": \"Random sampling within designated research plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Includes data on plant and animal species.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69400", "text": "{\n    \"dataset_name\": \"LIDC-IDRI Lung Nodule Detection Dataset\",\n    \"creator\": {\n        \"name\": \"The Cancer Imaging Archive (TCIA)\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ImageID\",\n            \"units\": \"Unique Identifier\"\n        },\n        {\n            \"name\": \"NoduleDiameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Malignancy\",\n            \"units\": \"Binary (0 or 1)\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective CT scans from multiple institutions\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Lung Image Database Consortium image collection: 1574 nodule with CT appearance and pathology\",\n            \"authors\": [\n                \"Armand\",\n                \"R.A.\",\n                \"Levy\",\n                \"L.M.\",\n                \"Trailina\",\n                \"B.A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.cancerimagingarchive.net/ncia/LIDC-IDRI\",\n    \"metadata\": {\n        \"data_size\": \"1.2 TB\",\n        \"annotations\": \"Radiologist-annotated nodule locations and characteristics\"\n    }\n}"}
{"_id": "Academic--research_data--n--69400", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Federated Tumor Segmentation (FeTS)\",\n        \"affiliation\": \"Various Universities\"\n    },\n    \"date_collected\": \"2023-08-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PatientID\",\n            \"units\": \"Unique Identifier\"\n        },\n        {\n            \"name\": \"TumorVolume\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"TumorType\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Multi-center MRI scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"BraTS Dataset\",\n            \"authors\": [\n                \"Bakas\",\n                \"S.\",\n                \"et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.medseg.de/en/datasets/brats\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Expert neuro-radiologist segmentations\"\n    }\n}"}
{"_id": "Academic--research_data--p--69401", "text": "{\n    \"dataset_name\": \"Lung Cancer CT Scan Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tumor Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Nodule Volume\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Early Lung Cancer Detection using Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_cancer_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-verified tumor segmentations\"\n    }\n}"}
{"_id": "Academic--research_data--n--69401", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Brain Volume\",\n            \"units\": \"cm^3\"\n        },\n        {\n            \"name\": \"Grey Matter Ratio\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"White Matter Volume\",\n            \"units\": \"cm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Convenience sampling from research participants\",\n    \"related_publications\": [\n        {\n            \"title\": \"Alzheimer's Disease Progression using MRI\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"30GB\",\n        \"annotations\": \"Expert annotations of brain regions\"\n    }\n}"}
{"_id": "Academic--research_data--p--69402", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2023-2024\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-02-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2023\",\n            \"authors\": [\n                \"Hansen\",\n                \"Sato\",\n                \"Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes land-ocean temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69402", "text": "{\n    \"dataset_name\": \"Historical Climate Data - 1980-2000\",\n    \"creator\": {\n        \"name\": \"NOAA Climate\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2000-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Station-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Trends in the 20th Century\",\n            \"authors\": [\n                \"Jones\",\n                \"Dyer\",\n                \"Reynolds\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_climate.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Includes daily precipitation and temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69403", "text": "{\n    \"dataset_name\": \"Stanford Sentiment Treebank\",\n    \"creator\": {\n        \"name\": \"Richard Socher\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sentence_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"sentence_text\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"sentiment\",\n            \"units\": \"integer (0-5)\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Human annotation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recursive Deep Models for Semantic Compositionality\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://nlp.stanford.edu/sentiment/treebank.zip\",\n    \"metadata\": {\n        \"data_size\": \"5.6 MB\",\n        \"annotations\": \"Sentiment labels for phrases in movie review sentences\"\n    }\n}"}
{"_id": "Academic--research_data--n--69403", "text": "{\n    \"dataset_name\": \"ImageNet\",\n    \"creator\": {\n        \"name\": \"Deng et al.\",\n        \"affiliation\": \"Princeton University\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_url\",\n            \"units\": \"URL\"\n        },\n        {\n            \"name\": \"label\",\n            \"units\": \"string\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Web crawling\",\n    \"related_publications\": [\n        {\n            \"title\": \"ImageNet: A Large-Scale Visual Recognition Challenge\",\n            \"year\": 2009\n        }\n    ],\n    \"download_url\": \"http://www.image-net.org/\",\n    \"metadata\": {\n        \"data_size\": \"150 GB\",\n        \"annotations\": \"Labels for various objects in images\"\n    }\n}"}
{"_id": "Academic--research_data--p--69404", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees north\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees east\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at global stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69404", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"Global Historical Climatology Network\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Station ID\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily readings from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Variations\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Missing values are denoted by -9999.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69405", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69405", "text": "{\n    \"dataset_name\": \"Water Quality Monitoring in Rivers\",\n    \"creator\": {\n        \"name\": \"Hydrological Survey Department\",\n        \"affiliation\": \"National Water Agency\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Grab samples collected weekly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of River Water Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Sampling locations marked on a map\"\n    }\n}"}
{"_id": "Academic--research_data--p--69406", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global grid cells\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains monthly average temperatures\"\n    }\n}"}
