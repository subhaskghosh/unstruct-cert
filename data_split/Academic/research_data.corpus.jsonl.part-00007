{"_id": "Academic--research_data--p--69813", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset - Tumor Segmentation\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pixel_intensity\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"image_resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"tumor_location\",\n            \"units\": \"coordinates\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective MRI scans from patients diagnosed with brain tumors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual segmentation of tumor regions\"\n    }\n}"}
{"_id": "Academic--research_data--n--69813", "text": "{\n    \"dataset_name\": \"Chest X-ray Dataset - Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pixel_value\",\n            \"units\": \"Hounsfield units\"\n        },\n        {\n            \"name\": \"image_width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"pneumonia_present\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective chest X-rays from patients with respiratory symptoms\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Pneumonia Detection using Convolutional Neural Networks\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Wang, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Radiologist-verified pneumonia labels\"\n    }\n}"}
{"_id": "Academic--research_data--p--69814", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentrations - Global\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric CO2\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
