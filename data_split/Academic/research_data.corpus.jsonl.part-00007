{"_id": "Academic--research_data--p--69823", "text": "{\n    \"dataset_name\": \"ImageNet-DL-Subset\",\n    \"creator\": {\n        \"name\": \"The Deep Learning Research Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"image_height\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"label\",\n            \"units\": \"category\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0\",\n    \"sampling_method\": \"Random sampling from ImageNet\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Image Recognition\",\n            \"year\": 2015\n        },\n        {\n            \"title\": \"Advancements in Convolutional Neural Networks\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/imagenet_dl_subset.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Bounding boxes for objects\"\n    }\n}"}
