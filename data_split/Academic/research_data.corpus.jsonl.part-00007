{"_id": "Academic--research_data--p--66933", "text": "{\n    \"dataset_name\": \"Mouse Cortical Neuron Activity\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Neuron ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"Spike Time\",\n            \"units\": \"milliseconds\"\n        },\n        {\n            \"variable_name\": \"Firing Rate\",\n            \"units\": \"Hz\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Whole-cell patch clamp recordings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Cortical Neuron Dynamics in Response to Sensory Stimuli\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/mouse_neuron_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes timestamps of action potentials and corresponding neuron IDs.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66933", "text": "{\n    \"dataset_name\": \"Human EEG Data - Resting State\",\n    \"creator\": {\n        \"name\": \"Dr. Ben Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Channel 1\",\n            \"units\": \"microvolts\"\n        },\n        {\n            \"variable_name\": \"Channel 2\",\n            \"units\": \"microvolts\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Electroencephalography\",\n    \"related_publications\": [\n        {\n            \"title\": \"Resting State EEG Dynamics\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/human_eeg_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"EEG data recorded from 64 channels during resting state.\"\n    }\n}"}
