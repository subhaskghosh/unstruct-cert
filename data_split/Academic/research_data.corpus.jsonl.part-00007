{"_id": "Academic--research_data--n--67107", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phytoplankton Density\",\n            \"units\": \"cells/mL\"\n        },\n        {\n            \"name\": \"Zooplankton Biomass\",\n            \"units\": \"mg/m³\"\n        },\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Light Penetration\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Coastal Waters\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Species identification verified\"\n    }\n}"}
{"_id": "Academic--research_data--p--67108", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_Beijing_2023\",\n    \"creator\": {\n        \"name\": \"Beijing Environmental Monitoring Center\",\n        \"affiliation\": \"Beijing Municipal Ecology and Environment Bureau\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2 Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"unit\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Beijing\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67108", "text": "{\n    \"dataset_name\": \"WaterQuality_River_Ohio_2022\",\n    \"creator\": {\n        \"name\": \"Ohio Environmental Protection Agency\",\n        \"affiliation\": \"Ohio EPA\"\n    },\n    \"date_collected\": \"2022-11-20T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"ODbL\",\n    \"sampling_method\": \"Grab samples at regular intervals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Assessment of Ohio Rivers\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ohio_river_water_quality_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes weekly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67109", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Licence\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data is quality controlled and validated daily.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67109", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Association\",\n        \"affiliation\": \"Research Department\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species Richness\",\n            \"units\": \"species/hectare\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://amazonconservation.org/biodiversitydata\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Preliminary analysis, data may contain errors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67110", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2021-2023\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Deforestation events and forest gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67110", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Output\",\n    \"creator\": {\n        \"name\": \"World Climate Research Programme\",\n        \"affiliation\": \"WCRP\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The CMIP6 model archive\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Climate simulation data for various scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67111", "text": "{\n    \"dataset_name\": \"Global Carbon Emission Dataset (2021-2023)\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions (metric tons)\",\n            \"units\": \"metric tons\"\n        },\n        {\n            \"name\": \"CH4 Emissions (metric tons)\",\n            \"units\": \"metric tons\"\n        },\n        {\n            \"name\": \"N2O Emissions (metric tons)\",\n            \"units\": \"metric tons\"\n        },\n        {\n            \"name\": \"Fossil Fuel Consumption\",\n            \"units\": \"Joules\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global monitoring stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Greenhouse Gas Emissions\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/carbon_emissions_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Comprehensive documentation including data processing steps and error analysis.\"\n    }\n}"}
