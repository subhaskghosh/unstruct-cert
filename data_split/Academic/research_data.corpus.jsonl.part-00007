{"_id": "Academic--research_data--n--71214", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Ben Carter\",\n        \"affiliation\": \"Australian Institute of Marine Science\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"coral_species_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"variable_name\": \"fish_biomass\",\n            \"units\": \"grams\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Underwater visual census along transects.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Resilience to Climate Change\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data includes images of coral species.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71215", "text": "{\n    \"dataset_name\": \"North American Plant Trait Database\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"leaf_area\",\n            \"unit\": \"cm^2\"\n        },\n        {\n            \"name\": \"stem_diameter\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"plant_height\",\n            \"unit\": \"m\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Random stratified sampling across representative biomes\",\n    \"related_publications\": [\n        {\n            \"title\": \"Plant trait variation along environmental gradients\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/naptd.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality assessed using standardized protocols.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71215", "text": "{\n    \"dataset_name\": \"Global Forest Inventory\",\n    \"creator\": {\n        \"name\": \"International Forestry Consortium\",\n        \"affiliation\": \"Global Organization\"\n    },\n    \"date_collected\": \"2019-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_density\",\n            \"unit\": \"trees/ha\"\n        },\n        {\n            \"name\": \"basal_area\",\n            \"unit\": \"m^2/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Systematic grid sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global trends in forest structure\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Brown, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://forestryconsortium.org/data.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Preliminary data, subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71216", "text": "{\n    \"dataset_name\": \"US Air Quality Monitoring - EPA\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"United States Government\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in the United States\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/us_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes daily averages for various pollutants.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71216", "text": "{\n    \"dataset_name\": \"Canadian Forest Fire Emissions\",\n    \"creator\": {\n        \"name\": \"Natural Resources Canada\",\n        \"affiliation\": \"Canadian Government\"\n    },\n    \"date_collected\": \"2023-06-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2_emissions\",\n            \"unit\": \"tonnes\"\n        },\n        {\n            \"name\": \"PM2.5_emissions\",\n            \"unit\": \"kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Data License - Canada\",\n    \"sampling_method\": \"Satellite remote sensing and ground measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Forest Fires on Atmospheric Composition\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/canada_fire_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data covers emissions from major forest fires across Canada.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71217", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data - North Atlantic\",\n    \"creator\": {\n        \"name\": \"National Oceanography Centre\",\n        \"affiliation\": \"University of Southampton\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees West\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Autonomous underwater vehicle deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atlantic Warming on Marine Ecosystems\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data_north_atlantic.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included for each data point.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71217", "text": "{\n    \"dataset_name\": \"Regional Rainfall Patterns - Amazon Basin\",\n    \"creator\": {\n        \"name\": \"Independent Researcher\",\n        \"affiliation\": \"None\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Rain gauge network\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/amazon_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data represents average monthly rainfall.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71218", "text": "{\n    \"dataset_name\": \"Cardiac MRI Segmentation Dataset\",\n    \"creator\": {\n        \"name\": \"Stanford University Medical Imaging Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2024-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"units\": \"file path\"\n        },\n        {\n            \"name\": \"left_ventricle_volume\",\n            \"units\": \"mL\"\n        },\n        {\n            \"name\": \"ejection_fraction\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Prospective MRI scans of patients with diagnosed cardiovascular disease.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Cardiac Segmentation using Deep Learning\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/cardiac_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"750MB\",\n        \"annotations\": \"Manual segmentations of left ventricle provided.\"\n    }\n}"}
