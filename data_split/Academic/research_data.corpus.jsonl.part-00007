{"_id": "Academic--research_data--n--65986", "text": "{\n    \"dataset_name\": \"Indoor Plant Growth Data\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plant Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Leaf Count\",\n            \"units\": \"number\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Manual measurements of plant growth\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/plant_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50KB\",\n        \"annotations\": \"Data collected from a small home experiment.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65987", "text": "{\n    \"dataset_name\": \"Global Precipitation and Temperature Dataset (GPTD)\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Total Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global satellite observations and ground station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Comprehensive Assessment of Global Precipitation Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/gptd_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--65987", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa Department of Agriculture\",\n        \"affiliation\": \"State of Iowa\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Soybean Yield\",\n            \"units\": \"bushels/acre\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Restricted Use\",\n    \"sampling_method\": \"Farm surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Iowa Crop Production\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/iowa_crop_yields.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data collected from farm reports\"\n    }\n}"}
{"_id": "Academic--research_data--p--65988", "text": "{\n    \"dataset_name\": \"North American Forest Bird Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"The Cornell Lab of Ornithology\",\n        \"affiliation\": \"Cornell University\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"observation_count\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Point count surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Avian abundance trends in North America\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_bird_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes bird species classifications.\"\n    }\n}"}
{"_id": "Academic--research_data--n--65988", "text": "{\n    \"dataset_name\": \"Global Coral Reef Health Data\",\n    \"creator\": {\n        \"name\": \"ReefBase\",\n        \"affiliation\": \"Global Coral Reef Monitoring Network\"\n    },\n    \"date_collected\": \"2021-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"coral_cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Status of coral reefs worldwide\",\n            \"authors\": [\n                \"Hughes\",\n                \"Baker\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes classifications of coral species and reef health.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65989", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, King's College London\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags are included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--65989", "text": "{\n    \"dataset_name\": \"HistoricalTemperatureData_Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\",\n            \"description\": \"Average daily temperature.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature variations\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data may contain missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65990", "text": "{\n    \"dataset_name\": \"National Water Quality Assessment (NAWQA) Data\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Systematic random sampling at fixed monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program: Surface Water-Quality Data\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/nawqa\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Includes quality control flags and metadata for each sample.\"\n    }\n}"}
{"_id": "Academic--research_data--n--65990", "text": "{\n    \"dataset_name\": \"Global Forest Change Data\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-08-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2010\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Derived from Landsat imagery, providing yearly forest cover changes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65991", "text": "{\n    \"dataset_name\": \"Air Quality Data - Urban Sensors\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley - Environmental Science Department\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring with fixed sensors across urban locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--65991", "text": "{\n    \"dataset_name\": \"National Emissions Inventory\",\n    \"creator\": {\n        \"name\": \"EnviroTrack Solutions\",\n        \"affiliation\": \"Commercial Environmental Consulting Firm\"\n    },\n    \"date_collected\": \"2024-02-28T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2 Emissions\",\n            \"units\": \"tons\"\n        },\n        {\n            \"name\": \"NOx Emissions\",\n            \"units\": \"tons\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Limited Use\",\n    \"sampling_method\": \"Modeled emissions estimates based on industrial activity data.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://envirotrack.com/data_request\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data requires specific usage agreements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65992", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"United States Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations across major cities\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--65992", "text": "{\n    \"dataset_name\": \"Plant Species Distribution in Forests\",\n    \"creator\": {\n        \"name\": \"Forestry Research Institute\",\n        \"affiliation\": \"National Forestry Research Institute\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random forest plots across various regions\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Forest Ecosystems\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/plant_data.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Species identifications were verified by expert botanists.\"\n    }\n}"}
