{"_id": "Academic--research_data--p--68163", "text": "{\n    \"dataset_name\": \"Coastal Erosion and Climate Change Impacts\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Erosion Rate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"mm/year\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular shoreline surveys and satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Erosion Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags for erosion rate measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68163", "text": "{\n    \"dataset_name\": \"Atmospheric Carbon Dioxide Levels\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2018-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations and atmospheric sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Cycle Trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68164", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68164", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. John Smith\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"number\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Remote operated vehicle (ROV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Sea Biodiversity\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification details.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68165", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide (CO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane (CH4)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Nitrous Oxide (N2O)\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric Greenhouse Gases\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/noaa_atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included for each variable.\"\n    }\n}"}
