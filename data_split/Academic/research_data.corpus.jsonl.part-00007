{"_id": "Academic--research_data--n--66039", "text": "{\n    \"dataset_name\": \"Chest X-Ray Pneumonia Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"gender\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"pneumonia_type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective analysis of hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection in Chest X-rays\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Wang, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist reports indicating presence/absence of pneumonia\"\n    }\n}"}
