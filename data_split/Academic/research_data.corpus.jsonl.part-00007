{"_id": "Academic--research_data--p--69247", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Health\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"patient_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"patient_age\",\n            \"units\": \"years\"\n        },\n        {\n            \"variable_name\": \"image_resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"variable_name\": \"tumor_grade\",\n            \"units\": \"I-IV\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Detection using MRI\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Manual segmentation by radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--69247", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"patient_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"variable_name\": \"pneumonia_diagnosis\",\n            \"units\": \"binary\"\n        },\n        {\n            \"variable_name\": \"image_quality\",\n            \"units\": \"scale of 1-5\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective study of patients with respiratory symptoms\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray.csv\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Automated diagnosis using a deep learning model\"\n    }\n}"}
