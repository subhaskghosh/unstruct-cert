{"_id": "Academic--research_data--n--68756", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns in Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Research Alliance\",\n        \"affiliation\": \"EU Consortium\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Regular Grid Interpolation\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Trends\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data requires significant processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68757", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-10-26T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London boroughs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2018-2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ],\n            \"year\": 2024,\n            \"doi\": \"10.1234/londonair2024\"\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68757", "text": "{\n    \"dataset_name\": \"Industrial Emission Monitoring - Ruhr Area\",\n    \"creator\": {\n        \"name\": \"German Federal Environmental Agency\",\n        \"affiliation\": \"Air Pollution Control Department\"\n    },\n    \"date_collected\": \"2023-11-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter\",\n            \"units\": \"mg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Stack emission measurements from industrial facilities\",\n    \"related_publications\": [\n        {\n            \"title\": \"Industrial Air Pollution in the Ruhr Area\",\n            \"authors\": [\n                \"Schmidt, K.\",\n                \"Weber, L.\"\n            ],\n            \"year\": 2023,\n            \"doi\": \"10.5678/ruhrindustry2023\"\n        }\n    ],\n    \"download_url\": \"https://example.de/industrialemissions.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data includes daily emission totals.\"\n    }\n}"}
