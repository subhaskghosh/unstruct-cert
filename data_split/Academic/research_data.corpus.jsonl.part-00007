{"_id": "Academic--research_data--p--67260", "text": "{\n    \"dataset_name\": \"Global Surface Summary of the Day - Version 3\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-10-27T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TMAX\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"TMIN\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"PRCP\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"AWND\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Daily Surface Data for Global Climate Analysis\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-summary-of-the-day/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
