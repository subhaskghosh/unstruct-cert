{"_id": "Academic--research_data--p--68218", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Flux Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Net Ecosystem Exchange\",\n            \"units\": \"kg C m-2 s-1\"\n        },\n        {\n            \"name\": \"Gross Primary Production\",\n            \"units\": \"kg C m-2 s-1\"\n        },\n        {\n            \"name\": \"Respiration\",\n            \"units\": \"kg C m-2 s-1\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Flux tower network with eddy covariance measurements and satellite validation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Patterns of Forest Carbon Flux\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_flux.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68218", "text": "{\n    \"dataset_name\": \"Regional Climate Model Output - North America\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Regional climate model simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Downscaled Climate Projections for North America\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/regional_climate_model.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Model output based on CMIP6 scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68219", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Research Group\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"O3 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Open Database License (ODbL)\",\n    \"sampling_method\": \"Continuous monitoring from fixed sensor network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2020-2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages\"\n    }\n}"}
