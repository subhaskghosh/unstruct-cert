{"_id": "Academic--research_data--p--71721", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71721", "text": "{\n    \"dataset_name\": \"Coastal Water Quality - California\",\n    \"creator\": {\n        \"name\": \"California State University, Monterey Bay\",\n        \"affiliation\": \"Marine Biology Department\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Discrete water samples collected monthly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Runoff on Coastal Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/california_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"3MB\",\n        \"annotations\": \"Raw data requires significant cleaning and outlier removal before analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71722", "text": "{\n    \"dataset_name\": \"North American Lake Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency - Lake Monitoring Team\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"Standard Units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from designated lake locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in North American Lake Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71722", "text": "{\n    \"dataset_name\": \"European River Sediment Analysis\",\n    \"creator\": {\n        \"name\": \"European River Basin Authority\",\n        \"affiliation\": \"ERBA\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sediment Grain Size\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Heavy Metal Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Organic Matter Content\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Core samples collected bi-annually from riverbeds.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sediment Composition and Pollution in European Rivers\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_sediment.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data is pre-processed and normalized.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71723", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Massachusetts Institute of Technology\",\n        \"affiliation\": \"MIT Computer Science and Artificial Intelligence Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"unit\": \"file path\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"unit\": \"binary (positive/negative)\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Retrospective collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"CheXpert: Large Scale Chest X-Ray Interpretation\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"750MB\",\n        \"annotations\": \"bounding boxes for pneumonia regions\"\n    }\n}"}
{"_id": "Academic--research_data--n--71723", "text": "{\n    \"dataset_name\": \"MRI Scans of Brain Tumors\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"unit\": \"file path\"\n        },\n        {\n            \"name\": \"tumor_grade\",\n            \"unit\": \"integer (1-4)\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective study with participant consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation with Deep Learning\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"segmentation masks for tumor regions\"\n    }\n}"}
{"_id": "Academic--research_data--p--71724", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Water pH\",\n            \"units\": \"pH\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations deployed across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic pollution on respiratory health in urban populations\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data quality flags and station metadata included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71724", "text": "{\n    \"dataset_name\": \"Plant Species Distribution in Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"University of São Paulo\",\n        \"affiliation\": \"Institute of Botany\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Leaf Area\",\n            \"units\": \"cm²\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Soil Type\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Light Intensity\",\n            \"units\": \"Lux\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Cloud Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"kg/m²\"\n        },\n        {\n            \"name\": \"Carbon Stock\",\n            \"units\": \"kg/m²\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Random stratified sampling across the Amazon basin\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the Amazon rainforest\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_plant_data.json\",\n    \"metadata\": {\n        \"data_size\": \"800KB\",\n        \"annotations\": \"Species identification verified by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71725", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoringData\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\",\n            \"description\": \"Concentration of dissolved oxygen in the water, critical for aquatic life. Measured using a Winkler titration method.\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\",\n            \"description\": \"Measure of the acidity or alkalinity of the water. Measured using a calibrated pH meter.\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\",\n            \"description\": \"Measure of water clarity, indicating the amount of suspended particles. Measured using a nephelometer.\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"unit\": \"mg/L\",\n            \"description\": \"Concentration of nitrate in the water, a common pollutant from agricultural runoff.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected monthly from 20 river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71725", "text": "{\n    \"dataset_name\": \"UrbanAirQualityMeasurements\",\n    \"creator\": {\n        \"name\": \"City Environmental Monitoring Department\",\n        \"affiliation\": \"City Hall\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"unit\": \"ppm\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at 5 urban locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Trends in Urban Areas\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data gaps are filled using interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71726", "text": "{\n    \"dataset_name\": \"Freshwater Ecosystem Health Monitoring - North America\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"E. coli Count\",\n            \"units\": \"CFU/100mL\"\n        },\n        {\n            \"name\": \"Total Dissolved Solids\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Alkalinity\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Flow Rate\",\n            \"units\": \"m^3/s\"\n        },\n        {\n            \"name\": \"Vegetation Index\",\n            \"units\": \"NDVI\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling across 50 lakes and rivers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71726", "text": "{\n    \"dataset_name\": \"Pacific Ocean Microplastic Distribution\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"Tokyo University\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Microplastic Concentration\",\n            \"units\": \"particles/m^3\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Transect sampling using research vessels.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Microplastic Pollution in the Pacific Gyre\",\n            \"authors\": [\n                \"Tanaka, K.\",\n                \"Yamamoto, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_microplastics.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data has been filtered for particles > 0.1mm.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71727", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
