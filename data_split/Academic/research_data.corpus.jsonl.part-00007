{"_id": "Academic--research_data--p--67896", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2021-2023\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": \"Hansen, M.C.\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2020\",\n    \"metadata\": {\n        \"data_size\": \"150 GB\",\n        \"annotations\": \"Raster data representing forest loss and gain\"\n    }\n}"}
