{"_id": "Academic--research_data--n--68996", "text": "{\n    \"dataset_name\": \"Lake Water Quality Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Water Depth\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH Level\",\n            \"unit\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Systematic sampling from multiple lake locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of nutrient runoff on lake ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes seasonal variations and pollution levels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68997", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations throughout Greater London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in London - 2023 Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is quality checked and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68997", "text": "{\n    \"dataset_name\": \"Soil Composition Analysis - Rural Farms\",\n    \"creator\": {\n        \"name\": \"National Agricultural Research Institute\",\n        \"affiliation\": \"Soil Science Division\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling of soil cores across agricultural land\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Fertilizers on Soil Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data represents a small-scale study.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68998", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-07-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic Density on Air Quality in Urban Areas\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data quality checks performed and documented.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68998", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon 2021\",\n    \"creator\": {\n        \"name\": \"Dr. Javier Rodriguez\",\n        \"affiliation\": \"Amazon Research Institute\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Rainforest\",\n            \"year\": 2022,\n            \"authors\": [\n                \"Rodriguez, J.\",\n                \"Silva, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity_2021.json\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Initial species identification completed.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68999", "text": "{\n    \"dataset_name\": \"Twitter Engagement Metrics - 2024\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"retweet_count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"like_count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"reply_count\",\n            \"unit\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling of public tweets\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing User Engagement on Twitter\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/twitter_engagement.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data contains cleaned tweet text.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68999", "text": "{\n    \"dataset_name\": \"Political Sentiment Analysis on Facebook\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"post_sentiment\",\n            \"unit\": \"score\"\n        },\n        {\n            \"name\": \"comment_count\",\n            \"unit\": \"count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Keyword-based scraping of Facebook posts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predicting Political Opinions from Social Media Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/political_sentiment.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes sentiment scores for political posts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69000", "text": "{\n    \"dataset_name\": \"EEG Data from Cognitive Task\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Time\",\n            \"units\": \"seconds\"\n        },\n        {\n            \"name\": \"Amplitude\",\n            \"units\": \"microvolts\"\n        },\n        {\n            \"name\": \"Frequency\",\n            \"units\": \"Hz\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"32-channel EEG recording during a visual attention task\",\n    \"related_publications\": [\n        {\n            \"title\": \"Neural Correlates of Visual Attention\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/eeg_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Epochs labeled by task condition\"\n    }\n}"}
{"_id": "Academic--research_data--n--69000", "text": "{\n    \"dataset_name\": \"fMRI Data of Emotional Response\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"X Coordinate\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Y Coordinate\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Z Coordinate\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"BOLD Signal\",\n            \"units\": \"arbitrary units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"3T fMRI scan during presentation of emotional stimuli\",\n    \"related_publications\": [\n        {\n            \"title\": \"Neural Basis of Emotional Processing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/fmri_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Regions of interest labeled based on anatomical atlas\"\n    }\n}"}
