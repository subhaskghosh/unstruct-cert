{"_id": "Academic--research_data--p--71892", "text": "{\n    \"dataset_name\": \"Urban Temperature Monitoring - Chicago\",\n    \"creator\": {\n        \"name\": \"City of Chicago Environmental Monitoring Team\",\n        \"affiliation\": \"Chicago Department of Public Health\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"location\",\n            \"units\": \"latitude, longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring sensors deployed across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Public Health in Chicago\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chicago_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality control flags included. Sensor calibration information available upon request.\"\n    }\n}"}
