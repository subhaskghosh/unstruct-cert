{"_id": "Academic--research_data--p--71093", "text": "{\n    \"dataset_name\": \"North American Forest Biodiversity Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"TreeHeight\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"DiameterAtBreastHeight\",\n            \"units\": \"centimeters\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"decimal degrees\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"decimal degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Stratified Random Sampling across 100 forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Impacts on Forest Composition\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Includes species identification and growth measurements.\"\n    }\n}"}
