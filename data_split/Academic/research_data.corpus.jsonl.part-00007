{"_id": "Academic--research_data--n--68507", "text": "{\n    \"dataset_name\": \"Global Forest Biomass 1990-2020\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geography\"\n    },\n    \"date_collected\": \"2020-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Belowground Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Root Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Wood Density\",\n            \"units\": \"kg/m³\"\n        },\n        {\n            \"name\": \"Species Composition\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Soil Carbon\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Remote sensing data fusion\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/global_forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Derived from satellite imagery and ground-based measurements.\"\n    }\n}"}
