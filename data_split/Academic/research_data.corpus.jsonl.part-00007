{"_id": "Academic--research_data--n--67174", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Inventory - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Foundation\",\n        \"affiliation\": \"Research Department\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://amazonconservation.org/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"850 MB\",\n        \"annotations\": \"Data includes species identification and abundance.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67175", "text": "{\n    \"dataset_name\": \"Coastal Erosion Rates - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Oceanography\"\n    },\n    \"date_collected\": \"2021-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Erosion Rate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"mm/year\"\n        },\n        {\n            \"name\": \"Vegetation Loss\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Sediment Composition\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular transect measurements along the coastline\",\n    \"related_publications\": [\n        {\n            \"title\": \"Accelerated Coastal Erosion in the Pacific Northwest\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality assessed through repeated measurements.\"\n    }\n}"}
