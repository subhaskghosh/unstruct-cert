{"_id": "Academic--research_data--n--68294", "text": "{\n    \"dataset_name\": \"GlobalForestCarbon_2010\",\n    \"creator\": {\n        \"name\": \"NASA Earth Exchange\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2010-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"AbovegroundBiomass\",\n            \"units\": \"tons/hectare\",\n            \"description\": \"Estimated aboveground biomass.\"\n        },\n        {\n            \"variable_name\": \"CarbonStock\",\n            \"units\": \"tons/hectare\",\n            \"description\": \"Carbon stock in vegetation.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Remote sensing data processed with statistical models.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budgets and the Role of Forests\",\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_2010.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Processed data; potential uncertainties due to modeling.\"\n    }\n}"}
