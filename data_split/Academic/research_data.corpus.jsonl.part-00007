{"_id": "Academic--research_data--p--71233", "text": "{\n    \"dataset_name\": \"Forest Bird Vocalization Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"vocalization_frequency\",\n            \"unit\": \"Hz\"\n        },\n        {\n            \"name\": \"bird_species\",\n            \"unit\": \"species name\"\n        },\n        {\n            \"name\": \"location_latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"location_longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated recording devices placed throughout the forest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Forest Fragmentation on Bird Song\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"journal\": \"Ecology\"\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_bird_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Vocalizations are annotated with species and behavioral context.\"\n    }\n}"}
