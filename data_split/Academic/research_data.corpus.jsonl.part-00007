{"_id": "Academic--research_data--p--68576", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database - River Basin Study\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors and periodic grab samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.gov/waterqualitydata\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68576", "text": "{\n    \"dataset_name\": \"Local Stream Monitoring Project - Community Science\",\n    \"creator\": {\n        \"name\": \"Community Environmental Group\",\n        \"affiliation\": \"Local NGO\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Water Clarity\",\n            \"units\": \"qualitative\"\n        },\n        {\n            \"name\": \"Presence of Macroinvertebrates\",\n            \"units\": \"observed\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"CC BY-NC\",\n    \"sampling_method\": \"Manual water sample collection by volunteers\",\n    \"related_publications\": [],\n    \"download_url\": \"https://communitygroup.org/streamdata\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data collected by untrained volunteers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68577", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring2024\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Environmental Science Department\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68577", "text": "{\n    \"dataset_name\": \"AtmosphericPollutionMeasurements2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Climate Monitoring Division\"\n    },\n    \"date_collected\": \"2023-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring using stationary sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Urban Air Pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data is pre-processed and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68578", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68578", "text": "{\n    \"dataset_name\": \"Industrial Emissions Database\",\n    \"creator\": {\n        \"name\": \"EcoTech Solutions Inc.\",\n        \"affiliation\": \"EcoTech Solutions\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NOx\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Periodic sampling from industrial facilities.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/industrial_emissions.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data is subject to data use agreement.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68579", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, University of California, Berkeley\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68579", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"US Department of Agriculture\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Random sampling plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in US Forests\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification codes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68580", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"London Environmental Research Group\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\",\n            \"description\": \"Concentration of nitrogen dioxide in the air\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations located throughout Greater London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68580", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Carbon Sequestration\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"US Department of Agriculture\"\n    },\n    \"date_collected\": \"2018-11-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\",\n            \"description\": \"Total aboveground biomass in the forest\"\n        },\n        {\n            \"name\": \"Soil Carbon\",\n            \"units\": \"kg/m²\",\n            \"description\": \"Carbon content in the soil\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random forest plots across national forests\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Sequestration in US Forests\",\n            \"authors\": [\n                \"Brown, P.\",\n                \"Green, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes uncertainties in biomass estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68581", "text": "{\n    \"dataset_name\": \"Lake Michigan Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Michigan Water Research Institute\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of Long-Term Water Quality Trends in Lake Michigan\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemichigan_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68581", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Environmental Monitoring Center\",\n        \"affiliation\": \"Beijing Municipality\"\n    },\n    \"date_collected\": \"2021-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - requires agreement\",\n    \"sampling_method\": \"Continuous monitoring stations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/beijing_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data, limited documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68582", "text": "{\n    \"dataset_name\": \"Global Precipitation and Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"University Corporation for Atmospheric Research\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite observations combined with ground station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Comprehensive Analysis of Global Precipitation Patterns\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_climate_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68582", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa State University Agricultural Extension\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Soybean Yield\",\n            \"units\": \"bushels/acre\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Agricultural surveys and farm reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Iowa Crop Production\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/iowa_crop_yields.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data is missing for some years due to reporting issues.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68583", "text": "{\n    \"dataset_name\": \"Social Interaction Dynamics\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"interaction_type\",\n            \"description\": \"Type of social interaction (e.g., conversation, negotiation, collaboration)\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"variable_name\": \"duration\",\n            \"description\": \"Duration of the interaction\",\n            \"unit\": \"seconds\"\n        },\n        {\n            \"variable_name\": \"sentiment_score\",\n            \"description\": \"Sentiment score of the interaction\",\n            \"unit\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Observational study in public spaces\",\n    \"related_publications\": [\n        {\n            \"title\": \"Dynamics of Social Interaction\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/social_interaction_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes timestamps and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68583", "text": "{\n    \"dataset_name\": \"Historical Demographic Trends\",\n    \"creator\": {\n        \"name\": \"Historical Data Archives\",\n        \"affiliation\": \"National Archives\"\n    },\n    \"date_collected\": \"1950-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"population_count\",\n            \"description\": \"Population count for a given region\",\n            \"unit\": \"number\"\n        },\n        {\n            \"variable_name\": \"age_group\",\n            \"description\": \"Age group of the population\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Census data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Historical Population Trends\",\n            \"year\": 1960\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_demographics.txt\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data is aggregated at the county level.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68584", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentration Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2022-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68584", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"Coral Reef Studies\"\n    },\n    \"date_collected\": \"2021-07-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Bleaching Severity\",\n            \"units\": \"scale of 1-5\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Ocean Warming on Coral Reefs\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes imagery and analysis reports.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68585", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing using Landsat imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN/GLOBAL_FOREST_CHANGE_2020_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Contains data on tree cover loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68585", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Dataset\",\n        \"affiliation\": \"ECAD\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution\",\n    \"sampling_method\": \"Network of ground-based weather stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.ecad.net/data\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Daily weather data from various European stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68586", "text": "{\n    \"dataset_name\": \"Global Precipitation and Temperature Dataset (GPTD)\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite observations and ground station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Impacts of Climate Change on Global Precipitation Patterns\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/gptd_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains quality control flags for data reliability.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68586", "text": "{\n    \"dataset_name\": \"Public Opinion on Climate Change Policies\",\n    \"creator\": {\n        \"name\": \"Pew Research Center\",\n        \"affiliation\": \"Pew Charitable Trusts\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Public Opinion\",\n            \"units\": \"Likert scale\"\n        },\n        {\n            \"name\": \"Political Affiliation\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC\",\n    \"sampling_method\": \"National survey conducted via telephone and online\",\n    \"related_publications\": [\n        {\n            \"title\": \"Political Polarization and Climate Change Beliefs\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/public_opinion_dataset.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Survey responses are anonymized.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68587", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis (GSTA) Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data based on station observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global surface temperature analysis\",\n            \"authors\": \"James Hansen et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68587", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns in Oxfordshire\",\n    \"creator\": {\n        \"name\": \"Oxford Climate Research Group\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2021-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Rain gauge measurements from 10 locations in Oxfordshire, UK.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of localized rainfall on agricultural yields in Oxfordshire\",\n            \"authors\": \"Jane Doe et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"http://oxfordclimate.org/rainfall_data\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Daily rainfall data for Oxfordshire, 2020-2023.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68588", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring 2023-2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoys and discrete water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"12.5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68588", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Instituto Nacional de Pesquisas da Amazônia (INPA)\",\n        \"affiliation\": \"Brazilian National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"counts\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Transect surveys and camera traps\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the central Amazon\",\n            \"authors\": [\n                \"Oliveira, R.\",\n                \"Silva, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.xml\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data includes species identification confidence levels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68589", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements in Arctic Regions\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring with automated sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic CO2 Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68589", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"Forestry Research Institute\",\n        \"affiliation\": \"Worldwide Organization\"\n    },\n    \"date_collected\": \"2022-08-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Carbon Stocks\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data resolution: 30 meters.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68590", "text": "{\n    \"dataset_name\": \"Global Forest Watch Tree Cover Loss Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover_loss\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"year\",\n            \"unit\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat and Sentinel-2 satellites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch annual report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"320MB\",\n        \"annotations\": \"Data includes annual tree cover loss from 2000 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68590", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"National Climatic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"1990-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"date\",\n            \"unit\": \"date\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate at a Glance\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Long-term temperature data from stations globally.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68591", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London, Environmental Research Group\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Morphology on Air Pollution Distribution\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included; station locations provided in separate file.\",\n        \"variable_count\": 5\n    }\n}"}
{"_id": "Academic--research_data--n--68591", "text": "{\n    \"dataset_name\": \"Forest Biodiversity - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Basal Area\",\n            \"units\": \"m²/ha\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Random plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Basin\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Species identification based on expert taxonomy.\",\n        \"variable_count\": 3\n    }\n}"}
{"_id": "Academic--research_data--p--68592", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples from fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68592", "text": "{\n    \"dataset_name\": \"Global Soil Temperature Data\",\n    \"creator\": {\n        \"name\": \"Independent Researcher\",\n        \"affiliation\": \"N/A\"\n    },\n    \"date_collected\": \"2022-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"Kelvin\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Crowdsourced data collection via mobile app\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/global_soil_temp.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data may contain inaccuracies due to crowdsourcing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68593", "text": "{\n    \"dataset_name\": \"National Ecological Observatory Network (NEON) Data\",\n    \"creator\": {\n        \"name\": \"NEON Inc.\",\n        \"affiliation\": \"National Science Foundation\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Air Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Soil Moisture\",\n            \"units\": \"percent\"\n        },\n        {\n            \"variable_name\": \"Leaf Area Index\",\n            \"units\": \"m2/m2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"NEON Data Products\",\n            \"authors\": \"Various NEON Scientists\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.neonscience.org/data\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68593", "text": "{\n    \"dataset_name\": \"Urban Bird Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Citizen Science Initiative\",\n        \"affiliation\": \"Local Audubon Society\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"Observation Count\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Opportunistic citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Bird Trends\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/birddata\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is unverified and may contain errors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68594", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"unit\": \"ppm\",\n            \"description\": \"Nitrogen dioxide concentration in parts per million.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data validated and cleaned using standard quality control procedures.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68594", "text": "{\n    \"dataset_name\": \"Global Carbon Emissions Inventory\",\n    \"creator\": {\n        \"name\": \"Carbon Analytics Inc.\",\n        \"affiliation\": \"Commercial Data Provider\"\n    },\n    \"date_collected\": \"2024-01-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"unit\": \"tonnes\",\n            \"description\": \"Annual carbon dioxide emissions by country.\"\n        },\n        {\n            \"name\": \"Methane Emissions\",\n            \"unit\": \"tonnes\",\n            \"description\": \"Annual methane emissions by country.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary License\",\n    \"sampling_method\": \"Bottom-up emission factors and activity data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2023\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Le Quéré, C.\",\n                \"Friedlingstein, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_carbon_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data compiled from various national and international sources.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68595", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated sensors deployed at fixed coastal locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Water Quality Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68595", "text": "{\n    \"dataset_name\": \"Indoor Air Quality Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2022-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Levels\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"VOC Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual air sampling in residential buildings.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Indoor Air Pollutants and Health\",\n            \"authors\": [\n                \"Carter, E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/indoor_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected from a limited number of buildings.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68596", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Latitude, Longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Major US Cities\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes hourly measurements from 50 monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68596", "text": "{\n    \"dataset_name\": \"Remote Sensing Vegetation Health Data\",\n    \"creator\": {\n        \"name\": \"Global Land Cover Consortium\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NDVI\",\n            \"units\": \"Dimensionless\"\n        },\n        {\n            \"name\": \"EVI\",\n            \"units\": \"Dimensionless\"\n        },\n        {\n            \"name\": \"Land Cover Type\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Vegetation Patterns\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/vegetation_health.tif\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data represents vegetation health indices over a global scale.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68597", "text": "{\n    \"dataset_name\": \"Global Forest Ecosystem Dynamics Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m2/m2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote Sensing and Ground Measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ecosystem Health Assessment Using Remote Sensing Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15GB\",\n        \"annotations\": \"Data includes quality control flags and metadata on sensor calibration.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68597", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m3\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous Monitoring Stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://citydata.org/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes hourly averages from monitoring stations.\"\n    }\n}"}
