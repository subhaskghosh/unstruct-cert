{"_id": "Academic--research_data--p--69328", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2020-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal (Public Domain)\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains land and ocean temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69328", "text": "{\n    \"dataset_name\": \"Historical Climate Reconstruction 1880-2019\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Annual Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Reconstructed data based on historical records\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Reconstruction of Global Climate\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/data-access/paleo-climate-data\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Provides a long-term perspective on climate variability.\"\n    }\n}"}
