{"_id": "Academic--research_data--p--66616", "text": "{\n    \"dataset_name\": \"Human Brain Activity during Cognitive Tasks\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"EEG_Channel_1\",\n            \"units\": \"uV\"\n        },\n        {\n            \"name\": \"Reaction_Time\",\n            \"units\": \"ms\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"fMRI and EEG recordings during a series of cognitive tasks.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Neural Correlates of Attention\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/neuroscience_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes annotations for task type and subject demographics.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66616", "text": "{\n    \"dataset_name\": \"Mouse Behavior in Maze\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2023-03-10T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Maze_Completion_Time\",\n            \"units\": \"seconds\"\n        },\n        {\n            \"name\": \"Correct_Turns\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Video tracking of mice navigating a complex maze.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial Learning in Rodents\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/mouse_maze_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data contains tracking data and maze configurations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66617", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI_Image\",\n            \"units\": \"DICOM format\"\n        },\n        {\n            \"name\": \"Tumor_Grade\",\n            \"units\": \"I-IV\"\n        },\n        {\n            \"name\": \"Patient_Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI-based tumor grading using deep learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/braintumor_mri\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Manual segmentations by radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--66617", "text": "{\n    \"dataset_name\": \"Chest X-ray Pneumonia Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"X-ray_Image\",\n            \"units\": \"JPEG format\"\n        },\n        {\n            \"name\": \"Pneumonia_Diagnosis\",\n            \"units\": \"Positive/Negative\"\n        },\n        {\n            \"name\": \"Patient_ID\",\n            \"units\": \"unique identifier\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective case-control study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep learning for pneumonia detection in chest X-rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chestxray_pneumonia\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Radiologist verified diagnoses\"\n    }\n}"}
{"_id": "Academic--research_data--p--66618", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Monthly averages\"\n    }\n}"}
