{"_id": "Academic--research_data--p--70640", "text": "{\n    \"dataset_name\": \"LongTermEcoMonitoring_LakeSuperior\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Minnesota, Department of Ecology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"WaterTemperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"AlgaeDensity\",\n            \"units\": \"cells/mL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors deployed at multiple depths, with monthly manual sample collection for validation.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in Lake Superior water quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemini_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality-controlled and flagged for anomalies.\"\n    }\n}"}
