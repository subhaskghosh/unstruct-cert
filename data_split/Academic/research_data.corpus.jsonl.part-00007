{"_id": "Academic--research_data--p--68544", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global network of weather stations and buoys, continuous measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-temperature-report/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68544", "text": "{\n    \"dataset_name\": \"Urban Bee Pollen Analysis\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Pollen Type\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Pollen Count\",\n            \"units\": \"Pollen Grains/cm^2\"\n        },\n        {\n            \"name\": \"Location Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Location Longitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Bee Species\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Floral Scent Intensity\",\n            \"units\": \"Arbitrary Units\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Pollen traps placed in 10 urban gardens, sampled weekly for one season.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Bee Foraging Patterns\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_bee_pollen.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes species identification notes.\"\n    }\n}"}
