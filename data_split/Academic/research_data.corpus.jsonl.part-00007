{"_id": "Academic--research_data--p--67216", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67216", "text": "{\n    \"dataset_name\": \"Botanical Survey of National Parks\",\n    \"creator\": {\n        \"name\": \"National Park Service\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Plant species identified\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Latitude of observation\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Longitude of observation\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Random transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Flora of the National Parks\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/botanical_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geographic coordinates provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--67217", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global Weather Stations Network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes daily averages and anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67217", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Wheat Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"variable_name\": \"Rice Yield\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Agricultural Surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Security\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes annual crop production by country.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67218", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"unit\": \"ug/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Weekly water samples collected from various depths in Lake Mendota.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality of Lake Mendota\",\n            \"authors\": [\n                \"Doe, J.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67218", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"GLA\"\n    },\n    \"date_collected\": \"2023-05-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Government License\",\n    \"sampling_method\": \"Continuous monitoring stations throughout London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Trends in London\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Wilson, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"1.8MB\",\n        \"annotations\": \"Real-time data feed.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67219", "text": "{\n    \"dataset_name\": \"Air Quality Data - Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data is quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67219", "text": "{\n    \"dataset_name\": \"Forest Birdsong Recordings\",\n    \"creator\": {\n        \"name\": \"Avian Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Recording Duration\",\n            \"units\": \"seconds\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Automated recording devices\",\n    \"related_publications\": [\n        {\n            \"title\": \"Birdsong Diversity in Redwood Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/birdsong_recordings.zip\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Recordings include species identification.\"\n    }\n}"}
