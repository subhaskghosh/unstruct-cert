{"_id": "Academic--research_data--p--66048", "text": "{\n    \"dataset_name\": \"Lung Image Database Consortium image collection\",\n    \"creator\": {\n        \"name\": \"National Lung Screening Trial Research Team\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"name\": \"Image Modality\",\n            \"unit\": \"CT, X-Ray\"\n        },\n        {\n            \"name\": \"Nodule Diameter\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective screening of high-risk individuals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Results of the National Lung Screening Trial\",\n            \"year\": 2011\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_images\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Radiologist-verified nodule locations\"\n    }\n}"}
{"_id": "Academic--research_data--n--66048", "text": "{\n    \"dataset_name\": \"Cardiovascular MRI Dataset\",\n    \"creator\": {\n        \"name\": \"University Cardiology Research Group\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2023-08-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient ID\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"name\": \"Ejection Fraction\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Left Ventricle Volume\",\n            \"unit\": \"mL\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Retrospective analysis of patient records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Cardiac Function Assessment using MRI\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://example.com/cardio_mri\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Automated segmentation of cardiac structures\"\n    }\n}"}
{"_id": "Academic--research_data--p--66049", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Health\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Tumor Grade\",\n            \"units\": \"I-IV\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective cohort study with MRI scans from patients diagnosed with brain tumors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual segmentation by radiologists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66049", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"X-Ray Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"Category\"\n        },\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"unique identifier\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Pneumonia Detection using CNNs\",\n            \"authors\": \"Lee et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray\",\n    \"metadata\": {\n        \"data_size\": \"25GB\",\n        \"annotations\": \"Radiologist reports.\"\n    }\n}"}
