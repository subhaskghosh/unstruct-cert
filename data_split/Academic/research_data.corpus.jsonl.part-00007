{"_id": "Academic--research_data--n--71650", "text": "{\n    \"dataset_name\": \"Campus Greenhouse Gas Emissions\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\",\n            \"description\": \"Carbon Dioxide emissions\"\n        },\n        {\n            \"name\": \"CH4\",\n            \"units\": \"ppb\",\n            \"description\": \"Methane emissions\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Greenhouse Gas Emissions on University Campuses\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://berkeley.edu/emissionsdata\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Preliminary data; requires further processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71651", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Temperatures\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_precip.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Quality controlled and gap-filled data\"\n    }\n}"}
{"_id": "Academic--research_data--n--71651", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2019-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Agricultural surveys and reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Security\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Yield data from various countries\"\n    }\n}"}
{"_id": "Academic--research_data--p--71652", "text": "{\n    \"dataset_name\": \"Social Media Interaction Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"post_text\",\n            \"unit\": \"text\"\n        },\n        {\n            \"name\": \"interaction_count\",\n            \"unit\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling of public posts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Social Media Engagement\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Basic sentiment analysis scores provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71652", "text": "{\n    \"dataset_name\": \"MRI Brain Scan Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"scan_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"voxel_intensity\",\n            \"unit\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"brain_region\",\n            \"unit\": \"anatomical label\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Research Use Only\",\n    \"sampling_method\": \"Patient cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Neurological Imaging Analysis\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_scan_data.nii.gz\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Detailed anatomical labeling.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71653", "text": "{\n    \"dataset_name\": \"Coastal Erosion Monitoring Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Oceanography\"\n    },\n    \"date_collected\": \"2022-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"ErosionRate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"variable_name\": \"BeachSlope\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"TidalRange\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular transect surveys with high-precision GPS and LiDAR data collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Accelerated Coastal Erosion in the Pacific Northwest\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Impact of Sea Level Rise on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.edu/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags and metadata on data collection procedures.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71653", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 1880-2015\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2015-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"TemperatureAnomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global surface temperature measurements from meteorological stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2016\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data includes uncertainties and methodology documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71654", "text": "{\n    \"dataset_name\": \"Regional Climate Impact Assessment - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"University of Washington Climate Impacts Group\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Daily Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Snowpack Depth\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Daily observation from regional weather stations and modeled data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Impacts on Water Resources in the Pacific Northwest\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/pnw_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71654", "text": "{\n    \"dataset_name\": \"Global Temperature Trends - Historical Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Global Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite observations and ground-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Global Temperature Analysis\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data is averaged globally and may not reflect regional variations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71655", "text": "{\n    \"dataset_name\": \"Urban Temperature Monitoring - NYC\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Columbia University\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"location\",\n            \"units\": \"GPS coordinates\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Continuous monitoring using sensor network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effect in New York City\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/nyc_temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71655", "text": "{\n    \"dataset_name\": \"Forest Birdsong Recordings - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Javier Rodriguez\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"birdsong_frequency\",\n            \"units\": \"Hz\"\n        },\n        {\n            \"name\": \"species\",\n            \"units\": \"Common Name\"\n        },\n        {\n            \"name\": \"location\",\n            \"units\": \"GPS coordinates\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Passive acoustic monitoring\",\n    \"related_publications\": [\n        {\n            \"title\": \"Birdsong Diversity in the Amazon Rainforest\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_birdsong.zip\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Species identification based on automated analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71656", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Civil, Environmental and Geomatic Engineering\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic Density on Air Quality in London\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
