{"_id": "Academic--research_data--p--69178", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Health\"\n    },\n    \"date_collected\": \"2023-06-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image_ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"MRI_Signal_Intensity\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"Tumor_Size\",\n            \"units\": \"mm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective cohort study with MRI scans from patients diagnosed with brain tumors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/braintumor_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"6500\",\n        \"annotations\": \"Expert radiologist annotations for tumor boundaries.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69178", "text": "{\n    \"dataset_name\": \"Chest X-ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient_ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"X-ray_Intensity\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"Lung_Opacity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective analysis of chest X-rays from patients with respiratory illnesses.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Detection of Pneumonia in Chest X-rays\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray.zip\",\n    \"metadata\": {\n        \"data_size\": \"4800\",\n        \"annotations\": \"Radiologist reports indicating presence or absence of pneumonia.\"\n    }\n}"}
