{"_id": "Academic--research_data--n--68933", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Health Data\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Private Research Foundation\"\n    },\n    \"date_collected\": \"2023-10-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Opportunistic sampling during research cruises\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Health Trends\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://www.oceaninstitute.org/data\",\n    \"metadata\": {\n        \"data_size\": \"1.8 GB\",\n        \"annotations\": \"Preliminary data, subject to revision.\"\n    }\n}"}
