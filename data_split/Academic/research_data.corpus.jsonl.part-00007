{"_id": "Academic--research_data--n--70434", "text": "{\n    \"dataset_name\": \"Citizen Science Bird Observations - North America\",\n    \"creator\": {\n        \"name\": \"eBird\",\n        \"affiliation\": \"Cornell Lab of Ornithology\"\n    },\n    \"date_collected\": \"2023-03-10T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Crowdsourced observations reported by birdwatchers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Distribution of migratory bird species\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ebird_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Observation timestamps and reporter IDs included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70435", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (COVID-19)\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"COVID-19 Status\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"COVID-19 X-ray Dataset\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://nihcc.nih.gov/covid-xray-dataset\",\n    \"metadata\": {\n        \"data_size\": \"420MB\",\n        \"annotations\": \"Image-level labels for COVID-19 status\"\n    }\n}"}
{"_id": "Academic--research_data--n--70435", "text": "{\n    \"dataset_name\": \"Large-Scale Genomic Dataset\",\n    \"creator\": {\n        \"name\": \"Broad Institute\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Gene Expression\",\n            \"units\": \"RPKM\"\n        },\n        {\n            \"name\": \"Mutation Status\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"VCF\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Whole-genome sequencing of patient samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Genomic Variations in Cancer\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.broadinstitute.org/genome-data\",\n    \"metadata\": {\n        \"data_size\": \"2TB\",\n        \"annotations\": \"Detailed genomic annotations\"\n    }\n}"}
{"_id": "Academic--research_data--p--70436", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network - Daily\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"NCEI\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Maximum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"GHCN Daily Documentation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/access/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70436", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"NSIDC\"\n    },\n    \"date_collected\": \"2018-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Trends\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice/extent\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Derived from satellite images\"\n    }\n}"}
{"_id": "Academic--research_data--p--70437", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Data - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data quality flagged for sensor malfunctions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70437", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Forest Service\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"Number of Individuals\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in National Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70438", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"tree_density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"water_quality_index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Stratified random sampling across 100 plots within the rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Contains species identification and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70438", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Municipal Government\"\n    },\n    \"date_collected\": \"2023-03-10T09:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pm25\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring from fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Trends in Urban Areas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Hourly measurements from air quality monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70439", "text": "{\n    \"dataset_name\": \"LongTermEcologyData_USA\",\n    \"creator\": {\n        \"name\": \"National Ecological Observatory Network (NEON)\",\n        \"affiliation\": \"Battelle Memorial Institute\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"air_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"soil_moisture\",\n            \"units\": \"percent\"\n        },\n        {\n            \"variable_name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"NEON data products for ecological forecasting\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.neonscience.org/data-access\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Contains data from 20 ecological sites across the USA.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70439", "text": "{\n    \"dataset_name\": \"UrbanAirQuality_Europe\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2023-06-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"pm25\",\n            \"units\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Daily measurements from monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.eea.europa.eu/data-and-maps\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data on air quality in major European cities.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70440", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"World Air Quality Index (WAQI)\",\n        \"affiliation\": \"WAQI Corp.\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM25\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Crowdsourced sensor network with quality control\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Assessment of Air Pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://waqi.info/feed/download/data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes hourly averages from over 10,000 stations globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70440", "text": "{\n    \"dataset_name\": \"Local Pond Water Quality\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2022-12-20T12:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual sample collection from a single pond\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pond Ecosystem Health\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.edu/pond_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data from a small, local pond. Limited geographical scope.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70441", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global historical temperature data from weather stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Impacts of Climate Change on Global Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly temperature anomalies from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70441", "text": "{\n    \"dataset_name\": \"Climate Model Output - Scenario A2\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Prediction\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Output from a complex climate model simulation.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Projections under Scenario A2\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_a2.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Model output based on a specific emissions scenario. Primarily theoretical.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70442", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Atmospheric Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains data from various monitoring stations around the globe. Focus is on long-term climate trends and anomaly detection.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70442", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa State University Agricultural Department\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Soybean Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Fertilizer Application\",\n            \"units\": \"lbs/acre\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"County-level agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Fertilizer on Crop Yield\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/iowa_crops.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Detailed records of crop yields and agricultural practices in Iowa.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70443", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-02-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers or less in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen dioxide concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in London 2023 Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality checked and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70443", "text": "{\n    \"dataset_name\": \"MarineBiodiversity_CoralReefs\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Marine Research Division\"\n    },\n    \"date_collected\": \"2023-03-10T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CoralCoverage\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of seafloor covered by coral\"\n        },\n        {\n            \"name\": \"FishDensity\",\n            \"units\": \"individuals/m²\",\n            \"description\": \"Density of fish species observed\"\n        },\n        {\n            \"name\": \"WaterTemperature\",\n            \"units\": \"°C\",\n            \"description\": \"Water temperature at reef site\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys and transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Ecosystem Health\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes species identification codes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70444", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_Urban\",\n    \"creator\": {\n        \"name\": \"Environmental Sciences Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_urban.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected from 10 monitoring stations across the city.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70444", "text": "{\n    \"dataset_name\": \"OceanCurrents_Pacific\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Scripps Institution of Oceanography\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CurrentSpeed\",\n            \"unit\": \"m/s\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Research vessel surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Current Dynamics\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.json\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data collected during a six-month research expedition.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70445", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of meteorological stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Surface Temperature Analysis\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70445", "text": "{\n    \"dataset_name\": \"Climate Model Output - CMIP6\",\n    \"creator\": {\n        \"name\": \"CMIP6 Consortium\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Projection\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Model Documentation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"2TB\",\n        \"annotations\": \"Output from various climate models under different scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70446", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Includes data quality flags and station locations.\",\n        \"data_dictionary_url\": \"https://data.london.gov.uk/airquality_dictionary.pdf\"\n    }\n}"}
{"_id": "Academic--research_data--n--70446", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Research Institute\",\n        \"affiliation\": \"Department of Ecology\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Random plot sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon Rainforest\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://amazondata.org/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Includes geographic coordinates of sampling plots.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70447", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Impacts on Global Precipitation Patterns\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70447", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Tweet ID\",\n            \"units\": \"Unique Identifier\"\n        },\n        {\n            \"name\": \"User ID\",\n            \"units\": \"Unique Identifier\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Twitter API data stream\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Current Events\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_sentiment.csv\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data includes sentiment labels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70448", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-10-27T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70448", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"Global Historical Climatology Network\",\n        \"affiliation\": \"National Centers for Environmental Information (NCEI)\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Temperature Variations\",\n            \"year\": 2019,\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Missing data handling notes\"\n    }\n}"}
{"_id": "Academic--research_data--p--70449", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags and station location information.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70449", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"Data Science Lab\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Tweet ID\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Twitter API stream\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Opinion on Climate Change\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data contains anonymized tweet text.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70450", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric CO2 Trends and Climate Impact\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70450", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Corn Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Soybean Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"name\": \"Fertilizer Usage\",\n            \"units\": \"lbs/acre\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Annual surveys of farms in Iowa\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Fertilizer on Crop Production\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data cleaned and validated by agricultural experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70451", "text": "{\n    \"dataset_name\": \"Lake Michigan Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at designated locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing Water Quality Trends in Lake Michigan\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemichigan_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70451", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Areas\",\n    \"creator\": {\n        \"name\": \"City Planning Department\",\n        \"affiliation\": \"New York City\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Continuous monitoring stations throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Wilson, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urbanairquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes missing value imputation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70452", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is quality-controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70452", "text": "{\n    \"dataset_name\": \"Forest Biodiversity - Amazon\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"Biodiversity Department\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Forest Dynamics\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Species identification based on visual observation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70453", "text": "{\n    \"dataset_name\": \"National Ecological Observatory Network (NEON) Data\",\n    \"creator\": {\n        \"name\": \"NEON Inc.\",\n        \"affiliation\": \"National Science Foundation\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m2/m2\"\n        },\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensor networks and field measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"NEON data products for ecosystem monitoring\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.neonscience.org/data\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Contains data on plant life, soil, and atmospheric conditions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70453", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Municipal Government\"\n    },\n    \"date_collected\": \"2022-12-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m3\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in urban air pollution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://cityairdata.gov\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Measurements of air pollutants in a major city.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70454", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley - Environmental Science Department\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"authors\": \"Carter, E., et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and validated against EPA standards.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70454", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - 2022-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"State Forestry Department\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots surveyed annually\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Forest Health\",\n            \"authors\": \"Davis, R.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Limited documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70455", "text": "{\n    \"dataset_name\": \"Global Forest Change Data 2021-2023\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote Sensing - Landsat Imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen et al.\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/glad/gee_v1_4\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Global tree cover loss data\"\n    }\n}"}
{"_id": "Academic--research_data--n--70455", "text": "{\n    \"dataset_name\": \"Historical Temperature Records - 1950-2000\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2000-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature trends\",\n            \"authors\": [\n                \"Hansen et al.\"\n            ],\n            \"year\": 1988\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Global surface temperature data\"\n    }\n}"}
