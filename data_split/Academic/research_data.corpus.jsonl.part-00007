{"_id": "Academic--research_data--p--68622", "text": "{\n    \"dataset_name\": \"US Water Quality Data\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Regular monitoring of rivers and lakes nationwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68622", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"UMD\"\n    },\n    \"date_collected\": \"2019-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Forest Loss\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Watch\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.example.com/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data derived from Landsat satellite imagery.\"\n    }\n}"}
