{"_id": "Academic--research_data--p--69265", "text": "{\n    \"dataset_name\": \"Lung Nodule Malignancy Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Data Consortium\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image File Path\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Nodule Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Malignancy Score\",\n            \"units\": \"0-1\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective study from hospital archives\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Lung Nodule Classification\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_nodule_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Radiologist-verified malignancy scores\"\n    }\n}"}
