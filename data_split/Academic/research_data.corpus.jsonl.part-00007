{"_id": "Academic--research_data--p--66835", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Monthly temperature anomalies from 1880 to present\"\n    }\n}"}
{"_id": "Academic--research_data--n--66835", "text": "{\n    \"dataset_name\": \"Stanford Dogs Dataset\",\n    \"creator\": {\n        \"name\": \"Stanford Computer Vision Lab\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"name\": \"Breed\",\n            \"unit\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"JPG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Web scraping and manual labeling\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Hierarchical Approach to Dog Breed Classification\",\n            \"authors\": [\n                \"Khullar, P.\",\n                \"Dutta, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"http://vision.stanford.edu/aditya86/ImageNetDogs/\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Images of 120 dog breeds\"\n    }\n}"}
{"_id": "Academic--research_data--p--66836", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global grid of temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--66836", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Weather stations across the United States\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Daily weather recordings\"\n    }\n}"}
{"_id": "Academic--research_data--p--66837", "text": "{\n    \"dataset_name\": \"Global Temperature Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"description\": \"Air temperature measured at 2 meters above ground.\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"description\": \"Relative humidity.\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Daily averages from weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Change\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temperature.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
