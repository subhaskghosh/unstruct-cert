{"_id": "Academic--research_data--p--70826", "text": "{\n    \"dataset_name\": \"Long-Term Forest Health Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"leaf_area_index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"soil_moisture\",\n            \"units\": \"percent\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Impacts of Climate Change on Forest Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes annual measurements of forest health indicators.\"\n    }\n}"}
