{"_id": "Academic--research_data--n--71049", "text": "{\n    \"dataset_name\": \"University Lake Study Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"State University Research Lab\"\n    },\n    \"date_collected\": \"2022-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Phosphate\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Weekly samples collected from a local lake\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Algal Blooms on Lake Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.com/lake_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8KB\",\n        \"annotations\": \"Raw sensor data with minimal processing\"\n    }\n}"}
{"_id": "Academic--research_data--p--71050", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Civil, Environmental and Geomatic Engineering\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations with hourly readings, following established EPA protocols.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic Density on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data quality flags included for sensor calibration and maintenance events.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71050", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Opportunistic sampling along river transects.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Basin\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Geographic coordinates included for each sampling location.\"\n    }\n}"}
