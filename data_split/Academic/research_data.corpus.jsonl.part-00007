{"_id": "Academic--research_data--p--71254", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"National Institute of Hydrology\",\n        \"affiliation\": \"Government Research Institute\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
