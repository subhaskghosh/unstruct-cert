{"_id": "Academic--research_data--n--71121", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"FAO Data License\",\n    \"sampling_method\": \"Remote sensing data from satellite imagery.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Estimates of Forest Biomass\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"700MB\",\n        \"annotations\": \"Data derived from Landsat and Sentinel-2 imagery.\"\n    }\n}"}
