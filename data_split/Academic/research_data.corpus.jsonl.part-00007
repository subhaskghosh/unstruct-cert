{"_id": "Academic--research_data--n--71292", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"US Department of Agriculture\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"tree_density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"soil_moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected during annual survey\"\n    }\n}"}
{"_id": "Academic--research_data--p--71293", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Dataset (GLST)\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite Remote Sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Land Surface Temperature\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/glst_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Quality flags included for each data point. Comprehensive documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71293", "text": "{\n    \"dataset_name\": \"North Atlantic Ocean Temperature and Salinity\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"WHOI\"\n    },\n    \"date_collected\": \"2022-05-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research Vessel Measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Heat Content Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality assessment included. User manual available.\"\n    }\n}"}
