{"_id": "Academic--research_data--p--68162", "text": "{\n    \"dataset_name\": \"Global Lake Water Quality Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Automated sensor deployments and manual water sample collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in lake water quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data has been quality controlled and outliers removed.\"\n    }\n}"}
