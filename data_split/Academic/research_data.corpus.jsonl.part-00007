{"_id": "Academic--research_data--p--70899", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Sea Ice Concentration\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"Cloud Cover\",\n            \"units\": \"percent\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global warming in the 21st century: An imperative for climate action\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Contains quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70899", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns\",\n    \"creator\": {\n        \"name\": \"Alice Smith\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Location ID\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Rain gauges in a specific county\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall variability in California\",\n            \"authors\": [\n                \"Alice Smith\",\n                \"Bob Johnson\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100 MB\",\n        \"annotations\": \"Data includes missing values for some locations.\"\n    }\n}"}
