{"_id": "Academic--research_data--n--69769", "text": "{\n    \"dataset_name\": \"Ocean Acidification Monitoring\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0 International\",\n    \"sampling_method\": \"Discrete water samples collected during research cruises.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Ocean Acidification\",\n            \"authors\": [\n                \"Feely, R.A.\",\n                \"Alin, S.R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_acidification.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data collected from the Pacific Ocean.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69770", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global meteorological stations and sea surface measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Contains monthly temperature data from 1880 to present.\"\n    }\n}"}
