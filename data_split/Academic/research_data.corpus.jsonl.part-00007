{"_id": "Academic--research_data--p--70712", "text": "{\n    \"dataset_name\": \"Long-Term Forest Plot Data - Harvard Forest\",\n    \"creator\": {\n        \"name\": \"Harvard Forest\",\n        \"affiliation\": \"Harvard University\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"tree_height\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"species\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Periodic forest plot measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term ecological change in Harvard Forest\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://harvardforest.fas.harvard.edu/data/long-term-forest-plot-data\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes tree measurements over 30 years.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70712", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Government of London\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"nitrogen_dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"particulate_matter_2_5\",\n            \"units\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in London 2023\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://londonair.org.uk/data\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Real-time air quality data from London monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70713", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 1990-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global temperature readings from weather stations and satellites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Global Temperature\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70713", "text": "{\n    \"dataset_name\": \"Economic Indicators of European Countries\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Federal Reserve Bank of New York\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"GDP\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"Inflation Rate\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Quarterly data collected from national statistical agencies.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Economic Growth in Europe\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/european_economy.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data is seasonally adjusted.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70714", "text": "{\n    \"dataset_name\": \"US River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated sensors deployed in rivers across the US\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/river-water-quality\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Detailed sensor calibration logs and data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70714", "text": "{\n    \"dataset_name\": \"European Air Quality Data\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"European Union\"\n    },\n    \"date_collected\": \"2023-05-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA\",\n    \"sampling_method\": \"Air quality monitoring stations throughout Europe\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe 2022\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.eea.europa.eu/data-and-maps/data/air-quality-eea\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Basic station location data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70715", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GST)\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Uncertainty\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Time\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70715", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa State University Department of Agronomy\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Location ID\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Data collected from automated weather stations across Iowa.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://iowaweatherdata.org/rainfall\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Daily rainfall measurements for research purposes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70716", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sea Level\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Ice Sheet Mass Balance\",\n            \"units\": \"Gigatonnes\"\n        },\n        {\n            \"name\": \"Solar Irradiance\",\n            \"units\": \"W/m^2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite observations and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Climate Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains data from 1950-2023\"\n    }\n}"}
{"_id": "Academic--research_data--n--70716", "text": "{\n    \"dataset_name\": \"Local Weather Patterns\",\n    \"creator\": {\n        \"name\": \"University Student Project Group\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Manual weather station readings\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/local_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"10KB\",\n        \"annotations\": \"Data collected within a 5-mile radius\"\n    }\n}"}
{"_id": "Academic--research_data--p--70717", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70717", "text": "{\n    \"dataset_name\": \"Theoretical Atmospheric Model Outputs\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Potential Temperature\",\n            \"units\": \"K\"\n        },\n        {\n            \"name\": \"Wind Velocity\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Numerical simulation\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Novel Atmospheric Modeling Framework\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_model.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Output from a high-resolution atmospheric model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70718", "text": "{\n    \"dataset_name\": \"North American Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"species_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Opportunistic observation with standardized protocols\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in North American bird migration\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Detailed species identification and location information\"\n    }\n}"}
{"_id": "Academic--research_data--n--70718", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"canopy_cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Remote sensing and ground truth validation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing urban green space\",\n            \"authors\": [\n                \"Doe, J.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/tree_canopy.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Geospatial data of tree locations and canopy cover\"\n    }\n}"}
{"_id": "Academic--research_data--p--70719", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative for Climate Action\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data quality flags provided for each observation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70719", "text": "{\n    \"dataset_name\": \"Climate Model Output - CMIP6 Projections\",\n    \"creator\": {\n        \"name\": \"The CMIP6 Community\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Projection\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Complex climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Earth System Models and Climate Change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/cmip6_projections.nc\",\n    \"metadata\": {\n        \"data_size\": \"5.5GB\",\n        \"annotations\": \"Model simulation metadata included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70720", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Water pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Air Pollution (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Stratified Random Sampling across 100 plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in the Amazon Rainforest\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70720", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow Analysis\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Vehicle Count\",\n            \"units\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"Average Speed\",\n            \"units\": \"km/h\"\n        },\n        {\n            \"name\": \"Traffic Density\",\n            \"units\": \"vehicles/km\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring using traffic sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Traffic Patterns in Metropolitan Areas\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/traffic_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data cleaned and filtered for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70721", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Michigan Water Science Lab\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected bi-weekly from 10 established monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_wq_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes flags for QA/QC issues.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70721", "text": "{\n    \"dataset_name\": \"Atmospheric Pollutant Levels in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban air quality assessment\",\n            \"authors\": [\n                \"Davis, R.\",\n                \"Wilson, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data has been reviewed by city officials.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70722", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Climate Impacts\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Impacts of Climate Change on Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains data on global temperature anomalies and their effect on various ecosystems.  Focus is on identifying regions most affected by climate change.\",\n        \"description\": \"This dataset aims to quantify the impact of climate change on global ecosystems.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70722", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns in Europe\",\n    \"creator\": {\n        \"name\": \"Dr. Klaus Schmidt\",\n        \"affiliation\": \"Max Planck Institute for Meteorology\"\n    },\n    \"date_collected\": \"2018-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Network of European meteorological stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in European Weather\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/european_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Historical weather data for various locations in Europe.\",\n        \"description\": \"A comprehensive record of temperature and precipitation patterns across Europe.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70723", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnomalies\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"PrecipitationAnomalies\",\n            \"units\": \"Percentage of Average\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature and precipitation measurements from weather stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Report - December 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes monthly averages and annual summaries.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70723", "text": "{\n    \"dataset_name\": \"Historical Weather Data - 1980-2010\",\n    \"creator\": {\n        \"name\": \"World Meteorological Organization\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"DailyTemperature\",\n            \"units\": \"Degrees Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Non-Commercial License\",\n    \"sampling_method\": \"Daily weather recordings from various global weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of 20th Century Weather Patterns\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data is raw, unadjusted measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70724", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Dataset v4.0\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Land Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Report 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes uncertainty estimates\"\n    }\n}"}
{"_id": "Academic--research_data--n--70724", "text": "{\n    \"dataset_name\": \"North Pacific Ocean pH and Alkalinity\",\n    \"creator\": {\n        \"name\": \"NOAA Ocean Carbon Program\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2022-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"variable_name\": \"Total Alkalinity\",\n            \"units\": \"mmol/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based measurements, discrete samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification in the North Pacific\",\n            \"authors\": [\n                \"Lee, K.\",\n                \"Brown, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_ph_dataset.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70725", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature and Vegetation Index\",\n    \"creator\": {\n        \"name\": \"NASA Earth Observations\",\n        \"affiliation\": \"Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Normalized Difference Vegetation Index (NDVI)\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Temperature on Global Vegetation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/nasa_land_temp_ndvi.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70725", "text": "{\n    \"dataset_name\": \"Ocean Current Velocity Measurements\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Department of Physical Oceanography\"\n    },\n    \"date_collected\": \"2023-05-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Eastward Current Velocity\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Northward Current Velocity\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Buoy measurements, hourly data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Circulation Patterns in the Atlantic\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data calibrated and quality controlled\"\n    }\n}"}
{"_id": "Academic--research_data--p--70726", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Stock\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Stratified Random Sampling from Field Plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon sequestration in tropical forests\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data validated with remote sensing imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70726", "text": "{\n    \"dataset_name\": \"Climate Model Output - Temperature Projections\",\n    \"creator\": {\n        \"name\": \"Global Climate Modeling Consortium\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Time\",\n            \"unit\": \"years\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Model Grid Resolution\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model_output.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data generated from CMIP6 models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70727", "text": "{\n    \"dataset_name\": \"Global Plastic Pollution Dataset\",\n    \"creator\": {\n        \"name\": \"Ocean Conservancy\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"plastic_concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"location_latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"location_longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"environmental_impact_score\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling across major oceanic regions\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Global Burden of Plastic Pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/plastic_pollution_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality control flags and metadata about sampling procedures.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70727", "text": "{\n    \"dataset_name\": \"Local Bee Population Survey\",\n    \"creator\": {\n        \"name\": \"Amateur Beekeeping Club\",\n        \"affiliation\": \"Local Community Group\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"bee_count\",\n            \"units\": \"number of bees\"\n        },\n        {\n            \"name\": \"hive_location\",\n            \"units\": \"address\"\n        },\n        {\n            \"name\": \"flower_type\",\n            \"units\": \"species name\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Volunteer observations from backyard hives\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/bee_data.xlsx\",\n    \"metadata\": {\n        \"data_size\": \"500 KB\",\n        \"annotations\": \"Data collected by amateur beekeepers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70728", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--70728", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Assessment - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in forest ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Species identified using expert classification\"\n    }\n}"}
{"_id": "Academic--research_data--p--70729", "text": "{\n    \"dataset_name\": \"Global Forest Watch Climate Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"canopy_cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"carbon_stock\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis and ground-based surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Watch Annual Report 2022\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Comprehensive documentation provided, including data dictionary and methodology report.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70729", "text": "{\n    \"dataset_name\": \"Historical Weather Records - City A\",\n    \"creator\": {\n        \"name\": \"City A Meteorological Office\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [],\n    \"download_url\": \"http://citya.gov/weatherdata\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Limited documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70730", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Emissions\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-10-27T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface observations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in global temperatures\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes monthly averages from 1880 to 2023.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70730", "text": "{\n    \"dataset_name\": \"Historical Rainfall Patterns\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Earth and Planetary Science\"\n    },\n    \"date_collected\": \"2019-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Regional weather station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of Rainfall Variability in California\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from 1900 to 2018.\"\n    }\n}"}
