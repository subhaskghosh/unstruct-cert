{"_id": "Academic--research_data--n--68211", "text": "{\n    \"dataset_name\": \"Local Pond Water Samples\",\n    \"creator\": {\n        \"name\": \"Community Science Group\",\n        \"affiliation\": \"Local High School\"\n    },\n    \"date_collected\": \"2023-08-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        },\n        {\n            \"name\": \"Water Clarity\",\n            \"unit\": \"qualitative\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual collection of water samples by students.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://communityscience.org/ponddata\",\n    \"metadata\": {\n        \"data_size\": \"100 KB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68212", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"dissolved_oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly discrete samples collected from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68212", "text": "{\n    \"dataset_name\": \"National Air Quality Monitoring Network Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-10-27T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"particulate_matter_2.5\",\n            \"units\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in US Air Quality\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data is hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68213", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements - Global Network\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across the globe\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2023\",\n            \"authors\": [\n                \"Friedlingstein et al.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included for each measurement. Calibration information available in separate documentation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68213", "text": "{\n    \"dataset_name\": \"Ocean Temperature Readings - Coastal Regions\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Institute\",\n        \"affiliation\": \"Private Research Firm\"\n    },\n    \"date_collected\": \"2022-07-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ship-based measurements at discrete locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Ocean Dynamics\",\n            \"authors\": [\n                \"Smith et al.\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data was collected as part of a broader marine ecosystem study.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68214", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Science Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations distributed throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68214", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"Remote Sensing Institute\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Derived from Landsat and Sentinel-2 data.\"\n    }\n}"}
