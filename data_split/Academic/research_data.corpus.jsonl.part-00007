{"_id": "Academic--research_data--p--67716", "text": "{\n    \"dataset_name\": \"Cardiac MRI Dataset for Arrhythmia Detection\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image_ID\",\n            \"unit\": \"Unique Identifier\"\n        },\n        {\n            \"name\": \"Pixel_Spacing\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Heart_Rate\",\n            \"unit\": \"bpm\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective cohort study from cardiology patients\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Arrhythmia Detection using Cardiac MRI\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/cardiac_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual segmentation of cardiac chambers by expert radiologists\"\n    }\n}"}
