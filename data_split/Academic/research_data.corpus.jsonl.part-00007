{"_id": "Academic--research_data--n--67930", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Dataset\",\n        \"affiliation\": \"ECAD\"\n    },\n    \"date_collected\": \"2018-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution\",\n    \"sampling_method\": \"Daily observations from weather stations across Europe\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Variability\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.ecad.eu/dataset/europe-daily-temperatures\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Historical weather observations\"\n    }\n}"}
{"_id": "Academic--research_data--p--67931", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"University of Leeds\",\n        \"affiliation\": \"School of Geography\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"variable_name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Ground-based measurements and national forest inventories\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global maps of forest biomass and carbon stocks\",\n            \"authors\": [\n                \"Crowther et al.\"\n            ],\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Dataset validated with multiple independent sources.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67931", "text": "{\n    \"dataset_name\": \"Landsat 8 Surface Reflectance\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"Earth Resources Coordination Office\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Blue Band\",\n            \"units\": \"reflectance\"\n        },\n        {\n            \"variable_name\": \"Green Band\",\n            \"units\": \"reflectance\"\n        },\n        {\n            \"variable_name\": \"Red Band\",\n            \"units\": \"reflectance\"\n        }\n    ],\n    \"data_format\": \"TIFF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite imagery acquisition\",\n    \"related_publications\": [\n        {\n            \"title\": \"Landsat Data Users Handbook\",\n            \"authors\": [\n                \"USGS\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/landsat8.tif\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Dataset contains cloud-masked reflectance values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67932", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, King's College London\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter 2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Exposure and Respiratory Health in Urban Populations\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67932", "text": "{\n    \"dataset_name\": \"Oceanographic Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Currents and Marine Ecosystems\",\n            \"authors\": [\n                \"Brown, C.\",\n                \"Davis, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data collected during a research expedition.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67933", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality-controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67933", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Biodiversity\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\",\n            \"description\": \"Number of identified species.\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\",\n            \"description\": \"Water depth.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health Assessment\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/marinebiodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species identifications were verified by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67934", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute of California\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Automated buoy deployments with weekly sample collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Nutrient Runoff on Coastal Ecosystems\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67934", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Continuous monitoring stations throughout major cities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Correlation between Air Pollution and Respiratory Illness\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been pre-processed for statistical analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67935", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery (GLAD)\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percent\",\n            \"description\": \"Percentage of tree cover in the year 2000.\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\",\n            \"description\": \"Year of forest loss.\"\n        },\n        {\n            \"name\": \"gain\",\n            \"unit\": \"ha\",\n            \"description\": \"Area of forest gain in hectares.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing using Landsat data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen, M. C.\",\n                \"Potapov, P. V.\",\n                \"Moore, R.\",\n                \"Hancher, M.\",\n                \"Turdukulov, A. A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"20 GB\",\n        \"annotations\": \"Contains data on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67935", "text": "{\n    \"dataset_name\": \"City Power Consumption Data\",\n    \"creator\": {\n        \"name\": \"National Grid\",\n        \"affiliation\": \"Energy Research Institute\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"power_usage\",\n            \"unit\": \"kW\",\n            \"description\": \"Electrical power consumption in kilowatts.\"\n        },\n        {\n            \"name\": \"timestamp\",\n            \"unit\": \"datetime\",\n            \"description\": \"Timestamp of power usage measurement.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Real-time power meter readings\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/powerdata\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data related to city power grid usage.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67936", "text": "{\n    \"dataset_name\": \"SoilNutrientLevels_US\",\n    \"creator\": {\n        \"name\": \"USDA National Cooperative Soil Survey\",\n        \"affiliation\": \"United States Department of Agriculture\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Potassium\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grid sampling across agricultural lands\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Nutrient Status in US Agricultural Regions\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_nutrients_us.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and quality-controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67936", "text": "{\n    \"dataset_name\": \"MarineBiodiversity_Pacific\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of Hawaii\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SpeciesAbundance\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"WaterTemperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random sampling using research vessels\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Marine Biodiversity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_pacific.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data from underwater sensors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67937", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Automated buoy with depth sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_mendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67937", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Environmental Monitoring Center\",\n        \"affiliation\": \"BMEPC\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality trends in Beijing\",\n            \"authors\": [\n                \"Li\",\n                \"Wang\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--p--67938", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global network of weather stations and satellite measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A Comprehensive Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--67938", "text": "{\n    \"dataset_name\": \"Climate Model Simulations\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"NCAR\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"Pascals\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Numerical simulations of climate models\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Projections\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://ncarsimulations.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Simulated climate data\"\n    }\n}"}
{"_id": "Academic--research_data--p--67939", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GSAT)\",\n    \"creator\": {\n        \"name\": \"Hadley Centre for Climate Prediction and Research\",\n        \"affiliation\": \"UK Met Office\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and sea-based instruments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature trends: Recent observations and projections\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/gsat_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes quality control flags\"\n    }\n}"}
{"_id": "Academic--research_data--n--67939", "text": "{\n    \"dataset_name\": \"Projected Climate Change Scenarios\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"UCAR\"\n    },\n    \"date_collected\": \"2023-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature_projection\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation_projection\",\n            \"units\": \"mm/year\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations (CMIP6)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future climate scenarios under different emission pathways\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_projections.nc\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Model output with various representative concentration pathways (RCPs)\"\n    }\n}"}
{"_id": "Academic--research_data--p--67940", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Earth Exchange\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite Remote Sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping global forest biomass with radar and optical data\",\n            \"authors\": [\n                \"A. Comont\",\n                \"B. Laurance\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Dataset provides global coverage, focusing on terrestrial ecosystems. Used in many climate impact studies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67940", "text": "{\n    \"dataset_name\": \"North Pacific Ocean Salinity\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-Based Measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity Changes and Global Climate\",\n            \"authors\": [\n                \"S. Wijffels\",\n                \"T. Durrant\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity.nc\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"High-resolution salinity measurements in the North Pacific Ocean.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67941", "text": "{\n    \"dataset_name\": \"Urban Temperature Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Geography\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"air_pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring with calibrated sensors, data averaged hourly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effect in London\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, P.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_temperature.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flagged based on sensor calibration and outlier detection.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67941", "text": "{\n    \"dataset_name\": \"Forest Birdsong Recordings - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"frequency\",\n            \"units\": \"Hz\"\n        },\n        {\n            \"name\": \"amplitude\",\n            \"units\": \"dB\"\n        },\n        {\n            \"name\": \"species\",\n            \"units\": \"\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Acoustic recordings using automated recorders.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bird Diversity in the Amazon Rainforest\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_birdsong.zip\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Species identification based on spectral analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67942", "text": "{\n    \"dataset_name\": \"Global Forest Watch Biomass Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"biomass\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"tree_height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"canopy_cover\",\n            \"unit\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global biomass distribution and the role of forest dynamics\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Provides high-resolution biomass estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67942", "text": "{\n    \"dataset_name\": \"Historical Weather Records - London\",\n    \"creator\": {\n        \"name\": \"UK Meteorological Office\",\n        \"affiliation\": \"Government Agency\"\n    },\n    \"date_collected\": \"2018-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"millimeters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Crown Copyright\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term climate trends in the United Kingdom\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.metoffice.gov.uk/data/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Daily weather recordings for London.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67943", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Evelyn Reed\",\n        \"affiliation\": \"University of Washington, School of Environmental and Forest Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in the Pacific Northwest\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes species identification confirmed by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67943", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling at fixed buoy locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Water Quality Assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data is quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67944", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"variable_name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
