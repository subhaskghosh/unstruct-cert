{"_id": "Academic--research_data--p--67403", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Average monthly surface temperature anomalies relative to the 1951-1980 baseline.\"\n        },\n        {\n            \"name\": \"Land Coverage\",\n            \"units\": \"percentage\",\n            \"description\": \"Percentage of land covered by vegetation.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Reduce Emissions\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67403", "text": "{\n    \"dataset_name\": \"High-Resolution Atmospheric Chemistry Model Output\",\n    \"creator\": {\n        \"name\": \"Sarah Thompson\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"OH Radical Concentration\",\n            \"units\": \"molecules/cm3\",\n            \"description\": \"Hydroxyl radical concentration, a key indicator of atmospheric oxidation capacity.\"\n        },\n        {\n            \"name\": \"Isoprene Emission Flux\",\n            \"units\": \"mg/m2/s\",\n            \"description\": \"Emission flux of isoprene, a biogenic volatile organic compound.\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Complex atmospheric chemistry model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Modeling Tropospheric Ozone Chemistry\",\n            \"authors\": [\n                \"Sarah Thompson\",\n                \"David Johnson\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.example.com/atmospheric_data\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data requires specialized software for processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67404", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Sea Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Ocean Heat Content\",\n            \"units\": \"Joules\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Warming Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67404", "text": "{\n    \"dataset_name\": \"Historical Weather Data - US Cities\",\n    \"creator\": {\n        \"name\": \"National Weather Service\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/us_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Includes daily weather summaries for major US cities.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67405", "text": "{\n    \"dataset_name\": \"Global Forest Biodiversity and Carbon Stock Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_density\",\n            \"unit\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"carbon_stock\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"species_richness\",\n            \"unit\": \"number of species\"\n        },\n        {\n            \"name\": \"ecosystem_type\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing and ground-based surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Patterns of Forest Biodiversity\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Includes data quality flags and metadata on survey locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67405", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow Dataset\",\n    \"creator\": {\n        \"name\": \"David Miller\",\n        \"affiliation\": \"City Transportation Authority\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"vehicle_count\",\n            \"unit\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"average_speed\",\n            \"unit\": \"km/hour\"\n        },\n        {\n            \"name\": \"road_segment_id\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Automated traffic sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Traffic Patterns in Metropolitan Areas\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/traffic_flow.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data cleaned and aggregated by 15-minute intervals.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67406", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
