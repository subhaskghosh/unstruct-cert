{"_id": "Academic--research_data--p--71229", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data has been quality controlled and gap-filled using interpolation techniques.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71229", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns - 2022\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2022-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Timestamp\",\n            \"units\": \"YYYY-MM-DD HH:mm:ss\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Academic Non-Commercial License\",\n    \"sampling_method\": \"Rain gauge measurements from a network of sensors in Northern California.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Hydrological Studies\",\n            \"authors\": [\n                \"Lee, K.\",\n                \"Brown, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is preliminary and subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71230", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network - Daily\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Daily observations from weather stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Homogeneity adjustments of monthly temperature series\",\n            \"authors\": [\n                \"Wang, X.\",\n                \"Wen, Y.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"High - Station quality control applied.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71230", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow - London\",\n    \"creator\": {\n        \"name\": \"Transport for London\",\n        \"affiliation\": \"Greater London Authority\"\n    },\n    \"date_collected\": \"2022-05-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Traffic Volume\",\n            \"units\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"Average Speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Government Licence\",\n    \"sampling_method\": \"Real-time traffic sensor data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predictive Modelling of Traffic Flow\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/dataset/traffic-flow\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Medium - basic validation checks.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71231", "text": "{\n    \"dataset_name\": \"Global Forest Watch Biomass Data\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery (GLAD)\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Carbon Stock\",\n            \"units\": \"tonnes C/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal (Public Domain Dedication)\",\n    \"sampling_method\": \"Satellite remote sensing (Landsat, Sentinel)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Biomass Mapping Using Remote Sensing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://gfw.umd.edu/data/\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Includes data on forest cover loss and gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71231", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"City of Los Angeles Environmental Monitoring Division\",\n        \"affiliation\": \"Los Angeles Department of Public Works\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Los Angeles\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.lacity.org/airqualitydata\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Real-time and historical air quality data.\"\n    }\n}"}
