{"_id": "Academic--research_data--n--70680", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"μg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Major Cities\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.xml\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data is subject to restrictions on commercial usage.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70681", "text": "{\n    \"dataset_name\": \"LongTermEcologyData_USA\",\n    \"creator\": {\n        \"name\": \"National Ecological Observatory Network (NEON)\",\n        \"affiliation\": \"Battelle\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"NEON Data Products\",\n            \"authors\": \"NEON Science Team\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.neonscience.org/data-access\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data collected from various field sites across the USA.\"\n    }\n}"}
