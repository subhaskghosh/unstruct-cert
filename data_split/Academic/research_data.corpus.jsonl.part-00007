{"_id": "Academic--research_data--n--67267", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images\",\n    \"creator\": {\n        \"name\": \"General Hospital Imaging Center\",\n        \"affiliation\": \"Local Hospital\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"X-Ray Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"ICD-10 code\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective chart review\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pneumonia Detection in Chest X-Rays\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Green, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray.xml\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Radiologist reports included\"\n    }\n}"}
{"_id": "Academic--research_data--p--67268", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"canopy_height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in the Amazon\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes species identification and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67268", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow Dataset\",\n    \"creator\": {\n        \"name\": \"City Planning Department\",\n        \"affiliation\": \"Metropolitan Government\"\n    },\n    \"date_collected\": \"2023-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"vehicle_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"average_speed\",\n            \"units\": \"km/h\"\n        },\n        {\n            \"name\": \"road_segment\",\n            \"units\": \"ID\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring of traffic sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Traffic Patterns in Metropolitan Areas\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/traffic_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes vehicle counts and speed measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67269", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies (2021-2023)\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Atmospheric Pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global surface observations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Report 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"High resolution data, quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67269", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements (2018-2022)\",\n    \"creator\": {\n        \"name\": \"NOAA Atlantic Oceanographic and Meteorological Laboratory\",\n        \"affiliation\": \"AOML\"\n    },\n    \"date_collected\": \"2022-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Buoy and ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atlantic Ocean Salinity Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity_2018_2022.nc\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data collected during research expedition.\"\n    }\n}"}
