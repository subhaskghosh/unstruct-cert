{"_id": "Academic--research_data--p--66981", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images - Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"National Institute of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"pneumonia_probability\",\n            \"units\": \"0-1\"\n        },\n        {\n            \"name\": \"image_file_path\",\n            \"units\": \"path to image file\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Retrospective collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Pneumonia Detection using Chest X-rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_pneumonia.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Bounding boxes for pneumonia regions\"\n    }\n}"}
