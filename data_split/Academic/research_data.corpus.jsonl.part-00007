{"_id": "Academic--research_data--n--66130", "text": "{\n    \"dataset_name\": \"Brain MRI Scans\",\n    \"creator\": {\n        \"name\": \"University of California, San Francisco\",\n        \"affiliation\": \"UCSF Radiology Department\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"scan_type\",\n            \"units\": \"MRI\"\n        },\n        {\n            \"name\": \"brain_region\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective study of healthy volunteers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Brain MRI Dataset\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"segmentation masks for brain structures\"\n    }\n}"}
{"_id": "Academic--research_data--p--66131", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Radiology Department, Stanford University\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"unit\": \"file path\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"unit\": \"binary (positive/negative)\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective collection from hospital archives\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xrays.zip\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Radiologist-verified labels\"\n    }\n}"}
{"_id": "Academic--research_data--n--66131", "text": "{\n    \"dataset_name\": \"MRI Brain Scans - Tumor Segmentation\",\n    \"creator\": {\n        \"name\": \"Neuroimaging Research Group, University of California, Berkeley\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"scan_type\",\n            \"unit\": \"T1-weighted, T2-weighted\"\n        },\n        {\n            \"name\": \"tumor_volume\",\n            \"unit\": \"cm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Prospective study with patient consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri.zip\",\n    \"metadata\": {\n        \"data_size\": \"5 GB\",\n        \"annotations\": \"Manual segmentations by neuro-radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--p--66132", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Satellite observations and ground stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains data from 1980 to 2023.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66132", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Past Weather Patterns\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected between 1900 and 2019.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66133", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66133", "text": "{\n    \"dataset_name\": \"Historical Climate Data of the Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute for Amazonian Research\"\n    },\n    \"date_collected\": \"2022-12-31T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Remote sensing and ground stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation and Climate Change in the Amazon\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been gap-filled using interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66134", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--66134", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Location ID\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily measurements at weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Rainfall Patterns\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from various weather stations.\"\n    }\n}"}
