{"_id": "Academic--research_data--p--66750", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (COVID-19)\",\n    \"creator\": {\n        \"name\": \"Massachusetts Institute of Technology\",\n        \"affiliation\": \"MIT-IBM Watson AI Lab\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"units\": \"file path\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"units\": \"COVID-19 / Normal / Pneumonia\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Development and Evaluation of a Deep Learning System for COVID-19 Detection\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_covid19.zip\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"bounding boxes for lung regions\"\n    }\n}"}
