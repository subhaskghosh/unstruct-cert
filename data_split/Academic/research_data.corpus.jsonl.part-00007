{"_id": "Academic--research_data--n--68665", "text": "{\n    \"dataset_name\": \"Synthetic Image Dataset for Object Detection\",\n    \"creator\": {\n        \"name\": \"Stanford AI Lab\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_path\",\n            \"units\": \"path\",\n            \"description\": \"Path to the image file.\"\n        },\n        {\n            \"variable_name\": \"bounding_boxes\",\n            \"units\": \"coordinates\",\n            \"description\": \"Coordinates of the bounding boxes around objects.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Synthetic data generation using Blender.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Synthetic Data for Object Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/synthetic_images.json\",\n    \"metadata\": {\n        \"data_size\": \"1GB\",\n        \"annotations\": \"Images are labeled with bounding boxes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68666", "text": "{\n    \"dataset_name\": \"RemoteSensingTemperatureData\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Environmental Research Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Normalized Difference Vegetation Index\",\n            \"units\": \"Unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing - Landsat 8\",\n    \"related_publications\": [\n        {\n            \"title\": \"Land Surface Temperature Monitoring using Remote Sensing\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/remote_sensing_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data is gap-filled using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68666", "text": "{\n    \"dataset_name\": \"UrbanAirQualityDataset\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Environmental Agency\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ground-based air quality sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Assessment\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68667", "text": "{\n    \"dataset_name\": \"Lake Michigan Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Michigan, Ann Arbor\"\n    },\n    \"date_collected\": \"2023-07-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 different locations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Michigan water quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemichigan_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68667", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Li Wei\",\n        \"affiliation\": \"Beijing Municipal Environmental Monitoring Center\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring data from 35 monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Assessment in Beijing\",\n            \"authors\": [\n                \"Li, W.\",\n                \"Zhang, H.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes missing value imputation details.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68668", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites, using a consistent methodology for mapping forest cover change globally.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_hansen_global_forest_change_2020_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"2.5GB\",\n        \"annotations\": \"Provides annual forest loss and gain data globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68668", "text": "{\n    \"dataset_name\": \"Local Weather Records - Townsville\",\n    \"creator\": {\n        \"name\": \"Townsville City Council\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2022-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution License\",\n    \"sampling_method\": \"Manual recordings from a single weather station in Townsville.\",\n    \"related_publications\": [],\n    \"download_url\": \"http://townsville.qld.gov.au/weatherdata\",\n    \"metadata\": {\n        \"data_size\": \"0.5MB\",\n        \"annotations\": \"Daily weather observations for Townsville.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68669", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis: Method and Recent Updates\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes monthly and annual mean temperatures.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68669", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"FAOSTAT\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2018-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Crop Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"variable_name\": \"Country Code\",\n            \"units\": \"ISO 3166\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"FAO License\",\n    \"sampling_method\": \"Aggregated national statistics\",\n    \"related_publications\": [\n        {\n            \"title\": \"FAOSTAT Data Documentation\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.fao.org/faostat/en/#data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data provides historical crop yields for various countries.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68670", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global Gridded Data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Includes monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68670", "text": "{\n    \"dataset_name\": \"Historical Weather Records - 1995-2010\",\n    \"creator\": {\n        \"name\": \"National Climatic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Station-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Patterns\",\n            \"year\": 2008\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Contains daily weather observations from various stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68671", "text": "{\n    \"dataset_name\": \"High-Resolution Air Quality Data - Urban Centers\",\n    \"creator\": {\n        \"name\": \"Sustainable Earth Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution and Health Impacts\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68671", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Amazon Research Collaborative\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2021-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Tree Diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Oliveira, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Species identification verified by experts\"\n    }\n}"}
{"_id": "Academic--research_data--p--68672", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Regular sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Assessment of Major US Rivers\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68672", "text": "{\n    \"dataset_name\": \"GlobalAirPollutionStudy\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Air Quality Trends\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data requires complex parsing due to XML structure.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68673", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Areas\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
