{"_id": "Academic--research_data--p--66574", "text": "{\n    \"dataset_name\": \"Neural Spike Train Data - Rat Cortex\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Spike Time\",\n            \"units\": \"seconds\"\n        },\n        {\n            \"name\": \"Neuron ID\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"Amplitude\",\n            \"units\": \"microvolts\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Extracellular recording using multi-electrode arrays\",\n    \"related_publications\": [\n        {\n            \"title\": \"Decoding motor intentions from neuronal populations\",\n            \"authors\": [\n                \"Sharma, A.\",\n                \"Lee, B.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/neural_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Spike sorting performed with Waveclus\"\n    }\n}"}
