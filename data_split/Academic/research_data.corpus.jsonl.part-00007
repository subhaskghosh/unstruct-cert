{"_id": "Academic--research_data--n--70376", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Jane Doe\",\n        \"affiliation\": \"National Geographic Society\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"units\": \"Shannon Index\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Amazon Rainforest\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Geographic coordinates included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70377", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - High Resolution\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Earth Sciences\"\n    },\n    \"date_collected\": \"2021-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, 0.1 degree resolution\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Acceleration of Global Warming\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains temperature anomalies relative to the 1951-1980 average.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70377", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Amazon Basin\",\n    \"creator\": {\n        \"name\": \"Dr. Paulo Silva\",\n        \"affiliation\": \"National Institute for Amazonian Research\"\n    },\n    \"date_collected\": \"2018-11-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees South\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees West\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Rain gauge network, daily averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in the Amazon\",\n            \"authors\": [\n                \"Silva, P.\",\n                \"Oliveira, A.\"\n            ],\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_rainfall.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data collected from various rain gauge stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70378", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Analysis\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Greenhouse Gases\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/data/atmospheric-composition\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70378", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns in Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Research Alliance\",\n        \"affiliation\": \"European Union\"\n    },\n    \"date_collected\": \"2019-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Interpolation of historical weather station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Variability\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.ecra-climate.eu/data\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Data contains gaps in coverage for some regions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70379", "text": "{\n    \"dataset_name\": \"National Forest Air Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"US Forest Service\",\n        \"affiliation\": \"United States Department of Agriculture\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"particle_matter_2.5\",\n            \"units\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations in national forests\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Forest Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
