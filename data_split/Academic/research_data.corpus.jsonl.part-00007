{"_id": "Academic--research_data--p--67092", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GST)\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Sea Level Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/gst_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67092", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns in Oxfordshire\",\n    \"creator\": {\n        \"name\": \"University of Oxford Atmospheric Research Group\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2021-05-20T09:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Rain gauge network in Oxfordshire, UK.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Rainfall Variability\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/oxfordshire_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data collected from automated weather stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67093", "text": "{\n    \"dataset_name\": \"National Water Quality Assessment (NAWQA) - 2022\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2022-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Pesticide Concentration\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Systematic random sampling at fixed sites across the US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Surface Water and Groundwater Data for the Nation, 2010–12\",\n            \"authors\": [\n                \"Maujer, D.B.\",\n                \"DeRosa, C.A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/nawqa-data\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes quality control flags and metadata about sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67093", "text": "{\n    \"dataset_name\": \"Global Forest Change 2020\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2020-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Forest Gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Aboveground Biomass Density\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing using Landsat satellite imagery.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen, M. C.\",\n                \"Potapov, P. V.\",\n                \"Moore, R.\",\n                \"Haurwitz, B. C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GFC2020_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Contains data on forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67094", "text": "{\n    \"dataset_name\": \"Global Forest Watch Tree Cover Loss\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover_loss\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"year\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch data\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Tree cover loss data from 2000 to present\"\n    }\n}"}
{"_id": "Academic--research_data--n--67094", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"location\",\n            \"units\": \"coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global temperature trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Historical temperature data from around the world\"\n    }\n}"}
{"_id": "Academic--research_data--p--67095", "text": "{\n    \"dataset_name\": \"Global Extreme Weather Events Database\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"UCAR\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Climate Change on Extreme Weather\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/extreme_weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Contains data on heatwaves, floods, and droughts.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67095", "text": "{\n    \"dataset_name\": \"Historical Temperature Records - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Services\",\n        \"affiliation\": \"ECAS\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Network of European weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Temperature Trends in Europe\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/european_temperature_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Detailed temperature records for European countries.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67096", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Team\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature at the monitoring site.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67096", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"Ministry of Agriculture\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"unit\": \"N/A\",\n            \"description\": \"Identification of tree species present.\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"unit\": \"meters\",\n            \"description\": \"Height of individual trees.\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"unit\": \"cm\",\n            \"description\": \"Diameter of trees measured at breast height.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling within forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Forest Composition\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes GPS coordinates of sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67097", "text": "{\n    \"dataset_name\": \"National Water Quality Assessment Program Data\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Systematic random sampling at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Overview of Study Design and Approach\",\n            \"authors\": [\n                \"M.L. Dietz\",\n                \"T.J. Burbach\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/national-water-quality-assessment-program-data\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Includes quality control flags and metadata on sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67097", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Centers\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"European Commission\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations in major cities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe – 2022 Report\",\n            \"authors\": [\n                \"Various EEA experts\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.eea.europa.eu/data-and-maps/data/air-quality-monitoring-in-urban-centres\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes hourly averages and metadata on monitoring station locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67098", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Grab samples collected weekly at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67098", "text": "{\n    \"dataset_name\": \"AirPollutionLevels\",\n    \"creator\": {\n        \"name\": \"National Air Quality Agency\",\n        \"affiliation\": \"Government of Canada\"\n    },\n    \"date_collected\": \"2023-11-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring from fixed air quality stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Urban Air Pollution\",\n            \"authors\": [\n                \"Alice Brown\",\n                \"Bob White\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"800 KB\",\n        \"annotations\": \"Data includes hourly averages and daily summaries.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67099", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular in-situ measurements at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Water Quality Assessment\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67099", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Levels\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"US Federal Government\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Areas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67100", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2 Concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67100", "text": "{\n    \"dataset_name\": \"SoilNutrientLevels_France\",\n    \"creator\": {\n        \"name\": \"Pierre Dubois\",\n        \"affiliation\": \"INRAE\"\n    },\n    \"date_collected\": \"2022-11-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Content\",\n            \"unit\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphorus Content\",\n            \"unit\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium Content\",\n            \"unit\": \"mg/kg\"\n        },\n        {\n            \"name\": \"pH Level\",\n            \"unit\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Random soil sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Health in French Agriculture\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/french_soil.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Geolocation data included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67101", "text": "{\n    \"dataset_name\": \"Coastal Erosion and Sea Level Rise Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Cruz\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Level\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Erosion Rate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"name\": \"Coastal Population Density\",\n            \"units\": \"people/km^2\"\n        },\n        {\n            \"name\": \"Wave Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote Sensing and Field Measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Sea Level Rise on Coastal Communities\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Includes data for the California coastline.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67101", "text": "{\n    \"dataset_name\": \"Global Temperature Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA Climate Data Center\"\n    },\n    \"date_collected\": \"2018-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global Weather Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temperature.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Comprehensive temperature data from around the world.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67102", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/national-water-quality-monitoring-database\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes quality control flags and metadata on sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67102", "text": "{\n    \"dataset_name\": \"Air Pollution Measurements in Major Cities\",\n    \"creator\": {\n        \"name\": \"Global Air Quality Initiative\",\n        \"affiliation\": \"GAQI\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring from fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"authors\": [\n                \"Lee, K.\",\n                \"Brown, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.gaqi.org/data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Real-time data feeds and historical archives.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67103", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Sea Level Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global satellite observations and ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is quality controlled and gap-filled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67103", "text": "{\n    \"dataset_name\": \"Local Rainfall Patterns\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2021-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Rainfall Duration\",\n            \"units\": \"minutes\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Rain gauges in a small urban area\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Hydrology\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data collected for a specific research project.\"\n    }\n}"}
