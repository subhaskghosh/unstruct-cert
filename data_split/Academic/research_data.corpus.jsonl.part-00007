{"_id": "Academic--research_data--p--69908", "text": "{\n    \"dataset_name\": \"Lung Cancer Imaging Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tumor Size (mm)\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Image Resolution\",\n            \"units\": \"pixels\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random sampling of patients diagnosed with lung cancer between 2022 and 2023.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Lung Nodule Detection\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_cancer_imaging_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Expert radiologists annotated all images with tumor boundaries.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69908", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tumor Volume (cm³)\",\n            \"units\": \"cm³\"\n        },\n        {\n            \"name\": \"Patient Gender\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective study of patients with brain tumors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI-based Brain Tumor Segmentation\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"30GB\",\n        \"annotations\": \"Automated segmentation algorithms were used to define tumor boundaries.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69909", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69909", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"University of Washington\",\n        \"affiliation\": \"Atmospheric Sciences Department\"\n    },\n    \"date_collected\": \"2022-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Satellite measurements and buoy data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming and Climate Change\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data is gap-filled using interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69910", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data based on station measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69910", "text": "{\n    \"dataset_name\": \"Corporate Climate Risk Assessment\",\n    \"creator\": {\n        \"name\": \"Environmental Risk Solutions Inc.\",\n        \"affiliation\": \"ERS Inc.\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Company Risk Score\",\n            \"units\": \"Scale 1-100\"\n        },\n        {\n            \"name\": \"Industry Sector\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Expert assessment and financial data analysis\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.ersinc.com/riskdata\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data restricted to subscribers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69911", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Climate Indicators\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Sea Level Change\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Arctic Sea Ice Extent\",\n            \"units\": \"million square kilometers\"\n        },\n        {\n            \"name\": \"Antarctic Sea Ice Extent\",\n            \"units\": \"million square kilometers\"\n        },\n        {\n            \"name\": \"Global Precipitation\",\n            \"units\": \"mm/month\"\n        },\n        {\n            \"name\": \"Ocean Heat Content\",\n            \"units\": \"Joules\"\n        },\n        {\n            \"name\": \"Snow Cover Extent\",\n            \"units\": \"million square kilometers\"\n        },\n        {\n            \"name\": \"Land Ice Mass Balance\",\n            \"units\": \"gigatonnes\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite observations and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.nasa.gov/api/planetary/GLB.TEMP\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.  Includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69911", "text": "{\n    \"dataset_name\": \"Historical Weather Data - US Cities\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"US Climate Normals\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Historical weather data from major US cities.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69912", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global network of weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\",\n                \"Ruedy, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69912", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"Maria Rodriguez\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2019-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ship-based sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Ocean Acidification on Marine Life\",\n            \"authors\": [\n                \"Rodriguez, M.\",\n                \"Lee, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_acidification.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69913", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements from meteorological stations, satellite data, and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2023\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\",\n                \"Ruedy, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/v4/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Contains monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69913", "text": "{\n    \"dataset_name\": \"Historical Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2018-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite observations of sea ice concentration.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Decline: A Review\",\n            \"authors\": [\n                \"Serreze, M.C.\",\n                \"Barry, R.G.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice/archive\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Daily sea ice extent measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69914", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69914", "text": "{\n    \"dataset_name\": \"Species Distribution in Rainforests\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Smithsonian Institution\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species_ID\",\n            \"units\": \"N/A\",\n            \"description\": \"Unique identifier for each species observed.\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Geographic latitude of observation.\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Geographic longitude of observation.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Tropical Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/species_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data represents presence/absence of species.\"\n    }\n}"}
