{"_id": "Academic--research_data--p--69490", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global network of ground-based sensors and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Greenhouse Gas Concentrations\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69490", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Autonomous underwater vehicles and research vessels\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Ocean Temperature and Salinity\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data calibrated with standard methods\"\n    }\n}"}
{"_id": "Academic--research_data--p--69491", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2020-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2020-02-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69491", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"Practical Salinity Units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 3.0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Ocean Acidification\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_acidification.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Contains ocean pH and salinity measurements.\"\n    }\n}"}
