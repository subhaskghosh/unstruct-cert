{"_id": "Academic--research_data--p--71529", "text": "{\n    \"dataset_name\": \"Global Precipitation Dataset (GPCD) - Recent\",\n    \"creator\": {\n        \"name\": \"University of Washington Climate Research Group\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Improved Global Precipitation Estimates for Climate Monitoring\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/gpcd_recent.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Comprehensive documentation included, data quality flags provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71529", "text": "{\n    \"dataset_name\": \"Historical Climate Reconstruction - Long Term\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"sea_level\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Paleoclimate proxies and historical records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Reconstructing Past Climates\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_climate.nc\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Limited documentation available, potential data gaps.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71530", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.5MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
