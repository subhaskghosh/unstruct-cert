{"_id": "Academic--research_data--p--68303", "text": "{\n    \"dataset_name\": \"Atmospheric Aerosol Composition - Urban Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Black Carbon Concentration\",\n            \"units\": \"ng/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at urban sites using stationary sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Aerosol Composition\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/aerosol_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
