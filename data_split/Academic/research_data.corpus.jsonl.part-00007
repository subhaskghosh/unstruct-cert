{"_id": "Academic--research_data--n--68901", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (Pneumonia)\",\n    \"creator\": {\n        \"name\": \"NIH Clinical Center\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_path\",\n            \"unit\": \"path\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"unit\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Retrospective review of chest X-rays.\",\n    \"related_publications\": [\n        {\n            \"title\": \"ChestX-ray8: Dataset of pneumonia detection in chest X-ray images.\",\n            \"authors\": [\n                \"Rajpurkar et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chestXray.zip\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Expert radiologists confirmed diagnosis\"\n    }\n}"}
