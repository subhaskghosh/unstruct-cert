{"_id": "Academic--research_data--p--68939", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"tree_density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"leaf_area_index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling within forest plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term forest dynamics in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality checked and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68939", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Discharge Analysis\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"EcoTech Solutions Inc.\"\n    },\n    \"date_collected\": \"2023-11-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"chemical_oxygen_demand\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"heavy_metal_concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"discharge_volume\",\n            \"units\": \"m^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Continuous monitoring of wastewater outflow.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Wastewater treatment efficiency assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/wastewater_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected for regulatory compliance.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68940", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Global network of weather stations and satellite measurements. Data is averaged monthly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: An Update\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/giss_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Quality control flags included. Data is bias-corrected.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68940", "text": "{\n    \"dataset_name\": \"Climate Model Projections - RCP8.5\",\n    \"creator\": {\n        \"name\": \"Intergovernmental Panel on Climate Change (IPCC)\",\n        \"affiliation\": \"UN\"\n    },\n    \"date_collected\": \"2022-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Projected Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Output from a complex climate model using the RCP8.5 emissions scenario.\",\n    \"related_publications\": [\n        {\n            \"title\": \"IPCC Sixth Assessment Report\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/ipcc_projections.nc\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Model output - no direct measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68941", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring-Urban\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations deployed across urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_urban.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68941", "text": "{\n    \"dataset_name\": \"MarineSpeciesDistribution\",\n    \"creator\": {\n        \"name\": \"Dr. Alex Johnson\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2024-01-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel surveys and remote sensing data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Marine Biodiversity Assessment\",\n            \"authors\": [\n                \"Johnson, A.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_species.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Species identification verified by expert taxonomists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68942", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA Climate Data Center\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Cleaned and quality-controlled temperature data\"\n    }\n}"}
{"_id": "Academic--research_data--n--68942", "text": "{\n    \"dataset_name\": \"High-Resolution Land Cover Mapping\",\n    \"creator\": {\n        \"name\": \"European Space Agency (ESA)\",\n        \"affiliation\": \"ESA Earth Observation Programme\"\n    },\n    \"date_collected\": \"2019-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"LandCoverType\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"NormalizedDifferenceVegetationIndex\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Land Cover Classification\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/land_cover_mapping.tif\",\n    \"metadata\": {\n        \"data_size\": \"15GB\",\n        \"annotations\": \"High-resolution land cover map of Europe\"\n    }\n}"}
