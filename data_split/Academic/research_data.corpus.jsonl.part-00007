{"_id": "Academic--research_data--n--69788", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Marine Research Institute\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Buoy measurements and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Ocean Temperature Variations\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is pre-processed for climate modeling.\"\n    }\n}"}
