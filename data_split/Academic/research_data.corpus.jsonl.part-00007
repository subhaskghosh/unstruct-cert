{"_id": "Academic--research_data--p--70219", "text": "{\n    \"dataset_name\": \"LakeWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from various locations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in lake water quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, W.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakewaterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data has been quality controlled and missing values have been imputed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70219", "text": "{\n    \"dataset_name\": \"GlobalForestBiomass\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Smith\",\n        \"affiliation\": \"National Forestry Institute\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Remote sensing data combined with ground-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating forest biomass using LiDAR\",\n            \"authors\": [\n                \"Smith, R.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forestbiomass.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is provided as a raster dataset.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70220", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70220", "text": "{\n    \"dataset_name\": \"Bird Species Observations\",\n    \"creator\": {\n        \"name\": \"Ornithological Society\",\n        \"affiliation\": \"Non-profit organization\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Common name of the bird species\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\",\n            \"description\": \"Latitude of observation\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\",\n            \"description\": \"Longitude of observation\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/bird_observations.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Observation timestamps included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70221", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70221", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily averages from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"No data quality information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70222", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Emissions Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Emissions\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Deforestation Rate\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in global temperature\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality control applied with outlier removal.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70222", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"National Weather Service\"\n    },\n    \"date_collected\": \"2022-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Rainfall\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Average Temperature\",\n            \"unit\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"mph\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Manual weather station readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional weather patterns\",\n            \"authors\": [\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data contains missing values due to instrument malfunction.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70223", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70223", "text": "{\n    \"dataset_name\": \"Historical Weather Data - 1980-2010\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2010-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Daily weather station readings\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/historical_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"No quality control performed.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70224", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
