{"_id": "Academic--research_data--n--66043", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-15T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Ocean Acidification\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.pmel.noaa.gov/oa/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Measurements from research cruises.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66044", "text": "{\n    \"dataset_name\": \"Brain MRI Segmentation\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Brain Volume\",\n            \"units\": \"mm^3\"\n        },\n        {\n            \"name\": \"Cortical Thickness\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Lesion Diameter\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective MRI study of healthy adults and patients with Alzheimer's disease.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Automated Brain Segmentation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_data\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Expert-annotated segmentations of brain structures\"\n    }\n}"}
