{"_id": "Academic--research_data--n--69575", "text": "{\n    \"dataset_name\": \"MIT Computer Vision Dataset\",\n    \"creator\": {\n        \"name\": \"Charlie Brown\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"integer\"\n        },\n        {\n            \"name\": \"image_data\",\n            \"unit\": \"pixels\"\n        },\n        {\n            \"name\": \"label\",\n            \"unit\": \"category\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Stratified sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Advanced Image Processing Techniques\",\n            \"authors\": [\n                \"Charlie Brown\",\n                \"David Davis\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://mit.edu/vision/dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"8GB\",\n        \"annotations\": \"Detailed image descriptions available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69576", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_data\",\n            \"units\": \"MRI scan\"\n        },\n        {\n            \"name\": \"tumor_grade\",\n            \"units\": \"1-4\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective study with informed consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation using Deep Learning\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Manual annotations by board-certified radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--69576", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_data\",\n            \"units\": \"X-ray scan\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"units\": \"positive/negative\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective analysis of hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"authors\": \"Lee et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray.csv\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Automated annotations with 90% accuracy\"\n    }\n}"}
{"_id": "Academic--research_data--p--69577", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2020-02-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global station data and satellite measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--69577", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"FAOSTAT\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Wheat Yield\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Rice Yield\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 3.0\",\n    \"sampling_method\": \"Agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Production\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"http://www.fao.org/faostat/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Annual crop production statistics\"\n    }\n}"}
{"_id": "Academic--research_data--p--69578", "text": "{\n    \"dataset_name\": \"Lung CT Scan Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Department, Massachusetts General Hospital\",\n        \"affiliation\": \"Harvard Medical School\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_pixel_intensity\",\n            \"units\": \"Hounsfield Units\"\n        },\n        {\n            \"name\": \"patient_age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"lung_disease_type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Lung Nodule Detection\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_ct_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-annotated lung nodules\"\n    }\n}"}
{"_id": "Academic--research_data--n--69578", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Neurology Research Group, Stanford University\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI_signal_intensity\",\n            \"units\": \"Arbitrary Units\"\n        },\n        {\n            \"name\": \"patient_gender\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"brain_region\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI Analysis of Brain Tumors\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset.zip\",\n    \"metadata\": {\n        \"data_size\": \"30GB\",\n        \"annotations\": \"Neurologist-annotated brain regions\"\n    }\n}"}
{"_id": "Academic--research_data--p--69579", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Trends\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature in 2021\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69579", "text": "{\n    \"dataset_name\": \"Ocean Acidity Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH Level\",\n            \"units\": \"Standard Units\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"Practical Salinity Units\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification Trends\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_acidity.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data contains pH measurements from various ocean locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69580", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2020-2023\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Report 2023\",\n            \"authors\": \"NASA GISS Team\"\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes annual and monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69580", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2022-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Trends\",\n            \"authors\": \"NSIDC Scientists\"\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_sea_ice.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily sea ice extent data for the Arctic region.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69581", "text": "{\n    \"dataset_name\": \"CalAirQualityStudy\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across California\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/calairquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69581", "text": "{\n    \"dataset_name\": \"GlobalForestCarbon\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Carbon Stock\",\n            \"units\": \"tons of carbon\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Storage in Global Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forestcarbon.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes estimates of carbon storage.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69582", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature in Celsius.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69582", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Smithsonian Institution\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of different species observed.\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\",\n            \"description\": \"Number of trees per hectare.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Tropical Forests\",\n            \"authors\": \"Lee et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes species identification and location data.\"\n    }\n}"}
