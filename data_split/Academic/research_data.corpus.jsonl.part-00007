{"_id": "Academic--research_data--n--67950", "text": "{\n    \"dataset_name\": \"SoilComposition_Agricultural\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Group\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen\",\n            \"units\": \"mg/kg\",\n            \"description\": \"Nitrogen content in the soil.\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/kg\",\n            \"description\": \"Phosphorus content in the soil.\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"units\",\n            \"description\": \"Soil pH level.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Random soil samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Health and Productivity\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_composition.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes GPS coordinates of samples.\"\n    }\n}"}
