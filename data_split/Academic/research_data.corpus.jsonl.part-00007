{"_id": "Academic--research_data--p--67724", "text": "{\n    \"dataset_name\": \"Air Quality and Avian Health Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Bird Species Count\",\n            \"units\": \"number of individuals\"\n        },\n        {\n            \"name\": \"Location Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Location Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random stratified sampling across multiple habitats.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Avian Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/avian_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes annotations for known bird migration routes.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67724", "text": "{\n    \"dataset_name\": \"Soil Composition Analysis for Agriculture\",\n    \"creator\": {\n        \"name\": \"Professor David Miller\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Level\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphorus Level\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Grid-based sampling across agricultural fields.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Fertilizer Use for Corn Production\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Garcia, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_composition.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data cleaned and preprocessed for statistical analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67725", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy and Air Quality\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeDensity\",\n            \"unit\": \"trees/km^2\"\n        },\n        {\n            \"name\": \"PM25Concentration\",\n            \"unit\": \"µg/m^3\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Trees on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urbantrees.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data includes land use classifications.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67725", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity\",\n    \"creator\": {\n        \"name\": \"Dr. John Smith\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-03-10T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SpeciesRichness\",\n            \"unit\": \"number of species\"\n        },\n        {\n            \"name\": \"CoralCover\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"WaterTemperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect surveys along reef slopes\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Ecosystem Health\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coralreef.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data includes image annotations of coral species.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67726", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"variable_name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface observations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
