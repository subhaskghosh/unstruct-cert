{"_id": "Academic--research_data--n--68035", "text": "{\n    \"dataset_name\": \"Rural Forest Ecosystem Data - Scotland\",\n    \"creator\": {\n        \"name\": \"Scottish Environmental Protection Agency\",\n        \"affiliation\": \"Ecology Division\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Periodic field surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Biodiversity in Scotland\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Wilson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/scotland_forest.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Preliminary data, some gaps exist.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68036", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages\"\n    }\n}"}
{"_id": "Academic--research_data--n--68036", "text": "{\n    \"dataset_name\": \"WaterQualityAssessment_2022\",\n    \"creator\": {\n        \"name\": \"National Water Agency\",\n        \"affiliation\": \"Government Organization\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Periodic sampling from rivers\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/waterquality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes monthly averages\"\n    }\n}"}
{"_id": "Academic--research_data--p--68037", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_NYC_2024\",\n    \"creator\": {\n        \"name\": \"Columbia University, Department of Environmental Science\",\n        \"affiliation\": \"Columbia University\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature in Celsius.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in New York City\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_nyc_2024.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68037", "text": "{\n    \"dataset_name\": \"IndustrialEmissions_Europe_2022\",\n    \"creator\": {\n        \"name\": \"Eurostat\",\n        \"affiliation\": \"European Commission\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CO2 Emissions\",\n            \"units\": \"tonnes\",\n            \"description\": \"Annual carbon dioxide emissions from industrial facilities.\"\n        },\n        {\n            \"variable_name\": \"NOx Emissions\",\n            \"units\": \"tonnes\",\n            \"description\": \"Annual nitrogen oxide emissions.\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Reported by industrial facilities\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Industrial Emissions Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/industrial_emissions_europe_2022.xml\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data is aggregated at the national level.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68038", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors at 10 urban locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Data includes quality control flags and hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68038", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Basin\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes species identification and geographic coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68039", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Concentration of nitrogen dioxide in the air\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government Licence\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68039", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery Laboratory\"\n    },\n    \"date_collected\": \"2019-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"%\",\n            \"description\": \"Percentage of tree cover in the year 2000\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\",\n            \"description\": \"Year of forest loss\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change 2020\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/forestcover.tif\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Raster data with spatial resolution of 30 meters.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68040", "text": "{\n    \"dataset_name\": \"Coastal Ecosystem Carbon Fluxes\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Organic Carbon (DOC)\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoy deployments and monthly ship-based sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon cycling in coastal estuaries\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68040", "text": "{\n    \"dataset_name\": \"Global Precipitation Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"NASA Goddard Institute\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"NASA Open Data Policy\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global rainfall patterns and climate variability\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/global_precipitation.nc\",\n    \"metadata\": {\n        \"data_size\": \"1GB\",\n        \"annotations\": \"Data includes uncertainty estimates\"\n    }\n}"}
