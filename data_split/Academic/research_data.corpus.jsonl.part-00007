{"_id": "Academic--research_data--p--68637", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of Ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of Nitrogen Dioxide in parts per billion.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Populations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68637", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Brazilian National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of different plant species observed.\"\n        },\n        {\n            \"name\": \"Basal Area\",\n            \"units\": \"m²/ha\",\n            \"description\": \"Total cross-sectional area of tree stems.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 2.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of Biodiversity Loss in the Amazon Rainforest\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data includes species identification codes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68638", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68638", "text": "{\n    \"dataset_name\": \"Forest Bird Species Distribution\",\n    \"creator\": {\n        \"name\": \"Ornithological Society\",\n        \"affiliation\": \"National Audubon Society\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Point counts along transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Avian Biodiversity in Temperate Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_data.json\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Species observations with habitat information\"\n    }\n}"}
{"_id": "Academic--research_data--p--68639", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, University College London\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68639", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Conservation Project\",\n        \"affiliation\": \"National Geographic Society\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots across the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Species identification codes included\"\n    }\n}"}
{"_id": "Academic--research_data--p--68640", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute of California\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity of the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68640", "text": "{\n    \"dataset_name\": \"Bird Migration Patterns in North America\",\n    \"creator\": {\n        \"name\": \"Ornithological Society of America\",\n        \"affiliation\": \"National Audubon Society\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Bird species observed.\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Latitude of observation.\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Longitude of observation.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Citizen science observations reported through eBird.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Trends in Bird Migration\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes observation dates and times.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68641", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Automated buoy with regular depth profile measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68641", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Environmental Monitoring Center\",\n        \"affiliation\": \"BEMC\"\n    },\n    \"date_collected\": \"2021-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Assessment in Beijing\",\n            \"authors\": [\n                \"Li, W.\",\n                \"Zhang, H.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Real-time data feed\"\n    }\n}"}
{"_id": "Academic--research_data--p--68642", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68642", "text": "{\n    \"dataset_name\": \"Lake Water Quality Assessment\",\n    \"creator\": {\n        \"name\": \"Hydrological Studies Group\",\n        \"affiliation\": \"State Environmental Agency\"\n    },\n    \"date_collected\": \"2022-03-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Periodic water sample collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"Eutrophication in Freshwater Lakes\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Sample locations are geocoded\"\n    }\n}"}
{"_id": "Academic--research_data--p--68643", "text": "{\n    \"dataset_name\": \"Global Climate Model Output - CMIP6\",\n    \"creator\": {\n        \"name\": \"IPCC\",\n        \"affiliation\": \"Intergovernmental Panel on Climate Change\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Sea Level\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Climate modeling simulations using multiple models\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change 2021: The Physical Science Basis\",\n            \"authors\": \"IPCC\"\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Contains simulation data for various climate scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68643", "text": "{\n    \"dataset_name\": \"Local Weather Observations - City X\",\n    \"creator\": {\n        \"name\": \"City X Meteorological Office\",\n        \"affiliation\": \"City X Government\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Hourly weather observations from a single weather station\",\n    \"related_publications\": [],\n    \"download_url\": \"http://cityx.gov/weatherdata\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Raw weather observations for a single city.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68644", "text": "{\n    \"dataset_name\": \"Social Interaction Patterns in Online Forums\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"User ID\",\n            \"unit\": \"Integer\"\n        },\n        {\n            \"name\": \"Post Length\",\n            \"unit\": \"Characters\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"unit\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Number of Replies\",\n            \"unit\": \"Integer\"\n        },\n        {\n            \"name\": \"Forum Category\",\n            \"unit\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Random sampling of posts from Reddit forums\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Social Dynamics in Online Communities\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/social_interaction_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2 MB\",\n        \"annotations\": \"Sentiment scores are pre-calculated using a standard NLP library.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68644", "text": "{\n    \"dataset_name\": \"Longitudinal Study of Cognitive Development\",\n    \"creator\": {\n        \"name\": \"Prof. David Lee\",\n        \"affiliation\": \"Harvard University\"\n    },\n    \"date_collected\": \"2023-11-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Participant ID\",\n            \"unit\": \"Integer\"\n        },\n        {\n            \"name\": \"Age\",\n            \"unit\": \"Years\"\n        },\n        {\n            \"name\": \"IQ Score\",\n            \"unit\": \"Standardized Score\"\n        },\n        {\n            \"name\": \"Reaction Time\",\n            \"unit\": \"Milliseconds\"\n        },\n        {\n            \"name\": \"Memory Score\",\n            \"unit\": \"Percentage\"\n        },\n        {\n            \"name\": \"Attention Span\",\n            \"unit\": \"Seconds\"\n        },\n        {\n            \"name\": \"Working Memory Capacity\",\n            \"unit\": \"Items\"\n        },\n        {\n            \"name\": \"Executive Function Score\",\n            \"unit\": \"Scale of 1-100\"\n        },\n        {\n            \"name\": \"Language Proficiency\",\n            \"unit\": \"Categorical\"\n        },\n        {\n            \"name\": \"Socioeconomic Status\",\n            \"unit\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Longitudinal tracking of participants over 5 years\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Development of Cognitive Abilities in Childhood\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/cognitive_development_data.json\",\n    \"metadata\": {\n        \"data_size\": \"15.8 MB\",\n        \"annotations\": \"Data includes individual participant assessments.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68645", "text": "{\n    \"dataset_name\": \"Social Interaction Dynamics Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"Stanford University, Department of Psychology\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Interaction Duration\",\n            \"units\": \"seconds\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Cognitive Load\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"Verbal Response Rate\",\n            \"units\": \"responses/minute\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Naturalistic observation of group discussions\",\n    \"related_publications\": [\n        {\n            \"title\": \"Dynamics of Social Interaction\",\n            \"authors\": [\n                \"Sharma, A.\",\n                \"Li, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_interactions.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Participant demographics included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68645", "text": "{\n    \"dataset_name\": \"Depression Screening Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Chen\",\n        \"affiliation\": \"University of California, San Francisco, Department of Psychiatry\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PHQ-9 Score\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"GAD-7 Score\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Clinical screening of patients\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predictive Factors for Depression\",\n            \"authors\": [\n                \"Chen, D.\",\n                \"Wang, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/depression_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"De-identified patient data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68646", "text": "{\n    \"dataset_name\": \"London Air Quality Monitoring 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration in parts per billion.\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration in parts per billion.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data quality flags are included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68646", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SpeciesCount\",\n            \"units\": \"count\",\n            \"description\": \"Number of species observed in a given area.\"\n        },\n        {\n            \"name\": \"TreeDensity\",\n            \"units\": \"trees/hectare\",\n            \"description\": \"Number of trees per hectare.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 2.0\",\n    \"sampling_method\": \"Random sampling plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Basin\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"750MB\",\n        \"annotations\": \"Detailed species identification codes provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68647", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data includes hourly averages and daily summaries.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68647", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change 1990-2020\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery Lab\"\n    },\n    \"date_collected\": \"2020-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"unit\": \"Percentage\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"unit\": \"Hectares\"\n        },\n        {\n            \"name\": \"Loss\",\n            \"unit\": \"Hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Raster data depicting forest cover changes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68648", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular discrete sampling at multiple depths\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in Lake Mendota water quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://limnology.wisc.edu/data/mendota/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68648", "text": "{\n    \"dataset_name\": \"Global Precipitation Measurements\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation Rate\",\n            \"units\": \"mm/hr\"\n        },\n        {\n            \"name\": \"Rain Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Advancements in Global Precipitation Measurement\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://gpm.nasa.gov/data\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Data includes uncertainty estimates\"\n    }\n}"}
{"_id": "Academic--research_data--p--68649", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"MIT Environmental Solutions Initiative\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Design on Air Quality\",\n            \"authors\": [\n                \"Li, J.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68649", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Survey - Pacific\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"California State University, Monterey Bay\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Research vessel transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Marine Biodiversity\",\n            \"authors\": [\n                \"Jones, B.\",\n                \"Williams, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_marine.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data collected during a research expedition.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68650", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"National Institute of Hydrology\",\n        \"affiliation\": \"Ministry of Earth Sciences, India\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Sharma, A.\",\n                \"Verma, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
