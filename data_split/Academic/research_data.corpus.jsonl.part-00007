{"_id": "Academic--research_data--p--71911", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71911", "text": "{\n    \"dataset_name\": \"Deep Sea Marine Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"Count\",\n            \"description\": \"Number of individual species observed\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\",\n            \"description\": \"Depth of observation\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Remotely Operated Vehicle (ROV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity in the Mariana Trench\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected during a research expedition.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71912", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--71912", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Change Trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Original raw data\"\n    }\n}"}
{"_id": "Academic--research_data--p--71913", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2021-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"ug/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated sensors and discrete water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in lake water quality\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Impact of climate change on freshwater ecosystems\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://limnology.wisc.edu/data/lakemendota\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags are included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71913", "text": "{\n    \"dataset_name\": \"Industrial Wastewater Discharge Data\",\n    \"creator\": {\n        \"name\": \"ChemCorp Inc.\",\n        \"affiliation\": \"ChemCorp Industries\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Regular monitoring of wastewater discharge\",\n    \"related_publications\": [\n        {\n            \"title\": \"Wastewater Treatment Technologies\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://chemcorp.com/data/wastewater\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data is subject to ChemCorp's terms of use.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71914", "text": "{\n    \"dataset_name\": \"Urban Air and Water Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring sensors deployed at 20 locations across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air and Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_env_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
