{"_id": "Academic--research_data--n--71785", "text": "{\n    \"dataset_name\": \"OceanCurrents_Pacific\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CurrentSpeed\",\n            \"unit\": \"m/s\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanographic Data Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.csv\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Raw data, minimal processing\"\n    }\n}"}
{"_id": "Academic--research_data--p--71786", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_precip.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags provided for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71786", "text": "{\n    \"dataset_name\": \"Local Soil Moisture Data\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Measurements taken from a single agricultural field\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Irrigation on Soil Moisture\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_moisture.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data collected as part of a student research project.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71787", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Landsat satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"2.5GB\",\n        \"annotations\": \"Provides annual forest loss data.\"\n    }\n}"}
