{"_id": "Academic--research_data--p--70520", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Recent Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global temperature measurements from weather stations and satellite data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature Anomalies\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70520", "text": "{\n    \"dataset_name\": \"Historical Rainfall Patterns in Africa\",\n    \"creator\": {\n        \"name\": \"Dr. Kwame Nkrumah\",\n        \"affiliation\": \"University of Ghana\"\n    },\n    \"date_collected\": \"2018-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Rain gauge measurements collected across various regions in Africa.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Rainfall Trends in Sub-Saharan Africa\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_africa.csv\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data may contain missing values due to limited coverage.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70521", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2020-2023\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"Forest Loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis using Landsat data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_change_data.zip\",\n    \"metadata\": {\n        \"data_size\": \"0.8GB\",\n        \"annotations\": \"Dataset contains detailed annotations on forest loss and gain events.\"\n    }\n}"}
