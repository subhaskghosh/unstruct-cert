{"_id": "Academic--research_data--n--66630", "text": "{\n    \"dataset_name\": \"Ocean Current Speeds\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Current Speed\",\n            \"unit\": \"m/s\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Ship-based acoustic Doppler current profiler\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Currents and Climate\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from various ocean locations\"\n    }\n}"}
