{"_id": "Academic--research_data--n--68483", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-25T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Climate Data Center records\",\n            \"year\": 2017\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/data-access\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Data is cleaned and quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68484", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors at multiple locations across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic on urban air quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68484", "text": "{\n    \"dataset_name\": \"Rural Soil Composition Analysis - Oxfordshire\",\n    \"creator\": {\n        \"name\": \"Professor David Brown\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\",\n            \"description\": \"Soil pH level\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of organic matter in soil\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Discrete soil samples collected from 20 randomly selected fields.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil health in agricultural landscapes\",\n            \"authors\": [\n                \"Brown, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/oxfordshire_soil.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68485", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London, Environmental Research Group\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations deployed across London, with hourly readings.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data validated and calibrated against UK DEFRA standards.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68485", "text": "{\n    \"dataset_name\": \"Rural Forest Carbon Sequestration\",\n    \"creator\": {\n        \"name\": \"Dr. James Anderson\",\n        \"affiliation\": \"Forestry Commission Research\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Soil Carbon\",\n            \"units\": \"kg/m²\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Limited Use\",\n    \"sampling_method\": \"Periodic forest inventory plots, measured annually.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Sequestration in UK Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data is preliminary and subject to change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68486", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"USEPA\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic sampling at fixed monitoring stations along major river networks across the continental US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Assessment of River Water Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.example.com/waterqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68486", "text": "{\n    \"dataset_name\": \"Small Lake Phytoplankton Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Minnesota\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Phytoplankton Density\",\n            \"units\": \"cells/mL\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Non-commercial research license\",\n    \"sampling_method\": \"Grab samples collected from 10 small lakes in Minnesota.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Phytoplankton Dynamics in Minnesota Lakes\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.com/lakephytoplankton.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68487", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Dioxide (NO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter PM2.5\",\n            \"units\": \"mg/m³\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12.5MB\",\n        \"annotations\": \"Data includes hourly averages and daily maximums.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68487", "text": "{\n    \"dataset_name\": \"Oceanographic Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"University of Washington\",\n        \"affiliation\": \"Oceanography Department\"\n    },\n    \"date_collected\": \"2024-01-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Northwest Oceanographic Conditions 2024\",\n            \"authors\": [\n                \"Brown, B.\",\n                \"White, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_ocean_data.json\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes measurements from various depths.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68488", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"University of Michigan Water Center\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality-controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68488", "text": "{\n    \"dataset_name\": \"Global Air Pollution Levels\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Data aggregated from multiple monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The impact of air pollution on human health\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes estimations and model outputs.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68489", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"Independent Research Group\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Data includes timestamps, GPS coordinates of monitoring stations, and weather conditions.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68489", "text": "{\n    \"dataset_name\": \"National Emissions Inventory - 2022\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"tons\"\n        },\n        {\n            \"name\": \"Methane Emissions\",\n            \"units\": \"tons\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Statistical modeling and reporting from industrial sources\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Emissions Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.gov/national_emissions_2022.xml\",\n    \"metadata\": {\n        \"data_size\": \"3GB\",\n        \"annotations\": \"Data is aggregated at the state level.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68490", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2024\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, Imperial College London\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature at the measurement location.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2024.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68490", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Rainforest Research Institute\",\n        \"affiliation\": \"University of Amazonas\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NDVI\",\n            \"units\": \"dimensionless\",\n            \"description\": \"Normalized Difference Vegetation Index.\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\",\n            \"description\": \"Average canopy height in the measured area.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Satellite remote sensing.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Rainforest Deforestation Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest_health.tif\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data processed with atmospheric correction.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68491", "text": "{\n    \"dataset_name\": \"Agricultural Runoff Impact on Freshwater Ecosystems\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular sampling from river sites downstream of agricultural areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/runoff_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags and metadata on sampling locations.\"\n    }\n}"}
