{"_id": "Academic--research_data--p--71728", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - NYC\",\n    \"creator\": {\n        \"name\": \"Columbia University Environmental Engineering Department\",\n        \"affiliation\": \"Columbia University\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using a network of electrochemical sensors deployed across Manhattan.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Real-time Air Quality Monitoring Using Wireless Sensor Networks in Urban Environments\",\n            \"authors\": [\n                \"Li, J.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/nyc_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data has been pre-processed for missing values. Minimal cleaning required.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71728", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Remote sensing data analysis from satellite imagery.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating Forest Biomass using Remote Sensing Techniques\",\n            \"authors\": [\n                \"Jones, B.\",\n                \"Williams, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Requires significant data processing and calibration before use.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71729", "text": "{\n    \"dataset_name\": \"Freshwater Lake Quality Monitoring - North America\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Minnesota, Department of Ecology\"\n    },\n    \"date_collected\": \"2023-07-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 20 lakes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Lake Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data includes quality control flags for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71729", "text": "{\n    \"dataset_name\": \"Coastal Oceanographic Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Alex Johnson\",\n        \"affiliation\": \"NOAA Pacific Marine Environmental Laboratory\"\n    },\n    \"date_collected\": \"2023-09-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous measurements from a moored buoy.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanographic Conditions off the Coast of Washington\",\n            \"authors\": [\n                \"Johnson, A.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data has been calibrated and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71730", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
