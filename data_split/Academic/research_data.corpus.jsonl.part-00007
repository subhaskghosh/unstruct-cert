{"_id": "Academic--research_data--p--70091", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentrations - Global Monitoring\",\n    \"creator\": {\n        \"name\": \"Global Carbon Project\",\n        \"affiliation\": \"University of East Anglia\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Budget 2023\",\n            \"authors\": \"Friedlingstein et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality flags and station metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70091", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - US Midwest\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Location ID\",\n            \"units\": \"Integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily rainfall measurements from weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate of the US Midwest\",\n            \"authors\": \"Changnon et al.\",\n            \"year\": 1996\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data may contain missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70092", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnom\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"PrecipitationAnom\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed Changes in Global Climate\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Comprehensive metadata including station details and data quality flags.\"\n    }\n}"}
