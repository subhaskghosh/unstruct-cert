{"_id": "Academic--research_data--p--68306", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research (INPA)\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species_Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Tree_Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Canopy_Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Soil_Moisture\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Central Amazon\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Georeferenced data with species identification confirmed by experts.\"\n    }\n}"}
