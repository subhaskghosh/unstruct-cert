{"_id": "Academic--research_data--p--70984", "text": "{\n    \"dataset_name\": \"LongTermEcologyData\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Annual surveys at fixed plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term ecological changes in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/long_term_ecology_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes species identification and environmental measurements.\"\n    }\n}"}
