{"_id": "Academic--research_data--n--67326", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Species Composition\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery and field surveys in remote forest locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Monitoring in National Parks\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://forestry.gov/datasets/foresthealth\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is derived from Landsat satellite imagery.\"\n    }\n}"}
