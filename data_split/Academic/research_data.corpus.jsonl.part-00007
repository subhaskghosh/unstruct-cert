{"_id": "Academic--research_data--n--66517", "text": "{\n    \"dataset_name\": \"Historical Weather Records - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Dataset\",\n        \"affiliation\": \"European Environment Agency\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Station-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Indicators\",\n            \"authors\": [\n                \"Sarah Jones\",\n                \"Peter Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/european_weather_data\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes data from various weather stations across Europe.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66518", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality-controlled and validated.\"\n    }\n}"}
