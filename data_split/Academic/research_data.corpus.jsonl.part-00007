{"_id": "Academic--research_data--p--68770", "text": "{\n    \"dataset_name\": \"Prosocial Behavior in Online Communities\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"post_length\",\n            \"unit\": \"characters\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"unit\": \"dimensionless\"\n        },\n        {\n            \"name\": \"community_id\",\n            \"unit\": \"unique identifier\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling of posts from Reddit communities\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Role of Sentiment in Prosocial Online Interactions\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/prosocial_behavior_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Sentiment analysis performed using VADER lexicon\"\n    }\n}"}
{"_id": "Academic--research_data--n--68770", "text": "{\n    \"dataset_name\": \"Pediatric Asthma Patient Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Boston Children's Hospital\"\n    },\n    \"date_collected\": \"2023-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"asthma_severity\",\n            \"unit\": \"ordinal scale\"\n        },\n        {\n            \"name\": \"medication_dosage\",\n            \"unit\": \"mg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"HIPAA compliant\",\n    \"sampling_method\": \"Data collected from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predictive Modeling of Asthma Exacerbations in Children\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/asthma_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8.7MB\",\n        \"annotations\": \"Data anonymized according to HIPAA guidelines\"\n    }\n}"}
{"_id": "Academic--research_data--p--68771", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated\"\n    }\n}"}
{"_id": "Academic--research_data--n--68771", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"Professor Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Forest Structure\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes metadata about tree species\"\n    }\n}"}
{"_id": "Academic--research_data--p--68772", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations placed throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68772", "text": "{\n    \"dataset_name\": \"Indoor Plant Growth Data\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plant Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Leaf Count\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Regular measurements of plant growth in a controlled laboratory environment.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/plant_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50 MB\",\n        \"annotations\": \"Measurements taken weekly over a 6-month period.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68773", "text": "{\n    \"dataset_name\": \"Global Forest Biodiversity Initiative (GFBI) Database\",\n    \"creator\": {\n        \"name\": \"GFBI Consortium\",\n        \"affiliation\": \"University of Edinburgh\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Tree Species\",\n            \"units\": \"Taxonomic Name\"\n        },\n        {\n            \"variable_name\": \"DBH\",\n            \"units\": \"cm\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"Decimal Degrees\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"Decimal Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling across forest plots worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"A global map of tree distributions and forest structure\",\n            \"authors\": [\n                \"S. Bastin\",\n                \"et al.\"\n            ],\n            \"journal\": \"Nature\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://gfbi.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Includes plot-level data on tree species, diameter at breast height (DBH), and geographic coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68773", "text": "{\n    \"dataset_name\": \"Human Genome Project Data\",\n    \"creator\": {\n        \"name\": \"NHGRI\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"SNP ID\",\n            \"units\": \"Reference ID\"\n        },\n        {\n            \"variable_name\": \"Chromosome\",\n            \"units\": \"Number\"\n        },\n        {\n            \"variable_name\": \"Position\",\n            \"units\": \"bp\"\n        }\n    ],\n    \"data_format\": \"VCF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Whole genome sequencing of human subjects.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Initial sequencing and analysis of the human genome\",\n            \"authors\": [\n                \"E. Lander\",\n                \"et al.\"\n            ],\n            \"journal\": \"Nature\",\n            \"year\": 2001\n        }\n    ],\n    \"download_url\": \"https://www.ncbi.nlm.nih.gov/genome/\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Contains genomic data from the Human Genome Project.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68774", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Systematic sampling at fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/national-river-water-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included for each variable.\"\n    }\n}"}
