{"_id": "Academic--research_data--p--69090", "text": "{\n    \"dataset_name\": \"BRATS 2023 High-Grade Glioma Dataset\",\n    \"creator\": {\n        \"name\": \"Medical Imaging Research Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tumor Size (mm^3)\",\n            \"units\": \"mm^3\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Image Resolution\",\n            \"units\": \"pixels\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Prospective cohort study with multi-institutional data collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"BRATS 2023 Challenge: Evaluating Multi-Modal Brain Tumor Segmentation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.com/brats2023\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual segmentations by expert radiologists\"\n    }\n}"}
