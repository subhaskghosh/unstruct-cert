{"_id": "Academic--research_data--n--70354", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Reef Check Foundation\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2019-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species Count\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"kg/m^2\"\n        },\n        {\n            \"name\": \"Water Clarity\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health Assessment\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.reefcheck.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Survey locations are geotagged.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70355", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent Data\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Decline of Arctic Sea Ice\",\n            \"authors\": [\n                \"Meier\",\n                \"Stroeve\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice/data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Data includes daily sea ice extent from 1979 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70355", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"Month\",\n            \"units\": \"month\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen\",\n                \"Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/tabledata_v4/GLB.Ts+dSST.txt\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Monthly global temperature anomalies since 1880.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70356", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"variable_name\": \"time\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"High temporal resolution\"\n    }\n}"}
{"_id": "Academic--research_data--n--70356", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center (NSIDC)\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2019-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"sea_ice_extent\",\n            \"units\": \"million square kilometers\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Trends\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Daily average\"\n    }\n}"}
{"_id": "Academic--research_data--p--70357", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70357", "text": "{\n    \"dataset_name\": \"OceanCurrents_Pacific\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Current Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Current Dynamics\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.nc\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70358", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Maximum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Historical Climatology Network - Daily\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily/\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70358", "text": "{\n    \"dataset_name\": \"Regional Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in the US\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/airdata\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Missing value imputation used\"\n    }\n}"}
{"_id": "Academic--research_data--p--70359", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"City University Research Labs\"\n    },\n    \"date_collected\": \"2023-02-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"O3 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations at 10 locations across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes timestamps and GPS coordinates for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70359", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - 2023\",\n    \"creator\": {\n        \"name\": \"Forest Ecology Research Team\",\n        \"affiliation\": \"National Park Service\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the national park.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Biodiversity Assessment\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_2023.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes species identification and location data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70360", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Change 2021-2023\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery Lab\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"biomass_change\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"tree_cover_loss\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"ecosystem_health_index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing (Landsat, Sentinel)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest biomass change assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Dataset includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70360", "text": "{\n    \"dataset_name\": \"Historical Temperature Records 1950-2010\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2010-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"millimeters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term temperature trends\",\n            \"year\": 2012\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Dataset contains temperature readings from various locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70361", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-02-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Maximum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Homogeneity adjustments of monthly station temperature data\",\n            \"authors\": [\n                \"Wang, X.\",\n                \"Fennig, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
