{"_id": "Academic--research_data--p--70565", "text": "{\n    \"dataset_name\": \"Cardiac MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University Medical Center\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_path\",\n            \"units\": \"path\"\n        },\n        {\n            \"name\": \"patient_age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Cardiac Disease Detection\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/cardiac_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Expert cardiologist annotations provided.\"\n    }\n}"}
