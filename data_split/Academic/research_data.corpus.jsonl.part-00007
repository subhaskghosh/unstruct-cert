{"_id": "Academic--research_data--p--69407", "text": "{\n    \"dataset_name\": \"UCI Machine Learning Repository - Iris Dataset\",\n    \"creator\": {\n        \"name\": \"Jeffrey Mark Siskind\",\n        \"affiliation\": \"University of California, Irvine\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"sepal_length\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"variable_name\": \"sepal_width\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"variable_name\": \"petal_length\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"variable_name\": \"petal_width\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"variable_name\": \"species\",\n            \"unit\": \"\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Collected from measurements of iris flowers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Fisher, R. A. (1936). The use of multiple measurements in taxonomic problems.\",\n            \"year\": 1936\n        }\n    ],\n    \"download_url\": \"https://archive.ics.uci.edu/ml/datasets/iris\",\n    \"metadata\": {\n        \"data_size\": \"64KB\",\n        \"annotations\": \"Contains 150 samples of iris flowers\"\n    }\n}"}
{"_id": "Academic--research_data--n--69407", "text": "{\n    \"dataset_name\": \"Customer Transaction Data\",\n    \"creator\": {\n        \"name\": \"Acme Corporation\",\n        \"affiliation\": \"Acme Industries\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"transaction_id\",\n            \"unit\": \"\"\n        },\n        {\n            \"variable_name\": \"customer_id\",\n            \"unit\": \"\"\n        },\n        {\n            \"variable_name\": \"amount\",\n            \"unit\": \"USD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary License\",\n    \"sampling_method\": \"Data collected from point-of-sale systems\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/transaction_data\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Contains data on customer purchases.\"\n    }\n}"}
