{"_id": "Academic--research_data--p--66570", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66570", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Non-commercial\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Arctic Sea Ice\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily sea ice extent data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66571", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite observations and ground stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains temperature and precipitation data from 1980 to present.\"\n    }\n}"}
