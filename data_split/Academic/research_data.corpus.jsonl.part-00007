{"_id": "Academic--research_data--n--70302", "text": "{\n    \"dataset_name\": \"Remote Sensing of Forest Health - Amazon\",\n    \"creator\": {\n        \"name\": \"National Institute for Space Research\",\n        \"affiliation\": \"INPE\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NDVI\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"EVI\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation and Forest Degradation in the Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_forest.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is derived from Landsat 8 imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70303", "text": "{\n    \"dataset_name\": \"Global Forest Change and Carbon Fluxes\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"units\": \"tons/year\"\n        },\n        {\n            \"name\": \"Biome Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis, annual composites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen et al.\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_change_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data covers global forest cover change from 2000-2023\"\n    }\n}"}
{"_id": "Academic--research_data--n--70303", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"Charles Keeling\",\n        \"affiliation\": \"Scripps Institution of Oceanography\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous atmospheric measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric CO2 Records from Mauna Loa\",\n            \"authors\": [\n                \"Keeling et al.\"\n            ],\n            \"year\": 1976\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Long-term CO2 concentration data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70304", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Dynamics - Sierra Nevada\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Forest Change in the Sierra Nevada\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes tree species identification and age estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70304", "text": "{\n    \"dataset_name\": \"Urban Air Quality - London\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Environmental Monitoring Ltd.\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Level\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring at 5 fixed stations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Real-time air quality data from London.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70305", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Radiology Department, Stanford University\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_file\",\n            \"unit\": \"path to image file\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"unit\": \"binary (0 or 1)\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective collection of patient data from hospital archives\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection in Chest X-Rays\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_pneumonia.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Images are labeled with pneumonia status (positive or negative).\"\n    }\n}"}
{"_id": "Academic--research_data--n--70305", "text": "{\n    \"dataset_name\": \"Healthy Brain MRI Scans\",\n    \"creator\": {\n        \"name\": \"Neuroimaging Research Group, Oxford\",\n        \"affiliation\": \"University of Oxford\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"subject_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"scan_date\",\n            \"unit\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"scan_type\",\n            \"unit\": \"T1-weighted, T2-weighted\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Prospective study of healthy volunteers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Normative Brain MRI Data for Aging Research\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/healthy_brain_mri.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"MRI scans from healthy individuals, used for normative data comparison.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70306", "text": "{\n    \"dataset_name\": \"High-Resolution Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors at 100 locations across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial and Temporal Patterns of Air Pollution in Urban Areas\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70306", "text": "{\n    \"dataset_name\": \"Regional Greenhouse Gas Emissions Inventory\",\n    \"creator\": {\n        \"name\": \"Global Emissions Research Group\",\n        \"affiliation\": \"International Energy Agency\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"metric tons\"\n        },\n        {\n            \"name\": \"Methane Emissions\",\n            \"units\": \"metric tons\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Annual national-level reports aggregated from member countries.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Greenhouse Gas Emissions\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ghg_emissions.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70307", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes land and ocean temperatures.\"\n    }\n}"}
