{"_id": "Academic--research_data--n--68825", "text": "{\n    \"dataset_name\": \"Historical Soil Composition Data\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Nitrogen Content\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"variable_name\": \"Phosphorus Content\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Field sampling at various agricultural sites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil nutrient mapping\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data collected from 100 different locations\"\n    }\n}"}
{"_id": "Academic--research_data--p--68826", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"MIT Environmental Solutions Initiative\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68826", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Institute\",\n        \"affiliation\": \"Private Research Foundation\"\n    },\n    \"date_collected\": \"2022-01-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"number\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Requires Permission\",\n    \"sampling_method\": \"Random sampling using research vessels.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Distribution of Deep Sea Coral\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data from underwater sensors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68827", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Historical Climatology Network-Daily Dataset\",\n            \"authors\": [\n                \"Durand, M.\",\n                \"Nicholls, N.\",\n                \"et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68827", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Thickness\",\n    \"creator\": {\n        \"name\": \"Canadian Ice Service\",\n        \"affiliation\": \"Environment and Climate Change Canada\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Thickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Ice Concentration\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Open Data Licence - Canada\",\n    \"sampling_method\": \"Satellite remote sensing and ice charts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Arctic Sea Ice Thickness\",\n            \"authors\": [\n                \"Kwok, R.\",\n                \"Comiso, J.\",\n                \"et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.eccc.gc.ca/data/ice/sea-ice-thickness/\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Data requires specialized software for analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68828", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, University of California, Berkeley\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68828", "text": "{\n    \"dataset_name\": \"Marine Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Independent Research Organization\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Water Depth\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"psu\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random sampling using research vessel\",\n    \"related_publications\": [\n        {\n            \"title\": \"Distribution of Marine Species in Coastal Regions\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68829", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data - North Atlantic\",\n    \"creator\": {\n        \"name\": \"National Oceanographic Centre, Southampton\",\n        \"affiliation\": \"University of Southampton\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular grid sampling using research vessels and autonomous buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atlantic Warming on Marine Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data_north_atlantic.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68829", "text": "{\n    \"dataset_name\": \"Global Precipitation Patterns\",\n    \"creator\": {\n        \"name\": \"World Meteorological Organization\",\n        \"affiliation\": \"WMO\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Atmospheric Pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Cloud Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Snow Depth\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Evaporation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Surface Runoff\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Vegetation Index\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Gross Primary Production\",\n            \"units\": \"gC/m^2/day\"\n        },\n        {\n            \"name\": \"Net Ecosystem Exchange\",\n            \"units\": \"gC/m^2/day\"\n        },\n        {\n            \"name\": \"Fire Radiative Power\",\n            \"units\": \"MW\"\n        },\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based weather stations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/global_precipitation.nc\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is subject to access restrictions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68830", "text": "{\n    \"dataset_name\": \"National Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Federal Government\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Air Quality in the United States\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.gov/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68830", "text": "{\n    \"dataset_name\": \"California Wildfire Emissions\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"tons\"\n        },\n        {\n            \"name\": \"PM10 Emissions\",\n            \"units\": \"kg\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing and ground measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Wildfires on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://calfiredata.org/emissions.csv\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data is spatially referenced.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68831", "text": "{\n    \"dataset_name\": \"Urban Air Quality Sensor Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley - Environmental Engineering Department\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"variable_name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        },\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from low-cost sensors deployed across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Geometry on Air Pollution Dispersion\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated against reference instruments.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68831", "text": "{\n    \"dataset_name\": \"National Emissions Inventory\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"United States Government\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"SO2\",\n            \"units\": \"tons\",\n            \"description\": \"Sulfur Dioxide emissions\"\n        },\n        {\n            \"variable_name\": \"NOx\",\n            \"units\": \"tons\",\n            \"description\": \"Nitrogen Oxides emissions\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Modeled emissions based on activity data and emission factors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in US Air Pollution\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.gov/national_emissions.xml\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Official government emissions data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68832", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Development on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality checked and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68832", "text": "{\n    \"dataset_name\": \"Historical Soil Composition Data\",\n    \"creator\": {\n        \"name\": \"GeoScience Analytics\",\n        \"affiliation\": \"Private Consulting Firm\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphorus Content\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"units\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Proprietary - Limited Use\",\n    \"sampling_method\": \"Core sampling at irregular intervals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Soil Analysis\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data requires specialized parsing tools.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68833", "text": "{\n    \"dataset_name\": \"Global Forest Watch Climate Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_cover_loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"carbon_emissions\",\n            \"unit\": \"tonnes of CO2 equivalent\"\n        },\n        {\n            \"name\": \"forest_area\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch annual report 2023\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data quality assessed and validated by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68833", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Output\",\n    \"creator\": {\n        \"name\": \"CMIP6 Collaboration\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2021-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The CMIP6 experimental design\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"5TB\",\n        \"annotations\": \"Model output from multiple climate models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68834", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
