{"_id": "Academic--research_data--p--69740", "text": "{\n    \"dataset_name\": \"Coastal Erosion Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ErosionRate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"name\": \"BeachWidth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"TideHeight\",\n            \"units\": \"feet\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular transect surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Erosion Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
