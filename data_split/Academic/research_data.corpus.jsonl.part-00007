{"_id": "Academic--research_data--p--71957", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"United States Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Water Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Sediment Weight\",\n            \"units\": \"kilograms\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal (Public Domain)\",\n    \"sampling_method\": \"Remote Sensing (Satellite Imagery and Buoy Data)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing Coastal Water Quality Using Remote Sensing\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71957", "text": "{\n    \"dataset_name\": \"Indoor Air Quality Study\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Health Sciences\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particle Count\",\n            \"units\": \"particles/m^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Direct Measurement (Sensor Networks)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ventilation on Indoor Air Quality\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/indoor_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Sensor calibration data included.\"\n    }\n}"}
