{"_id": "Academic--research_data--p--68529", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Aerosol Data - Global\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Satellite Remote Sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Aerosol Properties from MODIS\",\n            \"authors\": [\n                \"Levy et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data validated and quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68529", "text": "{\n    \"dataset_name\": \"North Pacific Ocean Temperature and Salinity\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Ocean Current Velocity\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Buoy Measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanic Variability in the North Pacific\",\n            \"authors\": [\n                \"Smith et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Data collected from moored buoys.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68530", "text": "{\n    \"dataset_name\": \"Twitter User Sentiment Analysis - 2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tweet_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"unit\": \"range -1 to 1\"\n        },\n        {\n            \"name\": \"timestamp\",\n            \"unit\": \"YYYY-MM-DD HH:mm:ss\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling of public Twitter data using the Twitter API.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Dynamics in Online Social Networks\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/twitter_sentiment_2024.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Sentiment scores calculated using a pre-trained NLP model.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68530", "text": "{\n    \"dataset_name\": \"Instagram Influencer Campaign Performance - 2023\",\n    \"creator\": {\n        \"name\": \"Market Insights Group\",\n        \"affiliation\": \"Marketing Analytics Firm\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"influencer_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"post_engagement\",\n            \"unit\": \"number of likes and comments\"\n        },\n        {\n            \"name\": \"campaign_cost\",\n            \"unit\": \"USD\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Data collected from Instagram's advertising API for a set of sponsored posts.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/influencer_campaign.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Performance metrics for Instagram marketing campaigns.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68531", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Populations\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes hourly measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68531", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Study\",\n    \"creator\": {\n        \"name\": \"Biodiversity Research Group\",\n        \"affiliation\": \"National Institute of Ecology\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Patterns of Biodiversity in Temperate Forests\",\n            \"authors\": [\n                \"Alice Brown\",\n                \"Bob Green\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data collected from multiple forest sites.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68532", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"dissolved_oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 monitoring stations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in river water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68532", "text": "{\n    \"dataset_name\": \"LakeSedimentAnalysis\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Coastal Ecosystems Research Laboratory\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sediment_organic_matter\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"grain_size\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"heavy_metal_concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Sediment cores collected annually from five lakes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sediment composition and contaminant levels in freshwater lakes\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_sediment.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data represents average sediment composition.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68533", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_UrbanAreas\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"UCAR\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"CO\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Location Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Location Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_urban.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data is quality controlled and gap-filled using interpolation.\"\n    }\n}"}
