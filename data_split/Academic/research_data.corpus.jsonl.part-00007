{"_id": "Academic--research_data--p--70189", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"time\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"uncertainty\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century: An Imperative for Climate Action\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Complete global coverage with high spatial resolution.\"\n    }\n}"}
