{"_id": "Academic--research_data--p--67382", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution License\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London boroughs.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67382", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - Amazon\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Remote sensing data combined with field surveys in the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Impacts on Amazonian Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://inpa.gov.br/amazonecosystem\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes daily measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67383", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Science Lab, University of California\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67383", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"Remote Sensing Group, NASA\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Estimates of Forest Biomass\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Derived from LiDAR data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67384", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/climate/data\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes monthly averages\"\n    }\n}"}
{"_id": "Academic--research_data--n--67384", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - 19th Century\",\n    \"creator\": {\n        \"name\": \"Royal Meteorological Society\",\n        \"affiliation\": \"University of Cambridge\"\n    },\n    \"date_collected\": \"1890-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Manual recordings from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate of the British Isles\",\n            \"year\": 1900\n        }\n    ],\n    \"download_url\": \"https://www.rmets.org/historical_data\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data is incomplete for some regions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67385", "text": "{\n    \"dataset_name\": \"CardioMRI-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Harvard Medical School\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"heart_rate\",\n            \"units\": \"bpm\"\n        },\n        {\n            \"name\": \"ejection_fraction\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Prospective MRI scans of patients with suspected heart conditions\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Automated Diagnosis of Cardiomyopathy\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/cardio_mri_2023.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Expert cardiologist-verified segmentations of cardiac structures\"\n    }\n}"}
{"_id": "Academic--research_data--n--67385", "text": "{\n    \"dataset_name\": \"ChestXRay-2021\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_resolution\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"patient_age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"chest_pain\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of chest X-ray images from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Detecting Pneumonia with Convolutional Neural Networks\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_2021.zip\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Radiologist reports indicating the presence or absence of pneumonia\"\n    }\n}"}
{"_id": "Academic--research_data--p--67386", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"Harvard University Atmospheric Chemistry Group\",\n        \"affiliation\": \"Harvard University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature at the monitoring site.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity of the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Morphology on Air Pollution\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67386", "text": "{\n    \"dataset_name\": \"Ocean Temperature Readings - Pacific\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Temperature of the ocean surface.\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\",\n            \"description\": \"Salinity of the ocean water.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Buoy-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming Trends\",\n            \"authors\": \"Johnson et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_temperature.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from research vessels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67387", "text": "{\n    \"dataset_name\": \"Global Forest Change and Carbon Flux Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland Hansen Lab\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percent\"\n        },\n        {\n            \"name\": \"carbon_stock\",\n            \"unit\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"gain\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"loss\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing, Landsat imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN/GLOBAL_FOREST_CHANGE_2020_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Global map of forest cover change\"\n    }\n}"}
{"_id": "Academic--research_data--n--67387", "text": "{\n    \"dataset_name\": \"Historical Weather Data - North America\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate at a Glance: National Centers for Environmental Information\",\n            \"authors\": [\n                \"NOAA\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/local-climatological-data/access/\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Daily weather data for North America\"\n    }\n}"}
{"_id": "Academic--research_data--p--67388", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Network\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2020-2024\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67388", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Research Institute\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Oliveira, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://amazonresearch.org/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes species identification and location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67389", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels (2021-2023)\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"co2_level\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global surface observations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global CO2 and Temperature\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_co2.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality flags and metadata on measurement methods.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67389", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns (1980-2010)\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Earth and Planetary Science\"\n    },\n    \"date_collected\": \"2010-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Regional weather station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Weather Trends in California\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been cleaned and processed for analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67390", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data cleaned and quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67390", "text": "{\n    \"dataset_name\": \"Historical Weather Data - US Cities\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily measurements from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"US Climate Normals\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Raw data from NOAA weather stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67391", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        },\n        {\n            \"variable_name\": \"Time\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global Gridded Data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Suitable for introductory climate science education.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67391", "text": "{\n    \"dataset_name\": \"High-Resolution Arctic Climate Model Output\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"NSF\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Air Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"variable_name\": \"Sea Ice Concentration\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"variable_name\": \"Ocean Salinity\",\n            \"units\": \"Practical Salinity Units\"\n        },\n        {\n            \"variable_name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"variable_name\": \"Cloud Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"variable_name\": \"Surface Pressure\",\n            \"units\": \"Pa\"\n        },\n        {\n            \"variable_name\": \"Radiation\",\n            \"units\": \"W/m^2\"\n        },\n        {\n            \"variable_name\": \"Soil Moisture\",\n            \"units\": \"m^3/m^3\"\n        },\n        {\n            \"variable_name\": \"Vegetation Type\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"variable_name\": \"Atmospheric CO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"Atmospheric O3\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"Sea Level Pressure\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"variable_name\": \"U-component of wind\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"variable_name\": \"V-component of wind\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"variable_name\": \"Relative Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"variable_name\": \"Snow Depth\",\n            \"units\": \"m\"\n        },\n        {\n            \"variable_name\": \"Ice Thickness\",\n            \"units\": \"m\"\n        },\n        {\n            \"variable_name\": \"Water Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Ocean Current Velocity\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"High-Resolution Climate Modeling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Climate Change: A High-Resolution Modeling Study\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://ncar.ucar.edu/arctic-model-data\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Advanced research dataset.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67392", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global surface temperature analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Temperature anomalies relative to the 1951-1980 mean\"\n    }\n}"}
{"_id": "Academic--research_data--n--67392", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Amazon Basin\",\n    \"creator\": {\n        \"name\": \"Brazilian National Institute for Space Research (INPE)\",\n        \"affiliation\": \"INPE\"\n    },\n    \"date_collected\": \"2018-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Research Use Only\",\n    \"sampling_method\": \"Satellite-based rainfall estimates, daily data\",\n    \"related_publications\": [\n        {\n            \"title\": \"TRMM rainfall dataset for the Amazon basin\",\n            \"authors\": [\n                \"R. Saleska\",\n                \"J. Roberts\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.inpe.br/data/rainfall/\",\n    \"metadata\": {\n        \"data_size\": \"1.8 GB\",\n        \"annotations\": \"Rainfall data with potential data gaps\"\n    }\n}"}
{"_id": "Academic--research_data--p--67393", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data validated and quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67393", "text": "{\n    \"dataset_name\": \"Rural Forest Ecosystem Carbon Fluxes\",\n    \"creator\": {\n        \"name\": \"University of Edinburgh Forest Research\",\n        \"affiliation\": \"University of Edinburgh\"\n    },\n    \"date_collected\": \"2023-06-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol/m²/s\",\n            \"description\": \"Carbon dioxide exchange rate.\"\n        },\n        {\n            \"name\": \"Water Vapor Flux\",\n            \"units\": \"mmol/m²/s\",\n            \"description\": \"Water vapor exchange rate.\"\n        },\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Temperature of the soil.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Eddy covariance measurements in a Scottish forest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Dynamics in Scottish Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_fluxes.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected during the summer growing season.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67394", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67394", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"National Geographic Society\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Temperate Forests\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data collected during a comprehensive biodiversity survey.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67395", "text": "{\n    \"dataset_name\": \"Global Forest Watch Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Carbon Emissions\",\n            \"units\": \"metric tons\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch annual report 2022\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data includes annotations on forest types and biodiversity hotspots.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67395", "text": "{\n    \"dataset_name\": \"Smart Grid Sensor Data\",\n    \"creator\": {\n        \"name\": \"Energy Research Institute\",\n        \"affiliation\": \"National University of Technology\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Voltage\",\n            \"units\": \"Volts\"\n        },\n        {\n            \"name\": \"Current\",\n            \"units\": \"Amperes\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Real-time sensor readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Smart Grid Efficiency with Machine Learning\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://eri.nu/smartgriddata\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Data contains timestamps and location information for each sensor reading.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67396", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
