{"_id": "Academic--research_data--p--67711", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Anomalies\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TemperatureAnomalies\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface observations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Report - October 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/tool/MrktTempAnom\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes monthly temperature and precipitation anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67711", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Europe\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"WheatYield\",\n            \"unit\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"CornYield\",\n            \"unit\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Agricultural surveys and statistical modeling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Food Security in Europe - 2017 Report\",\n            \"authors\": [\n                \"Garcia, L.\",\n                \"Brown, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.fao.org/faostat/en/#data\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes annual crop yields for various European countries.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67712", "text": "{\n    \"dataset_name\": \"Global Temperature and CO2 Levels\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Global Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sea Level Change\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Arctic Ice Extent\",\n            \"units\": \"sq km\",\n            \"description\": \"Measures the impact of warming on polar regions\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite measurements and ground-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Observed and Projected Climate Change\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67712", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - 1995-2010\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Daily Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Weather station readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Variability\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Missing data is denoted by -999\"\n    }\n}"}
{"_id": "Academic--research_data--p--67713", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less, a key air pollutant.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration, a secondary pollutant.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen dioxide concentration, a common traffic-related pollutant.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature recorded at the monitoring station.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity at the monitoring station.\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\",\n            \"description\": \"Wind speed at the monitoring station.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67713", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Instituto Nacional de Pesquisas da Amazônia\",\n        \"affiliation\": \"Brazilian National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"N/A\",\n            \"description\": \"Botanical name of the identified tree species.\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\",\n            \"description\": \"Height of the tree measured in meters.\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\",\n            \"description\": \"Diameter of the tree trunk measured at 1.3 meters above the ground.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random plot sampling within designated forest areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Rainforest Biodiversity Assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://amazonia.inpa.gov.br/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Species identification confirmed by expert botanists.\"\n    }\n}"}
