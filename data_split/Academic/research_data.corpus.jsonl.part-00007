{"_id": "Academic--research_data--p--71697", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Monthly Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"Year\"\n        },\n        {\n            \"name\": \"Month\",\n            \"units\": \"Month\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Global historical temperature records from multiple sources.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data has been quality controlled and includes missing value imputation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71697", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"Dr. James Anderson\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Sea Ice Thickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"Year\"\n        },\n        {\n            \"name\": \"Month\",\n            \"units\": \"Month\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite remote sensing data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Arctic Sea Ice\",\n            \"authors\": [\n                \"Anderson, J.\",\n                \"Smith, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/sea_ice_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data derived from satellite imagery. Requires specialized software to process.\"\n    }\n}"}
