{"_id": "Academic--research_data--p--71567", "text": "{\n    \"dataset_name\": \"Global Forest Change Data\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat data\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN/GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data provides annual global maps of forest loss and gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71567", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Climate Monitoring Branch\"\n    },\n    \"date_collected\": \"2021-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term climate trends in North America\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/data-access/historical-weather-data\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Historical weather data from stations across the United States.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71568", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature in Celsius.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data quality flags indicate sensor malfunctions or data gaps.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71568", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Dr. David Brown\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"percentage\",\n            \"description\": \"Percentage of area covered by forest.\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\",\n            \"description\": \"Elevation above sea level.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Trends in the Amazon\",\n            \"authors\": [\n                \"Brown, D.\",\n                \"Smith, A.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Pixel values represent forest cover class.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71569", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland / Google\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"variable_name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": \"Hansen, M. C., et al.\"\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_hansen_global_forest_change_2020_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Includes tree cover loss and gain data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71569", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"Dr. Jane Doe\",\n        \"affiliation\": \"Stanford University Climate Lab\"\n    },\n    \"date_collected\": \"2022-06-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CO2_ppm\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous measurements from Mauna Loa Observatory\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in atmospheric CO2\",\n            \"authors\": \"Doe, J., et al.\"\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"High-resolution CO2 concentration data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71570", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CO2_Concentration\",\n            \"units\": \"ppm\",\n            \"description\": \"Atmospheric concentration of carbon dioxide in parts per million.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\",\n            \"description\": \"Air temperature measured in degrees Celsius.\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity as a percentage.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Systematic grid sampling across urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Urban CO2 on Local Climate\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, W.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71570", "text": "{\n    \"dataset_name\": \"Ocean Current Velocity Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"U_Velocity\",\n            \"units\": \"m/s\",\n            \"description\": \"Eastward component of ocean current velocity.\"\n        },\n        {\n            \"variable_name\": \"V_Velocity\",\n            \"units\": \"m/s\",\n            \"description\": \"Northward component of ocean current velocity.\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA-4.0\",\n    \"sampling_method\": \"Opportunistic sampling during research cruises.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Dynamics of Ocean Currents\",\n            \"authors\": [\n                \"Davis, R.\",\n                \"Smith, J.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data calibrated using standard oceanographic methods.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71571", "text": "{\n    \"dataset_name\": \"Coastal Temperature Trends\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara - Marine Science Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Systematic grid sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Warming Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71571", "text": "{\n    \"dataset_name\": \"Global Climate Observations\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"Pascals\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Opportunistic observations from research vessels\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Patterns\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/global_climate.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71572", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute of California\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-10T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Monoxide (CO)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide (NO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic Density on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes flags for data quality and missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71572", "text": "{\n    \"dataset_name\": \"Industrial Emission Levels - 2022\",\n    \"creator\": {\n        \"name\": \"ChemCorp Industries\",\n        \"affiliation\": \"ChemCorp Inc.\"\n    },\n    \"date_collected\": \"2022-11-15T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sulfur Dioxide (SO2)\",\n            \"units\": \"mg/m3\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Weekly stack emission tests\",\n    \"related_publications\": [],\n    \"download_url\": \"https://chemcorp.com/emission_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is subject to confidentiality agreements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71573", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Civil, Environmental and Geomatic Engineering\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included for each measurement\"\n    }\n}"}
{"_id": "Academic--research_data--n--71573", "text": "{\n    \"dataset_name\": \"Historical Soil Composition - Rural Scotland\",\n    \"creator\": {\n        \"name\": \"Alastair McGregor\",\n        \"affiliation\": \"Scottish Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2018-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"units\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Periodic sampling from various locations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/scottish_soil.xml\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data collected over a 5-year period\"\n    }\n}"}
{"_id": "Academic--research_data--p--71574", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71574", "text": "{\n    \"dataset_name\": \"AirPollutionMeasurements\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Private Environmental Consulting Firm\"\n    },\n    \"date_collected\": \"2023-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Continuous monitoring using stationary sensors.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data is pre-processed for noise reduction.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71575", "text": "{\n    \"dataset_name\": \"US Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in the United States\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71575", "text": "{\n    \"dataset_name\": \"European Water Quality Assessment\",\n    \"creator\": {\n        \"name\": \"University of Berlin\",\n        \"affiliation\": \"Germany\"\n    },\n    \"date_collected\": \"2023-07-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ph\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"conductivity\",\n            \"units\": \"mS/cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"River sampling campaigns\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality in European Rivers\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_europe.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes location coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71576", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - Chesapeake Bay\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Maryland Center for Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen (mg/L)\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity (PSU)\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Turbidity (NTU)\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensor buoys deployed at 10 locations throughout the Chesapeake Bay. Data logged every 15 minutes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Chesapeake Bay water quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chesapeake_bay_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data has been quality controlled and flagged for outliers.\",\n        \"sensor_types\": [\n            \"DO sensor\",\n            \"Salinity sensor\",\n            \"Temperature sensor\",\n            \"Turbidity sensor\"\n        ]\n    }\n}"}
{"_id": "Academic--research_data--n--71576", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Basal Area\",\n            \"units\": \"m^2/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected plots within the Amazon rainforest. Tree species and diameters measured manually.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the Amazon\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Species identification verified by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71577", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 different locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality controlled and outliers removed.\"\n    }\n}"}
