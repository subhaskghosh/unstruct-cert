{"_id": "Academic--research_data--p--68651", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"E. coli Count\",\n            \"unit\": \"CFU/100mL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic sampling at fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
