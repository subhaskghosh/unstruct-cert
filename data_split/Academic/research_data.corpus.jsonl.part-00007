{"_id": "Academic--research_data--n--71472", "text": "{\n    \"dataset_name\": \"Global Oceanographic Survey\",\n    \"creator\": {\n        \"name\": \"Ocean Research Institute\",\n        \"affiliation\": \"Marine Biology Department\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"unit\": \"m\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nutrient Concentration (Nitrate)\",\n            \"unit\": \"µmol/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"unit\": \"µg/L\"\n        },\n        {\n            \"name\": \"Phytoplankton Species\",\n            \"unit\": \"count/mL\"\n        },\n        {\n            \"name\": \"Current Velocity (Eastward)\",\n            \"unit\": \"m/s\"\n        },\n        {\n            \"name\": \"Current Velocity (Northward)\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Currents and Marine Life\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://oceanresearch.org/data/global_ocean.nc\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
