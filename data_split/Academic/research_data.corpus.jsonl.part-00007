{"_id": "Academic--research_data--n--71970", "text": "{\n    \"dataset_name\": \"ForestInventoryData\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"TimberCorp Inc.\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"DBH\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary Commercial License\",\n    \"sampling_method\": \"Systematic grid sampling within managed forest lands.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://timbercorp.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Preliminary inventory data; limited quality control.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71971", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology, Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of Ozone in parts per billion\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71971", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery (GLAD)\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"%\",\n            \"description\": \"Percent tree cover in the year 2000\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"Year\",\n            \"description\": \"Year of forest loss\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen, M.C.\",\n                \"Potapov, P.V.\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Raster data with spatial resolution of 30m\"\n    }\n}"}
{"_id": "Academic--research_data--p--71972", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data has been pre-processed for missing values and outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71972", "text": "{\n    \"dataset_name\": \"SensorReadings_RuralArea\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-05-20T12:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Hourly readings from a single sensor.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/sensor_rural.json\",\n    \"metadata\": {\n        \"data_size\": \"2.2MB\",\n        \"annotations\": \"Raw sensor data, no pre-processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71973", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London, Environmental Research Group\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included for each measurement. Calibration information available.\",\n        \"data_quality\": \"High\"\n    }\n}"}
{"_id": "Academic--research_data--n--71973", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of Washington, Forest Ecology Department\"\n    },\n    \"date_collected\": \"2022-11-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements in remote forests\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ecosystem Dynamics in Remote Landscapes\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_ecosystem.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data includes remotely sensed vegetation indices.\",\n        \"data_quality\": \"Medium\"\n    }\n}"}
{"_id": "Academic--research_data--p--71974", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Chicago 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Chicago, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chicago_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71974", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Data - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Dr. Kenji Tanaka\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Research vessel transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Ocean Temperature and Salinity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_marine.json\",\n    \"metadata\": {\n        \"data_size\": \"60MB\",\n        \"annotations\": \"Data collected during a research expedition.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71975", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Oceanographic Research Institute\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Water Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Automated sensor buoys deployed at 5 key coastal locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Coastal Ecosystems\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags and sensor calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71975", "text": "{\n    \"dataset_name\": \"Urban Traffic Flow\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"City Planning Department\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Vehicle Count\",\n            \"units\": \"vehicles/hour\"\n        },\n        {\n            \"name\": \"Average Speed\",\n            \"units\": \"km/h\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Loop detectors and traffic cameras at major intersections.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Traffic Modeling\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/traffic_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes vehicle type classification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71976", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Civil, Environmental and Geomatic Engineering\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"unit\": \"ppb\",\n            \"description\": \"Nitrogen dioxide concentration.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Distributed sensor network deployed across London, collecting data every 15 minutes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Design on Air Quality: A Case Study of London\",\n            \"journal\": \"Environmental Science & Technology\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included for sensor calibration and missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71976", "text": "{\n    \"dataset_name\": \"Rural Forest Carbon Sequestration - Amazon 2022-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"unit\": \"tons/hectare\",\n            \"description\": \"Total biomass of trees and shrubs above ground.\"\n        },\n        {\n            \"name\": \"Soil Carbon\",\n            \"unit\": \"kg/m²\",\n            \"description\": \"Carbon content in the soil.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Individual plot measurements taken at randomly selected locations within the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Dynamics in Amazonian Forests\",\n            \"journal\": \"Forest Ecology and Management\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_carbon_data.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data represents measurements from 50 sample plots.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71977", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ground-level ozone.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71977", "text": "{\n    \"dataset_name\": \"Coral Reef Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of seafloor covered by coral.\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Temperature of the surrounding water.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"SCUBA diving surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Effect of Climate Change on Coral Reefs\",\n            \"authors\": [\n                \"Jones, B.\",\n                \"Williams, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Images included with data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71978", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley Environmental Science Department\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regularly spaced sampling points along the river, collected monthly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71978", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Levels\",\n    \"creator\": {\n        \"name\": \"Massachusetts Institute of Technology\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Major Cities\",\n            \"authors\": [\n                \"Alice Brown\",\n                \"Bob Johnson\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
