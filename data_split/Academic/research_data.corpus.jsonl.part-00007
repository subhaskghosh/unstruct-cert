{"_id": "Academic--research_data--p--70506", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Data\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m2/m2\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Central Amazon\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes species identification and ecological measurements.\"\n    }\n}"}
