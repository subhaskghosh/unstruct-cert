{"_id": "Academic--research_data--p--70127", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Extended Reconstructed Sea Surface Temperature (ERSST)\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"sea_surface_temperature\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Monthly sea surface temperature anomalies\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees North\",\n            \"description\": \"Latitude of the measurement\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees East\",\n            \"description\": \"Longitude of the measurement\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global ocean buoy measurements and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Extended Reconstructed Sea Surface Temperature (ERSST) version 5\",\n            \"authors\": [\n                \"Huang\",\n                \"et al.\"\n            ],\n            \"year\": 2017\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ersst/v5/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly anomalies relative to the 1981-2010 base period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70127", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover - City of Exampleville\",\n    \"creator\": {\n        \"name\": \"City of Exampleville Planning Department\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"tree_canopy_cover\",\n            \"units\": \"percentage\",\n            \"description\": \"Percentage of land area covered by tree canopy.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"High-resolution aerial imagery analysis\",\n    \"related_publications\": [],\n    \"download_url\": \"http://exampleville.gov/treecoverdata\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data based on 2023 imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70128", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Stock\",\n            \"unit\": \"Mg/ha\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"unit\": \"categorical\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Carbon Stock Assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes quality flags for each measurement\"\n    }\n}"}
