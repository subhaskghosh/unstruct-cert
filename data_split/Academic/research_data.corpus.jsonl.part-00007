{"_id": "Academic--research_data--p--70697", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        },\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70697", "text": "{\n    \"dataset_name\": \"Student Survey on Climate Change Awareness\",\n    \"creator\": {\n        \"name\": \"University Research Group\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Awareness\",\n            \"units\": \"Scale of 1-5\",\n            \"description\": \"Student awareness of climate change\"\n        },\n        {\n            \"variable_name\": \"Concern\",\n            \"units\": \"Scale of 1-5\",\n            \"description\": \"Level of student concern\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Online survey\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/student_survey.csv\",\n    \"metadata\": {\n        \"data_size\": \"1MB\",\n        \"annotations\": \"Raw survey responses\"\n    }\n}"}
{"_id": "Academic--research_data--p--70698", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Data\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"unit\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random stratified sampling across 100 plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the central Amazon\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes species identification and environmental variables.\"\n    }\n}"}
