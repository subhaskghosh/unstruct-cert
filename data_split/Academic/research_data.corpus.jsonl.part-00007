{"_id": "Academic--research_data--p--70859", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"United States Department of Commerce\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global surface temperature measurements from weather stations and satellites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70859", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Institute\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2018-08-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Crop Yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Farm surveys and government reports.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rainfall on Crop Yields\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Yield data for major crops in the region.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70860", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
