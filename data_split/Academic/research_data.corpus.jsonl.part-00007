{"_id": "Academic--research_data--n--68731", "text": "{\n    \"dataset_name\": \"Remote Forest Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"Research Division\"\n    },\n    \"date_collected\": \"2024-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground-based sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment Report\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://forestry.gov/foresthealth.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes metadata about satellite calibration.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68732", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, University College London\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature in Celsius.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68732", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Data - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Institute\",\n        \"affiliation\": \"University of Hawaii\"\n    },\n    \"date_collected\": \"2024-01-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\",\n            \"description\": \"Salinity of seawater.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Seawater temperature.\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Research vessel transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Ecosystem Dynamics\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_marine_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data collected during a research expedition.\"\n    }\n}"}
