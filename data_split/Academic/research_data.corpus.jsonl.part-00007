{"_id": "Academic--research_data--n--70111", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Stock\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Forestry Research Agency\"\n    },\n    \"date_collected\": \"2021-08-22T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Carbon Stock\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Carbon Dynamics\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.tif\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Raster data with spatial resolution of 30m\"\n    }\n}"}
{"_id": "Academic--research_data--p--70112", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Emily Carter\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples collected from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70112", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Li Wei\",\n        \"affiliation\": \"Chinese Academy of Sciences\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring from fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Assessment in a Megacity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"3MB\",\n        \"annotations\": \"Data is raw and requires further processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70113", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NCEI\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        },\n        {\n            \"name\": \"Measurement Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and ocean buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70113", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"Local Meteorology Institute\",\n        \"affiliation\": \"City University\"\n    },\n    \"date_collected\": \"2022-12-20T12:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"inches Hg\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/weather_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"None.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70114", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database - 2023-2024\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Grab samples collected weekly from designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/national-water-quality-monitoring-database\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags and station metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70114", "text": "{\n    \"dataset_name\": \"Air Pollution Data - Urban Centers\",\n    \"creator\": {\n        \"name\": \"Global Air Quality Consortium\",\n        \"affiliation\": \"GAQC\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed urban stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Urban Air Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.gaqc.org/airdata\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data includes sensor calibration information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70115", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global grid cells, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Report 2022\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Contains monthly temperature anomalies relative to a baseline period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70115", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2022-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Coral Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"variable_name\": \"Reef Location\",\n            \"units\": \"GPS coordinates\"\n        },\n        {\n            \"variable_name\": \"Water Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random transects along Great Barrier Reef\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Bleaching Patterns\",\n            \"authors\": [\n                \"Hughes, T.P.\",\n                \"Kerry, J.T.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_survey.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Survey data on coral species and reef health.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70116", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70116", "text": "{\n    \"dataset_name\": \"Historical Weather Data\",\n    \"creator\": {\n        \"name\": \"Robert Davis\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2022-12-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Trends in North America\",\n            \"authors\": \"Davis et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is missing for some stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70117", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Chicago\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"University of Illinois at Chicago\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"particulate_matter_2.5\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Populations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chicago_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70117", "text": "{\n    \"dataset_name\": \"Coral Reef Health Monitoring - Great Barrier Reef\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"James Cook University\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"coral_cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"water_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Climate Change on Coral Reef Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/great_barrier_reef_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Image data available upon request\"\n    }\n}"}
{"_id": "Academic--research_data--p--70118", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70118", "text": "{\n    \"dataset_name\": \"AirPollutionLevels\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Air Quality in Urban Areas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data is hourly averaged.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70119", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - v4\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"unit\": \"W/m^2\"\n        },\n        {\n            \"name\": \"Sea Level Pressure\",\n            \"unit\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global warming in the 21st century: An unprecedented rate of change\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes quality control flags and uncertainty estimates.\"\n    }\n}"}
