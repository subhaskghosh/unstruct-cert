{"_id": "Academic--research_data--p--69471", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2020 Onwards\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global surface temperature measurements from land and ocean stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2020.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains monthly average temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69471", "text": "{\n    \"dataset_name\": \"Historical Climate Data - 1950-2019\",\n    \"creator\": {\n        \"name\": \"Hadley Centre for Climate Prediction and Research\",\n        \"affiliation\": \"Met Office\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Open Data Commons Open Database License\",\n    \"sampling_method\": \"Historical weather station data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Past Climate Variability\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_climate.nc\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Provides daily climate data from 1950 to 2019.\"\n    }\n}"}
