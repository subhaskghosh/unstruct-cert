{"_id": "Academic--research_data--p--68372", "text": "{\n    \"dataset_name\": \"Global Precipitation Measurements - Climate Change Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"precipitation_rate\",\n            \"units\": \"mm/hr\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Remote sensing using GPM satellite constellation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Advancements in Global Precipitation Monitoring\",\n            \"year\": 2023\n        },\n        {\n            \"title\": \"Climate Change Impacts on Precipitation Patterns\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/gpm_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68372", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns - 1990s\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"1995-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"mph\"\n        },\n        {\n            \"name\": \"pressure\",\n            \"units\": \"inches Hg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Weather Trends in North America\",\n            \"year\": 1998\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Missing data values represented as NaN\"\n    }\n}"}
{"_id": "Academic--research_data--p--68373", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"gain\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"loss\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Landsat satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_hansen_global_forest_change_2020_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"100 GB\",\n        \"annotations\": \"Extensive documentation and user guides available.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68373", "text": "{\n    \"dataset_name\": \"Historical Weather Data - Europe\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-12-24T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/\",\n    \"metadata\": {\n        \"data_size\": \"20 GB\",\n        \"annotations\": \"Basic README file provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68374", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"OpenAQ\",\n        \"affiliation\": \"Non-profit organization\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache-2.0\",\n    \"sampling_method\": \"Network of ground-based sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in PM2.5 Concentrations\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://openaq.org/data\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68374", "text": "{\n    \"dataset_name\": \"Human Gene Expression Atlas\",\n    \"creator\": {\n        \"name\": \"Human Protein Atlas Consortium\",\n        \"affiliation\": \"KTH Royal Institute of Technology\"\n    },\n    \"date_collected\": \"2023-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Gene Expression Level\",\n            \"units\": \"RPKM\"\n        },\n        {\n            \"name\": \"Tissue Type\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"RNA sequencing of human tissue samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"A human protein atlas of the transcriptome\",\n            \"year\": 2016\n        }\n    ],\n    \"download_url\": \"https://www.proteinatlas.org/data\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Data includes quality control metrics for RNA sequencing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68375", "text": "{\n    \"dataset_name\": \"Lake Superior Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Minnesota, Large Lakes Observatory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic grab samples collected monthly at fixed locations, with laboratory analysis following EPA protocols.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Superior water quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, B.\"\n            ],\n            \"journal\": \"Journal of Great Lakes Research\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakesuperior_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
