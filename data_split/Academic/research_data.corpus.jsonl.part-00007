{"_id": "Academic--research_data--n--71132", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Smithsonian Tropical Research Institute\",\n        \"affiliation\": \"STRI\"\n    },\n    \"date_collected\": \"2022-12-20T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"number of individuals\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual species identification and counts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity hotspots in the Amazon rainforest\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"60MB\",\n        \"annotations\": \"Data includes images of collected species\"\n    }\n}"}
{"_id": "Academic--research_data--p--71133", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global meteorological station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\",\n                \"Ruedy, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Contains monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71133", "text": "{\n    \"dataset_name\": \"Canadian Forest Fire Emissions\",\n    \"creator\": {\n        \"name\": \"University of Alberta Research Group\",\n        \"affiliation\": \"University of Alberta\"\n    },\n    \"date_collected\": \"2021-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"Burned Area\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Forest Fires on Air Quality\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://forestfiredata.ualberta.ca\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Daily emissions from forest fires in Canada.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71134", "text": "{\n    \"dataset_name\": \"Urban Air and Water Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Water pH\",\n            \"units\": \"pH\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations throughout urban London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_water.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71134", "text": "{\n    \"dataset_name\": \"Remote Sensing of Amazon Rainforest Biodiversity\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"University of São Paulo\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NDVI\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Satellite imagery analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment using Remote Sensing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.tif\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"High-resolution satellite imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71135", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic emissions on urban air quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags and station locations.\"\n    }\n}"}
