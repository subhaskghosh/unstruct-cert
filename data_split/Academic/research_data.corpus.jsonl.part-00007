{"_id": "Academic--research_data--n--68710", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Inventory\",\n    \"creator\": {\n        \"name\": \"Remote Sensing Applications Team, University of Minnesota\",\n        \"affiliation\": \"University of Minnesota\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Carbon Stock\",\n            \"units\": \"tonnes C/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite remote sensing and field measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping forest carbon stocks using LiDAR\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68711", "text": "{\n    \"dataset_name\": \"Global Forest Watch - Tree Cover Loss\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover_loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"carbon_emissions\",\n            \"unit\": \"tonnes CO2e\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat data\"\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/datasets/tree-cover-loss\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes annual tree cover loss from 2000 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68711", "text": "{\n    \"dataset_name\": \"Economic Impact of Climate Change on Agriculture\",\n    \"creator\": {\n        \"name\": \"Agricultural Economics Research Institute\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"crop_yield\",\n            \"unit\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"market_price\",\n            \"unit\": \"USD/ton\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Economic modeling and statistical analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate change and agricultural productivity\"\n        }\n    ],\n    \"download_url\": \"http://aeri.ucdavis.edu/data/climate_impact\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Dataset focused on economic impacts on agricultural sectors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68712", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Centers - 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across major metropolitan areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data is quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68712", "text": "{\n    \"dataset_name\": \"Soil Composition Analysis - Agricultural Lands\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Group\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphorus Content\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium Content\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random sampling of soil cores from agricultural fields.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Fertilizer Use for Crop Yield\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes measurements from various soil depths.\"\n    }\n}"}
