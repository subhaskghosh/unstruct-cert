{"_id": "Academic--research_data--n--71494", "text": "{\n    \"dataset_name\": \"European Air Quality Measurements - 2022\",\n    \"creator\": {\n        \"name\": \"European Environmental Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"nitrogen_dioxide\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Hourly measurements at fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe - 2023 Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/european_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data is pre-processed and cleaned.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71495", "text": "{\n    \"dataset_name\": \"Global Atmospheric CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71495", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"Local Weather Enthusiast Group\",\n        \"affiliation\": \"Community Organization\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Manual recordings from local weather stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Missing data present\"\n    }\n}"}
{"_id": "Academic--research_data--p--71496", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in urban air pollution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been quality-controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
