{"_id": "Academic--research_data--n--71919", "text": "{\n    \"dataset_name\": \"Local Weather Patterns - 2018\",\n    \"creator\": {\n        \"name\": \"Community Weather Watch\",\n        \"affiliation\": \"Local Volunteers\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Manual readings from local sensors\",\n    \"related_publications\": [],\n    \"download_url\": \"https://communityweather.org/data\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data collected from 2018 in a single city\"\n    }\n}"}
{"_id": "Academic--research_data--p--71920", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Includes data quality flags and station locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71920", "text": "{\n    \"dataset_name\": \"Rural Biodiversity Survey - Scotland\",\n    \"creator\": {\n        \"name\": \"Scottish Natural Heritage\",\n        \"affiliation\": \"Ecology Department\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Habitat Type\",\n            \"units\": \"category\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Random transect surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Scottish Highlands\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.snh.gov.uk/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Includes species identification notes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71921", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"University of Michigan Water Center\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from various locations around Lake Erie.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Lake Erie Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        },\n        {\n            \"title\": \"Impact of Nutrient Runoff on Lake Erie Ecosystems\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71921", "text": "{\n    \"dataset_name\": \"Global Air Pollution Dataset\",\n    \"creator\": {\n        \"name\": \"OpenAQ\",\n        \"affiliation\": \"OpenAQ\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Data aggregated from various monitoring stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial and Temporal Patterns of Air Pollution\",\n            \"authors\": [\n                \"Garcia, M.\",\n                \"Lee, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"60MB\",\n        \"annotations\": \"Data includes metadata about monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71922", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"USEPA\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Grab samples collected monthly at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Water Quality in the United States\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.example.com/waterqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71922", "text": "{\n    \"dataset_name\": \"Air Pollution Levels in Urban Areas\",\n    \"creator\": {\n        \"name\": \"City of London Corporation\",\n        \"affiliation\": \"CLC\"\n    },\n    \"date_collected\": \"2022-01-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Continuous monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.com/airqualitydata.xml\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is preliminary.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71923", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global weather station network and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71923", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"Local City Planning Department\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_canopy_cover\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"urban_area\",\n            \"units\": \"square meters\"\n        }\n    ],\n    \"data_format\": \"Shapefile\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Aerial imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Forestry Report\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/tree_cover.shp\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Accuracy assessed using ground truth data\"\n    }\n}"}
{"_id": "Academic--research_data--p--71924", "text": "{\n    \"dataset_name\": \"Global Precipitation Dataset (GPCP) v2.3\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees_north\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees_east\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite and ground-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Global Precipitation Climatology Project (GPCP) Combined Precipitation Dataset\",\n            \"authors\": [\n                \"Huffman, G. J.\",\n                \"Joyce, R. J.\",\n                \"Janowiak, J. E.\",\n                \"Arkin, P. A.\",\n                \"Xie, P.\",\n                \"Yoshioka, M.\",\n                \"Schneider, R. E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/data-access/severe-weather-datasets/global-historical-climatology-network-daily\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"High-resolution global precipitation data\"\n    }\n}"}
{"_id": "Academic--research_data--n--71924", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"Hadley Centre\",\n        \"affiliation\": \"Met Office\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Open Database License\",\n    \"sampling_method\": \"Global network of weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global surface temperature variations and trends\",\n            \"authors\": [\n                \"Brohan, P.\",\n                \"Kennedy, J. J.\",\n                \"Harris, I.\",\n                \"Trewin, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.metoffice.gov.uk/hadobs/hadcrut5/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Global average temperature data\"\n    }\n}"}
{"_id": "Academic--research_data--p--71925", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Automated sensor buoys deployed at various locations throughout Lake Erie.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_wq_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated. Includes metadata on sensor locations and maintenance logs.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71925", "text": "{\n    \"dataset_name\": \"Global Air Pollution Data - 2022-2023\",\n    \"creator\": {\n        \"name\": \"World Health Organization (WHO)\",\n        \"affiliation\": \"Department of Public Health\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Data aggregated from ground-based monitoring stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The impact of air pollution on global health\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is preliminary and subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71926", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, UCL\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes hourly averages from 50 monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71926", "text": "{\n    \"dataset_name\": \"Remote Forest Carbon Flux - Amazon 2023\",\n    \"creator\": {\n        \"name\": \"Amazon Rainforest Research Consortium\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol/m²/s\"\n        },\n        {\n            \"name\": \"Water Vapor Flux\",\n            \"units\": \"mmol/m²/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Eddy covariance measurements in remote Amazonian forests\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Dynamics in the Amazon Basin\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_carbon_flux.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data collected from 10 tower sites within the Amazon rainforest.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71927", "text": "{\n    \"dataset_name\": \"AirQualityRemoteSensingData\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Remote Sensing of Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71927", "text": "{\n    \"dataset_name\": \"HistoricalClimateData\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Weather stations across the United States\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climatedata.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Missing value imputation applied.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71928", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2022-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly discrete samples collected from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_mendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71928", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Elena Ramirez\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2018-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect surveys conducted quarterly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity patterns in the Amazon\",\n            \"authors\": [\n                \"Ramirez, E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Species identification verified by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71929", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"unit\": \"ppb\",\n            \"description\": \"Nitrogen dioxide concentration.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic Emissions on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71929", "text": "{\n    \"dataset_name\": \"Industrial Emissions Inventory - Germany\",\n    \"creator\": {\n        \"name\": \"Federal Environment Agency\",\n        \"affiliation\": \"German Government\"\n    },\n    \"date_collected\": \"2022-12-31T18:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2\",\n            \"unit\": \"tonnes\"\n        },\n        {\n            \"name\": \"CO2\",\n            \"unit\": \"tonnes\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Government Open Data License\",\n    \"sampling_method\": \"Annual reporting by industrial facilities\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/germany_emissions_2022.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\"\n    }\n}"}
{"_id": "Academic--research_data--p--71930", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2021\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2021-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 2.5 micrometers or less in diameter.\"\n        },\n        {\n            \"variable_name\": \"PM10\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter 10 micrometers or less in diameter.\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration.\"\n        },\n        {\n            \"variable_name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative Humidity.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": \"Carter, E., et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data cleaned and validated for missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71930", "text": "{\n    \"dataset_name\": \"Rural Soil Composition Analysis\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"N/A\",\n            \"description\": \"Soil pH level.\"\n        },\n        {\n            \"variable_name\": \"Nitrogen\",\n            \"units\": \"mg/kg\",\n            \"description\": \"Nitrogen content in soil.\"\n        },\n        {\n            \"variable_name\": \"Phosphorus\",\n            \"units\": \"mg/kg\",\n            \"description\": \"Phosphorus content in soil.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random soil samples collected from agricultural fields.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71931", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Seattle\",\n    \"creator\": {\n        \"name\": \"University of Washington Atmospheric Sciences Department\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter 2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations deployed across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial and Temporal Patterns of Air Pollution in Seattle\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/seattle_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71931", "text": "{\n    \"dataset_name\": \"Indoor Air Quality in Office Buildings\",\n    \"creator\": {\n        \"name\": \"Stanford Environmental Health Lab\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Volatile Organic Compounds\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Sensor network deployed in office buildings.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ventilation on Indoor Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/indoor_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data was collected during peak office hours.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71932", "text": "{\n    \"dataset_name\": \"Global Land and Atmospheric Temperature Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Atmospheric CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface measurements and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
