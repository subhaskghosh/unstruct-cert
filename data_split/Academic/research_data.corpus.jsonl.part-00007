{"_id": "Academic--research_data--n--66076", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall Amount\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Station ID\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily precipitation measurements at weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Variability\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Daily rainfall data from across the US\"\n    }\n}"}
{"_id": "Academic--research_data--p--66077", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Recent Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"TemperatureAnom\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Monthly global temperature anomaly relative to the 1951-1980 mean.\"\n        },\n        {\n            \"variable_name\": \"Year\",\n            \"units\": \"year\",\n            \"description\": \"Year of observation.\"\n        },\n        {\n            \"variable_name\": \"Month\",\n            \"units\": \"month\",\n            \"description\": \"Month of observation.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global surface temperature measurements from meteorological stations, satellite observations, and sea surface temperature measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"authors\": \"Hansen, J., et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Includes uncertainty estimates for temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66077", "text": "{\n    \"dataset_name\": \"Historical Rainfall Patterns in the Amazon\",\n    \"creator\": {\n        \"name\": \"INPE - National Institute for Space Research\",\n        \"affiliation\": \"Brazilian Government\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Rainfall\",\n            \"units\": \"mm\",\n            \"description\": \"Daily rainfall accumulation.\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Latitude coordinate.\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees\",\n            \"description\": \"Longitude coordinate.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite-based precipitation estimates.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Amazon Rainfall Trends\",\n            \"authors\": \"Marengo, J., et al.\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"2.5 MB\",\n        \"annotations\": \"Data includes quality flags.\"\n    }\n}"}
