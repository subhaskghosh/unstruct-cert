{"_id": "Academic--research_data--p--68222", "text": "{\n    \"dataset_name\": \"Urban Temperature Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Environmental Research Group\"\n    },\n    \"date_collected\": \"2023-07-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"location\",\n            \"units\": \"latitude, longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using sensor network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effect in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality checked and validated.\"\n    }\n}"}
