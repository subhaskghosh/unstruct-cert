{"_id": "Academic--research_data--n--70225", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phytoplankton Density\",\n            \"units\": \"cells/mL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Research vessel surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Marine Biodiversity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data collected from coastal regions.\"\n    }\n}"}
