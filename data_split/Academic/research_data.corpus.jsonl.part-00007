{"_id": "Academic--research_data--n--68780", "text": "{\n    \"dataset_name\": \"NOAA Global Surface Summary of the Day\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Maximum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Historical Climatology Network\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/noaa_global_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"750MB\",\n        \"annotations\": \"Data includes missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68781", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute of California\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68781", "text": "{\n    \"dataset_name\": \"Plant Species Distribution\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"unit\": \"N/A\",\n            \"description\": \"Name of the plant species.\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\",\n            \"description\": \"Geographic latitude.\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\",\n            \"description\": \"Geographic longitude.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random sampling in forest ecosystems\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Forest Regions\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Brown, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/plant_distribution.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data includes species classification information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68782", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Environmental Science and Technology\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Nitrogen dioxide concentration.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"authors\": \"Smith et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68782", "text": "{\n    \"dataset_name\": \"Soil Nutrient Levels - Rural Farms\",\n    \"creator\": {\n        \"name\": \"Local Agricultural Cooperative\",\n        \"affiliation\": \"Rural Farming Initiative\"\n    },\n    \"date_collected\": \"2022-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Nitrogen\",\n            \"units\": \"ppm\",\n            \"description\": \"Nitrogen content in soil.\"\n        },\n        {\n            \"variable_name\": \"Phosphorus\",\n            \"units\": \"ppm\",\n            \"description\": \"Phosphorus content in soil.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Limited Use\",\n    \"sampling_method\": \"Random soil samples collected bi-annually\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/soil_nutrients.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Minimal data documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68783", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68783", "text": "{\n    \"dataset_name\": \"Forest Biodiversity in Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Sofia Ramirez\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of different species observed.\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\",\n            \"description\": \"Number of trees per hectare.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"All Rights Reserved\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"authors\": [\n                \"Ramirez, S.\",\n                \"Silva, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Species identifications verified by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68784", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"National Water Quality Monitoring Council\"\n    },\n    \"date_collected\": \"2023-11-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic grab samples collected monthly at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Assessment of River Water Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/national-river-water-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags are included for each variable.\",\n        \"last_updated\": \"2024-01-20T14:00:00Z\"\n    }\n}"}
