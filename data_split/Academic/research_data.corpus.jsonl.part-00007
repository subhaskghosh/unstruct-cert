{"_id": "Academic--research_data--p--67858", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University Medical Center\"\n    },\n    \"date_collected\": \"2023-06-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Tumor Grade\",\n            \"units\": \"Scale of 1-4\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"Years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Prospective cohort study with standardized MRI protocols.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation using Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Manual annotations by board-certified radiologists.\"\n    }\n}"}
