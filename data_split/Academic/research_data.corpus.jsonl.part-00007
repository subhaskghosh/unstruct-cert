{"_id": "Academic--research_data--n--69377", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis Dataset\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"TechCorp Research\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tweet_text\",\n            \"units\": \"text\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"units\": \"scale of -1 to 1\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"API collection from Twitter\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis in Social Media\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/sentiment_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes tweets and associated sentiment scores.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69378", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies (Land and Ocean)\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2020-02-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Surface Temperature Analysis\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--69378", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center (NSIDC)\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Trends\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Daily and monthly sea ice extent data\"\n    }\n}"}
{"_id": "Academic--research_data--p--69379", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Year\",\n            \"units\": \"Year\"\n        },\n        {\n            \"name\": \"Mean Global Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Average Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Ocean Average Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Uncertainty\",\n            \"units\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global average calculated from station data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data includes annual global temperature anomalies since 1880.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69379", "text": "{\n    \"dataset_name\": \"Forest Fire Emissions\",\n    \"creator\": {\n        \"name\": \"European Forest Fire Information System (EFFIS)\",\n        \"affiliation\": \"European Commission\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Fire Name\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Burned Area\",\n            \"units\": \"Hectares\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground reports.\",\n    \"related_publications\": [\n        {\n            \"title\": \"EFFIS Report 2021\",\n            \"authors\": [\n                \"San-Miguel-Ayanz, J.\",\n                \"Romero-Callejo, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://effis.jrc.ec.europa.eu/\",\n    \"metadata\": {\n        \"data_size\": \"500 KB\",\n        \"annotations\": \"Data on forest fires in Europe, Africa, and the Middle East.\"\n    }\n}"}
