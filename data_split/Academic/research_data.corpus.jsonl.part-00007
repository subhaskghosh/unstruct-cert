{"_id": "Academic--research_data--n--66190", "text": "{\n    \"dataset_name\": \"Historical Weather Data 1980-2019\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Station-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"US Climate Normals\",\n            \"year\": 2010\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Daily weather observations from stations across the US.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66191", "text": "{\n    \"dataset_name\": \"Lung Cancer CT Scan Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Research Group\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ImageID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"ScanType\",\n            \"units\": \"CT\"\n        },\n        {\n            \"name\": \"NodulePresence\",\n            \"units\": \"Boolean\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Early Detection of Lung Cancer with Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_cancer_ct_scans\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Radiologist-verified nodule locations\"\n    }\n}"}
{"_id": "Academic--research_data--n--66191", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Neuroimaging Lab\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SubjectID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"MRSequence\",\n            \"units\": \"T1-weighted, T2-weighted\"\n        },\n        {\n            \"name\": \"BrainRegion\",\n            \"units\": \"Region of the brain\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling from patient database\",\n    \"related_publications\": [\n        {\n            \"title\": \"Structural MRI Analysis of Alzheimer's Disease\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_data\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Automated segmentation of brain structures\"\n    }\n}"}
{"_id": "Academic--research_data--p--66192", "text": "{\n    \"dataset_name\": \"Climate Change Impact on Coastal Ecosystems\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Level\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"individuals/m^2\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Random stratified sampling along the coastline.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Sea Level Rise on Coastal Biodiversity\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66192", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"National Weather Service\"\n    },\n    \"date_collected\": \"2022-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Automated weather stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"authors\": \"Smith, J.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data contains missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66193", "text": "{\n    \"dataset_name\": \"Simulated Patient Data for Heart Disease Prediction\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"systolic_blood_pressure\",\n            \"units\": \"mmHg\"\n        },\n        {\n            \"name\": \"cholesterol\",\n            \"units\": \"mg/dL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predicting Heart Disease with Machine Learning\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/heart_disease_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data includes features commonly used for heart disease prediction.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66193", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis Data\",\n    \"creator\": {\n        \"name\": \"David Brown\",\n        \"affiliation\": \"Tech Solutions Inc.\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tweet_text\",\n            \"units\": \"text\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"units\": \"scale of -1 to 1\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"API access to Twitter data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis of Twitter Data\",\n            \"authors\": [\n                \"Brown, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/sentiment_data.json\",\n    \"metadata\": {\n        \"data_size\": \"800KB\",\n        \"annotations\": \"Data contains tweets and their associated sentiment scores.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66194", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes temperature anomalies relative to a 1951-1980 baseline.\"\n    }\n}"}
