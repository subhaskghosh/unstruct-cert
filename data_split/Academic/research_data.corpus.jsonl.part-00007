{"_id": "Academic--research_data--p--68012", "text": "{\n    \"dataset_name\": \"Local Air Quality and Temperature Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Institute for Environmental Research, University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter 2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous on-site measurements using calibrated sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Local Emissions on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68012", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery (GLAD)\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"Meters\"\n        },\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"Tons/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change Assessment\",\n            \"authors\": [\n                \"Hansen, M.C.\",\n                \"Potapov, P.V.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Satellite imagery processed and classified.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68013", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Atmospheric Greenhouse Gases\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68013", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Health Indicators\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Phytoplankton Biomass\",\n            \"units\": \"mg/m^3\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Ocean Acidity\",\n            \"units\": \"pH\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Monthly sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Ocean Warming on Marine Life\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Spatial coverage limited to coastal regions.\"\n    }\n}"}
