{"_id": "Academic--research_data--p--67890", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Comprehensive documentation and quality control procedures are included.\"\n    }\n}"}
