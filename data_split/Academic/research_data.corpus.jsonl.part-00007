{"_id": "Academic--research_data--p--71411", "text": "{\n    \"dataset_name\": \"North American Atmospheric CO2 Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2021-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"parts per million\"\n        },\n        {\n            \"name\": \"Temperature (Celsius)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees West\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/noaa_co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71411", "text": "{\n    \"dataset_name\": \"European Soil Moisture Data\",\n    \"creator\": {\n        \"name\": \"European Space Agency\",\n        \"affiliation\": \"Climate Change Initiative\"\n    },\n    \"date_collected\": \"2019-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"m³/m³\"\n        },\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"Kelvin\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-SA 3.0\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Monitoring European Soil Moisture\",\n            \"authors\": [\n                \"Garcia, M.\",\n                \"Lee, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/esa_soil_moisture.nc\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data validated against in-situ measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71412", "text": "{\n    \"dataset_name\": \"National Ecological Observatory Network (NEON) Plant Phenology Data\",\n    \"creator\": {\n        \"name\": \"NEON Program\",\n        \"affiliation\": \"National Science Foundation\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"leaf_area_index\",\n            \"units\": \"m2/m2\"\n        },\n        {\n            \"name\": \"plant_height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"stem_diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"greenness_index\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Random stratified sampling across continental US\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial and temporal dynamics of plant phenology in the contiguous United States\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\",\n                \"Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.neonscience.org/data-access/data-download\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71412", "text": "{\n    \"dataset_name\": \"Simulated Forest Fire Spread Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Computational modeling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Modeling Forest Fire Behavior Under Climate Change Scenarios\",\n            \"authors\": [\n                \"Carter\",\n                \"Lee\",\n                \"Davis\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.edu/forest_fire_data\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Simulation parameters documented\"\n    }\n}"}
{"_id": "Academic--research_data--p--71413", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Toronto\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 monitoring stations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Lake Erie Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 MB\",\n        \"annotations\": \"Data quality flagged for outliers.\"\n    }\n}"}
