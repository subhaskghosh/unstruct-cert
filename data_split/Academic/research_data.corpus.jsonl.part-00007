{"_id": "Academic--research_data--p--70741", "text": "{\n    \"dataset_name\": \"North American Bird Migration Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across North America.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Migratory Patterns of North American Birds\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Bird species identified to the lowest taxonomic level.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70741", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"Data Insights Corp\",\n        \"affiliation\": \"Private Company\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"tweet_text\",\n            \"units\": \"text\"\n        },\n        {\n            \"variable_name\": \"user_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"variable_name\": \"sentiment_score\",\n            \"units\": \"scale of 0 to 1\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"API query to Twitter.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Online Sentiment\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Brown, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Sentiment scores generated by a machine learning model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70742", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoringData\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"NitrateConcentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of River Water Quality in the United States\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Each row represents a sample, with columns corresponding to measured variables. Missing values are indicated by 'NA'.\",\n        \"data_quality_flags\": \"Flags indicate potential data quality issues, such as sensor malfunctions or calibration errors.\"\n    }\n}"}
