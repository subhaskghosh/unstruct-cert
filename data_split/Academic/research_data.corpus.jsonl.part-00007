{"_id": "Academic--research_data--p--68369", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular depth profiles collected weekly during the ice-free season.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality in Lake Mendota\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://limnology.wisc.edu/data/mendota_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68369", "text": "{\n    \"dataset_name\": \"Global Industrial Effluent Monitoring\",\n    \"creator\": {\n        \"name\": \"ChemCorp Solutions\",\n        \"affiliation\": \"ChemCorp Inc.\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Effluent Discharge Rate\",\n            \"units\": \"m3/day\"\n        },\n        {\n            \"name\": \"Chemical Oxygen Demand\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Proprietary - Limited Use\",\n    \"sampling_method\": \"Continuous monitoring of industrial wastewater discharge.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://chemcorpsolutions.com/effluentdata\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data requires account registration.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68370", "text": "{\n    \"dataset_name\": \"Rural Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Environmental Health\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Active air sampling using portable monitors and passive diffusion tubes\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Practices on Rural Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/rural_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data collected from remote agricultural sites.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68370", "text": "{\n    \"dataset_name\": \"Urban Pollution Study - 2022\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"City University Research Center\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"VOCs\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Passive diffusion tubes deployed across city centers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution Trends in Major Cities\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_pollution_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data collected primarily from high-traffic urban areas.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68371", "text": "{\n    \"dataset_name\": \"RiverWaterQualityData_2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at multiple locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Includes metadata on sampling locations and weather conditions.\"\n    }\n}"}
