{"_id": "Academic--research_data--p--67788", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Monoxide (CO)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide (NO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Licence\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2020-2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67788", "text": "{\n    \"dataset_name\": \"River Water Quality Assessment - Thames\",\n    \"creator\": {\n        \"name\": \"Environment Agency\",\n        \"affiliation\": \"Water Quality Division\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Crown Copyright\",\n    \"sampling_method\": \"Weekly grab samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Water Quality Report - Thames River Basin\",\n            \"authors\": [\n                \"Brown, C.\",\n                \"Davis, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://environment.data.gov.uk/waterquality.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes weekly average concentrations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67789", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoys and discrete water samples collected bi-weekly.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/datasets/lake-erie-water-quality\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is quality controlled and includes flags for potential errors.\"\n    }\n}"}
