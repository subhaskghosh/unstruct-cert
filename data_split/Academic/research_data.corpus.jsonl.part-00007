{"_id": "Academic--research_data--n--70753", "text": "{\n    \"dataset_name\": \"Indoor Plant Growth Experiment\",\n    \"creator\": {\n        \"name\": \"Botany Department\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plant Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Leaf Area\",\n            \"units\": \"cm²\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Controlled environment chamber with daily measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effect of Light Intensity on Plant Growth\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/plant_growth_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes species and treatment information.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70754", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface observations and satellite measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-temperature/access/monitoring/time-series/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly average temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--70754", "text": "{\n    \"dataset_name\": \"Historical Weather Data - 1990-2019\",\n    \"creator\": {\n        \"name\": \"National Weather Service\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily weather station observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Variability\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.weather.gov/data\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Hourly weather readings from across the United States.\"\n    }\n}"}
