{"_id": "Academic--research_data--n--67123", "text": "{\n    \"dataset_name\": \"Soil Moisture Levels in Agricultural Fields\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Green\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Nitrogen Levels\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Random soil samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Irrigation Strategies\",\n            \"authors\": [\n                \"Green, R.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_moisture_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data represents average values across multiple fields.\"\n    }\n}"}
