{"_id": "Academic--research_data--p--68173", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Global temperature station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Includes quality control flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68173", "text": "{\n    \"dataset_name\": \"Regional Precipitation Patterns\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0\",\n    \"sampling_method\": \"Rain gauge network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Precipitation Trends in California\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/precipitation_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Limited documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68174", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - Land and Ocean\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global observational network of weather stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature in 2022\",\n            \"authors\": [\n                \"Hansen, J.\",\n                \"Sato, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68174", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Simulations\",\n    \"creator\": {\n        \"name\": \"Various\",\n        \"affiliation\": \"International Climate Modeling Consortium\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations using various Earth System Models.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The CMIP6 Model Ensemble\",\n            \"authors\": [\n                \"Eyring, V.\",\n                \"Boucher, O.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Contains climate projections under different scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68175", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring - 2022\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA Great Lakes National Program Office\"\n    },\n    \"date_collected\": \"2022-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors and periodic grab samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of Water Quality in Lake Erie\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_wq_2022.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality controlled and flagged for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68175", "text": "{\n    \"dataset_name\": \"Historical River Flow Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA National Water Center\"\n    },\n    \"date_collected\": \"2018-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Streamflow\",\n            \"units\": \"cubic feet per second\"\n        },\n        {\n            \"name\": \"Water Level\",\n            \"units\": \"feet\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Manual gauge readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in River Flow\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/river_flow_history.txt\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Raw data, minimal quality control.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68176", "text": "{\n    \"dataset_name\": \"Land Use Change and Biodiversity in Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Ferreira\",\n        \"affiliation\": \"National Institute of Amazonian Research (INPA)\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Cover Type\",\n            \"unit\": \"Categorical\"\n        },\n        {\n            \"name\": \"Species Richness\",\n            \"unit\": \"Species/km^2\"\n        },\n        {\n            \"name\": \"Population Density\",\n            \"unit\": \"People/km^2\"\n        },\n        {\n            \"name\": \"Deforestation Rate\",\n            \"unit\": \"% per year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random Stratified Sampling across 100km x 100km grid cells\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Land Use Change on Amazonian Biodiversity\",\n            \"authors\": [\n                \"Ferreira, I.\",\n                \"Silva, J.\",\n                \"Oliveira, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Data includes quality control flags and detailed metadata for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68176", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment - Great Barrier Reef\",\n    \"creator\": {\n        \"name\": \"Dr. David Chen\",\n        \"affiliation\": \"Australian Institute of Marine Science (AIMS)\"\n    },\n    \"date_collected\": \"2023-08-22T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Algae Biomass\",\n            \"unit\": \"mg/m^2\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Transect surveys at 50 randomly selected reef sites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Monitoring Coral Reef Health in a Changing Climate\",\n            \"authors\": [\n                \"Chen, D.\",\n                \"Lee, A.\",\n                \"Brown, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data includes spatial coordinates and imagery metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68177", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Limnology Lab\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Carbon Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from various depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_mendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68177", "text": "{\n    \"dataset_name\": \"Beijing Air Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Ecology and Environment Bureau\",\n        \"affiliation\": \"BMEEB\"\n    },\n    \"date_collected\": \"2023-11-01T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Continuous monitoring from fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air pollution and health in Beijing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Real-time data updates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68178", "text": "{\n    \"dataset_name\": \"Global Lake Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"International Water Quality Consortium\",\n        \"affiliation\": \"Global Environmental Agency\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"unit\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Regular sampling from designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Lake Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Includes quality control flags for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68178", "text": "{\n    \"dataset_name\": \"California Irrigation Runoff Analysis\",\n    \"creator\": {\n        \"name\": \"UC Davis Water Resources Group\",\n        \"affiliation\": \"University of California, Davis\"\n    },\n    \"date_collected\": \"2018-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Runoff Volume\",\n            \"unit\": \"m^3\"\n        },\n        {\n            \"name\": \"Pesticide Concentration\",\n            \"unit\": \"ug/L\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Monitoring runoff from agricultural fields.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Irrigation on Water Quality in California\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ca_runoff.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Limited metadata; basic variable descriptions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68179", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London, Department of Environmental Science\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_london.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68179", "text": "{\n    \"dataset_name\": \"GlobalOceanCurrents\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Institute\",\n        \"affiliation\": \"Marine Science Organization\"\n    },\n    \"date_collected\": \"2024-01-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CurrentSpeed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-4.0\",\n    \"sampling_method\": \"Satellite and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Ocean Currents\",\n            \"authors\": [\n                \"Smith, B.\",\n                \"Davis, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.nc\",\n    \"metadata\": {\n        \"data_size\": \"700MB\",\n        \"annotations\": \"Data processed using advanced oceanographic models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68180", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
