{"_id": "Academic--research_data--p--67213", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, A.\"\n            ]\n        },\n        {\n            \"title\": \"Impact of Aerosols on Climate Change\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Smith, B.\",\n                \"Carter, E.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67213", "text": "{\n    \"dataset_name\": \"Ocean Temperature Records\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Buoy measurements and ship-based surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Ocean Temperature\",\n            \"year\": 2022,\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data gaps filled using interpolation.\"\n    }\n}"}
