{"_id": "Academic--research_data--p--71748", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (NIH)\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Radiologist Impression\",\n            \"units\": \"text\"\n        },\n        {\n            \"name\": \"Image Quality\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Presence of Nodules\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective collection from clinical records\",\n    \"related_publications\": [\n        {\n            \"title\": \"CheXpert: Large Scale Chest X-Ray Interpretation\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"4.2GB\",\n        \"annotations\": \"Radiologist reports included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71748", "text": "{\n    \"dataset_name\": \"Synthetic Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"University of Simulated Data\",\n        \"affiliation\": \"Department of Artificial Intelligence\"\n    },\n    \"date_collected\": \"2024-01-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"Tumor Location\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Tumor Volume\",\n            \"units\": \"mm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Generative Adversarial Network (GAN)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Generating Realistic Medical Images with GANs\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/synthetic_brain_mri\",\n    \"metadata\": {\n        \"data_size\": \"2.8GB\",\n        \"annotations\": \"Automated annotations based on generation parameters\"\n    }\n}"}
