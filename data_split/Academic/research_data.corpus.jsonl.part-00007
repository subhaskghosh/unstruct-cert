{"_id": "Academic--research_data--p--67030", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, King's College London\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2 concentration\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5 concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone concentration\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality in London: Trends and health impacts\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes hourly averages\"\n    }\n}"}
{"_id": "Academic--research_data--n--67030", "text": "{\n    \"dataset_name\": \"Indoor Air Quality in Office Buildings\",\n    \"creator\": {\n        \"name\": \"Building Environment Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"VOC concentration\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Sensor network in office spaces\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of ventilation on indoor air quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/indoor_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes measurements from multiple rooms\"\n    }\n}"}
{"_id": "Academic--research_data--p--67031", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoringData\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at designated locations along the river.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67031", "text": "{\n    \"dataset_name\": \"AirQualityMeasurements\",\n    \"creator\": {\n        \"name\": \"City Air Monitoring Department\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2023-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67032", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"World Air Quality Index (WAQI)\",\n        \"affiliation\": \"WAQI Corporation\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM25\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Assessment of Air Pollution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://waqi.info/data/\",\n    \"metadata\": {\n        \"data_size\": \"15GB\",\n        \"annotations\": \"Data includes quality control flags and station metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67032", "text": "{\n    \"dataset_name\": \"Local Rainfall Data - City Park\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"City Park Department\"\n    },\n    \"date_collected\": \"2022-12-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"Excel\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Manual rainfall gauge readings\",\n    \"related_publications\": [],\n    \"download_url\": \"http://citypark.example.com/rainfall_data.xlsx\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data collected by volunteers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67033", "text": "{\n    \"dataset_name\": \"National Rivers and Streams Assessment (NRSA) - 2023\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"Office of Research and Development\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"E. coli Count\",\n            \"units\": \"CFU/100mL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Randomly selected river and stream sites across the US, using a stratified random sampling design.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Rivers and Streams Assessment 2023: Results and Findings\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/nrsa/data-and-downloads\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags and validation reports included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67033", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2023\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Department of Geographical Sciences\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Gain in Tree Cover\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Satellite imagery analysis, using Landsat data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"authors\": [\n                \"Hansen, M.C.\",\n                \"Potapov, P.V.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.org/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"5.5 GB\",\n        \"annotations\": \"Raster data with associated metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67034", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Research Group\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution License\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Air Quality Report 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67034", "text": "{\n    \"dataset_name\": \"OceanCurrents_Pacific_2022\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Pacific Marine Environmental Laboratory\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Current Speed\",\n            \"unit\": \"m/s\"\n        },\n        {\n            \"name\": \"Current Direction\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Buoy measurements and model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Circulation Patterns\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.noaa.gov/ocean_currents.nc\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Requires specialized software for analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67035", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"variable_name\": \"Atmospheric CO2 Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global grid of surface stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A Review\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67035", "text": "{\n    \"dataset_name\": \"Historical Weather Records 1950-2010\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2010-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"Text\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Weather stations across North America\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Variability\",\n            \"year\": 2015\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Limited metadata available\"\n    }\n}"}
