{"_id": "Academic--research_data--p--67412", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, University College London\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CO\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"O3\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes hourly averages\"\n    }\n}"}
{"_id": "Academic--research_data--n--67412", "text": "{\n    \"dataset_name\": \"Soil Nutrient Levels in Agricultural Fields\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Institute\",\n        \"affiliation\": \"National Institute of Agricultural Sciences\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Nitrogen\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"variable_name\": \"Phosphorus\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"variable_name\": \"Potassium\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random soil sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Health Assessment\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_nutrients.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data represents composite samples\"\n    }\n}"}
{"_id": "Academic--research_data--p--67413", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Atmospheric Composition\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data_urban.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67413", "text": "{\n    \"dataset_name\": \"Glacial Ice Core Data - Antarctic\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"British Antarctic Survey\"\n    },\n    \"date_collected\": \"2023-01-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Deuterium Isotope Ratio\",\n            \"units\": \"‰\"\n        },\n        {\n            \"name\": \"Ice Thickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Gas Bubble Concentration\",\n            \"units\": \"bubbles/mL\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Ice core drilling and analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Paleoclimate Reconstruction from Antarctic Ice Cores\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/antarctic_ice_cores.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Age model provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--67414", "text": "{\n    \"dataset_name\": \"Global Forest Change Data\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery (GLAD)\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"journal\": \"Nature Climate Change\"\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Provides annual tree cover loss data globally, useful for tracking deforestation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67414", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in London\",\n    \"creator\": {\n        \"name\": \"King's College London\",\n        \"affiliation\": \"Environmental Research Group\"\n    },\n    \"date_collected\": \"2022-12-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2 concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM2.5 concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government License\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air pollution exposure and respiratory health in London\",\n            \"authors\": \"Kelly, F. J., et al.\",\n            \"journal\": \"Environmental Health Perspectives\"\n        }\n    ],\n    \"download_url\": \"https://www.londonair.org.uk/data\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Hourly air quality measurements from a network of monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67415", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"ug/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Discrete water samples collected weekly from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality in Lake Mendota\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67415", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Environmental Monitoring Center\",\n        \"affiliation\": \"BEMC\"\n    },\n    \"date_collected\": \"2023-05-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Continuous monitoring from fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in a Megacity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67416", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67416", "text": "{\n    \"dataset_name\": \"Bird Species Observations in Forests\",\n    \"creator\": {\n        \"name\": \"Ornithological Society\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Observation Count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Location Latitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bird Migration Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_observations.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data collected by volunteers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67417", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen (mg/L)\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"variable_name\": \"Turbidity (NTU)\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular spaced buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Quality control flags included\",\n        \"data_provenance\": \"Automated buoy system with laboratory verification.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67417", "text": "{\n    \"dataset_name\": \"Forest Birdsong Recordings\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"variable_name\": \"Recording Duration\",\n            \"units\": \"seconds\"\n        }\n    ],\n    \"data_format\": \"WAV\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Passive acoustic monitoring\",\n    \"related_publications\": [\n        {\n            \"title\": \"Acoustic diversity in Californian forests\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/birdsong_data.zip\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Species identified by expert ornithologists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67418", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
