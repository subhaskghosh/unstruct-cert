{"_id": "Academic--research_data--p--70762", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2023-2024\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        },\n        {\n            \"title\": \"Impacts of Climate Change on Coastal Regions\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        },\n        {\n            \"title\": \"Long-Term Temperature Records\",\n            \"authors\": [\n                \"Wilson, K.\",\n                \"Garcia, R.\"\n            ]\n        },\n        {\n            \"title\": \"Climate Modelling and Projections\",\n            \"authors\": [\n                \"Rodriguez, S.\",\n                \"Lee, T.\"\n            ]\n        },\n        {\n            \"title\": \"Regional Variations in Temperature Anomalies\",\n            \"authors\": [\n                \"Kim, H.\",\n                \"Patel, N.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes monthly temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70762", "text": "{\n    \"dataset_name\": \"Forest Inventory Data - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"US Forest Service\",\n        \"affiliation\": \"Department of Agriculture\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"centimeters\"\n        },\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Growth in the Pacific Northwest\",\n            \"authors\": [\n                \"Anderson, P.\"\n            ]\n        },\n        {\n            \"title\": \"Tree Species Distribution\",\n            \"authors\": [\n                \"Thompson, Q.\"\n            ]\n        },\n        {\n            \"title\": \"Sustainable Forest Management\",\n            \"authors\": [\n                \"White, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_inventory.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes tree measurements within specified plots.\"\n    }\n}"}
