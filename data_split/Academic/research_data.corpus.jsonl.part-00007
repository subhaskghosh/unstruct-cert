{"_id": "Academic--research_data--p--71151", "text": "{\n    \"dataset_name\": \"Species Distribution in Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"variable_name\": \"altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"distance_to_river\",\n            \"units\": \"kilometers\"\n        },\n        {\n            \"variable_name\": \"species_count\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial Distribution of Key Species in the Amazon\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_species.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Georeferenced data with species presence/absence.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71151", "text": "{\n    \"dataset_name\": \"Butterfly Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2019-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"wing_span\",\n            \"units\": \"centimeters\"\n        },\n        {\n            \"variable_name\": \"migration_speed\",\n            \"units\": \"km/h\"\n        },\n        {\n            \"variable_name\": \"flight_duration\",\n            \"units\": \"hours\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Opportunistic Observation\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/butterfly_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data collected during annual butterfly migrations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71152", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Laboratory\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 500 monitoring sites across the US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality in the United States\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data quality flags included for each variable.\"\n    }\n}"}
