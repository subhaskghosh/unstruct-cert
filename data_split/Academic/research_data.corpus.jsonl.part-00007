{"_id": "Academic--research_data--p--71202", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"variable_name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen, M. C.\",\n                \"Potapov, P. V.\",\n                \"Moore, R.\",\n                \"Hancher, M.\",\n                \"Turubanova, S. A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/dataset/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Provides yearly tree cover loss and gain maps globally.\"\n    }\n}"}
