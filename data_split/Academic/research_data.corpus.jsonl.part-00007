{"_id": "Academic--research_data--n--68117", "text": "{\n    \"dataset_name\": \"North Atlantic Ocean Temperature Profiles\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"WHOI\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ship-based CTD measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean temperature variability in the North Atlantic\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temperature.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Limited documentation available.\"\n    }\n}"}
