{"_id": "Academic--research_data--p--70122", "text": "{\n    \"dataset_name\": \"High-Resolution Arctic Temperature Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across the Arctic\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Temperature Trends in the Arctic\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
