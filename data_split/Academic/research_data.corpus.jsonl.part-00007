{"_id": "Academic--research_data--p--69254", "text": "{\n    \"dataset_name\": \"Ocean Plastic Distribution - North Pacific Gyre\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Scripps Institution of Oceanography\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Plastic Concentration\",\n            \"units\": \"particles/m^3\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Manta trawl with surface and depth filtration\",\n    \"related_publications\": [\n        {\n            \"title\": \"Microplastic Abundance in the North Pacific Subtropical Gyre\",\n            \"year\": 2024,\n            \"journal\": \"Environmental Science & Technology\"\n        }\n    ],\n    \"download_url\": \"https://example.com/oceanplastic.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes size classification of plastic particles.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69254", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"AirWatch Ltd.\",\n        \"affiliation\": \"Environmental Monitoring Agency\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m^3\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations throughout London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Air Pollution in Urban Environments\",\n            \"year\": 2023,\n            \"journal\": \"Atmospheric Environment\"\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitylondon.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes hourly averages and daily summaries.\"\n    }\n}"}
