{"_id": "Academic--research_data--n--68848", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of British Columbia\"\n    },\n    \"date_collected\": \"2022-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Forest Biomass Globally\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is derived from multiple sources and has inherent uncertainties.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68849", "text": "{\n    \"dataset_name\": \"NOAA Global Ocean Temperature Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"sea_surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Warming Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/noaa_ocean_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68849", "text": "{\n    \"dataset_name\": \"Global Land Cover Classification\",\n    \"creator\": {\n        \"name\": \"European Space Agency (ESA)\",\n        \"affiliation\": \"Climate Change Initiative\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"land_cover_type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"variable_name\": \"pixel_value\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Land Cover\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/land_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Raster data with spatial coordinates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68850", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling within forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Dynamics in California Forests\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags for sensor readings.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68850", "text": "{\n    \"dataset_name\": \"Global Climate Model Outputs\",\n    \"creator\": {\n        \"name\": \"Climate Research Consortium\",\n        \"affiliation\": \"International Organization\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"CO2_concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Model simulation outputs\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_model.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"High-resolution climate model data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68851", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide (CO2)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane (CH4)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone (O3)\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of atmospheric monitoring stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in atmospheric greenhouse gases\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_atmosphere_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data quality flags included for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68851", "text": "{\n    \"dataset_name\": \"Local Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"London Environmental Agency\",\n        \"affiliation\": \"City of London\"\n    },\n    \"date_collected\": \"2021-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide (NO2)\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Continuous monitoring at 20 fixed locations within Greater London.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://londonair.gov.uk/data.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68852", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery (GLAD)\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"variable_name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen, M. C.\",\n                \"Potapov, P. V.\",\n                \"Moore, R.\",\n                \"Hancher, M.\",\n                \"Turubanova, S. A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"150 GB\",\n        \"annotations\": \"Dataset provides yearly global forest loss and gain data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68852", "text": "{\n    \"dataset_name\": \"Indoor Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Local High School\"\n    },\n    \"date_collected\": \"2022-05-20T12:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"CO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Sensor readings collected in a classroom environment.\",\n    \"related_publications\": [],\n    \"download_url\": \"http://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"2 MB\",\n        \"annotations\": \"Short-term air quality measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68853", "text": "{\n    \"dataset_name\": \"Public Sentiment on Climate Change - Multiplatform\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"user_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"post_text\",\n            \"unit\": \"text\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"unit\": \"scale of -1 to 1\"\n        },\n        {\n            \"name\": \"platform\",\n            \"unit\": \"string (Twitter, Facebook, Reddit)\"\n        },\n        {\n            \"name\": \"location\",\n            \"unit\": \"city, country\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Random sampling of public posts with climate change keywords\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Sentiment on Climate Change Using Social Media Data\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_sentiment_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Sentiment analysis scores provided for each post.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68853", "text": "{\n    \"dataset_name\": \"Marketing Campaign Performance - Twitter\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Acme Marketing Agency\"\n    },\n    \"date_collected\": \"2023-08-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tweet_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"tweet_text\",\n            \"unit\": \"text\"\n        },\n        {\n            \"name\": \"engagement_rate\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"campaign_id\",\n            \"unit\": \"unique identifier\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Data collected from a specific marketing campaign on Twitter.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/twitter_marketing_data.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Engagement metrics for each tweet.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68854", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2022-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples collected from multiple depths\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68854", "text": "{\n    \"dataset_name\": \"Global Ocean Salinity Data\",\n    \"creator\": {\n        \"name\": \"National Oceanography Centre\",\n        \"affiliation\": \"University of Southampton\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Ship-based conductivity, temperature, and depth (CTD) measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Variability of global ocean salinity\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/global_ocean_salinity.nc\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data has been corrected for drift.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68855", "text": "{\n    \"dataset_name\": \"Global Monthly Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"average_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"total_precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global surface observations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Summary\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-monthly-temperature-and-precipitation-data/access/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly averages for temperature and precipitation worldwide.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68855", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Europe\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization of the United Nations (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"wheat_yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"corn_yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"country_code\",\n            \"units\": \"ISO 3166\"\n        }\n    ],\n    \"data_format\": \"XLSX\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"National agricultural statistics\",\n    \"related_publications\": [\n        {\n            \"title\": \"World Food Situation\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"http://www.fao.org/faostat/en/#data\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Historical data on crop yields across European countries.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68856", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring - Colorado 2024\",\n    \"creator\": {\n        \"name\": \"Colorado Department of Public Health & Environment\",\n        \"affiliation\": \"CDPHE\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 20 river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Colorado River Basin Water Quality Assessment\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/colorado_river_wq_2024.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68856", "text": "{\n    \"dataset_name\": \"Global Ocean Salinity Data\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Institute\",\n        \"affiliation\": \"ORI\"\n    },\n    \"date_collected\": \"2022-11-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ship-based conductivity measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Salinity Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_ocean_salinity.nc\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Data has been processed to remove outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68857", "text": "{\n    \"dataset_name\": \"Lake Water Quality Monitoring - 2024\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 10 locations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Lake Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68857", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Dataset - 2023\",\n    \"creator\": {\n        \"name\": \"Atmospheric Research Group\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from a fixed monitoring station.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Gases\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data has been calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68858", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Beta\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley - Environmental Science Lab\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring sensors deployed across urban areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Design on Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data has been quality checked and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68858", "text": "{\n    \"dataset_name\": \"National Air Quality Database\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"United States Government\"\n    },\n    \"date_collected\": \"2024-04-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"unit\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Nationwide network of monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Air Pollutant Levels\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://epa.gov/air_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Official government data on air quality.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68859", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Animal Behavior Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"animal_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"behavior_type\",\n            \"units\": \"categorical (foraging, resting, mating, etc.)\"\n        },\n        {\n            \"name\": \"location_x\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"location_y\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"timestamp\",\n            \"units\": \"seconds\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Camera trap footage with automated behavior recognition\",\n    \"related_publications\": [\n        {\n            \"title\": \"Behavioral Ecology of Amazonian Primates\",\n            \"authors\": [\n                \"Rossi, I.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_animal_behavior.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Behavioral events labeled by expert ecologists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68859", "text": "{\n    \"dataset_name\": \"Andes Mountain Flora Composition\",\n    \"creator\": {\n        \"name\": \"Dr. Alejandro Vargas\",\n        \"affiliation\": \"University of the Andes\"\n    },\n    \"date_collected\": \"2023-08-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"elevation\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"abundance\",\n            \"units\": \"number of individuals\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Quadrat sampling along elevation gradients\",\n    \"related_publications\": [\n        {\n            \"title\": \"Plant Biodiversity in the Andes Mountains\",\n            \"authors\": [\n                \"Vargas, A.\",\n                \"Lopez, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/andes_flora.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Species identification verified by botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68860", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2023\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"Sea Level Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Global meteorological stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68860", "text": "{\n    \"dataset_name\": \"Historical Crop Yields in Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa Department of Agriculture\",\n        \"affiliation\": \"State of Iowa\"\n    },\n    \"date_collected\": \"2021-08-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Corn Yield\",\n            \"units\": \"bushels/acre\"\n        },\n        {\n            \"variable_name\": \"Soybean Yield\",\n            \"units\": \"bushels/acre\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted - Requires Agreement\",\n    \"sampling_method\": \"Farm surveys and agricultural reports\",\n    \"related_publications\": [\n        {\n            \"title\": \"Iowa Crop Production\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is preliminary and subject to revision\"\n    }\n}"}
{"_id": "Academic--research_data--p--68861", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68861", "text": "{\n    \"dataset_name\": \"Coral Reef Health Survey - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Alex Johnson\",\n        \"affiliation\": \"Marine Biology Institute\"\n    },\n    \"date_collected\": \"2023-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of seabed covered by live coral.\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"kg/m²\",\n            \"description\": \"Biomass of fish species.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Climate Change on Coral Reefs\",\n            \"authors\": [\n                \"Johnson, A.\",\n                \"Smith, B.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Geographic coordinates included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68862", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68862", "text": "{\n    \"dataset_name\": \"ForestBiodiversitySurvey\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"NFS\"\n    },\n    \"date_collected\": \"2023-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"centimeters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Transect surveys conducted annually.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Biodiversity in a Changing Landscape\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes geographic coordinates of each survey point.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68863", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68863", "text": "{\n    \"dataset_name\": \"Coral Reef Health Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"°C\"\n        },\n        {\n            \"name\": \"Fish Diversity\",\n            \"unit\": \"Species Count\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual surveys and water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bleaching Events and Coral Reef Decline\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Data includes species identification and habitat classification.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68864", "text": "{\n    \"dataset_name\": \"North American River Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency (EPA)\",\n        \"affiliation\": \"United States Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular sampling from designated river monitoring stations across North America.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of Water Quality Trends in Major North American Rivers\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/north_america_river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68864", "text": "{\n    \"dataset_name\": \"European Soil Composition Dataset\",\n    \"creator\": {\n        \"name\": \"European Soil Bureau\",\n        \"affiliation\": \"Joint Research Centre, European Commission\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Organic Carbon Content\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Soil pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Bulk Density\",\n            \"units\": \"g/cm^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Grid-based soil sampling across Europe.\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Soil Data Centre Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/european_soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes spatial coordinates for each sample.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68865", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Dataset\",\n    \"creator\": {\n        \"name\": \"University of Leeds, Earth Observation Group\",\n        \"affiliation\": \"University of Leeds\"\n    },\n    \"date_collected\": \"2023-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"variable_name\": \"Forest Type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data combined with ground-truth measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping global forest biomass with high spatial resolution\",\n            \"authors\": \"...\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68865", "text": "{\n    \"dataset_name\": \"Regional Atmospheric Composition Study\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"NCAR\"\n    },\n    \"date_collected\": \"2021-03-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Atmospheric modeling and simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Ozone Transport and Chemistry\",\n            \"authors\": \"...\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data is generated from a regional atmospheric model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68866", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, King's College London\",\n        \"affiliation\": \"King's College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration.\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68866", "text": "{\n    \"dataset_name\": \"SoilComposition_Scotland\",\n    \"creator\": {\n        \"name\": \"Scottish Agricultural College\",\n        \"affiliation\": \"SRUC\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"units\",\n            \"description\": \"Soil pH level\"\n        },\n        {\n            \"variable_name\": \"OrganicMatter\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of organic matter in the soil\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Random soil samples collected across Scotland\",\n    \"related_publications\": [\n        {\n            \"title\": \"Scottish Soil Analysis\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/scottish_soil.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data represents composite samples.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68867", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": \"Carter, E. et al.\",\n            \"journal\": \"Environmental Science & Technology\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"65MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68867", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change 2020\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2020-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Forest Cover\",\n            \"units\": \"percentage\",\n            \"description\": \"Percentage of forest cover in a given area\"\n        },\n        {\n            \"variable_name\": \"Land Use Type\",\n            \"units\": \"categorical\",\n            \"description\": \"Type of land use (forest, agriculture, urban, etc.)\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change Assessment\",\n            \"authors\": \"Hansen, M. C. et al.\",\n            \"journal\": \"Science\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_2020.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Raster data with spatial resolution of 30m\"\n    }\n}"}
