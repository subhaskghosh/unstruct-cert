{"_id": "Academic--research_data--n--71765", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center (NSIDC)\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"millions of square kilometers\"\n        },\n        {\n            \"name\": \"Date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Unrestricted\",\n    \"sampling_method\": \"Satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Trends\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Requires specialized software for analysis.\"\n    }\n}"}
