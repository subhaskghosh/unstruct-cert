{"_id": "Academic--research_data--n--70685", "text": "{\n    \"dataset_name\": \"Industrial Emissions Monitoring - 2022\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-03-10T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2_concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"NOx_concentration\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"location_id\",\n            \"unit\": \"numeric\"\n        },\n        {\n            \"name\": \"timestamp\",\n            \"unit\": \"YYYY-MM-DD HH:MM:SS\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous Emission Monitoring Systems (CEMS)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Areas\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/emissions_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data collected from industrial facilities.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70686", "text": "{\n    \"dataset_name\": \"Human Activity Recognition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Acceleration_X\",\n            \"units\": \"m/s^2\"\n        },\n        {\n            \"variable_name\": \"Acceleration_Y\",\n            \"units\": \"m/s^2\"\n        },\n        {\n            \"variable_name\": \"Acceleration_Z\",\n            \"units\": \"m/s^2\"\n        },\n        {\n            \"variable_name\": \"Gyro_X\",\n            \"units\": \"rad/s\"\n        },\n        {\n            \"variable_name\": \"Gyro_Y\",\n            \"units\": \"rad/s\"\n        },\n        {\n            \"variable_name\": \"Gyro_Z\",\n            \"units\": \"rad/s\"\n        },\n        {\n            \"variable_name\": \"Activity\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Wearable sensor data collected from volunteers during daily activities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Human Activity Recognition using Deep Learning\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/har_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Activity labels provided for each data point.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70686", "text": "{\n    \"dataset_name\": \"Plant Growth Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Plant_Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"variable_name\": \"Leaf_Area\",\n            \"units\": \"cm^2\"\n        },\n        {\n            \"variable_name\": \"Stem_Diameter\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Measurements taken weekly on plants grown in a controlled environment.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Light Intensity on Plant Growth\",\n            \"authors\": [\n                \"Lee, D.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/plant_growth.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes measurements for different plant species.\"\n    }\n}"}
