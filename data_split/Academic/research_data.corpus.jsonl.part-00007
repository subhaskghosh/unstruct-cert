{"_id": "Academic--research_data--n--70059", "text": "{\n    \"dataset_name\": \"North Pacific Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Buoy Measurements and Satellite Observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Heat Content Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data is preliminary and subject to revision.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70060", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland, Hansen/UMD Global Forest Change Team\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M.C., et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://developers.google.com/earth-engine/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2008_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Detailed documentation provided on the University of Maryland website.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70060", "text": "{\n    \"dataset_name\": \"City of New York Traffic Data\",\n    \"creator\": {\n        \"name\": \"New York City Department of Transportation\",\n        \"affiliation\": \"NYC DOT\"\n    },\n    \"date_collected\": \"2022-12-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"vehicle_count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"average_speed\",\n            \"unit\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Loop detectors on roadways\",\n    \"related_publications\": [\n        {\n            \"title\": \"New York City Traffic Patterns\",\n            \"authors\": \"NYC DOT\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.cityofnewyork.us/Transportation/Traffic-Counts/tq2x-66qc\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Basic metadata provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70061", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes hourly averages for key pollutants.\"\n    }\n}"}
