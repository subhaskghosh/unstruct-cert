{"_id": "Academic--research_data--p--67000", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67000", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Study\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"USFS\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of National Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes species classifications.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67001", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular water sample collection at fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67001", "text": "{\n    \"dataset_name\": \"Forest Fire Emissions Data\",\n    \"creator\": {\n        \"name\": \"Canadian Forest Service\",\n        \"affiliation\": \"Natural Resources Canada\"\n    },\n    \"date_collected\": \"2021-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Emissions\",\n            \"units\": \"tonnes\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Data License - Government of Canada\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of forest fires on air quality\",\n            \"authors\": [\n                \"Brown, A.\",\n                \"Davis, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/fire_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Emissions estimated using models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67002", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Time\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Uncertainty\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global grid cell averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/climate/temp_2021.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Contains temperature data from 1880 to 2023\"\n    }\n}"}
{"_id": "Academic--research_data--n--67002", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in London\",\n    \"creator\": {\n        \"name\": \"Environmental Agency of London\",\n        \"affiliation\": \"Greater London Authority\"\n    },\n    \"date_collected\": \"2019-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Air Quality Report\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality/london.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Real-time air quality data from various monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67003", "text": "{\n    \"dataset_name\": \"USGS National Water Quality Assessment Program Data\",\n    \"creator\": {\n        \"name\": \"United States Geological Survey\",\n        \"affiliation\": \"USGS\"\n    },\n    \"date_collected\": \"2021-05-10T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected from stream sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program—Overview of Study Design and Approach\",\n            \"authors\": [\n                \"Paul D. Myers\",\n                \"Bruce M. Carlston\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/national-water-quality-assessment-program-data\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67003", "text": "{\n    \"dataset_name\": \"European Air Quality Database\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2019-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality in Europe – 2020 report\",\n            \"authors\": [\n                \"European Environment Agency\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.eea.europa.eu/data-and-maps/data/air-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data validated according to EU standards.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67004", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Monthly average surface temperature anomalies.\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"degrees North\",\n            \"description\": \"Geographical latitude of the measurement.\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"degrees East\",\n            \"description\": \"Geographical longitude of the measurement.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global network of weather stations and satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Updated Analysis\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/gsta2021.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Includes uncertainty estimates for temperature anomalies.\"\n    }\n}"}
