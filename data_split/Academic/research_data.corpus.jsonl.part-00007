{"_id": "Academic--research_data--n--66390", "text": "{\n    \"dataset_name\": \"Alzheimer's Disease Neuroimaging Initiative (ADNI)\",\n    \"creator\": {\n        \"name\": \"ADNI Consortium\",\n        \"affiliation\": \"Multiple Institutions\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"subject_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"MRI_scan_date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"ADNI Data Use Agreement\",\n    \"sampling_method\": \"Longitudinal study with standardized imaging protocols\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Alzheimer’s Disease Neuroimaging Initiative: Rationale for the study and overview\",\n            \"year\": 2003\n        }\n    ],\n    \"download_url\": \"https://adni.loni.usc.edu/\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Cognitive scores, biomarker data\"\n    }\n}"}
{"_id": "Academic--research_data--p--66391", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--66391", "text": "{\n    \"dataset_name\": \"Historical Weather Records\",\n    \"creator\": {\n        \"name\": \"National Climatic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate at a Glance\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Daily weather observations\"\n    }\n}"}
{"_id": "Academic--research_data--p--66392", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality-controlled and outliers removed.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66392", "text": "{\n    \"dataset_name\": \"Ocean Current Velocities\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"U-component\",\n            \"units\": \"m/s\",\n            \"description\": \"Eastward component of current velocity.\"\n        },\n        {\n            \"variable_name\": \"V-component\",\n            \"units\": \"m/s\",\n            \"description\": \"Northward component of current velocity.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Moored current meters\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Circulation Dynamics\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Smith, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_currents.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is raw and requires processing.\"\n    }\n}"}
