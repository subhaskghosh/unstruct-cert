{"_id": "Academic--research_data--n--71847", "text": "{\n    \"dataset_name\": \"Pacific Ocean Marine Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Monterey Bay Aquarium Research Institute\",\n        \"affiliation\": \"MBARI\"\n    },\n    \"date_collected\": \"2023-10-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Remotely Operated Vehicle (ROV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep-Sea Biodiversity in the Pacific Ocean\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_marine_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes georeferenced locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71848", "text": "{\n    \"dataset_name\": \"LocalClimateData_NYC\",\n    \"creator\": {\n        \"name\": \"NYU Environmental Science Lab\",\n        \"affiliation\": \"New York University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Hourly measurements from ground-based weather stations in New York City.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Extreme Weather in NYC\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/nyc_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71848", "text": "{\n    \"dataset_name\": \"SatelliteBasedPrecipitation\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"precipitation_rate\",\n            \"units\": \"mm/hour\"\n        },\n        {\n            \"name\": \"cloud_cover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global precipitation estimates derived from satellite microwave sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Precipitation Climatology Project\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/satellite_precipitation.nc\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data is gridded at 0.25 degree resolution.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71849", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Europe\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations across major European cities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality in Europe - 2023 Report\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data is quality controlled and validated by the EEA.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71849", "text": "{\n    \"dataset_name\": \"Industrial Emissions Inventory\",\n    \"creator\": {\n        \"name\": \"National Pollutant Discharge Elimination System\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2\",\n            \"units\": \"tons\",\n            \"description\": \"Sulfur dioxide emissions from factories.\"\n        },\n        {\n            \"name\": \"CO2\",\n            \"units\": \"tons\",\n            \"description\": \"Carbon dioxide emissions from factories.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Reported emissions data from industrial facilities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Industrial Emissions Trends\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/industrial_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data represents self-reported emissions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71850", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Imperial College London, Environmental Research Group\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data validated and quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71850", "text": "{\n    \"dataset_name\": \"Rural Air Quality Study - Scottish Highlands\",\n    \"creator\": {\n        \"name\": \"Professor Alistair MacLeod\",\n        \"affiliation\": \"University of Edinburgh, Atmospheric Sciences\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 10 micrometers or less.\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of sulfur dioxide in the air.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Mobile monitoring using drone technology\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric Composition in Remote Regions\",\n            \"authors\": \"MacLeod et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/scottish_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"750MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71851", "text": "{\n    \"dataset_name\": \"UrbanAirQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"City University of London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Areas\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data has been quality checked and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71851", "text": "{\n    \"dataset_name\": \"ForestEcosystemHealth\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"US Department of Agriculture\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeDiameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"LeafAreaIndex\",\n            \"units\": \"m²/m²\"\n        },\n        {\n            \"name\": \"SoilMoisture\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes measurements from various forest plots across the country.\"\n    }\n}"}
