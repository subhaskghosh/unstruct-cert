{"_id": "Academic--research_data--n--68841", "text": "{\n    \"dataset_name\": \"Gulf of Mexico Marine Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Texas A&M University\"\n    },\n    \"date_collected\": \"2023-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"Number of individuals\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"psu\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Remote Operated Vehicle (ROV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity of the Gulf of Mexico\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/gulf_marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Species identification validated by experts\"\n    }\n}"}
