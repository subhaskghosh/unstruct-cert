{"_id": "Academic--research_data--n--69500", "text": "{\n    \"dataset_name\": \"Chest X-ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_size\",\n            \"unit\": \"MB\"\n        },\n        {\n            \"name\": \"patient_gender\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Prospective study with informed consent\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pneumonia Detection using CNNs\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://another-example.com/chest_xray\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Pneumonia labels\"\n    }\n}"}
{"_id": "Academic--research_data--p--69501", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Monthly mean temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--69501", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Oceanographic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Argo float data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Salinity\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.nodc.noaa.gov/OC5/select/woa2018/woa2018_salinity\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Monthly salinity data\"\n    }\n}"}
