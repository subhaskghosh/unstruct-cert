{"_id": "Academic--research_data--n--68014", "text": "{\n    \"dataset_name\": \"Global Soil Composition - 2018\",\n    \"creator\": {\n        \"name\": \"International Soil Science Consortium\",\n        \"affiliation\": \"Various Universities\"\n    },\n    \"date_collected\": \"2018-03-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sand Content\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Silt Content\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Clay Content\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Bulk Density\",\n            \"units\": \"g/cm^3\"\n        },\n        {\n            \"name\": \"Cation Exchange Capacity\",\n            \"units\": \"cmol/kg\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphorus Content\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium Content\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Composite sampling from various locations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global distribution of soil properties\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/global_soil_composition.json\",\n    \"metadata\": {\n        \"data_size\": \"5.5 MB\",\n        \"annotations\": \"Metadata includes sampling location details.\"\n    }\n}"}
