{"_id": "Academic--research_data--p--67509", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"National Water Quality Monitoring Council\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"unit\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Systematic Grab Samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Assessment of River Water Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.example.com/riverdata.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included for each variable. Thoroughly documented sampling protocols.\"\n    }\n}"}
