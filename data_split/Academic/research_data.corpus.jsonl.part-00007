{"_id": "Academic--research_data--p--68231", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"variable_name\": \"O3\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen Dioxide concentration\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations distributed across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Air Quality in Urban Environments\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags are included in a separate column.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68231", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change 1990-2020\",\n    \"creator\": {\n        \"name\": \"University of Maryland Global Land Cover Facility\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2020-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Forest Cover\",\n            \"units\": \"Percentage\",\n            \"description\": \"Percentage of area covered by forest\"\n        },\n        {\n            \"variable_name\": \"Gain\",\n            \"units\": \"hectares\",\n            \"description\": \"Area of forest gained\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change: Mapping the World's Forests\",\n            \"authors\": [\n                \"Hansen, M.C.\",\n                \"Potapov, P.V.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_change.tif\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data processed using standard remote sensing techniques.\"\n    }\n}"}
