{"_id": "Academic--research_data--p--70301", "text": "{\n    \"dataset_name\": \"Global Forest Carbon Flux Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Flux\",\n            \"units\": \"kg C/m2/year\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon sequestration in tropical forests\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
