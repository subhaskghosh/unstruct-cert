{"_id": "Academic--research_data--p--67510", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GSTA)\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"National Centers for Environmental Information\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Air Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Kelvin\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global weather station network and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"A Global Reconstruction of Temperature from 1880 to 2020\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/gsta_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags are included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67510", "text": "{\n    \"dataset_name\": \"Forest Biomass Estimates\",\n    \"creator\": {\n        \"name\": \"Department of Forestry\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"centimeters\"\n        },\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Forest inventory plots across California\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating Forest Biomass in California\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data includes estimates of aboveground biomass.\"\n    }\n}"}
