{"_id": "Academic--research_data--p--67631", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group, UCL\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"variable_name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of nitrogen dioxide in parts per billion.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in London\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality assessed as 'high' based on rigorous calibration and validation procedures.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67631", "text": "{\n    \"dataset_name\": \"SoilComposition_RuralFrance_2022\",\n    \"creator\": {\n        \"name\": \"Institut National de la Recherche Agronomique\",\n        \"affiliation\": \"INRAE\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"unitless\",\n            \"description\": \"Soil pH level.\"\n        },\n        {\n            \"variable_name\": \"OrganicMatter\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of organic matter in the soil.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random soil sampling across agricultural fields.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Composition and Crop Yield in France\",\n            \"authors\": [\n                \"Dupont, L.\",\n                \"Martin, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/french_soil_composition_2022.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Preliminary data analysis completed. Quality is moderate.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67632", "text": "{\n    \"dataset_name\": \"Coastal Erosion Impact Assessment Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Santa Barbara\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Erosion Rate\",\n            \"units\": \"meters/year\"\n        },\n        {\n            \"name\": \"Sea Level Rise\",\n            \"units\": \"mm/year\"\n        },\n        {\n            \"name\": \"Vegetation Density\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Field surveys and remote sensing data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Vulnerability Assessment\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_erosion_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67632", "text": "{\n    \"dataset_name\": \"Global Temperature Anomaly Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global climate model output\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data represents the average temperature anomaly for each grid cell.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67633", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent and Thickness\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"million square kilometers\"\n        },\n        {\n            \"name\": \"Sea Ice Thickness\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Decline in Arctic Sea Ice Extent\",\n            \"authors\": [\n                \"Meier\",\n                \"Stroeve\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice/data\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Includes quality flags and uncertainty estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67633", "text": "{\n    \"dataset_name\": \"Global Carbon Tax Policies\",\n    \"creator\": {\n        \"name\": \"World Bank\",\n        \"affiliation\": \"International Bank for Reconstruction and Development\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Tax Rate\",\n            \"units\": \"USD per metric ton of CO2\"\n        },\n        {\n            \"name\": \"Policy Implementation Date\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Government reports and policy documents\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Effectiveness of Carbon Pricing\",\n            \"authors\": [\n                \"Stiglitz\",\n                \"Nordhaus\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.worldbank.org/carbon-tax\",\n    \"metadata\": {\n        \"data_size\": \"2 MB\",\n        \"annotations\": \"Includes details on policy exemptions and revenue recycling.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67634", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
