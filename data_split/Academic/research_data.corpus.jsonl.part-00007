{"_id": "Academic--research_data--p--70643", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies and Climate Indicators\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Global Mean Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Sea Level Change\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"variable_name\": \"Arctic Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"variable_name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"variable_name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Nitrous Oxide Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"variable_name\": \"Radiative Forcing\",\n            \"units\": \"W/m^2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal (Public Domain Dedication)\",\n    \"sampling_method\": \"Global monitoring stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Reto Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"150 MB\",\n        \"annotations\": \"Complete metadata available in accompanying documentation.\"\n    }\n}"}
