{"_id": "Academic--research_data--p--68570", "text": "{\n    \"dataset_name\": \"Global Land Surface Temperature Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2019-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Land Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Global gridded data from land-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Land Surface Temperature Analysis\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/land_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Gridded dataset, monthly averages\"\n    }\n}"}
{"_id": "Academic--research_data--n--68570", "text": "{\n    \"dataset_name\": \"Pacific Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-03-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Buoy and ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Warming Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Ocean temperature anomaly data, daily measurements\"\n    }\n}"}
{"_id": "Academic--research_data--p--68571", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations across urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic emissions on urban air quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and validated by researchers at Imperial College London.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68571", "text": "{\n    \"dataset_name\": \"Indoor Air Quality in Office Buildings\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Health Sciences\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"VOCs\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA\",\n    \"sampling_method\": \"Sensor network deployed in office buildings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of ventilation on indoor air quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/indoor_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data collected as part of a research study on building ventilation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68572", "text": "{\n    \"dataset_name\": \"RiverWaterQualityData\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly from various river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68572", "text": "{\n    \"dataset_name\": \"AtmosphericPollutionLevels\",\n    \"creator\": {\n        \"name\": \"City Air Quality Monitoring\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2021-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"2.5 MB\",\n        \"annotations\": \"Data is pre-processed and averaged hourly.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68573", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Monitoring - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Oceanography\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated sensors deployed on a research vessel and at fixed buoy locations, supplemented with discrete water samples analyzed in a laboratory.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Ocean Acidification on Coastal Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
